<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CSweetMemoryRepositoryRoot Condition="'$(CSweetMemoryRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CSweet.Memory</CSweetMemoryRepositoryRoot>
    <UseLocalCSweetMemory Condition="'$(UseLocalCSweetMemory)' == '' and Exists('$(CSweetMemoryRepositoryRoot)\src\CSweet.Memory\CSweet.Memory.csproj')">true</UseLocalCSweetMemory>
    <UseLocalCSweetMemory Condition="'$(UseLocalCSweetMemory)' == ''">false</UseLocalCSweetMemory>
    <CSweetAgentSdkRepositoryRoot Condition="'$(CSweetAgentSdkRepositoryRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\CSweet.Agent.Sdk\src\CSweet.Agent.SDK\CSweet.Agent.SDK.csproj')">$(MSBuildThisFileDirectory)..\CSweet.Agent.Sdk</CSweetAgentSdkRepositoryRoot>
    <CSweetAgentSdkRepositoryRoot Condition="'$(CSweetAgentSdkRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CSweetAgentSdk</CSweetAgentSdkRepositoryRoot>
    <UseLocalCSweetAgentSdk Condition="'$(UseLocalCSweetAgentSdk)' == '' and Exists('$(CSweetAgentSdkRepositoryRoot)\src\CSweet.Agent.SDK\CSweet.Agent.SDK.csproj')">true</UseLocalCSweetAgentSdk>
    <UseLocalCSweetAgentSdk Condition="'$(UseLocalCSweetAgentSdk)' == ''">false</UseLocalCSweetAgentSdk>
    <CSweetWorkManagementContractsRepositoryRoot Condition="'$(CSweetWorkManagementContractsRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CSweet.WorkManagement.Contracts</CSweetWorkManagementContractsRepositoryRoot>
    <UseLocalCSweetWorkManagementContracts Condition="'$(UseLocalCSweetWorkManagementContracts)' == '' and Exists('$(CSweetWorkManagementContractsRepositoryRoot)\src\CSweet.WorkManagement.Contracts\CSweet.WorkManagement.Contracts.csproj')">true</UseLocalCSweetWorkManagementContracts>
    <UseLocalCSweetWorkManagementContracts Condition="'$(UseLocalCSweetWorkManagementContracts)' == ''">false</UseLocalCSweetWorkManagementContracts>
    <CSweetOfficeContractsRepositoryRoot Condition="'$(CSweetOfficeContractsRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CSweet.Office.Contracts</CSweetOfficeContractsRepositoryRoot>
    <UseLocalOfficeContracts Condition="'$(UseLocalOfficeContracts)' == '' and Exists('$(CSweetOfficeContractsRepositoryRoot)\src\CSweet.Office.Contracts\CSweet.Office.Contracts.csproj')">true</UseLocalOfficeContracts>
    <UseLocalOfficeContracts Condition="'$(UseLocalOfficeContracts)' == ''">false</UseLocalOfficeContracts>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Prefer sibling source checkouts; explicit false retains package-only release validation. -->
    <CSweetIsolationRepositoryRoot Condition="'$(CSweetIsolationRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CSweet.Isolation</CSweetIsolationRepositoryRoot>
    <UseLocalIsolation Condition="'$(UseLocalIsolation)' == '' and Exists('$(CSweetIsolationRepositoryRoot)\src\CSweet.Isolation.Security\CSweet.Isolation.Security.csproj')">true</UseLocalIsolation>
    <UseLocalIsolation Condition="'$(UseLocalIsolation)' == ''">false</UseLocalIsolation>
    <CSweetWebHostRepositoryRoot Condition="'$(CSweetWebHostRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CSweet.WebHost</CSweetWebHostRepositoryRoot>
    <UseLocalWebHost Condition="'$(UseLocalWebHost)' == '' and Exists('$(CSweetWebHostRepositoryRoot)\src\CSweet.WebHost.Core\CSweet.WebHost.Core.csproj')">true</UseLocalWebHost>
    <UseLocalWebHost Condition="'$(UseLocalWebHost)' == ''">false</UseLocalWebHost>
    <CSweetWebHostContractsRepositoryRoot Condition="'$(CSweetWebHostContractsRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CSweet.WebHost.Contracts</CSweetWebHostContractsRepositoryRoot>
    <UseLocalWebHostContracts Condition="'$(UseLocalWebHostContracts)' == '' and Exists('$(CSweetWebHostContractsRepositoryRoot)\src\CSweet.WebHost.Contracts\CSweet.WebHost.Contracts.csproj')">true</UseLocalWebHostContracts>
    <UseLocalWebHostContracts Condition="'$(UseLocalWebHostContracts)' == ''">false</UseLocalWebHostContracts>
  </PropertyGroup>
</Project>
