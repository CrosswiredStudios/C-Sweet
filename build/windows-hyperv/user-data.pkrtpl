#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: csweet-agent-guest
    username: csweet-image
    password: "!"
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ${ssh_public_key}
  storage:
    layout:
      name: direct
  packages:
    - linux-tools-virtual
    - linux-cloud-tools-common
    - linux-cloud-tools-virtual
  late-commands:
    - curtin in-target --target=/target -- test -x /usr/sbin/hv_kvp_daemon
    - curtin in-target --target=/target -- sh -c "printf 'csweet-image ALL=(ALL) NOPASSWD:ALL\\n' >/etc/sudoers.d/90-csweet-image"
    - curtin in-target --target=/target -- chmod 0440 /etc/sudoers.d/90-csweet-image
  updates: security
  shutdown: reboot
