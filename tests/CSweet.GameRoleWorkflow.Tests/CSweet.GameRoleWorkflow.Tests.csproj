<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <CSweetSourceRepositoriesRoot Condition="'$(CSweetSourceRepositoriesRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..</CSweetSourceRepositoriesRoot>
    <CSweetGameDirectorRepositoryRoot Condition="'$(CSweetGameDirectorRepositoryRoot)' == ''">$(CSweetSourceRepositoriesRoot)/CSweet.Agent.Director.VideoGame</CSweetGameDirectorRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CSweet.Agent.Testing" Condition="'$(UseLocalCSweetAgentSdk)' != 'true'" />
    <ProjectReference Include="$(CSweetAgentSdkRepositoryRoot)/src/CSweet.Agent.Testing/CSweet.Agent.Testing.csproj" Condition="'$(UseLocalCSweetAgentSdk)' == 'true'" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Agents.AI" VersionOverride="1.15.0" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
    <ProjectReference Include="../CSweet.UnitTests/CSweet.UnitTests.csproj" />
    <ProjectReference Include="$(CSweetSourceRepositoriesRoot)/CSweet.Agent.Engineer.VideoGame/src/CSweet.Agent.Engineer.VideoGame/CSweet.Agent.Engineer.VideoGame.csproj" Aliases="Engineer" />
    <EmbeddedResource Include="$(CSweetGameDirectorRepositoryRoot)/profiles/video-game-production.v2.8.json" LogicalName="first-sprint-profile.json" />
    <EmbeddedResource Include="$(CSweetSourceRepositoriesRoot)/CSweet.Agent.TechnicalDirector.VideoGame/csweet-plugin.json" LogicalName="game-technical-director.json" />
    <EmbeddedResource Include="$(CSweetSourceRepositoriesRoot)/CSweet.Agent.Producer.VideoGame/csweet-plugin.json" LogicalName="game-producer.json" />
    <EmbeddedResource Include="$(CSweetSourceRepositoriesRoot)/CSweet.Agent.Engineer.VideoGame/csweet-plugin.json" LogicalName="game-engineer.json" />
    <EmbeddedResource Include="$(CSweetSourceRepositoriesRoot)/CSweet.Agent.QA.VideoGame/csweet-plugin.json" LogicalName="game-quality-assurance.json" />
    <ProjectReference Include="$(CSweetGameDirectorRepositoryRoot)/src/CSweet.Agent.Director.VideoGame/CSweet.Agent.Director.VideoGame.csproj" Aliases="Director" />
    <ProjectReference Include="$(CSweetSourceRepositoriesRoot)/CSweet.Agent.CreativeDirector.VideoGame/src/CSweet.Agent.CreativeDirector.VideoGame/CSweet.Agent.CreativeDirector.VideoGame.csproj" Aliases="Creative" />
    <ProjectReference Include="$(CSweetSourceRepositoriesRoot)/CSweet.Agent.Producer.VideoGame/src/CSweet.Agent.Producer.VideoGame/CSweet.Agent.Producer.VideoGame.csproj" Aliases="Producer" />
    <ProjectReference Include="$(CSweetSourceRepositoriesRoot)/CSweet.Agent.TechnicalDirector.VideoGame/src/CSweet.Agent.TechnicalDirector.VideoGame/CSweet.Agent.TechnicalDirector.VideoGame.csproj" Aliases="Technical" />
  </ItemGroup>
</Project>
