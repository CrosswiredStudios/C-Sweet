<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UsesOfficeContracts>true</UsesOfficeContracts>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CSweet.Compute.Guest/CSweet.Compute.Guest.csproj" />
    <ProjectReference Include="../../src/CSweet.Compute.HyperV/CSweet.Compute.HyperV.csproj" />
    <ProjectReference Include="../../src/CSweet.Compute.Runtime/CSweet.Compute.Runtime.csproj" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CSweet.AgentBroker\CSweet.AgentBroker.csproj" />
    <ProjectReference Include="..\..\src\CSweet.ExecutionArtifacts\CSweet.ExecutionArtifacts.csproj" />
    <Using Include="Xunit" />
    <Compile Remove="PersonalAssistantAgentTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CSweet.Agent.SDK" Condition="'$(UseLocalCSweetAgentSdk)' != 'true'" />
    <ProjectReference Include="$(CSweetAgentSdkRepositoryRoot)\src\CSweet.Agent.SDK\CSweet.Agent.SDK.csproj" Condition="'$(UseLocalCSweetAgentSdk)' == 'true'" />
    <PackageReference Include="CSweet.Memory.Sqlite" Condition="'$(UseLocalCSweetMemory)' != 'true'" />
    <ProjectReference Include="$(CSweetMemoryRepositoryRoot)\src\CSweet.Memory.Sqlite\CSweet.Memory.Sqlite.csproj" Condition="'$(UseLocalCSweetMemory)' == 'true'" />
    <ProjectReference Include="..\..\src\CSweet.Api\CSweet.Api.csproj" />
    <ProjectReference Include="..\..\src\CSweet.AgentHost\CSweet.AgentHost.csproj" />
    <ProjectReference Include="..\..\src\CSweet.Domain\CSweet.Domain.csproj" />
    <ProjectReference Include="..\..\src\CSweet.Application\CSweet.Application.csproj" />
    <ProjectReference Include="..\..\src\CSweet.AI\CSweet.AI.csproj" />
    <ProjectReference Include="..\..\src\CSweet.UI\CSweet.UI.csproj" />
    <ProjectReference Include="..\..\src\CSweet.Infrastructure\CSweet.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\CSweet.ExecutionGateway\CSweet.ExecutionGateway.csproj" />
  </ItemGroup>

  <ItemGroup><EmbeddedResource Include="Fixtures/video-game-production.v2.5.json" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../CSweet.Compute.GuestFixture/CSweet.Compute.GuestFixture.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
  <Target Name="CopyComputeGuestFixture" AfterTargets="Build">
    <ItemGroup><ComputeGuestFixtureFiles Include="../CSweet.Compute.GuestFixture/bin/$(Configuration)/$(TargetFramework)/CSweet.Compute.GuestFixture.*" /></ItemGroup>
    <Copy SourceFiles="@(ComputeGuestFixtureFiles)" DestinationFolder="$(OutDir)guest-fixture" />
  </Target>
</Project>
