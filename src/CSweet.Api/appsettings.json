{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ChatTurns": {
    "HardTimeout": "00:30:00",
    "DirectFallbackTimeout": "00:02:00",
    "MemoryOperationTimeout": "00:00:05",
    "StreamHeartbeatInterval": "00:00:10",
    "RuntimeStartupTimeout": "00:00:30",
    "CapabilityRegistrationTimeout": "00:00:05",
    "CapabilityRetryDelay": "00:00:01"
  },
  "CSweet": {
    "Marketplace": {
      "Enabled": true,
      "BaseUrl": "https://marketplace.csweet.com/",
      "TimeoutSeconds": 10
    },
    "Agents": {
      "SuggestedChiefOfStaffRepository": "https://github.com/CrosswiredStudios/CSweet.Agent.ChiefOfStaff"
    },
    "ExecutionGateway": {
      "PublicUrl": ""
    },
    "ExecutionFleet": {
      "PublicLaunchEnabled": false,
      "AllowUnpinnedDevelopmentImages": false,
      "MinimumBuilderCpuCount": 1,
      "MinimumBuilderMemoryMb": 4096,
      "MinimumBuilderDiskMb": 3072,
      "MinimumRuntimeCpuCount": 1,
      "MinimumRuntimeMemoryMb": 512,
      "MinimumRuntimeDiskMb": 1024,
      "ReleaseManifestUrl": "https://github.com/CrosswiredStudios/CSweet.Office/releases/latest/download/office-release.json",
      "WindowsPackageOverrideUrl": "",
      "LinuxPackageOverrideUrl": "",
      "MacOsPackageOverrideUrl": ""
    },
    "PluginConnections": {
      "PublicBaseUrl": "",
      "Providers": {
        "com.csweet.google.youtube": {
          "DisplayName": "Google / YouTube",
          "AuthorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
          "TokenEndpoint": "https://oauth2.googleapis.com/token",
          "RevocationEndpoint": "https://oauth2.googleapis.com/revoke",
          "ClientId": "",
          "ClientSecret": ""
        }
      }
    },
    "MediaAssets": {
      "MaximumFileSizeBytes": 1073741824,
      "MaximumOrganizationStorageBytes": 549755813888,
      "ResumableChunkSizeBytes": 8388608,
      "UploadSessionLifetimeHours": 24
    }
  }
}
