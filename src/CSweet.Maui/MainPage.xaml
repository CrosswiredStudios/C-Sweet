<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:CSweet.UI;assembly=CSweet.UI"
             xmlns:web="clr-namespace:Microsoft.AspNetCore.Components.Web;assembly=Microsoft.AspNetCore.Components.Web"
             x:Class="CSweet.Maui.MainPage"
             BackgroundColor="#050505">

    <!-- #050505 is the default night-glass paper, so no light flash before the UI paints. -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" BackgroundColor="#050505">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ui:Routes}" />
            <RootComponent Selector="head::after" ComponentType="{x:Type web:HeadOutlet}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
