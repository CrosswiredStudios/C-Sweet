{
  "Kestrel": {
    "Endpoints": {
      "Mcp": { "Url": "http://0.0.0.0:8081", "Protocols": "Http1" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FeatureFlags": {
    "ProviderGateway": false,
    "InfrastructureGovernance": false,
    "RestrictedFileTransfer": false
  },
  "Infrastructure": {
    "Namecheap": {
      "ProductionApiEnabled": false,
      "FixedEgressIPv4": ""
    }
  },
  "CSweet": {
    "Llm": {
      "Queue": {
        "MaximumConcurrentRequests": 1,
        "MaximumQueuedRequests": 256,
        "GenerationTimeoutSeconds": 900,
        "MaximumRequestBytes": 4194304,
        "MaximumMessageCount": 512,
        "MaximumMessageCharacters": 1048576,
        "MaximumToolCount": 256,
        "DefaultMaximumOutputTokens": 32768
      }
    },
    "Marketplace": {
      "Enabled": false,
      "BaseUrl": "https://marketplace.csweet.com/",
      "TimeoutSeconds": 10
    },
    "AgentOnboardingDelivery": {
      "MaximumAttempts": 12
    }
  }
}
