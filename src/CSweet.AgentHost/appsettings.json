{
  "Kestrel": {
    "Endpoints": {
      "Mcp": { "Url": "http://0.0.0.0:8081", "Protocols": "Http1" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FeatureFlags": {
    "ProviderGateway": false,
    "InfrastructureGovernance": false,
    "RestrictedFileTransfer": false
  },
  "Infrastructure": {
    "Namecheap": {
      "ProductionApiEnabled": false,
      "FixedEgressIPv4": ""
    }
  },
  "CSweet": {
    "Llm": {
      "Queue": {
        "MaximumQueuedRequests": 256,
        "GenerationTimeoutSeconds": 0,
        "MaximumRequestBytes": 0,
        "MaximumMessageCount": 512,
        "MaximumMessageCharacters": 0,
        "MaximumToolCount": 256
      }
    },
    "Mcp": {
      "Limits": {
        "MaximumRequestBytes": 16777216,
        "MaximumInlineTextBytes": 65536
      }
    },
    "SourceControl": {
      "WorkspaceSync": {
        "MaximumArchiveBytes": 8388608,
        "MaximumExpandedBytes": 268435456,
        "MaximumFileCount": 20000
      }
    },
    "Marketplace": {
      "Enabled": false,
      "BaseUrl": "https://marketplace.csweet.com/",
      "TimeoutSeconds": 10
    },
    "AgentOnboardingDelivery": {
      "MaximumAttempts": 12
    },
    "Harness": {
      "DecisionModel": {
        "Enabled": true,
        "BaseUrl": "",
        "Model": "",
        "KeyEnv": "",
        "TimeoutMs": 20000,
        "Retries": 2,
        "MaxQuestionsPerRequest": 24,
        "MaxRequestTokens": 30000,
        "MaxParallel": 4,
        "MaxStateTokens": 25000,
        "PreserveRecent": 6,
        "KeepThreshold": 0.5,
        "TruncateHeadChars": 300
      }
    }
  }
}
