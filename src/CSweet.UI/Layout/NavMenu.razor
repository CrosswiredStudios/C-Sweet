@implements IDisposable
@inject IBusinessContext BusinessContext
@inject IAuthenticationApiClient AuthenticationApi
@inject AuthSessionStore AuthSession
@inject NavigationManager Navigation
@inject CommunicationUnreadState CommunicationUnread

<div class="nav-shell">
    <a class="nav-brand" href="/" aria-label="C-Sweet Enterprise home">
        <img src="images/icon_dark.svg" alt="" />
        <div>
            <MudText Typo="Typo.subtitle1" Color="Color.Primary">C-Sweet</MudText>
            <MudText Typo="Typo.caption">Run the company</MudText>
        </div>
    </a>

    <div class="app-nav-shell">
        <MudNavMenu Bordered="false" Dense="true" Class="app-nav">
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Apartment">Enterprise</MudNavLink>

            <div class="business-nav-group">
                <BusinessSwitcher />
                @if (BusinessContext.SelectedBusiness is not null)
                {
                    <MudNavLink Href="@OverviewHref" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Dashboard" Class="business-nav-link">
                        Overview
                    </MudNavLink>
                    <MudNavLink Href="@WorkHref" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.ViewKanban" Class="business-nav-link">
                        Work
                    </MudNavLink>
                    <MudNavLink Href="@ProjectsHref" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.AccountTree" Class="business-nav-link">
                        Projects
                    </MudNavLink>
                    <MudNavLink Href="@SourceControlHref" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.AccountTree" Class="business-nav-link">
                        Source Control
                    </MudNavLink>
                    <MudNavLink Href="@ApprovalsHref" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Approval" Class="business-nav-link">
                        Approvals
                    </MudNavLink>
                    <MudNavLink Href="@DocumentsHref" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Description" Class="business-nav-link">
                        Documents
                    </MudNavLink>
                    <MudNavLink Href="@EmployeesHref" Icon="@Icons.Material.Outlined.Groups" Class="@EmployeesClass">
                        Employees
                    </MudNavLink>
                    <MudNavLink Href="@AnalyticsHref" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Insights" Class="business-nav-link">
                        Analytics
                    </MudNavLink>
                    <MudNavLink Href="@MarketplaceHref" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Outlined.Storefront" Class="business-nav-link">
                        Agent marketplace
                    </MudNavLink>
                    <MudNavLink Href="@CommunicationsHref" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Outlined.Forum" Class="business-nav-link communications-nav-link">
                        <span class="communications-nav-content">
                            <span class="communications-nav-label">Communications</span>
                            @if (CommunicationUnread.TotalUnreadCount > 0)
                            {
                                <span class="communications-nav-badge" aria-label="@UnreadAriaLabel">@UnreadLabel</span>
                            }
                        </span>
                    </MudNavLink>
                    <MudNavLink Href="@SecurityHref" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Security" Class="business-nav-link">
                        Security
                    </MudNavLink>
                }
                else
                {
                    <div class="business-nav-disabled" aria-disabled="true"><MudIcon Icon="@Icons.Material.Outlined.Dashboard" /> Overview</div>
                    <div class="business-nav-disabled" aria-disabled="true"><MudIcon Icon="@Icons.Material.Outlined.ViewKanban" /> Work</div>
                    <div class="business-nav-disabled" aria-disabled="true"><MudIcon Icon="@Icons.Material.Outlined.AccountTree" /> Projects</div>
                    <div class="business-nav-disabled" aria-disabled="true"><MudIcon Icon="@Icons.Material.Outlined.AccountTree" /> Source Control</div>
                    <div class="business-nav-disabled" aria-disabled="true"><MudIcon Icon="@Icons.Material.Outlined.Approval" /> Approvals</div>
                    <div class="business-nav-disabled" aria-disabled="true"><MudIcon Icon="@Icons.Material.Outlined.Description" /> Documents</div>
                    <div class="business-nav-disabled" aria-disabled="true"><MudIcon Icon="@Icons.Material.Outlined.Groups" /> Employees</div>
                    <div class="business-nav-disabled" aria-disabled="true"><MudIcon Icon="@Icons.Material.Outlined.Insights" /> Analytics</div>
                    <div class="business-nav-disabled" aria-disabled="true"><MudIcon Icon="@Icons.Material.Outlined.Storefront" /> Agent marketplace</div>
                    <div class="business-nav-disabled" aria-disabled="true"><MudIcon Icon="@Icons.Material.Outlined.Security" /> Security</div>
                }
            </div>
        </MudNavMenu>
    </div>

    <div class="nav-footer">
        <MudNavMenu Bordered="false" Dense="true" Class="app-nav">
            <MudNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Settings">Settings</MudNavLink>
        </MudNavMenu>

        <MudMenu FullWidth="true" AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomCenter" Class="user-menu">
            <ActivatorContent>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.AccountCircle" FullWidth="true" Class="user-menu-button">
                    <span class="user-menu-label">@UserLabel</span>
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudText Typo="Typo.caption" Class="user-menu-email">@AuthSession.Current?.Email</MudText>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync">Sign out</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </div>
</div>

@code {
    private string? OverviewHref => BusinessContext.SelectedBusiness is { } business
        ? $"/organizations/{business.Id}/command-center"
        : null;

    private string? EmployeesHref => BusinessContext.SelectedBusiness is { } business
        ? $"/organizations/{business.Id}/employees"
        : null;

    private string? WorkHref => BusinessContext.SelectedBusiness is { } business
        ? $"/organizations/{business.Id}/work"
        : null;

    private string? ProjectsHref => BusinessContext.SelectedBusiness is { } business
        ? $"/organizations/{business.Id}/projects"
        : null;

    private string? SourceControlHref => BusinessContext.SelectedBusiness is { } business
        ? $"/organizations/{business.Id}/source-control"
        : null;

    private string? AnalyticsHref => BusinessContext.SelectedBusiness is { } business
        ? $"/organizations/{business.Id}/analytics"
        : null;

    private string? ApprovalsHref => BusinessContext.SelectedBusiness is { } business
        ? $"/organizations/{business.Id}/approvals"
        : null;

    private string? CommunicationsHref => BusinessContext.SelectedBusiness is { } business
        ? $"/organizations/{business.Id}/communications"
        : null;

    private string? DocumentsHref => BusinessContext.SelectedBusiness is { } business
        ? $"/organizations/{business.Id}/documents"
        : null;

    private string? MarketplaceHref => BusinessContext.SelectedBusiness is { } business
        ? $"/organizations/{business.Id}/marketplace"
        : null;

    private string? SecurityHref => BusinessContext.SelectedBusiness is { } business
        ? $"/organizations/{business.Id}/security"
        : null;

    private string EmployeesClass => BusinessNavigation.IsEmployeePath(CurrentPath())
        ? "business-nav-link active"
        : "business-nav-link";

    private string UnreadLabel => CommunicationUnread.TotalUnreadCount > 99
        ? "99+" : CommunicationUnread.TotalUnreadCount.ToString();

    private string UnreadAriaLabel => CommunicationUnread.TotalUnreadCount == 1
        ? "1 unread notification"
        : $"{CommunicationUnread.TotalUnreadCount} unread notifications";

    private string UserLabel => string.IsNullOrWhiteSpace(AuthSession.Current?.Email)
        ? "User"
        : AuthSession.Current.Email;

    protected override void OnInitialized()
    {
        BusinessContext.Changed += OnContextChanged;
        Navigation.LocationChanged += OnLocationChanged;
        CommunicationUnread.Changed += OnUnreadChanged;
        _ = CommunicationUnread.InitializeAsync();
    }

    private string CurrentPath() => Navigation.ToBaseRelativePath(Navigation.Uri);
    private void OnContextChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    private void OnUnreadChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LogoutAsync()
    {
        await AuthenticationApi.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        BusinessContext.Changed -= OnContextChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        CommunicationUnread.Changed -= OnUnreadChanged;
    }
}
