@inherits LayoutComponentBase
@inject AppCulture Culture

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudRTLProvider RightToLeft="@Culture.IsRightToLeft">
<main class="auth-shell">
    <section class="auth-brand-panel">
        <img class="auth-mark" src="images/icon_dark.svg" alt="C-Sweet" />
        <div>
            <MudText Typo="Typo.h3">C-Sweet</MudText>
            <MudText>Build and operate your company with an agent-first workforce.</MudText>
        </div>
    </section>
    <section class="auth-content">
        @Body
    </section>
</main>
</MudRTLProvider>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#18233F",
            Secondary = "#9BE7C2",
            SecondaryContrastText = "#18233F",
            Tertiary = "#9BE7C2",
            Background = "#FFFCF7",
            Surface = "#FFFFFF",
            TextPrimary = "#0B2E53",
            TextSecondary = "#52606D",
            Error = "#B3261E",
            Success = "#23845C",
            Warning = "#F2B84B"
        }
    };
}
