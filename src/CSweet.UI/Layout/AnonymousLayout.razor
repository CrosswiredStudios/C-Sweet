@inherits LayoutComponentBase
@inject AppCulture Culture
@inject IAppLocalizer L

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudRTLProvider RightToLeft="@Culture.IsRightToLeft">
<main class="auth-shell">
    <section class="auth-brand-panel">
        <img class="auth-mark" src="images/icon_dark.svg" alt="C-Sweet" />
        <div>
            <MudText Typo="Typo.h3">C-Sweet</MudText>
            <MudText>@L["AnonymousLayout.Tagline"]</MudText>
        </div>
        <div class="auth-language">
            <select class="auth-language-select" aria-label="@L["Layout.LanguagePicker"]" value="@Culture.CurrentCode" @onchange="OnLanguageChanged">
                @foreach (var culture in CSweet.Contracts.Localization.SupportedCultures.All)
                {
                    <option value="@culture.Code" lang="@culture.Code">@culture.NativeName</option>
                }
            </select>
        </div>
    </section>
    <section class="auth-content">
        @Body
    </section>
</main>
</MudRTLProvider>

@code {
    private Task OnLanguageChanged(ChangeEventArgs e) => Culture.SetLanguageAsync(e.Value?.ToString());

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#18233F",
            Secondary = "#9BE7C2",
            SecondaryContrastText = "#18233F",
            Tertiary = "#9BE7C2",
            Background = "#FFFCF7",
            Surface = "#FFFFFF",
            TextPrimary = "#0B2E53",
            TextSecondary = "#52606D",
            Error = "#B3261E",
            Success = "#23845C",
            Warning = "#F2B84B"
        }
    };
}
