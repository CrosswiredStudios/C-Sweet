@inherits LayoutComponentBase
@implements IDisposable
@inject AppearanceState Appearance
@inject IAuthenticationApiClient AuthenticationApi
@inject AuthSessionStore AuthSession
@inject NavigationManager Navigation
@inject IAppLocalizer L

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="setup-appearance" data-appearance="@Appearance.Theme">
<div class="setup-layout-shell aurora-page onboarding-workspace">
    <header class="setup-layout-header">
        <div class="setup-layout-brand" aria-label="@L["SetupLayout.BrandAriaLabel"]">
            <img src="images/icon_dark.svg" alt="" />
            <span class="setup-layout-brand-name">C-Sweet</span>
            <span class="setup-layout-brand-context">@L["SetupLayout.Context"]</span>
        </div>
        <div class="setup-layout-account">
            @if (!string.IsNullOrWhiteSpace(AuthSession.Current?.Email))
            {
                <MudText Typo="Typo.caption">@AuthSession.Current.Email</MudText>
            }
            <MudButton Variant="Variant.Text"
                       Class="setup-sign-out"
                       StartIcon="@Icons.Material.Filled.Logout"
                       OnClick="LogoutAsync">
                @L["SetupLayout.SignOut"]
            </MudButton>
        </div>
    </header>

    <main class="setup-layout-content">
        @Body
    </main>
</div>
</div>

@code {
    protected override void OnInitialized() => Appearance.Changed += OnAppearanceChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await Appearance.InitializeAsync(); }
    private void OnAppearanceChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Appearance.Changed -= OnAppearanceChanged;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#18233F",
            Secondary = "#9BE7C2",
            SecondaryContrastText = "#18233F",
            Tertiary = "#9BE7C2",
            Background = "#FFFCF7",
            Surface = "#FFFFFF",
            TextPrimary = "#18233F",
            TextSecondary = "#68738A",
            Success = "#23845C",
            Warning = "#F2B84B",
            Error = "#E85D75"
        }
    };

    private async Task LogoutAsync()
    {
        await AuthenticationApi.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
