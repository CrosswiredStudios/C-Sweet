@using CSweet.Contracts.Setup
@inject ISetupApiClient SetupApi
@implements IAsyncDisposable

<div class="mt-4" aria-live="polite">
    <MudText>Guided Windows upgrade on <strong>@Office.MachineName</strong>. Uses the configured local development installer and preserves this Office's identity, pool, and capacity. Windows will request administrator approval.</MudText>
    @if (_session is null || _session.State is "failed" or "expired" or "revoked" or "ready")
    {
        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || !ReadyForUpgrade)" OnClick="StartAsync">Upgrade Office</MudButton>
    }
    @if (_session is { State: "created" })
    {
        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || !ReadyForUpgrade)" OnClick="LaunchAsync">@(_session.AdministratorApprovalRequestedAt is null ? "Continue with Windows approval" : "Retry Windows approval")</MudButton>
    }
    @if (_session is not null)
    {
        <MudText Class="mt-3"><strong>@_session.PhaseDisplayName</strong></MudText>
        <MudText>@_session.Message</MudText>
        <MudProgressLinear Class="mt-2" Value="@_session.PercentComplete" Color="Color.Primary" />
    }
    @if (_error is not null) { <MudAlert Severity="Severity.Warning" Class="mt-3">@_error</MudAlert> }
</div>

@code {
    [Parameter, EditorRequired] public ExecutionNodeSummaryResponse Office { get; set; } = default!;
    [Parameter] public bool ReadyForUpgrade { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private LocalOfficeSetupSessionResponse? _session;
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _poll;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { Accept(await SetupApi.GetActiveLocalOfficeSetupSessionAsync(_lifetime.Token)); }
        catch (Exception ex) when (ex is HttpRequestException or ApiClientException or TaskCanceledException)
        { _error = "Could not restore upgrade status. Retry before starting another upgrade."; }
        _poll = PollAsync();
    }

    private async Task StartAsync()
    {
        if (_busy || !ReadyForUpgrade) return;
        _busy = true;
        try
        {
            var result = await SetupApi.CreateLocalOfficeSetupSessionAsync(new("custom",
                Office.AllocatableCpuCount, Office.AllocatableMemoryMb, Office.AllocatableDiskMb, Office.Id), _lifetime.Token);
            Accept(result);
            _poll ??= PollAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or ApiClientException or TaskCanceledException)
        { _error = "Could not prepare the upgrade. Refresh Office status and try again."; }
        finally { _busy = false; }
    }

    private void Accept(LocalOfficeSetupActionResponse result)
    {
        _error = result.Succeeded ? null : result.Message;
        if (result.Session is { RecoveryAction: "upgrade" } session && session.UpgradeOfficeId == Office.Id) _session = session;
    }

    private async Task LaunchAsync()
    {
        if (_busy || !ReadyForUpgrade || _session is null) return;
        _busy = true;
        try
        {
            if (_session.LaunchUri is null || _session.AdministratorApprovalRequestedAt is not null)
                Accept(await SetupApi.RefreshLocalOfficeSetupSessionHandoffAsync(_session.Id, _lifetime.Token));
            if (_error is not null || _session.LaunchUri is null) return;
            Accept(await SetupApi.LaunchLocalOfficeSetupSessionAsync(_session.Id, new(_session.LaunchUri), _lifetime.Token));
        }
        catch (Exception ex) when (ex is HttpRequestException or ApiClientException or TaskCanceledException)
        { _error = "Windows setup could not start. Check administrator approval and try again."; }
        finally { _busy = false; }
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
                await InvokeAsync(async () =>
                {
                    if (!_busy && _session is not null)
                    {
                        try { Accept(await SetupApi.GetLocalOfficeSetupSessionAsync(_session.Id, _lifetime.Token)); }
                        catch (Exception ex) when (ex is HttpRequestException or ApiClientException or TaskCanceledException)
                        { _error = "Upgrade status is unavailable. This page will retry automatically."; }
                        await OnChanged.InvokeAsync();
                        StateHasChanged();
                    }
                });
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        if (_poll is not null) await _poll;
        _lifetime.Dispose();
    }
}
