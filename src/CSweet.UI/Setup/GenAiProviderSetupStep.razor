@using CSweet.Contracts.GenAi
@using CSweet.Domain.Setup
@inject IGenAiProviderApiClient Api

<section class="provider-step" aria-labelledby="genai-provider-step-title">
    <header class="provider-step-header">
        <div>
            <MudText Typo="Typo.overline">@ContextLabel</MudText>
            <h1 id="genai-provider-step-title">Connect generative AI providers.</h1>
            <p>Give approved agents least-privilege access to image and video generation or editing. This step is optional.</p>
        </div>
        <div class="provider-count" aria-live="polite">
            <strong>@_profiles.Count</strong>
            <span>@(_profiles.Count == 1 ? "provider connected" : "providers connected")</span>
        </div>
    </header>

    @if (_isDiscoveringLocalProviders)
    {
        <div class="provider-feedback checking provider-discovery-feedback" role="status">
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
            <span>Looking for ComfyUI on this machine...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_localDiscoveryMessage))
    {
        <div class="provider-feedback @_localDiscoveryFeedbackClass provider-discovery-feedback" role="status">
            <MudIcon Icon="@(_localDiscoveryFailed ? Icons.Material.Filled.ErrorOutline : Icons.Material.Filled.CheckCircle)" />
            <span>@_localDiscoveryMessage</span>
        </div>
    }

    <div class="provider-workspace">
        <section class="provider-roster" aria-labelledby="connected-genai-providers-title">
            <div class="provider-section-heading">
                <div>
                    <span class="provider-section-kicker">Your roster</span>
                    <h2 id="connected-genai-providers-title">Connected providers</h2>
                </div>
                @if (_profiles.Count > 0)
                {
                    <span class="provider-ready-badge">Ready to continue</span>
                }
            </div>

            @if (_profiles.Count == 0)
            {
                <div class="provider-empty-state">
                    <MudIcon Icon="@Icons.Material.Outlined.PermMedia" />
                    <strong>Your provider roster is empty</strong>
                    <span>Choose a service on the right, or skip this optional step.</span>
                </div>
            }
            else
            {
                <div class="provider-list">
                    @foreach (var profile in _profiles)
                    {
                        <article class="provider-list-item">
                            <span class="provider-mark">@ProviderMark(profile.ProviderType)</span>
                            <div class="provider-list-copy">
                                <strong>@profile.Name</strong>
                                <span>@ProviderTypeLabel(profile.ProviderType) · @ProviderConnectionLabel(profile)</span>
                            </div>
                            <div class="provider-list-state">
                                <span class="provider-status @(profile.LastSuccessfulConnectionAt.HasValue ? "verified" : "saved")">
                                    @(profile.LastSuccessfulConnectionAt.HasValue ? "Connected" : "Saved")
                                </span>
                                <button type="button"
                                        class="provider-edit-button"
                                        aria-label="Edit @profile.Name"
                                        disabled="@_isBusy"
                                        @onclick="() => EditProvider(profile)">
                                    <MudIcon Icon="@Icons.Material.Outlined.Edit" />
                                </button>
                                <button type="button"
                                        class="provider-delete-button"
                                        aria-label="Delete @profile.Name"
                                        disabled="@_isBusy"
                                        @onclick="() => AskDeleteProvider(profile)">
                                    <MudIcon Icon="@Icons.Material.Outlined.DeleteOutline" />
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="provider-picker" aria-labelledby="add-genai-provider-title">
            <div class="provider-section-heading">
                <div>
                    <span class="provider-section-kicker">Add another</span>
                    <h2 id="add-genai-provider-title">@(_showHosted ? "Choose a hosted provider" : "Choose a local runtime")</h2>
                </div>
                @if (!_showHosted)
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.Refresh"
                               Disabled="@_isDiscoveringLocalProviders"
                               OnClick="DiscoverLocalProvidersAsync">
                        @(_isDiscoveringLocalProviders ? "Scanning..." : "Scan again")
                    </MudButton>
                }
            </div>

            <div class="provider-mode-switch" role="group" aria-label="Provider location">
                <button type="button"
                        class="@(!_showHosted ? "selected" : null)"
                        aria-pressed="@(!_showHosted)"
                        disabled="@_isBusy"
                        @onclick="() => SetProviderMode(false)">
                    <MudIcon Icon="@Icons.Material.Outlined.Computer" />
                    <span>
                        <strong>Local</strong>
                        <small>Runs on your hardware</small>
                    </span>
                </button>
                <button type="button"
                        class="@(_showHosted ? "selected" : null)"
                        aria-pressed="@_showHosted"
                        disabled="@_isBusy"
                        @onclick="() => SetProviderMode(true)">
                    <MudIcon Icon="@Icons.Material.Outlined.CloudQueue" />
                    <span>
                        <strong>Hosted</strong>
                        <small>Connect with an API key</small>
                    </span>
                </button>
            </div>

            <div class="provider-choice-grid">
                @foreach (var preset in ActivePresets)
                {
                    <button type="button"
                            class="provider-choice @(IsActivePreset(preset) ? "selected" : null)"
                            aria-pressed="@IsActivePreset(preset)"
                            disabled="@_isBusy"
                            @onclick="() => SelectPresetAsync(preset)">
                        <span class="provider-choice-mark">@preset.Mark</span>
                        <span>
                            <strong>@preset.DisplayName</strong>
                            <small>@preset.Description</small>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                    </button>
                }
            </div>
        </section>
    </div>

    <MudDialog Visible="_editorOpen" VisibleChanged="OnEditorVisibilityChanged" Options="_editorDialogOptions">
        <DialogContent>
            <section class="provider-editor" aria-labelledby="genai-provider-editor-title">
                <header class="provider-editor-header">
                    <div class="provider-editor-title">
                        <span class="provider-choice-mark">@(_activePreset?.Mark ?? ProviderMark(_providerType))</span>
                        <div>
                            <span class="provider-section-kicker">@(_editingProviderId is null ? "New connection" : "Edit connection")</span>
                            <h2 id="genai-provider-editor-title">@(_activePreset?.DisplayName ?? ProviderTypeLabel(_providerType))</h2>
                        </div>
                    </div>
                    <button type="button" class="provider-close-button" aria-label="Close provider form" disabled="@_isBusy" @onclick="CloseEditor">
                        <MudIcon Icon="@Icons.Material.Filled.Close" />
                    </button>
                </header>

                <div class="provider-form-grid">
                    <MudTextField Label="Provider name"
                                  @bind-Value="_providerName"
                                  Variant="Variant.Outlined"
                                  Disabled="@_isBusy" />
                    <MudSelect T="GenAiProviderType"
                               Label="Provider type"
                               Value="_providerType"
                               ValueChanged="OnProviderTypeChanged"
                               Variant="Variant.Outlined"
                               Disabled="@_isBusy">
                        @foreach (var type in Enum.GetValues<GenAiProviderType>())
                        {
                            <MudSelectItem Value="@type">@ProviderTypeLabel(type)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string"
                                  Class="provider-form-wide"
                                  Label="Base URL"
                                  Value="_baseUrl"
                                  ValueChanged="OnBaseUrlChanged"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Disabled="@_isBusy"
                                  Placeholder="@(_showHosted ? "https://api.example.com" : "http://127.0.0.1:8188")" />
                    <MudTextField T="string"
                                  Class="provider-form-wide"
                                  Label="@ApiKeyLabel"
                                  Value="_apiKey"
                                  ValueChanged="OnApiKeyChanged"
                                  Immediate="true"
                                  InputType="InputType.Password"
                                  Placeholder="@ApiKeyPlaceholder"
                                  Variant="Variant.Outlined"
                                  Disabled="@_isBusy"
                                  autocomplete="off" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_editorMessage))
                {
                    <div class="provider-feedback @(_editorError ? "error" : "success")" role="status">
                        <MudIcon Icon="@(_editorError ? Icons.Material.Filled.ErrorOutline : Icons.Material.Filled.CheckCircle)" />
                        <span>@_editorMessage</span>
                    </div>
                }

                @if (_editingProviderId.HasValue)
                {
                    <section class="provider-operation-section" aria-labelledby="approved-operations-title">
                        <div class="provider-section-heading">
                            <div>
                                <span class="provider-section-kicker">Least privilege</span>
                                <h2 id="approved-operations-title">Approved operations</h2>
                            </div>
                            <MudButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Disabled="@_isBusy"
                                       OnClick="NewOperation">
                                New operation
                            </MudButton>
                        </div>

                        @if (SelectedProfile?.Operations.Count > 0)
                        {
                            <div class="provider-operation-list">
                                @foreach (var operation in SelectedProfile.Operations)
                                {
                                    <article class="provider-operation-item @(operation.Id == _editingOperationId ? "selected" : null)">
                                        <button type="button" class="provider-operation-select" @onclick="() => EditOperation(operation)">
                                            <span class="provider-operation-icon"><MudIcon Icon="@OperationIcon(operation.OperationType)" /></span>
                                            <span>
                                                <strong>@operation.Name</strong>
                                                <small>@OperationLabel(operation.OperationType)@(operation.IsDefault ? " · Default" : null)</small>
                                            </span>
                                        </button>
                                        @if (!operation.IsDefault)
                                        {
                                            <MudButton Variant="Variant.Text"
                                                       Size="Size.Small"
                                                       Disabled="@_isBusy"
                                                       OnClick="@(() => SetDefaultAsync(operation.Id))">
                                                Make default
                                            </MudButton>
                                        }
                                    </article>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="provider-operation-empty">Add an approved model or workflow to define exactly what agents may use.</p>
                        }

                        <div class="provider-operation-form">
                            <MudSelect T="GenAiOperationType"
                                       Label="Least-privilege operation"
                                       @bind-Value="_operationType"
                                       Variant="Variant.Outlined"
                                       Disabled="@_isBusy">
                                @foreach (var type in SupportedOperations)
                                {
                                    <MudSelectItem Value="@type">@OperationLabel(type)</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField Label="Configuration name"
                                          @bind-Value="_operationName"
                                          Variant="Variant.Outlined"
                                          Disabled="@_isBusy" />
                            <MudTextField Class="provider-form-wide"
                                          Label="Model ID"
                                          @bind-Value="_modelId"
                                          Variant="Variant.Outlined"
                                          Disabled="@_isBusy" />
                            @if (UsesTemplate)
                            {
                                <MudTextField Class="provider-form-wide"
                                              Label="@(_providerType == GenAiProviderType.Replicate ? "Prediction input template JSON" : "ComfyUI API workflow JSON")"
                                              @bind-Value="_templateJson"
                                              Lines="6"
                                              Variant="Variant.Outlined"
                                              Disabled="@_isBusy" />
                                <MudTextField Class="provider-form-wide"
                                              Label="@(_providerType == GenAiProviderType.Replicate ? "Output selector (for example: output)" : "Output node ID")"
                                              @bind-Value="_outputSelector"
                                              Variant="Variant.Outlined"
                                              Disabled="@_isBusy" />
                            }
                            <div class="provider-operation-actions">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Secondary"
                                           Disabled="@(_isBusy || string.IsNullOrWhiteSpace(_operationName))"
                                           OnClick="SaveOperationAsync">
                                    @(_isBusy ? "Saving..." : _editingOperationId.HasValue ? "Save operation" : "Add operation")
                                </MudButton>
                            </div>
                        </div>
                    </section>
                }

                <footer class="provider-editor-actions">
                    @if (_editingProviderId.HasValue)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   Disabled="@(_isBusy || !CanTestConnection)"
                                   OnClick="TestConnectionAsync">
                            @(_isTesting ? "Testing..." : "Test connection")
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   Disabled="@(_isBusy || !CanTestConnection)"
                                   OnClick="TestConnectionAsync">
                            @(_isTesting ? "Testing..." : "Test connection")
                        </MudButton>
                    }
                    <span class="provider-editor-spacer"></span>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="@_isBusy" OnClick="CloseEditor">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               Disabled="@(_isBusy || !CanSaveProvider)"
                               OnClick="SaveProviderAsync">
                        @(_isBusy && !_isTesting ? "Saving..." : _editingProviderId is null ? "Connect provider" : "Save changes")
                    </MudButton>
                </footer>
            </section>
        </DialogContent>
    </MudDialog>

    <MudDialog Visible="_deleteDialogOpen" VisibleChanged="OnDeleteDialogVisibilityChanged" Options="_deleteDialogOptions">
        <DialogContent>
            <section class="provider-delete-dialog" aria-labelledby="genai-provider-delete-title">
                <span class="provider-delete-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Outlined.DeleteOutline" />
                </span>
                <div>
                    <span class="provider-section-kicker">Remove connection</span>
                    <h2 id="genai-provider-delete-title">Delete @(_providerPendingDelete?.Name)?</h2>
                    <p>This removes the saved endpoint, its credentials, and its approved operations. You can reconnect it later.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(_deleteMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_deleteMessage</MudAlert>
                }

                <footer class="provider-editor-actions">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="@_isBusy" OnClick="CloseDeleteDialog">Keep provider</MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Outlined.DeleteOutline"
                               Disabled="@(_isBusy || _providerPendingDelete is null)"
                               OnClick="DeleteProviderAsync">
                        @(_isBusy ? "Deleting..." : "Delete provider")
                    </MudButton>
                </footer>
            </section>
        </DialogContent>
    </MudDialog>

    @if (_formSucceeded == true && !string.IsNullOrWhiteSpace(_formMessage))
    {
        <div class="provider-feedback success provider-save-announcement" role="status">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
            <span>@_formMessage Add another provider or continue when you’re ready.</span>
        </div>
    }

    @if (ShowNavigation)
    {
        <footer class="provider-step-actions">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Disabled="@_isBusy"
                       OnClick="OnBack">
                Back
            </MudButton>
            <div>
                <span>@(_profiles.Count == 0
                    ? "This step is optional"
                    : $"{_profiles.Count} {(_profiles.Count == 1 ? "provider" : "providers")} connected")</span>
                @if (_profiles.Count == 0)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="@_isBusy" OnClick="OnContinue">Skip for now</MudButton>
                }
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           EndIcon="@Icons.Material.Filled.ArrowForward"
                           Disabled="@_isBusy"
                           OnClick="OnContinue">
                    Continue
                </MudButton>
            </div>
        </footer>
    }
</section>

@code {
    private static readonly IReadOnlyList<GenAiProviderPreset> LocalPresets =
    [
        new(GenAiProviderType.ComfyUiLocal, "ComfyUI Local", "Run image and video workflows on your hardware.", "http://127.0.0.1:8188", "CU")
    ];

    private static readonly IReadOnlyList<GenAiProviderPreset> HostedPresets =
    [
        new(GenAiProviderType.ComfyUiCloud, "Comfy Cloud", "Run hosted ComfyUI workflows.", "https://cloud.comfy.org", "CC"),
        new(GenAiProviderType.OpenAi, "OpenAI", "Generate and edit images with OpenAI.", "https://api.openai.com", "OA"),
        new(GenAiProviderType.GoogleGemini, "Google Gemini", "Generate and edit media with Gemini.", "https://generativelanguage.googleapis.com", "G"),
        new(GenAiProviderType.Replicate, "Replicate", "Run hosted image and video models.", "https://api.replicate.com", "R")
    ];

    private readonly DialogOptions _editorDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
    private readonly DialogOptions _deleteDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    [Parameter] public string ContextLabel { get; set; } = "Step 3 of 5";
    [Parameter] public bool ShowNavigation { get; set; } = true;
    [Parameter] public bool AutoDiscoverLocalProviders { get; set; }
    [Parameter] public EventCallback LocalProviderDiscoveryAttempted { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnContinue { get; set; }

    private List<GenAiProviderProfileResponse> _profiles = [];
    private GenAiProviderPreset? _activePreset;
    private Guid? _editingProviderId;
    private bool _showHosted;
    private bool _editorOpen;
    private bool _deleteDialogOpen;
    private GenAiProviderProfileResponse? _providerPendingDelete;
    private string? _deleteMessage;
    private bool _isBusy;
    private bool _isTesting;
    private bool _isDiscoveringLocalProviders;
    private bool _localDiscoveryFailed;
    private string? _localDiscoveryMessage;
    private string _localDiscoveryFeedbackClass = "checking";
    private bool _editorError;
    private string? _editorMessage;
    private bool? _formSucceeded;
    private string? _formMessage;

    private string _providerName = string.Empty;
    private GenAiProviderType _providerType = GenAiProviderType.ComfyUiLocal;
    private string _baseUrl = string.Empty;
    private string? _apiKey;
    private bool _hasApiKey;
    private bool _connectionDetailsChanged;
    private bool? _connectionSucceeded;
    private int _connectionValidationVersion;

    private Guid? _editingOperationId;
    private GenAiOperationType _operationType = GenAiOperationType.ImageGeneration;
    private string _operationName = "Default image generation";
    private string? _modelId;
    private string? _templateJson;
    private string? _outputSelector;

    private IReadOnlyList<GenAiProviderPreset> ActivePresets => _showHosted ? HostedPresets : LocalPresets;
    private GenAiProviderProfileResponse? SelectedProfile => _profiles.SingleOrDefault(x => x.Id == _editingProviderId);
    private IReadOnlyList<GenAiOperationType> SupportedOperations => _providerType == GenAiProviderType.OpenAi
        ? [GenAiOperationType.ImageGeneration, GenAiOperationType.ImageEditing]
        : Enum.GetValues<GenAiOperationType>();
    private bool UsesTemplate => _providerType is GenAiProviderType.ComfyUiLocal or GenAiProviderType.ComfyUiCloud or GenAiProviderType.Replicate;
    private bool RequiresApiKey => IsHosted(_providerType);
    private bool CanTestConnection =>
        Uri.TryCreate(_baseUrl, UriKind.Absolute, out var testUri) &&
        testUri.Scheme is "http" or "https" &&
        (!RequiresApiKey || !string.IsNullOrWhiteSpace(_apiKey) || (_editingProviderId.HasValue && _hasApiKey));
    private bool CanSaveProvider =>
        !string.IsNullOrWhiteSpace(_providerName) &&
        Uri.TryCreate(_baseUrl, UriKind.Absolute, out var uri) &&
        uri.Scheme is "http" or "https" &&
        (_editingProviderId.HasValue || !RequiresApiKey || !string.IsNullOrWhiteSpace(_apiKey)) &&
        ((_editingProviderId.HasValue && !_connectionDetailsChanged) || _connectionSucceeded == true);
    private string ApiKeyLabel => _editingProviderId.HasValue && _hasApiKey
        ? "New API key (leave blank to keep saved key)"
        : RequiresApiKey ? "API key" : "API key (optional)";
    private string? ApiKeyPlaceholder => _editingProviderId.HasValue && _hasApiKey
        ? "Saved key"
        : RequiresApiKey ? "Enter the provider API key" : "Leave blank if authentication is disabled";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !AutoDiscoverLocalProviders)
        {
            return;
        }

        await LocalProviderDiscoveryAttempted.InvokeAsync();
        await DiscoverLocalProvidersAsync();
    }

    private async Task LoadAsync()
    {
        _profiles = (await Api.ListAsync()).ToList();
    }

    private async Task DiscoverLocalProvidersAsync()
    {
        if (_isDiscoveringLocalProviders)
        {
            return;
        }

        _isDiscoveringLocalProviders = true;
        _localDiscoveryFailed = false;
        _localDiscoveryMessage = null;
        _localDiscoveryFeedbackClass = "checking";
        await InvokeAsync(StateHasChanged);

        try
        {
            var discovery = await Api.DiscoverLocalAsync();
            _profiles = discovery.Profiles.ToList();
            var added = discovery.Results.Any(x => x.Status == LocalGenAiProviderDiscoveryStatuses.Added);
            var configured = discovery.Results.Any(x => x.Status == LocalGenAiProviderDiscoveryStatuses.AlreadyConfigured);
            if (added)
            {
                _localDiscoveryFeedbackClass = "success";
                _localDiscoveryMessage = "Connected ComfyUI automatically.";
            }
            else if (configured)
            {
                _localDiscoveryFeedbackClass = "success";
                _localDiscoveryMessage = "No new local providers found. ComfyUI is already connected.";
            }
            else
            {
                _localDiscoveryMessage = "No local ComfyUI runtime found. Start it and scan again, or add the endpoint manually.";
            }
        }
        catch
        {
            _localDiscoveryFailed = true;
            _localDiscoveryFeedbackClass = "error";
            _localDiscoveryMessage = "C-Sweet could not scan for local GenAI providers. You can scan again or add one manually.";
        }
        finally
        {
            _isDiscoveringLocalProviders = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SetProviderMode(bool showHosted)
    {
        if (_isBusy || _showHosted == showHosted)
        {
            return;
        }

        _showHosted = showHosted;
        CloseEditor();
    }

    private bool IsActivePreset(GenAiProviderPreset preset) =>
        _editorOpen && _activePreset?.ProviderType == preset.ProviderType;

    private async Task SelectPresetAsync(GenAiProviderPreset preset)
    {
        _activePreset = preset;
        _editingProviderId = null;
        _providerType = preset.ProviderType;
        _providerName = preset.ProviderName;
        _baseUrl = preset.BaseUrl;
        _apiKey = null;
        _hasApiKey = false;
        _connectionDetailsChanged = true;
        InvalidateConnectionValidation();
        NewOperation();
        _editorOpen = true;

        if (!IsHosted(preset.ProviderType))
        {
            await InvokeAsync(StateHasChanged);
            await TestConnectionAsync();
        }
    }

    private void EditProvider(GenAiProviderProfileResponse profile)
    {
        _showHosted = IsHosted(profile.ProviderType);
        _activePreset = LocalPresets.Concat(HostedPresets).FirstOrDefault(x => x.ProviderType == profile.ProviderType);
        _editingProviderId = profile.Id;
        _providerType = profile.ProviderType;
        _providerName = profile.Name;
        _baseUrl = profile.BaseUrl;
        _apiKey = null;
        _hasApiKey = profile.HasApiKey;
        _connectionDetailsChanged = false;
        _connectionSucceeded = profile.LastSuccessfulConnectionAt.HasValue ? true : null;
        _editorMessage = profile.LastSuccessfulConnectionAt.HasValue
            ? "This saved connection has been verified."
            : "Test this saved connection before assigning it to agents.";
        _editorError = false;
        NewOperation();
        _editorOpen = true;
    }

    private void CloseEditor()
    {
        if (_isBusy)
        {
            return;
        }

        _editorOpen = false;
        _activePreset = null;
        _editingProviderId = null;
        InvalidateConnectionValidation();
        NewOperation();
    }

    private void OnEditorVisibilityChanged(bool isVisible)
    {
        if (isVisible)
        {
            _editorOpen = true;
            return;
        }

        CloseEditor();
    }

    private Task OnProviderTypeChanged(GenAiProviderType value)
    {
        _providerType = value;
        _showHosted = IsHosted(value);
        _connectionDetailsChanged = true;
        InvalidateConnectionValidation();
        NewOperation();
        return Task.CompletedTask;
    }

    private Task OnBaseUrlChanged(string value)
    {
        _baseUrl = value;
        _connectionDetailsChanged = true;
        InvalidateConnectionValidation();
        return Task.CompletedTask;
    }

    private Task OnApiKeyChanged(string value)
    {
        _apiKey = value;
        _connectionDetailsChanged = true;
        InvalidateConnectionValidation();
        return Task.CompletedTask;
    }

    private void InvalidateConnectionValidation()
    {
        _connectionValidationVersion++;
        _connectionSucceeded = null;
        _editorMessage = null;
        _editorError = false;
    }

    private async Task SaveProviderAsync()
    {
        if (!CanSaveProvider || _isBusy)
        {
            return;
        }

        _isBusy = true;
        _formSucceeded = null;
        _formMessage = null;
        _editorMessage = null;

        try
        {
            var wasNew = !_editingProviderId.HasValue;
            _ = _editingProviderId.HasValue
                ? await Api.UpdateAsync(_editingProviderId.Value, new(
                    _providerName.Trim(),
                    _providerType,
                    _baseUrl.Trim(),
                    string.IsNullOrWhiteSpace(_apiKey) ? null : _apiKey,
                    ReplaceApiKey: !string.IsNullOrWhiteSpace(_apiKey),
                    IsEnabled: true))
                : await Api.CreateAsync(new(
                    _providerName.Trim(),
                    _providerType,
                    _baseUrl.Trim(),
                    string.IsNullOrWhiteSpace(_apiKey) ? null : _apiKey));

            await LoadAsync();
            _formSucceeded = true;
            _formMessage = wasNew ? "Provider connected." : "Provider changes saved.";
            _editorOpen = false;
            _activePreset = null;
            _editingProviderId = null;
            _connectionDetailsChanged = false;
            _connectionSucceeded = null;
        }
        catch (Exception exception)
        {
            _editorError = true;
            _editorMessage = exception.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        if (!CanTestConnection || _isBusy)
        {
            return;
        }

        var validationVersion = ++_connectionValidationVersion;
        _isBusy = true;
        _isTesting = true;
        _editorMessage = null;

        try
        {
            var result = _editingProviderId.HasValue && !_connectionDetailsChanged
                ? await Api.TestAsync(_editingProviderId.Value)
                : await Api.TestDraftAsync(new(
                    _editingProviderId,
                    _providerType,
                    _baseUrl.Trim(),
                    string.IsNullOrWhiteSpace(_apiKey) ? null : _apiKey,
                    ReplaceApiKey: !string.IsNullOrWhiteSpace(_apiKey)));
            if (validationVersion != _connectionValidationVersion)
            {
                return;
            }

            _editorError = !result.Succeeded;
            _editorMessage = result.Message;
            _connectionSucceeded = result.Succeeded;
            if (_editingProviderId.HasValue)
            {
                await LoadAsync();
            }
        }
        catch (Exception exception)
        {
            if (validationVersion != _connectionValidationVersion)
            {
                return;
            }

            _editorError = true;
            _editorMessage = exception.Message;
            _connectionSucceeded = false;
        }
        finally
        {
            _isTesting = false;
            _isBusy = false;
        }
    }

    private void AskDeleteProvider(GenAiProviderProfileResponse profile)
    {
        if (_isBusy)
        {
            return;
        }

        _providerPendingDelete = profile;
        _deleteMessage = null;
        _formSucceeded = null;
        _formMessage = null;
        _deleteDialogOpen = true;
    }

    private void CloseDeleteDialog()
    {
        if (_isBusy)
        {
            return;
        }

        _deleteDialogOpen = false;
        _providerPendingDelete = null;
        _deleteMessage = null;
    }

    private void OnDeleteDialogVisibilityChanged(bool isVisible)
    {
        if (isVisible)
        {
            _deleteDialogOpen = true;
            return;
        }

        CloseDeleteDialog();
    }

    private async Task DeleteProviderAsync()
    {
        if (_providerPendingDelete is null || _isBusy)
        {
            return;
        }

        _isBusy = true;
        _deleteMessage = null;

        try
        {
            await Api.DeleteAsync(_providerPendingDelete.Id);
            await LoadAsync();
            _deleteDialogOpen = false;
            _providerPendingDelete = null;
            _formSucceeded = true;
            _formMessage = "Provider removed.";
        }
        catch (Exception exception)
        {
            _deleteMessage = exception.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void NewOperation()
    {
        _editingOperationId = null;
        _operationType = GenAiOperationType.ImageGeneration;
        _operationName = "Default image generation";
        _modelId = null;
        _templateJson = null;
        _outputSelector = _providerType == GenAiProviderType.Replicate ? "output" : null;
    }

    private void EditOperation(GenAiOperationConfigurationResponse operation)
    {
        _editingOperationId = operation.Id;
        _operationType = operation.OperationType;
        _operationName = operation.Name;
        _modelId = operation.ModelId;
        _templateJson = operation.TemplateJson;
        _outputSelector = operation.OutputSelector;
        _editorMessage = null;
    }

    private async Task SaveOperationAsync()
    {
        if (!_editingProviderId.HasValue || string.IsNullOrWhiteSpace(_operationName) || _isBusy)
        {
            return;
        }

        _isBusy = true;
        _editorMessage = null;

        try
        {
            await Api.SaveOperationAsync(
                _editingProviderId.Value,
                _editingOperationId,
                new(
                    _operationType,
                    _operationName.Trim(),
                    string.IsNullOrWhiteSpace(_modelId) ? null : _modelId.Trim(),
                    string.IsNullOrWhiteSpace(_templateJson) ? null : _templateJson,
                    string.IsNullOrWhiteSpace(_outputSelector) ? null : _outputSelector.Trim(),
                    DefaultsJson: null,
                    IsEnabled: true));
            await LoadAsync();
            _editorError = false;
            _editorMessage = _editingOperationId.HasValue ? "Approved operation updated." : "Approved operation added.";
            NewOperation();
        }
        catch (Exception exception)
        {
            _editorError = true;
            _editorMessage = exception.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SetDefaultAsync(Guid operationId)
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _editorMessage = null;

        try
        {
            await Api.SetDefaultAsync(operationId);
            await LoadAsync();
            _editorError = false;
            _editorMessage = "Default operation updated.";
        }
        catch (Exception exception)
        {
            _editorError = true;
            _editorMessage = exception.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static bool IsHosted(GenAiProviderType type) => type != GenAiProviderType.ComfyUiLocal;

    private static string ProviderMark(GenAiProviderType type) => type switch
    {
        GenAiProviderType.ComfyUiLocal => "CU",
        GenAiProviderType.ComfyUiCloud => "CC",
        GenAiProviderType.OpenAi => "OA",
        GenAiProviderType.GoogleGemini => "G",
        GenAiProviderType.Replicate => "R",
        _ => "AI"
    };

    private static string ProviderTypeLabel(GenAiProviderType type) => type switch
    {
        GenAiProviderType.ComfyUiLocal => "ComfyUI Local",
        GenAiProviderType.ComfyUiCloud => "Comfy Cloud",
        GenAiProviderType.OpenAi => "OpenAI",
        GenAiProviderType.GoogleGemini => "Google Gemini",
        GenAiProviderType.Replicate => "Replicate",
        _ => type.ToString()
    };

    private static string ProviderConnectionLabel(GenAiProviderProfileResponse profile) =>
        Uri.TryCreate(profile.BaseUrl, UriKind.Absolute, out var uri) ? uri.Host : profile.BaseUrl;

    private static string OperationLabel(GenAiOperationType type) => type switch
    {
        GenAiOperationType.ImageGeneration => "Image generation",
        GenAiOperationType.ImageEditing => "Image editing",
        GenAiOperationType.VideoGeneration => "Video generation",
        GenAiOperationType.VideoEditing => "Video editing",
        _ => type.ToString()
    };

    private static string OperationIcon(GenAiOperationType type) => type switch
    {
        GenAiOperationType.ImageGeneration => Icons.Material.Outlined.Image,
        GenAiOperationType.ImageEditing => Icons.Material.Outlined.AutoFixHigh,
        GenAiOperationType.VideoGeneration => Icons.Material.Outlined.MovieCreation,
        GenAiOperationType.VideoEditing => Icons.Material.Outlined.VideoSettings,
        _ => Icons.Material.Outlined.PermMedia
    };

    private sealed record GenAiProviderPreset(
        GenAiProviderType ProviderType,
        string DisplayName,
        string Description,
        string BaseUrl,
        string Mark)
    {
        public string ProviderName => DisplayName;
    }
}
