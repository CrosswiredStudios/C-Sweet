<section class="setup-welcome" aria-labelledby="setup-welcome-title">
    <div class="setup-welcome-copy">
        <MudText Typo="Typo.overline">Welcome to C-Sweet</MudText>
        <h1 id="setup-welcome-title">Build your AI workplace.</h1>
        <p>
            Give your team a place to run and a provider to think with. That's all you need to begin.
        </p>

    </div>

    <ol class="setup-promise-list" aria-label="What setup includes">
        <li>
            <span class="setup-promise-number"><MudIcon Icon="@Icons.Material.Outlined.Computer" /></span>
            <div>
                <strong>A place to work</strong>
                <small>Choose this computer or connect an office, then verify the available capacity.</small>
            </div>
        </li>
        <li>
            <span class="setup-promise-number"><MudIcon Icon="@Icons.Material.Outlined.Hub" /></span>
            <div>
                <strong>The models behind your team</strong>
                <small>Connect a local runtime or a hosted AI provider.</small>
            </div>
        </li>
    </ol>

    <footer class="setup-welcome-actions">
        <span>Creative tools are optional.</span>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward"
                   Disabled="@IsBusy"
                   OnClick="OnContinue">
            @(IsBusy ? "Starting..." : "Start setup")
        </MudButton>
    </footer>
</section>

@code {
    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback OnContinue { get; set; }
}
