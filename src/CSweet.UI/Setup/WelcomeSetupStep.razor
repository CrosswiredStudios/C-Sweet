<section class="setup-welcome" aria-labelledby="setup-welcome-title">
    <div class="setup-welcome-copy">
        <MudText Typo="Typo.overline">Welcome to C-Sweet</MudText>
        <h1 id="setup-welcome-title">Your AI workforce starts here.</h1>
        <p>
            We’ll prepare where your agents run, connect the AI providers they use, and help you choose
            optional email and communication integrations. You can revisit these settings as your organization grows.
        </p>

    </div>

    <ol class="setup-promise-list" aria-label="What setup includes">
        <li>
            <span class="setup-promise-number">1</span>
            <div>
                <strong>Prepare agent execution</strong>
                <small>Choose this computer or connect an office, then verify the available capacity.</small>
            </div>
        </li>
        <li>
            <span class="setup-promise-number">2</span>
            <div>
                <strong>Connect AI providers</strong>
                <small>Add and verify an LLM provider, with optional providers for generated media.</small>
            </div>
        </li>
        <li>
            <span class="setup-promise-number">3</span>
            <div>
                <strong>Choose your integrations</strong>
                <small>Configure optional email and communication channels now, or return to them later.</small>
            </div>
        </li>
    </ol>

    <footer class="setup-welcome-actions">
        <span>Plan for about 15–30 minutes</span>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward"
                   Disabled="@IsBusy"
                   OnClick="OnContinue">
            @(IsBusy ? "Starting..." : "Start setup")
        </MudButton>
    </footer>
</section>

@code {
    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback OnContinue { get; set; }
}
