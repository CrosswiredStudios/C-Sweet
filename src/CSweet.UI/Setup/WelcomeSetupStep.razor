@inject IAppLocalizer L
<section class="setup-welcome" aria-labelledby="setup-welcome-title">
    <div class="setup-welcome-copy">
        <MudText Typo="Typo.overline">@L["WelcomeSetupStep.WelcomeToCSweet"]</MudText>
        <h1 id="setup-welcome-title">@L["WelcomeSetupStep.BuildYourAIWorkplace"]</h1>
        <p>
            @L["WelcomeSetupStep.ConnectAPlaceToWork"]
        </p>

    </div>

    <ol class="setup-promise-list" aria-label="@L["WelcomeSetupStep.WhatSetupIncludes"]">
        <li>
            <span class="setup-promise-number"><MudIcon Icon="@Icons.Material.Outlined.Computer" /></span>
            <div>
                <strong>@L["WelcomeSetupStep.APlaceToWork"]</strong>
                <small>@L["WelcomeSetupStep.ChooseThisComputerOrConnect"]</small>
            </div>
        </li>
        <li>
            <span class="setup-promise-number"><MudIcon Icon="@Icons.Material.Outlined.Hub" /></span>
            <div>
                <strong>@L["WelcomeSetupStep.TheModelsBehindYourTeam"]</strong>
                <small>@L["WelcomeSetupStep.ConnectALocalRuntimeOr"]</small>
            </div>
        </li>
        <li>
            <span class="setup-promise-number"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" /></span>
            <div><strong>@L["WelcomeSetupStep.YourOwnAIAssistant"]</strong><small>@L["WelcomeSetupStep.ChooseItsNameModelAnd"]</small></div>
        </li>
    </ol>

    <footer class="setup-welcome-actions">
        <span>@L["WelcomeSetupStep.CreativeToolsAreOptional"]</span>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward"
                   Disabled="@IsBusy"
                   OnClick="OnContinue">
            @(IsBusy ? "Starting..." : "Start setup")
        </MudButton>
    </footer>
</section>

@code {
    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback OnContinue { get; set; }
}
