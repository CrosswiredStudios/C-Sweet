@using CSweet.Contracts.Setup
@inject ISetupApiClient SetupApi
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="host-onboarding" aria-labelledby="host-onboarding-title">
    <header class="host-onboarding-header">
        <MudText Typo="Typo.overline">Step 2 of 6</MudText>
        <h1 id="host-onboarding-title">Where should your agents work?</h1>
        <p>Choose the first machine that will securely build and run your agents.</p>
    </header>

    @if (_loading)
    {
        <div class="host-feedback checking" role="status" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
            <span>Checking for an Office...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="host-feedback error" role="alert">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" />
            <div><strong>We couldn't check your Offices.</strong><span>@_error</span></div>
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="RefreshAsync">Try again</MudButton>
        </div>
    }
    else if (_status is not null)
    {
        <div class="host-location-grid" role="group" aria-label="Office location">
            <button type="button"
                    class="host-location-card @TargetClass("local")"
                    aria-pressed="@(_installationTarget == "local")"
                    disabled="@_busy"
                    @onclick='@(() => SelectInstallationTargetAsync("local"))'>
                <span class="host-location-icon"><MudIcon Icon="@Icons.Material.Outlined.Computer" /></span>
                <span class="host-location-copy">
                    <strong>This machine</strong>
                    <small>Install C-Sweet Office here. You can add additional machines later.</small>
                    @if (_status?.LocalCapacity is { } machineCapacity)
                    {
                        <small class="host-machine-stats">
                            @FormatGb(machineCapacity.TotalMemoryMb) GB memory · @machineCapacity.TotalCpuCount CPU cores · @FormatGb(machineCapacity.FreeDiskMb) GB free
                        </small>
                    }
                </span>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="host-location-check" />
            </button>
            <button type="button"
                    class="host-location-card @TargetClass("remote")"
                    aria-pressed="@(_installationTarget == "remote")"
                    disabled="@(_busy || LocalSetupLocksLocation)"
                    @onclick='@(() => SelectInstallationTargetAsync("remote"))'>
                <span class="host-location-icon"><MudIcon Icon="@Icons.Material.Outlined.Devices" /></span>
                <span class="host-location-copy">
                    <strong>Another machine</strong>
                    <small>Install C-Sweet Office on another Windows, Linux, or macOS machine.</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="host-location-check" />
            </button>
        </div>

        @if (_installationTarget == "local")
        {
            @LocalExperience()
        }
        else
        {
            @RemoteExperience()
        }

        @if (!string.IsNullOrWhiteSpace(_actionMessage) &&
             (_installationTarget == "remote" || !_actionSucceeded))
        {
            <div class="host-feedback @(_actionSucceeded ? "success" : "warning")" role="status" aria-live="polite">
                <MudIcon Icon="@(_actionSucceeded ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Info)" />
                <span>@_actionMessage</span>
            </div>
        }
    }

    @if (_installationTarget == "remote")
    {
        <footer class="host-onboarding-actions">
            <MudButton Variant="Variant.Text" Disabled="@_busy" OnClick="OnBack">Back</MudButton>
            <div>
                @if (_status?.IsReady != true)
                {
                    <span>Connect one healthy Office to continue</span>
                }
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           EndIcon="@Icons.Material.Filled.ArrowForward"
                           Disabled="@(_busy || _loading || _status?.IsReady != true)"
                           OnClick="OnContinue">Continue</MudButton>
            </div>
        </footer>
    }
</section>

@code {
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnContinue { get; set; }

    private readonly HashSet<Guid> _remoteApprovalInFlight = [];
    private ExecutionCapacityOnboardingResponse? _status;
    private ExecutionEnrollmentResponse? _issuedEnrollment;
    private IJSObjectReference? _jsModule;
    private CancellationTokenSource? _polling;
    private string _remotePlatform = "windows";
    private string _installationTarget = "local";
    private string _capacityPreset = "balanced";
    private bool _capacityPresetInitialized;
    private int _customCpuCount;
    private int _customMemoryGb;
    private int _customStorageGb;
    private bool _customInitialized;
    private LocalOfficeSetupSessionResponse? _localSession;
    private DateTimeOffset? _localLaunchAttemptedAt;
    private int _localLaunchAttempts;
    private bool _localApprovalRequested;
    private bool _removedOfficeRestartInFlight;
    private bool _loading = true;
    private bool _busy;
    private bool _automaticEnrollmentInFlight;
    private long _statusMutationVersion;
    private bool _actionSucceeded;
    private string? _actionMessage;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        await RestoreActiveLocalSetupAsync();
        StartPolling();
    }

    private async Task RefreshAsync()
    {
        try
        {
            var status = await SetupApi.GetExecutionCapacityStatusAsync();
            await AcceptStatusAsync(status);
            _error = null;
        }
        catch
        {
            _error = "Check the connection and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectInstallationTargetAsync(string target)
    {
        if (target == "remote" && LocalSetupLocksLocation) return;
        _installationTarget = target;
        if (target == "local") return;
        BeginStatusMutation();
        _busy = true;
        _actionMessage = null;
        try
        {
            var result = await SetupApi.SelectExecutionModeAsync("remote");
            Apply(result);
            if (result.Succeeded)
                await EnsureRemoteEnrollmentAsync();
        }
        catch
        {
            SetAction(false, "The C-Sweet Office location could not be saved. Try again.");
        }
        finally
        {
            _busy = false;
            EndStatusMutation();
        }
    }

    private async Task StartLocalInstallAsync()
    {
        if (_busy || _localSession is not null || _status?.LocalCapacity is null || !LocalAllocationIsValid) return;
        BeginStatusMutation();
        _busy = true;
        _actionMessage = null;
        try
        {
            var allocation = SelectedAllocation;
            var result = await SetupApi.CreateLocalOfficeSetupSessionAsync(new(
                _capacityPreset, allocation.CpuCount, allocation.MemoryMb, allocation.DiskMb));
            _status = result.Status;
            _localSession = result.Session;
            AdoptLocalSession(result.Session);
            if (_localSession is { State: "created", LaunchUri: null,
                    AdministratorApprovalRequestedAt: null })
                await RefreshLocalHandoffAsync();
            SetAction(result.Succeeded, result.Message);
        }
        catch
        {
            SetAction(false, "The assisted Office setup could not be started. Try again.");
        }
        finally
        {
            _busy = false;
            EndStatusMutation();
        }
    }

    private async Task LaunchLocalConfiguratorAsync()
    {
        if (_localSession?.LaunchUri is not { Length: > 0 } uri) return;
        _localLaunchAttemptedAt = DateTimeOffset.UtcNow;
        _localLaunchAttempts++;
        await (await ModuleAsync()).InvokeVoidAsync("launchExternalUri", uri);
    }

    private async Task RequestAdministratorApprovalAsync()
    {
        if (_localSession?.LaunchUri is not { Length: > 0 } launchUri) return;
        BeginStatusMutation();
        _busy = true;
        _actionMessage = null;
        try
        {
            var result = await SetupApi.LaunchLocalOfficeSetupSessionAsync(
                _localSession.Id, new LaunchLocalOfficeSetupRequest(launchUri));
            _status = result.Status;
            _localSession = result.Session ?? _localSession;
            SetAction(result.Succeeded, result.Message);
            if (!result.Succeeded) return;
            _localApprovalRequested = true;
            _localLaunchAttemptedAt = DateTimeOffset.UtcNow;
            _localLaunchAttempts++;
            if (_localSession.LaunchMethod != "server")
                await LaunchLocalConfiguratorAsync();
        }
        catch
        {
            SetAction(false, "C-Sweet could not request Windows administrator approval. Try again.");
        }
        finally
        {
            _busy = false;
            EndStatusMutation();
        }
    }

    private async Task RetryLocalSetupAsync()
    {
        if (_localSession?.State == "created")
        {
            if (!await RefreshLocalHandoffAsync()) return;
        }
        await RequestAdministratorApprovalAsync();
    }

    private async Task SelectLocalRecoveryAsync(string action)
    {
        if (_busy || _localSession?.State != "recoveryrequired") return;
        if (action == "remove")
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                "Remove C-Sweet Office from this computer? This permanently destroys Office services, cached artifacts, mutable runtime data, and Office-owned virtual machines. Orphaned work cannot be recovered.");
            if (!confirmed) return;
        }
        else if (action == "reconnect")
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                "Reassign this Office to the new Headquarters? Windows has verified that no assignments or Office-owned virtual machines remain. The installed Office will be retained, while its old Headquarters identity and disposable caches are cleared.");
            if (!confirmed) return;
        }

        BeginStatusMutation();
        _busy = true;
        _actionMessage = null;
        var launch = false;
        try
        {
            var result = await SetupApi.SelectLocalOfficeRecoveryAsync(_localSession.Id, action);
            _status = result.Status;
            if (result.Session is not null) AdoptLocalSession(result.Session);
            SetAction(result.Succeeded, result.Message);
            launch = result.Succeeded && _localSession?.LaunchUri is { Length: > 0 };
        }
        catch
        {
            SetAction(false, action == "remove"
                ? "C-Sweet could not authorize Office removal. Try again."
                : "C-Sweet could not authorize Office reassignment. Try again.");
        }
        finally
        {
            _busy = false;
            EndStatusMutation();
        }
        if (launch) await RequestAdministratorApprovalAsync();
    }

    private Task ReconnectLocalOfficeAsync() => SelectLocalRecoveryAsync("reconnect");
    private Task RemoveLocalOfficeAsync() => SelectLocalRecoveryAsync("remove");

    private async Task RestoreActiveLocalSetupAsync()
    {
        try
        {
            var result = await SetupApi.GetActiveLocalOfficeSetupSessionAsync();
            if (result.Session is null)
            {
                if (_localSession?.State == "removalinprogress") await ResetLocalSetupAsync();
                return;
            }
            _status = result.Status;
            AdoptLocalSession(result.Session);
            if (_localSession is { State: "created", LaunchUri: null,
                    AdministratorApprovalRequestedAt: null })
                await RefreshLocalHandoffAsync();
        }
        catch
        {
            // Status polling retries active-session discovery without blocking onboarding.
        }
    }

    private void AdoptLocalSession(LocalOfficeSetupSessionResponse? session)
    {
        if (session is null) return;
        _installationTarget = "local";
        _localSession = session;
        _localApprovalRequested = session.AdministratorApprovalRequestedAt is not null ||
            session.State is "redeemed" or "connected" or "ready";
        _localLaunchAttemptedAt = session.AdministratorApprovalRequestedAt;
        _localLaunchAttempts = session.AdministratorApprovalRequestedAt is null ? 0 : 1;
    }

    private async Task<bool> RefreshLocalHandoffAsync()
    {
        if (_localSession is null) return false;
        try
        {
            var result = await SetupApi.RefreshLocalOfficeSetupSessionHandoffAsync(_localSession.Id);
            _status = result.Status;
            if (!result.Succeeded || result.Session is null)
            {
                SetAction(false, result.Message);
                return false;
            }
            AdoptLocalSession(result.Session);
            return true;
        }
        catch
        {
            SetAction(false, "C-Sweet could not restore the secure Windows approval request. Try again.");
            return false;
        }
    }

    private Task ResetLocalSetupAsync()
    {
        _localSession = null;
        _localLaunchAttemptedAt = null;
        _localLaunchAttempts = 0;
        _localApprovalRequested = false;
        _actionMessage = null;
        return Task.CompletedTask;
    }

    private async Task ContinueAfterRemovedOfficeAsync()
    {
        if (_busy || _removedOfficeRestartInFlight || _localSession is not { State: "removed" } removed) return;
        _removedOfficeRestartInFlight = true;
        BeginStatusMutation();
        _busy = true;
        _actionMessage = null;
        var launch = false;
        try
        {
            var result = await SetupApi.CreateLocalOfficeSetupSessionAsync(new(
                "custom", removed.AllocatableCpuCount, removed.AllocatableMemoryMb, removed.AllocatableDiskMb));
            _status = result.Status;
            if (result.Session is not null) AdoptLocalSession(result.Session);
            if (_localSession is { State: "created", LaunchUri: null,
                    AdministratorApprovalRequestedAt: null })
                await RefreshLocalHandoffAsync();
            SetAction(result.Succeeded, result.Message);
            launch = result.Succeeded && _localSession?.LaunchUri is { Length: > 0 };
        }
        catch
        {
            SetAction(false, "The old Office was removed, but the fresh installation could not be started. Try again.");
        }
        finally
        {
            _busy = false;
            _removedOfficeRestartInFlight = false;
            EndStatusMutation();
        }
        if (launch) await RequestAdministratorApprovalAsync();
    }

    private async Task EnsureRemoteEnrollmentAsync()
    {
        if (_status is null || _automaticEnrollmentInFlight ||
            _status.IsReady || _status.ActiveEnrollment is not null ||
            _status.Nodes.Any(node => node.Status is "pendingapproval" or "ready"))
            return;

        _automaticEnrollmentInFlight = true;
        BeginStatusMutation();
        try
        {
            var result = await SetupApi.CreateExecutionEnrollmentAsync();
            Apply(result);
            if (result.Succeeded)
                _issuedEnrollment = result.Enrollment;
        }
        catch
        {
            SetAction(false, "Connection instructions could not be created. Try again.");
        }
        finally
        {
            _automaticEnrollmentInFlight = false;
            EndStatusMutation();
        }
    }

    private async Task ReplaceRemoteEnrollmentAsync()
    {
        if (_status?.ActiveEnrollment is not { Status: "available" } active) return;
        BeginStatusMutation();
        _busy = true;
        _actionMessage = null;
        try
        {
            var revoked = await SetupApi.RevokeExecutionEnrollmentAsync(active.Id);
            Apply(revoked);
            if (!revoked.Succeeded) return;
            _issuedEnrollment = null;
            var replacement = await SetupApi.CreateExecutionEnrollmentAsync();
            Apply(replacement);
            if (!replacement.Succeeded || replacement.Enrollment?.EnrollmentToken is not { Length: > 0 })
                return;
            _issuedEnrollment = replacement.Enrollment;
            SetAction(true, "A new connection code is ready. Copy it and run the Office installer again; the previous code no longer works.");
        }
        catch
        {
            SetAction(false, "A new connection code could not be generated. Try again.");
        }
        finally
        {
            _busy = false;
            EndStatusMutation();
        }
    }

    private async Task ApproveRemoteAsync(Guid nodeId)
    {
        if (!_remoteApprovalInFlight.Add(nodeId)) return;
        BeginStatusMutation();
        _busy = true;
        try
        {
            var result = await SetupApi.ApproveExecutionNodeAsync(nodeId);
            Apply(result);
        }
        catch (ApiClientException exception)
        {
            SetAction(false, $"The C-Sweet control plane could not complete approval. {exception.Message}");
        }
        catch
        {
            SetAction(false, "The C-Sweet control plane could not complete approval. Check the server logs and try again.");
        }
        finally
        {
            _remoteApprovalInFlight.Remove(nodeId);
            _busy = false;
            EndStatusMutation();
        }
    }

    private async Task RejectRemoteAsync(Guid nodeId)
    {
        BeginStatusMutation();
        _busy = true;
        try
        {
            var result = await SetupApi.RejectExecutionNodeAsync(nodeId);
            Apply(result);
            if (result.Succeeded)
                await EnsureRemoteEnrollmentAsync();
        }
        catch
        {
            SetAction(false, "This C-Sweet Office could not be rejected. Try again.");
        }
        finally
        {
            _busy = false;
            EndStatusMutation();
        }
    }

    private RenderFragment LocalExperience() => @<section class="host-workspace local-wizard" aria-labelledby="local-host-title">
        <header class="local-wizard-heading">
            <div>
                <span class="host-section-kicker">Local Office setup &nbsp;·&nbsp; @LocalStepNumber of 4</span>
                <h2 id="local-host-title">@LocalTitle</h2>
                <p>@LocalSubtitle</p>
            </div>
            <ol class="local-stage-track" aria-label="Local Office setup progress">
                @foreach (var stage in LocalStages)
                {
                    <li class="@LocalStageClass(stage.Number)">
                        <span>@stage.Number</span><small>@stage.Label</small>
                    </li>
                }
            </ol>
        </header>

        @if (_localSession is null)
        {
            @if (_status?.LocalCapacity is not { IsSupported: true } capacity)
            {
                <div class="host-inline-notice warning" role="alert">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" />
                    <span>@(_status?.LocalCapacity?.UnavailableReason ?? "Assisted local setup is unavailable on this machine.")</span>
                </div>
            }
            else
            {
                <div class="capacity-card-grid" role="radiogroup" aria-label="Office capacity profile">
                    @foreach (var option in CapacityOptions)
                    {
                        <button type="button" role="radio" aria-checked="@(_capacityPreset == option.Key)"
                                class="capacity-option @(_capacityPreset == option.Key ? "selected" : null)"
                                @onclick="() => SelectCapacityPreset(option.Key)">
                            @if (option.Key == RecommendedPresetKey) { <span class="capacity-recommended">Recommended</span> }
                            <MudIcon Icon="@option.Icon" />
                            <strong>@option.Name</strong>
                            <small>@option.Description</small>
                            @if (option.Key != "custom")
                            {
                                var preset = capacity.Presets.Single(x => x.Key == option.Key);
                                <b>@preset.PercentOfSafeCapacity%</b>
                                <span>@FormatGb(preset.MemoryMb) GB · @preset.CpuCount cores</span>
                            }
                            else
                            {
                                <b>Exact limits</b><span>Memory, CPU, and storage</span>
                            }
                        </button>
                    }
                </div>

                @if (_capacityPreset == "custom")
                {
                    <fieldset class="custom-allocation">
                        <legend>Custom allocation</legend>
                        <div class="allocation-input-grid">
                            @AllocationEditor("Memory", _customMemoryGb, "GB", "memory")
                            @AllocationEditor("CPU", _customCpuCount, "cores", "cpu")
                            @AllocationEditor("Storage", _customStorageGb, "GB", "storage")
                        </div>
                        <small class="@(LocalAllocationIsValid ? null : "invalid")">@CustomAllocationHint</small>
                    </fieldset>
                }
            }
        }
        else
        {
            @if (_localSession.State == "created" && !_localApprovalRequested)
            {
                <div class="local-approval-explanation">
                    <span class="local-approval-icon"><MudIcon Icon="@Icons.Material.Outlined.AdminPanelSettings" /></span>
                    <div>
                        <strong>Why administrator approval is needed</strong>
                        <p>C-Sweet uses Hyper-V to give agents an isolated, secure virtual machine runtime. Administrator approval lets C-Sweet:</p>
                        <ul>
                            <li>Enable and verify the required Windows virtualization features</li>
                            <li>Create and certify the secure VM runtime images</li>
                            <li>Install the Office background services on this machine</li>
                        </ul>
                        <small>Windows will show one administrator approval prompt. Setup continues automatically after you approve it.</small>
                    </div>
                </div>
                @if (_localSession.LaunchUri is null)
                {
                    <div class="host-inline-notice warning">
                        <MudIcon Icon="@Icons.Material.Outlined.Info" />
                        <div><strong>The secure request cannot be reopened</strong><span>Start again to create a fresh administrator approval request.</span></div>
                    </div>
                    <div class="local-install-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Refresh"
                                   OnClick="ResetLocalSetupAsync">Start again</MudButton>
                    </div>
                }
                else
                {
                    <div class="local-install-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.AdminPanelSettings"
                                   Disabled="@_busy" OnClick="RequestAdministratorApprovalAsync">
                            @(_busy ? "Requesting approval…" : "Continue to Windows approval")
                        </MudButton>
                    </div>
                }
            }
            else
            {
                @if (_localSession.State == "recoveryrequired")
                {
                    <div class="local-approval-explanation" role="alert">
                        <span class="host-error-icon"><MudIcon Icon="@Icons.Material.Outlined.SyncProblem" /></span>
                        <div>
                            <strong>Existing Office found</strong>
                            <p>@_localSession.Message</p>
                            <small>Reassignment keeps the installed Office, creates a fresh Headquarters identity, and clears old trust and disposable caches. It proceeds only after Windows verifies that no assignments, authorized workloads, or Office-owned virtual machines remain.</small>
                        </div>
                    </div>
                    <div class="local-install-actions">
                        @if (_localSession.RecoveryCanReconnect)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Outlined.Sync"
                                       Disabled="@_busy" OnClick="ReconnectLocalOfficeAsync">
                                @(_busy ? "Preparing…" : "Reassign this Office")
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                   StartIcon="@Icons.Material.Outlined.DeleteForever"
                                   Disabled="@_busy" OnClick="RemoveLocalOfficeAsync">
                            Remove Office
                        </MudButton>
                    </div>
                    @if (!_localSession.RecoveryCanReconnect)
                    {
                        <div class="host-inline-notice warning">
                            <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" />
                            <span>Reassignment is blocked because active or untrusted local state remains. Removal permanently destroys orphaned work and Office-owned virtual machines.</span>
                        </div>
                    }
                }
                else
                {
                <div class="local-session-progress" role="status" aria-live="polite">
                @if (_localSession.State == "ready")
                {
                    <span class="host-ready-icon"><MudIcon Icon="@Icons.Material.Filled.Check" /></span>
                }
                else if (LocalSetupStartStalled)
                {
                    <span class="host-error-icon"><MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" /></span>
                }
                else
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                }
                <div><strong>@LocalProgressTitle</strong><span>@LocalProgressMessage</span></div>
                </div>
                @if (_localSession.State != "created")
                {
                    <MudProgressLinear Value="@LocalProgressPercent" Color="Color.Primary" />
                    <div class="local-progress-meta">
                        <span>@LocalProgressPercent% complete</span>
                        @if (_localSession.State == "ready")
                        {
                            <span>Setup complete</span>
                        }
                        else if (LocalProgressEta is { } localEta)
                        {
                            <span>@localEta</span>
                        }
                        else
                        {
                            <span>Estimating time remaining…</span>
                        }
                    </div>
                }
                @if (_localSession.State is "failed" or "expired" or "revoked")
                {
                    <div class="local-install-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Refresh"
                                   OnClick="ResetLocalSetupAsync">Start again</MudButton>
                    </div>
                }
                else if (ShowLocalLaunchRetry)
                {
                    <div class="local-install-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AdminPanelSettings"
                                   OnClick="RetryLocalSetupAsync">Try Windows setup again</MudButton>
                    </div>
                }
                }
            }
        }

        <footer class="local-wizard-actions">
            <MudButton Variant="Variant.Text" Disabled="@_busy" OnClick="OnBack">Back</MudButton>
            @if (_localSession?.State == "ready")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                           OnClick="OnContinue">Continue</MudButton>
            }
            else if (_localSession is null)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                           Disabled="@(_busy || !LocalAllocationIsValid)" OnClick="StartLocalInstallAsync">
                    @(_busy ? "Creating Office..." : "Create an Office")
                </MudButton>
            }
        </footer>
    </section>;

    private RenderFragment RemoteExperience() => @<section class="host-workspace" aria-labelledby="remote-host-title">
        @if (_status?.IsReady == true)
        {
            <div class="host-ready-state" role="status" aria-live="polite">
                <span class="host-ready-icon"><MudIcon Icon="@Icons.Material.Filled.Check" /></span>
                <div><strong id="remote-host-title">Your C-Sweet Office is ready</strong><span>@TargetReadyMessage</span></div>
            </div>
        }
        else
        {
            <div class="remote-layout">
                <div class="remote-instructions">
                    <div class="host-progress-heading">
                        <div>
                            <span class="host-section-kicker">@TargetKicker</span>
                            <h2 id="remote-host-title">Install a C-Sweet Office</h2>
                        </div>
                    </div>
                    <div class="host-platform-picker" role="group" aria-label="C-Sweet Office operating system">
                        @foreach (var platform in RemotePlatforms)
                        {
                            <button type="button" class="@(platform.Key == _remotePlatform ? "selected" : null)"
                                    aria-pressed="@(platform.Key == _remotePlatform)" disabled="@_busy"
                                    @onclick="() => _remotePlatform = platform.Key">
                                <MudIcon Icon="@platform.Icon" /><span>@platform.Label</span>
                            </button>
                        }
                    </div>

                    @if (_status?.Packages is { } packages && !string.IsNullOrWhiteSpace(packages.ControlPlaneUrl))
                    {
                        <ol class="remote-steps">
                            <li>
                                <span>1</span>
                                    <div><strong>Install the signed package</strong><small>@PackageLocationInstruction</small></div>
                                @if (SelectedPackageUrl(packages) is { Length: > 0 } packageUrl)
                                {
                                    <MudButton Href="@packageUrl" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Download">Download</MudButton>
                                }
                                else
                                {
                                    <small class="remote-unavailable">The package has not been published for this deployment.</small>
                                }
                            </li>
                            <li>
                                <span>2</span>
                                <div><strong>Run the setup command</strong><small>The installer verifies TLS and asks before trusting a private certificate only for Office.</small></div>
                                <div class="host-copy-field">
                                    <code>@InstallCommand(packages.ControlPlaneUrl!)</code>
                                    <MudButton Variant="Variant.Text" OnClick="() => CopyCommandAsync(packages.ControlPlaneUrl!)">Copy</MudButton>
                                </div>
                            </li>
                            <li>
                                <span>3</span>
                                <div><strong>Enter the connection code</strong><small>@ConnectionCodeHint</small></div>
                                @if (PendingNodes.Count > 0 || _status.ActiveEnrollment is { Status: "claimed" })
                                {
                                    <div class="host-inline-notice success">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                                        <div><strong>Connection code accepted</strong><span>The Office is connected. Review its identity below and approve it to continue.</span></div>
                                    </div>
                                }
                                else if (_issuedEnrollment?.EnrollmentToken is { Length: > 0 } token)
                                {
                                    <div class="host-secret-field">
                                        <code>@MaskedToken(token)</code>
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => CopyTokenAsync(token)">Copy code</MudButton>
                                        <MudButton Variant="Variant.Text" Disabled="@_busy" OnClick="ReplaceRemoteEnrollmentAsync">Generate a different code</MudButton>
                                    </div>
                                }
                                else if (_status.ActiveEnrollment is { Status: "available" })
                                {
                                    <div class="host-inline-notice warning">
                                        <MudIcon Icon="@Icons.Material.Outlined.Lock" />
                                        <div><strong>The active code cannot be shown</strong><span>Connection codes are shown only once. Generate a new code to continue; the previous code will stop working.</span></div>
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="ReplaceRemoteEnrollmentAsync">Generate a new code</MudButton>
                                    </div>
                                }
                                else if (_status.Nodes.Any(node => node.Status == "ready"))
                                {
                                    <div class="host-inline-notice checking">
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                        <div><strong>Office approved</strong><span>Waiting for its authenticated health check. This page updates automatically.</span></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="host-inline-notice checking">
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                        <span>Creating a secure connection code...</span>
                                    </div>
                                }
                            </li>
                        </ol>
                        <details class="remote-details">
                            <summary>Connection details</summary>
                            <span>Execution Gateway</span>
                            <code>@packages.ControlPlaneUrl</code>
                        </details>
                    }
                    else
                    {
                        <div class="host-inline-notice error">
                            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" />
                            <div><strong>Office setup is unavailable</strong><span>An administrator must configure the Execution Gateway before a machine can connect.</span></div>
                        </div>
                    }
                </div>

                <aside class="remote-status" aria-label="C-Sweet Office connection progress">
                    <span class="host-section-kicker">Connection progress</span>
                    <ol class="remote-progress-list">
                        <li class="@RemoteStageClass(1)"><span><MudIcon Icon="@RemoteStageIcon(1)" /></span><div><strong>Instructions ready</strong><small>@ProgressInstallInstruction</small></div></li>
                        <li class="@RemoteStageClass(2)"><span><MudIcon Icon="@RemoteStageIcon(2)" /></span><div><strong>Host connected</strong><small>Waiting for its secure hello.</small></div></li>
                        <li class="@RemoteStageClass(3)"><span><MudIcon Icon="@RemoteStageIcon(3)" /></span><div><strong>Host approved</strong><small>Confirm the machine belongs to you.</small></div></li>
                        <li class="@RemoteStageClass(4)"><span><MudIcon Icon="@RemoteStageIcon(4)" /></span><div><strong>Health check</strong><small>Verify secure runtime and capacity.</small></div></li>
                    </ol>
                    @if (PendingNodes.Count == 0 && RemoteStage < 3)
                    {
                        <div class="remote-waiting" role="status" aria-live="polite">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                            <span>@RemoteWaitingMessage</span>
                        </div>
                    }
                </aside>
            </div>

            @foreach (var node in PendingNodes)
            {
                <article class="host-approval-card">
                    <span class="host-approval-icon"><MudIcon Icon="@Icons.Material.Outlined.Laptop" /></span>
                    <div class="host-approval-copy">
                        <span class="host-section-kicker">Approval required</span>
                        <h3>@node.MachineName</h3>
                        <p>@DisplayPlatform(node) · C-Sweet Office @node.NodeVersion</p>
                        @if (node.Providers.Any(provider => !provider.IsAvailable))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                This host has unavailable isolation controls. It cannot receive agent work until its certified provider is healthy.
                            </MudAlert>
                        }
                        <details>
                            <summary>Identity details</summary>
                            <span>Certificate fingerprint</span>
                            <code>@node.CertificateThumbprint</code>
                        </details>
                    </div>
                    <div class="host-approval-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="() => ApproveRemoteAsync(node.Id)">Approve host</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@_busy" OnClick="() => RejectRemoteAsync(node.Id)">Not my host</MudButton>
                    </div>
                </article>
            }
        }
    </section>;

    private async Task AcceptStatusAsync(ExecutionCapacityOnboardingResponse status)
    {
        _status = status;
        if (!_capacityPresetInitialized && status.LocalCapacity?.Presets is { Count: > 0 })
        {
            _capacityPreset = RecommendedPresetKey ?? "balanced";
            _capacityPresetInitialized = true;
        }
        if (_issuedEnrollment is not null &&
            (status.ActiveEnrollment?.Id != _issuedEnrollment.Id || status.ActiveEnrollment.Status != "available"))
            _issuedEnrollment = null;
        if (_installationTarget == "remote") await EnsureRemoteEnrollmentAsync();
    }

    private void Apply(ExecutionCapacityActionResponse result)
    {
        _status = result.Status;
        SetAction(result.Succeeded, result.Message);
    }

    private void SetAction(bool succeeded, string message)
    {
        _actionSucceeded = succeeded;
        _actionMessage = message;
    }

    private void StartPolling()
    {
        _polling = new CancellationTokenSource();
        _ = PollAsync(_polling.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    var requestVersion = Volatile.Read(ref _statusMutationVersion);
                    var status = await SetupApi.GetExecutionCapacityStatusAsync(cancellationToken);
                    LocalOfficeSetupActionResponse? activeLocal = null;
                    if (_localSession is null)
                        activeLocal = await SetupApi.GetActiveLocalOfficeSetupSessionAsync(cancellationToken);
                    await InvokeAsync(async () =>
                    {
                        if (requestVersion != Volatile.Read(ref _statusMutationVersion) ||
                            _busy || _automaticEnrollmentInFlight)
                            return;
                        if (activeLocal?.Session is { } discovered)
                        {
                            _status = activeLocal.Status;
                            AdoptLocalSession(discovered);
                            if (_localSession is { State: "created", LaunchUri: null,
                                    AdministratorApprovalRequestedAt: null })
                                await RefreshLocalHandoffAsync();
                        }
                        await AcceptStatusAsync(status);
                        if (_installationTarget == "local" && _localSession is not null)
                        {
                            var localResult = await SetupApi.GetLocalOfficeSetupSessionAsync(
                                _localSession.Id, cancellationToken);
                            if (localResult.Succeeded && localResult.Session is { } refreshed)
                            {
                                _localSession = refreshed with
                                {
                                    LaunchUri = refreshed.LaunchUri ?? _localSession.LaunchUri,
                                    WindowsPackageUrl = refreshed.WindowsPackageUrl ?? _localSession.WindowsPackageUrl
                                };
                                _status = localResult.Status;
                                if (_localSession.State == "removed")
                                    await ContinueAfterRemovedOfficeAsync();
                            }
                        }
                        StateHasChanged();
                    });
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    break;
                }
                catch
                {
                    // A transient refresh failure should not end the waiting experience.
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch { }
    }

    private void BeginStatusMutation() => Interlocked.Increment(ref _statusMutationVersion);
    private void EndStatusMutation() => Interlocked.Increment(ref _statusMutationVersion);

    private ExecutionNodeSummaryResponse? LocalNode => _status?.Nodes.FirstOrDefault(node => node.IsLocalMachine && node.Status != "revoked");
    private IReadOnlyList<ExecutionNodeSummaryResponse> PendingNodes => _status?.Nodes
        .Where(node => node.Status == "pendingapproval").ToArray() ?? [];

    private int LocalStepNumber => _localSession is null
        ? 1
        : _localSession.State == "ready"
            ? 4
            : _localSession.PhaseKey switch
            {
                "connect" or "verify" => 3,
                "ready" => 4,
                _ => 2
            };

    private string LocalTitle => _localSession is null
        ? "How much of this machine should Office use?"
        : LocalProgressTitle;

    private string LocalSubtitle => _localSession is null
        ? "We detected this computer and calculated safe limits automatically."
        : LocalProgressMessage;

    private LocalExecutionNodeProvisioningProgressResponse? ActiveLocalProvisioning =>
        _status?.LocalProvisioning is { State: "running" or "restart-required" or "failed" } progress
            ? progress
            : null;

    private string LocalProgressTitle => _localSession?.State == "ready"
        ? "Your Office is ready"
        : LocalSetupStartStalled
            ? "Windows setup needs attention"
            : AwaitingBootstrapAfterApproval
                ? "Waiting for Windows setup"
                : ActiveLocalProvisioning?.PhaseDisplayName
                  ?? _localSession?.PhaseDisplayName
                  ?? "Preparing your Office";

    private string LocalProgressMessage => _localSession?.State == "ready"
        ? "This Office is connected and healthy."
        : LocalSetupStartStalled
            ? "The administrator request opened, but Windows setup has not reported progress. If you approved it and this message persists, try again."
            : AwaitingBootstrapAfterApproval
                ? "Complete the Windows administrator prompt if it is still open. Setup continues automatically after approval."
                : ActiveLocalProvisioning?.Message
                  ?? _localSession?.Message
                  ?? "C-Sweet is preparing this machine.";

    private int LocalProgressPercent => ActiveLocalProvisioning?.PercentComplete
        ?? _localSession?.PercentComplete
        ?? 0;

    private string? LocalProgressEta => ActiveLocalProvisioning is { } progress
        ? Eta(progress)
        : Eta(_localSession?.EstimatedRemainingMinimumSeconds,
            _localSession?.EstimatedRemainingMaximumSeconds);

    private bool LocalSetupStartStalled => _localSession?.State == "created" &&
        (_localSession.LaunchMethod == "server" || _localSession.LaunchUri is { Length: > 0 }) &&
        _localLaunchAttempts > 0 &&
        _localSession.PhaseKey == "install" &&
        ActiveLocalProvisioning is null &&
        DateTimeOffset.UtcNow - _localLaunchAttemptedAt.GetValueOrDefault() >= TimeSpan.FromSeconds(45);

    private bool AwaitingBootstrapAfterApproval => _localSession?.State == "created" &&
        _localApprovalRequested && ActiveLocalProvisioning is null && !LocalSetupStartStalled;

    private bool ShowLocalLaunchRetry => LocalSetupStartStalled;

    private bool LocalSetupLocksLocation => _localSession is not null;

    private string LocalStageClass(int stage) => LocalStepNumber > stage
        ? "complete"
        : LocalStepNumber == stage ? "current" : string.Empty;

    private void SelectCapacityPreset(string key)
    {
        if (key == "custom" && !_customInitialized)
        {
            var source = SelectedAllocation;
            _customCpuCount = source.CpuCount;
            _customMemoryGb = Math.Max(1, source.MemoryMb / 1024);
            _customStorageGb = Math.Max(1, source.DiskMb / 1024);
            _customInitialized = true;
        }
        _capacityPreset = key;
    }

    private Allocation SelectedAllocation
    {
        get
        {
            if (_capacityPreset == "custom")
                return new(_customCpuCount, _customMemoryGb * 1024, _customStorageGb * 1024);
            var preset = _status?.LocalCapacity?.Presets.FirstOrDefault(x => x.Key == _capacityPreset);
            return preset is null ? new(0, 0, 0) : new(preset.CpuCount, preset.MemoryMb, preset.DiskMb);
        }
    }

    private bool LocalAllocationIsValid
    {
        get
        {
            var capacity = _status?.LocalCapacity;
            var value = SelectedAllocation;
            return capacity is { IsSupported: true } &&
                value.CpuCount >= capacity.MinimumCpuCount && value.CpuCount <= capacity.SafeCpuCount &&
                value.MemoryMb >= capacity.MinimumMemoryMb && value.MemoryMb <= capacity.SafeMemoryMb &&
                value.DiskMb >= capacity.MinimumDiskMb && value.DiskMb <= capacity.SafeDiskMb;
        }
    }

    private string CustomAllocationHint => LocalAllocationIsValid
        ? "Within the safe limits for this computer."
        : "Choose values within this computer's safe limits.";

    private RenderFragment AllocationEditor(string label, int value, string suffix, string key) => @<label class="allocation-editor">
        <span>@label</span>
        <span class="allocation-stepper">
            <button type="button" aria-label="Decrease @label" @onclick="() => AdjustCustom(key, -1)">−</button>
            <input type="number" value="@value" min="1" aria-label="@label allocation"
                   @onchange="eventArgs => SetCustomValue(key, eventArgs.Value?.ToString())" />
            <small>@suffix</small>
            <button type="button" aria-label="Increase @label" @onclick="() => AdjustCustom(key, 1)">+</button>
        </span>
    </label>;

    private void AdjustCustom(string key, int delta)
    {
        if (_status?.LocalCapacity is not { } capacity) return;
        switch (key)
        {
            case "cpu": _customCpuCount = Math.Clamp(_customCpuCount + delta,
                capacity.MinimumCpuCount, capacity.SafeCpuCount); break;
            case "memory": _customMemoryGb = Math.Clamp(_customMemoryGb + delta,
                Math.Max(1, capacity.MinimumMemoryMb / 1024), Math.Max(1, capacity.SafeMemoryMb / 1024)); break;
            case "storage": _customStorageGb = Math.Clamp(_customStorageGb + delta,
                Math.Max(1, capacity.MinimumDiskMb / 1024), Math.Max(1, capacity.SafeDiskMb / 1024)); break;
        }
    }

    private void SetCustomValue(string key, string? text)
    {
        if (!int.TryParse(text, out var value)) return;
        switch (key)
        {
            case "cpu": _customCpuCount = value; break;
            case "memory": _customMemoryGb = value; break;
            case "storage": _customStorageGb = value; break;
        }
    }

    private static int FormatGb(int megabytes) => Math.Max(0, megabytes / 1024);

    private int RemoteStage => _status?.IsReady == true ? 5
        : _status?.Nodes.Any(node => node.Status == "ready") == true ? 4
        : PendingNodes.Count > 0 ? 3
        : _status?.ActiveEnrollment?.Status == "claimed" ? 2
        : _status?.ActiveEnrollment is not null || _issuedEnrollment is not null ? 1
        : 0;

    private string ConnectionCodeHint => _issuedEnrollment is { } enrollment
        ? $"Shown only once and {ExpiryDescription(enrollment.ExpiresAt)}. It can be used only once."
        : "Shown only once, expires after 15 minutes, and can be used only once.";

    private string RemoteWaitingMessage =>
        _issuedEnrollment?.EnrollmentToken is { Length: > 0 }
            ? $"Run the installer {TargetPrepositionalPhrase} with the code shown here. This page updates automatically when the Office connects."
            : _status?.ActiveEnrollment is { Status: "available" }
                ? "The active code is hidden after a reload. Generate a new code above to continue setup."
                : $"Waiting for {TargetNounPhrase}. This page updates automatically when it connects.";

    private string TargetKicker => _installationTarget == "local" ? "This machine" : "Another machine";
    private string TargetNounPhrase => _installationTarget == "local" ? "this machine" : "the other machine";
    private string TargetPrepositionalPhrase => _installationTarget == "local" ? "on this machine" : "on the other machine";
    private string PackageLocationInstruction => _installationTarget == "local"
        ? "Open it on this machine."
        : "Open it on the other machine you want to use.";
    private string ProgressInstallInstruction => _installationTarget == "local"
        ? "Install on this machine."
        : "Install on the other machine.";
    private string TargetReadyMessage => _installationTarget == "local"
        ? "This machine is connected and healthy."
        : "The other machine is connected and healthy.";

    private string RemoteStageClass(int stage) => RemoteStage > stage ? "complete" : RemoteStage == stage ? "current" : string.Empty;
    private string RemoteStageIcon(int stage) => RemoteStage > stage
        ? Icons.Material.Filled.Check
        : RemoteStage == stage ? Icons.Material.Filled.MoreHoriz : Icons.Material.Outlined.RadioButtonUnchecked;
    private string TargetClass(string target) => _installationTarget == target ? "selected" : string.Empty;
    private static bool IsRunning(LocalExecutionNodeProvisioningProgressResponse progress) => progress.State == "running";
    private static bool IsFailed(LocalExecutionNodeProvisioningProgressResponse progress) => progress.State == "failed";
    private static string DisplayPlatform(ExecutionNodeSummaryResponse node) => $"{Title(node.OperatingSystem)} / {node.Architecture}";
    private static string Title(string value) => value switch { "windows" => "Windows", "linux" => "Linux", "macos" => "macOS", _ => value };

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration < TimeSpan.Zero) duration = TimeSpan.Zero;
        if (duration.TotalHours >= 1) return $"{(int)duration.TotalHours}h {duration.Minutes}m";
        if (duration.TotalMinutes >= 1) return $"{(int)duration.TotalMinutes}m {duration.Seconds}s";
        return $"{Math.Max(0, duration.Seconds)}s";
    }

    private static string ExpiryDescription(DateTimeOffset expiresAt)
    {
        var remaining = expiresAt - DateTimeOffset.UtcNow;
        if (remaining <= TimeSpan.Zero) return "has expired";
        var minutes = Math.Max(1, (int)Math.Ceiling(remaining.TotalMinutes));
        return $"expires in about {minutes} minute{(minutes == 1 ? string.Empty : "s")}";
    }

    private static string? Eta(LocalExecutionNodeProvisioningProgressResponse progress)
        => Eta(progress.EstimatedRemainingMinimumSeconds, progress.EstimatedRemainingMaximumSeconds);

    private static string? Eta(int? estimatedMinimumSeconds, int? estimatedMaximumSeconds)
    {
        if (estimatedMaximumSeconds is not { } maximum) return null;
        var minimum = Math.Max(0, estimatedMinimumSeconds ?? maximum);
        maximum = Math.Max(minimum, maximum);
        return minimum == maximum
            ? $"About {FormatDuration(TimeSpan.FromSeconds(maximum))} remaining"
            : $"About {FormatDuration(TimeSpan.FromSeconds(minimum))}–{FormatDuration(TimeSpan.FromSeconds(maximum))} remaining";
    }

    private static string MaskedToken(string token) => token.Length < 4 ? "••••" : $"•••• •••• •••• {token[^4..]}";

    private static readonly RemotePlatform[] RemotePlatforms =
    [
        new("windows", "Windows", Icons.Material.Filled.Window),
        new("linux", "Linux", Icons.Material.Filled.Terminal),
        new("macos", "macOS", Icons.Material.Filled.LaptopMac)
    ];

    private static readonly LocalStage[] LocalStages =
    [
        new(1, "Capacity"), new(2, "Install"), new(3, "Connect"), new(4, "Ready")
    ];

    private static readonly CapacityOption[] CapacityOptions =
    [
        new("small", "Small", "Light background work", Icons.Material.Outlined.Spa),
        new("balanced", "Balanced", "Best for most teams", Icons.Material.Outlined.Speed),
        new("performance", "Performance", "Maximum local speed", Icons.Material.Outlined.RocketLaunch),
        new("custom", "Custom", "Choose exact limits", Icons.Material.Outlined.Tune)
    ];

    private string? SelectedPackageUrl(OfficePackageLinksResponse packages) => _remotePlatform switch
    {
        "windows" => packages.WindowsPackageOverrideUrl ?? packages.ReleaseManifestUrl,
        "linux" => packages.LinuxPackageOverrideUrl ?? packages.ReleaseManifestUrl,
        "macos" => packages.MacOsPackageOverrideUrl ?? packages.ReleaseManifestUrl,
        _ => packages.ReleaseManifestUrl
    };

    private string? RecommendedPresetKey => _status?.LocalCapacity?.Presets
        .FirstOrDefault(preset => preset.MemoryMb >= 16 * 1024)?.Key;

    private string InstallCommand(string controlPlaneUrl) => _remotePlatform switch
    {
        "windows" => $"& \"$env:ProgramFiles\\CSweet\\Office\\Install-CSweetOffice.ps1\" -PayloadRoot \"$env:ProgramFiles\\CSweet\\Office\\payload\" -ControlPlaneUrl '{PowerShellQuote(controlPlaneUrl)}'",
        "linux" => $"sudo /usr/sbin/csweet-configure-office '{UnixQuote(controlPlaneUrl)}'",
        "macos" => $"sudo /usr/local/sbin/csweet-configure-office '{UnixQuote(controlPlaneUrl)}'",
        _ => string.Empty
    };

    private static string PowerShellQuote(string value) => value.Replace("'", "''", StringComparison.Ordinal);
    private static string UnixQuote(string value) => value.Replace("'", "'\"'\"'", StringComparison.Ordinal);

    private async Task CopyCommandAsync(string gateway) => await CopyAsync(InstallCommand(gateway), "Setup command copied.");
    private async Task CopyTokenAsync(string token) => await CopyAsync(token, "Connection code copied. Paste it only into the C-Sweet Office installer.");

    private async Task CopyAsync(string value, string message)
    {
        var module = await ModuleAsync();
        await module.InvokeVoidAsync("copyText", value);
        SetAction(true, message);
    }

    private Task<IJSObjectReference> ModuleAsync() => _jsModule is not null
        ? Task.FromResult(_jsModule)
        : LoadModuleAsync();

    private async Task<IJSObjectReference> LoadModuleAsync() => _jsModule =
        await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CSweet.UI/js/auth-security.js");

    public async ValueTask DisposeAsync()
    {
        _polling?.Cancel();
        _polling?.Dispose();
        if (_jsModule is not null) await _jsModule.DisposeAsync();
    }

    private sealed record RemotePlatform(string Key, string Label, string Icon);
    private sealed record LocalStage(int Number, string Label);
    private sealed record CapacityOption(string Key, string Name, string Description, string Icon);
    private readonly record struct Allocation(int CpuCount, int MemoryMb, int DiskMb);
}
