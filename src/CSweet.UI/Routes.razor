@using System.Net.Http.Json
@using CSweet.Contracts.Setup
@inject HttpClient Http
@inject IAuthenticationApiClient AuthenticationApi
@inject NavigationManager Navigation
@inject AuthSessionStore Session
@implements IDisposable

<Router AppAssembly="@SharedUiAssembly.Value" NotFoundPage="typeof(Pages.NotFound)" OnNavigateAsync="GuardNavigationAsync">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    @* Keep the current route mounted while the navigation guard runs. A Navigating fragment disposes the layout and conversation state. *@
</Router>

@code {
    protected override void OnInitialized() => Session.SessionEnded += OnSessionEnded;

    public void Dispose() => Session.SessionEnded -= OnSessionEnded;

    // An API call returned 401 mid-session (cookie expired or signed out elsewhere).
    private void OnSessionEnded() => _ = InvokeAsync(() =>
    {
        var current = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (!LoginRedirect.IsPublicAccountRoute(current) &&
            !current.StartsWith("register", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(LoginRedirect.LoginUri(current, LoginRedirect.ReasonExpired));
        }
    });

    private async Task GuardNavigationAsync(Microsoft.AspNetCore.Components.Routing.NavigationContext context)
    {
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(context.CancellationToken);
        timeout.CancelAfter(TimeSpan.FromSeconds(10));
        var cancellationToken = timeout.Token;
        var path = context.Path.Trim('/');
        var isPublicAccountRoute = LoginRedirect.IsPublicAccountRoute(path);

        CSweet.Contracts.Auth.AuthStatusResponse auth;
        try
        {
            auth = await AuthenticationApi.GetStatusAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (context.CancellationToken.IsCancellationRequested)
        {
            return; // A newer navigation superseded this one; its own guard decides.
        }
        catch
        {
            // Fail closed. If the session cannot be confirmed (API unreachable, timeout, bad
            // response) the user is treated as signed out; the login page explains the outage.
            if (!isPublicAccountRoute)
            {
                Navigation.NavigateTo(LoginRedirect.LoginUri(path, LoginRedirect.ReasonUnavailable));
            }
            return;
        }

        if (auth.RegistrationOpen)
        {
            RedirectUnless(path, "register", "/register");
            return;
        }

        if (!auth.IsAuthenticated)
        {
            if (!isPublicAccountRoute)
            {
                Navigation.NavigateTo(LoginRedirect.LoginUri(path));
            }
            return;
        }

        if (path.Equals("register", StringComparison.OrdinalIgnoreCase) || isPublicAccountRoute)
        {
            Navigation.NavigateTo("/");
            return;
        }

        try
        {
            var status = await Http.GetFromJsonAsync<SetupStatusResponse>("api/setup/status", cancellationToken);
            if (status is { IsFirstRunComplete: false })
            {
                RedirectUnless(path, "setup", "/setup");
            }
        }
        catch
        {
            // Signed in, but setup state is unavailable: keep the route; pages show connectivity state.
        }
    }

    private void RedirectUnless(string path, string allowedPrefix, string destination)
    {
        if (!path.StartsWith(allowedPrefix, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(destination);
        }
    }
}
