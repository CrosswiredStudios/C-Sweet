@using CSweet.Contracts.Core
@using System.Net
@using System.Net.Http.Json
@inject HttpClient Http
@inject IAppLocalizer L

@if (ActionsOnly)
{
    @if (Item.OffersRetry) { <span>@Item.RetryReason</span> <MudButton OnClick="RetryAsync" Disabled="_retrying" Variant="Variant.Outlined" aria-label="@($"Retry {Item.Title}")">@L["Common.Retry"]</MudButton> }
    @if (_error is not null) { <MudText role="alert" Color="Color.Error">@_error</MudText> }
}
else
{
<AttentionRequestCard Kind="Issue" EmployeeId="Item.OwnerOrganizationUserId" Name="@Item.OwnerName" Embedded="Embedded"
    Context="@Item.ManagerName" Prompt="@Item.Title" Description="@Item.Reason"
    Status="@Item.RetryReason">
    <MudButton Href="@Item.ActionUri" Variant="Variant.Outlined">Open affected work</MudButton>
    @if (Item.OffersRetry)
    {
        <MudButton OnClick="RetryAsync" Disabled="_retrying" Variant="Variant.Outlined" Color="Color.Primary">@(_retrying ? "Retrying…" : "Retry")</MudButton>
    }
    @if (_error is not null)
    {
        <MudText role="alert" Color="Color.Error">@_error</MudText>
    }
</AttentionRequestCard>

}

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public bool ActionsOnly { get; set; }
    [Parameter] public bool Embedded { get; set; }
    [Parameter, EditorRequired] public BlockedWorkAttentionResponse Item { get; set; } = default!;
    [Parameter] public EventCallback RefreshRequested { get; set; }
    private bool _retrying;
    private string? _error;

    private async Task RetryAsync()
    {
        if (_retrying || !Item.OffersRetry || Item.RetryKey is null) return;
        _retrying = true; _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/organizations/{OrganizationId:D}/work/personal-todos/attention/retry",
                new CSweet.WorkManagement.Contracts.RequeuePersonalTodoItemRequest(Item.ItemId, Item.Revision,
                    Item.RetryKey));
            if (response.StatusCode == HttpStatusCode.Conflict)
                _error = "This work has changed. Refresh and review its current state before retrying.";
            else if (response.StatusCode == HttpStatusCode.Forbidden)
                _error = "You no longer have permission to retry this work.";
            else if (!response.IsSuccessStatusCode)
                _error = "The work could not be retried. Open the affected work to review its current state.";
            if (_error is null) await RefreshRequested.InvokeAsync();
        }
        catch (HttpRequestException) { _error = "The retry could not be confirmed. Refresh to check the current state."; }
        finally { _retrying = false; }
    }
}
