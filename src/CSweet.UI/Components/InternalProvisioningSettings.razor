@using CSweet.Contracts.SourceControl
@using CSweet.Contracts.Core
@inject HttpClient Http
@inject IAppLocalizer L

<MudExpansionPanels><MudExpansionPanel Expanded="Expanded" Text="@L["InternalProvisioningSettings.InternalRepositoryCreationPolicy"]">
    <MudStack Spacing="2">
        <MudText>@L["InternalProvisioningSettings.AuthorizedAgentsCanCreatePrivate"]</MudText>
        @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
        @if (_settings is not null)
        {
            <MudCheckBox @bind-Value="_enabled" Label="@L["InternalProvisioningSettings.AllowInternalRepositoryCreation"]" Disabled="_busy" />
            <MudCheckBox @bind-Value="_approval" Label="@L["InternalProvisioningSettings.RequireManagerApprovalForEach"]" Disabled="_busy" />
            <MudNumericField T="int" @bind-Value="_maximum" Min="1" Max="10000" Label="@L["InternalProvisioningSettings.RepositoryQuota"]" Disabled="_busy" />
            <MudTextField @bind-Value="_prefix" Label="Repository name prefix (optional)" Disabled="_busy" />
            <MudTextField @bind-Value="_branch" Label="@L["InternalProvisioningSettings.InitialBranch"]" Disabled="_busy" />
            <MudSelect T="Guid?" @bind-Value="_team" Label="@L["InternalProvisioningSettings.DefaultTeam"]" Disabled="_busy" Clearable="true" HelperText="@L["InternalProvisioningSettings.IfUnsetAnAgentWith"]">
                @foreach (var team in _teams) { <MudSelectItem T="Guid?" Value="@((Guid?)team.Id)">@team.Name</MudSelectItem> }
            </MudSelect>
            <MudText Color="Color.Secondary">@L["InternalProvisioningSettings.ChangingThisPolicyInvalidatesQueued"]</MudText>
            <MudButton OnClick="SaveAsync" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary">@L["InternalProvisioningSettings.SaveCreationPolicy"]</MudButton>
            <MudText Typo="Typo.subtitle1">@L["InternalProvisioningSettings.RecentCreationRequests"]</MudText>
            @foreach (var job in _settings.Jobs)
            {
                <MudText>@job.Name · @job.Status @job.Message</MudText>
            }
        }
        <MudButton OnClick="LoadAsync" Disabled="_busy">@L["Common.Refresh"]</MudButton>
    </MudStack>
</MudExpansionPanel></MudExpansionPanels>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public bool Expanded { get; set; }
    private InternalGitProvisioningSettings? _settings;
    private IReadOnlyList<TeamSummaryResponse> _teams = [];
    private bool _enabled, _approval, _busy;
    private int _maximum;
    private Guid? _team;
    private string _prefix = "", _branch = "main";
    private string? _error;
    private string Endpoint => $"api/organizations/{OrganizationId:D}/source-control/internal/provisioning";
    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync() => await RunAsync(async () =>
    {
        Apply((await Http.GetFromJsonAsync<InternalGitProvisioningSettings>(Endpoint))!);
        _teams = (await Http.GetFromJsonAsync<TeamDirectoryResponse>($"api/core/organizations/{OrganizationId:D}/teams?includeArchived=false"))?.Teams.Where(t => !t.IsArchived).ToList() ?? [];
    });
    private async Task SaveAsync() => await RunAsync(async () =>
    {
        if (_settings is null) return;
        using var response = await Http.PutAsJsonAsync(Endpoint, new UpdateInternalGitProvisioningSettings(_enabled, _approval, _maximum, _team, _prefix, _branch, _settings.Revision));
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            throw new InvalidOperationException(error.TryGetProperty("message", out var message) ? message.GetString() : "Could not save creation policy.");
        }
        Apply((await response.Content.ReadFromJsonAsync<InternalGitProvisioningSettings>())!);
    });
    private void Apply(InternalGitProvisioningSettings settings)
    {
        _settings = settings; _enabled = settings.Enabled; _approval = settings.RequiresApproval; _maximum = settings.MaximumRepositories;
        _team = settings.DefaultTeamId; _prefix = settings.NamePrefix; _branch = settings.DefaultBranch;
    }
    private async Task RunAsync(Func<Task> action)
    { _busy = true; _error = null; try { await action(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
}
