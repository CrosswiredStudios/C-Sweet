@using CSweet.Contracts.Core
@inject IAppLocalizer L

@if (Item.IssueId is null && Item.Work.Count == 0 && Item.AffectedWork.Count == 0 && Item.Incidents.Count == 0 && Item.Actions.Count == 0 && Item.Questions.Count == 1)
{
    <AgentQuestionCard OrganizationId="OrganizationId" Question="Item.Questions[0]" Overview="true" Answered="AnsweredAsync" />
}
else
{
    <AttentionRequestCard Kind="@(Item.IsComputeBlocker ? "Compute" : Item.RequiresUserAction ? "Issue" : "Status")" Name="@Item.OwnerName" EmployeeId="Item.OwnerOrganizationUserId"
        Context="@Item.ProjectName" Prompt="@Item.Title">
        <BodyContent>
            @if (!string.IsNullOrWhiteSpace(Summary)) { <p class="blocker-summary">@Summary</p> }
            @if (!Item.RequiresUserAction) { <p>@L["PendingAgentQuestions.NoActionNeeded"]</p> }
            else
            {
                @foreach (var question in Item.Questions.DistinctBy(q => q.Decision.Id))
                {
                    <AgentQuestionCard @key="question.Decision.Id" OrganizationId="OrganizationId" Question="question" Overview="true" Embedded="true" Answered="AnsweredAsync" />
                }
                @foreach (var incident in Item.Incidents.Where(i => i.HasUserAction))
                {
                    @if (incident.ResolutionDecision is { } decision && incident.ReportConversationId is { } chat)
                    {
                        @if (!Item.Questions.Any(q => q.Decision.Id == decision.Id))
                        {
                            <DecisionPrompt Content="@decision.Prompt" />
                            <IncidentResolutionChoices @key="decision.Id" OrganizationId="OrganizationId" ConversationId="chat" Decision="decision" Answered="RefreshRequested" />
                        }
                    }
                    else
                    {
                        <ProjectIncidentAttentionCard @key="incident.Id" Incident="incident" OrganizationId="OrganizationId" ActionsOnly="true" RefreshRequested="RefreshRequested" />
                    }
                }
                @if (Item.Questions.Count == 0 && !Item.Incidents.Any(i => i.HasUserAction))
                {
                    @foreach (var work in Item.Work.Where(w => w.OffersRetry))
                    {
                        <BlockedWorkAttentionCard @key="work.ItemId" OrganizationId="OrganizationId" Item="work" ActionsOnly="true" RefreshRequested="RefreshRequested" />
                    }
                }
            }
            @if (Item.Work.Count > 0 || Item.AffectedWork.Count > 0 || Item.Incidents.Count > 0 || Item.Questions.Count > 0 ||
                !string.IsNullOrWhiteSpace(Item.Detail) || !string.IsNullOrWhiteSpace(Item.NextAction))
            {
                <details class="issue-details">
                    <summary>@L["PendingAgentQuestions.ViewAffectedWork"]</summary>
                    @foreach (var work in AffectedWork) { <p><a href="@work.ActionUri">@work.Title</a></p> }
                    @foreach (var incident in Item.Incidents)
                    {
                        <p><a href="@incident.ActionUri">@L["ProjectIncidentAttentionCard.ReadReport"] · @incident.ReporterName</a></p>
                        @if (incident.InvestigateUri is { } uri && uri != incident.ActionUri) { <p><a href="@uri">@incident.InvestigateLabel</a></p> }
                        <ChatMarkdown Content="@(incident.OwnerReport ?? incident.Facts)" />
                    }
                    @foreach (var question in Item.Questions) { <p><a href="@($"/organizations/{OrganizationId}/communications/{question.ConversationId}?decision={question.Decision.Id}")">@question.Decision.Prompt</a></p> }
                    @if (!string.IsNullOrWhiteSpace(Item.Detail)) { <ChatMarkdown Content="@Item.Detail" /> }
                    @if (!string.IsNullOrWhiteSpace(Item.NextAction)) { <p>@Item.NextAction</p> }
                </details>
            }
        </BodyContent>
        <ChildContent>
            @foreach (var action in Item.Actions)
            {
                <MudButton Href="@action.ActionUri" Variant="Variant.Outlined" Color="Color.Primary">@action.Label</MudButton>
            }
        </ChildContent>
    </AttentionRequestCard>
}

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter, EditorRequired] public OverviewIssueCard Item { get; set; } = default!;
    [Parameter] public EventCallback RefreshRequested { get; set; }
    [Parameter] public EventCallback<Guid> Answered { get; set; }
    private string? Summary => !string.IsNullOrWhiteSpace(Item.Summary) ? Item.Summary : Item.Incidents.FirstOrDefault()?.OwnerReport ?? Item.Work.FirstOrDefault()?.Reason;
    private IEnumerable<OverviewAffectedWork> AffectedWork => Item.Work.Select(w => new OverviewAffectedWork(w.ItemId, w.Title, w.ActionUri))
        .Concat(Item.AffectedWork).DistinctBy(w => w.ItemId);
    private async Task AnsweredAsync(Guid decisionId)
    {
        await Answered.InvokeAsync(decisionId);
        await RefreshRequested.InvokeAsync();
    }
}
