@using CSweet.Contracts.WorkManagement

<p class="mb-3">Add backlog tickets to <strong>@Sprint.Name</strong>, or return tickets to the backlog. Starting the sprint is a separate action.</p>
<MudTextField T="string" @bind-Value="_search" Label="Search tickets" Immediate="true" Variant="Variant.Outlined" />
@if (!string.IsNullOrWhiteSpace(Error)) { <MudAlert Severity="Severity.Error" Class="my-3">@Error</MudAlert> }
<h3 class="mt-4">In this sprint</h3>
@foreach (var item in VisibleItems.Where(x => x.SprintId == Sprint.Id))
{
    <div class="scope-ticket" @key="item.Id">
        <span><strong>@item.Identifier</strong> @item.Title</span>
        <MudButton Disabled="Busy" OnClick="@(() => OnAssign.InvokeAsync(new(item, null)))">Return to backlog</MudButton>
    </div>
}
@if (!VisibleItems.Any(x => x.SprintId == Sprint.Id)) { <p class="pa-3">No matching tickets in this sprint.</p> }
<h3 class="mt-4">Backlog</h3>
@foreach (var item in VisibleItems.Where(x => x.SprintId is null && x.Status is not ("Completed" or "Cancelled")))
{
    <div class="scope-ticket" @key="item.Id">
        <span><strong>@item.Identifier</strong> @item.Title</span>
        <MudButton Disabled="Busy" Color="Color.Primary" OnClick="@(() => OnAssign.InvokeAsync(new(item, Sprint.Id)))">Add to sprint</MudButton>
    </div>
}
@if (!VisibleItems.Any(x => x.SprintId is null && x.Status is not ("Completed" or "Cancelled"))) { <p class="pa-3">No matching backlog tickets. Create a work item or assign a ticket from its details.</p> }

@code {
    [Parameter, EditorRequired] public WorkSprintResponse Sprint { get; set; } = default!;
    [Parameter] public IReadOnlyList<WorkBoardItemResponse> Items { get; set; } = [];
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback<WorkSprintAssignment> OnAssign { get; set; }
    private string _search = "";
    private IEnumerable<WorkBoardItemResponse> VisibleItems => Items.Where(x => WorkBoardWorkspacePresentation.Matches(x, _search));
}
