@using System.Net.Http.Json
@using CSweet.WorkManagement.Contracts
@inject HttpClient Http

@if (_snapshot is { } tracking)
{
    <section class="work-tracking" aria-label="Work tracking">
        @if (!tracking.Limited || tracking.Following)
        {
            <button type="button" disabled="@_busy" aria-pressed="@tracking.Following" @onclick="ToggleAsync">@(tracking.Following ? "Following" : "Follow")</button>
            @if (!tracking.Limited && ShowUpdates && tracking.WorkItemUrl is { } url) { <a href="@url">Open work item</a> }
        }
        @if (ShowUpdates)
        {
            <h3>Progress and results</h3>
            @if (tracking.Limited) { <p>Updates shared with you</p> }
            @foreach (var update in tracking.Updates)
            {
                <article><strong>@UpdateLabel(update.Kind)</strong><p>@update.Summary</p><time datetime="@update.OccurredAt.ToString("O")">@update.OccurredAt.ToLocalTime().ToString("g")</time></article>
            }
            @if (tracking.Updates.Count == 0) { <p>No progress updates yet.</p> }
        }
    </section>
}
@if (_error is { } error) { <p role="alert">@error</p> }

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid ItemId { get; set; }
    [Parameter] public bool ShowUpdates { get; set; }
    private WorkTrackingSnapshot? _snapshot;
    private Guid _loadedItem;
    private Guid _loadedOrg;
    private bool _busy;
    private string? _error;
    private string Endpoint => $"api/organizations/{OrganizationId:D}/work/tracking/{ItemId:D}";
    private static string UpdateLabel(string kind) => kind switch
    {
        "Accepted" => "Acknowledged", "Clarification" => "Clarification needed", "Declined" => "Declined",
        "Progress" => "Progress", "Milestone" => "Milestone", "Blocked" => "Blocked", "Decision" => "Decision needed",
        "Completed" or "Failed" => "Result", "WorkTerminal" => "Work status", "Attention" => "Needs attention", _ => "Update"
    };
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedItem == ItemId && _loadedOrg == OrganizationId) return;
        _loadedItem = ItemId; _loadedOrg = OrganizationId; _snapshot = null; _error = null;
        using var response = await Http.GetAsync(Endpoint);
        if (response.IsSuccessStatusCode) _snapshot = await response.Content.ReadFromJsonAsync<WorkTrackingSnapshot>();
        else if (ShowUpdates) _error = "These work updates are unavailable or your access has changed.";
    }
    private async Task ToggleAsync()
    {
        if (_snapshot is null || _busy) return;
        _busy = true; _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(Endpoint + (_snapshot.Following ? "/unfollow" : "/follow"),
                new FollowWorkRequest(ItemId, Guid.NewGuid().ToString("N")));
            if (response.IsSuccessStatusCode) _snapshot = await response.Content.ReadFromJsonAsync<WorkTrackingSnapshot>();
            else _error = "Unable to update following. Refresh and try again.";
        }
        finally { _busy = false; }
    }
}
