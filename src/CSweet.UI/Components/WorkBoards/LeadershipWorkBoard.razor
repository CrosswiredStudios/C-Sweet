@using CSweet.Contracts.Communications
@using CSweet.Contracts.WorkManagement
@using Present = CSweet.UI.Components.WorkBoards.WorkBoardWorkspacePresentation
@inject HttpClient Http
@inject IAppLocalizer L

@if (_notice is not null)
{
    <p class="board-notice" role="status">@_notice</p>
}
@{
    var visible = Commitments.Where(Matches).OrderByDescending(x => x.UpdatedAt).ToLookup(Status);
    var filtered = AttentionOnly || !string.IsNullOrWhiteSpace(Search);
}
@if (filtered && visible.Count == 0)
{
    <p class="board-notice" role="status">@L["WorkBoardWorkspace.NoWorkMatchesTheseFilters"] <button type="button" @onclick="OnClearFilters">@L["WorkBoardWorkspace.ClearFilters"]</button></p>
}
<div class="workflow-columns" aria-label="@L["WorkBoardWorkspace.WorkBoardColumns"]">
    @foreach (var (key, category) in Columns)
    {
        var cards = visible[key];
        var label = L[$"LinkedCommitments.{key}"];
        <WorkBoardKanbanColumn @key="key" Name="@label" Category="@category" ColumnKey="@key.ToString()"
                               Count="cards.Count()" Compact="Compact" Filtered="filtered">
            @foreach (var commitment in cards)
            {
                <WorkBoardKanbanCard @key="commitment.Id" Title="@commitment.Title" Attention="@Reason(commitment)"
                                     OwnerName="@(string.IsNullOrWhiteSpace(commitment.OwnerDisplayName) ? null : commitment.OwnerDisplayName)"
                                     Status="@label" StatusTitle="@label" Compact="Compact"
                                     OnOpen="@(() => _selectedId = commitment.Id)" OpenLabel="@Present.CardText(commitment.Title, 120)">
                    <FooterContent>
                        @if (commitment.ConversationId is { } conversation)
                        {
                            <a class="ticket-link" href="@ConversationLink(commitment, conversation)">@L["LinkedCommitments.OpenConversation"]</a>
                        }
                    </FooterContent>
                    <Actions>
                        @if (commitment.CanRetry && CanAct(commitment))
                        {
                            <button type="button" class="ticket-retry" disabled="@_busy.Contains(commitment.Id)" @onclick="() => ActAsync(commitment, retry: true)"><MudIcon Icon="@Icons.Material.Outlined.Replay" Size="Size.Small" />@L["LinkedCommitments.Retry"]</button>
                        }
                        @if (commitment.CanStop && CanAct(commitment))
                        {
                            <button type="button" class="ticket-retry" disabled="@_busy.Contains(commitment.Id)" @onclick="() => ActAsync(commitment, retry: false)">@L["LinkedCommitments.Stop"]</button>
                        }
                    </Actions>
                </WorkBoardKanbanCard>
            }
        </WorkBoardKanbanColumn>
    }
</div>

<MudDialog Visible="@(Selected is not null)" VisibleChanged="CloseDetails" Options="DetailsOptions">
    <TitleContent>@L["LinkedCommitments.Title"]</TitleContent>
    <DialogContent>
        @if (Selected is { } commitment)
        {
            <div class="commitment-details">
                <h3>@commitment.Title</h3>
                <p>@L[$"LinkedCommitments.{Status(commitment)}"] @if (!string.IsNullOrWhiteSpace(commitment.OwnerDisplayName)) { <span>· @commitment.OwnerDisplayName</span> }</p>
                @if (Reason(commitment) is { } reason)
                {
                    <p>@reason</p>
                }
                @if (commitment.ConversationId is { } conversation)
                {
                    <MudLink Href="@ConversationLink(commitment, conversation)">@L["LinkedCommitments.OpenConversation"]</MudLink>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => CloseDetails(false))">@L["Common.Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<WorkBoardLinkedCommitmentResponse> Commitments { get; set; } = [];
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string Search { get; set; } = "";
    [Parameter] public bool AttentionOnly { get; set; }
    [Parameter] public EventCallback OnClearFilters { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private enum CommitmentStatus { ToDo, InProgress, Waiting, Blocked, Done }

    private static readonly (CommitmentStatus Status, string Category)[] Columns =
    [
        (CommitmentStatus.ToDo, "todo"),
        (CommitmentStatus.InProgress, "inprogress"),
        (CommitmentStatus.Waiting, "waiting"),
        (CommitmentStatus.Blocked, "blocked"),
        (CommitmentStatus.Done, "done")
    ];
    private static readonly DialogOptions DetailsOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
    private readonly HashSet<Guid> _busy = [];
    private string? _notice;
    private Guid? _selectedId;
    private WorkBoardLinkedCommitmentResponse? Selected => Commitments.FirstOrDefault(x => x.Id == _selectedId);

    private void CloseDetails(bool visible)
    {
        if (!visible) _selectedId = null;
    }

    internal static bool NeedsAttention(WorkBoardLinkedCommitmentResponse commitment) =>
        Status(commitment) is CommitmentStatus.Waiting or CommitmentStatus.Blocked;

    private static CommitmentStatus Status(WorkBoardLinkedCommitmentResponse commitment) => commitment.Status switch
    {
        "Blocked" or "Failed" => CommitmentStatus.Blocked,
        "Completed" => CommitmentStatus.Done,
        "Running" => CommitmentStatus.InProgress,
        _ when !string.IsNullOrWhiteSpace(commitment.WaitingReason) || commitment.NextReviewAt.HasValue ||
               commitment.Status == "WaitingForApproval" => CommitmentStatus.Waiting,
        _ => CommitmentStatus.ToDo
    };

    private static string? Reason(WorkBoardLinkedCommitmentResponse commitment) => Status(commitment) switch
    {
        CommitmentStatus.Blocked when !string.IsNullOrWhiteSpace(commitment.BlockReason) => commitment.BlockReason,
        CommitmentStatus.Waiting when !string.IsNullOrWhiteSpace(commitment.WaitingReason) => commitment.WaitingReason,
        _ => null
    };

    private bool Matches(WorkBoardLinkedCommitmentResponse commitment)
    {
        if (AttentionOnly && !NeedsAttention(commitment)) return false;
        if (string.IsNullOrWhiteSpace(Search)) return true;
        var term = Search.Trim();
        return commitment.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
               commitment.OwnerDisplayName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
               Reason(commitment)?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
    }

    private static bool CanAct(WorkBoardLinkedCommitmentResponse commitment) =>
        commitment.CoordinationSessionId.HasValue && commitment.ConversationId.HasValue &&
        commitment.CoordinationRevision.HasValue;

    // Retry asks the specialist for a fresh response; the platform then returns the blocked card to To Do.
    // Stop cancels the running collaboration; the card's owner reports that on its next review.
    private async Task ActAsync(WorkBoardLinkedCommitmentResponse commitment, bool retry)
    {
        if (commitment.CoordinationSessionId is not { } session || commitment.ConversationId is not { } conversation ||
            commitment.CoordinationRevision is not { } revision || !_busy.Add(commitment.Id)) return;
        _notice = null;
        try
        {
            var path = $"api/organizations/{OrganizationId:D}/communications/hub/chats/{conversation:D}" +
                       $"/coordination-sessions/{session:D}/{(retry ? "retry" : "stop")}";
            using var response = retry
                ? await Http.PostAsJsonAsync(path, new RetryAgentCoordinationRequest(revision,
                    "Retry requested by a manager from the team board.", $"board-retry:{session:N}:{revision}"))
                : await Http.PostAsJsonAsync(path, new StopAgentCoordinationRequest(revision,
                    "Stopped by a manager from the team board.", $"board-stop:{session:N}:{revision}"));
            _notice = response.StatusCode switch
            {
                _ when response.IsSuccessStatusCode => retry ? L["LinkedCommitments.RetryQueued"] : L["LinkedCommitments.Stopped"],
                System.Net.HttpStatusCode.Conflict or System.Net.HttpStatusCode.NotFound => L["LinkedCommitments.Changed"],
                System.Net.HttpStatusCode.Forbidden => L["LinkedCommitments.NotAllowed"],
                _ => L["LinkedCommitments.Failed"]
            };
        }
        catch (Exception error) when (error is HttpRequestException or OperationCanceledException)
        {
            _notice = L["LinkedCommitments.Failed"];
        }
        finally { _busy.Remove(commitment.Id); }
        await OnChanged.InvokeAsync();
    }

    private string ConversationLink(WorkBoardLinkedCommitmentResponse commitment, Guid conversation) =>
        commitment.OwnerOrganizationUserId is { } owner
            ? $"/organizations/{OrganizationId:D}/communications/{conversation:D}?perspective={owner:D}"
            : $"/organizations/{OrganizationId:D}/communications/{conversation:D}";
}
