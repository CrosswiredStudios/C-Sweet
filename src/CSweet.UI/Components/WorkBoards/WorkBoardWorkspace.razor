@using System.Net
@using CSweet.Contracts.WorkManagement
@using Present = CSweet.UI.Components.WorkBoards.WorkBoardWorkspacePresentation
@using Wire = CSweet.WorkManagement.Contracts
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JavaScript

<main class="work-board @(_compact ? "is-compact" : "")" aria-label="@Detail.Board.Name">
    <header class="board-header">
        <button type="button" class="back-link" @onclick="OnBack"><MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" />All boards</button>
        <div class="board-title-row">
            <div><div class="board-eyebrow">Company work / Board</div><h1>@Detail.Board.Name</h1></div>
            <div class="board-title-actions">
                @if (Detail.Board.IsArchived) { <span class="status-label">Archived · read only</span> }
                <button type="button" class="icon-button" aria-label="Board information" aria-expanded="@_showInfo" @onclick="@(() => _showInfo = !_showInfo)"><MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" /></button>
                <button type="button" class="icon-button" aria-label="Toggle favorite" aria-pressed="@Detail.Board.IsFavorite" @onclick="OnFavorite"><MudIcon Icon="@(Detail.Board.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)" Size="Size.Small" /></button>
            </div>
        </div>
        <nav class="board-tabs" aria-label="Board views">
            @if (CanReadSprints)
            {
                <button type="button" class="@TabClass(WorkBoardView.Sprint)" aria-current="@Current(WorkBoardView.Sprint)" @onclick="@(() => SelectViewAsync(WorkBoardView.Sprint))">Active sprint</button>
            }
            <button type="button" class="@TabClass(WorkBoardView.Backlog)" aria-current="@Current(WorkBoardView.Backlog)" @onclick="@(() => SelectViewAsync(WorkBoardView.Backlog))">Backlog <span class="count">@BacklogCount</span></button>
            <button type="button" class="@TabClass(WorkBoardView.All)" aria-current="@Current(WorkBoardView.All)" @onclick="@(() => SelectViewAsync(WorkBoardView.All))">All work</button>
            @if (CanReadSprints)
            {
                <button type="button" class="@TabClass(WorkBoardView.Sprints)" aria-current="@Current(WorkBoardView.Sprints)" @onclick="@(() => SelectViewAsync(WorkBoardView.Sprints))">Sprints</button>
            }
        </nav>
    </header>
    @if (_showInfo)
    {
        <section class="board-info"><strong>@Detail.Board.Key</strong><p>@Detail.Board.Description</p></section>
    }
    <div class="board-content">
        @if (CanReadSprints && !string.IsNullOrWhiteSpace(SprintError))
        {
            <div class="board-error" role="alert">Sprint information could not be loaded. <button type="button" @onclick="OnRefresh">Retry</button></div>
        }
        @if (_view == WorkBoardView.Sprint)
        {
            <section class="sprint-summary" aria-label="Selected sprint">
                <div class="sprint-heading">
                    @if (Sprints.Count > 0)
                    {
                        <div class="sprint-selection">
                            <select aria-label="Select sprint" value="@_sprintId" @onchange="SelectSprintAsync">
                                @if (!_sprintId.HasValue) { <option value="">Choose a planned or past sprint</option> }
                                @foreach (var sprint in OrderedSprints)
                                {
                                    <option value="@sprint.Id">@sprint.Name · @sprint.Status</option>
                                }
                            </select>
                            @if (SelectedSprint is { } selected) { <span class="status-label @StatusClass(selected.Status)">@selected.Status</span> }
                        </div>
                    }
                    @if (SelectedSprint is { } current)
                    {
                        <p class="sprint-goal">@(string.IsNullOrWhiteSpace(current.Goal) ? "No sprint goal has been set." : current.Goal)</p>
                    }
                    else
                    {
                        <h2>@(string.IsNullOrWhiteSpace(SprintError) ? "No active sprint" : "Sprint information unavailable")</h2>
                        <p class="sprint-goal">Review the backlog or choose a planned sprint to prepare the next commitment.</p>
                    }
                </div>
                @if (SelectedSprint is { } progress)
                {
                    <div class="sprint-progress">
                        <div><strong>@progress.CompletedItemCount / @progress.ItemCount complete</strong><span>@Present.CompletionPercent(progress).ToString("0")%</span></div>
                        <progress max="100" value="@Present.CompletionPercent(progress)" aria-label="Sprint completion"></progress>
                        <small>@SprintDates(progress)</small>
                    </div>
                }
            </section>
        }
        else
        {
            <div class="view-heading"><h2>@ViewTitle</h2><p>@ViewDescription</p></div>
        }
        <div class="board-toolbar">
            @if (_view != WorkBoardView.Sprints)
            {
                <label class="board-search"><MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" /><input type="search" aria-label="Search visible work" placeholder="@SearchPlaceholder" @bind="_search" @bind:event="oninput" /></label>
                <button type="button" class="quiet-button @(_attentionOnly ? "is-selected" : "")" aria-pressed="@_attentionOnly" @onclick="@(() => _attentionOnly = !_attentionOnly)"><MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" />@AttentionCount need attention</button>
                <details class="display-options"><summary>Display</summary><div class="display-options-panel"><label><input type="checkbox" @bind="_compact" />Compact cards</label><label><input type="checkbox" @bind="_showDescriptions" />Show descriptions</label></div></details>
            }
            <div class="board-actions">
                @if (_view == WorkBoardView.Sprints || (_view == WorkBoardView.Sprint && SelectedSprint is null))
                {
                    @if (CanReadSprints) { <button type="button" class="quiet-button" @onclick="OnManageSprints">Manage sprints</button> }
                }
                @if (_view == WorkBoardView.Sprint && SelectedSprint is { Status: "Active" or "Paused" or "Completed" or "Cancelled" } executionSprint && CanReadExecution)
                {
                    <button type="button" class="quiet-button" @onclick="@(() => OnExecution.InvokeAsync(executionSprint))">Execution</button>
                }
                @if (Detail.Board.AllowedActions.Contains(WorkItemActions.Create) && !Detail.Board.IsArchived)
                {
                    <button type="button" class="primary-button" @onclick="OnCreate"><MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" />New work item</button>
                }
                <button type="button" class="icon-button" aria-label="Refresh board" disabled="@Busy" @onclick="OnRefresh"><MudIcon Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" /></button>
                @BoardActions
            </div>
        </div>
        @if (_executionLoading) { <div class="board-notice" role="status">Checking sprint execution…</div> }
        @if (_executionError is not null) { <div class="board-error" role="alert">@_executionError <button type="button" @onclick="LoadExecutionAsync">Retry execution</button></div> }
        @if (Busy) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
        @if (!string.IsNullOrWhiteSpace(MoveError)) { <div class="board-error" role="alert">@MoveError</div> }
        @ContextContent

        @if (_view == WorkBoardView.Sprints)
        {
            <div class="sprint-directory">
                @foreach (var sprint in OrderedSprints)
                {
                    <article class="sprint-directory-row" @key="sprint.Id"><div><h3>@sprint.Name</h3><p>@sprint.Goal</p><small>@SprintDates(sprint) · @sprint.CompletedItemCount / @sprint.ItemCount complete</small></div><span class="status-label @StatusClass(sprint.Status)">@sprint.Status</span><button type="button" class="quiet-button" @onclick="@(() => OpenSprintAsync(sprint.Id))">View sprint</button></article>
                }
                @if (Sprints.Count == 0 && string.IsNullOrWhiteSpace(SprintError)) { <p class="workspace-empty">No sprints have been planned.</p> }
            </div>
        }
        else if (_view == WorkBoardView.Backlog)
        {
            <div class="backlog-list" aria-label="Unscheduled work">
                @foreach (var item in VisibleItems)
                {
                    <button type="button" class="backlog-row" @key="item.Id" @onclick="@(() => OnOpenItem.InvokeAsync(item))"><span class="ticket-reference">@Present.ShortIdentifier(item, Detail.Board.Key)</span><span class="backlog-title"><strong>@item.Title</strong><small>@Present.TypeLabel(item) · @ColumnName(item) @if (Attention(item) is { } reason) { <span class="attention-text"> · @reason</span> }</small></span><span class="ticket-owner">@(item.AssignedDisplayName ?? "Unassigned")</span><span>@(item.EstimatePoints?.ToString("0.##") ?? "—") pts</span></button>
                }
                @if (VisibleItems.Count == 0) { <p class="workspace-empty">@(HasFilters ? "No work matches these filters." : "No unscheduled work. Planned sprint items are available under Sprints.")</p> }
            </div>
        }
        else if (_view == WorkBoardView.Sprint && SelectedSprint is null)
        {
            <div class="workspace-empty"><button type="button" class="quiet-button" @onclick="@(() => SelectViewAsync(WorkBoardView.Backlog))">View backlog · @BacklogCount</button></div>
        }
        else
        {
            <nav class="workflow-navigation" aria-label="Jump to workflow stage">
                @foreach (var column in Detail.Columns)
                {
                    <button type="button" @onclick="@(() => JumpToColumnAsync(column.Id))">@column.Name <span>@VisibleItems.Count(x => x.ColumnId == column.Id)</span></button>
                }
            </nav>
            @if (HasFilters && VisibleItems.Count == 0) { <p class="board-notice" role="status">No work matches these filters. <button type="button" @onclick="ClearFilters">Clear filters</button></p> }
            <div class="workflow-columns" @ref="_columns" aria-label="Work board columns">
                @foreach (var column in Detail.Columns)
                {
                    var columnItems = VisibleItems.Where(x => x.ColumnId == column.Id).ToList();
                    var occupancy = Detail.Items.Count(x => x.ColumnId == column.Id);
                    <section class="workflow-column @(_dropTarget == column.Id ? "is-drop-target" : "")" data-column="@column.Id" @key="column.Id"
                             @ondragover:preventDefault="true" @ondragenter="@(() => _dropTarget = column.Id)" @ondrop="@(() => DropAsync(column, null))">
                        <header class="workflow-column-header"><div><span class="column-dot @column.Category.ToLowerInvariant()"></span><h3>@column.Name</h3><span class="count">@columnItems.Count</span></div>
                            @if (column.WipLimit.HasValue)
                            {
                                <small class="@(occupancy >= column.WipLimit ? "attention-text" : "")" title="Board-wide occupancy · @column.WipPolicy">@occupancy / @column.WipLimit WIP</small>
                            }
                        </header>
                        @foreach (var item in columnItems)
                        {
                            <article class="work-ticket" @key="item.Id" @ondragover:preventDefault="true" @ondrop:stopPropagation="true" @ondrop="@(() => DropAsync(column, item.Id))">
                                <button type="button" class="ticket-open" @onclick="@(() => OnOpenItem.InvokeAsync(item))" aria-label="Open @item.Identifier: @item.Title">
                                    <span class="ticket-top"><span title="@item.Identifier">@Present.ShortIdentifier(item, Detail.Board.Key) · @Present.TypeLabel(item)</span><span>@(item.EstimatePoints.HasValue ? $"{item.EstimatePoints:0.##} pts" : "")</span></span>
                                    <span class="ticket-title"><StructuredMentionText Text="@item.Title" Mentions="@item.Mentions" Field="@Wire.WorkItemMentionFields.Title" /></span>
                                    @if (_showDescriptions && !string.IsNullOrWhiteSpace(item.Description)) { <span class="ticket-description">@WorkBoardPresentation.DescriptionPreview(item.Description)</span> }
                                    <span class="ticket-footer"><span class="ticket-owner"><span class="owner-avatar" aria-hidden="true">@Initials(item.AssignedDisplayName)</span>@(item.AssignedDisplayName ?? "Unassigned")</span><span class="ticket-priority">@item.Priority</span></span>
                                    @if (_view == WorkBoardView.All && Sprints.FirstOrDefault(x => x.Id == item.SprintId) is { } sprint) { <span class="ticket-sprint">@sprint.Name</span> }
                                    @if (Attention(item) is { } attention) { <span class="ticket-attention"><MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" />@attention</span> }
                                </button>
                                @if (CanDrag(item)) { <button type="button" class="ticket-drag" draggable="true" @ondragstart="@(() => _draggedItem = item)" @ondragend="EndDrag" aria-label="Drag @item.Identifier; open item for Move or assign actions"><MudIcon Icon="@Icons.Material.Outlined.DragIndicator" Size="Size.Small" /></button> }
                            </article>
                        }
                        @if (columnItems.Count == 0) { <div class="column-empty">@(HasFilters ? "No matching work" : "No work here")</div> }
                    </section>
                }
            </div>
        }
    </div>
</main>

@code {
    [Parameter, EditorRequired] public WorkBoardDetailResponse Detail { get; set; } = default!;
    [Parameter] public IReadOnlyList<WorkSprintResponse> Sprints { get; set; } = [];
    [Parameter] public string? SprintError { get; set; }
    [Parameter] public string? MoveError { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public RenderFragment? BoardActions { get; set; }
    [Parameter] public RenderFragment? ContextContent { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnFavorite { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback OnManageSprints { get; set; }
    [Parameter] public EventCallback<WorkSprintResponse> OnExecution { get; set; }
    [Parameter] public EventCallback<WorkBoardItemResponse> OnOpenItem { get; set; }
    [Parameter] public EventCallback<WorkBoardDropRequest> OnDrop { get; set; }

    private WorkBoardView _view = WorkBoardView.Sprint;
    private Guid? _boardId, _sprintId, _dropTarget;
    private string _search = "";
    private bool _attentionOnly, _compact, _showDescriptions, _showInfo, _executionLoading, _disposed;
    private string? _executionError;
    private WorkBoardItemResponse? _draggedItem;
    private WorkBoardDetailResponse? _loadedDetail;
    private Guid? _loadedSprintId;
    private int _executionRequest;
    private IReadOnlyDictionary<Guid, Wire.WorkItemExecutionResponse> _executionItems = new Dictionary<Guid, Wire.WorkItemExecutionResponse>();
    private ElementReference _columns;
    private IJSObjectReference? _module;
    private bool CanReadSprints => Detail.Board.AllowedActions.Contains(WorkSprintActions.Read);
    private bool CanReadExecution => Detail.Board.AllowedActions.Contains(WorkOrchestrationActions.Read);
    private WorkSprintResponse? SelectedSprint => Sprints.FirstOrDefault(x => x.Id == _sprintId);
    private IEnumerable<WorkSprintResponse> OrderedSprints => Sprints.OrderBy(x => x.Status switch { "Active" => 0, "Paused" => 1, "Planned" => 2, _ => 3 }).ThenByDescending(x => x.StartsAt ?? x.CreatedAt);
    private IReadOnlyList<WorkBoardItemResponse> ScopedItems => Present.ScopeItems(Detail.Items, _view, _sprintId);
    private IReadOnlyList<WorkBoardItemResponse> VisibleItems => ScopedItems.Where(x => Present.Matches(x, _search) && (!_attentionOnly || Attention(x) is not null)).ToList();
    private int BacklogCount => Present.ScopeItems(Detail.Items, WorkBoardView.Backlog, null).Count;
    private int AttentionCount => ScopedItems.Count(x => Attention(x) is not null);
    private bool HasFilters => _attentionOnly || !string.IsNullOrWhiteSpace(_search);
    private string ViewTitle => _view switch { WorkBoardView.Backlog => "Product backlog", WorkBoardView.Sprints => "Sprint planning & history", _ => "All board work" };
    private string ViewDescription => _view switch { WorkBoardView.Backlog => "Unscheduled work for a future sprint.", WorkBoardView.Sprints => "Current commitments, upcoming plans, and completed sprints.", _ => "Every work item across the board, including unscheduled work." };
    private string SearchPlaceholder => _view switch { WorkBoardView.Backlog => "Search backlog…", WorkBoardView.All => "Search all work…", _ => "Search sprint…" };

    protected override async Task OnParametersSetAsync()
    {
        if (_boardId != Detail.Board.Id)
        {
            _boardId = Detail.Board.Id;
            _sprintId = null;
            _view = CanReadSprints ? WorkBoardView.Sprint : WorkBoardView.All;
            ClearFilters();
        }
        if (!CanReadSprints && _view is WorkBoardView.Sprint or WorkBoardView.Sprints) _view = WorkBoardView.All;
        _sprintId = CanReadSprints ? Present.SelectSprint(Sprints, _sprintId) : null;
        if (!ReferenceEquals(_loadedDetail, Detail) || _loadedSprintId != _sprintId)
            await LoadExecutionAsync();
    }

    private async Task LoadExecutionAsync()
    {
        var request = ++_executionRequest;
        _loadedDetail = Detail;
        _loadedSprintId = _sprintId;
        _executionItems = new Dictionary<Guid, Wire.WorkItemExecutionResponse>();
        _executionError = null;
        _executionLoading = false;
        if (_view != WorkBoardView.Sprint || !CanReadExecution || SelectedSprint is not { Status: "Active" or "Paused" or "Completed" or "Cancelled" } sprint) return;
        _executionLoading = true;
        try
        {
            using var response = await Http.GetAsync($"api/organizations/{Detail.Board.OrganizationId:D}/work/boards/{Detail.Board.Id:D}/orchestration/sprints/{sprint.Id:D}/execution");
            if (request != _executionRequest || _disposed) return;
            if (response.StatusCode == HttpStatusCode.NotFound) return;
            response.EnsureSuccessStatusCode();
            var execution = await response.Content.ReadFromJsonAsync<Wire.WorkSprintExecutionResponse>();
            if (request == _executionRequest && !_disposed)
                _executionItems = execution?.Items.ToDictionary(x => x.WorkItemId) ?? new Dictionary<Guid, Wire.WorkItemExecutionResponse>();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (request == _executionRequest && !_disposed) _executionError = "Execution information is unavailable. Attention counts may be incomplete.";
        }
        finally { if (request == _executionRequest) _executionLoading = false; }
    }

    public async Task ShowBacklogAsync() { await SelectViewAsync(WorkBoardView.Backlog); await InvokeAsync(StateHasChanged); }
    private async Task SelectViewAsync(WorkBoardView view) { _view = view; ClearFilters(); await LoadExecutionAsync(); }
    private Task SelectSprintAsync(ChangeEventArgs args) => Guid.TryParse(args.Value?.ToString(), out var id) ? OpenSprintAsync(id) : Task.CompletedTask;
    private async Task OpenSprintAsync(Guid id) { _sprintId = id; _view = WorkBoardView.Sprint; ClearFilters(); await LoadExecutionAsync(); }
    private void ClearFilters() { _search = ""; _attentionOnly = false; }
    private string? Attention(WorkBoardItemResponse item) => Present.AttentionReason(item, _executionItems.GetValueOrDefault(item.Id));
    private string ColumnName(WorkBoardItemResponse item) => Detail.Columns.FirstOrDefault(x => x.Id == item.ColumnId)?.Name ?? item.Status;
    private string TabClass(WorkBoardView view) => _view == view ? "is-active" : "";
    private string? Current(WorkBoardView view) => _view == view ? "page" : null;
    private static string StatusClass(string status) => status switch { "Active" or "Completed" => "is-success", "Paused" => "is-warning", _ => "" };
    private static string Initials(string? name) => string.IsNullOrWhiteSpace(name) ? "—" : string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
    private static string SprintDates(WorkSprintResponse sprint)
    {
        var start = sprint.StartsAt ?? sprint.StartedAt;
        var dates = start.HasValue && sprint.EndsAt.HasValue ? $"{start.Value.ToLocalTime():MMM d}–{sprint.EndsAt.Value.ToLocalTime():MMM d, yyyy}" : "Dates not set";
        if (sprint.Status == "Planned") return $"{dates} · Not started";
        if (sprint.Status == "Paused") return $"{dates} · Paused";
        if (sprint.Status != "Active" || !sprint.EndsAt.HasValue) return dates;
        var days = (sprint.EndsAt.Value.ToLocalTime().Date - DateTimeOffset.Now.Date).Days;
        return $"{dates} · {(days < 0 ? $"{Math.Abs(days)} days overdue" : days == 0 ? "Ends today" : $"{days} days remaining")}";
    }
    private bool CanDrag(WorkBoardItemResponse item) => !Busy && Detail.Columns.Any(column => WorkBoardPresentation.CanMove(Detail, item, column));
    private void EndDrag() { _draggedItem = null; _dropTarget = null; }
    private async Task DropAsync(WorkBoardColumnResponse column, Guid? beforeId)
    {
        var item = _draggedItem;
        EndDrag();
        if (item is not null && item.Id != beforeId && !Busy && WorkBoardPresentation.CanMove(Detail, item, column))
            await OnDrop.InvokeAsync(new WorkBoardDropRequest(item, column, beforeId));
    }
    private async Task JumpToColumnAsync(Guid id)
    {
        try
        {
            _module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/CSweet.UI/js/workBoard.js");
            await _module.InvokeVoidAsync("scrollToColumn", _columns, id.ToString());
        }
        catch (JSDisconnectedException) { }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _executionRequest++;
        if (_module is not null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}
