@using CSweet.Agent.SDK

<MudCard Class="marketplace-agent-card h-100" Outlined="true" Elevation="0">
    <MudCardContent>
        <div class="marketplace-agent-card-heading">
            <div class="marketplace-agent-icon">
                @if (IconUrl is not null)
                {
                    <img src="@IconUrl" alt="@($"{Agent.Name} icon")" />
                }
                else
                {
                    <MudIcon Icon="@(Agent.Source == AgentCatalogSource.FirstPartyCatalog
                        ? Icons.Material.Outlined.Verified
                        : Icons.Material.Outlined.SmartToy)" />
                }
            </div>
            <MudStack Row="true" Spacing="1" Class="marketplace-agent-badges">
                <MudChip T="string" Size="Size.Small"
                         Color="@(Agent.Source == AgentCatalogSource.FirstPartyCatalog ? Color.Primary : Color.Default)">
                    @SourceLabel
                </MudChip>
                @if (Agent.Availability is AgentAvailabilityState.InstalledEnabled or AgentAvailabilityState.InstalledDisabled)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                        @(Agent.Availability == AgentAvailabilityState.InstalledEnabled ? "Installed · enabled" : "Installed · disabled")
                    </MudChip>
                }
            </MudStack>
        </div>

        <MudText Typo="Typo.overline" Color="Color.Secondary">
            @Agent.Category · @(Agent.RoleName ?? "Unclassified role") · @Agent.Publisher
        </MudText>
        <MudText Typo="Typo.h5" Class="marketplace-agent-name">@Agent.Name</MudText>
        <MudText Color="Color.Secondary" Class="marketplace-agent-summary">@Agent.Summary</MudText>

        <div class="marketplace-agent-capabilities" aria-label="@($"{Agent.Name} capabilities")">
            @foreach (var capability in Agent.Capabilities.Take(4))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                    @capability
                </MudChip>
            }
        </div>

        <div class="marketplace-agent-meta">
            <MudText Typo="Typo.subtitle2">@PriceLabel</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @(Agent.Rating.HasValue
                    ? $"{Agent.Rating:0.0}/10 · {Agent.RatingCount} reviews"
                    : Agent.Trust)
            </MudText>
            @if (!string.IsNullOrWhiteSpace(Agent.LicenseSpdxId))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">License: @Agent.LicenseSpdxId</MudText>
            }
        </div>
    </MudCardContent>
    <MudCardActions Class="marketplace-agent-actions">
        @if (CanReviewHire)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.PersonAdd"
                       OnClick="@(() => ReviewHireRequested.InvokeAsync(Agent))">
                Review and hire
            </MudButton>
        }
        else
        {
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
                Not currently hireable
            </MudChip>
        }
        @if (!string.IsNullOrWhiteSpace(DetailsHref))
        {
            <MudButton Href="@DetailsHref" Target="_blank" Variant="Variant.Text"
                       EndIcon="@Icons.Material.Outlined.OpenInNew">
                Details
            </MudButton>
        }
    </MudCardActions>
</MudCard>

@code {
    [Parameter, EditorRequired] public AvailableAgent Agent { get; set; } = default!;
    [Parameter] public EventCallback<AvailableAgent> ReviewHireRequested { get; set; }

    private string SourceLabel => Agent.Source switch
    {
        AgentCatalogSource.Installed => "Installed",
        AgentCatalogSource.LocalDirectory => "Local directory",
        AgentCatalogSource.FirstPartyCatalog => "C-Sweet first party",
        AgentCatalogSource.Marketplace => "Marketplace",
        _ => Agent.Source.ToString()
    };

    private string? DetailsHref => Agent.DocumentationUrl ?? Agent.RepositoryUrl;
    private string? IconUrl => Agent.IconUrls?.FirstOrDefault();

    private bool CanReviewHire =>
        Agent.Availability is AgentAvailabilityState.AvailableToInstall or AgentAvailabilityState.InstalledEnabled &&
        (Agent.Source is AgentCatalogSource.Installed or AgentCatalogSource.LocalDirectory ||
         !string.IsNullOrWhiteSpace(Agent.RepositoryUrl));

    private string PriceLabel =>
        Agent.Price is null ? "Open source / free" : $"{Agent.Price:0.##} {Agent.Currency}";
}
