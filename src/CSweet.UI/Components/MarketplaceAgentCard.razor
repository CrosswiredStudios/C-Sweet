@using CSweet.Agent.SDK
@implements IAsyncDisposable
@inject IJSRuntime JS

<article @ref="_card" class="agent-brand-card" style="@AccentStyle" data-open="false" aria-label="@Agent.Name">
    <button type="button" class="agent-brand-front" aria-expanded="false" aria-controls="@_detailsId"
            aria-label="@($"Explore {Agent.Name}, {RoleLabel}")">
        <span class="agent-brand-art">
            <img src="@ImageUrl" alt="@($"{Agent.Name} agent artwork")" loading="lazy" decoding="async"
                 referrerpolicy="no-referrer" @onerror="ImageFailed" />
            <span class="agent-brand-company">
                @if (CompanyLogoUrl is { } logo)
                {
                    <img src="@logo" alt="@Agent.Publisher" referrerpolicy="no-referrer" @onerror="LogoFailed" />
                }
                else
                {
                    <span>@Agent.Publisher</span>
                }
            </span>
            <span class="agent-brand-state">@SourceLabel</span>
        </span>
        <span class="agent-brand-copy">
            <span class="agent-brand-name">@Agent.Name</span>
            <span class="agent-brand-role">@RoleLabel</span>
            <span class="agent-brand-summary">@Agent.Summary</span>
            <span class="agent-brand-explore">Explore agent <MudIcon Icon="@Icons.Material.Outlined.North" Size="Size.Small" /></span>
        </span>
    </button>
    <section id="@_detailsId" class="agent-brand-details" aria-label="@($"About {Agent.Name}")" aria-hidden="true" inert>
        <header class="agent-brand-details-header">
            <span class="agent-brand-publisher">@Agent.Publisher</span>
            <button type="button" class="agent-brand-close" aria-label="@($"Close {Agent.Name} details")">
                <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
            </button>
        </header>
        <div class="agent-brand-details-body">
            <h3>@Agent.Name</h3>
            <div class="agent-brand-role">@RoleLabel</div>
            <p class="agent-brand-description">@LongDescription</p>
            @if (Agent.Keywords.Count > 0)
            {
                <div class="agent-brand-tags" aria-label="Specialties">
                    @foreach (var keyword in Agent.Keywords.Take(4))
                    {
                        <span>@keyword</span>
                    }
                </div>
            }
            <div class="agent-brand-trust">@AvailabilityLabel · @Agent.Trust</div>
        </div>
        <footer class="agent-brand-details-footer">
            <span class="agent-brand-price">@PriceLabel</span>
            <button type="button" class="agent-brand-meet" @onclick="OpenProfile">
                Meet Agent <MudIcon Icon="@Icons.Material.Outlined.NorthEast" Size="Size.Small" />
            </button>
            <small>View profile, capabilities &amp; access</small>
        </footer>
    </section>
</article>

<MudDialog @bind-Visible="_profileOpen" Options="_profileOptions">
    <TitleContent>
        <MudText Typo="Typo.h5">Meet @Agent.Name</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2">@RoleLabel · @Agent.Publisher</MudText>
        <MudText Class="my-4" Style="white-space: pre-line; overflow-wrap: anywhere;">@LongDescription</MudText>
        <MudText Typo="Typo.subtitle2">Capabilities</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="my-3">
            @foreach (var capability in Agent.Capabilities)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@capability</MudChip>
            }
        </MudStack>
        <MudText Typo="Typo.body2">@AvailabilityLabel · @PriceLabel · @Agent.Trust</MudText>
        @if (!string.IsNullOrWhiteSpace(Agent.LicenseSpdxId))
        {
            <MudText Typo="Typo.caption">License: @Agent.LicenseSpdxId</MudText>
        }
        @if (Agent.Rating is { } rating)
        {
            <MudText Typo="Typo.caption">@($"{rating:0.0}/10 · {Agent.RatingCount} reviews")</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseProfile">Close</MudButton>
        @if (DetailsHref is { } details)
        {
            <MudButton Href="@details" Target="_blank" EndIcon="@Icons.Material.Outlined.OpenInNew">Documentation</MudButton>
        }
        @if (CanReviewHire && ReviewHireRequested.HasDelegate)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ReviewHireAsync">Review and hire</MudButton>
        }
        else if (!CanReviewHire)
        {
            <MudText Typo="Typo.caption">Not currently hireable</MudText>
        }
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public AvailableAgent Agent { get; set; } = default!;
    [Parameter] public EventCallback<AvailableAgent> ReviewHireRequested { get; set; }

    private readonly string _detailsId = $"agent-details-{Guid.NewGuid():N}";
    private readonly DialogOptions _profileOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true };
    private ElementReference _card;
    private IJSObjectReference? _module;
    private IJSObjectReference? _interaction;
    private string? _previousImage;
    private string? _previousLogo;
    private bool _imageFailed;
    private bool _logoFailed;
    private bool _profileOpen;
    private bool _disposed;

    private string ImageUrl => !_imageFailed && MarketplaceAgentPresentation.IsAgentImageUrl(Agent.ImageUrl)
        ? Agent.ImageUrl! : MarketplaceAgentPresentation.DefaultImageUrl;
    private string? CompanyLogoUrl => !_logoFailed && MarketplaceAgentPresentation.IsCompanyLogoUrl(Agent.CompanyLogoUrl)
        ? Agent.CompanyLogoUrl : null;
    private string AccentStyle => MarketplaceAgentPresentation.AccentStyle(Agent.AccentColor);
    private string LongDescription => string.IsNullOrWhiteSpace(Agent.LongDescription) ? Agent.Summary : Agent.LongDescription;
    private string RoleLabel => string.IsNullOrWhiteSpace(Agent.RoleName) ? Agent.Category : Agent.RoleName;
    private string? DetailsHref => AgentCatalogBranding.IsImageUrl(Agent.DocumentationUrl) ? Agent.DocumentationUrl
        : AgentCatalogBranding.IsImageUrl(Agent.RepositoryUrl) ? Agent.RepositoryUrl : null;
    private string SourceLabel => Agent.Source switch
    {
        AgentCatalogSource.Installed => "Installed agent",
        AgentCatalogSource.LocalDirectory => "Local agent",
        AgentCatalogSource.FirstPartyCatalog => "C-Sweet agent",
        _ => "Marketplace agent"
    };
    private string AvailabilityLabel => Agent.Availability switch
    {
        AgentAvailabilityState.InstalledEnabled => "Installed · enabled",
        AgentAvailabilityState.InstalledDisabled => "Installed · disabled",
        AgentAvailabilityState.Planned => "Coming soon",
        AgentAvailabilityState.AvailableToInstall => "Available to hire",
        _ => "Unavailable"
    };
    private bool CanReviewHire =>
        (Agent.Availability is AgentAvailabilityState.AvailableToInstall or AgentAvailabilityState.InstalledEnabled) &&
        (Agent.Source is AgentCatalogSource.Installed or AgentCatalogSource.LocalDirectory || !string.IsNullOrWhiteSpace(Agent.RepositoryUrl));
    private string PriceLabel => Agent.Price is null ? "Open source / free" : $"{Agent.Price:0.##} {Agent.Currency}";

    protected override void OnParametersSet()
    {
        if (_previousImage != Agent.ImageUrl) { _previousImage = Agent.ImageUrl; _imageFailed = false; }
        if (_previousLogo != Agent.CompanyLogoUrl) { _previousLogo = Agent.CompanyLogoUrl; _logoFailed = false; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CSweet.UI/js/marketplaceAgentCard.js");
        if (!_disposed) _interaction = await _module.InvokeAsync<IJSObjectReference>("attach", _card);
    }
    private void ImageFailed() => _imageFailed = true;
    private void LogoFailed() => _logoFailed = true;
    private void OpenProfile() => _profileOpen = true;
    private void CloseProfile() => _profileOpen = false;
    private async Task ReviewHireAsync()
    {
        _profileOpen = false;
        await ReviewHireRequested.InvokeAsync(Agent);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_interaction is not null) { await _interaction.InvokeVoidAsync("dispose"); await _interaction.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
