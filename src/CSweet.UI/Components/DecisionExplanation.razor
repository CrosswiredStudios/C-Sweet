@using CSweet.Contracts.Communications
@implements IAsyncDisposable
@inject HttpClient Http
@inject IAppLocalizer L

<MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="ask-follow-up"
           StartIcon="@Icons.Material.Outlined.ChatBubbleOutline" aria-haspopup="dialog" OnClick="() => _open = true">@L["Communications.Decision.AskFollowUp"]</MudButton>

@if (_open)
{
    <MudDialog @ref="_dialog" @bind-Visible="_open" Options="DialogSettings" aria-label="@L["Communications.Decision.AskFollowUp"]">
        <TitleContent><MudText Typo="Typo.h6">@L["Communications.Decision.AskFollowUp"]</MudText></TitleContent>
        <DialogContent>
            @if (Option is not null) { <p class="option-context">@Option.Label</p> }
            <label class="question-label">@L["Communications.Decision.QuestionLabel"]
                <textarea rows="3" maxlength="4000" disabled="@_busy" @bind="_question" @bind:event="oninput"></textarea>
            </label>
            <div aria-live="polite">
                @if (_busy) { <p>@L["Communications.Decision.Asking"]</p> }
                @if (_errorKey is not null) { <p role="alert">@L[_errorKey]</p> }
                @foreach (var exchange in _exchanges)
                {
                    <div class="follow-up-answer">
                        @if (exchange.OptionLabel is not null) { <small>@exchange.OptionLabel</small> }
                        <strong>@exchange.Question</strong>
                        <p>@exchange.Answer</p>
                    </div>
                }
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton Size="Size.Small" OnClick="CloseAsync">@L["Common.Close"]</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(_busy || string.IsNullOrWhiteSpace(_question))" OnClick="AskAsync">@L["Communications.Decision.SendQuestion"]</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid ConversationId { get; set; }
    [Parameter] public Guid DecisionId { get; set; }
    [Parameter] public ExecutiveDecisionOptionResponse? Option { get; set; }
    private static readonly DialogOptions DialogSettings = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };
    private readonly CancellationTokenSource _lifetime = new();
    private readonly List<Exchange> _exchanges = [];
    private MudDialog? _dialog;
    private bool _open, _busy;
    private string? _question, _errorKey;

    private async Task AskAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_question)) return;
        var question = _question.Trim();
        var option = Option;
        _busy = true;
        _errorKey = null;
        try
        {
            var result = await DecisionExplanationResult.RequestAsync(Http, OrganizationId, ConversationId, DecisionId,
                new(question, option?.Id), _lifetime.Token);
            _errorKey = result.ErrorKey;
            if (result.Answer is { } answer)
            {
                _exchanges.Insert(0, new(question, option?.Label, answer));
                _question = null;
            }
        }
        finally { _busy = false; }
    }

    private sealed record Exchange(string Question, string? OptionLabel, string Answer);
    private Task CloseAsync() => _dialog?.CloseAsync() ?? Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
        if (_open) await CloseAsync();
    }
}
