@using CSweet.Contracts.Core
@inject IAppLocalizer L
@inject UserTime Time

<div class="project-health-links" aria-label="@L["ProjectOverview.HealthAriaLabel"]">
    @foreach (var metric in Metrics)
    {
        <a href="@Link(metric.Tab)"><span>@L[metric.LabelKey]</span><strong>@metric.Count</strong><small>@L[metric.ActionKey] <span aria-hidden="true">↗</span></small></a>
    }
</div>
<div class="project-overview-grid">
    <div class="overview-primary">
        <article class="overview-panel brief-panel">
            <div class="overview-heading"><h2>@L["ProjectOverview.Brief.Title"]</h2><span class="eyebrow">@L["ProjectOverview.Brief.Eyebrow"]</span></div>
            <p class="brief-excerpt">@Brief</p>
            <details class="full-brief"><summary>@L["Projects.ReadFullBrief"]</summary><p>@Brief</p></details>
            <div class="brief-facts"><div><small>@L["Projects.CurrentPhase"]</small><strong>@ProjectPresentation.Metadata(Project.Project, "LifecycleStage", L["Projects.NotSet"])</strong></div><div><small>@L["Projects.TargetDateLabel"]</small><strong>@TargetDate</strong></div></div>
            <details class="project-record"><summary>@L["ProjectOverview.About"]</summary><dl><dt>@L["ProjectOverview.Field.Profile"]</dt><dd>@ProjectPresentation.Profile(Project.Project.TypeKey, L)</dd><dt>@L["ProjectOverview.Field.Revision"]</dt><dd>@Project.Project.Revision</dd><dt>@L["ProjectOverview.Field.Updated"]</dt><dd>@Time.Format(Project.Project.OccurredAt, "MMM d, yyyy · h:mm tt")</dd>@if (!string.IsNullOrWhiteSpace(Project.Project.Sha256)) { <dt>@L["ProjectOverview.Field.RecordHash"]</dt><dd>@Project.Project.Sha256</dd> }</dl></details>
        </article>
        <article class="overview-panel">
            <div class="overview-heading"><h2>@L["ProjectOverview.WorkPeople.Title"]</h2><a href="@Link("work")">@L["ProjectOverview.ViewWork"] ↗</a></div>
            @foreach (var board in Project.Work.Where(x => x.ResourceType == "Board"))
            { <a class="overview-row" href="@($"{Link("work")}&board={board.Id:D}")"><div><strong>@board.Title</strong><small>@L["ProjectOverview.ProjectBoard"] · @board.Status</small></div><span aria-hidden="true">↗</span></a> }
            @foreach (var team in Project.Teams.Where(x => x.ResourceType == "Team"))
            { <a class="overview-row" href="@Link("people")"><div><strong>@team.Title</strong><small>@L["ProjectOverview.Team"] · @team.Status</small></div><span aria-hidden="true">↗</span></a> }
            @if (!Project.Work.Any(x => x.ResourceType == "Board") && !Project.Teams.Any(x => x.ResourceType == "Team"))
            { <p class="muted">@L["ProjectOverview.NoBoardsOrTeams"]</p><a href="@($"{ProjectHref}/members")">@L["Projects.ManageMembers"] →</a> }
        </article>
    </div>
    <div class="overview-secondary">
        <article class="overview-panel readiness-panel">
            <span class="eyebrow">@L["Projects.DeliveryReadiness"]</span>
            <h2 class="readiness-title">@(Project.Health.ReleaseReady ? L["ProjectOverview.ReadyForRelease"] : L["Projects.NotReady"])</h2>
            <p class="muted">@(Project.Health.ReleaseReady ? L["ProjectOverview.ReadyHint"] : L["ProjectOverview.NotReadyHint"])</p>
            @if (Project.Health.FailedBuilds > 0) { <a class="overview-row" href="@Link("delivery")"><span>@L["ProjectOverview.FailedBuilds"]</span><strong>@Project.Health.FailedBuilds</strong></a> }
            @if (Project.Health.BlockingValidations > 0) { <a class="overview-row" href="@Link("delivery")"><span>@L["ProjectOverview.BlockingValidations"]</span><strong>@Project.Health.BlockingValidations</strong></a> }
            @if (Project.Health.DocumentsInReview > 0) { <a class="overview-row" href="@Link("documents")"><span>@L["ProjectOverview.DocumentsInReview"]</span><strong>@Project.Health.DocumentsInReview</strong></a> }
            @if (!Project.Evidence.Any(x => x.ResourceType == "Build")) { <p class="readiness-note">@L["ProjectOverview.NoBuildRecorded"]</p> }
            <a class="overview-action" href="@Link("delivery")">@L["ProjectOverview.InspectDelivery"] <span aria-hidden="true">→</span></a>
        </article>
        <article class="overview-panel">
            <div class="overview-heading"><h2>@L["ProjectOverview.RecentActivity"]</h2><a href="@Link("audit")">@L["ProjectOverview.ViewAudit"] ↗</a></div>
            @foreach (var entry in RecentActivity)
            { <div class="activity-entry"><span class="activity-dot" aria-hidden="true"></span><div><strong>@(string.IsNullOrWhiteSpace(entry.Summary) ? entry.EventType : entry.Summary)</strong><small>@(entry.ActorDisplayName ?? entry.ActorKind) · @Time.Format(entry.OccurredAt, "MMM d · h:mm tt")</small></div></div> }
            @if (!RecentActivity.Any()) { <p class="muted">@L["ProjectOverview.NoActivity"]</p> }
        </article>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProjectInspectionResponse Project { get; set; } = default!;
    [Parameter, EditorRequired] public string ProjectHref { get; set; } = "";
    private string Link(string tab) => $"{ProjectHref}?tab={tab}";
    private string Brief => ProjectPresentation.Metadata(Project.Project, "Outcome", L["ProjectOverview.NoBrief"]);
    private string TargetDate => DateTimeOffset.TryParse(ProjectPresentation.Metadata(Project.Project, "TargetDate", ""), out var date) ? Time.Format(date, "MMM d, yyyy") : L["ProjectOverview.NoTargetDate"];
    private IEnumerable<ProjectAuditEntry> RecentActivity => Project.Audit.Where(x => !ProjectPresentation.IsRoutineRead(x)).OrderByDescending(x => x.OccurredAt).Take(4);
    private (string LabelKey, int Count, string Tab, string ActionKey)[] Metrics => [("ProjectOverview.Metric.OpenWork", Project.Health.OpenItems, "work", "ProjectOverview.Metric.ExploreBoard"), ("ProjectOverview.Metric.BlockedWork", Project.Health.BlockedItems, "work", "ProjectOverview.Metric.InspectWork"), ("ProjectOverview.Metric.PendingGates", Project.Health.PendingGates, "decisions", "ProjectOverview.Metric.ReviewGates"), ("ProjectOverview.Metric.OpenDecisions", Project.Health.OpenDecisions, "decisions", "ProjectOverview.Metric.ViewDecisions")];
}
