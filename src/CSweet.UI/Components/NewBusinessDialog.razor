@inject NavigationManager Navigation
<MudDialog Visible="Visible" VisibleChanged="VisibleChanged" Options="Options">
    <DialogContent>
        <section class="business-dialog onboarding-dialog">
            <header class="business-dialog-header"><div><span class="business-kicker">Enterprise · New business</span><h2>Where would you like to start?</h2><p>Create your business first. Bring existing projects along whenever you are ready.</p></div><MudIconButton Icon="@Icons.Material.Outlined.Close" OnClick="CloseAsync" aria-label="Close new business dialog" /></header>
            <div class="onboarding-story-grid">
                <button type="button" class="onboarding-story" @onclick="StartNew"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" /><strong>New business</strong><p>Start with a name, a mission, and an idea.</p><span>Start fresh</span></button>
                <button type="button" class="onboarding-story" @onclick="StartExisting"><MudIcon Icon="@Icons.Material.Outlined.Business" /><strong>Existing business</strong><p>Create your business, then import the projects you already have.</p><span>Bring existing work</span></button>
            </div>
        </section>
    </DialogContent>
</MudDialog>
@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback NewBusiness { get; set; }
    [Parameter] public Guid? DraftId { get; set; }
    [Parameter] public bool ResumeGitHubSetup { get; set; }
    private bool _redirected;
    private DialogOptions Options => new() { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true, BackdropClick = false, CloseOnEscapeKey = true };
    private Task CloseAsync() => VisibleChanged.InvokeAsync(false);
    private void StartNew() => Start("New");
    private void StartExisting() => Start("Existing");
    private void Start(string mode) => Navigation.NavigateTo($"/businesses/new?mode={mode}" + (DraftId is { } id ? $"&draft={id:D}" : ""));
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_redirected && Visible && DraftId.HasValue) { _redirected = true; StartExisting(); }
        return Task.CompletedTask;
    }
}
