@inject IAppLocalizer L
<nav class="employee-page-tabs" aria-label="@L["EmployeePageTabs.EmployeesSections"]">
    <a href="@TeamUrl"
       aria-current="@(!HiringSelected ? "page" : null)"
       class="@(!HiringSelected ? "active" : null)">
        @L["EmployeePageTabs.Team"]
    </a>
    <a href="@HiringUrl"
       aria-current="@(HiringSelected ? "page" : null)"
       class="@(HiringSelected ? "active" : null)">
        @L["EmployeePageTabs.Hiring"]
    </a>
</nav>
