@inject IAppLocalizer L
<div class="employee-directory-table-wrap">
    <table class="employee-directory-table">
        <thead>
            <tr><th>@L["EmployeeDirectoryTable.Employee"]</th><th>@L["EmployeeDirectoryTable.Teams"]</th><th>@L["EmployeeDirectoryTable.Type"]</th><th>@L["EmployeeDirectoryTable.Status"]</th><th>@L["EmployeeDirectoryTable.Manager"]</th><th>@L["EmployeeDirectoryTable.DirectReports"]</th><th><span class="sr-only">@L["EmployeeDirectoryTable.Actions"]</span></th></tr>
        </thead>
        <tbody>
            @foreach (var employee in Employees)
            {
                <tr class="@(employee.Id == SelectedId ? "selected" : null)">
                    <td>
                        <EmployeeIdentityButton Employee="employee" EmployeeSelected="EmployeeSelected" />
                    </td>
                    <td><EmployeeTeamChips Teams="employee.Teams" /></td>
                    <td><EmployeeTypeBadge IsAgent="employee.IsAgent" /></td>
                    <td><EmployeeStatusBadge Status="employee.Status" /></td>
                    <td>@(employee.ManagerName ?? "—")</td>
                    <td>@employee.DirectReportCount</td>
                    <td><EmployeeActionMenu Employee="employee" ActionRequested="ActionRequested" /></td>
                </tr>
            }
        </tbody>
    </table>
</div>
