@inject IAppLocalizer L
<aside class="employee-details" aria-label="@L["EmployeeDetailsPanel.SelectedEmployeeDetails"]">
    @if (Employee is not null)
    {
        <header>
            <EmployeeAvatar Employee="Employee" />
            <div>
                <MudText Typo="Typo.h6">@Employee.Name</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Employee.RoleLabel</MudText>
                <div class="employee-detail-badges">
                    <EmployeeTypeBadge IsAgent="Employee.IsAgent" />
                    @if (Employee.IsAgent)
                    {
                        <EmployeeStatusBadge Status="Employee.Status" />
                    }
                </div>
            </div>
        </header>
        <section>
            <MudText Typo="Typo.overline">@L["EmployeeDetailsPanel.Overview"]</MudText>
            <dl>
                <div><dt>@L["EmployeeDetailsPanel.ReportsTo"]</dt><dd>@(Employee.ManagerName ?? "Nobody")</dd></div>
                <div><dt>@L["EmployeeDetailsPanel.DirectReports"]</dt><dd>@Employee.DirectReportCount</dd></div>
                <div><dt>@L["EmployeeDetailsPanel.Type"]</dt><dd>@(Employee.IsAgent ? "Agent" : "Human")</dd></div>
            </dl>
        </section>
        <section>
            <MudText Typo="Typo.overline">Teams (@Employee.Teams.Count)</MudText>
            <EmployeeTeamChips Teams="Employee.Teams" />
            @foreach (var team in Employee.Teams)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Groups"
                           OnClick="@(() => TeamSelected.InvokeAsync(team.TeamId))">
                    Focus @team.TeamName
                </MudButton>
            }
        </section>
        <section>
            <MudText Typo="Typo.overline">Direct reports (@Employee.DirectReportCount)</MudText>
            @if (DirectReports.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["EmployeeDetailsPanel.NoDirectReports"]</MudText>
            }
            else
            {
                <div class="employee-direct-reports">
                    @foreach (var report in DirectReports)
                    {
                        <button type="button" @onclick="@(() => SelectAsync(report.Id))">
                            <EmployeeAvatar Employee="report" />
                            <span><strong>@report.Name</strong><small>@report.RoleLabel</small></span>
                        </button>
                    }
                </div>
            }
        </section>
        <section>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/organizations/{Employee.Source.OrganizationId}/employees/{Employee.Id}")">@L["EmployeeDetailsPanel.ViewProfile"]</MudButton>
            <EmployeeActionMenu Employee="Employee" ShowDirectChat="false" ActionRequested="ActionRequested" />
        </section>
    }
</aside>
