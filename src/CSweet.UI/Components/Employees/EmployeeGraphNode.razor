<article class="employee-node">
    <a class="employee-node-link" href="@($"/organizations/{Employee.Source.OrganizationId}/employees/{Employee.Id}")" aria-label="@($"Open {Employee.Name} details")">
        <EmployeeAvatar Employee="Employee" />
        <span class="employee-node-copy">
            <strong title="@Employee.Name">@Employee.Name</strong>
            <small title="@Employee.RoleLabel">@Employee.RoleLabel</small>
        </span>
    </a>
    @if (Employee.IsAgent)
    {
        <div class="employee-node-state"><EmployeeStatusBadge Status="Employee.Status" Compact="true" /></div>
    }
    @if (Employee.DirectReportCount > 0)
    {
        <button type="button" class="employee-node-reports" aria-expanded="@(!Collapsed)" aria-label="@($"{(Collapsed ? "Expand" : "Collapse")} {Employee.Name}'s reports")" @onclick="ToggleAsync">
            @ReportLabel <MudIcon Icon="@(Collapsed ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)" Size="Size.Small" />
        </button>
    }
</article>
