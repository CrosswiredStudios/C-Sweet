@inject IAppLocalizer L
<div class="employee-graph-toolbar" aria-label="@L["EmployeeGraphToolbar.GraphFilters"]">
    <MudSelect T="Guid?"
               Label="@L["EmployeeGraphToolbar.HighlightTeam"]"
               Value="SelectedTeamId"
               ValueChanged="SelectedTeamIdChanged"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Clearable="true"
               Class="employee-team-select">
        @foreach (var team in Teams.Where(x => !x.IsArchived).OrderBy(x => x.Name))
        {
            <MudSelectItem T="Guid?" Value="@((Guid?)team.Id)">@team.Name</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="int"
               Label="@L["EmployeeGraphToolbar.Degrees"]"
               Value="Degrees"
               ValueChanged="DegreesChanged"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Class="employee-degree-select">
        <MudSelectItem T="int" Value="1">@L["EmployeeGraphToolbar.1Degree"]</MudSelectItem>
        <MudSelectItem T="int" Value="2">@L["EmployeeGraphToolbar.2Degrees"]</MudSelectItem>
        <MudSelectItem T="int" Value="3">@L["EmployeeGraphToolbar.3Degrees"]</MudSelectItem>
    </MudSelect>
    <MudTooltip Text="@L["EmployeeGraphToolbar.ControlsHowManyReportingRelationships"]">
        <MudIconButton Icon="@Icons.Material.Outlined.Info" Color="Color.Primary" aria-label="@L["EmployeeGraphToolbar.AboutGraphDegrees"]" />
    </MudTooltip>
</div>
