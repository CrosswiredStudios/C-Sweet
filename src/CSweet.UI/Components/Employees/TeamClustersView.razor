@using CSweet.Contracts.Core
@using CSweet.UI.Components.Employees.Models
@inject IAppLocalizer L

<section class="team-workspace" aria-label="@L["TeamClustersView.Teams"]">
    <div class="workspace-tools">
        <MudTextField T="string" @bind-Value="_search" Placeholder="@L["TeamClustersView.SearchPeopleOrRoles"]" Immediate="true"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Search" aria-label="@L["TeamClustersView.SearchTeamMembers"]" />
        <MudSelect T="string" Value="_archiveFilter" ValueChanged="ChangeArchiveFilter" Label="@L["TeamClustersView.Teams"]" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem T="string" Value="@("active")">@L["TeamClustersView.Active"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("archived")">@L["TeamClustersView.Archived"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("all")">@L["TeamClustersView.All"]</MudSelectItem>
        </MudSelect>
        @if (Directory.CanManageTeams)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.GroupAdd"
                       OnClick="@(() => ActionRequested.InvokeAsync(new TeamUiActionRequest(TeamUiActionKind.Create)))">@L["TeamClustersView.CreateTeam"]</MudButton>
        }
    </div>
    <div class="workspace-body">
        <nav class="team-rail" aria-label="@L["TeamClustersView.ChooseATeam"]">
            <button class="@(_selectedTeamId is null && !_unassigned ? "active" : null)" aria-pressed="@(_selectedTeamId is null && !_unassigned)" @onclick="() => Choose(null)"><span>@L["TeamClustersView.AllPeople"]</span><small>@Employees.Count</small></button>
            @foreach (var team in FilteredTeams)
            {
                <button class="@(_selectedTeamId == team.Id ? "active" : null)" aria-pressed="@(_selectedTeamId == team.Id)" @onclick="() => Choose(team.Id)">
                    <span>@team.Name @if (team.IsArchived) { <em>@L["TeamClustersView.Archived"]</em> }</span><small>@team.ActiveMemberCount</small>
                </button>
            }
            @if (Unassigned.Count > 0)
            {
                <button class="@(_unassigned ? "active" : null)" aria-pressed="@_unassigned" @onclick="ChooseUnassigned"><span>@L["TeamClustersView.Unassigned"]</span><small>@Unassigned.Count</small></button>
            }
        </nav>
        <div class="team-content">
            @{ var selectedTeam = SelectedTeam; }
            <header class="team-content-heading">
                <div><h2>@(selectedTeam?.Name ?? (_unassigned ? "Unassigned" : "All people"))</h2>
                    @if (!string.IsNullOrWhiteSpace(selectedTeam?.Description)) { <p>@selectedTeam.Description</p> }
                    @if (selectedTeam?.TeamKey == LeadershipTeamPresentation.TeamKey) { <p>@L["TeamClustersView.MembershipFollowsYourReportingStructure"]</p> }
                </div>
                @if (selectedTeam is not null && Directory.CanManageTeams && selectedTeam.TeamKey != LeadershipTeamPresentation.TeamKey)
                {
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="@($"Manage {selectedTeam.Name}")">
                        <MudMenuItem OnClick="@(() => ActionRequested.InvokeAsync(new TeamUiActionRequest(TeamUiActionKind.Edit, selectedTeam.Id)))">@L["TeamClustersView.EditTeam"]</MudMenuItem>
                        @if (selectedTeam.IsArchived)
                        {
                            <MudMenuItem OnClick="@(() => ActionRequested.InvokeAsync(new TeamUiActionRequest(TeamUiActionKind.Restore, selectedTeam.Id)))">@L["TeamClustersView.RestoreTeam"]</MudMenuItem>
                        }
                        else
                        {
                            <MudMenuItem OnClick="@(() => ActionRequested.InvokeAsync(new TeamUiActionRequest(TeamUiActionKind.AddMember, selectedTeam.Id)))">@L["TeamClustersView.AddMember"]</MudMenuItem>
                            <MudMenuItem OnClick="@(() => ActionRequested.InvokeAsync(new TeamUiActionRequest(TeamUiActionKind.Archive, selectedTeam.Id)))">@L["TeamClustersView.ArchiveTeam"]</MudMenuItem>
                        }
                    </MudMenu>
                }
            </header>
            <div class="team-people">
                @foreach (var employee in VisibleEmployees)
                {
                    var membership = selectedTeam?.Members.FirstOrDefault(x => x.OrganizationUserId == employee.Id && x.EndedAt is null);
                    <article class="person-card">
                        <a href="@($"/organizations/{employee.Source.OrganizationId}/employees/{employee.Id}")" aria-label="@($"Open {employee.Name} details")">
                            <EmployeeAvatar Employee="employee" />
                            <strong>@employee.Name</strong>
                            <span>@(membership?.TeamRoleName ?? employee.RoleLabel)</span>
                            @if (membership?.IsLead == true) { <small>@L["TeamClustersView.TeamLead"]</small> }
                        </a>
                        @if (employee.IsAgent) { <div class="person-state"><EmployeeStatusBadge Status="employee.Status" Compact="true" /></div> }
                        @if (membership is not null && selectedTeam is not null && Directory.CanManageTeams && selectedTeam.TeamKey != LeadershipTeamPresentation.TeamKey && !membership.IsLead && !selectedTeam.IsArchived)
                        {
                            <div class="person-actions"><MudIconButton Icon="@Icons.Material.Outlined.PersonRemove" Size="Size.Small"
                                aria-label="@($"Remove {employee.Name} from {selectedTeam.Name}")"
                                OnClick="@(() => ActionRequested.InvokeAsync(new TeamUiActionRequest(TeamUiActionKind.RemoveMember, selectedTeam.Id, employee.Id)))" /></div>
                        }
                    </article>
                }
            </div>
            @if (VisibleEmployees.Count == 0)
            {
                <div class="team-empty"><h3>@(string.IsNullOrWhiteSpace(_search) ? "No team members yet" : "No matching people")</h3><p>@(string.IsNullOrWhiteSpace(_search) ? "Team members will appear here when they are assigned." : "Try another name or role.")</p></div>
            }
        </div>
    </div>
</section>

@code {
    private string _search = string.Empty;
    private string _archiveFilter = "active";
    private Guid? _selectedTeamId;
    private Guid? _previousFocus;
    private bool _unassigned;
    private bool _initialized;
    [Parameter] public TeamDirectoryResponse Directory { get; set; } = new(Guid.Empty, false, []);
    [Parameter] public IReadOnlyList<EmployeeViewModel> Employees { get; set; } = [];
    [Parameter] public Guid? FocusTeamId { get; set; }
    [Parameter] public EventCallback<TeamUiActionRequest> ActionRequested { get; set; }
    protected override void OnParametersSet()
    {
        if (FocusTeamId != _previousFocus && FocusTeamId.HasValue) Choose(FocusTeamId);
        else if (!_initialized) Choose(Directory.Teams.FirstOrDefault(x => !x.IsArchived && x.TeamKey != LeadershipTeamPresentation.TeamKey)?.Id);
        _previousFocus = FocusTeamId;
        _initialized = true;
        if (_selectedTeamId.HasValue && !Directory.Teams.Any(x => x.Id == _selectedTeamId)) Choose(null);
    }
    private void Choose(Guid? id) { _selectedTeamId = id; _unassigned = false; }
    private void ChangeArchiveFilter(string value)
    {
        _archiveFilter = value;
        if (_selectedTeamId.HasValue && !FilteredTeams.Any(x => x.Id == _selectedTeamId))
            Choose(FilteredTeams.FirstOrDefault()?.Id);
    }
    private void ChooseUnassigned() { _selectedTeamId = null; _unassigned = true; }
    private TeamSummaryResponse? SelectedTeam => Directory.Teams.FirstOrDefault(x => x.Id == _selectedTeamId);
    private IReadOnlyList<TeamSummaryResponse> FilteredTeams => Directory.Teams
        .Where(team => _archiveFilter == "all" || (_archiveFilter == "archived" ? team.IsArchived : !team.IsArchived))
        .OrderBy(team => team.Name, StringComparer.OrdinalIgnoreCase).ToList();
    private IReadOnlyList<EmployeeViewModel> Unassigned => Employees.Where(x => !x.Teams.Any(team => !team.IsArchived)).ToList();
    private IReadOnlyList<EmployeeViewModel> VisibleEmployees => (_unassigned ? Unassigned : Employees)
        .Where(x => SelectedTeam is null || SelectedTeam.Members.Any(m => m.OrganizationUserId == x.Id && m.EndedAt is null))
        .Where(x => string.IsNullOrWhiteSpace(_search) || x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            x.RoleLabel.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            (SelectedTeam?.Members.Any(m => m.OrganizationUserId == x.Id && m.EndedAt is null && (m.TeamRoleName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)) ?? false))
        .OrderByDescending(x => SelectedTeam?.Members.Any(m => m.OrganizationUserId == x.Id && m.EndedAt is null && m.IsLead) == true)
        .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase).ToList();
}
