@using CSweet.UI.Components.Employees.Models
@inject IAppLocalizer L

@if (Teams.Count == 0)
{
    <span class="team-chip unassigned">@L["EmployeeTeamChips.Unassigned"]</span>
}
else
{
    <span class="team-chips" aria-label="@L["EmployeeTeamChips.TeamMemberships"]">
        @foreach (var team in VisibleTeams)
        {
            <span class="team-chip" style="@($"--team-color:{team.Color}")" title="@team.TeamName">
                <span class="team-chip-dot" aria-hidden="true"></span>
                <span class="team-chip-name">@team.TeamName</span>
                @if (!string.IsNullOrWhiteSpace(team.TeamRole))
                {
                    <small>@team.TeamRole</small>
                }
                @if (team.IsLead)
                {
                    <span class="sr-only">@L["EmployeeTeamChips.TeamLead"]</span>
                }
            </span>
        }
        @if (HiddenTeamCount > 0)
        {
            <span class="team-chip more" title="@($"{HiddenTeamCount} more team memberships")">
                +@HiddenTeamCount
            </span>
        }
    </span>
}

@code {
    [Parameter]
    public IReadOnlyList<EmployeeTeamViewModel> Teams { get; set; } = [];

    [Parameter]
    public int? MaxVisible { get; set; }

    private IEnumerable<EmployeeTeamViewModel> VisibleTeams =>
        MaxVisible is > 0 ? Teams.Take(MaxVisible.Value) : Teams;

    private int HiddenTeamCount =>
        MaxVisible is > 0 ? Math.Max(0, Teams.Count - MaxVisible.Value) : 0;
}
