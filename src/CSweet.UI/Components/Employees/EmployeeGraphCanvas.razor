@implements IAsyncDisposable

<div class="employee-graph-canvas-shell">
    <div @ref="_viewport"
         class="employee-graph-canvas"
         tabindex="0"
         aria-label="Reporting graph. Drag to pan. Use the mouse wheel or zoom controls to zoom. Arrow keys pan and plus or minus keys zoom.">
        <svg @ref="_content"
             width="@Graph.Width"
             height="@Graph.Height"
             viewBox="@ViewBox"
             role="img"
             aria-label="Employee reporting relationships">
            @foreach (var edge in Graph.Edges)
            {
                <path class="employee-graph-connector" d="@EdgePath(edge)" />
            }
            @foreach (var node in Graph.Nodes)
            {
                <foreignObject @key="node.Employee.Id"
                               class="@NodeFilterClass(node.Employee)"
                               x="@(node.X - Graph.NodeWidth / 2)"
                               y="@(node.Y - Graph.NodeHeight / 2)"
                               width="@Graph.NodeWidth"
                               height="@Graph.NodeHeight">
                    <EmployeeGraphNode Employee="node.Employee"
                                       Selected="@(node.Employee.Id == SelectedId)"
                                       SelectedChanged="SelectAsync" />
                </foreignObject>
            }
        </svg>
    </div>
    <EmployeeGraphZoomControls Zoom="_zoom"
                               ZoomInRequested="ZoomInAsync"
                               ZoomOutRequested="ZoomOutAsync"
                               FitRequested="FitAsync" />
    <div class="employee-graph-pan-hint" aria-hidden="true">
        <MudIcon Icon="@Icons.Material.Outlined.PanTool" Size="Size.Small" />
        Drag to move
    </div>
</div>
