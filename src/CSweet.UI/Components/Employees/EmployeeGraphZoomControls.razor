@inject IAppLocalizer L
<div class="employee-graph-zoom-controls" role="group" aria-label="@L["EmployeeGraphZoomControls.GraphZoomControls"]">
    <button type="button" title="@L["EmployeeGraphZoomControls.ZoomOut"]" aria-label="@L["EmployeeGraphZoomControls.ZoomOut"]" @onclick="ZoomOutAsync">
        <MudIcon Icon="@Icons.Material.Outlined.Remove" />
    </button>
    <output aria-live="polite" aria-label="@L["EmployeeGraphZoomControls.CurrentZoom"]">@ZoomLabel</output>
    <button type="button" title="@L["EmployeeGraphZoomControls.ZoomIn"]" aria-label="@L["EmployeeGraphZoomControls.ZoomIn"]" @onclick="ZoomInAsync">
        <MudIcon Icon="@Icons.Material.Outlined.Add" />
    </button>
    <span aria-hidden="true"></span>
    <button type="button" class="fit-button" title="@L["EmployeeGraphZoomControls.FitGraphToView"]" aria-label="@L["EmployeeGraphZoomControls.FitGraphToView"]" @onclick="FitAsync">
        <MudIcon Icon="@Icons.Material.Outlined.FitScreen" />
    </button>
</div>
