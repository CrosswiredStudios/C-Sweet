@using System.Text.Json
@using CSweet.Contracts.Realtime
@implements IDisposable
@inject AppRealtimeState Realtime
@inject CommunicationUnreadState Unread
@inject AgentHireOperationState AgentHires
@inject BusinessOnboardingOperationState BusinessOnboardingOperations
@inject IBusinessContext Businesses
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private readonly CancellationTokenSource _disposeCts = new();
    private CancellationToken _disposeToken;
    private bool _started;

    protected override void OnInitialized()
    {
        _disposeToken = _disposeCts.Token;
        Realtime.EventReceived += OnEvent;
        Realtime.Disconnected += OnDisconnected;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started) return;
        _started = true;
        await Businesses.InitializeAsync();
        await Unread.InitializeAsync();
        await AgentHires.InitializeAsync();
        await BusinessOnboardingOperations.InitializeAsync();
        if (!_disposeToken.IsCancellationRequested)
        {
            _ = ConnectWithRetryAsync(_disposeToken);
        }
    }

    private void OnDisconnected()
    {
        if (!_disposeToken.IsCancellationRequested)
        {
            _ = ConnectWithRetryAsync(_disposeToken);
        }
    }

    private async Task ConnectWithRetryAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            try
            {
                await Realtime.StartAsync(cancellationToken);
                await Unread.ReloadAsync(cancellationToken);
                return;
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { return; }
            catch (Exception)
            {
                try { await Task.Delay(TimeSpan.FromSeconds(5), cancellationToken); }
                catch (OperationCanceledException) { return; }
            }
        }
    }

    private void OnEvent(AppRealtimeEventEnvelope envelope)
    {
        if (envelope.EventType != AppRealtimeEvents.NotificationCreated) return;
        try
        {
            var notification = envelope.Data.Deserialize<AppNotificationEvent>(JsonOptions);
            if (notification is null) return;
            var severity = notification.Severity switch
            {
                "Urgent" => Severity.Error,
                "Important" => Severity.Warning,
                _ => Severity.Info
            };
            _ = InvokeAsync(() => ShowNotification(notification, severity));
        }
        catch (JsonException) { }
    }

    private void ShowNotification(AppNotificationEvent notification, Severity severity)
    {
        var message = notification.Category == "ResourceChangeApproval"
            ? "Hiring plan approval needed"
            : $"{notification.Title}: {notification.Body}";
        Snackbar.Add(message, severity, options =>
        {
            if (string.IsNullOrWhiteSpace(notification.ActionUri)) return;
            options.Action = notification.Category == "ResourceChangeApproval" ? "Review" : "Open";
            options.ActionColor = Color.Primary;
            options.ActionVariant = Variant.Filled;
            options.CloseAfterNavigation = true;
            options.OnClick = _ =>
            {
                Navigation.NavigateTo(notification.ActionUri);
                return Task.CompletedTask;
            };
        }, key: $"notification:{notification.NotificationId:D}");
    }

    public void Dispose()
    {
        Realtime.EventReceived -= OnEvent;
        Realtime.Disconnected -= OnDisconnected;
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }
}
