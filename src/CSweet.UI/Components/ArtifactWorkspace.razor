@using CSweet.Contracts.Core
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject CSweet.UI.Services.AppRealtimeState Realtime

<aside class="artifact-workspace" @ref="_panel" aria-label="Document workspace">
    <header class="artifact-workspace-header">
        <div class="artifact-workspace-heading">
            <span class="artifact-workspace-mark" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Outlined.Description" />
            </span>
            <div>
                <span class="artifact-workspace-eyebrow"><i></i>C-SWEET DOCUMENT</span>
                <MudText Typo="Typo.h5">@(_detail?.Document.Title ?? "Loading…")</MudText>
                @if (_detail is { } headingDetail)
                {
                    <span class="artifact-workspace-type">@FormatDocumentType(headingDetail.Document.DocumentType)</span>
                }
            </div>
        </div>
        <div class="artifact-workspace-header-actions">
            @if (_detail is not null)
            {
                <MudIconButton Icon="@(_detail.Document.ArchivedAt.HasValue ? Icons.Material.Outlined.Unarchive : Icons.Material.Outlined.Archive)"
                               OnClick="ToggleArchiveAsync" Disabled="@_busy" aria-label="Archive or restore document" />
            }
            <MudIconButton Icon="@Icons.Material.Outlined.Close" OnClick="CloseAsync" aria-label="Close document" />
        </div>
    </header>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_notFound)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            This document is unavailable or has not been shared with you.
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="RequestAccessAsync" Class="mt-3">
            Request access
        </MudButton>
    }
    else if (_detail is { } detail)
    {
        <div class="artifact-workspace-meta">
            <MudChip T="string" Size="Size.Small" Color="@StatusColor(detail.Document.Status)" Variant="Variant.Filled">@StatusLabel(detail.Document.Status)</MudChip>
            <span class="artifact-meta-item"><MudIcon Icon="@Icons.Material.Outlined.HistoryEdu" Size="Size.Small" />Revision @detail.LatestRevision.Number</span>
            <span class="artifact-meta-item"><MudIcon Icon="@Icons.Material.Outlined.Verified" Size="Size.Small" />Accepted @(detail.AcceptedRevision is null ? "none" : $"revision {detail.AcceptedRevision.Number}")</span>
            @if (detail.Document.PackageId.HasValue)
            {
                <span class="artifact-meta-item"><MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" />Document package</span>
            }
            <span class="artifact-meta-item artifact-meta-owner"><MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Size="Size.Small" />Created by @detail.Document.CreatorDisplayName@(detail.Document.CreatorIsFormerEmployee ? " (former employee)" : null)</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }

        <MudTabs @bind-ActivePanelIndex="_tab" Class="artifact-workspace-tabs">
            <MudTabPanel Text="Preview" Icon="@Icons.Material.Outlined.Visibility">
                <div class="artifact-preview-shell">
                    <div class="artifact-preview-caption">
                        <span>Revision @detail.LatestRevision.Number</span>
                        <span>Updated @detail.LatestRevision.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</span>
                    </div>
                    <article class="artifact-markdown-preview"><ChatMarkdown Content="@detail.LatestRevision.Content" /></article>
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Edit" Icon="@Icons.Material.Outlined.Edit">
                <MudTextField @bind-Value="_draft" Label="Markdown" Variant="Variant.Outlined"
                              Lines="22" FullWidth="true" Immediate="true" />
                <div class="artifact-workspace-actions">
                    <MudButton Variant="Variant.Outlined" Disabled="@_busy" OnClick="SaveDraftAsync">Save draft</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="SubmitAsync">Submit for review</MudButton>
                </div>
            </MudTabPanel>
            <MudTabPanel Text="History" Icon="@Icons.Material.Outlined.History">
                <MudList T="ArtifactRevisionResponse" Dense="true">
                    @foreach (var revision in detail.Revisions)
                    {
                        <MudListItem T="ArtifactRevisionResponse" Value="revision">
                            <div class="artifact-history-row">
                                <strong>Revision @revision.Number</strong>
                                <span>@revision.Status · @revision.CreatorDisplayName · @revision.CreatedAt.ToLocalTime().ToString("g")</span>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudTabPanel>
            <MudTabPanel Text="Access" Icon="@Icons.Material.Outlined.Lock">
                <MudText Typo="Typo.subtitle2">Location</MudText>
                <div class="d-flex align-center gap-2 mb-3">
                    <MudSelect T="Guid?" @bind-Value="_moveFolderId" Label="Folder" Variant="Variant.Outlined" Dense="true">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">Unfiled</MudSelectItem>
                        @foreach (var folder in _folders) { <MudSelectItem T="Guid?" Value="folder.Id">@folder.Name</MudSelectItem> }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" Disabled="@_busy" OnClick="MoveAsync">Move</MudButton>
                </div>
                @foreach (var grant in detail.Grants.Where(x => x.RevokedAt is null))
                {
                    <div class="artifact-access-row">
                        <strong>@grant.SubjectDisplayName</strong><span>@grant.Action</span>
                        <MudIconButton Icon="@Icons.Material.Outlined.RemoveCircleOutline" Size="Size.Small"
                                       Disabled="@_busy" OnClick="@(() => RevokeAsync(grant))" aria-label="Revoke access" />
                    </div>
                }
                @foreach (var request in detail.AccessRequests.Where(x => x.Status == "Pending"))
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        @request.SubjectDisplayName requested @string.Join(", ", request.Actions): @request.Justification
                    </MudAlert>
                }
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2">Share exact document</MudText>
                <MudSelect T="string" @bind-Value="_shareSubjectKind" Label="Principal type" Variant="Variant.Outlined" Class="mt-2">
                    <MudSelectItem T="string" Value="@("OrganizationUser")">Human employee</MudSelectItem>
                    <MudSelectItem T="string" Value="@("AgentInstallation")">Agent installation</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="_shareSubjectId" Label="Employee or installation ID" Variant="Variant.Outlined" Class="mt-2" />
                <MudSelect T="string" @bind-Value="_shareAction" Label="Permission" Variant="Variant.Outlined" Class="mt-2">
                    @foreach (var action in ArtifactActions.FileActions.Order()) { <MudSelectItem T="string" Value="action">@action</MudSelectItem> }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="ShareAsync" Class="mt-2">Grant exact-file access</MudButton>
            </MudTabPanel>
        </MudTabs>

        @if (detail.Document.Status == "InReview")
        {
            <footer class="artifact-decision-bar">
                <div class="artifact-decision-copy">
                    <span>REVIEW DECISION</span>
                    <strong>Approve this revision or return it with focused feedback.</strong>
                </div>
                <div class="artifact-decision-controls">
                    <MudTextField @bind-Value="_decisionComment" Label="Decision comment" Placeholder="Optional for approval; recommended when requesting changes" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <div class="artifact-decision-buttons">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Check"
                                   Disabled="@_busy" OnClick="AcceptAsync">Accept revision</MudButton>
                        <MudButton Color="Color.Warning" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.RateReview"
                                   Disabled="@_busy" OnClick="RequestChangesAsync">Request changes</MudButton>
                    </div>
                </div>
            </footer>
        }
    }
</aside>

@code {
    [Parameter, EditorRequired] public Guid OrganizationId { get; set; }
    [Parameter, EditorRequired] public Guid ArtifactId { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    [Parameter] public EventCallback<ArtifactDocumentDetail> Changed { get; set; }

    private ElementReference _panel;
    private IJSObjectReference? _module;
    private ArtifactDocumentDetail? _detail;
    private readonly List<ArtifactFolderResponse> _folders = [];
    private string _draft = string.Empty;
    private string? _decisionComment, _error;
    private string _shareSubjectKind = "OrganizationUser", _shareSubjectId = "", _shareAction = ArtifactActions.Read;
    private Guid? _moveFolderId;
    private bool _loading = true, _busy, _notFound;
    private int _tab;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    protected override void OnInitialized() => Realtime.EventReceived += OnRealtimeEvent;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CSweet.UI/js/artifact-workspace.js");
        await _module.InvokeVoidAsync("observeWidth", _panel, "csweet.artifact-workspace.width");
    }

    private async Task LoadAsync()
    {
        _loading = true; _notFound = false; _error = null;
        try
        {
            var response = await Http.GetAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}");
            if (response.StatusCode is System.Net.HttpStatusCode.NotFound or System.Net.HttpStatusCode.Forbidden)
            { _notFound = true; _detail = null; return; }
            response.EnsureSuccessStatusCode();
            _detail = await response.Content.ReadFromJsonAsync<ArtifactDocumentDetail>();
            _draft = _detail?.LatestRevision.Content ?? string.Empty;
            _moveFolderId = _detail?.Document.FolderId;
            var folders = await Http.GetFromJsonAsync<List<ArtifactFolderResponse>>(
                $"api/organizations/{OrganizationId:D}/documents/folders?includeArchived=false");
            _folders.Clear(); if (folders is not null) _folders.AddRange(folders);
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _loading = false; }
    }

    private async Task SaveDraftAsync()
    {
        if (_detail is null || _draft == _detail.LatestRevision.Content) return;
        await MutateAsync(Http.PostAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/revisions",
            new CreateArtifactRevisionRequest(_detail.LatestRevision.Id, _draft, $"ui-revision:{Guid.NewGuid():N}")));
    }

    private async Task RequestAccessAsync()
    {
        _busy = true; _error = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/access-requests",
                new RequestArtifactAccessRequest([ArtifactActions.Read], "I need access to this linked document.", $"ui-access:{ArtifactId:N}"));
            if (!response.IsSuccessStatusCode) _error = await response.Content.ReadAsStringAsync();
            else _error = "Access request submitted for an Owner or Manager to review.";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task SubmitAsync()
    {
        if (_detail is null) return;
        if (_draft != _detail.LatestRevision.Content) await SaveDraftAsync();
        if (_detail is null) return;
        await MutateAsync(Http.PostAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/submit",
            new SubmitArtifactRevisionRequest(_detail.LatestRevision.Id, $"ui-submit:{_detail.LatestRevision.Id:D}")));
    }

    private Task AcceptAsync() => DecideAsync("accept");
    private Task RequestChangesAsync() => DecideAsync("request-revision");
    private async Task DecideAsync(string decision)
    {
        if (_detail?.Document.SubmittedRevisionId is not Guid revisionId) return;
        await MutateAsync(Http.PostAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/decisions",
            new DecideArtifactRevisionRequest(revisionId, decision, _decisionComment,
                $"ui-decision:{revisionId:D}:{decision}")));
    }

    private async Task ToggleArchiveAsync()
    {
        if (_detail is null) return;
        var action = _detail.Document.ArchivedAt.HasValue ? "restore" : "archive";
        await MutateAsync(Http.PostAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/{action}",
            new ArtifactArchiveRequest($"ui-{action}:{ArtifactId:N}:{Guid.NewGuid():N}")));
    }

    private async Task ShareAsync()
    {
        if (!Guid.TryParse(_shareSubjectId, out var subjectId)) { _error = "Enter a valid employee or installation ID."; return; }
        await MutateAsync(Http.PutAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/grants",
            new UpsertArtifactGrantRequest(_shareSubjectKind, subjectId, [_shareAction], null,
                $"ui-share:{ArtifactId:N}:{subjectId:N}:{_shareAction}")));
    }

    private async Task RevokeAsync(ArtifactGrantResponse grant)
    {
        await MutateAsync(Http.PutAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/grants",
            new UpsertArtifactGrantRequest(grant.SubjectKind, grant.SubjectId, [], null,
                $"ui-revoke:{ArtifactId:N}:{grant.SubjectId:N}:{Guid.NewGuid():N}")));
    }

    private async Task MoveAsync()
    {
        await MutateAsync(Http.PostAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/move",
            new MoveArtifactRequest(_moveFolderId, $"ui-move:{ArtifactId:N}:{Guid.NewGuid():N}")));
    }

    private async Task MutateAsync(Task<HttpResponseMessage> operation)
    {
        _busy = true; _error = null;
        try
        {
            var response = await operation;
            if (!response.IsSuccessStatusCode) { _error = await response.Content.ReadAsStringAsync(); return; }
            var detail = await response.Content.ReadFromJsonAsync<ArtifactDocumentDetail>();
            if (detail is not null) { _detail = detail; _draft = detail.LatestRevision.Content; await Changed.InvokeAsync(detail); }
            else await LoadAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private Task CloseAsync() => Closed.InvokeAsync();
    private void OnRealtimeEvent(CSweet.Contracts.Realtime.AppRealtimeEventEnvelope envelope)
    {
        if (envelope.OrganizationId == OrganizationId && envelope.EventType == CSweet.Contracts.Realtime.AppRealtimeEvents.DocumentChanged)
            _ = InvokeAsync(LoadAsync);
    }
    private static Color StatusColor(string status) => status switch
    { "Approved" => Color.Success, "InReview" => Color.Info, "ChangesRequested" => Color.Warning, "Archived" => Color.Default, _ => Color.Primary };
    private static string StatusLabel(string status) => status switch
    { "InReview" => "In review", "ChangesRequested" => "Changes requested", _ => status };
    private static string FormatDocumentType(string documentType) => documentType
        .Replace("video-game.", string.Empty, StringComparison.OrdinalIgnoreCase)
        .Replace("creative-direction.", string.Empty, StringComparison.OrdinalIgnoreCase)
        .Replace('-', ' ')
        .Replace('.', ' ');

    public async ValueTask DisposeAsync()
    {
        Realtime.EventReceived -= OnRealtimeEvent;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("stopObservingWidth", _panel); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
