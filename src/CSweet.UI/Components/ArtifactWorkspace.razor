@using CSweet.Contracts.Core
@using MudBlazor.Extensions
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject CSweet.UI.Services.AppRealtimeState Realtime
@inject IAppLocalizer L
@inject UserTime Time

<aside class="artifact-workspace" @ref="_panel" aria-label="@L["ArtifactWorkspace.AriaLabel"]" @onkeydown="OnKeyDown">
    <header class="artifact-workspace-header">
        <div class="artifact-workspace-heading">
            <span class="artifact-workspace-mark" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Outlined.Description" />
            </span>
            <div>
                <span class="artifact-workspace-eyebrow"><i></i>@L["ArtifactWorkspace.Eyebrow"]</span>
                <MudText Typo="Typo.h5">@(_detail?.Document.Title ?? L["Common.Loading"])</MudText>
                @if (_detail is { } headingDetail)
                {
                    <span class="artifact-workspace-type">@(IsRetainedEvidence ? L["ArtifactWorkspace.QaTestHistory"] : headingDetail.DocumentTypeDisplayName ?? FormatDocumentType(headingDetail.Document.DocumentType))</span>
                }
            </div>
        </div>
        <div class="artifact-workspace-header-actions">
            @if (_detail is not null && !ReviewOnly)
            {
                <MudIconButton Icon="@(_detail.Document.ArchivedAt.HasValue ? Icons.Material.Outlined.Unarchive : Icons.Material.Outlined.Archive)"
                               OnClick="ToggleArchiveAsync" Disabled="@_busy" aria-label="@L["ArtifactWorkspace.ArchiveOrRestore"]" />
            }
            <MudIconButton @ref="_closeButton" Icon="@Icons.Material.Outlined.Close" OnClick="CloseAsync" aria-label="@L["ArtifactWorkspace.CloseDocument"]" />
        </div>
    </header>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_notFound)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            @L["ArtifactWorkspace.Unavailable"]
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="RequestAccessAsync" Class="mt-3">
            @L["ArtifactWorkspace.RequestAccess"]
        </MudButton>
    }
    else if (_error is not null && _detail is null)
    { <MudAlert Severity="Severity.Error" Class="ma-3" role="alert">@_error</MudAlert> }
    else if (_detail is { } detail)
    {
        <div class="artifact-workspace-meta">
            <MudChip T="string" Size="Size.Small" Color="@StatusColor(detail.Document.Status)" Variant="Variant.Filled">@(IsRetainedEvidence && detail.Document.ArchivedAt is null ? L["ArtifactWorkspace.EvidenceSaved"] : StatusLabel(detail.Document.Status))</MudChip>
            @if (PreviewRevision is { } displayedRevision)
            { <span class="artifact-meta-item"><MudIcon Icon="@Icons.Material.Outlined.HistoryEdu" Size="Size.Small" />@L.Format("ArtifactWorkspace.Revision", new { number = displayedRevision.Number })</span> }
            @if (!IsRetainedEvidence)
            { <span class="artifact-meta-item"><MudIcon Icon="@Icons.Material.Outlined.Verified" Size="Size.Small" />@(detail.AcceptedRevision is null ? L["ArtifactWorkspace.AcceptedNone"] : L.Format("ArtifactWorkspace.AcceptedRevision", new { number = detail.AcceptedRevision.Number }))</span> }
            @if (detail.Document.PackageId.HasValue)
            {
                <span class="artifact-meta-item"><MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" />@L["ArtifactWorkspace.DocumentPackage"]</span>
            }
            <span class="artifact-meta-item artifact-meta-owner"><MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Size="Size.Small" />@L.Format(detail.Document.CreatorIsFormerEmployee ? "ArtifactWorkspace.CreatedByFormer" : "ArtifactWorkspace.CreatedBy", new { name = detail.Document.CreatorDisplayName })</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }

        @if (PreviewRevision is null)
        { <MudAlert Severity="Severity.Warning" Class="ma-3">@L["ArtifactWorkspace.RevisionUnavailable"]</MudAlert> }
        else if (detail.Document.SubmittedRevisionId.HasValue && PreviewRevision.Id != detail.Document.SubmittedRevisionId && ReviewOnly)
        { <MudAlert Severity="Severity.Info" Class="ma-3">@L["ArtifactWorkspace.HistoricalRevision"]</MudAlert> }
        else if (PreviewRevision.Id != detail.LatestRevision.Id)
        { <p class="artifact-review-caption">@L.Format("ArtifactWorkspace.ShowingRevision", new { number = PreviewRevision.Number, latest = detail.LatestRevision.Number })</p> }

        <MudTabs @bind-ActivePanelIndex="_tab" Class="artifact-workspace-tabs">
            <MudTabPanel Text="@L["ArtifactWorkspace.Tab.Preview"]" Icon="@Icons.Material.Outlined.Visibility">
                @if (PreviewRevision is { } preview)
                {
                <div class="artifact-preview-shell">
                    <div class="artifact-preview-caption">
                        <span>@L.Format("ArtifactWorkspace.PreviewCaption", new { number = preview.Number, status = IsRetainedEvidence ? L["ArtifactWorkspace.SavedEvidence"] : preview.Status })</span>
                        <span>@L.Format("ArtifactWorkspace.Updated", new { time = Time.Format(preview.CreatedAt, "MMM d, yyyy · h:mm tt") })</span>
                    </div>
                    @if (IsRetainedEvidence)
                    {
                        <article class="artifact-markdown-preview">
                            <p>@L["ArtifactWorkspace.Evidence.Intro"]</p>
                            <p>@L["ArtifactWorkspace.Evidence.Note"]</p>
                            <details><summary>@L["ArtifactWorkspace.Evidence.ViewLogs"]</summary><pre>@preview.Content</pre></details>
                        </article>
                    }
                    else
                    { <article class="artifact-markdown-preview"><ChatMarkdown Content="@preview.Content" /></article> }
                </div>
                }
            </MudTabPanel>
            @if (!ReviewOnly)
            {
            <MudTabPanel Text="@L["Common.Edit"]" Icon="@Icons.Material.Outlined.Edit">
                <MudTextField @bind-Value="_draft" Label="@L["ArtifactWorkspace.MarkdownLabel"]" Variant="Variant.Outlined"
                              Lines="22" FullWidth="true" Immediate="true" />
                <div class="artifact-workspace-actions">
                    <MudButton Variant="Variant.Outlined" Disabled="@_busy" OnClick="SaveDraftAsync">@L["ArtifactWorkspace.SaveDraft"]</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="SubmitAsync">@(IsRetainedEvidence ? L["ArtifactWorkspace.SaveEvidence"] : L["ArtifactWorkspace.SubmitForReview"])</MudButton>
                </div>
            </MudTabPanel>
            }
            <MudTabPanel Text="@L["ArtifactWorkspace.Tab.History"]" Icon="@Icons.Material.Outlined.History">
                @if (detail.Revisions.Count == 0)
                { <MudText Color="Color.Secondary" Class="pa-4">@L["ArtifactWorkspace.NoRevisions"]</MudText> }
                <MudList T="ArtifactRevisionResponse" Dense="true">
                    @foreach (var revision in detail.Revisions)
                    {
                        <MudListItem T="ArtifactRevisionResponse" Value="revision">
                            <div class="artifact-history-row">
                                <strong>@L.Format("ArtifactWorkspace.Revision", new { number = revision.Number })</strong>
                                <span>@L.Format("ArtifactWorkspace.HistoryMeta", new { status = revision.Status, creator = revision.CreatorDisplayName, time = Time.Format(revision.CreatedAt, "g") })</span>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudTabPanel>
            @if (!ReviewOnly)
            {
            <MudTabPanel Text="@L["ArtifactWorkspace.Tab.Access"]" Icon="@Icons.Material.Outlined.Lock">
                <MudText Typo="Typo.subtitle2">@L["ArtifactWorkspace.Location"]</MudText>
                <div class="d-flex align-center gap-2 mb-3">
                    <MudSelect T="Guid?" @bind-Value="_moveFolderId" Label="@L["ArtifactWorkspace.Folder"]" Variant="Variant.Outlined" Dense="true">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">@L["ArtifactWorkspace.Unfiled"]</MudSelectItem>
                        @foreach (var folder in _folders) { <MudSelectItem T="Guid?" Value="folder.Id">@folder.Name</MudSelectItem> }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" Disabled="@_busy" OnClick="MoveAsync">@L["ArtifactWorkspace.Move"]</MudButton>
                </div>
                @foreach (var grant in detail.Grants.Where(x => x.RevokedAt is null))
                {
                    <div class="artifact-access-row">
                        <strong>@grant.SubjectDisplayName</strong><span>@PermissionLabel(grant.Action)</span>
                        <MudIconButton Icon="@Icons.Material.Outlined.RemoveCircleOutline" Size="Size.Small"
                                       Disabled="@_busy" OnClick="@(() => RevokeAsync(grant))" aria-label="@L["ArtifactWorkspace.RevokeAccess"]" />
                    </div>
                }
                @foreach (var request in detail.AccessRequests.Where(x => x.Status == "Pending"))
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        @L.Format("ArtifactWorkspace.AccessRequested", new { subject = request.SubjectDisplayName, actions = string.Join(", ", request.Actions), justification = request.Justification })
                    </MudAlert>
                }
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2">@L["ArtifactWorkspace.ShareTitle"]</MudText>
                <MudSelect T="string" @bind-Value="_shareSubjectKind" Label="@L["ArtifactWorkspace.ShareWith"]" Variant="Variant.Outlined" Class="mt-2">
                    <MudSelectItem T="string" Value="@("OrganizationUser")">@L["ArtifactWorkspace.HumanEmployee"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("AgentInstallation")">@L["ArtifactWorkspace.AgentInstallation"]</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="_shareSubjectId" Label="@L["ArtifactWorkspace.SubjectIdLabel"]" Variant="Variant.Outlined" Class="mt-2" />
                <MudSelect T="string" @bind-Value="_shareAction" Label="@L["ArtifactWorkspace.PermissionLabel"]" Variant="Variant.Outlined" Class="mt-2">
                    @foreach (var action in ArtifactActions.FileActions.Order()) { <MudSelectItem T="string" Value="action">@PermissionLabel(action)</MudSelectItem> }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="ShareAsync" Class="mt-2">@L["ArtifactWorkspace.GrantAccess"]</MudButton>
            </MudTabPanel>
            }
        </MudTabs>

        @if (CanReviewDisplayedRevision)
        {
            <footer class="artifact-decision-bar">
                <div class="artifact-decision-copy">
                    <span>@L["ArtifactWorkspace.ReviewDecision"]</span>
                    <strong>@L.Format("ArtifactWorkspace.DecisionFor", new { number = PreviewRevision!.Number })</strong>
                    <p>@L["ArtifactWorkspace.DecisionHelp"]</p>
                </div>
                <div class="artifact-decision-controls">
                    <MudTextField @bind-Value="_decisionComment" Label="@L["ArtifactWorkspace.DecisionComment"]" Placeholder="@L["ArtifactWorkspace.DecisionCommentPlaceholder"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Disabled="_busy" />
                    <div class="artifact-decision-buttons">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Check"
                                   Disabled="@_busy" OnClick="AcceptAsync">@L.Format("ArtifactWorkspace.ApproveRevision", new { number = PreviewRevision!.Number })</MudButton>
                        <MudButton Color="Color.Warning" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.RateReview"
                                   Disabled="@_busy" OnClick="RequestChangesAsync">@L["ArtifactWorkspace.RequestChanges"]</MudButton>
                    </div>
                </div>
            </footer>
        }
    }
</aside>

@code {
    private string PermissionLabel(string action) => action switch
    {
        ArtifactActions.Read => L["ArtifactWorkspace.Permission.View"], ArtifactActions.Revise => L["ArtifactWorkspace.Permission.Edit"],
        ArtifactActions.Submit => L["ArtifactWorkspace.SubmitForReview"], ArtifactActions.Decide => L["ArtifactWorkspace.Permission.Decide"], _ => action
    };
    [Parameter, EditorRequired] public Guid OrganizationId { get; set; }
    [Parameter, EditorRequired] public Guid ArtifactId { get; set; }
    [Parameter] public Guid? RevisionId { get; set; }
    [Parameter] public bool ReviewOnly { get; set; }
    [Parameter] public bool CanDecide { get; set; } = true;
    [Parameter] public EventCallback Closed { get; set; }
    [Parameter] public EventCallback<ArtifactDocumentDetail> Changed { get; set; }

    private ElementReference _panel;
    private MudIconButton? _closeButton;
    private IJSObjectReference? _module;
    private ArtifactDocumentDetail? _detail;
    private readonly List<ArtifactFolderResponse> _folders = [];
    private string _draft = string.Empty;
    private string? _decisionComment, _error;
    private string _shareSubjectKind = "OrganizationUser", _shareSubjectId = "", _shareAction = ArtifactActions.Read;
    private Guid? _moveFolderId;
    private bool _loading = true, _busy, _notFound;
    private int _tab;
    private bool _disposed;
    private long _loadVersion;
    private (Guid Organization, Guid Artifact, Guid? Revision)? _binding;
    private bool IsRetainedEvidence => ArtifactDocumentTypes.IsRetainedEvidence(_detail?.Document.DocumentType ?? "");
    private ArtifactRevisionResponse? PreviewRevision
    {
        get
        {
            if (_detail is null) return null;
            var selected = RevisionId ?? _detail.Document.SubmittedRevisionId;
            return selected.HasValue ? _detail.Revisions.FirstOrDefault(x => x.Id == selected)
                : _detail.LatestRevision;
        }
    }
    private bool CanReviewDisplayedRevision => CanDecide && !IsRetainedEvidence && _detail?.Document.Status == "InReview" &&
        PreviewRevision is { Status: "Submitted" } revision && _detail.Document.SubmittedRevisionId == revision.Id;

    protected override async Task OnParametersSetAsync()
    {
        var binding = (OrganizationId, ArtifactId, RevisionId);
        if (_binding == binding) return;
        _binding = binding;
        _detail = null; _error = null; _decisionComment = null; _tab = 0;
        await LoadAsync();
    }

    protected override void OnInitialized()
    {
        Realtime.EventReceived += OnRealtimeEvent;
        Realtime.Reconnected += OnReconnect;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CSweet.UI/js/artifact-workspace.js");
        await _module.InvokeVoidAsync("observeWidth", _panel, "csweet.artifact-workspace.width");
        await _module.InvokeVoidAsync("rememberFocus", _panel);
        if (_closeButton is not null) await _closeButton.FocusAsync();
    }

    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        var organization = OrganizationId;
        var artifact = ArtifactId;
        _loading = true; _notFound = false; _error = null;
        try
        {
            using var response = await Http.GetAsync($"api/organizations/{organization:D}/documents/{artifact:D}");
            if (_disposed || version != _loadVersion) return;
            if (response.StatusCode is System.Net.HttpStatusCode.NotFound or System.Net.HttpStatusCode.Forbidden)
            { _notFound = true; _detail = null; return; }
            response.EnsureSuccessStatusCode();
            var detail = await response.Content.ReadFromJsonAsync<ArtifactDocumentDetail>();
            if (_disposed || version != _loadVersion) return;
            _detail = detail;
            _draft = _detail?.LatestRevision.Content ?? string.Empty;
            _moveFolderId = _detail?.Document.FolderId;
            if (!ReviewOnly)
            {
                var folders = await Http.GetFromJsonAsync<List<ArtifactFolderResponse>>(
                    $"api/organizations/{organization:D}/documents/folders?includeArchived=false");
                if (_disposed || version != _loadVersion) return;
                _folders.Clear(); if (folders is not null) _folders.AddRange(folders);
            }
        }
        catch (Exception) { if (version == _loadVersion) { _detail = null; _error = L["ArtifactWorkspace.Error.LoadFailed"]; } }
        finally { if (version == _loadVersion) _loading = false; }
    }

    private async Task SaveDraftAsync()
    {
        if (_detail is null || _draft == _detail.LatestRevision.Content) return;
        await MutateAsync(Http.PostAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/revisions",
            new CreateArtifactRevisionRequest(_detail.LatestRevision.Id, _draft, $"ui-revision:{Guid.NewGuid():N}")));
    }

    private async Task RequestAccessAsync()
    {
        _busy = true; _error = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/access-requests",
                new RequestArtifactAccessRequest([ArtifactActions.Read], L["ArtifactWorkspace.AccessRequestJustification"], $"ui-access:{ArtifactId:N}"));
            if (!response.IsSuccessStatusCode) _error = await response.Content.ReadAsStringAsync();
            else _error = L["ArtifactWorkspace.AccessRequestSubmitted"];
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task SubmitAsync()
    {
        if (_detail is null) return;
        if (_draft != _detail.LatestRevision.Content) await SaveDraftAsync();
        if (_detail is null) return;
        await MutateAsync(Http.PostAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/submit",
            new SubmitArtifactRevisionRequest(_detail.LatestRevision.Id, $"ui-submit:{_detail.LatestRevision.Id:D}")));
    }

    private Task AcceptAsync() => DecideAsync("accept");
    private Task RequestChangesAsync() => DecideAsync("request-revision");
    private async Task DecideAsync(string decision)
    {
        if (_busy || !CanReviewDisplayedRevision || PreviewRevision is not { } revision) return;
        if (decision == "request-revision" && string.IsNullOrWhiteSpace(_decisionComment))
        { _error = L["ArtifactWorkspace.Error.FeedbackRequired"]; return; }
        var revisionId = revision.Id;
        var organization = OrganizationId;
        var artifact = ArtifactId;
        _busy = true;
        try
        {
            await LoadAsync();
            if (_disposed || organization != OrganizationId || artifact != ArtifactId) return;
            if (!CanReviewDisplayedRevision || PreviewRevision?.Id != revisionId)
            {
                _error = L["ArtifactWorkspace.Error.NoLongerAwaiting"];
                if (_detail is not null) await Changed.InvokeAsync(_detail);
                return;
            }
            await MutateAsync(Http.PostAsJsonAsync($"api/organizations/{organization:D}/documents/{artifact:D}/decisions",
                new DecideArtifactRevisionRequest(revisionId, decision, _decisionComment?.Trim(),
                    $"ui-decision:{revisionId:D}:{decision}")), reviewDecision: true);
        }
        finally { _busy = false; }
    }

    private async Task ToggleArchiveAsync()
    {
        if (_detail is null) return;
        var action = _detail.Document.ArchivedAt.HasValue ? "restore" : "archive";
        await MutateAsync(Http.PostAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/{action}",
            new ArtifactArchiveRequest($"ui-{action}:{ArtifactId:N}:{Guid.NewGuid():N}")));
    }

    private async Task ShareAsync()
    {
        if (!Guid.TryParse(_shareSubjectId, out var subjectId)) { _error = L["ArtifactWorkspace.Error.InvalidSubjectId"]; return; }
        await MutateAsync(Http.PutAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/grants",
            new UpsertArtifactGrantRequest(_shareSubjectKind, subjectId, [_shareAction], null,
                $"ui-share:{ArtifactId:N}:{subjectId:N}:{_shareAction}")));
    }

    private async Task RevokeAsync(ArtifactGrantResponse grant)
    {
        await MutateAsync(Http.PutAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/grants",
            new UpsertArtifactGrantRequest(grant.SubjectKind, grant.SubjectId, [], null,
                $"ui-revoke:{ArtifactId:N}:{grant.SubjectId:N}:{Guid.NewGuid():N}")));
    }

    private async Task MoveAsync()
    {
        await MutateAsync(Http.PostAsJsonAsync($"api/organizations/{OrganizationId:D}/documents/{ArtifactId:D}/move",
            new MoveArtifactRequest(_moveFolderId, $"ui-move:{ArtifactId:N}:{Guid.NewGuid():N}")));
    }

    private async Task MutateAsync(Task<HttpResponseMessage> operation, bool reviewDecision = false)
    {
        _busy = true; _error = null;
        try
        {
            using var response = await operation;
            if (!response.IsSuccessStatusCode)
            {
                _error = reviewDecision ? response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Forbidden => L["ArtifactWorkspace.Error.DecisionForbidden"],
                    System.Net.HttpStatusCode.NotFound => L["ArtifactWorkspace.Error.DecisionNotFound"],
                    System.Net.HttpStatusCode.Conflict => L["ArtifactWorkspace.Error.DecisionConflict"],
                    _ => L["ArtifactWorkspace.Error.DecisionFailed"]
                } : await response.Content.ReadAsStringAsync();
                return;
            }
            var detail = await response.Content.ReadFromJsonAsync<ArtifactDocumentDetail>();
            if (detail is not null) { _detail = detail; _draft = detail.LatestRevision.Content; await Changed.InvokeAsync(detail); }
            else await LoadAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task CloseAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("restoreFocus", _panel);
        await Closed.InvokeAsync();
    }
    private Task OnKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
    private void OnRealtimeEvent(CSweet.Contracts.Realtime.AppRealtimeEventEnvelope envelope)
    {
        if (envelope.OrganizationId == OrganizationId && envelope.EventType == CSweet.Contracts.Realtime.AppRealtimeEvents.DocumentChanged)
            OnReconnect();
    }
    private void OnReconnect()
    {
        if (!_disposed) _ = InvokeAsync(async () => { await LoadAsync(); if (!_disposed) StateHasChanged(); });
    }
    private static Color StatusColor(string status) => status switch
    { "Approved" => Color.Success, "InReview" => Color.Info, "ChangesRequested" => Color.Warning, "Archived" => Color.Default, _ => Color.Primary };
    private string StatusLabel(string status) => L.Has("ArtifactWorkspace.Status." + status) ? L["ArtifactWorkspace.Status." + status] : status;
    private static string FormatDocumentType(string documentType) => documentType
        .Replace('-', ' ')
        .Replace('.', ' ');

    public async ValueTask DisposeAsync()
    {
        _disposed = true; ++_loadVersion;
        Realtime.EventReceived -= OnRealtimeEvent;
        Realtime.Reconnected -= OnReconnect;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("stopObservingWidth", _panel); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
