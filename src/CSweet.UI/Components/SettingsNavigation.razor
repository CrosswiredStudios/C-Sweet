<nav class="settings-navigation" aria-label="Settings sections">
    <MudNavMenu Bordered="false" Dense="true" Class="settings-nav-menu">
        <MudNavLink Href="/settings" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Overview</MudNavLink>
        @foreach (var group in SettingsSections.All.GroupBy(section => section.Group))
        {
            <MudText Typo="Typo.overline" Class="settings-nav-label">@group.Key</MudText>
            @foreach (var section in group)
            {
                <MudNavLink Href="@section.Url" Match="@(section.Url == "/settings/agents" ? NavLinkMatch.All : NavLinkMatch.Prefix)" Icon="@section.Icon">@section.Title</MudNavLink>
            }
        }
    </MudNavMenu>
</nav>
