@using CSweet.Contracts.Core
@implements IDisposable
@inject AgentHireOperationState HireOperations
@inject NavigationManager Navigation

@if (HireOperations.Operations.Count > 0)
{
    <aside class="agent-hire-tray" aria-live="polite" aria-label="Agent hiring progress">
        @foreach (var operation in HireOperations.Operations)
        {
            <MudPaper Class="@ToastClass(operation)" Elevation="0">
                <div class="agent-hire-toast-icon" aria-hidden="true">
                    <MudIcon Icon="@StatusIcon(operation.Status)" />
                </div>
                <div class="agent-hire-toast-content">
                    <header class="agent-hire-toast-header">
                        <div>
                            <span class="agent-hire-toast-eyebrow">@StatusLabel(operation.Status)</span>
                            <strong>@operation.Phase</strong>
                            <small>@operation.EmployeeDisplayName</small>
                        </div>
                        @if (CanDismiss(operation.Status))
                        {
                            <MudIconButton Class="agent-hire-toast-dismiss"
                                           Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           aria-label="Dismiss hiring notification"
                                           OnClick="@(() => DismissAsync(operation))" />
                        }
                    </header>
                    <p class="agent-hire-toast-detail">@operation.Detail</p>
                    @if (AgentHireOperationStatuses.IsActive(operation.Status))
                    {
                        <div class="agent-hire-toast-progress-label">
                            <span>@ProgressLabel(operation)</span>
                            @if (operation.TotalBuildSteps > 0)
                            {
                                <strong>@($"{Progress(operation):0}%")</strong>
                            }
                        </div>
                        <MudProgressLinear Class="agent-hire-toast-progress"
                                           Color="Color.Primary"
                                           Rounded="true"
                                           Indeterminate="@(operation.TotalBuildSteps == 0)"
                                           Value="@Progress(operation)" />
                    }
                    <div class="agent-hire-toast-actions">
                        @if (operation.Status == AgentHireOperationStatuses.Succeeded)
                        {
                            <MudButton Class="agent-hire-primary-action" Size="Size.Small" Variant="Variant.Filled"
                                       EndIcon="@Icons.Material.Outlined.ArrowForward"
                                       OnClick="@(() => Open(operation))">View team</MudButton>
                        }
                        else if (operation.Status == AgentHireOperationStatuses.NeedsSetup)
                        {
                            <MudButton Class="agent-hire-primary-action" Size="Size.Small" Variant="Variant.Filled"
                                       EndIcon="@Icons.Material.Outlined.ArrowForward"
                                       OnClick="@(() => Open(operation))">Finish setup</MudButton>
                        }
                        else if (operation.Status == AgentHireOperationStatuses.Failed)
                        {
                            <MudButton Class="agent-hire-primary-action" Size="Size.Small" Variant="Variant.Filled"
                                       OnClick="@(() => RetryAsync(operation))">Retry</MudButton>
                            @if (!string.IsNullOrWhiteSpace(operation.ActionUri))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Open(operation))">View details</MudButton>
                            }
                        }
                        else if (operation.Status == AgentHireOperationStatuses.AwaitingConfirmation)
                        {
                            <MudButton Class="agent-hire-primary-action" Size="Size.Small" Variant="Variant.Filled"
                                       OnClick="@(() => RetryAsync(operation))">Resume hire</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                       OnClick="@(() => CancelAsync(operation))">Cancel</MudButton>
                        }
                    </div>
                </div>
            </MudPaper>
        }
    </aside>
}

@code {
    protected override void OnInitialized() => HireOperations.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    private Task RetryAsync(AgentHireOperationResponse operation) => HireOperations.RetryAsync(operation);
    private Task DismissAsync(AgentHireOperationResponse operation) => HireOperations.DismissAsync(operation);
    private Task CancelAsync(AgentHireOperationResponse operation) => HireOperations.CancelInterruptedAsync(operation);
    private void Open(AgentHireOperationResponse operation)
    {
        if (!string.IsNullOrWhiteSpace(operation.ActionUri)) Navigation.NavigateTo(operation.ActionUri);
    }

    private static double Progress(AgentHireOperationResponse operation) =>
        operation.TotalBuildSteps == 0 ? 0 : 100d * operation.CompletedBuildSteps / operation.TotalBuildSteps;

    private static string ProgressLabel(AgentHireOperationResponse operation) =>
        operation.TotalBuildSteps > 0
            ? $"{operation.CompletedBuildSteps} of {operation.TotalBuildSteps} build steps complete"
            : "Preparing the build environment";

    private static string ToastClass(AgentHireOperationResponse operation) =>
        $"agent-hire-toast agent-hire-toast-{operation.Status.ToLowerInvariant()}";

    private static bool CanDismiss(string status) =>
        status is AgentHireOperationStatuses.Succeeded or AgentHireOperationStatuses.NeedsSetup or AgentHireOperationStatuses.Failed;

    private static string StatusLabel(string status) => status switch
    {
        AgentHireOperationStatuses.Succeeded => "AGENT HIRED",
        AgentHireOperationStatuses.Failed => "HIRING INTERRUPTED",
        AgentHireOperationStatuses.NeedsSetup => "SETUP REQUIRED",
        AgentHireOperationStatuses.AwaitingConfirmation => "ACTION REQUIRED",
        _ => "AGENT HIRING"
    };

    private static string StatusIcon(string status) => status switch
    {
        AgentHireOperationStatuses.Succeeded => Icons.Material.Filled.CheckCircle,
        AgentHireOperationStatuses.Failed => Icons.Material.Filled.Error,
        AgentHireOperationStatuses.NeedsSetup => Icons.Material.Filled.Settings,
        AgentHireOperationStatuses.AwaitingConfirmation => Icons.Material.Filled.Restore,
        _ => Icons.Material.Filled.PersonAdd
    };

    public void Dispose() => HireOperations.Changed -= OnChanged;
}
