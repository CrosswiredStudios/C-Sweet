@inject IAppLocalizer L
<nav class="agent-settings-navigation" aria-label="@L["AgentSettingsNavigation.AriaLabel"]">
    <MudButton Href="/settings/agents" Variant="@(Runtime ? Variant.Text : Variant.Filled)" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Inventory2">
        @L["AgentSettingsNavigation.InstalledAgents"]
    </MudButton>
    <MudButton Href="/settings/agents/runtime" Variant="@(Runtime ? Variant.Filled : Variant.Text)" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Memory">
        @L["AgentSettingsNavigation.Runtime"]
    </MudButton>
</nav>

@code {
    [Parameter] public bool Runtime { get; set; }
}
