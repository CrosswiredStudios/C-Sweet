@using CSweet.Contracts.Core
@using CSweet.Contracts.SourceControl
@inject HttpClient Http
@inject NavigationManager Navigation

<section class="repository-workspace" aria-label="Repositories">
    <MudStack Spacing="3">
        @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
        @if (CanManage && Creating)
        {
            <div class="repository-create">
                <div class="repository-create-heading">
                    <div><MudText Typo="Typo.h6">New private repository</MudText><MudText Typo="Typo.body2" Class="repository-muted">C-Sweet storage · No account setup required</MudText></div>
                    <MudIconButton Icon="@Icons.Material.Outlined.Close" OnClick="CloseCreateAsync" Disabled="_busy" aria-label="Close new repository form" />
                </div>
                <div class="repository-create-fields">
                    <MudTextField @bind-Value="_name" Label="Repository name" Placeholder="e.g. orbit-game" Variant="Variant.Outlined" Immediate="true" Disabled="_busy" />
                    <MudTextField @bind-Value="_branch" Label="Initial branch" Variant="Variant.Outlined" Disabled="_busy" />
                </div>
                <div class="repository-create-actions">
                    <MudButton OnClick="CreateAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_branch))" Variant="Variant.Filled" Color="Color.Primary">Create repository</MudButton>
                    <MudButton OnClick="CloseCreateAsync" Disabled="_busy">Cancel</MudButton>
                </div>
            </div>
        }
        @if (_busy) { <MudProgressLinear Indeterminate="true" aria-label="Loading repositories" /> }
        @if (!_busy && _error is null && AllRepositories.Count == 0)
        {
            @if (!Creating || !CanManage)
            {
                <div class="repository-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Large" />
                    <MudText Typo="Typo.h5">A home for your team’s code</MudText>
                    <MudText Class="repository-muted">@(CanManage ? "Create a private repository in C-Sweet. GitHub is optional and can be connected later." : "No repositories yet. A business owner or manager can create one for your team.")</MudText>
                    @if (CanManage)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => CreatingChanged.InvokeAsync(true)">Create your first repository</MudButton>
                    }
                    <MudText Typo="Typo.caption" Class="repository-muted">Private · Built-in storage</MudText>
                </div>
            }
        }
        else if (AllRepositories.Count > 0 && SelectedRepository is null)
        {
            <RepositoryDirectory OrganizationId="OrganizationId" Repositories="AllRepositories" Connections="Connections" />
        }
        @if (_externalRepository is { } external)
        {
            <MudPaper Outlined="true" Class="pa-4">
                <div class="repository-create-heading"><MudText Typo="Typo.h6">@external.Name</MudText><MudButton OnClick="CloseRepository">Close</MudButton></div>
                <MudText>@external.CanonicalPath</MudText>
                <MudText Typo="Typo.body2">@ProviderLabel(external) · @external.DefaultBranch · @RepositoryStatusLabel(external.Status)</MudText>
                @if (!string.IsNullOrWhiteSpace(external.HealthMessage)) { <MudAlert Severity="Severity.Warning" Class="mt-3">@external.HealthMessage</MudAlert> }
                @if (Connections.Any(c => c.Id == external.ConnectionId && c.Provider == "GitHub"))
                {
                    <MudButton Href="@GitHubUrl(external)" Target="_blank" Rel="noopener noreferrer" EndIcon="@Icons.Material.Outlined.OpenInNew" Class="mt-3">Open in GitHub</MudButton>
                }
            </MudPaper>
        }
        @if (SelectedRepository is { } selectedId && _repositories.Any(r => r.Id == selectedId))
        {
            <InternalRepositoryDetail OrganizationId="OrganizationId" RepositoryId="selectedId" CanManage="CanManage" SelectedReference="@SelectedReference" SelectedFile="@SelectedFile" />
        }
        @if (_details is not null)
        {
            <MudDivider />
            <div class="repository-detail-header">
                <div class="repository-title">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountTree" />
                    <div><MudText Typo="Typo.h5">@_details.Repository.Name</MudText><MudText Typo="Typo.caption" Class="repository-muted">@_details.Repository.CanonicalPath · @(_details.Repository.IsPrivate ? "Private" : "Public")</MudText></div>
                </div>
                <MudButton OnClick="CloseRepository" Disabled="_busy" StartIcon="@Icons.Material.Outlined.ArrowBack">All repositories</MudButton>
            </div>
            @if (_details.Inspection.Refs.Count == 0)
            {
                <div class="repository-empty repository-empty-compact">
                    <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" />
                    <MudText Typo="Typo.h6">This repository is empty</MudText>
                    <MudText Class="repository-muted">Push a commit to @_details.Repository.DefaultBranch to start browsing files.</MudText>
                </div>
            }
            else
            {
                <div class="code-toolbar">
                    <MudSelect T="string" Value="@CurrentReference" ValueChanged="ChangeReferenceAsync" Variant="Variant.Outlined" Dense="true" Class="branch-select" aria-label="Branch or tag">
                        @foreach (var reference in _details.Inspection.Refs)
                        {
                            <MudSelectItem T="string" Value="@reference.Name">@ShortReference(reference.Name)</MudSelectItem>
                        }
                    </MudSelect>
                    <span class="code-toolbar-summary">@_details.Inspection.Commits.Count recent @(_details.Inspection.Commits.Count == 1 ? "commit" : "commits")</span>
                </div>
                <div class="code-browser">
                    @if (_details.Inspection.Commits.FirstOrDefault() is { } latest)
                    {
                        <div class="code-commit-bar"><MudIcon Icon="@Icons.Material.Outlined.Commit" /><strong>@latest.Author</strong><span class="code-commit-subject">@latest.Subject</span><code>@latest.Sha[..8]</code></div>
                    }
                    @if (!string.IsNullOrEmpty(_browserPath))
                    {
                        <button type="button" class="code-row code-row-button" @onclick="NavigateUp"><MudIcon Icon="@Icons.Material.Outlined.FolderOpen" /><span class="code-entry-name">..</span><span></span></button>
                    }
                    @foreach (var entry in BrowserEntries)
                    {
                        <button type="button" class="code-row code-row-button" @onclick="() => OpenEntryAsync(entry)">
                            <MudIcon Icon="@(entry.IsDirectory ? Icons.Material.Outlined.Folder : Icons.Material.Outlined.InsertDriveFile)" />
                            <span class="code-entry-name">@entry.Name</span><span class="code-entry-kind">@(entry.IsDirectory ? "Directory" : "File")</span>
                        </button>
                    }
                </div>
                @if (_details.Inspection.Content is not null)
                {
                    <div class="file-preview"><div class="file-preview-header"><strong>@_selectedFile</strong><MudButton Size="Size.Small" OnClick="CloseFile">Close file</MudButton></div><pre><code>@_details.Inspection.Content</code></pre></div>
                }
            }
            @if (CanManage)
            {
                <MudTextField @bind-Value="_editName" Label="Name" Disabled="_busy" />
                <MudTextField @bind-Value="_editBranch" Label="Default branch" Disabled="_busy" />
                <MudCheckBox @bind-Value="_archived" Label="Archived (blocks new work; keeps history)" Disabled="_busy" />
                <MudButton OnClick="SaveAsync" Disabled="_busy" Variant="Variant.Outlined">Save repository</MudButton>
                @if (_details.Repository.Status == "Archived")
                {
                    <MudAlert Severity="Severity.Warning">Deletion permanently removes Git history. Repositories with team assignments or work history must remain archived.</MudAlert>
                    <MudTextField @bind-Value="_deleteName" Label="Type the repository name to confirm deletion" />
                    <MudButton OnClick="DeleteAsync" Color="Color.Error" Disabled="@(_busy || _deleteName != _details.Repository.Name)">Delete repository permanently</MudButton>
                }
                else if (_details.Repository.Status == "Ready")
                {
                    <MudSelect T="Guid" @bind-Value="_team" Label="Assign to team">
                        @foreach (var team in _teams) { <MudSelectItem T="Guid" Value="team.Id">@team.Name</MudSelectItem> }
                    </MudSelect>
                    <MudCheckBox @bind-Value="_primary" Label="Use as the team's primary repository" />
                    <MudSelect T="string" @bind-Value="_mergePolicy" Label="Merge approval">
                        <MudSelectItem T="string" Value="@("LeadAuthorizedAutoMerge")">QA and team lead</MudSelectItem>
                        <MudSelectItem T="string" Value="@("LeadAndAdministratorApproval")">QA, team lead and administrator</MudSelectItem>
                    </MudSelect>
                    <MudButton OnClick="AssignTeamAsync" Disabled="@(_busy || _team == Guid.Empty)">Save team access</MudButton>
                }
            }
            <InternalGitClientAccess @key="_details.Repository.Id" OrganizationId="OrganizationId" RepositoryId="_details.Repository.Id" CanManage="CanManage" />
            <InternalGitLocks OrganizationId="OrganizationId" RepositoryId="_details.Repository.Id" CanManage="@(CanManage && _details.Repository.Status == "Ready")" />
            <MudText Typo="Typo.subtitle1">Team access</MudText>
            @foreach (var access in _teamAccess)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText>@access.TeamName · @(access.Disabled ? "revoked" : access.IsPrimary ? "primary" : "available") · @(access.MergeApprovalMode == "LeadAndAdministratorApproval" ? "QA, lead and administrator" : "QA and lead")</MudText>
                    @if (CanManage)
                    {
                        <MudButton Disabled="_busy" OnClick="@(() => EditTeam(access))">Edit access</MudButton>
                        @if (!access.Disabled) { <MudButton Disabled="_busy" Color="Color.Error" OnClick="@(() => RevokeTeamAsync(access))">Revoke access</MudButton> }
                    }
                </MudStack>
            }
            <MudText Typo="Typo.subtitle1">Proposed changes</MudText>
            @foreach (var proposal in _proposals)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText>@proposal.Branch to @proposal.TargetBranch · @proposal.CommitSha[..8] · @proposal.Status · QA: @(proposal.QaPassed ? "passed" : "pending")</MudText>
                    <MudButton OnClick="@(() => InspectProposalAsync(proposal.Id))" Disabled="_busy">Review diff</MudButton>
                </MudStack>
            }
            @if (_proposalDiff is not null) { <pre style="white-space:pre-wrap;max-height:32rem;overflow:auto">@_proposalDiff</pre> }
            <MudText Typo="Typo.subtitle1">Branches and tags</MudText>
            @if (CanManage && _details.Repository.Status == "Ready")
            {
                <MudTextField @bind-Value="_newRef" Label="New ref (refs/heads/name or refs/tags/name)" Disabled="_busy" />
                <MudTextField @bind-Value="_refTarget" Label="Target commit SHA" Disabled="_busy" />
                <MudButton OnClick="CreateRefAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_newRef) || string.IsNullOrWhiteSpace(_refTarget))">Create branch or tag</MudButton>
            }
            @foreach (var reference in _details.Inspection.Refs)
            {
                <MudButton OnClick="@(() => InspectAsync(_details.Repository.Id, reference.Name))" Disabled="_busy">@reference.Name · @reference.Sha[..8]</MudButton>
                @if (CanManage && _details.Repository.Status == "Ready" && reference.Name != "refs/heads/" + _details.Repository.DefaultBranch)
                {
                    <MudButton Color="Color.Error" OnClick="@(() => _deleteRef = reference)" Disabled="_busy">Delete ref</MudButton>
                }
            }
            @if (_deleteRef is not null)
            {
                <MudAlert Severity="Severity.Warning">Delete @_deleteRef.Name at @_deleteRef.Sha[..8]?</MudAlert>
                <MudButton Color="Color.Error" OnClick="DeleteRefAsync" Disabled="_busy">Confirm ref deletion</MudButton>
                <MudButton OnClick="@(() => _deleteRef = null)">Cancel</MudButton>
            }
            <MudText Typo="Typo.subtitle1">Recent commits</MudText>
            @foreach (var commit in _details.Inspection.Commits) { <MudText Typo="Typo.body2">@commit.Sha[..8] · @commit.Subject · @commit.Author</MudText> }

        }
    </MudStack>
</section>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public bool CanManage { get; set; }
    [Parameter] public bool Creating { get; set; }
    [Parameter] public EventCallback<bool> CreatingChanged { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public IReadOnlyList<SourceControlRepositorySummary> Repositories { get; set; } = [];
    [Parameter] public IReadOnlyList<SourceControlConnectionSummary> Connections { get; set; } = [];
    private SourceControlRepositorySummary? _externalRepository;
    private Guid _loadedOrganization;
    private Guid? _loadedSelection;
    private string? _loadedReference;
    private string? _loadedFile;
    private IReadOnlyList<SourceControlRepositorySummary> AllRepositories => _repositories
        .Concat(Repositories.Where(r => !Connections.Any(c => c.Id == r.ConnectionId && c.Provider == "InternalGit")))
        .DistinctBy(r => r.Id).OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase).ToList();
    private bool IsInternal(SourceControlRepositorySummary repository) => _repositories.Any(r => r.Id == repository.Id);
    private string ProviderLabel(SourceControlRepositorySummary repository) => IsInternal(repository) ? "C-Sweet storage"
        : Connections.FirstOrDefault(c => c.Id == repository.ConnectionId)?.Provider ?? "Connected Git";
    private static string GitHubUrl(SourceControlRepositorySummary repository) => "https://github.com/" + string.Join("/", repository.CanonicalPath.Split('/').Select(Uri.EscapeDataString));
    private static string RepositoryStatusLabel(string status) => status switch
    {
        "AttentionRequired" => "Needs attention",
        "Pending" or "Provisioning" => "Setup in progress",
        "Connected" => "Ready",
        _ => status
    };
    private static Color RepositoryStatusColor(string status) => status switch
    {
        "Ready" or "Connected" => Color.Success,
        "AttentionRequired" => Color.Warning,
        "Disconnected" => Color.Error,
        _ => Color.Default
    };
    private Task CloseCreateAsync() => CreatingChanged.InvokeAsync(false);
    private void OpenRepositoryAsync(SourceControlRepositorySummary repository)
        => Navigation.NavigateTo($"/organizations/{OrganizationId:D}/source-control/{repository.Id:D}");
    private void CloseRepository() => Navigation.NavigateTo($"/organizations/{OrganizationId:D}/source-control");
    [Parameter] public Guid? SelectedRepository { get; set; }
    [Parameter] public string? SelectedReference { get; set; }
    [Parameter] public string? SelectedFile { get; set; }
    private IReadOnlyList<SourceControlRepositorySummary> _repositories = [];
    private IReadOnlyList<TeamSummaryResponse> _teams = [];
    private IReadOnlyList<InternalGitTeamAccess> _teamAccess = [];
    private IReadOnlyList<InternalGitProposalSummary> _proposals = [];
    private InternalRepositoryDetails? _details;
    private string _name = "", _branch = "main", _editName = "", _editBranch = "main";
    private string? _error, _selectedRef, _selectedFile, _proposalDiff;
    private string _browserPath = "";
    private string _deleteName = "", _newRef = "", _refTarget = "", _mergePolicy = "LeadAuthorizedAutoMerge";
    private Guid _team;
    private bool _primary = true;
    private InternalGitRef? _deleteRef;
    private bool _busy, _archived;
    private string Endpoint => $"api/organizations/{OrganizationId:D}/source-control/internal/repositories";
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedOrganization != OrganizationId)
        {
            _loadedOrganization = OrganizationId;
            _repositories = []; _teams = []; _details = null; _externalRepository = null;
            _loadedSelection = null; _loadedReference = null; _loadedFile = null;
            await RunAsync(async () =>
            {
                await LoadAsync();
                if (CanManage)
                {
                    var teams = await Http.GetFromJsonAsync<TeamDirectoryResponse>($"api/core/organizations/{OrganizationId:D}/teams?includeArchived=false");
                    _teams = teams?.Teams.Where(t => !t.IsArchived).ToList() ?? [];
                }
            });
        }
        if (SelectedRepository is { } id && (_loadedSelection != id || _loadedReference != SelectedReference || _loadedFile != SelectedFile))
        {
            _loadedSelection = id; _loadedReference = SelectedReference; _loadedFile = SelectedFile;
            if (_repositories.Any(r => r.Id == id))
            {
                _externalRepository = null;
                _details = null;
            }
            else
            {
                _details = null;
                _externalRepository = AllRepositories.FirstOrDefault(r => r.Id == id);
            }
        }
    }
    private async Task LoadAsync() => _repositories = await Http.GetFromJsonAsync<List<SourceControlRepositorySummary>>(Endpoint) ?? [];
    private async Task CreateAsync() => await RunAsync(async () =>
    {
        using var response = await Http.PostAsJsonAsync(Endpoint, new CreateInternalRepositoryRequest(_name, _branch));
        await CheckAsync(response); _name = ""; await LoadAsync();
        await CreatingChanged.InvokeAsync(false); await OnChanged.InvokeAsync();
    });
    private async Task InspectAsync(Guid id, string? reference = null, string? file = null) => await RunAsync(async () =>
    {
        _details = await Http.GetFromJsonAsync<InternalRepositoryDetails>(InspectionUrl(id, reference, file));
        if (_details is null) return;
        _teamAccess = await Http.GetFromJsonAsync<List<InternalGitTeamAccess>>($"{Endpoint}/{id:D}/team") ?? [];
        _team = Guid.Empty;
        _proposals = await Http.GetFromJsonAsync<List<InternalGitProposalSummary>>($"{Endpoint}/{id:D}/proposals") ?? [];
        _proposalDiff = null; _deleteName = ""; _deleteRef = null; _selectedRef = reference; _selectedFile = file;
        _browserPath = file is null ? "" : ParentPath(file);
        _editName = _details.Repository.Name; _editBranch = _details.Repository.DefaultBranch; _archived = _details.Repository.Status == "Archived";
    });
    private async Task SaveAsync() => await RunAsync(async () =>
    {
        if (_details is null) return;
        using var response = await Http.PutAsJsonAsync($"{Endpoint}/{_details.Repository.Id:D}", new UpdateInternalRepositoryRequest(_editName, _editBranch, _archived, _details.Revision));
        await CheckAsync(response); await InspectAsync(_details.Repository.Id, _selectedRef);
    });
    private async Task DeleteAsync() => await RunAsync(async () =>
    {
        if (_details is null) return;
        using var response = await Http.PostAsJsonAsync($"{Endpoint}/{_details.Repository.Id:D}/delete", new DeleteInternalRepositoryRequest(_deleteName, _details.Revision));
        await CheckAsync(response); _details = null; _deleteName = ""; await LoadAsync();
        Navigation.NavigateTo($"/organizations/{OrganizationId:D}/source-control");
    });
    private Task CreateRefAsync() => ChangeRefAsync(new("create", _newRef, new string('0', 40), _refTarget));
    private Task DeleteRefAsync() => _deleteRef is null ? Task.CompletedTask : ChangeRefAsync(new("delete", _deleteRef.Name, _deleteRef.Sha));
    private async Task ChangeRefAsync(InternalGitRefRequest request) => await RunAsync(async () =>
    {
        if (_details is null) return;
        using var response = await Http.PostAsJsonAsync($"{Endpoint}/{_details.Repository.Id:D}/refs", request);
        await CheckAsync(response);
        _details = _details with { Inspection = (await response.Content.ReadFromJsonAsync<InternalGitRepositoryInspection>())! };
        _deleteRef = null; _newRef = ""; _refTarget = "";
    });
    private async Task AssignTeamAsync() => await RunAsync(async () =>
    {
        if (_details is null) return;
        using var response = await Http.PutAsJsonAsync($"{Endpoint}/{_details.Repository.Id:D}/team", new SetInternalRepositoryTeamRequest(_team, _primary, _mergePolicy, _teamAccess.SingleOrDefault(a => a.TeamId == _team)?.Revision ?? 0));
        await CheckAsync(response);
        _teamAccess = await Http.GetFromJsonAsync<List<InternalGitTeamAccess>>($"{Endpoint}/{_details.Repository.Id:D}/team") ?? [];
    });
    private void EditTeam(InternalGitTeamAccess access) { _team = access.TeamId; _primary = access.IsPrimary; _mergePolicy = access.MergeApprovalMode; }
    private async Task RevokeTeamAsync(InternalGitTeamAccess access) => await RunAsync(async () =>
    {
        if (_details is null) return;
        using var response = await Http.PutAsJsonAsync($"{Endpoint}/{_details.Repository.Id:D}/team", new SetInternalRepositoryTeamRequest(access.TeamId, false, access.MergeApprovalMode, access.Revision, true));
        await CheckAsync(response);
        _teamAccess = await Http.GetFromJsonAsync<List<InternalGitTeamAccess>>($"{Endpoint}/{_details.Repository.Id:D}/team") ?? [];
    });
    private async Task InspectProposalAsync(Guid proposalId) => await RunAsync(async () =>
    {
        if (_details is null) return;
        var diff = await Http.GetFromJsonAsync<InternalGitRepositoryInspection>($"{Endpoint}/{_details.Repository.Id:D}/proposals/{proposalId:D}");
        _proposalDiff = diff?.Content;
    });
    private string CurrentReference => _selectedRef ?? $"refs/heads/{_details?.Repository.DefaultBranch}";
    private IReadOnlyList<BrowserEntry> BrowserEntries
    {
        get
        {
            if (_details is null) return [];
            var prefix = string.IsNullOrEmpty(_browserPath) ? "" : _browserPath + "/";
            return _details.Inspection.Files.Where(path => path.StartsWith(prefix, StringComparison.Ordinal))
                .Select(path => path[prefix.Length..]).Where(path => path.Length > 0).Select(path => path.Split('/', 2))
                .GroupBy(parts => parts[0], StringComparer.Ordinal)
                .Select(group => new BrowserEntry(group.Key, group.Any(parts => parts.Length > 1)))
                .OrderByDescending(entry => entry.IsDirectory).ThenBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase).ToList();
        }
    }
    private async Task OpenEntryAsync(BrowserEntry entry)
    {
        if (_details is null) return;
        var path = string.IsNullOrEmpty(_browserPath) ? entry.Name : $"{_browserPath}/{entry.Name}";
        if (entry.IsDirectory) { _browserPath = path; _selectedFile = null; return; }
        await InspectAsync(_details.Repository.Id, _selectedRef, path);
        Navigation.NavigateTo(RepositoryUrl(_details.Repository.Id, _selectedRef, path), replace: true);
    }
    private void NavigateUp() => _browserPath = ParentPath(_browserPath);
    private void CloseFile()
    {
        if (_details is null) return;
        _details = _details with { Inspection = _details.Inspection with { Content = null } };
        _selectedFile = null;
        Navigation.NavigateTo(RepositoryUrl(_details.Repository.Id, _selectedRef), replace: true);
    }
    private Task ChangeReferenceAsync(string reference)
    {
        if (_details is not null) Navigation.NavigateTo(RepositoryUrl(_details.Repository.Id, reference));
        return Task.CompletedTask;
    }
    private string InspectionUrl(Guid id, string? reference, string? file)
    {
        var url = $"{Endpoint}/{id:D}";
        return Navigation.GetUriWithQueryParameters(url, new Dictionary<string, object?> { ["reference"] = reference, ["file"] = file });
    }    private string RepositoryUrl(Guid id, string? reference, string? file = null)
    {
        var url = $"/organizations/{OrganizationId:D}/source-control/{id:D}";
        return Navigation.GetUriWithQueryParameters(url, new Dictionary<string, object?> { ["reference"] = reference, ["file"] = file });
    }
    private static string ShortReference(string reference) => reference.StartsWith("refs/heads/", StringComparison.Ordinal) ? reference[11..]
        : reference.StartsWith("refs/tags/", StringComparison.Ordinal) ? reference[10..] : reference;
    private static string ParentPath(string path) { var separator = path.LastIndexOf('/'); return separator < 0 ? "" : path[..separator]; }
    private sealed record BrowserEntry(string Name, bool IsDirectory);
    private async Task RunAsync(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; }
    }
    private static async Task CheckAsync(HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode)
        {
            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            throw new InvalidOperationException(body.TryGetProperty("message", out var message) ? message.GetString() : "Repository operation failed.");
        }
    }
}
