@using CSweet.Contracts.Communications
@inject IAppLocalizer L

<div class="decision-response">
    @if (Decision.Options.Any(IsListedOption))
    {
        <div class="decision-choices" role="radiogroup" aria-label="@L["AgentQuestionCard.YourResponse"]">
            @foreach (var option in Decision.Options.Where(IsListedOption))
            {
                <div @key="option.Id" class="choice">
                    @if (option.Recommended) { <small class="recommended">@L["AgentQuestionCard.Recommended"]</small> }
                    <label>
                        <input type="radio" name="@_group" value="@option.Id" checked="@(Selected == option.Id)" disabled="@Disabled"
                               @onchange="() => SelectedChanged.InvokeAsync(option.Id)" />
                        <span class="choice-copy"><strong>@option.Label</strong>
                            @if (!string.IsNullOrWhiteSpace(option.Description)) { <span class="choice-summary">@option.Description</span> }
                        </span>
                    </label>
                    <DecisionExplanation OrganizationId="OrganizationId" ConversationId="ConversationId" DecisionId="Decision.Id" Option="option" />
                </div>
            }
        </div>
    }
    @DirectionInput
    <div class="decision-actions">
        @if (Decision.AllowFreeText && Decision.Options.Count > 0)
        {
            <div class="custom-direction">
                <button type="button" disabled="@Disabled" aria-pressed="@(Selected == Other ? "true" : "false")"
                        @onclick="() => SelectedChanged.InvokeAsync(Other)">@L["Communications.Decision.CustomAnswer"]</button>
                <DecisionExplanation OrganizationId="OrganizationId" ConversationId="ConversationId" DecisionId="Decision.Id" Option="CustomOption" />
            </div>
        }
        <div class="decision-submit">
            <DecisionExplanation OrganizationId="OrganizationId" ConversationId="ConversationId" DecisionId="Decision.Id" />
            @ConfirmButton
        </div>
    </div>
</div>

@code {
    public const string Other = "__other__";
    private readonly string _group = $"choices-{Guid.NewGuid():N}";
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid ConversationId { get; set; }
    [Parameter, EditorRequired] public ExecutiveDecisionCardResponse Decision { get; set; } = default!;
    [Parameter] public string? Selected { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }
    [Parameter] public RenderFragment? DirectionInput { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ConfirmButton { get; set; }
    private bool IsListedOption(ExecutiveDecisionOptionResponse option) => !Decision.AllowFreeText || option.Id != "provide-direction";
    private ExecutiveDecisionOptionResponse CustomOption => new(Other, L["Communications.Decision.CustomAnswer"], null, false) { Impact = L["Communications.Decision.CustomImpact"] };
}
