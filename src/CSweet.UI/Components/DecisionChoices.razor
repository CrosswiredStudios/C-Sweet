@using CSweet.Contracts.Communications
@implements IDisposable
@inject HttpClient Http
@inject IAppLocalizer L

<div class="decision-response">
    @if (Decision.Options.Count > 0)
    {
        <div class="decision-layout">
            <label class="decision-picker">
                <span>@L["Communications.Decision.YourChoice"]</span>
                <span class="select-field">
                    <select @bind:get="@(Selected ?? "")" @bind:set="SelectAsync" disabled="@Disabled">
                        <option value="" disabled hidden>@L["Communications.Decision.ChooseAnswer"]</option>
                        @foreach (var option in Decision.Options.Where(IsListedOption))
                        {
                            <option @key="option.Id" value="@option.Id">@(option.Recommended && option.Id != Selected ? $"{option.Label} ({L["AgentQuestionCard.Recommended"]})" : option.Label)</option>
                        }
                        @if (Decision.AllowFreeText) { <option value="@Other">@L["Communications.Decision.CustomAnswer"]</option> }
                    </select>
                    <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" aria-hidden="true" />
                </span>
            </label>
            @if (Selected == Other && Decision.AllowFreeText)
            {
                <section class="option-detail" aria-label="@L["Communications.Decision.CustomAnswer"]">
                    <p>@L["Communications.Decision.CustomImpact"]</p>
                    @DirectionInput
                </section>
            }
            else if (SelectedOption is { } choice)
            {
                var copy = _wording.GetValueOrDefault(choice);
                var description = copy?.Text ?? choice.Description;
                var impact = copy?.Impact ?? choice.Impact;
                <section class="option-detail" aria-label="@choice.Label">
                    <div class="detail-heading">
                        <MudIcon Icon="@Icons.Material.Outlined.Lightbulb" Size="Size.Small" aria-hidden="true" />
                        <strong>@choice.Label</strong>
                        @if (choice.Recommended) { <small>@L["AgentQuestionCard.Recommended"]</small> }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(description) && description != impact)
                    {
                        <p>@description</p>
                    }
                    <div class="choice-impact" aria-live="polite">
                        <h4>@L["Communications.Decision.WhatThisMeans"]</h4>
                        @if (!string.IsNullOrWhiteSpace(impact)) { <p>@impact</p> }
                        else if (_wording.ContainsKey(choice) && !_loading.Contains(choice))
                        {
                            <p>@L["Communications.Decision.ExplanationFailed"]</p>
                            <MudButton Size="Size.Small" OnClick="@(() => LoadWordingAsync(choice))">@L["Common.Retry"]</MudButton>
                        }
                        else { <p>@L["Communications.Decision.Asking"]</p> }
                    </div>
                    @if (copy is not null && ((!string.IsNullOrWhiteSpace(choice.Description) && choice.Description != description) ||
                        (!string.IsNullOrWhiteSpace(choice.Impact) && choice.Impact != impact)))
                    {
                        <details class="decision-original"><summary>@L["Communications.Decision.OriginalWording"]</summary>
                            @if (!string.IsNullOrWhiteSpace(choice.Description)) { <p>@choice.Description</p> }
                            @if (!string.IsNullOrWhiteSpace(choice.Impact) && choice.Impact != choice.Description) { <p>@choice.Impact</p> }
                        </details>
                    }
                </section>
            }
        </div>
    }
    else { @DirectionInput }
    <div class="decision-submit">
        <DecisionExplanation OrganizationId="OrganizationId" ConversationId="ConversationId" DecisionId="Decision.Id" Option="SelectedOption" />
        @ConfirmButton
    </div>
</div>

@code {
    public const string Other = "__other__";
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid ConversationId { get; set; }
    [Parameter, EditorRequired] public ExecutiveDecisionCardResponse Decision { get; set; } = default!;
    [Parameter] public string? Selected { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }
    [Parameter] public RenderFragment? DirectionInput { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ConfirmButton { get; set; }

    private readonly Dictionary<ExecutiveDecisionOptionResponse, DecisionWordingResponse?> _wording = [];
    private readonly HashSet<ExecutiveDecisionOptionResponse> _loading = [];
    private readonly CancellationTokenSource _lifetime = new();
    private ExecutiveDecisionOptionResponse? SelectedOption => Decision.Options.FirstOrDefault(o => o.Id == Selected && IsListedOption(o));
    private bool IsListedOption(ExecutiveDecisionOptionResponse option) => !Decision.AllowFreeText || option.Id != "provide-direction";
    private Task SelectAsync(string value) => SelectedChanged.InvokeAsync(value);

    protected override Task OnParametersSetAsync()
    {
        if (SelectedOption is { } choice && !_wording.ContainsKey(choice))
            return LoadWordingAsync(choice);
        return Task.CompletedTask;
    }

    private async Task LoadWordingAsync(ExecutiveDecisionOptionResponse choice)
    {
        if (!_loading.Add(choice)) return;
        _wording[choice] = null;
        try
        {
            _wording[choice] = await DecisionExplanationResult.GetWordingAsync(Http, OrganizationId, ConversationId, Decision.Id, choice.Id, _lifetime.Token);
        }
        finally { _loading.Remove(choice); }
    }

    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
