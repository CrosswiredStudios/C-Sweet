@using CSweet.Contracts.Agents
@inject IAppLocalizer L
@inject UserTime Time

<section class="agent-build-progress-content" aria-label="@L["AgentBuildProgressContent.AriaLabel"]" aria-live="polite">
    <MudText Typo="Typo.subtitle2" Class="agent-build-progress-title">@(ProgressTitle ?? BuildTitle)</MudText>
    @if (string.Equals(Build?.SourceMode, "PrebuiltRelease", StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(Build?.ReleaseTag))
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary">@(string.IsNullOrWhiteSpace(Build?.ReleaseAssetName) ? L.Format("AgentBuildProgressContent.PrebuiltRelease", new { tag = Build.ReleaseTag }) : L.Format("AgentBuildProgressContent.PrebuiltReleaseWithAsset", new { tag = Build.ReleaseTag, asset = Build.ReleaseAssetName }))</MudText>
    }
    @if (!string.IsNullOrWhiteSpace(ProgressDetail))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@ProgressDetail</MudText>
    }
    @if (Build is null)
    {
        @if (IsPrebuilt)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["AgentBuildProgressContent.InstallingPrebuilt"]</MudText>
            <ol class="installed-agent-build-steps">
                <li>@L["AgentBuildProgressContent.Step.Download"]</li>
                <li>@L["AgentBuildProgressContent.Step.Verify"]</li>
                <li>@L["AgentBuildProgressContent.Step.Install"]</li>
            </ol>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["AgentBuildProgressContent.StepsPending"]</MudText>
        }
    }
    else
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary">@L.Format("AgentBuildProgressContent.AttemptQueued", new { attempt = Build.Attempt, time = Time.Format(Build.QueuedAt, "g") })</MudText>
        @if (Build.Steps is { Count: > 0 })
        {
            <ol class="installed-agent-build-steps">
                @foreach (var step in Build.Steps)
                {
                    <li class="agent-build-progress-step">
                        <div class="agent-build-progress-marker" aria-hidden="true">
                            @if (step.Status == "InProgress")
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                            }
                            else
                            {
                                <MudIcon Icon="@StepIcon(step.Status)" Color="@StepColor(step.Status)" Size="Size.Small" />
                            }
                        </div>
                        <div class="agent-build-progress-step-content">
                            <div class="agent-build-progress-step-heading">
                                <MudText Typo="Typo.subtitle2" Class="agent-build-progress-title">@step.Label</MudText>
                                <span class="agent-step-status agent-step-status-@step.Status.ToLowerInvariant()">@StepStatus(step.Status)</span>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@step.Detail</MudText>
                            @if (!string.IsNullOrWhiteSpace(step.Error))
                            {
                                <pre class="agent-build-step-error">@step.Error</pre>
                            }
                        </div>
                    </li>
                }
            </ol>
        }
        @if (!string.IsNullOrWhiteSpace(Build.FailureMessage))
        {
            <MudText Typo="Typo.body2" Color="Color.Error">@Build.FailureMessage</MudText>
        }
    }
</section>

@code {
    private bool IsPrebuilt => string.Equals(Build?.SourceMode ?? SourceMode, "PrebuiltRelease", StringComparison.Ordinal);
    private string BuildTitle => (IsPrebuilt, Build?.Status) switch
    {
        (true, "Queued") => L["AgentBuildProgressContent.Title.PrebuiltQueued"],
        (true, "Cloning") => L["AgentBuildProgressContent.Title.PrebuiltCloning"],
        (true, "Building") => L["AgentBuildProgressContent.Title.PrebuiltBuilding"],
        (true, "Succeeded") => string.IsNullOrWhiteSpace(Build?.ReleaseTag) ? L["AgentBuildProgressContent.Title.ReleaseInstalled"] : L.Format("AgentBuildProgressContent.Title.ReleaseTagInstalled", new { tag = Build.ReleaseTag }),
        (true, "Failed") => L["AgentBuildProgressContent.Title.PrebuiltFailed"],
        (true, "Cancelled") => L["AgentBuildProgressContent.Title.PrebuiltCancelled"],
        (true, null) => L["AgentBuildProgressContent.Title.PrebuiltPreparing"],
        (_, "Queued") => L["AgentBuildProgressContent.Title.Queued"],
        (_, "Cloning") => L["AgentBuildProgressContent.Title.Cloning"],
        (_, "Building") => L["AgentBuildProgressContent.Title.Building"],
        (_, "Succeeded") => L["AgentBuildProgressContent.Title.Succeeded"],
        (_, "Failed") => L["AgentBuildProgressContent.Title.Failed"],
        (_, "Cancelled") => L["AgentBuildProgressContent.Title.Cancelled"],
        _ => L["AgentBuildProgressContent.Title.Information"]
    };
    private string StepStatus(string status) =>
        L.Has("AgentBuildProgressContent.StepStatus." + status) ? L["AgentBuildProgressContent.StepStatus." + status] : status;
    private static string StepIcon(string status) => status switch
    {
        "Succeeded" => Icons.Material.Filled.CheckCircle,
        "Failed" => Icons.Material.Filled.Error,
        "Cancelled" => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Outlined.RadioButtonUnchecked
    };
    private static Color StepColor(string status) => status switch
    {
        "Succeeded" => Color.Success, "Failed" => Color.Error, "Cancelled" => Color.Warning, _ => Color.Default
    };
    [Parameter] public AgentBuildSummaryResponse? Build { get; set; }
    [Parameter] public string? SourceMode { get; set; }
    [Parameter] public string? ProgressTitle { get; set; }
    [Parameter] public string? ProgressDetail { get; set; }
}
