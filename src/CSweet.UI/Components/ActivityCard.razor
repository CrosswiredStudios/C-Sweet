@using CSweet.Contracts.Core
@inject IAppLocalizer L

<article class="activity-card" data-activity-kind="@Item.ActivityKind">
    <header class="activity-card-header @(Item.Collaborator is not null ? "collaborating" : "")">
        <div class="activity-card-agents @(Item.Collaborator is not null ? "collaborating" : "")">
            <ActivityAgent OrganizationId="OrganizationId" EmployeeId="Item.EmployeeId" Name="@Item.EmployeeName" Role="@Item.EmployeeRole" IsActive="@(State == "Executing")" />
            @if (Item.Collaborator is { } other)
            {
                <span class="activity-card-connector" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.CompareArrows" Size="Size.Small" /></span>
                <ActivityAgent OrganizationId="OrganizationId" EmployeeId="other.EmployeeId" Name="@other.EmployeeName" Role="@other.Role" Status="@(State == "Executing" ? $"Awaiting {Item.EmployeeName}" : "Collaborator")" />
            }
        </div>
        <div class="activity-card-controls" role="group" aria-label="@AgentStatus">
            <span class="activity-card-status @StateClass">@FriendlyState <span aria-hidden="true">·</span> <time title="@Item.StartedAt.ToLocalTime().ToString("g")">@Age</time></span>
        </div>
    </header>
    <div class="activity-card-title"><MudIcon Icon="@HeadingIcon" Size="Size.Small" /><strong>
        @if (HasLinkedTicket)
        {
            <a class="activity-title-link" href="@CurrentActivityNavigation.WorkItemHref(OrganizationId, Item)" title="@Item.Title"><span class="activity-title-text">@Item.Title</span><MudIcon Icon="@Icons.Material.Outlined.NorthEast" Size="Size.Small" /></a>
        }
        else { <span class="activity-title-text" title="@Heading">@Heading</span> }
    </strong></div>
    @if (Item.ProjectId.HasValue || HasLinkedTicket)
    {
        <div class="activity-card-metadata">
            @if (Item.ProjectId is Guid projectId)
            {
                <a class="activity-project-link" href="@($"/organizations/{OrganizationId}/projects/{projectId}")" title="@Item.Context">@Item.Context</a>
            }
            else { <span class="activity-card-context" title="@Item.Context">@Item.Context</span> }
            @if (HasLinkedTicket && Item.Identifier is not null)
            {
                <span aria-hidden="true">·</span><span class="activity-card-identifier" title="@Item.Identifier">@Item.Identifier</span>
            }
        </div>
    }
    @if (HasLinkedTicket)
    {
        @if (Item.ActivityKind == "Collaboration" && !string.IsNullOrWhiteSpace(Item.CollaborationName) && Item.CollaborationName != Item.Title)
        {
            <div class="activity-card-context activity-card-scope" title="@Item.CollaborationName">Collaboration: @Item.CollaborationName</div>
        }
    }
    else if (Item.ProjectId.HasValue && Item.Title != Item.ActivityLabel)
    {
        <div class="activity-card-context activity-card-scope" title="@Item.Title">@Item.Title</div>
    }
    <div class="activity-card-summary">
        @if (State is "Waiting" or "Needs attention")
        {
            <div class="activity-card-reason"><span>@(State == "Needs attention" ? "What needs attention" : Item.Compute is not null ? "Compute / workflow status" : "What's needed")</span><p>@Action</p></div>
        }
        else
        {
            <div class="activity-card-now"><MudIcon Icon="@(State == "Executing" ? Icons.Material.Outlined.PlayCircleOutline : Icons.Material.Outlined.Schedule)" Size="Size.Small" /><span class="activity-card-action">@(VisibleGeneration is not null ? L["ActivityCard.Speed.Action"] : Action)</span>
                @if (VisibleGeneration is { } generation)
                {
                    <span class="activity-generation-speed" role="img" aria-label="@SpeedLabel(generation)" title="@L[generation.IsEstimated ? "ActivityCard.Speed.EstimatedTooltip" : "ActivityCard.Speed.ReportedTooltip"]">
                        <MudIcon Icon="@Icons.Material.Outlined.Speed" Size="Size.Small" />
                        @L.Format(generation.IsEstimated ? "ActivityCard.Speed.Estimated" : "ActivityCard.Speed.Reported", new { rate = generation.TokensPerSecond.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) })
                    </span>
                }
            </div>
        }
    </div>
    @if (Item.CanInspect && Item.Compute is { } compute)
    {
        <div class="activity-card-context activity-compute-progress" aria-label="Compute progress">
            <div>@compute.Phase · @compute.Status</div>
            <div>@compute.RecentCompletedOperations recent compute operations completed · not a QA verdict</div>
            <div>Assigned commit <code>@compute.SourceCommitSha[..8]</code></div>
            <div>Last confirmed update: <time datetime="@compute.ObservedAt.ToString("O")">@compute.ObservedAt.ToLocalTime().ToString("g")</time></div>
            @if (compute.ResumeAt is { } resume)
            {
                <div>Automatic resume eligible from <time datetime="@resume.ToString("O")">@resume.ToLocalTime().ToString("T")</time></div>
            }
        </div>
    }
    @if (Item.CanInspect && Item.PreviousSteps.Any(x => x.Kind == "Workspace"))
    {
        <ul class="activity-workspace-progress" aria-label="@L["ActivityCard.WorkspaceAriaLabel"]">
            @foreach (var step in Item.PreviousSteps.Where(x => x.Kind == "Workspace"))
            {
                <li><time datetime="@step.OccurredAt.ToString("O")">@step.OccurredAt.ToLocalTime().ToString("HH:mm:ss")</time> @step.Text</li>
            }
        </ul>
    }
    @if (Item.Compute is null || Item.AttemptId.HasValue || Item.ModelRunId.HasValue)
    {
    <button type="button" class="activity-stream-toggle" data-current-activity-open="@Item.Key" aria-expanded="@(IsSelected ? "true" : "false")" @onclick="() => Inspect.InvokeAsync(Item)">
        <MudIcon Icon="@(IsSelected ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)" Size="Size.Small" />
        @(IsSelected ? "Close provider stream" : "Peek at provider stream")
    </button>
    }
    @if (IsSelected)
    {
        @ChildContent
    }
</article>

@code {
    [Parameter, EditorRequired] public CurrentActivityItem Item { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public string State { get; set; } = "";
    [Parameter] public string Action { get; set; } = "";
    [Parameter] public string Age { get; set; } = "";
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public bool IsConnected { get; set; } = true;
    [Parameter] public EventCallback<CurrentActivityItem> Inspect { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private CurrentActivityGeneration? VisibleGeneration => IsConnected && Item.CanInspect && State == "Executing" && Item.Compute is null &&
        Item.Generation is { TokensPerSecond: > 0 } generation && double.IsFinite(generation.TokensPerSecond) &&
        generation.ObservedAt <= DateTimeOffset.UtcNow && DateTimeOffset.UtcNow - generation.ObservedAt < TimeSpan.FromSeconds(15) ? generation : null;
    private string SpeedLabel(CurrentActivityGeneration generation) => L.Format(
        generation.IsEstimated ? "ActivityCard.Speed.EstimatedLabel" : "ActivityCard.Speed.ReportedLabel",
        new { rate = generation.TokensPerSecond.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) });
    private bool HasLinkedTicket => Item.WorkItemId.HasValue && Item.BoardId.HasValue;
    private bool IsQueued => State == "Waiting" && (Action.StartsWith("Queued", StringComparison.Ordinal) || Action == "Waiting for an agent claim");
    private string FriendlyState => State == "Executing" ? "Working" : IsQueued ? "Queued" : State;
    private string StateClass => State == "Executing" ? "working" : State is "Needs attention" or "Recovering" or "Unconfirmed" ? "attention" : "waiting";
    private string AgentStatus => State == "Executing" ? Item.ActivityKind switch
    {
        "Collaboration" or "Chat" or "Discussion" => "Responding now",
        "Review" => "Reviewing now",
        "Testing" => "Testing now",
        _ => "Working now"
    } : FriendlyState;
    private string Heading => Item.ActivityLabel ?? (Item.ActivityKind switch
    {
        "Collaboration" => $"Collaboration: {(!string.IsNullOrWhiteSpace(Item.CollaborationName) ? Item.CollaborationName : Item.Title == "Collaborating" ? "Agent coordination" : Item.Title)}",
        "Review" => State == "Executing" ? "Reviewing work" : IsQueued ? "Review queued" : "Review waiting",
        "Chat" => "Responding in Communications",
        "Model" => "Generating a response",
        _ => State == "Waiting" ? IsQueued ? "Work queued" : Action.Contains("decision", StringComparison.OrdinalIgnoreCase) ? "Awaiting a decision" :
            Action.Contains("approval", StringComparison.OrdinalIgnoreCase) ? "Awaiting approval" : Action.Contains("model capacity", StringComparison.OrdinalIgnoreCase) ? "Waiting for capacity" : "Waiting on dependencies" :
            State == "Needs attention" ? "Needs attention" : Item.WorkItemId.HasValue ? "Working on a task" : "Background activity"
    });
    private string HeadingIcon => Item.ActivityKind switch
    {
        "Collaboration" => Icons.Material.Outlined.Forum,
        "Review" => Icons.Material.Outlined.FactCheck,
        "Testing" => Icons.Material.Outlined.Science,
        "Build" => Icons.Material.Outlined.Build,
        "Discussion" => Icons.Material.Outlined.Forum,
        "Chat" => Icons.Material.Outlined.ChatBubbleOutline,
        _ => State is "Waiting" or "Needs attention" ? Icons.Material.Outlined.PauseCircleOutline : Icons.Material.Outlined.TaskAlt
    };
}
