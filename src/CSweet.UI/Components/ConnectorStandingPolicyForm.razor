@using CSweet.Contracts.Plugins
@using CSweet.Contracts.GenAi
@inject IAppLocalizer L
@inject UserTime Time

@if (Setup.Review is { CanUseStandingPolicy: true } review && _editor is not null)
{
    <MudPaper Outlined="true" Class="pa-4 my-3">
        <MudText Typo="Typo.h6">@review.OperationDescription</MudText>
        <MudText>@L.Format("ConnectorStandingPolicyForm.Account", new { name = review.AccountName })</MudText>
        <MudText>@L.Format("ConnectorStandingPolicyForm.Agent", new { name = review.RequesterName })</MudText>
        <MudAlert Severity="Severity.Warning" Class="my-3">
            @L["ConnectorStandingPolicyForm.Warning"]
        </MudAlert>
        @if (_pending is null)
        {
            @foreach (var field in _editor.Fields)
            {
                <MudPaper Outlined="true" Class="pa-3 my-3">
                    <MudText Typo="Typo.subtitle1">@field.Review.Label</MudText>
                    @if (field.Review.Description is { } description) { <MudText Typo="Typo.body2">@description</MudText> }
                    <MudText Style="white-space: pre-wrap; overflow-wrap: anywhere">@L.Format("ConnectorStandingPolicyForm.ReviewedValue", new { value = ConnectorStandingPolicyEditor.Label(L, field.Review.CurrentValue) })</MudText>
                    <MudSelect T="string" Label="@L["ConnectorStandingPolicyForm.Rule"]" @bind-Value="field.Mode" Disabled="Busy" Class="mt-2">
                        @if (field.HasExisting) { <MudSelectItem T="string" Value="@("Saved")">@L["ConnectorStandingPolicyForm.Rule.Saved"]</MudSelectItem> }
                        <MudSelectItem T="string" Value="@("Reviewed")">@L["ConnectorStandingPolicyForm.Rule.Reviewed"]</MudSelectItem>
                        @if (field.Review.SuggestedValues.Count > 0) { <MudSelectItem T="string" Value="@("Choices")">@L["ConnectorStandingPolicyForm.Rule.Choices"]</MudSelectItem> }
                        <MudSelectItem T="string" Value="@("Any")">@L["ConnectorStandingPolicyForm.Rule.Any"]</MudSelectItem>
                    </MudSelect>
                    @if (field.Mode == "Saved") { <MudText Style="white-space: pre-wrap">@L.Format("ConnectorStandingPolicyForm.Permitted", new { values = field.ExistingDescription(L) is { Length: > 0 } existingDescription ? existingDescription : L["ConnectorStandingPolicyEditor.NotSet"] })</MudText> }
                    @if (field.Mode == "Choices")
                    {
                        <MudSelect T="string" Label="@L["ConnectorStandingPolicyForm.PermittedValues"]" MultiSelection="true" @bind-SelectedValues="field.SelectedValues" Disabled="Busy">
                            @foreach (var choice in field.Review.SuggestedValues)
                            { <MudSelectItem T="string" Value="@choice.GetRawText()">@ConnectorStandingPolicyEditor.Label(L, choice)</MudSelectItem> }
                        </MudSelect>
                    }
                    @if (field.Review.CanOmit || field.AllowOmission)
                    { <MudCheckBox T="bool" @bind-Value="field.AllowOmission" Disabled="Busy" Label="@L["ConnectorStandingPolicyForm.MayBeUnset"]" /> }
                </MudPaper>
            }
            <MudSelect T="string" Label="@L["ConnectorStandingPolicyForm.TimeZone"]" @bind-Value="_editor.TimeZoneId" Disabled="Busy" Class="my-3">
                @foreach (var zone in TimeZoneInfo.GetSystemTimeZones())
                { <MudSelectItem T="string" Value="@zone.Id">@zone.DisplayName</MudSelectItem> }
            </MudSelect>
            <MudSelect T="int" Label="@L["ConnectorStandingPolicyForm.AllowedDays"]" MultiSelection="true" @bind-SelectedValues="_editor.Days" Disabled="Busy">
                @foreach (var day in Enumerable.Range(0, 7))
                { <MudSelectItem T="int" Value="day">@DayName(day)</MudSelectItem> }
            </MudSelect>
            <MudCheckBox T="bool" @bind-Value="_editor.AllDay" Disabled="Busy" Label="@L["ConnectorStandingPolicyForm.AllowWholeDay"]" />
            @if (!_editor.AllDay)
            {
                <MudTimePicker Label="@L["ConnectorStandingPolicyForm.From"]" @bind-Time="_editor.StartTime" Disabled="Busy" />
                <MudCheckBox T="bool" @bind-Value="_editor.EndAtMidnight" Disabled="Busy" Label="@L["ConnectorStandingPolicyForm.EndAtMidnight"]" />
                @if (!_editor.EndAtMidnight) { <MudTimePicker Label="@L["ConnectorStandingPolicyForm.Until"]" @bind-Time="_editor.EndTime" Disabled="Busy" /> }
                <MudText Typo="Typo.caption">@L["ConnectorStandingPolicyForm.WindowHint"]</MudText>
            }
            <MudDatePicker Label="@L["ConnectorStandingPolicyForm.ExpiresOn"]" @bind-Date="_editor.ExpiryDate" Disabled="Busy" Class="mt-3" />
            <MudTimePicker Label="@L["ConnectorStandingPolicyForm.ExpiryTime"]" @bind-Time="_editor.ExpiryTime" Disabled="Busy" />
            <MudNumericField T="int" Label="@L["ConnectorStandingPolicyForm.MaxPerHour"]" @bind-Value="_editor.MaximumActionsPerHour"
                             Min="1" Max="1000" Disabled="Busy" Class="mt-3" />
            <MudTextField T="string" Label="@L["ConnectorStandingPolicyForm.EscalationTerms"]"
                          @bind-Value="_editor.EscalationTerms" Lines="3" Disabled="Busy" Class="mt-3"
                          HelperText="@L["ConnectorStandingPolicyForm.EscalationTermsHelp"]" />
            <MudSelect T="string" Label="@L["ConnectorStandingPolicyForm.ScheduledField"]"
                       @bind-Value="_editor.ScheduledFieldKey" Disabled="Busy" Class="mt-3">
                <MudSelectItem T="string" Value="@string.Empty">@L["ConnectorStandingPolicyForm.NoScheduledField"]</MudSelectItem>
                @foreach (var field in _editor.Fields.Where(x => x.Review.CurrentValue?.ValueKind == System.Text.Json.JsonValueKind.String))
                { <MudSelectItem T="string" Value="@ConnectorStandingPolicyEditor.Key(field.Review.Field)">@field.Review.Label</MudSelectItem> }
            </MudSelect>
            <MudText Typo="Typo.caption">@L["ConnectorStandingPolicyForm.ScheduledHint"]</MudText>
            @if (review.Media is { } media)
            {
                <MudText Typo="Typo.subtitle1" Class="mt-3">@L["ConnectorStandingPolicyForm.MediaLimits"]</MudText>
                <MudText>@L.Format("ConnectorStandingPolicyForm.ReviewedFile", new { name = media.FileName })</MudText>
                <MudNumericField T="decimal" Label="@L["ConnectorStandingPolicyForm.MaxFileSize"]" @bind-Value="_editor.MaximumMediaMegabytes" Min="0.00000095367431640625m" Max="262144m" Disabled="Busy" />
                <MudSelect T="string" Label="@L["ConnectorStandingPolicyForm.PermittedFileTypes"]" MultiSelection="true" @bind-SelectedValues="_editor.AllowedMediaTypes" Disabled="Busy">
                    @foreach (var type in MediaAttachmentPolicy.Accept.Split(',').Where(x => !x.StartsWith('.')).Append(media.ContentType).Distinct())
                    { <MudSelectItem T="string" Value="@type">@type</MudSelectItem> }
                </MudSelect>
                <MudText Typo="Typo.caption">@L["ConnectorStandingPolicyForm.MediaHint"]</MudText>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Preview" Disabled="Busy" Class="mt-4">@L["ConnectorStandingPolicyForm.ReviewRules"]</MudButton>
        }
        else
        {
            <MudText Typo="Typo.h6">@L["ConnectorStandingPolicyForm.ReviewTitle"]</MudText>
            @foreach (var rule in _pending.Definition.Fields)
            {
                <MudText Class="my-2" Style="white-space: pre-wrap; overflow-wrap: anywhere">
                    <strong>@L.Format("ConnectorStandingPolicyForm.Summary.FieldLabel", new { label = review.FieldReviews.Single(x => x.Field == rule.Field).Label })</strong>
                    @(rule.AllowAny ? L["ConnectorStandingPolicyForm.Summary.AnyValues"] : rule.AllowedValues.Count == 0 ? L["ConnectorStandingPolicyForm.Summary.MustBeUnset"] : string.Join("; ", rule.AllowedValues.Select(x => ConnectorStandingPolicyEditor.Label(L, x))))
                    @(rule.AllowOmission ? L["ConnectorStandingPolicyForm.Summary.MayBeUnset"] : L["ConnectorStandingPolicyForm.Summary.MustBeSupplied"])
                </MudText>
            }
            <MudText>@L.Format("ConnectorStandingPolicyForm.Summary.Days", new { days = string.Join(", ", _pending.Definition.DaysOfWeek.Select(DayName)) })</MudText>
            <MudText>@L.Format("ConnectorStandingPolicyForm.Summary.Hours", new { start = ClockLabel(_pending.Definition.StartMinute), end = ClockLabel(_pending.Definition.EndMinute), zone = TimeZoneInfo.FindSystemTimeZoneById(_pending.Definition.TimeZoneId).DisplayName })</MudText>
            <MudText>@L.Format("ConnectorStandingPolicyForm.Summary.Maximum", new { count = _pending.Definition.MaximumActionsPerHour })</MudText>
            <MudText>@L.Format("ConnectorStandingPolicyForm.Summary.Expires", new { time = TimeZoneInfo.ConvertTime(_pending.Definition.ExpiresAt, TimeZoneInfo.FindSystemTimeZoneById(_pending.Definition.TimeZoneId)).ToString("f", Time.Culture) })</MudText>
            <MudText>@L.Format("ConnectorStandingPolicyForm.Summary.EscalationTerms", new { terms = _pending.Definition.EscalationTerms.Count == 0 ? L["ConnectorStandingPolicyForm.NoneSelected"] : string.Join("; ", _pending.Definition.EscalationTerms) })</MudText>
            @if (_pending.Definition.ScheduledAt is { } scheduled)
            { <MudText>@L.Format("ConnectorStandingPolicyForm.Summary.Scheduled", new { label = review.FieldReviews.Single(x => x.Field == scheduled).Label })</MudText> }
            @if (_pending.Definition.MaximumMediaBytes is { } bytes)
            { <MudText>@L.Format("ConnectorStandingPolicyForm.Summary.Media", new { size = Time.FormatNumber(bytes / 1048576m, "G"), types = string.Join(", ", _pending.Definition.AllowedMediaTypes!) })</MudText> }
            <MudAlert Severity="Severity.Warning" Class="my-3">@L["ConnectorStandingPolicyForm.FinalWarning"]</MudAlert>
            <MudCheckBox T="bool" @bind-Value="_confirmed" Disabled="Busy" Label="@L["ConnectorStandingPolicyForm.Authorize"]" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Busy || !_confirmed)" OnClick="Submit">@L["ConnectorStandingPolicyForm.ApprovePolicy"]</MudButton>
            <MudButton Disabled="Busy" OnClick="Edit">@L["ConnectorStandingPolicyForm.BackToEditing"]</MudButton>
        }
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public ConnectorStandingPolicySetup Setup { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<ApproveConnectorStandingPolicyRequest> Approved { get; set; }
    private ConnectorStandingPolicySetup? _last;
    private ConnectorStandingPolicyEditor? _editor;
    private ApproveConnectorStandingPolicyRequest? _pending;
    private bool _confirmed;
    private string? _error;
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_last, Setup))
        { _last = Setup; _editor = Setup.Review is null ? null : new(Setup); _pending = null; _confirmed = false; _error = null; }
    }
    private void Preview()
    {
        try { _pending = _editor!.Build(); _confirmed = false; _error = null; }
        catch (PolicyValidationException error) { _error = L.Format(error.Key, error.Arguments); }
        catch (Exception error) when (error is ArgumentException or InvalidOperationException or TimeZoneNotFoundException or InvalidTimeZoneException)
        { _error = error.Message; }
    }
    private void Edit() { _pending = null; _confirmed = false; }
    private Task Submit() => _confirmed && _pending is not null ? Approved.InvokeAsync(_pending) : Task.CompletedTask;
    private string ClockLabel(int minute) => minute == 1440 ? L["ConnectorStandingPolicyForm.Midnight"] : TimeSpan.FromMinutes(minute).ToString(@"hh\:mm");
    private string DayName(int day) => Time.Culture.DateTimeFormat.GetDayName((DayOfWeek)day);
}
