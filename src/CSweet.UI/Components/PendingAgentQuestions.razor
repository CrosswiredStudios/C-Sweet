@using CSweet.Contracts.Communications
@using CSweet.Contracts.Core
@using CSweet.Contracts.Realtime
@inject HttpClient Http
@inject AppRealtimeState Realtime
@implements IDisposable

<section class="pending-decisions @(SummaryOnly ? "decision-summary" : "decision-inbox")" aria-label="@(SummaryOnly ? "Pending attention items" : "Pending Decisions")">
    @if (!SummaryOnly)
    {
    <div class="decisions-toolbar">
        <div>
            <h2>Pending Decisions</h2>
            <p>Review requests for direction and respond without leaving this page.</p>
        </div>
        <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" Disabled="_loading" OnClick="RefreshAsync" aria-label="Refresh decisions" />
    </div>
    }
    @if (_error is not null) { <MudAlert Severity="Severity.Warning">@_error</MudAlert> }
    else if (_loading && !_loaded) { <MudProgressLinear Indeterminate="true" /> }
    else if (_questions.Count == 0 && !SummaryOnly)
    {
        <div class="decisions-empty"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" /><span>No decisions need your response.</span></div>
    }
    else
    {
        <div class="decisions-count">
            @if (SummaryOnly) { <span>@PendingCount pending</span> }
            else { <span>@_questions.Count pending questions</span><span>@_questions.Select(x => x.AgentOrganizationUserId).Distinct().Count() agents</span> }
        </div>
        @if (!SummaryOnly)
        {
            <div class="decision-list">
                @foreach (var question in _questions)
                {
                    <AgentQuestionCard @key="question.Decision.Id" OrganizationId="OrganizationId" Question="question" Answered="OnAnsweredAsync" />
                }
            </div>
        }
    }
    @if (SummaryOnly)
    {
        @if (ApprovalError is not null) { <MudAlert Severity="Severity.Warning">@ApprovalError</MudAlert> }
        else if (!ApprovalsLoaded) { <MudText Color="Color.Secondary">Loading approvals…</MudText> }
        @if (RecommendationError is not null) { <MudAlert Severity="Severity.Warning">@RecommendationError</MudAlert> }
        else if (!RecommendationsLoaded) { <MudText Color="Color.Secondary">Loading hiring suggestions…</MudText> }
        @if (_loaded && _error is null && ApprovalsLoaded && ApprovalError is null && RecommendationsLoaded && RecommendationError is null && PendingCount == 0)
        {
            <div class="decisions-empty"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" /><span>Nothing needs your attention.</span></div>
        }
        else
        {
            <div class="attention-list" aria-label="Decisions, approvals, and hiring">
                @foreach (var question in _questions)
                {
                    <AgentQuestionCard @key="question.Decision.Id" OrganizationId="OrganizationId" Question="question" Overview="true" Answered="OnAnsweredAsync" />
                }
                @foreach (var approval in PendingApprovals.Take(_showAll ? PendingApprovals.Count : 5))
                {
                    var hiring = approval.Kind is ApprovalDashboardKinds.ResourceChange or ApprovalDashboardKinds.HiringWorkflow;
                    @if (hiring)
                    {
                        <OverviewHiringApprovalCard @key="approval.Id" OrganizationId="OrganizationId" Approval="approval" Decided="OnApprovalDecidedAsync" />
                    }
                    else
                    {
                    <AttentionRequestCard @key="approval.Id" Kind="Approval" Name="@approval.RequestedBy" Context="@approval.RequestingTeam"
                        Prompt="@approval.Title" Description="@approval.Summary" Status="@($"Requested {approval.CreatedAt.ToLocalTime():g}")">
                        <MudButton Href="@($"/organizations/{OrganizationId}/approvals?approvalId={approval.Id}")" Variant="Variant.Outlined" Color="Color.Primary">Review approval</MudButton>
                    </AttentionRequestCard>
                    }
                }
                @foreach (var incident in ProjectIncidents.Take(_showAll ? ProjectIncidents.Count : 5))
                {
                    <AttentionRequestCard @key="incident.Id" Kind="Project stalled" Name="@incident.ReporterName" Context="@incident.ProjectName"
                        Prompt="@incident.Reason" Description="@incident.RecommendedAction" Status="@($"Detected {incident.DetectedAt.ToLocalTime():g}")">
                        <MudButton Href="@incident.ActionUri" Variant="Variant.Outlined" Color="Color.Primary">Read manager report</MudButton>
                    </AttentionRequestCard>
                }
                @foreach (var recommendation in Recommendations.Take(_showAll ? Recommendations.Count : 5))
                {
                    <OverviewHiringCandidateCard @key="recommendation.Id" OrganizationId="OrganizationId" Recommendation="recommendation" Hired="RefreshRequested" />
                }
            </div>
            @if (ProjectIncidents.Count > 5 || PendingApprovals.Count > 5 || Recommendations.Count > 5)
            {
                <MudButton OnClick="() => _showAll = !_showAll" aria-expanded="@_showAll" Size="Size.Small">@(_showAll ? "Show fewer items" : $"Show all items ({PendingCount})")</MudButton>
            }
        }
    }
</section>
@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public bool SummaryOnly { get; set; }
    [Parameter] public IReadOnlyList<ProjectIncidentAttentionResponse> ProjectIncidents { get; set; } = [];
    [Parameter] public IReadOnlyList<ApprovalDashboardItemResponse> Approvals { get; set; } = [];
    [Parameter] public IReadOnlyList<HiringRecommendationResponse> Recommendations { get; set; } = [];
    [Parameter] public bool ApprovalsLoaded { get; set; } = true;
    [Parameter] public bool RecommendationsLoaded { get; set; } = true;
    [Parameter] public string? ApprovalError { get; set; }
    [Parameter] public string? RecommendationError { get; set; }
    [Parameter] public EventCallback RefreshRequested { get; set; }
    private IReadOnlyList<ApprovalDashboardItemResponse> PendingApprovals => Approvals
        .Where(x => !_completedApprovals.Contains(x.Id) && x.CanDecide && x.Status == "Pending").ToList();
    private int PendingCount => _questions.Count + PendingApprovals.Count + Recommendations.Count + ProjectIncidents.Count;
    private bool _showAll;
    private readonly HashSet<Guid> _completedDecisions = [];
    private readonly HashSet<Guid> _completedApprovals = [];
    private IReadOnlyList<PendingAgentQuestionResponse> _questions = [];
    private bool _loading, _loaded, _disposed;
    private string? _error;
    private long _loadVersion;
    private Guid? _loadedOrganization;
    protected override void OnInitialized()
    {
        Realtime.EventReceived += OnEvent;
        Realtime.Reconnected += OnReconnect;
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedOrganization == OrganizationId) return;
        _loadedOrganization = OrganizationId;
        _questions = []; _loaded = false; _showAll = false;
        _completedDecisions.Clear();
        _completedApprovals.Clear();
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        var organization = OrganizationId;
        _loading = true; _error = null;
        try
        {
            var items = await Http.GetFromJsonAsync<List<PendingAgentQuestionResponse>>($"api/organizations/{organization}/communications/questions/pending") ?? [];
            if (!_disposed && version == _loadVersion)
            {
                _questions = items.Where(x => !_completedDecisions.Contains(x.Decision.Id) && string.Equals(x.Decision.Status, "Pending", StringComparison.OrdinalIgnoreCase)).ToList();
                _loaded = true;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        { if (version == _loadVersion) _error = SummaryOnly ? "Could not load pending questions." : "Could not load pending questions. Use Refresh decisions to try again."; }
        finally { if (version == _loadVersion) _loading = false; }
    }
    private async Task OnAnsweredAsync(Guid decisionId)
    {
        _completedDecisions.Add(decisionId);
        _questions = _questions.Where(x => x.Decision.Id != decisionId).ToList();
        StateHasChanged();
        await LoadAsync();
    }
    private async Task RefreshAsync() { await Task.WhenAll(LoadAsync(), RefreshRequested.InvokeAsync()); }
    private async Task OnApprovalDecidedAsync(Guid approvalId)
    {
        _completedApprovals.Add(approvalId);
        StateHasChanged();
        await RefreshRequested.InvokeAsync();
    }
    private void OnEvent(AppRealtimeEventEnvelope envelope)
    {
        if (envelope.OrganizationId == OrganizationId && envelope.EventType == CommunicationEvents.DecisionUpdated) OnReconnect();
    }
    private void OnReconnect()
    {
        if (!_disposed) _ = InvokeAsync(async () => { await LoadAsync(); if (!_disposed) StateHasChanged(); });
    }
    public void Dispose()
    {
        _disposed = true; ++_loadVersion;
        Realtime.EventReceived -= OnEvent;
        Realtime.Reconnected -= OnReconnect;
    }
}

