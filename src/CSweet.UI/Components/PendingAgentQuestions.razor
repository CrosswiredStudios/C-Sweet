@using CSweet.Contracts.Communications
@using CSweet.Contracts.Core
@using CSweet.Contracts.Compute
@using CSweet.Contracts.Realtime
@inject HttpClient Http
@inject AppRealtimeState Realtime
@implements IDisposable
@inject IAppLocalizer L

<section class="pending-decisions @(SummaryOnly ? "decision-summary" : "decision-inbox")" aria-label="@(SummaryOnly ? "Pending attention items" : "Pending Decisions")">
    @if (!SummaryOnly)
    {
    <div class="decisions-toolbar">
        <div>
            <h2>@L["PendingAgentQuestions.PendingDecisions"]</h2>
            <p>@L["PendingAgentQuestions.ReviewRequestsForDirectionAnd"]</p>
        </div>
        <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" Disabled="_loading" OnClick="RefreshAsync" aria-label="@L["PendingAgentQuestions.RefreshDecisions"]" />
    </div>
    }
    @if (_error is not null) { <MudAlert Severity="Severity.Warning">@_error</MudAlert> }
    else if (_loading && !_loaded) { <MudProgressLinear Indeterminate="true" /> }
    else if (_questions.Count == 0 && !SummaryOnly)
    {
        <div class="decisions-empty"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" /><span>@L["PendingAgentQuestions.NoDecisionsNeedYourResponse"]</span></div>
    }
    else
    {
        <div class="decisions-count">
            @if (SummaryOnly) { <span>@PendingCount pending</span> }
            else { <span>@_questions.Count pending questions</span><span>@_questions.Select(x => x.AgentOrganizationUserId).Distinct().Count() agents</span> }
        </div>
        @if (!SummaryOnly)
        {
            <div class="decision-list">
                @foreach (var question in OverviewAttentionItems.StandaloneQuestions(_questions, ProjectIncidents))
                {
                    <AgentQuestionCard @key="question.Decision.Id" OrganizationId="OrganizationId" Question="question" Answered="OnAnsweredAsync" />
                }
            </div>
        }
    }
    @if (SummaryOnly)
    {
        @if (ApprovalError is not null) { <MudAlert Severity="Severity.Warning">@ApprovalError</MudAlert> }
        else if (!ApprovalsLoaded) { <MudText Color="Color.Secondary">@L["PendingAgentQuestions.LoadingApprovals"]</MudText> }
        @if (RecommendationError is not null) { <MudAlert Severity="Severity.Warning">@RecommendationError</MudAlert> }
        else if (!RecommendationsLoaded) { <MudText Color="Color.Secondary">@L["PendingAgentQuestions.LoadingHiringSuggestions"]</MudText> }
        @if (ComputeError is not null) { <MudAlert Severity="Severity.Warning">@ComputeError</MudAlert> }
        else if (!ComputeLoaded) { <MudText Color="Color.Secondary">@L["PendingAgentQuestions.LoadingComputePermissions"]</MudText> }
        @if (ComputeHasMore)
        {
            <MudText Color="Color.Secondary">@L["PendingAgentQuestions.ShowingPermissionsForThe100"]</MudText>
        }
        @if (_loaded && _error is null && ApprovalsLoaded && ApprovalError is null && RecommendationsLoaded && RecommendationError is null && ComputeLoaded && ComputeError is null && !ComputeHasMore && PendingCount == 0)
        {
            <div class="decisions-empty"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" /><span>@L["PendingAgentQuestions.NothingNeedsYourAttention"]</span></div>
        }
        else
        {
            <div class="attention-list" aria-label="@L["PendingAgentQuestions.DecisionsApprovalsHiringAndCompute"]">
                @foreach (var question in OverviewAttentionItems.StandaloneQuestions(_questions, ProjectIncidents))
                {
                    <AgentQuestionCard @key="question.Decision.Id" OrganizationId="OrganizationId" Question="question" Overview="true" Answered="OnAnsweredAsync" />
                }
                @foreach (var approval in PendingApprovals.Take(_showAll ? PendingApprovals.Count : 5))
                {
                    var hiring = approval.Kind is ApprovalDashboardKinds.ResourceChange or ApprovalDashboardKinds.HiringWorkflow;
                    @if (hiring)
                    {
                        <OverviewHiringApprovalCard @key="approval.Id" OrganizationId="OrganizationId" Approval="approval" Decided="OnApprovalDecidedAsync" />
                    }
                    else if (approval.Artifact is { SubmittedRevisionId: not null })
                    {
                        <DocumentApprovalCard @key="approval.Id" OrganizationId="OrganizationId" Approval="approval"
                            Opened="DocumentOpened" RefreshRequested="RefreshRequested" />
                    }
                    else
                    {
                    <AttentionRequestCard @key="approval.Id" Kind="Approval" Name="@approval.RequestedBy" Context="@approval.RequestingTeam"
                        Prompt="@approval.Title" Description="@approval.Summary" Status="@($"Requested {approval.CreatedAt.ToLocalTime():g}")">
                        <MudButton Href="@($"/organizations/{OrganizationId}/approvals?approvalId={approval.Id}")" Variant="Variant.Outlined" Color="Color.Primary">@L["PendingAgentQuestions.ReviewApproval"]</MudButton>
                    </AttentionRequestCard>
                    }
                }
                @foreach (var incident in ProjectIncidents.Take(_showAll ? ProjectIncidents.Count : 5))
                {
                    <ProjectIncidentAttentionCard @key="incident.Id" OrganizationId="OrganizationId" Incident="incident" RefreshRequested="RefreshRequested" />
                }
                @foreach (var resource in ComputeResources.Take(_showAll ? ComputeResources.Count : 5))
                {
                    <AttentionRequestCard @key="resource.Id" Kind="Compute" EmployeeId="resource.EmployeeId" Name="@resource.Agent" Context="@resource.Project"
                        Prompt="Allow a local test link" PromptMeta="@($"{resource.OperatingSystem} · {resource.Id.ToString("N")[..8]}")"
                        Description="@L["PendingAgentQuestions.AllowTheAgentToShare"]"
                        Status="This computer only · This instance only · Expires with the instance. No public or outbound internet access.">
                        <MudButton OnClick="() => AllowLocalLinkAsync(resource.Id)" Disabled="@_grantingLocalLinks.Contains(resource.Id)"
                            Variant="Variant.Outlined" Color="Color.Primary">@(_grantingLocalLinks.Contains(resource.Id) ? "Allowing…" : "Allow access")</MudButton>
                        @if (_localLinkErrors.TryGetValue(resource.Id, out var error))
                        {
                            <MudText role="alert" Color="Color.Error">@error</MudText>
                        }
                    </AttentionRequestCard>
                }
                @foreach (var recommendation in Recommendations.Take(_showAll ? Recommendations.Count : 5))
                {
                    <OverviewHiringCandidateCard @key="recommendation.Id" OrganizationId="OrganizationId" Recommendation="recommendation" Hired="RefreshRequested" />
                }
            </div>
            @if (ProjectIncidents.Count > 5 || PendingApprovals.Count > 5 || Recommendations.Count > 5 || ComputeResources.Count > 5)
            {
                <MudButton OnClick="() => _showAll = !_showAll" aria-expanded="@_showAll" Size="Size.Small">@(_showAll ? "Show fewer items" : $"Show all items ({PendingCount})")</MudButton>
            }
        }
    }
</section>
@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public bool SummaryOnly { get; set; }
    [Parameter] public IReadOnlyList<ProjectIncidentAttentionResponse> ProjectIncidents { get; set; } = [];
    [Parameter] public IReadOnlyList<ApprovalDashboardItemResponse> Approvals { get; set; } = [];
    [Parameter] public IReadOnlyList<HiringRecommendationResponse> Recommendations { get; set; } = [];
    [Parameter] public bool ApprovalsLoaded { get; set; } = true;
    [Parameter] public bool RecommendationsLoaded { get; set; } = true;
    [Parameter] public string? ApprovalError { get; set; }
    [Parameter] public string? RecommendationError { get; set; }
    [Parameter] public IReadOnlyList<ComputeResourceStatus> ComputeResources { get; set; } = [];
    [Parameter] public bool ComputeLoaded { get; set; } = true;
    [Parameter] public string? ComputeError { get; set; }
    [Parameter] public bool ComputeHasMore { get; set; }
    [Parameter] public EventCallback RefreshRequested { get; set; }
    [Parameter] public EventCallback<DocumentApprovalSelection> DocumentOpened { get; set; }
    private IReadOnlyList<ApprovalDashboardItemResponse> PendingApprovals => Approvals
        .Where(x => !_completedApprovals.Contains(x.Id) && OverviewAttentionItems.IsActionable(x)).ToList();
    private int PendingCount => OverviewAttentionItems.StandaloneQuestions(_questions, ProjectIncidents).Count + PendingApprovals.Count + Recommendations.Count + ProjectIncidents.Count + ComputeResources.Count;
    private bool _showAll;
    private readonly HashSet<Guid> _completedDecisions = [];
    private readonly HashSet<Guid> _completedApprovals = [];
    private readonly HashSet<Guid> _grantingLocalLinks = [];
    private readonly Dictionary<Guid, string> _localLinkErrors = [];
    private IReadOnlyList<PendingAgentQuestionResponse> _questions = [];
    private bool _loading, _loaded, _disposed;
    private string? _error;
    private long _loadVersion;
    private Guid? _loadedOrganization;
    protected override void OnInitialized()
    {
        Realtime.EventReceived += OnEvent;
        Realtime.Reconnected += OnReconnect;
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedOrganization == OrganizationId) return;
        _loadedOrganization = OrganizationId;
        _questions = []; _loaded = false; _showAll = false;
        _completedDecisions.Clear();
        _completedApprovals.Clear();
        _localLinkErrors.Clear();
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        var organization = OrganizationId;
        _loading = true; _error = null;
        try
        {
            var items = await Http.GetFromJsonAsync<List<PendingAgentQuestionResponse>>($"api/organizations/{organization}/communications/questions/pending") ?? [];
            if (!_disposed && version == _loadVersion)
            {
                _questions = items.Where(x => !_completedDecisions.Contains(x.Decision.Id) && OverviewAttentionItems.IsPending(x.Decision.Status)).ToList();
                _loaded = true;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        { if (version == _loadVersion) _error = SummaryOnly ? "Could not load pending questions." : "Could not load pending questions. Use Refresh decisions to try again."; }
        finally { if (version == _loadVersion) _loading = false; }
    }
    private async Task OnAnsweredAsync(Guid decisionId)
    {
        _completedDecisions.Add(decisionId);
        _questions = _questions.Where(x => x.Decision.Id != decisionId).ToList();
        StateHasChanged();
        await LoadAsync();
    }
    private async Task RefreshAsync() { await Task.WhenAll(LoadAsync(), RefreshRequested.InvokeAsync()); }
    private async Task AllowLocalLinkAsync(Guid environmentId)
    {
        if (!_grantingLocalLinks.Add(environmentId)) return;
        var organization = OrganizationId;
        _localLinkErrors.Remove(environmentId);
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/organizations/{organization}/compute/{environmentId}/local-link", new { enabled = true });
            if (organization != OrganizationId || _disposed) return;
            if (!response.IsSuccessStatusCode)
                _localLinkErrors[environmentId] = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Forbidden => "Only a current business owner can allow access.",
                    System.Net.HttpStatusCode.Conflict => "The instance or its permissions changed. Refresh and try again.",
                    _ => "Could not allow access. Try again."
                };
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        {
            if (organization == OrganizationId && !_disposed)
                _localLinkErrors[environmentId] = "Could not confirm access. Refresh before trying again.";
        }
        finally { _grantingLocalLinks.Remove(environmentId); }
        if (organization == OrganizationId && !_disposed) await RefreshRequested.InvokeAsync();
    }
    private async Task OnApprovalDecidedAsync(Guid approvalId)
    {
        _completedApprovals.Add(approvalId);
        StateHasChanged();
        await RefreshRequested.InvokeAsync();
    }
    private void OnEvent(AppRealtimeEventEnvelope envelope)
    {
        if (envelope.OrganizationId == OrganizationId && envelope.EventType == CommunicationEvents.DecisionUpdated) OnReconnect();
    }
    private void OnReconnect()
    {
        if (!_disposed) _ = InvokeAsync(async () => { await LoadAsync(); if (!_disposed) StateHasChanged(); });
    }
    public void Dispose()
    {
        _disposed = true; ++_loadVersion;
        Realtime.EventReceived -= OnEvent;
        Realtime.Reconnected -= OnReconnect;
    }
}

