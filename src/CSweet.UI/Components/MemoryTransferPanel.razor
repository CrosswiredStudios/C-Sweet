@using CSweet.Contracts.Core
@using CSweet.Contracts.Memory
@using System.Net
@inject HttpClient Http
@inject IAppLocalizer L

<MudPaper Elevation="1" Class="surface-panel pa-4 mb-4" aria-label="@L["MemoryTransferPanel.KnowledgeTransfers"]">
    <MudText Typo="Typo.h6">@L["MemoryTransferPanel.KnowledgeTransfers"]</MudText>
    <MudText Class="mb-2">@L["MemoryTransferPanel.PrepareAHandoffReviewThe"]</MudText>
    @if (!_opened)
    {
        <MudButton OnClick="OpenAsync" Disabled="_busy">@L["MemoryTransferPanel.ManageTransfers"]</MudButton>
    }
    else
    {
        <MudStack Spacing="2">
            <MudSelect T="Guid" Label="@L["MemoryTransferPanel.ReceivingEmployee"]" Value="_target" ValueChanged="TargetChangedAsync" Disabled="Frozen">
                @foreach (var employee in _employees.Where(x => x.Id != EmployeeId && x.EmployeeType == 1 && x.IsActive && x.ArchivedAt is null))
                { <MudSelectItem T="Guid" Value="employee.Id">@employee.DisplayName</MudSelectItem> }
            </MudSelect>
            <MudButton OnClick="@(() => TargetChangedAsync(_target))" Disabled="@(Frozen || _target == Guid.Empty)">@L["MemoryTransferPanel.RefreshSharedAudiences"]</MudButton>
            <MudSelect T="string" Label="@L["MemoryTransferPanel.SourceAudience"]" @bind-Value="_scope" Disabled="@(Frozen || _items.Count > 0)">
                <MudSelectItem T="string" Value="@("Employee")">@L["MemoryTransferPanel.EmployeeMemory"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("Relationship")">@L["MemoryTransferPanel.YourRelationshipWithThisEmployee"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("Organization")">@L["MemoryTransferPanel.OrganizationMemory"]</MudSelectItem>
                @if (_audiences.Any(x => x.Scope == "Team"))
                { <MudSelectItem T="string" Value="@("Team")">@L["MemoryTransferPanel.TeamMemory"]</MudSelectItem> }
                @if (_audiences.Any(x => x.Scope == "Role"))
                { <MudSelectItem T="string" Value="@("Role")">@L["MemoryTransferPanel.RoleMemory"]</MudSelectItem> }
            </MudSelect>
            @if (_scope is "Team" or "Role")
            {
                <MudSelect T="Guid?" Label="@L["MemoryTransferPanel.SharedAudience"]" @bind-Value="_sourceAudience" Disabled="@(Frozen || _items.Count > 0)">
                    @foreach (var audience in _audiences.Where(x => x.Scope == _scope))
                    { <MudSelectItem T="Guid?" Value="@((Guid?)audience.AudienceId)">@audience.Name</MudSelectItem> }
                </MudSelect>
                <MudText Typo="Typo.caption">@L["MemoryTransferPanel.TheReceivingEmployeeAndReviewer"]</MudText>
            }
            <MudText Typo="Typo.caption">Relationship handoffs stay in your relationship with the receiving employee. You must manage both employees; organization memory requires a top-level human manager.</MudText>
            <MudButton OnClick="AddSelected" Disabled="@(Frozen || Selected is null || _items.Count >= 32)">@L["MemoryTransferPanel.AddTheCurrentlyInspectedMemory"]</MudButton>
            @foreach (var item in _items)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" @key="item.Id">
                    <MudText>@item.Title</MudText>
                    <MudButton OnClick="@(() => _items.Remove(item))" Disabled="Frozen">@L["Common.Remove"]</MudButton>
                </MudStack>
            }
            <MudTextField T="string" Label="@L["MemoryTransferPanel.HandoffNotes"]" @bind-Value="_debrief" Lines="3" MaxLength="16000" Disabled="Frozen" />
            <MudSelect T="string" Label="@L["MemoryTransferPanel.NotesSensitivity"]" @bind-Value="_sensitivity" Disabled="Frozen">
                @foreach (var value in new[] { "Personal", "Confidential", "Restricted" })
                { <MudSelectItem T="string" Value="value">@value</MudSelectItem> }
            </MudSelect>
            <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="PrepareAsync"
                       Disabled="@(Frozen || !CanPrepare)">@L["MemoryTransferPanel.PrepareForReview"]</MudButton>
            @if (_pendingPrepare is not null || _pendingTransition is not null)
            {
                <MudButton OnClick="RetryAsync" Disabled="_busy">@L["MemoryTransferPanel.RetryTheSameOperation"]</MudButton>
            }
            @if (_transfer is { } transfer)
            {
                <MudDivider />
                <MudText Typo="Typo.h6">Transfer to @EmployeeName(transfer.TargetEmployeeId)</MudText>
                <MudText>@transfer.Status · @transfer.Sensitivity</MudText>
                <pre style="white-space:pre-wrap;overflow-wrap:anywhere">@transfer.Content</pre>
                @if (transfer.Status is "PendingApproval" or "Approved" && !transfer.CanApprove && !transfer.CanApply)
                { <MudAlert Severity="Severity.Warning">@L["MemoryTransferPanel.SourceEvidenceChangedOrIs"]</MudAlert> }
                <MudStack Row="true">
                    <MudButton OnClick="@(() => LoadTransferAsync(transfer.PackageId))" Disabled="Frozen">@L["MemoryTransferPanel.RefreshReview"]</MudButton>
                    <MudButton OnClick='@(() => TransitionAsync("approve"))' Disabled="@(Frozen || !transfer.CanApprove)">@L["Common.Approve"]</MudButton>
                    <MudButton Color="Color.Primary" OnClick='@(() => TransitionAsync("apply"))' Disabled="@(Frozen || !transfer.CanApply)">@L["MemoryTransferPanel.ApplyToReceivingEmployee"]</MudButton>
                    <MudButton Color="Color.Error" OnClick='@(() => TransitionAsync("reject"))' Disabled="@(Frozen || !transfer.CanReject)">
                        @(transfer.Status == "Applied" ? "Revoke transfer" : "Reject transfer")
                    </MudButton>
                </MudStack>
            }
            <MudText Typo="Typo.subtitle1">@L["MemoryTransferPanel.YourSavedTransfers"]</MudText>
            <MudButton OnClick="@(() => LoadListAsync(false))" Disabled="Frozen">@L["MemoryTransferPanel.RefreshSavedTransfers"]</MudButton>
            @foreach (var saved in _saved)
            {
                <MudButton OnClick="@(() => LoadTransferAsync(saved.PackageId))" Disabled="Frozen" @key="saved.PackageId">
                    Review handoff to @EmployeeName(saved.TargetEmployeeId) · @saved.CreatedAt.ToLocalTime().ToString("g")
                </MudButton>
            }
            @if (_nextCursor.HasValue)
            { <MudButton OnClick="@(() => LoadListAsync(true))" Disabled="Frozen">@L["MemoryTransferPanel.LoadOlderTransfers"]</MudButton> }
        </MudStack>
    }
    @if (_message is not null) { <MudAlert Severity="Severity.Info" Class="mt-2">@_message</MudAlert> }
</MudPaper>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid EmployeeId { get; set; }
    [Parameter] public AgentMemoryItemResponse? Selected { get; set; }
    private string Url => $"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/memory/transfers";
    private bool _opened, _busy;
    private bool Frozen => _busy || _pendingPrepare is not null || _pendingTransition is not null;
    private IReadOnlyList<OrganizationUserResponse> _employees = [];
    private readonly List<AgentMemoryItemResponse> _items = [];
    private readonly List<MemoryTransferListItem> _saved = [];
    private Guid _target;
    private Guid? _sourceAudience;
    private IReadOnlyList<MemoryTransferAudience> _audiences = [];
    private bool CanPrepare => _target != Guid.Empty && (_items.Count > 0 || !string.IsNullOrWhiteSpace(_debrief)) &&
        (_scope is not ("Team" or "Role") || _audiences.Any(x => x.Scope == _scope && x.AudienceId == _sourceAudience));
    private Guid? _nextCursor;
    private string _scope = "Employee", _debrief = "", _sensitivity = "Personal";
    private string? _message;
    private MemoryTransferResponse? _transfer;
    private PrepareMemoryTransferRequest? _pendingPrepare;
    private TransitionMemoryTransferRequest? _pendingTransition;
    private Guid _pendingPackage;
    private string? _pendingUrl, _pendingOrigin;
    private long _viewGeneration, _activity;
    private (Guid Organization, Guid Employee)? _view;

    protected override void OnParametersSet()
    {
        var view = (OrganizationId, EmployeeId);
        if (_view == view) return;
        _view = view; _viewGeneration++; _activity++;
        ClearPresentation();
        _employees = []; _saved.Clear(); _nextCursor = null; _target = Guid.Empty;
        _audiences = []; _sourceAudience = null;
        _scope = "Employee"; _sensitivity = "Personal";
        // An uncertain write keeps its exact body and original route across navigation.
        _opened = _pendingPrepare is not null || _pendingTransition is not null;
        if (!_opened) _busy = false;
        _message = _opened ? "A transfer operation for the previous employee is unconfirmed. Retry the same operation before preparing another handoff." : null;
    }

    private void ClearPresentation()
    { _transfer = null; _items.Clear(); _debrief = ""; }
    private void ClearPending()
    { _pendingPrepare = null; _pendingTransition = null; _pendingUrl = null; _pendingOrigin = null; _pendingPackage = Guid.Empty; }
    private string EmployeeName(Guid id) => _employees.FirstOrDefault(x => x.Id == id)?.DisplayName ?? "Unavailable employee";
    private static string? ItemKind(string kind) => kind switch { "Episode" or "Claim" or "Block" or "Procedure" => kind,
        "Core" => "Block", "Relationship" or "Edge" => "Edge", _ => null };

    private async Task OpenAsync()
    {
        if (Frozen) return;
        var generation = _viewGeneration; var activity = ++_activity;
        var organization = OrganizationId;
        _busy = true; _message = null;
        try
        {
            var employees = await Http.GetFromJsonAsync<IReadOnlyList<OrganizationUserResponse>>($"api/core/organizations/{organization}/users") ?? [];
            if (generation != _viewGeneration) return;
            _employees = employees;
            _opened = true;
        }
        catch (Exception e) when (NetworkError(e)) { if (generation == _viewGeneration) _message = L["MemoryTransferPanel.TransferControlsCouldNotBe"]; }
        finally { if (activity == _activity) _busy = false; }
        if (generation == _viewGeneration && _opened) await LoadListAsync(false);
    }
    private void AddSelected()
    {
        if (Frozen || Selected is not { } selected) return;
        if (ItemKind(selected.Kind) is null || selected.Scope is not ("Employee" or "Relationship" or "Organization" or "Team" or "Role") ||
            selected.Scope is "Team" or "Role" && (selected.AudienceId is null || selected.AudienceId == Guid.Empty))
        { _message = L["MemoryTransferPanel.ThisItemCannotBeTransferred"]; return; }
        if (_items.Count > 0 && (_items[0].Scope != selected.Scope || _items[0].UserId != selected.UserId || _items[0].AudienceId != selected.AudienceId))
        { _message = L["MemoryTransferPanel.KeepEachHandoffWithinOne"]; return; }
        _scope = selected.Scope;
        _sourceAudience = selected.AudienceId;
        if (!_items.Any(x => x.Id == selected.Id && x.Kind == selected.Kind)) _items.Add(selected);
        _message = null;
    }
    private async Task PrepareAsync()
    {
        if (Frozen || !CanPrepare) return;
        _pendingPrepare = new(Guid.NewGuid(), _target, _scope, _items.Select(x => new MemoryTransferSelection(ItemKind(x.Kind)!, x.Id)).ToArray(), _debrief, _sensitivity,
            _scope is "Team" or "Role" ? _sourceAudience : null);
        _pendingOrigin = Url; _pendingUrl = Url;
        await RetryAsync();
    }
    private async Task TransitionAsync(string action)
    {
        if (Frozen || _transfer is null) return;
        _pendingPackage = _transfer.PackageId;
        _pendingTransition = new(Guid.NewGuid(), _transfer.ReviewToken, action);
        _pendingOrigin = Url; _pendingUrl = $"{Url}/{_pendingPackage}";
        await RetryAsync();
    }
    private async Task RetryAsync()
    {
        if (_busy || _pendingUrl is null || (_pendingPrepare is null && _pendingTransition is null)) return;
        var generation = _viewGeneration; var origin = _pendingOrigin;
        _busy = true; _message = null;
        Guid? refresh = null;
        try
        {
            using var response = _pendingPrepare is { } prepare ? await Http.PostAsJsonAsync(_pendingUrl, prepare)
                : await Http.PostAsJsonAsync(_pendingUrl, _pendingTransition);
            if (response.StatusCode is HttpStatusCode.Conflict or HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized or HttpStatusCode.NotFound or HttpStatusCode.BadRequest)
            {
                ClearPending(); ClearPresentation();
                if (generation != _viewGeneration || origin != Url) _opened = false;
                _message = L["MemoryTransferPanel.TheOperationWasNotAccepted"];
                return;
            }
            response.EnsureSuccessStatusCode();
            var result = await response.Content.ReadFromJsonAsync<MemoryTransferResult>() ?? throw new System.Text.Json.JsonException();
            if (result.ReceiptId == Guid.Empty || result.PackageId == Guid.Empty ||
                _pendingTransition is not null && result.PackageId != _pendingPackage ||
                result.Status is not ("PendingApproval" or "Approved" or "Applied" or "Rejected") ||
                result.Status == "Applied" && (result.AppliedEpisodeId is null || result.AppliedEpisodeId == Guid.Empty))
                throw new System.Text.Json.JsonException();
            ClearPending(); ClearPresentation();
            if (generation == _viewGeneration && origin == Url)
            {
                refresh = result.PackageId;
                _message = result.WasReplay ? "This operation was already recorded. Loading the current transfer." : "The operation was recorded.";
            }
            else
            {
                _opened = false;
                _message = L["MemoryTransferPanel.TheOperationForThePrevious"];
            }
        }
        catch (Exception e) when (NetworkError(e))
        { _message = L["MemoryTransferPanel.TheResultCouldNotBe"]; }
        finally { _busy = false; }
        if (refresh.HasValue)
        {
            await LoadTransferAsync(refresh.Value);
            if (generation == _viewGeneration && origin == Url) await LoadListAsync(false);
        }
    }
    private async Task LoadTransferAsync(Guid id)
    {
        if (Frozen) return;
        var generation = _viewGeneration; var activity = ++_activity; var url = Url;
        _busy = true; _transfer = null;
        try
        {
            using var response = await Http.GetAsync($"{url}/{id}");
            if (generation != _viewGeneration) return;
            if (!response.IsSuccessStatusCode) { _message = L["MemoryTransferPanel.ThisTransferIsUnavailableOr"]; return; }
            var transfer = await response.Content.ReadFromJsonAsync<MemoryTransferResponse>();
            if (generation != _viewGeneration) return;
            if (transfer is null || transfer.PackageId != id || transfer.TargetEmployeeId == Guid.Empty || transfer.ReviewToken?.Length != 64 ||
                transfer.Status is not ("PendingApproval" or "Approved" or "Applied" or "Rejected")) throw new System.Text.Json.JsonException();
            _transfer = transfer;
        }
        catch (Exception e) when (NetworkError(e)) { if (generation == _viewGeneration) _message = L["MemoryTransferPanel.TheReviewCouldNotBe"]; }
        finally { if (activity == _activity) _busy = false; }
    }
    private async Task LoadListAsync(bool more)
    {
        if (Frozen) return;
        var generation = _viewGeneration; var activity = ++_activity; var url = Url;
        _busy = true;
        if (!more) { _saved.Clear(); _nextCursor = null; }
        try
        {
            var page = await Http.GetFromJsonAsync<MemoryTransferPage>(url + (more && _nextCursor.HasValue ? $"?cursor={_nextCursor}" : ""));
            if (generation != _viewGeneration) return;
            if (page is not null) { _saved.AddRange(page.Items.Where(x => !_saved.Any(y => y.PackageId == x.PackageId))); _nextCursor = page.NextCursor; }
        }
        catch (Exception e) when (NetworkError(e)) { if (generation == _viewGeneration) { _saved.Clear(); _nextCursor = null; _message = L["MemoryTransferPanel.SavedTransfersCouldNotBe"]; } }
        finally { if (activity == _activity) _busy = false; }
    }
    private async Task TargetChangedAsync(Guid target)
    {
        if (Frozen) return;
        _target = target; _audiences = [];
        if (_items.Count == 0) _sourceAudience = null;
        if (target == Guid.Empty) return;
        var generation = _viewGeneration; var activity = ++_activity; var url = Url;
        _busy = true;
        try
        {
            var audiences = await Http.GetFromJsonAsync<MemoryTransferAudience[]>($"{url}/audiences?targetEmployeeId={target}") ?? [];
            if (generation != _viewGeneration || _target != target) return;
            if (audiences.Length > 129 || audiences.Any(x => x.AudienceId == Guid.Empty || x.Scope is not ("Team" or "Role")))
                throw new System.Text.Json.JsonException();
            _audiences = audiences;
        }
        catch (Exception e) when (NetworkError(e))
        { if (generation == _viewGeneration && _target == target) _message = L["MemoryTransferPanel.SharedAudiencesCouldNotBe"]; }
        finally { if (activity == _activity) _busy = false; }
    }
    private static bool NetworkError(Exception e) => e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException;
}
