@using CSweet.Contracts.Communications
@inject HttpClient Http
@inject IJSRuntime JS

@if (_submitted) { }
else
{
<div @ref="_dismissalElement" class="question-dismissal">
@if (Overview)
{
    <AttentionRequestCard Kind="Decision" EmployeeId="Question.AgentOrganizationUserId" Name="@Question.AgentName"
        Context="@Portraits?.FindRole(Question.AgentOrganizationUserId)" Prompt="@Question.Decision.Prompt" Status="Awaiting your response" RightAlignedActions="OpenEnded">
        <BodyContent>
            @if (OpenEnded)
            {
                <label class="direction-label">Your answer<textarea rows="4" maxlength="4000" disabled="@_busy" @bind="_direction" @bind:event="oninput"></textarea></label>
            }
        </BodyContent>
        <ChildContent>
        @if (OpenEnded)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_direction))" OnClick="SubmitAsync">@(_busy ? "Submitting…" : "Send response")</MudButton>
        }
        else
        {
        <MudMenu Label="@(_busy ? "Sending answer…" : "Choose an answer")" Variant="Variant.Filled" Color="Color.Primary"
                 EndIcon="@Icons.Material.Outlined.ExpandMore" Disabled="_busy" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            @foreach (var option in Question.Decision.Options)
            {
                @if (Question.Decision.AllowFreeText && option.Id == "provide-direction")
                {
                    <MudMenuItem Href="@ConversationHref"><strong>@option.Label</strong><div class="option-description">Continue in the conversation</div></MudMenuItem>
                }
                else
                {
                    <MudMenuItem Disabled="_busy" OnClick="() => AnswerOptionAsync(option.Id)">
                        <strong>@option.Label</strong>@if (option.Recommended) { <small>Recommended</small> }
                        @if (!string.IsNullOrWhiteSpace(option.Description)) { <div class="option-description">@option.Description</div> }
                    </MudMenuItem>
                }
            }
            @if (Question.Decision.AllowFreeText)
            {
                <MudDivider />
                <MudMenuItem Href="@ConversationHref" Icon="@Icons.Material.Outlined.ChatBubbleOutline">Something Else<div class="option-description">Continue in the conversation</div></MudMenuItem>
            }
        </MudMenu>
        }
        </ChildContent>
    </AttentionRequestCard>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_error</MudAlert> }
}
else
{
<article class="question-card" aria-label="@($"Question from {Question.AgentName}")">
    <details>
    <summary>
        <span class="question-meta"><strong>@Question.AgentName</strong><span class="question-date">@Question.Decision.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</span><span class="pending-label">Pending</span></span>
        <span class="question-prompt">@Question.Decision.Prompt</span>
        <span class="expand-label">Review & respond</span>
    </summary>
    <div class="question-response">
    <fieldset disabled="@_busy">
        <legend>Your response</legend>
        @foreach (var option in Question.Decision.Options)
        {
            <label><input type="radio" name="@Question.Decision.Id" checked="@(_selected == option.Id)" @onchange="() => Select(option.Id)" />
                <span><strong>@option.Label</strong> @if (option.Recommended) { <small>Recommended</small> }
                <span class="option-description">@option.Description</span></span></label>
        }
        @if (Question.Decision.AllowFreeText && !OpenEnded)
        {
            <label><input type="radio" name="@Question.Decision.Id" checked="@(_selected == Other)" @onchange="() => Select(Other)" /><span>Something else</span></label>
        }
        @if (NeedsText)
        {
            <label class="direction-label">@(OpenEnded ? "Your answer" : "Your direction")<textarea rows="4" maxlength="4000" @bind="_direction" @bind:event="oninput"></textarea></label>
        }
    </fieldset>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert> }
    <div class="response-actions">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Disabled="@(_busy || (!OpenEnded && _selected is null) || (NeedsText && string.IsNullOrWhiteSpace(_direction)))" OnClick="SubmitAsync">@(_busy ? "Submitting…" : "Send response")</MudButton>
        <MudButton Href="@($"/organizations/{OrganizationId}/communications/{Question.ConversationId}")" Size="Size.Small">View conversation</MudButton>
    </div>
    </div>
    </details>
</article>
}
</div>
}

@code {
    [CascadingParameter] public EmployeePortraits? Portraits { get; set; }
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public bool Overview { get; set; }
    [Parameter, EditorRequired] public PendingAgentQuestionResponse Question { get; set; } = default!;
    [Parameter] public EventCallback<Guid> Answered { get; set; }
    private const string Other = "__other__";
    private string? _selected, _direction, _error;
    private bool _busy, _submitted;
    private ElementReference _dismissalElement;
    private bool _answerConfirmed;
    private readonly string _answerKey = Guid.NewGuid().ToString("N");
    private bool OpenEnded => Question.Decision.AllowFreeText && Question.Decision.Options.Count == 0;
    private bool NeedsText => Question.Decision.AllowFreeText && (OpenEnded || _selected == Other || _selected == "provide-direction");
    private string ConversationHref => $"/organizations/{OrganizationId}/communications/{Question.ConversationId}";
    private async Task AnswerOptionAsync(string option)
    {
        if (_busy || _submitted || _answerConfirmed) return;
        Select(option);
        await SubmitAsync();
    }
    private void Select(string option) { _selected = option; _error = null; }
    private async Task SubmitAsync()
    {
        if (_busy || _submitted || _answerConfirmed || (!OpenEnded && _selected is null) || (NeedsText && string.IsNullOrWhiteSpace(_direction))) return;
        _busy = true; _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/organizations/{OrganizationId}/communications/hub/chats/{Question.ConversationId}/decisions/{Question.Decision.Id}/respond",
                new AnswerExecutiveDecisionRequest(NeedsText ? null : _selected, NeedsText ? _direction : null, _answerKey));
            var result = await response.Content.ReadFromJsonAsync<AnswerExecutiveDecisionResponse>();
            if (response.IsSuccessStatusCode && result?.Succeeded == true)
            {
                _answerConfirmed = true;
                try
                {
                    await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CSweet.UI/js/questionDismissal.js");
                    if (module is not null) await module.InvokeVoidAsync("dismiss", _dismissalElement);
                }
                catch (Exception ex) when (ex is JSException or OperationCanceledException or InvalidOperationException)
                {
                    // A confirmed answer still dismisses if browser animation is unavailable.
                }
                _submitted = true;
                await Answered.InvokeAsync(Question.Decision.Id);
            }
            else _error = result?.Message ?? "Could not send your response. Refresh to check whether this question is still pending.";
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        { _error = "Could not confirm your response. You can safely try again."; }
        finally { _busy = false; }
    }
}
