@using CSweet.Contracts.SourceControl
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IAppLocalizer L

<MudPaper Outlined="true" Class="pa-4 platform-setup-card">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
        <div>
            <MudText Typo="Typo.h6">@L["SourceControlPlatformSetupWizard.GitHubAppSetup"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @(Setup.Readiness.ExistingGitHubAvailable ? "GitHub app configured. Manage setup and permissions." : "Connect the repositories you want C-Sweet to work with.")
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Custom.Brands.GitHub"
                   OnClick="OpenAsync">@(Setup.Readiness.ExistingGitHubAvailable ? "Manage GitHub setup" : "Set up GitHub")</MudButton>
    </MudStack>
</MudPaper>

<MudDialog @bind-Visible="_open" Options="_options">
    <TitleContent><MudText Typo="Typo.h6">@L["SourceControlPlatformSetupWizard.SetUpGitHub"]</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="github-wizard" aria-live="polite">
            @if (_working)
            {
                <MudProgressLinear Indeterminate="true" />
                <MudText>@L["SourceControlPlatformSetupWizard.PreparingYourGitHubConnection"]</MudText>
            }
            @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
            @if (_flow?.Setup.Readiness.ExistingGitHubAvailable == true && !Pending && !_choosingOptions)
            {
                <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.h5">@L["SourceControlPlatformSetupWizard.GitHubIsReady"]</MudText>
                <MudText>@L["SourceControlPlatformSetupWizard.ConnectAGitHubAccountFrom"]</MudText>
                @if ((BusinessId ?? _returnBusinessId) is { } businessId)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/organizations/{businessId:D}/source-control?connectGitHub=true&allowRepositoryCreation={_allowCreation.ToString().ToLowerInvariant()}")">@L["SourceControlPlatformSetupWizard.ConnectGitHubAccount"]</MudButton>
                }
            }
            else if (_manifest is not null)
            {
                <MudText Typo="Typo.h5">@(Step == "provisioner-review" ? "Approve repository creation" : "Approve repository access")</MudText>
                <MudText>@L["SourceControlPlatformSetupWizard.ContinueOnGitHubToApprove"]</MudText>
                <form @ref="_manifestForm" action="@_manifest.PostUrl" method="post">
                    <input type="hidden" name="manifest" value="@_manifest.ManifestJson" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">@L["SourceControlPlatformSetupWizard.ContinueToGitHub"]</MudButton>
                </form>
            }
            else if (Step is "source-access-confirm" or "provisioner-confirm" or "review-activate" or "capabilities")
            {
                <MudText>@L["SourceControlPlatformSetupWizard.FinishVerifyingYourGitHubSetup"]</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_working" OnClick="FinishAsync">@(_error is null ? "Finish setup" : "Retry")</MudButton>
            }
            else
            {
                <MudText Typo="Typo.h5">@L["SourceControlPlatformSetupWizard.ConnectGitHubToCSweet"]</MudText>
                <MudText Typo="Typo.body2">@L["SourceControlPlatformSetupWizard.ChooseWhatCSweetCan"]</MudText>
                <MudCheckBox T="bool" @bind-Value="_allowCreation" Label="@L["SourceControlPlatformSetupWizard.AllowCSweetToCreate"]"
                             Disabled="@(_working || Pending)" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SourceControlPlatformSetupWizard.OptionalRequiresApprovalOfAn"]</MudText>
                <MudText Typo="Typo.body2">@(_useOrganization ? "The app will be owned by this organization." : "The app will be owned by your signed-in personal GitHub account.")</MudText>
                <MudCheckBox T="bool" @bind-Value="_useOrganization" Label="@L["SourceControlPlatformSetupWizard.UseAnOrganizationInstead"]"
                             Disabled="@(_working || Setup.Readiness.ExistingGitHubAvailable || (Pending && Step != "organization"))" />
                @if (_useOrganization)
                {
                    <MudTextField Label="@L["SourceControlPlatformSetupWizard.GitHubOrganization"]" @bind-Value="_organization" Immediate="true"
                                  Variant="Variant.Outlined" Disabled="@(_working || Setup.Readiness.ExistingGitHubAvailable || (Pending && Step != "organization"))" HelperText="@L["SourceControlPlatformSetupWizard.UseAnOrganizationWhereYou"]" />
                }
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @((Step == "provisioner-review") ? "This enables repository creation and configuration." : "This enables reading code, pushing branches, and managing pull requests in repositories you select later.")
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Custom.Brands.GitHub"
                           Disabled="@(_working || (_useOrganization && string.IsNullOrWhiteSpace(_organization)))" OnClick="ContinueAsync">@L["SourceControlPlatformSetupWizard.ContinueToGitHub"]</MudButton>
            }
            <MudExpansionPanels Elevation="0">
                <MudExpansionPanel Text="@L["SourceControlPlatformSetupWizard.AdvancedSetup"]">
                    @if (Pending)
                    {
                        <MudText Typo="Typo.body2">@L["SourceControlPlatformSetupWizard.DiscardingSetupRemovesPendingCredentials"]</MudText>
                        <MudButton Color="Color.Error" Disabled="_working" OnClick="DiscardAsync" Class="mb-3">@L["SourceControlPlatformSetupWizard.DiscardSetup"]</MudButton>
                    }
                    <SourceControlConfigurationInstructions AppKind="source" DefaultTabIndex="@DefaultConfigurationTab" />
                    <MudDivider Class="my-4" />
                    <SourceControlConfigurationInstructions AppKind="provisioner" DefaultTabIndex="@DefaultConfigurationTab" />
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudStack>
    </DialogContent>
    <DialogActions><MudButton Disabled="_working" OnClick="Close">@(Pending ? "Close — resume later" : Setup.Readiness.ExistingGitHubAvailable ? "Done" : "Close")</MudButton></DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public PlatformSourceControlSetupResponse Setup { get; set; } = default!;
    [Parameter] public EventCallback<PlatformSourceControlSetupResponse> SetupChanged { get; set; }
    [Parameter] public Guid? BusinessId { get; set; }
    [Parameter] public bool AllowRepositoryCreation { get; set; }
    private readonly DialogOptions _options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false };
    private GitHubPlatformWizardFlow? _flow;
    private bool _open, _working, _initialized, _submitManifest, _finishPending, _businessRestored;
    private string _organization = string.Empty;
    private bool _useOrganization, _allowCreation, _choosingOptions;
    private string? _error;
    private PlatformGitHubManifestLaunchResponse? _manifest;
    private ElementReference _manifestForm;
    private Guid? _returnBusinessId;
    private string? Step => _flow?.Setup.Session?.CurrentStep;
    private bool Pending => GitHubPlatformWizardFlow.IsPending(_flow?.Setup ?? Setup);
    private int DefaultConfigurationTab => Uri.TryCreate(Navigation.BaseUri, UriKind.Absolute, out var uri) && uri.IsLoopback ? 0 : 1;

    protected override void OnParametersSet()
    {
        if (_working) return;
        _flow = new GitHubPlatformWizardFlow(Http, Setup, PublishAsync);
        _organization = Setup.Session?.GitHubOrganization ?? _organization;
        if (!_initialized)
        {
            _initialized = true;
            _useOrganization = !string.IsNullOrWhiteSpace(Setup.Session?.GitHubOrganization);
            _allowCreation = Pending ? Setup.Session?.ProvisionerRequested == true : AllowRepositoryCreation;
            _error = Setup.Session?.LastError;
            if (Pending)
            {
                _open = true;
                if (Step is "source-access-confirm" or "provisioner-confirm" or "review-activate" or "capabilities")
                    _finishPending = true;
            }
            else if (BusinessId is not null)
            {
                _open = true;
                _choosingOptions = true;
            }
        }
    }

    private Task OpenAsync()
    {
        if (_manifest?.ExpiresAt <= DateTimeOffset.UtcNow) _manifest = null;
        _open = true;
        _choosingOptions = !Pending;
        if (!Pending) _allowCreation = AllowRepositoryCreation;
        return Task.CompletedTask;
    }
    private void Close() => _open = false;
    private Task PublishAsync(PlatformSourceControlSetupResponse setup)
    {
        Setup = setup;
        return SetupChanged.InvokeAsync(setup);
    }
    private Task ContinueAsync() => WorkAsync(async () =>
    {
        if (!Pending && Setup.Readiness.ExistingGitHubAvailable && (!_allowCreation || Setup.Readiness.ManagedGitHubAvailable))
        {
            _choosingOptions = false;
            return;
        }
        _manifest = await _flow!.PrepareAsync(Navigation.BaseUri.TrimEnd('/'), _useOrganization ? _organization : null, _allowCreation);
        _choosingOptions = false;
        _submitManifest = true;
    });
    private Task FinishAsync() => WorkAsync(async () =>
    {
        _manifest = await _flow!.FinishAsync();
        _submitManifest = _manifest is not null;
    });
    private Task DiscardAsync() => WorkAsync(async () =>
    {
        await _flow!.CancelAsync();
        _manifest = null;
    });
    private async Task WorkAsync(Func<Task> action)
    {
        if (_working) return;
        _working = true; _error = null;
        try { await action(); }
        catch (Exception exception) { _error = exception.Message; }
        finally { _working = false; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Complete callbacks only after the dialog is interactive, never during prerender.
        if (_finishPending)
        {
            _finishPending = false;
            await FinishAsync();
            StateHasChanged();
            return;
        }
        if (!_submitManifest && _businessRestored) return;
        var submit = _submitManifest;
        _submitManifest = false;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CSweet.UI/githubWizard.js");
            try
            {
                if (!_businessRestored)
                {
                    var storedBusiness = await module.InvokeAsync<string?>("takeBusinessId");
                    _businessRestored = true;
                    if (Guid.TryParse(storedBusiness, out var businessId))
                    {
                        _returnBusinessId = businessId;
                        StateHasChanged();
                    }
                }
                if (submit) await module.InvokeVoidAsync("submitManifest", _manifestForm, (BusinessId ?? _returnBusinessId)?.ToString("D"));
            }
            finally { await module.DisposeAsync(); }
        }
        catch (JSException) { /* The visible submit button remains a usable fallback. */ }
    }
}
