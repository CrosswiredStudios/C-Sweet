@inject ISetupApiClient SetupApi
@inject NavigationManager Navigation
@inject ExecutionCapacityAlertState CapacityState
@implements IAsyncDisposable

@if (CapacityState.Status != ExecutionCapacityAlertStatus.Hidden)
{
    <MudAlert Severity="@(IsConnecting ? Severity.Info : Severity.Error)" Variant="Variant.Filled" Class="execution-capacity-alert" aria-live="polite">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width: 100%; gap: 1rem; flex-wrap: wrap">
            <div>
                @if (IsConnecting)
                {
                    <strong>Waiting for Office to become ready.</strong>
                    <div>Office may still be starting or reconnecting. This status updates automatically when agent execution is ready.</div>
                }
                else
                {
                    <strong>Agent execution capacity is unavailable.</strong>
                    <div>Office is not ready to run builds or agents. Open Offices to check connection status and resolve any issues.</div>
                }
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Inherit"
                       StartIcon="@Icons.Material.Filled.Dns"
                       OnClick="OpenFleet">Open Offices</MudButton>
        </MudStack>
    </MudAlert>
}

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private bool IsConnecting => CapacityState.Status == ExecutionCapacityAlertStatus.Connecting;

    protected override async Task OnInitializedAsync()
    {
        var lifetimeToken = _lifetime.Token;
        await RefreshAsync(lifetimeToken);
        if (!lifetimeToken.IsCancellationRequested)
        {
            _ = PollAsync(lifetimeToken);
        }
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshAsync(cancellationToken);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private async Task RefreshAsync(CancellationToken cancellationToken)
    {
        try
        {
            var setup = await SetupApi.GetStatusAsync(cancellationToken);
            if (setup.IsFirstRunComplete)
            {
                var capacity = await SetupApi.GetExecutionCapacityStatusAsync(cancellationToken);
                CapacityState.Update(capacity, DateTimeOffset.UtcNow);
            }
            else
            {
                CapacityState.Hide();
            }
        }
        catch
        {
            // Connectivity errors are surfaced by individual pages; do not misreport them as fleet loss.
            CapacityState.Hide();
        }
    }

    private void OpenFleet() => Navigation.NavigateTo("/settings/offices");

    public ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
        return ValueTask.CompletedTask;
    }
}
