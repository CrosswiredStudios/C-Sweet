@using CSweet.Contracts.Core
@using System.Text.Json
@inject HttpClient Http
@inject IAppLocalizer L

<article class="project-approval @(Compact ? "compact" : "")" aria-label="@L["ProjectCreationApprovalCard.ProjectCreationApproval"]">
    <div class="review-body">
        <header>
            <span class="request-kind">@L["ProjectCreationApprovalCard.NewProject"]</span>
            <span class="status">@StatusLabel</span>
        </header>
        <h2>@Item.Title</h2>
        <p class="requester">@Item.RequestedBy · @Item.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</p>
        @if (Item.ProjectCreation is { } project)
        {
            <p class="outcome">@project.Outcome</p>
            @if (!Compact && !string.IsNullOrWhiteSpace(project.Rationale))
            {
                <p class="rationale"><strong>@L["ProjectCreationApprovalCard.WhyThisProject"]</strong> @project.Rationale</p>
            }
            <dl class="facts">
                <div><dt>@L["ProjectCreationApprovalCard.ProjectLead"]</dt><dd>@project.Lead</dd></div>
                <div><dt>@L["ProjectCreationApprovalCard.ProposedBudget"]</dt><dd>@Budget(project)</dd></div>
                @if (!Compact) { <div><dt>@L["ProjectCreationApprovalCard.ExternalDateConstraint"]</dt><dd>@(project.TargetDate?.ToLocalTime().ToString("MMM d, yyyy") ?? "Not specified")</dd></div> }
            </dl>
            @if (!Compact)
            {
                <section class="approval-scope">
                    <h3>@L["ProjectCreationApprovalCard.WhatYouReApproving"]</h3>
                    <ul>
                        <li>Create @project.Name in the @project.Stage phase@(project.CreatesBoard ? " with a project work board" : "").</li>
                        <li>Assign @project.Lead as project lead@(project.Team is not null ? $" and link {project.Team}" : "").</li>
                        <li>@L["ProjectCreationApprovalCard.SaveTheProposedBudgetMilestones"]</li>
                    </ul>
                    <p><strong>@L["ProjectCreationApprovalCard.AgentCan"]</strong> @List(project.AgentPermissions, "No delegated actions specified")</p>
                    <p><strong>@L["ProjectCreationApprovalCard.ComesBackForHumanApproval"]</strong> @List(project.HumanDecisions, "No additional decision categories specified")</p>
                </section>
                <details>
                    <summary>Plan &amp; success criteria</summary>
                    <h3>@L["ProjectCreationApprovalCard.SuccessCriteria"]</h3>
                    @if (project.SuccessCriteria.Count == 0) { <p>@L["ProjectCreationApprovalCard.NotSpecified"]</p> }
                    <ul>@foreach (var criterion in project.SuccessCriteria) { <li>@criterion</li> }</ul>
                    <h3>@L["ProjectCreationApprovalCard.Milestones"]</h3>
                    @if (project.Milestones.Count == 0) { <p>@L["ProjectCreationApprovalCard.NoMilestonesProposed"]</p> }
                    @foreach (var milestone in project.Milestones)
                    {
                        <div class="milestone"><strong>@milestone.Name</strong><span>@milestone.Stage · @(milestone.TargetDate?.ToLocalTime().ToString("MMM d, yyyy") ?? "Date not specified")</span>
                            @if (milestone.RequiredEvidence.Count > 0) { <span>Evidence: @List(milestone.RequiredEvidence)</span> }
                            @if (milestone.Reviewers.Count > 0) { <span>Reviewers: @List(milestone.Reviewers)</span> }
                        </div>
                    }
                </details>
                <details>
                    <summary>Team &amp; operating limits</summary>
                    <dl class="limits">
                        <dt>@L["ProjectCreationApprovalCard.Team"]</dt><dd>@(project.Team ?? "Not assigned")</dd>
                        <dt>@L["ProjectCreationApprovalCard.Supervision"]</dt><dd>@List(project.Supervisors)</dd>
                        <dt>@L["ProjectCreationApprovalCard.AuthorizedStaffingRoles"]</dt><dd>@List(project.StaffingRoles)</dd>
                        <dt>@L["ProjectCreationApprovalCard.BudgetVarianceAllowance"]</dt><dd>@(project.BudgetVariance?.ToString("P0") ?? "Not specified")</dd>
                        <dt>@L["ProjectCreationApprovalCard.ScheduleVarianceAllowance"]</dt><dd>@(project.ScheduleVarianceDays is { } days ? $"{days} days" : "Not specified")</dd>
                        <dt>@L["ProjectCreationApprovalCard.AuthorityExpires"]</dt><dd>@(project.AuthorityExpiresAt?.ToLocalTime().ToString("g") ?? "No expiry specified")</dd>
                    </dl>
                    <p class="help">Staffing roles describe permitted roles; they do not confirm that those employees have been hired.</p>
                </details>
                @if (project.Documents.Count > 0)
                {
                    <details><summary>Supporting documents (@project.Documents.Count)</summary>
                        @foreach (var document in project.Documents) { <p><MudLink Href="@document.Uri">@document.Name</MudLink> · @document.Revision</p> }
                    </details>
                }
            }
            else
            {
                <p class="help">@L["ProjectCreationApprovalCard.CreatesTheProjectAssignsIts"]</p>
            }
        }
        @if (Item.ReviewError is not null) { <MudAlert Severity="Severity.Warning">@Item.ReviewError</MudAlert> }
        @if (!string.IsNullOrWhiteSpace(Item.DecisionComment)) { <p class="decision-note"><strong>@L["ProjectCreationApprovalCard.DecisionFeedback"]</strong> @Item.DecisionComment</p> }
        @if (Item.DecidedAt.HasValue) { <p class="help">@StatusLabel @(Item.ActualDecisionMaker is not null ? $"by {Item.ActualDecisionMaker}" : "") · @Item.DecidedAt.Value.ToLocalTime().ToString("g")</p> }
    </div>
    <footer>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert> }
        @if (CanInteract && Item.CanDecide && Item.Status == "Pending" && Item.ProjectCreation is not null)
        {
            @if (_editing is not null)
            {
                <MudTextField T="string" @bind-Value="_feedback" Label="@(_editing == ResourceChangeDecisionKinds.RequestRevision ? "What should change?" : "Reason (optional)")"
                    Lines="3" MaxLength="4000" Variant="Variant.Outlined" Class="mb-3" Disabled="_busy" />
                <div class="actions">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="@(() => DecideAsync(_editing))">@(_editing == ResourceChangeDecisionKinds.RequestRevision ? "Send change request" : "Deny project")</MudButton>
                    <MudButton Disabled="_busy" OnClick="@(() => _editing = null)">@L["Common.Cancel"]</MudButton>
                </div>
            }
            else
            {
                <div class="actions">
                    <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="_busy" OnClick="@(() => DecideAsync(ResourceChangeDecisionKinds.Approve))">@(Compact ? "Approve" : "Approve project")</MudButton>
                    @if (Compact) { <MudButton Href="@MoreInfoUri" Variant="Variant.Outlined">@L["ProjectCreationApprovalCard.MoreInfo"]</MudButton> }
                    else { <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="@(() => _editing = ResourceChangeDecisionKinds.RequestRevision)">@L["ProjectCreationApprovalCard.RequestChanges"]</MudButton> }
                    <MudButton Color="Color.Error" Disabled="_busy" OnClick="@(() => _editing = ResourceChangeDecisionKinds.Reject)">@(Compact ? "Deny" : "Decline")</MudButton>
                </div>
                @if (!Compact) { <p class="help">@L["ProjectCreationApprovalCard.ApprovalAppliesToThisProposal"]</p> }
            }
        }
        else if (Compact) { <MudButton Href="@MoreInfoUri" Variant="Variant.Outlined">@L["ProjectCreationApprovalCard.MoreInfo"]</MudButton> }
        @if (Item.CreatedProjectId is { } projectId)
        {
            <MudButton Href="@($"/organizations/{OrganizationId:D}/projects/{projectId:D}")" Color="Color.Primary">@L["ProjectCreationApprovalCard.ViewProject"]</MudButton>
        }
        @if (!Compact && Item.AgentAction is { } action)
        {
            <details class="technical"><summary>@L["ProjectCreationApprovalCard.TechnicalDetails"]</summary><p>@L["ProjectCreationApprovalCard.ActionWorkstreamCreateV2"]</p><p>Channel: @action.ChannelId</p><p>@L["ProjectCreationApprovalCard.PayloadBinding"] <code>@action.PayloadHash</code></p></details>
        }
    </footer>
</article>

@code {
    [Parameter, EditorRequired] public ApprovalDashboardItemResponse Item { get; set; } = default!;
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool CanInteract { get; set; } = true;
    [Parameter] public EventCallback<string> DecisionCompleted { get; set; }
    private string? _editing, _error;
    private string _feedback = "";
    private bool _busy;
    private string MoreInfoUri => $"/organizations/{OrganizationId:D}/approvals?approvalId={Item.Id:D}";
    private string StatusLabel => Item.DecisionKind == ResourceChangeDecisionKinds.RequestRevision ? "Changes requested" : Item.Status switch
    { "Pending" => "Needs your approval", "Approved" => Item.CreatedProjectId.HasValue ? "Project created" : "Approved", "Rejected" => "Declined", _ => Item.Status };
    private static string Budget(ProjectCreationApprovalResponse p) => p.Budget is { } amount ? $"{amount:N2} {p.Currency ?? "(currency not specified)"}" : "Not specified";
    private static string List(IReadOnlyList<string> items, string empty = "Not specified") => items.Count == 0 ? empty : string.Join(", ", items);
    private async Task DecideAsync(string? decision)
    {
        if (_busy || decision is null || !CanInteract || !Item.CanDecide || Item.Status != "Pending" || Item.AgentAction is not { } action) return;
        if (decision == ResourceChangeDecisionKinds.RequestRevision && string.IsNullOrWhiteSpace(_feedback)) { _error = L["ProjectCreationApprovalCard.DescribeWhatShouldChangeBefore"]; return; }
        _busy = true; _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync($"api/core/organizations/{OrganizationId:D}/approvals/agent-actions/{Item.Id:D}/decide",
                new DecideManagedAgentActionRequest(Item.Id, decision, _feedback, action.PayloadHash, action.ExpectedRevision,
                    action.IdempotencyKey, $"project-review:{Item.Id:N}:{decision}", action.ResourceId));
            if (!response.IsSuccessStatusCode)
            {
                _error = L["ProjectCreationApprovalCard.TheDecisionCouldNotBe"];
                try { using var problem = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
                    if (problem.RootElement.TryGetProperty("message", out var message)) _error = message.GetString() ?? _error; }
                catch (JsonException) { }
                await DecisionCompleted.InvokeAsync("");
                return;
            }
            _editing = null;
            await DecisionCompleted.InvokeAsync(decision == ResourceChangeDecisionKinds.Approve ? $"{Item.ProjectCreation?.Name ?? "Project"} created."
                : decision == ResourceChangeDecisionKinds.RequestRevision ? "Changes requested. Your feedback was saved." : "Project declined.");
        }
        catch (HttpRequestException) { _error = L["ProjectCreationApprovalCard.TheResultCouldNotBe"]; }
        finally { _busy = false; }
    }
}
