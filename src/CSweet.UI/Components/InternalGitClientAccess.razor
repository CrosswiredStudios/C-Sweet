@using CSweet.Contracts.SourceControl
@inject HttpClient Http

<MudExpansionPanels><MudExpansionPanel Text="Git client access">
    <MudStack Spacing="2">
        @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
        @if (_access is not null)
        {
            <MudText>Clone URL</MudText><MudTextField Value="_access.CloneUrl" ReadOnly="true" />
            <MudText>Use username <code>csweet</code> and an access token as the password in your Git client's credential manager. Tokens are shown once and expire automatically.</MudText>
            <MudTextField @bind-Value="_name" Label="Credential name" Disabled="_busy" />
            <MudNumericField T="int" @bind-Value="_days" Min="1" Max="90" Label="Lifetime in days" Disabled="_busy" />
            @if (CanManage)
            {
                <MudCheckBox @bind-Value="_push" Label="Allow pushes" Disabled="_busy" />
                @if (_push) { <MudCheckBox @bind-Value="_defaultBranch" Label="Allow direct writes to the default branch" Disabled="_busy" /> }
                <MudText Color="Color.Secondary">Active agent branches stay protected. Force updates to existing branches are rejected.</MudText>
            }
            <MudButton OnClick="CreateAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_name))">Create access token</MudButton>
            @if (_token is not null)
            {
                <MudAlert Severity="Severity.Info">Save this token now. It cannot be displayed again.</MudAlert>
                <MudTextField Value="_token" ReadOnly="true" Label="New access token" />
                <MudButton OnClick="@(() => _token = null)">Hide token</MudButton>
            }
            @foreach (var credential in _access.Credentials)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText>@credential.Name · @(credential.CanPush ? "read and push" : "read only") · expires @credential.ExpiresAt.ToLocalTime().ToString("g") @(credential.Revoked ? "· revoked" : "")</MudText>
                    @if (!credential.Revoked) { <MudButton Color="Color.Error" Disabled="_busy" OnClick="@(() => RevokeAsync(credential.Id))">Revoke</MudButton> }
                </MudStack>
            }
        }
    </MudStack>
</MudExpansionPanel></MudExpansionPanels>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid RepositoryId { get; set; }
    [Parameter] public bool CanManage { get; set; }
    private InternalGitAccessList? _access;
    private bool _push, _defaultBranch, _busy;
    private int _days = 30;
    private string _name = "";
    private string? _token, _error;
    private string Endpoint => $"api/organizations/{OrganizationId:D}/source-control/internal/repositories/{RepositoryId:D}/access";
    protected override async Task OnParametersSetAsync() { _token = null; await RunAsync(LoadAsync); }
    private async Task LoadAsync() => _access = await Http.GetFromJsonAsync<InternalGitAccessList>(Endpoint);
    private async Task CreateAsync() => await RunAsync(async () =>
    {
        using var response = await Http.PostAsJsonAsync(Endpoint, new CreateInternalGitAccessRequest(_name, CanManage && _push, CanManage && _push && _defaultBranch, _days));
        await CheckAsync(response);
        _token = (await response.Content.ReadFromJsonAsync<CreatedInternalGitAccess>())!.Token;
        await LoadAsync();
    });
    private async Task RevokeAsync(Guid id) => await RunAsync(async () =>
    { using var response = await Http.DeleteAsync($"{Endpoint}/{id:D}"); await CheckAsync(response); _token = null; await LoadAsync(); });
    private static async Task CheckAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode) return;
        var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
        throw new InvalidOperationException(body.TryGetProperty("message", out var message) ? message.GetString() : "Credential operation failed.");
    }
    private async Task RunAsync(Func<Task> action)
    { _busy = true; _error = null; try { await action(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
}
