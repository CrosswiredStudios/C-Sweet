@using CSweet.Contracts.Memory
@using System.Net
@inject HttpClient Http
@inject IAppLocalizer L

<MudDivider Class="my-3" />
<MudText Typo="Typo.subtitle2">@L["MemorySuppressionPanel.SuppressThisMemorySource"]</MudText>
@if (_review is null)
{
    <MudButton OnClick="LoadAsync" Disabled="Locked">@L["MemorySuppressionPanel.ReviewSuppression"]</MudButton>
}
else
{
    <MudText style="white-space:pre-wrap">@_review.Content</MudText>
    @if (_review.IsSuppressed)
    { <MudAlert Severity="Severity.Info">@L["MemorySuppressionPanel.ThisSourceIsAlreadySuppressed"]</MudAlert> }
    else
    {
        <MudAlert Severity="Severity.Warning">@L["MemorySuppressionPanel.SuppressingPreventsRecallOfThis"]</MudAlert>
        @if (_review.LegalHold)
        { <MudText Typo="Typo.caption">@L["MemorySuppressionPanel.TheLegalHoldRemainsIn"]</MudText> }
        <MudButton OnClick="SubmitAsync" Disabled="Locked" Color="Color.Warning">@L["MemorySuppressionPanel.SuppressSource"]</MudButton>
    }
    <MudButton OnClick="LoadAsync" Disabled="Locked">@L["MemorySuppressionPanel.RefreshReview"]</MudButton>
}
@if (_pending is not null)
{ <MudButton OnClick="RetryAsync" Disabled="_busy">@L["MemorySuppressionPanel.RetryTheSameSuppression"]</MudButton> }
@if (_message is not null) { <MudAlert Severity="Severity.Info">@_message</MudAlert> }

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid EmployeeId { get; set; }
    [Parameter] public Guid EpisodeId { get; set; }
    [Parameter] public EventCallback<Guid> Reviewed { get; set; }
    [Parameter] public EventCallback<bool> LockedChanged { get; set; }
    private string Url => $"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/memory/episodes/{EpisodeId}/suppression";
    private MemorySuppressionPreview? _review;
    private SuppressMemorySourceRequest? _pending;
    private bool _busy;
    private bool Locked => _busy || _pending is not null;
    private string? _message;

    private async Task LoadAsync()
    {
        if (Locked) return;
        _busy = true; _review = null; _message = null; await LockedChanged.InvokeAsync(true);
        try
        {
            using var response = await Http.GetAsync(Url);
            if (!response.IsSuccessStatusCode) { _message = L["MemorySuppressionPanel.ThisEpisodeIsUnavailableFor"]; return; }
            _review = await response.Content.ReadFromJsonAsync<MemorySuppressionPreview>();
        }
        catch (Exception error) when (NetworkError(error)) { _message = L["MemorySuppressionPanel.ReviewDetailsCouldNotBe"]; }
        finally { _busy = false; await LockedChanged.InvokeAsync(Locked); }
    }
    private async Task SubmitAsync()
    {
        if (Locked || _review is null || _review.IsSuppressed) return;
        _pending = new(Guid.NewGuid(), _review.Revision, _review.EvidenceToken);
        await RetryAsync();
    }
    private async Task RetryAsync()
    {
        if (_busy || _pending is null) return;
        _busy = true; _message = null; await LockedChanged.InvokeAsync(true);
        Guid? updated = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(Url, _pending);
            if (response.StatusCode is HttpStatusCode.Conflict or HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized or HttpStatusCode.NotFound or HttpStatusCode.BadRequest)
            {
                _pending = null; _review = null;
                _message = L["MemorySuppressionPanel.TheReviewWasNotAccepted"];
                return;
            }
            response.EnsureSuccessStatusCode();
            var result = await response.Content.ReadFromJsonAsync<SuppressMemorySourceResponse>() ?? throw new System.Text.Json.JsonException();
            _pending = null; _review = null; updated = result.EpisodeId;
            _message = result.WasReplay ? "This suppression was already recorded." : "This source and dependent memories are now suppressed.";
        }
        catch (Exception error) when (NetworkError(error))
        { _message = L["MemorySuppressionPanel.TheResultCouldNotBe"]; }
        finally { _busy = false; await LockedChanged.InvokeAsync(Locked); }
        if (updated.HasValue)
        {
            try { await Reviewed.InvokeAsync(updated.Value); }
            catch (Exception error) when (NetworkError(error)) { _message = L["MemorySuppressionPanel.TheReviewWasRecordedReload"]; }
        }
    }
    private static bool NetworkError(Exception error) => error is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException;
}
