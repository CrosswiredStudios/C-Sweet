@using CSweet.Contracts.Memory
@using System.Net
@inject HttpClient Http
@inject IAppLocalizer L

<MudDivider Class="my-3" />
<MudText Typo="Typo.subtitle2">@L["MemoryProcedureReviewPanel.ReviewThisProcedure"]</MudText>
@if (_review is null)
{
    <MudButton OnClick="LoadAsync" Disabled="_busy">@L["MemoryProcedureReviewPanel.CheckReviewAccess"]</MudButton>
}
else
{
    <MudText>@_review.Name · Version @_review.Version</MudText>
    <MudText style="white-space:pre-wrap">@_review.Procedure</MudText>
    <MudText>Applies when: @(_review.Applicability ?? "No applicability recorded")</MudText>
    <MudText Typo="Typo.caption">@_review.Confirmation · @_review.Sensitivity · @_review.SourceEpisodeIds.Count source records</MudText>
    @foreach (var source in _review.SourceEpisodeIds.Take(20).Select((id, index) => (Id: id, Number: index + 1)))
    {
        <MudButton OnClick="@(() => InspectSource.InvokeAsync(source.Id))" Disabled="Locked">Inspect source @source.Number</MudButton>
    }
    @if (_review.SourceEpisodeIds.Count > 20)
    { <MudText Typo="Typo.caption">Showing the first 20 source links. The review checks all @_review.SourceEpisodeIds.Count sources.</MudText> }
    @if (!_review.CanConfirm)
    { <MudAlert Severity="Severity.Warning">@L["MemoryProcedureReviewPanel.ThisProcedureOrItsEvidence"]</MudAlert> }
    <MudStack Row="true" Class="my-2">
        <MudButton OnClick='@(() => SubmitAsync("confirm"))' Disabled='@(Locked || !_review.CanConfirm || _review.Confirmation == "Confirmed")' Color="Color.Primary">@L["MemoryProcedureReviewPanel.ConfirmProcedure"]</MudButton>
        <MudButton OnClick='@(() => SubmitAsync("reject"))' Disabled='@(Locked || !_review.CanReject || _review.Confirmation == "Rejected")' Color="Color.Error">@L["MemoryProcedureReviewPanel.RejectProcedure"]</MudButton>
        <MudButton OnClick="LoadAsync" Disabled="Locked">@L["MemoryProcedureReviewPanel.RefreshReview"]</MudButton>
    </MudStack>
    @if (_review.CanCorrect)
    {
        <MudTextField T="string" Label="@L["MemoryProcedureReviewPanel.ProcedureName"]" @bind-Value="_name" MaxLength="200" Disabled="Locked" />
        <MudTextField T="string" Label="@L["MemoryProcedureReviewPanel.CorrectedProcedure"]" @bind-Value="_procedure" MaxLength="16000" Lines="4" Disabled="Locked" />
        <MudTextField T="string" Label="@L["MemoryProcedureReviewPanel.AppliesWhen"]" @bind-Value="_applicability" MaxLength="4000" Lines="2" Disabled="Locked" />
        <MudButton OnClick='@(() => SubmitAsync("correct"))' Disabled="@(Locked || string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_procedure))">@L["MemoryProcedureReviewPanel.SaveNewVersion"]</MudButton>
    }
}
@if (_pending is not null)
{ <MudButton OnClick="RetryAsync" Disabled="_busy">@L["MemoryProcedureReviewPanel.RetryTheSameReview"]</MudButton> }
@if (_message is not null) { <MudAlert Severity="Severity.Info">@_message</MudAlert> }

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid EmployeeId { get; set; }
    [Parameter] public Guid ProcedureId { get; set; }
    [Parameter] public EventCallback<Guid> Reviewed { get; set; }
    [Parameter] public EventCallback<Guid> InspectSource { get; set; }
    [Parameter] public EventCallback<bool> LockedChanged { get; set; }
    private string Url => $"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/memory/procedures/{ProcedureId}/review";
    private MemoryProcedureReviewResponse? _review;
    private ReviewMemoryProcedureRequest? _pending;
    private bool _busy;
    private bool Locked => _busy || _pending is not null;
    private string _name = "", _procedure = "";
    private string? _applicability, _message;

    private async Task LoadAsync()
    {
        if (Locked) return;
        _busy = true; _review = null; _message = null; await LockedChanged.InvokeAsync(true);
        try
        {
            using var response = await Http.GetAsync(Url);
            if (!response.IsSuccessStatusCode) { _message = L["MemoryProcedureReviewPanel.ThisProcedureIsUnavailableFor"]; return; }
            _review = await response.Content.ReadFromJsonAsync<MemoryProcedureReviewResponse>();
            if (_review is not null) { _name = _review.Name; _procedure = _review.Procedure; _applicability = _review.Applicability; }
        }
        catch (Exception error) when (NetworkError(error)) { _message = L["MemoryProcedureReviewPanel.ReviewDetailsCouldNotBe"]; }
        finally { _busy = false; await LockedChanged.InvokeAsync(Locked); }
    }
    private async Task SubmitAsync(string action)
    {
        if (Locked || _review is null) return;
        _pending = new(Guid.NewGuid(), _review.Revision, _review.EvidenceToken, action,
            action == "correct" ? new(_name, _procedure, _applicability) : null);
        await RetryAsync();
    }
    private async Task RetryAsync()
    {
        if (_busy || _pending is null) return;
        _busy = true; _message = null; await LockedChanged.InvokeAsync(true);
        Guid? updated = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(Url, _pending);
            if (response.StatusCode is HttpStatusCode.Conflict or HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized or HttpStatusCode.NotFound or HttpStatusCode.BadRequest)
            {
                _pending = null; _review = null;
                _message = L["MemoryProcedureReviewPanel.TheReviewWasNotAccepted"];
                return;
            }
            response.EnsureSuccessStatusCode();
            var result = await response.Content.ReadFromJsonAsync<ReviewMemoryProcedureResponse>() ?? throw new System.Text.Json.JsonException();
            _pending = null; _review = null; updated = result.ResultProcedureId;
            _message = result.WasReplay ? "This review was already recorded." : "Your review was recorded.";
        }
        catch (Exception error) when (NetworkError(error))
        { _message = L["MemoryProcedureReviewPanel.TheResultCouldNotBe"]; }
        finally { _busy = false; await LockedChanged.InvokeAsync(Locked); }
        if (updated.HasValue)
        {
            try { await Reviewed.InvokeAsync(updated.Value); }
            catch (Exception error) when (NetworkError(error)) { _message = L["MemoryProcedureReviewPanel.TheReviewWasRecordedReload"]; }
        }
    }
    private static bool NetworkError(Exception error) => error is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException;
}
