@using System.Net.Http.Json
@using System.Text.Json
@using CSweet.Contracts.Core
@inject HttpClient Http
@inject IAppLocalizer L

<div class="automatic-hiring-control" role="status" aria-live="polite">
    <div class="automatic-hiring-copy">
        <strong>@L[Blocked ? "AutomaticHiringControl.Blocked" : "AutomaticHiringControl.Mode"]</strong>
        <span>@(Blocked ? BlockReason : L.Format("AutomaticHiringControl.Description", new { name = Name }))</span>
    </div>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_stopping" OnClick="StopAsync">
        @L[_stopping ? "AutomaticHiringControl.Stopping" : "AutomaticHiringControl.ChooseManually"]
    </MudButton>
</div>
@if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid RecommendationId { get; set; }
    [Parameter] public string Name { get; set; } = "Your Chief of Staff";
    [Parameter] public string? BlockReason { get; set; }
    private bool Blocked => !string.IsNullOrWhiteSpace(BlockReason);
    [Parameter] public EventCallback<HiringRecommendationResponse> Stopped { get; set; }
    private bool _stopping;
    private string? _error;

    private async Task StopAsync()
    {
        if (_stopping) return;
        _stopping = true; _error = null;
        try
        {
            using var response = await Http.PostAsync($"api/core/organizations/{OrganizationId:D}/hiring/recommendations/{RecommendationId:D}/choose-manually", null);
            if (!response.IsSuccessStatusCode)
            {
                _error = L["AutomaticHiringControl.CouldNotStop"];
                if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                {
                    var detail = await response.Content.ReadFromJsonAsync<JsonElement>();
                    if (detail.TryGetProperty("message", out var message)) _error = message.GetString() ?? _error;
                }
                return;
            }
            var updated = await response.Content.ReadFromJsonAsync<HiringRecommendationResponse>();
            if (updated is { ManualSelectionRequested: true, AutomaticHiringEnabled: false } && updated.Id == RecommendationId)
                await Stopped.InvokeAsync(updated);
            else _error = L["AutomaticHiringControl.CouldNotStop"];
        }
        catch (Exception error) when (error is HttpRequestException or JsonException or TaskCanceledException)
        { _error = L["AutomaticHiringControl.CouldNotStop"]; }
        finally { _stopping = false; }
    }
}
