@using AvailableAgent = CSweet.Agent.SDK.AvailableAgent
@using CSweet.Contracts.Core
@using System.Text.Json
@implements IDisposable
@inject AgentHireOperationState HireOperations
@inject IAppLocalizer L

<AttentionRequestCard Kind="Hiring" EmployeeId="RecommenderId" Name="@Recommender" Context="@Context"
    Prompt="@Recommendation.Title" PromptMeta="@($"{Recommendation.RemainingHeadcount} of {Recommendation.Headcount} positions remaining")" RightAlignedActions="true">
    <BodyContent>
        @if (HasSeparateRequester)
        {
            <p class="role-requester">Role requested by @Recommendation.RequestingEmployee@if (!string.IsNullOrWhiteSpace(Recommendation.RequestingTeam)) { <span> · @Recommendation.RequestingTeam</span> }</p>
        }
        @if (_candidate is not null)
        {
            <div class="overview-candidate" aria-label="@L["OverviewHiringCandidateCard.RecommendedCandidate"]">
                <div class="candidate-identity">
                    <img src="@CandidateImage" alt="@_candidate.Name" loading="lazy" referrerpolicy="no-referrer" @onerror="() => _imageFailed = true" />
                    <div><span class="candidate-kicker">@L["OverviewHiringCandidateCard.RecommendedAgent"]</span><strong>@_candidate.Name</strong><span>@_candidate.Publisher</span><span>@(_candidate.Price is { } price ? $"{price:0.##} {_candidate.Currency}" : "Cost unavailable")</span></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Recommendation.SelectionRationale))
                {
                    <div class="candidate-rationale"><span class="candidate-kicker">@L["OverviewHiringCandidateCard.WhyThisAgent"]</span><p>@Recommendation.SelectionRationale</p></div>
                }
            </div>
        }
        else
        {
            <div class="overview-candidate candidate-preparation" role="status" aria-live="polite" aria-atomic="true">
                <div class="candidate-identity">
                    <span class="candidate-preparation-icon" aria-hidden="true">
                        @if (IsInterviewing)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.PersonSearch" Size="Size.Large" Color="Color.Primary" />
                        }
                    </span>
                    <div><span class="candidate-kicker">@L["OverviewHiringCandidateCard.CandidateSelection"]</span><strong>@PreparationTitle</strong></div>
                </div>
                <div class="candidate-rationale"><p>@PreparationDescription</p></div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Recommendation.Objective))
        {
            <details class="candidate-scope"><summary>@L["OverviewHiringCandidateCard.RoleScope"]</summary><p>@Recommendation.Objective</p></details>
        }
    </BodyContent>
    <ChildContent>
        @if (IsAutomatic)
        {
            <AutomaticHiringControl OrganizationId="OrganizationId" RecommendationId="Recommendation.Id" Name="@Recommender" BlockReason="@Recommendation.AutomaticHiringBlockReason" Stopped="OnManualSelection" />
        }
        else if (IsManualSelection)
        {
            <p role="status">@L["AutomaticHiringControl.ManualSelection"]</p>
        }
        @if (PendingOperation is { } operation)
        {
            <div class="candidate-hiring-status" role="status" aria-live="polite" aria-atomic="true">
                @if (AgentHireOperationStatuses.IsActive(operation.Status))
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                }
                <span><strong>@operation.Phase</strong><span>@operation.Detail</span></span>
            </div>
        }
        <div class="candidate-actions">
            @if ((!IsAutomatic || !string.IsNullOrWhiteSpace(Recommendation.AutomaticHiringBlockReason)) && !IsManualSelection && _candidate is not null)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="IsHireDisabled" OnClick="OpenHireAsync">@(PendingOperation is not null ? "Hiring in progress…" : _openingReview ? "Preparing review…" : IsAutomatic ? L["AutomaticHiringControl.Review"] : $"Hire {_candidate.Name}")</MudButton>
            }
            @if (!IsAutomatic || NoSuitableAgent)
            {
                <MudButton Href="@Recommendation.HiringUrl" Disabled="IsHireDisabled" Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Outlined.ArrowForward">@L[NoSuitableAgent ? "HiringCandidateSelection.OpenMarketplace" : "OverviewHiringCandidateCard.BrowseCandidates"]</MudButton>
            }
        </div>
    </ChildContent>
</AttentionRequestCard>
@if (_candidate is not null)
{
    <AgentHireDialog @ref="_hireDialog" OrganizationId="OrganizationId" Hired="Hired" />
}

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter, EditorRequired] public HiringRecommendationResponse Recommendation { get; set; } = default!;
    [Parameter] public EventCallback Hired { get; set; }
    [CascadingParameter] public EmployeePortraits? Portraits { get; set; }
    private AgentHireDialog? _hireDialog;
    private AvailableAgent? _candidate;
    private string? _candidateJson;
    private bool _imageFailed;
    private bool _openingReview;
    private Guid? _manualRoleId;
    private bool IsManualSelection => _manualRoleId == Recommendation.Id || Recommendation.ManualSelectionRequested;
    private bool IsAutomatic => Recommendation.AutomaticHiringEnabled && !IsManualSelection;
    private bool NoSuitableAgent => Recommendation.NoSuitableAgentFound && !IsManualSelection;
    private AgentHireOperationResponse? PendingOperation => IsManualSelection ? null : HireOperations.Operations
        .Where(x => x.OrganizationId == OrganizationId && x.RecommendationId == Recommendation.Id &&
            (AgentHireOperationStatuses.IsActive(x.Status) || x.Status is AgentHireOperationState.UnconfirmedStatus or AgentHireOperationStatuses.AwaitingConfirmation))
        .OrderByDescending(x => x.UpdatedAt).FirstOrDefault();
    private bool IsHireDisabled => _openingReview || PendingOperation is not null;
    protected override void OnInitialized() => HireOperations.Changed += OnHireOperationsChanged;
    private void OnHireOperationsChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => HireOperations.Changed -= OnHireOperationsChanged;
    private bool IsInterviewing => !IsManualSelection && !NoSuitableAgent && _candidate is null && string.IsNullOrWhiteSpace(_candidateJson) &&
        string.IsNullOrWhiteSpace(Recommendation.SelectionRationale);
    private string PreparationTitle => NoSuitableAgent ? L["HiringCandidateSelection.NoSuitableAgent"]
        : IsInterviewing ? "Interviewing agents"
        : !string.IsNullOrWhiteSpace(_candidateJson) ? "Recommendation unavailable" : "Candidate review";
    private string PreparationDescription => IsManualSelection ? L["AutomaticHiringControl.ManualSelection"] : NoSuitableAgent
        ? L.Format("HiringCandidateSelection.NoSuitableAgentDescription", new { role = Recommendation.Title })
        : IsInterviewing
        ? "We're reviewing candidates for this role. A recommendation will appear here when it's ready."
        : !string.IsNullOrWhiteSpace(_candidateJson)
            ? "The recommended agent could not be displayed. Browse candidates to review available agents."
            : Recommendation.SelectionRationale!;
    private string Recommender => !string.IsNullOrWhiteSpace(Recommendation.SuggestedBy) ? Recommendation.SuggestedBy
        : !string.IsNullOrWhiteSpace(Recommendation.RequestingEmployee) ? Recommendation.RequestingEmployee : "Hiring suggestion";
    private Guid? RecommenderId => Portraits?.FindEmployee(Recommender);
    private bool HasSeparateRequester => !string.IsNullOrWhiteSpace(Recommendation.RequestingEmployee) &&
        !string.Equals(Recommendation.RequestingEmployee, Recommender, StringComparison.OrdinalIgnoreCase);
    private string? Context => HasSeparateRequester ? Portraits?.FindRole(RecommenderId)
        : Recommendation.RequestingTeam ?? Portraits?.FindRole(RecommenderId);
    private string CandidateImage => !_imageFailed && MarketplaceAgentPresentation.IsAgentImageUrl(_candidate?.ImageUrl)
        ? _candidate!.ImageUrl! : MarketplaceAgentPresentation.DefaultImageUrl;
    protected override void OnParametersSet()
    {
        var candidateJson = IsManualSelection ? null : Recommendation.SelectedCatalogAgentJson;
        if (_candidateJson == candidateJson) return;
        _candidateJson = candidateJson;
        _candidate = null; _imageFailed = false;
        if (string.IsNullOrWhiteSpace(_candidateJson)) return;
        try
        {
            var candidate = JsonSerializer.Deserialize<AvailableAgent>(_candidateJson, new JsonSerializerOptions(JsonSerializerDefaults.Web));
            if (!string.IsNullOrWhiteSpace(candidate?.AgentReference) && !string.IsNullOrWhiteSpace(candidate.Name)) _candidate = candidate;
        }
        catch (JsonException) { }
    }
    private void OnManualSelection(HiringRecommendationResponse updated)
    {
        _manualRoleId = updated.Id;
        _candidateJson = null; _candidate = null;
    }
    private async Task OpenHireAsync()
    {
        if (IsHireDisabled || _candidate is null || _hireDialog is null) return;
        _openingReview = true;
        try { await _hireDialog.OpenAsync(_candidate, Recommendation.Title, Recommendation.Id); }
        finally { _openingReview = false; }
    }
}
