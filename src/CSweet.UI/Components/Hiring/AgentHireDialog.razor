@using System.Net.Http.Json
@using System.Text.Json
@using CSweet.Agent.SDK
@using CSweet.Contracts.Agents
@using CSweet.Contracts.Core
@using CSweet.Contracts.Llm
@using CSweet.Contracts.Plugins
@using CSweet.Domain.Core
@using ContractAgentConfigurationFieldTypes = CSweet.Contracts.Agents.AgentConfigurationFieldTypes
@inject HttpClient Http
@inject ILlmProviderApiClient LlmProviderApi
@inject AgentHireOperationState HireOperations
@inject NavigationManager Navigation

<MudDialog @bind-Visible="_reviewOpen" Options="_dialogOptions" Class="hire-profile-dialog">
    <DialogContent>
        <section class="hire-profile" aria-labelledby="hire-dialog-title">
            <header class="profile-topbar">
                <span class="profile-eyebrow">Your next teammate</span>
                <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Close hire review" Disabled="_reviewBusy" OnClick="CloseReviewAsync" />
            </header>
            <div class="profile-scroll">
                <div class="profile-identity">
                    <img class="profile-portrait" src="@PortraitUrl" alt="@(_selectedAgent?.Name ?? "Agent portrait")" @onerror="() => _portraitFailed = true" />
                    <div class="profile-person">
                        @if (_editingName)
                        {
                            <div class="profile-name-editor" @onkeydown:stopPropagation="true">
                                <h2 id="hire-dialog-title" class="sr-only">@_employeeDisplayName</h2>
                                <MudTextField T="string" Label="Employee name" @bind-Value="_nameDraft" Immediate="true" AutoFocus="true"
                                              MaxLength="160" Variant="Variant.Outlined" OnKeyDown="HandleNameKey" Disabled="_reviewBusy" />
                                <div class="profile-name-actions">
                                    <MudButton Size="Size.Small" Color="Color.Primary" OnClick="SaveName" Disabled="@(_reviewBusy || string.IsNullOrWhiteSpace(_nameDraft))">Save</MudButton>
                                    <MudButton Size="Size.Small" OnClick="CancelNameEdit" Disabled="_reviewBusy">Cancel</MudButton>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="profile-name">
                                <h2 id="hire-dialog-title">@_employeeDisplayName</h2>
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="Edit employee name" Disabled="_reviewBusy" OnClick="BeginNameEdit" />
                            </div>
                        }
                        <p class="profile-role">@(_preview?.RoleTitle ?? _selectedAgent?.RoleName)</p>
                        @if (_preview is not null)
                        {
                            <span class="profile-trust"><MudIcon Icon="@Icons.Material.Outlined.Shield" Size="Size.Small" /> @_preview.Trust</span>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_selectedAgent?.Summary))
                {
                    <p class="profile-summary">@_selectedAgent.Summary</p>
                }
                @if (_reviewBusy && _preview is null)
                {
                    <div class="profile-loading"><MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" /> Preparing the hire review…</div>
                }
                @if (!string.IsNullOrWhiteSpace(_reviewError))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_reviewError</MudAlert>
                }
                @if (!string.IsNullOrWhiteSpace(_reviewStatus))
                {
                    <MudAlert Severity="Severity.Info">@_reviewStatus</MudAlert>
                }
                @if (_preview is not null)
                {
                    <section class="profile-section" aria-labelledby="profile-placement-title">
                        <h3 id="profile-placement-title">Joining your team</h3>
                        @if (RecommendationId.HasValue)
                        {
                            <dl class="profile-placement">
                                <div><dt>Team</dt><dd>@(_teams.FirstOrDefault(t => t.Id == _teamId)?.Name ?? "No team assigned")</dd></div>
                                <div><dt>Reports to</dt><dd>@(_people.FirstOrDefault(p => p.Id == _reportsToId)?.DisplayName ?? "Manager unavailable")</dd></div>
                            </dl>
                            <p class="profile-note"><MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" /> Assigned by the hiring plan</p>
                        }
                        else
                        {
                            <div class="profile-fields">
                                <MudSelect T="Guid?" Label="Reports to" @bind-Value="_reportsToId" Required="true" Variant="Variant.Outlined" Disabled="_reviewBusy">
                                    @foreach (var person in _people)
                                    {
                                        <MudSelectItem T="Guid?" Value="@person.Id">@person.DisplayName</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSelect T="Guid?" Label="Team" @bind-Value="_teamId" Clearable="true" Variant="Variant.Outlined" Disabled="_reviewBusy"
                                           HelperText="Optional. Team assignment is permanent for AI employees.">
                                    @foreach (var team in _teams.Where(t => !t.IsArchived).OrderBy(t => t.Name))
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)team.Id)">@team.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        }
                    </section>
                    @if (HasModelSettings)
                    {
                        <section class="profile-section" aria-labelledby="profile-model-title">
                            <h3 id="profile-model-title">Model</h3>
                            <button type="button" class="profile-model" aria-expanded="@(_modelSettingsOpen || ModelFields.Any(f => f.Required && !HasConfigurationValue(f)))" aria-controls="profile-model-fields" disabled="@_reviewBusy" @onclick="() => _modelSettingsOpen = !_modelSettingsOpen">
                                <MudIcon Icon="@Icons.Material.Outlined.Memory" />
                                <span><strong>@ModelSummary</strong><small>@SelectedProvider?.Name</small></span>
                                <span class="profile-change">@(_modelSettingsOpen ? "Done" : "Change")</span>
                            </button>
                            @if (_modelSettingsOpen || ModelFields.Any(f => f.Required && !HasConfigurationValue(f)))
                            {
                                <div id="profile-model-fields">@ConfigurationEditor(ModelFields)</div>
                            }
                        </section>
                    }
                    <section class="profile-access">
                        <button type="button" class="profile-disclosure" aria-expanded="@_grantDetailsOpen" aria-controls="hire-access-details" @onclick="ToggleGrantDetails">
                            <MudIcon Icon="@Icons.Material.Outlined.Security" />
                            <span>Review access</span>
                            <MudIcon Icon="@(_grantDetailsOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
                        </button>
                        @if (_grantDetailsOpen)
                        {
                            <div id="hire-access-details">
                                <MudTabs MinimumTabWidth="0px" Elevation="0" Rounded="true" @bind-ActivePanelIndex="_accessTab" Class="profile-access-tabs">
                                    <MudTabPanel Text="@($"Capabilities ({_preview.Capabilities.Count})")">@AccessPane(_preview.Capabilities, "Capabilities", "What this agent can do.")</MudTabPanel>
                                    <MudTabPanel Text="@($"Platform ({_preview.RequestedCapabilities.Count})")">@AccessPane(_preview.RequestedCapabilities, "Platform access", "Platform actions this agent requests.")</MudTabPanel>
                                    <MudTabPanel Text="@($"Events ({_preview.Subscriptions.Count})")">@AccessPane(_preview.Subscriptions, "Event subscriptions", "Events this agent listens for.")</MudTabPanel>
                                    <MudTabPanel Text="@($"Network ({_preview.NetworkAccess.Count})")">@AccessPane(_preview.NetworkAccess, "Network access", "Network destinations this agent requests.")</MudTabPanel>
                                </MudTabs>
                            </div>
                        }
                    </section>
                    @if (OtherFields.Any())
                    {
                        <details class="profile-details" open="@OtherFields.Any(f => f.Required && !HasConfigurationValue(f))">
                            <summary>Agent settings <span>@OtherFields.Count() @(OtherFields.Count() == 1 ? "setting" : "settings")</span></summary>
                            @ConfigurationEditor(OtherFields)
                        </details>
                    }
                    <details class="profile-details profile-package">
                        <summary>Agent information</summary>
                        <dl class="profile-placement">
                            <div><dt>Source</dt><dd>@_preview.Source</dd></div>
                            <div><dt>Price</dt><dd>@(_preview.Price.HasValue ? $"{_preview.Price:0.##} {_preview.Currency}" : "Price not provided")</dd></div>
                        </dl>
                        <p class="profile-note">@_preview.InstallationConsequence</p>
                    </details>
                }
            </div>
            @if (_preview is not null)
            {
                <footer class="profile-actions">
                    <MudButton Variant="Variant.Text" OnClick="CloseReviewAsync" Disabled="_reviewBusy">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                               Disabled="@(_reviewBusy || _editingName || !_reportsToId.HasValue || string.IsNullOrWhiteSpace(_employeeDisplayName) || HasMissingRequiredConfiguration)"
                               OnClick="ConfirmHireAsync">Approve and hire</MudButton>
                </footer>
            }
        </section>
    </DialogContent>
</MudDialog>
@code {
    private RenderFragment ConfigurationEditor(IEnumerable<PluginConfigurationField> fields) => @<div class="profile-fields">
        @foreach (var field in fields)
    {
        <div class="hire-configuration-field">
            @if (IsProviderField(field))
            {
                <MudSelect T="string" Label="@FieldLabel(field)" Value="@ConfigurationString(field.Key)"
                           ValueChanged="@(value => SetProviderAsync(field.Key, value))"
                           Variant="Variant.Outlined" Disabled="_reviewBusy">
                    @foreach (var provider in _providers.Where(provider => provider.IsEnabled))
                    {
                        <MudSelectItem T="string" Value="@provider.Id.ToString()">@provider.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (IsModelField(field) && _preview?.ConfigurationFields.Any(IsProviderField) == true)
            {
                <MudSelect T="string" Label="@FieldLabel(field)" Value="@ConfigurationString(field.Key)"
                           ValueChanged="@(value => SetConfiguration(field.Key, value))"
                           Variant="Variant.Outlined" Disabled="@(_reviewBusy || SelectedProvider is null || _loadingModels)">
                    @foreach (var model in _models)
                    {
                        <MudSelectItem T="string" Value="@model">@model</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (field.Type.Equals(ContractAgentConfigurationFieldTypes.Boolean, StringComparison.OrdinalIgnoreCase))
            {
                <MudCheckBox T="bool" Label="@FieldLabel(field)" Value="@ConfigurationBoolean(field.Key)"
                             ValueChanged="@(value => SetConfiguration(field.Key, value))" Disabled="_reviewBusy" />
            }
            else if (field.Type.Equals(ContractAgentConfigurationFieldTypes.Number, StringComparison.OrdinalIgnoreCase))
            {
                <MudNumericField T="decimal?" Min="@(field.Minimum ?? decimal.MinValue)" Max="@(field.Maximum ?? decimal.MaxValue)" Label="@FieldLabel(field)" Value="@ConfigurationNumber(field.Key)"
                                 ValueChanged="@(value => SetConfiguration(field.Key, value))"
                                 Variant="Variant.Outlined" Disabled="_reviewBusy" />
            }
            else if (field.Type.Equals(ContractAgentConfigurationFieldTypes.Select, StringComparison.OrdinalIgnoreCase))
            {
                <MudSelect T="string" Label="@FieldLabel(field)" Value="@ConfigurationString(field.Key)"
                           ValueChanged="@(value => SetConfiguration(field.Key, value))"
                           Variant="Variant.Outlined" Disabled="_reviewBusy">
                    @foreach (var option in field.Options ?? [])
                    {
                        <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudTextField T="string" InputType="@(field.Secret ? InputType.Password : InputType.Text)" Label="@FieldLabel(field)" Value="@ConfigurationString(field.Key)"
                              ValueChanged="@(value => SetConfiguration(field.Key, value))"
                              Variant="Variant.Outlined" Disabled="_reviewBusy" />
            }
            @if (!string.IsNullOrWhiteSpace(field.Description))
            {
                <small>@field.Description</small>
            }
        </div>
    }
    </div>;

    private RenderFragment AccessPane(IReadOnlyList<string> items, string heading, string description) => @<div class="profile-access-pane">
        <h4>@heading</h4>
        <p>@description</p>
        @if (items.Count == 0)
        {
            <p class="profile-access-empty">None requested.</p>
        }
        else
        {
            <ul>
                @foreach (var item in items)
                {
                    <li><code>@CapabilityDisplayNames.For(item)</code></li>
                }
            </ul>
        }
    </div>;

    private bool _portraitFailed;
    private bool _editingName;
    private string _nameDraft = string.Empty;
    private bool _modelSettingsOpen;
    private int _accessTab;
    private string PortraitUrl => !_portraitFailed && MarketplaceAgentPresentation.IsAgentImageUrl(_selectedAgent?.ImageUrl)
        ? _selectedAgent!.ImageUrl! : MarketplaceAgentPresentation.DefaultImageUrl;
    private IEnumerable<PluginConfigurationField> VisibleFields => _preview?.ConfigurationFields.Where(IsConfigurationFieldVisible) ?? [];
    private bool HasModelSettings => VisibleFields.Any(IsModelField);
    private IEnumerable<PluginConfigurationField> ModelFields => VisibleFields.Where(f => IsModelField(f) || IsProviderField(f));
    private IEnumerable<PluginConfigurationField> OtherFields => VisibleFields.Where(f => !HasModelSettings || (!IsModelField(f) && !IsProviderField(f)));
    private string ModelSummary => string.Join(", ", ModelFields.Where(IsModelField).Select(f => ConfigurationString(f.Key)).Where(v => !string.IsNullOrWhiteSpace(v))) is { Length: > 0 } value ? value : "Choose a model";

    private void BeginNameEdit() { _nameDraft = _employeeDisplayName; _editingName = true; }
    private void CancelNameEdit() { _editingName = false; _nameDraft = _employeeDisplayName; }
    private void SaveName()
    {
        if (_reviewBusy || string.IsNullOrWhiteSpace(_nameDraft)) return;
        _employeeDisplayName = _nameDraft.Trim();
        _editingName = false;
    }
    private void HandleNameKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") SaveName();
        else if (args.Key == "Escape") CancelNameEdit();
    }

    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public EventCallback Hired { get; set; }
    private Guid? RecommendationId;
    private string? _role;
    private bool _reviewOpen;
    private bool _reviewBusy;
    private bool _grantDetailsOpen;
    private string? _reviewError;
    private string? _reviewStatus;
    private MarketplaceHirePreviewResponse? _preview;
    private AvailableAgent? _selectedAgent;
    private string _employeeDisplayName = string.Empty;
    private Guid? _reportsToId;
    private Guid? _teamId;
    private IReadOnlyList<OrganizationUserResponse> _people = [];
    private IReadOnlyList<TeamSummaryResponse> _teams = [];
    private IReadOnlyList<LlmProviderProfileResponse> _providers = [];
    private IReadOnlyList<string> _models = [];
    private readonly Dictionary<string, object?> _configurationValues = new(StringComparer.Ordinal);
    private bool _loadingModels;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = false };
    private static readonly JsonSerializerOptions SerializerOptions = new(JsonSerializerDefaults.Web);
    private bool HasMissingRequiredConfiguration =>
        _preview?.ConfigurationFields
            .Where(configField => configField.Required && IsConfigurationFieldVisible(configField))
            .Any(configField => !HasConfigurationValue(configField)) == true;

    public async Task OpenAsync(AvailableAgent agent, string? role = null, Guid? recommendationId = null)
    {
        _role = role;
        RecommendationId = recommendationId;
        _selectedAgent = agent;
        _reviewOpen = true;
        _reviewBusy = true;
        _grantDetailsOpen = false;
        _portraitFailed = false;
        _editingName = false;
        _modelSettingsOpen = false;
        _accessTab = 0;
        _models = [];
        _reviewError = null;
        _reviewStatus = null;
        _preview = null;
        _employeeDisplayName = agent.Name;
        _reportsToId = null;
        _teamId = null;
        _configurationValues.Clear();
        await InvokeAsync(StateHasChanged);
        try
        {
            var peopleTask = Http.GetFromJsonAsync<IReadOnlyList<OrganizationUserResponse>>(
                $"api/core/organizations/{OrganizationId:D}/users");

            var teamsTask = Http.GetFromJsonAsync<TeamDirectoryResponse>(
                $"api/core/organizations/{OrganizationId:D}/teams?includeArchived=false");
            await Task.WhenAll(peopleTask, teamsTask);
            _people = await peopleTask ?? [];
            _providers = [];
            _teams = (await teamsTask)?.Teams ?? [];
            _reportsToId = _people
                .OrderByDescending(person => person.PermissionLevel == (int)OrganizationPermissionLevel.Owner)
                .ThenBy(person => person.DisplayName)
                .Select(person => (Guid?)person.Id)
                .FirstOrDefault();
            await LoadPreviewAsync();
        }
        catch (Exception exception)
        {
            _reviewError = exception.Message;
        }
        finally
        {
            _reviewBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadPreviewAsync()
    {
        if (_selectedAgent is null) return;
        var supersededWorkflowId = _preview?.WorkflowId;
        var role = string.IsNullOrWhiteSpace(_role)
            ? _selectedAgent.RoleName ?? _selectedAgent.RoleAliases.FirstOrDefault() ?? _selectedAgent.Name
            : _role.Trim();
        var response = await Http.PostAsJsonAsync(
            $"api/core/organizations/{OrganizationId:D}/hiring/marketplace/preview",
            new PreviewMarketplaceHireRequest(
                _selectedAgent.AgentReference,
                role,
                _employeeDisplayName,
                _reportsToId,
                $"marketplace-preview:{Guid.NewGuid():N}")
            {
                RecommendationId = RecommendationId,
                TeamId = _teamId,
                SupersedesWorkflowId = supersededWorkflowId
            });
        if (!response.IsSuccessStatusCode)
        {
            var failure = await response.Content.ReadFromJsonAsync<MarketplaceApiError>();
            throw new InvalidOperationException(failure?.Message ?? "The agent hire could not be prepared.");
        }
        _preview = await response.Content.ReadFromJsonAsync<MarketplaceHirePreviewResponse>()
            ?? throw new InvalidOperationException("The Marketplace hire preview was empty.");
        if (RecommendationId.HasValue)
        {
            _reportsToId = _preview.ReportsToOrganizationUserId;
            _teamId = _preview.TeamId;
        }
        await InitializeConfigurationAsync();
    }

    private async Task ConfirmHireAsync()
    {
        if (_preview is null || _reviewBusy || _editingName || !_reportsToId.HasValue || string.IsNullOrWhiteSpace(_employeeDisplayName) || HasMissingRequiredConfiguration) return;
        _reviewBusy = true;
        _reviewError = null;
        _reviewStatus = null;
        try
        {
            if (_preview.ReportsToOrganizationUserId != _reportsToId ||
                _preview.TeamId != _teamId ||
                !string.Equals(
                    _preview.EmployeeDisplayName,
                    _employeeDisplayName.Trim(),
                    StringComparison.Ordinal))
            {
                await LoadPreviewAsync();
                if (_preview is null || HasMissingRequiredConfiguration) return;
            }
            var preview = _preview;
            var request = new ConfirmHiringWorkflowRequest($"marketplace-confirm:{preview.WorkflowId:D}")
            {
                ConfigurationSettings = _configurationValues
                    .Where(pair => pair.Value is not null)
                    .ToDictionary(
                        pair => pair.Key,
                        pair => JsonSerializer.SerializeToElement(pair.Value, SerializerOptions),
                        StringComparer.Ordinal)
            };
            HireOperations.Start(
                OrganizationId,
                preview.WorkflowId,
                _selectedAgent?.Name ?? preview.EmployeeDisplayName,
                preview.EmployeeDisplayName,
                request,
                RecommendationId);
            _reviewOpen = false;
            _preview = null;
            _selectedAgent = null;
            await Hired.InvokeAsync();
        }
        catch (Exception exception)
        {
            _reviewError = exception.Message;
            _reviewStatus = null;
        }
        finally
        {
            _reviewBusy = false;
        }
    }

    private async Task CloseReviewAsync()
    {
        var workflowId = _preview?.WorkflowId;
        if (workflowId.HasValue)
        {
            try
            {
                await Http.PostAsync(
                    $"api/core/organizations/{OrganizationId:D}/hiring/workflows/{workflowId:D}/cancel-preview",
                    content: null);
            }
            catch
            {
                // Closing the local dialog must not trap the user if cancellation transport fails.
            }
        }
        _reviewOpen = false;
        _preview = null;
        _selectedAgent = null;
        _reviewError = null;
        _reviewStatus = null;
        _reportsToId = null;
        _employeeDisplayName = string.Empty;
        _configurationValues.Clear();
        _models = [];
    }

    private void ToggleGrantDetails() => _grantDetailsOpen = !_grantDetailsOpen;

    private async Task InitializeConfigurationAsync()
    {
        var existing = _configurationValues.ToDictionary(
            pair => pair.Key,
            pair => pair.Value,
            StringComparer.Ordinal);
        _configurationValues.Clear();
        if (_preview is null)
            return;
        if (_providers.Count == 0 && _preview.ConfigurationFields.Any(f => IsProviderField(f) || IsModelField(f)))
            _providers = await LlmProviderApi.ListAsync();
        var provider = _providers.FirstOrDefault(candidate => candidate.IsEnabled);
        foreach (var field in _preview.ConfigurationFields)
        {
            if (existing.TryGetValue(field.Key, out var existingValue) && existingValue is not null)
                _configurationValues[field.Key] = existingValue;
            else if (ConfigurationDefaultValue(field) is { } defaultValue)
                _configurationValues[field.Key] = defaultValue;
            else if (IsProviderField(field) && provider is not null)
                _configurationValues[field.Key] = provider.Id.ToString();
            else if (field.Type.Equals(ContractAgentConfigurationFieldTypes.Boolean, StringComparison.OrdinalIgnoreCase))
                _configurationValues[field.Key] = false;
            else if (field.Type.Equals(ContractAgentConfigurationFieldTypes.Select, StringComparison.OrdinalIgnoreCase))
                _configurationValues[field.Key] = field.Options?.FirstOrDefault()?.Value;
            else
                _configurationValues[field.Key] = null;
        }
        var selectedProvider = SelectedProvider ?? provider;
        if (selectedProvider is not null && _preview.ConfigurationFields.Any(IsModelField))
        {
            await LoadModelsAsync(selectedProvider);
            SetDefaultModel(selectedProvider, overwrite: false);
        }
    }

    private async Task SetProviderAsync(string key, string value)
    {
        _configurationValues[key] = value;
        var provider = SelectedProvider;
        if (provider is null)
            return;
        await LoadModelsAsync(provider);
        SetDefaultModel(provider, overwrite: true);
    }

    private async Task LoadModelsAsync(LlmProviderProfileResponse provider)
    {
        _loadingModels = true;
        try
        {
            var catalog = await LlmProviderApi.GetModelCatalogAsync(provider.Id);
            _models = catalog.Models
                .Select(model => model.Id)
                .Append(provider.DefaultChatModel)
                .Where(model => !string.IsNullOrWhiteSpace(model))
                .Distinct(StringComparer.Ordinal)
                .ToList();
        }
        finally
        {
            _loadingModels = false;
        }
    }

    private void SetDefaultModel(LlmProviderProfileResponse provider, bool overwrite)
    {
        if (_preview is null)
            return;
        var model = _models.Contains(provider.DefaultChatModel, StringComparer.Ordinal)
            ? provider.DefaultChatModel
            : _models.FirstOrDefault() ?? string.Empty;
        foreach (var field in _preview.ConfigurationFields.Where(IsModelField))
        {
            if (overwrite || string.IsNullOrWhiteSpace(ConfigurationString(field.Key)))
                _configurationValues[field.Key] = model;
        }
    }

    private LlmProviderProfileResponse? SelectedProvider
    {
        get
        {
            var configField = _preview?.ConfigurationFields.FirstOrDefault(IsProviderField);
            if (configField is null) return _providers.FirstOrDefault(provider => provider.IsEnabled);
            return !Guid.TryParse(ConfigurationString(configField.Key), out var id)
                ? null
                : _providers.FirstOrDefault(provider => provider.Id == id && provider.IsEnabled);
        }
    }

    private static bool IsProviderField(PluginConfigurationField field) =>
        field.Type.Equals("provider", StringComparison.OrdinalIgnoreCase) ||
        field.Type.Equals(ContractAgentConfigurationFieldTypes.LlmProvider, StringComparison.OrdinalIgnoreCase);

    private static bool IsModelField(PluginConfigurationField field) =>
        field.Type.Equals("model", StringComparison.OrdinalIgnoreCase) ||
        field.Type.Equals(ContractAgentConfigurationFieldTypes.LlmModel, StringComparison.OrdinalIgnoreCase);

    private bool IsConfigurationFieldVisible(PluginConfigurationField field) =>
        AgentConfigurationVisibility.IsVisible(field, _configurationValues);

    private static string FieldLabel(PluginConfigurationField field) =>
        field.Required ? $"{field.Label} (required)" : field.Label;

    private static object? ConfigurationDefaultValue(PluginConfigurationField field)
    {
        if (field.DefaultValue is not { } value)
            return null;
        return value.ValueKind switch
        {
            JsonValueKind.String => value.GetString(),
            JsonValueKind.Number when value.TryGetDecimal(out var number) => number,
            JsonValueKind.True => true,
            JsonValueKind.False => false,
            _ => null
        };
    }

    private string ConfigurationString(string key) =>
        _configurationValues.GetValueOrDefault(key)?.ToString() ?? string.Empty;

    private bool ConfigurationBoolean(string key) =>
        _configurationValues.GetValueOrDefault(key) is true;

    private decimal? ConfigurationNumber(string key) =>
        _configurationValues.GetValueOrDefault(key) as decimal?;

    private void SetConfiguration(string key, object? value) =>
        _configurationValues[key] = value;

    private bool HasConfigurationValue(PluginConfigurationField field)
    {
        if (!_configurationValues.TryGetValue(field.Key, out var value) || value is null)
            return false;
        return field.Type.Equals(ContractAgentConfigurationFieldTypes.Boolean, StringComparison.OrdinalIgnoreCase) ||
               field.Type.Equals(ContractAgentConfigurationFieldTypes.Number, StringComparison.OrdinalIgnoreCase) ||
               !string.IsNullOrWhiteSpace(value.ToString());
    }

    private sealed record MarketplaceApiError(string? Error, string? Message, Guid? DefinitionId = null);

}
