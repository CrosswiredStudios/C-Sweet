@using CSweet.Contracts.SourceControl
@inject HttpClient Http

<MudExpansionPanels><MudExpansionPanel Text="Repository backups">
    <MudStack Spacing="2">
        <MudText>Back up Git history and all referenced LFS files to the configured backup storage. Restore creates a separate private repository; assign its team access after inspection.</MudText>
        @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
        @if (_message is not null) { <MudAlert Severity="Severity.Success">@_message</MudAlert> }
        <MudButton OnClick="RefreshAsync" Disabled="_busy">Refresh backups and repositories</MudButton>
        <MudSelect T="Guid" @bind-Value="_repository" Label="Repository to back up" Disabled="@(_busy || _pendingBackup is not null)">
            @foreach (var repository in _repositories.Where(r => r.Status is "Ready" or "Archived"))
            { <MudSelectItem Value="repository.Id">@repository.Name</MudSelectItem> }
        </MudSelect>
        <MudButton OnClick="CreateAsync" Disabled="@(_busy || _repository == Guid.Empty)">@(_pendingBackup is null ? "Create backup" : "Retry backup")</MudButton>
        <MudButton OnClick="LoadScheduleAsync" Disabled="@(_busy || _repository == Guid.Empty)">Manage automatic backups</MudButton>
        @if (_schedule is { } schedule && schedule.RepositoryId == _repository)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudText>Automatic backups for @RepositoryName(schedule.RepositoryId)</MudText>
                <MudCheckBox T="bool" @bind-Value="_scheduleEnabled" Disabled="_busy" Label="Enable automatic backups" />
                <MudNumericField T="int" @bind-Value="_intervalHours" Min="1" Max="8760" Label="Interval in hours" Disabled="_busy" />
                <MudText>A backup is queued when enabled, then once per UTC interval. Missed intervals do not create a backlog.</MudText>
                <MudCheckBox T="bool" @bind-Value="_retainAll" Disabled="_busy" Label="Keep all completed backups" />
                @if (!_retainAll)
                {
                    <MudNumericField T="int" @bind-Value="_keepLatest" Min="1" Max="100" Label="Number of backups to retain" Disabled="_busy" />
                    <MudAlert Severity="Severity.Warning">After a scheduled backup succeeds, older backups for this repository, including manual backups, will be permanently deleted beyond this count.</MudAlert>
                    <MudCheckBox T="bool" @bind-Value="_confirmRetention" Disabled="_busy" Label="I approve automatic deletion under this retention policy" />
                }
                <MudButton OnClick="SaveScheduleAsync" Disabled="@(_busy || _scheduleEnabled && !_retainAll && !_confirmRetention)">Save automatic backup settings</MudButton>
            </MudPaper>
        }
        @foreach (var job in _jobs.Where(j => j.Status is "Queued" or "Running" or "Failed").Concat(_jobs.Where(j => j.Status == "Completed").Take(5)))
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudText>@RepositoryName(job.RepositoryId) · backup job @job.Id · @job.Status</MudText>
                @if (job.FailureMessage is not null) { <MudText>@job.FailureMessage</MudText> }
                @if (job.Status == "Failed") { <MudButton OnClick="@(() => RetryJobAsync(job))" Disabled="_busy">Retry backup job</MudButton> }
                @if (job.Status is "Completed" or "Failed") { <MudButton OnClick="@(() => DismissJobAsync(job))" Disabled="_busy">Dismiss job (keep backup)</MudButton> }
            </MudPaper>
        }
        @if (_backups.Count == 0) { <MudText>No completed backups in the configured storage.</MudText> }
        @if (_backups.Count > 0)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudButton OnClick="@(() => _page--)" Disabled="@(_busy || _page == 0)">Newer backups</MudButton>
                <MudText>Page @(_page + 1) of @PageCount · @_backups.Count backups</MudText>
                <MudButton OnClick="@(() => _page++)" Disabled="@(_busy || _page + 1 >= PageCount)">Older backups</MudButton>
            </MudStack>
        }
        @foreach (var backup in _backups.Skip(_page * PageSize).Take(PageSize))
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudText>@RepositoryName(backup.RepositoryId) · @backup.CreatedAt.ToLocalTime().ToString("g")</MudText>
                <MudText Typo="Typo.body2">@backup.RefCount refs · @backup.LfsObjectCount LFS files · @backup.ArchiveBytes.ToString("N0") bytes · default branch @backup.DefaultBranch</MudText>
                <MudText Typo="Typo.caption">Backup @backup.Id</MudText>
                <MudText Typo="Typo.caption" Style="overflow-wrap:anywhere">SHA-256: @backup.ArchiveSha256</MudText>
                <MudButton OnClick="@(() => SelectRestore(backup))" Disabled="@(_busy || _restoreAttempted)">Restore into new repository</MudButton>
                <MudButton Color="Color.Error" OnClick="@(() => _delete = backup)" Disabled="_busy">Delete backup</MudButton>
            </MudPaper>
        }
        @if (_restore is not null)
        {
            <MudText>Restore backup @_restore.Id. Existing repositories will remain intact.</MudText>
            <MudTextField @bind-Value="_restoreName" Label="New repository name" Disabled="@(_busy || _restoreAttempted)" />
            <MudButton OnClick="RestoreAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_restoreName))">@(_restoreAttempted ? "Retry restore" : "Restore backup")</MudButton>
            @if (_restoreAttempted)
            {
                <MudText>A failed or interrupted restore may leave a pending repository. Retry to finish it, or dismiss this form to start another restore.</MudText>
                <MudButton OnClick="@(() => { _restore = null; _restoreAttempted = false; })" Disabled="_busy">Dismiss restore</MudButton>
            }
            @if (!_restoreAttempted) { <MudButton OnClick="@(() => _restore = null)" Disabled="_busy">Cancel</MudButton> }
        }
        @if (_delete is not null)
        {
            <MudAlert Severity="Severity.Warning">Permanently delete backup @_delete.Id? This removes its archived history and LFS files from backup storage.</MudAlert>
            <MudButton Color="Color.Error" OnClick="DeleteAsync" Disabled="_busy">Confirm backup deletion</MudButton>
            <MudButton OnClick="@(() => _delete = null)" Disabled="_busy">Cancel</MudButton>
        }
    </MudStack>
</MudExpansionPanel></MudExpansionPanels>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    private List<SourceControlRepositorySummary> _repositories = [];
    private List<InternalGitBackupSummary> _backups = [];
    private List<InternalGitBackupJob> _jobs = [];
    private InternalGitBackupSchedule? _schedule;
    private bool _scheduleEnabled, _confirmRetention, _retainAll = true;
    private int _intervalHours = 24, _keepLatest = 10;
    private const int PageSize = 10;
    private int _page;
    private int PageCount => Math.Max(1, (_backups.Count + PageSize - 1) / PageSize);
    private Guid _repository, _restoreId;
    private Guid? _pendingBackup;
    private InternalGitBackupSummary? _restore, _delete;
    private bool _busy, _restoreAttempted;
    private string _restoreName = "";
    private string? _error, _message;
    private string Endpoint => $"api/organizations/{OrganizationId:D}/source-control/internal";
    protected override Task OnInitializedAsync() => RefreshAsync();
    private string RepositoryName(Guid id) => _repositories.FirstOrDefault(r => r.Id == id)?.Name ?? id.ToString();
    private Task RefreshAsync() => RunAsync(LoadAsync);
    private Task LoadScheduleAsync() => RunAsync(async () => {
        _schedule = await Http.GetFromJsonAsync<InternalGitBackupSchedule>($"{Endpoint}/repositories/{_repository:D}/backup-schedule") ?? throw new IOException("Backup schedule response was empty.");
        _scheduleEnabled = _schedule.Enabled; _intervalHours = _schedule.IntervalHours;
        _retainAll = _schedule.KeepLatest is null; _keepLatest = _schedule.KeepLatest ?? 10; _confirmRetention = false;
    });
    private Task SaveScheduleAsync() => RunAsync(async () => {
        if (_schedule is null) return;
        using var response = await Http.PutAsJsonAsync($"{Endpoint}/repositories/{_schedule.RepositoryId:D}/backup-schedule",
            new SaveInternalGitBackupSchedule(_scheduleEnabled, _intervalHours, _retainAll ? null : _keepLatest, _schedule.Revision, _confirmRetention));
        await CheckAsync(response); _schedule = await response.Content.ReadFromJsonAsync<InternalGitBackupSchedule>();
        _confirmRetention = false; _message = "Automatic backup settings saved.";
    });
    private async Task LoadAsync()
    {
        _repositories = await Http.GetFromJsonAsync<List<SourceControlRepositorySummary>>($"{Endpoint}/repositories") ?? [];
        _backups = await Http.GetFromJsonAsync<List<InternalGitBackupSummary>>($"{Endpoint}/backups") ?? [];
        _jobs = await Http.GetFromJsonAsync<List<InternalGitBackupJob>>($"{Endpoint}/backup-jobs") ?? [];
        _backups = _backups.OrderByDescending(b => b.CreatedAt).ThenBy(b => b.Id).ToList();
        _page = Math.Min(_page, PageCount - 1);
    }
    private Task CreateAsync() => RunAsync(async () =>
    {
        _pendingBackup ??= Guid.NewGuid();
        using var response = await Http.PostAsJsonAsync($"{Endpoint}/repositories/{_repository:D}/backup-jobs", new CreateInternalGitBackupRequest(_pendingBackup.Value));
        await CheckAsync(response); _pendingBackup = null; _message = "Backup queued. Refresh to check progress; you can leave this page while it runs."; await LoadAsync();
    });
    private Task RetryJobAsync(InternalGitBackupJob job) => RunAsync(async () => {
        using var response = await Http.PostAsJsonAsync($"{Endpoint}/repositories/{job.RepositoryId:D}/backup-jobs", new CreateInternalGitBackupRequest(job.Id));
        await CheckAsync(response); await LoadAsync();
    });
    private Task DismissJobAsync(InternalGitBackupJob job) => RunAsync(async () => {
        using var response = await Http.DeleteAsync($"{Endpoint}/backup-jobs/{job.Id:D}");
        await CheckAsync(response); await LoadAsync();
    });
    private void SelectRestore(InternalGitBackupSummary backup)
    { _restore = backup; _restoreId = Guid.NewGuid(); _restoreName = ""; _restoreAttempted = false; }
    private Task RestoreAsync() => RunAsync(async () =>
    {
        if (_restore is null) return;
        _restoreAttempted = true;
        using var response = await Http.PostAsJsonAsync($"{Endpoint}/backups/{_restore.RepositoryId:D}/{_restore.Id:D}/restore", new RestoreInternalGitBackupRequest(_restoreId, _restoreName));
        await CheckAsync(response);
        _message = $"Restored into {_restoreName}. Refresh the repository list to inspect it and assign team access.";
        _restore = null; _restoreAttempted = false; await LoadAsync();
    });
    private Task DeleteAsync() => RunAsync(async () =>
    {
        if (_delete is null) return;
        using var response = await Http.DeleteAsync($"{Endpoint}/backups/{_delete.RepositoryId:D}/{_delete.Id:D}");
        await CheckAsync(response); _delete = null; _message = "Backup deleted."; await LoadAsync();
    });
    private static async Task CheckAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode) return;
        var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
        throw new InvalidOperationException(body.TryGetProperty("message", out var message) ? message.GetString() : "Backup operation failed.");
    }
    private async Task RunAsync(Func<Task> action)
    { _busy = true; _error = null; _message = null; try { await action(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
}
