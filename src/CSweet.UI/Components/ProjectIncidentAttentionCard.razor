@using CSweet.Contracts.Core
@using CSweet.Contracts.Communications
@inject HttpClient Http
@inject IAppLocalizer L

<AttentionRequestCard Kind="@(Incident.IsStatusReport ? "Issue" : "Input needed")"
    EmployeeId="@(Incident.ReporterOrganizationUserId ?? Incident.ReporterEmployeeId)"
    Name="@Incident.ReporterName" Context="@Incident.ProjectName" Prompt="@Incident.Reason"
    Description="@(Incident.OwnerReport ?? Incident.Facts)" Status="@(_notice ?? Incident.RecoveryStatus ?? (Incident.ReportDeliveryPending ? L["ProjectIncidentAttentionCard.Preparing"] : null))">
    <BodyContent>
        @if (!string.IsNullOrWhiteSpace(Incident.RecoveryStatus))
        {
            <p class="incident-next-step">@Incident.RecommendedAction</p>
        }
        @if (Incident.RelatedIncidentCount > 1)
        {
            <p>@L.Format("ProjectIncidentAttentionCard.RelatedReports", new { count = Incident.RelatedIncidentCount })</p>
        }
        @if (!string.IsNullOrWhiteSpace(Incident.DiagnosticDetails))
        {
            <details class="incident-diagnostics"><summary>@L["ProjectIncidentAttentionCard.TechnicalDetails"]</summary><pre>@Incident.DiagnosticDetails</pre></details>
        }
        @if (Incident.ResolutionDecision is { } decision && Incident.ReportConversationId is { } chat)
        {
            <IncidentResolutionChoices @key="decision.Id" OrganizationId="OrganizationId" ConversationId="chat" Decision="decision" Answered="RefreshRequested" />
        }
    </BodyContent>
    <ChildContent>
    @if (Incident.Collaboration is { } collaboration)
    {
        @if (Incident.ResolutionDecision is null && (collaboration.CanRetry || collaboration.Status is "Active" or "Summarizing"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_retrying || Queued || !collaboration.CanRetry)"
                       OnClick="RetryAsync">@(_retrying ? L["ProjectIncidentAttentionCard.Retrying"] : Queued ? L["ProjectIncidentAttentionCard.RetryQueued"] : !collaboration.CanRetry ? L["ProjectIncidentAttentionCard.InProgress"] : L["Common.Retry"])</MudButton>
        }
        <MudButton Href="@(Incident.InvestigateUri ?? collaboration.InvestigateUri)" Variant="Variant.Outlined" Color="Color.Primary">@(Incident.InvestigateLabel ?? L["ProjectIncidentAttentionCard.Investigate"])</MudButton>
    }
    else if (!string.IsNullOrWhiteSpace(Incident.InvestigateUri))
    {
        <MudButton Href="@Incident.InvestigateUri" Variant="Variant.Filled" Color="Color.Primary">@(Incident.InvestigateLabel ?? L["ProjectIncidentAttentionCard.Investigate"])</MudButton>
    }
    @if (!Incident.ReportDeliveryPending)
    {
        <MudButton Href="@Incident.ActionUri" Variant="Variant.Outlined" Color="Color.Primary">@L["ProjectIncidentAttentionCard.ReadReport"]</MudButton>
    }
    </ChildContent>
</AttentionRequestCard>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter, EditorRequired] public ProjectIncidentAttentionResponse Incident { get; set; } = default!;
    [Parameter] public EventCallback RefreshRequested { get; set; }
    private bool _retrying;
    private (Guid Session, long Revision)? _queued;
    private string? _notice;
    private bool Queued => Incident.Collaboration is { } c && _queued == (c.SessionId, c.Revision);

    protected override void OnParametersSet()
    {
        if (_queued.HasValue && !Queued) { _queued = null; _notice = null; }
    }

    private async Task RetryAsync()
    {
        if (_retrying || Queued || Incident.Collaboration is not { CanRetry: true } collaboration) return;
        _retrying = true; _notice = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/organizations/{OrganizationId}/communications/hub/chats/{collaboration.ConversationId}/coordination-sessions/{collaboration.SessionId}/retry",
                new RetryAgentCoordinationRequest(collaboration.Revision,
                    "Retry requested by a manager from Overview.",
                    $"ui-retry:{collaboration.SessionId:N}:{collaboration.Revision}"));
            if (response.IsSuccessStatusCode)
            {
                _queued = (collaboration.SessionId, collaboration.Revision);
                _notice = L["ProjectIncidentAttentionCard.Notice.Queued"];
            }
            else
                _notice = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Conflict => L["ProjectIncidentAttentionCard.Notice.Conflict"],
                    System.Net.HttpStatusCode.Forbidden => L["ProjectIncidentAttentionCard.Notice.Forbidden"],
                    System.Net.HttpStatusCode.NotFound => L["ProjectIncidentAttentionCard.Notice.NotFound"],
                    _ => L["ProjectIncidentAttentionCard.Notice.Failed"]
                };
        }
        catch (Exception error) when (error is HttpRequestException or OperationCanceledException)
        { _notice = L["ProjectIncidentAttentionCard.Notice.Unconfirmed"]; }
        finally { _retrying = false; }
        await RefreshRequested.InvokeAsync();
    }
}
