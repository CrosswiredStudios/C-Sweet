@page "/settings/offices"
@page "/settings/offices/{OfficeId:guid}"
@page "/settings/agents/execution-fleet"
@layout SettingsLayout
@using System.Net.Http.Json
@using CSweet.Contracts.Setup
@using CSweet.UI.Services
@inject HttpClient Http
@inject ISetupApiClient SetupApi
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>@(SelectedOffice is { } selected ? $"{selected.Name} - Offices - C-Sweet" : "Offices - C-Sweet")</PageTitle>

<div class="setup-shell configuration-page offices-page">
    <MudPaper Elevation="0" Class="page-header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">Server settings</MudText>
            <MudText Typo="Typo.h3">@(SelectedOffice?.Name ?? "Offices")</MudText>
            <MudText Color="Color.Secondary">@(OfficeId is null ? "Manage every Office connected to this server, wherever it runs." : "Manage this computer and the work it runs.")</MudText>
        </div>
        <div class="office-actions">
            @if (OfficeId is not null)
            {
                <MudButton Href="/settings/offices" Variant="Variant.Outlined">All Offices</MudButton>
                @if (_careInProgress) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCareAsync">View progress</MudButton> }
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => _showSetup = !_showSetup">@(_showSetup ? "Close setup" : "Add Office")</MudButton>
            }
            <MudButton Variant="Variant.Outlined" Disabled="@(_busy || _refreshing)" OnClick="LoadAsync">Refresh</MudButton>
        </div>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="@(_messageSucceeded ? Severity.Success : Severity.Warning)" role="status">@_message</MudAlert>
    }
    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error">@_loadError Actions are disabled until status can be refreshed.</MudAlert>
    }
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" aria-label="Loading Offices" />
    }
    else if (_fleet is not null && OfficeId is null)
    {
        <div class="office-summary" aria-label="Office summary">
            <div><strong>@_fleet.Nodes.Count</strong><span>Total Offices</span></div>
            <div><strong>@_fleet.Nodes.Count(x => Status(x) == "Ready")</strong><span>Ready</span></div>
            <div><strong>@_fleet.Nodes.Count(x => Status(x) is "Offline" or "Awaiting approval" or "Needs attention")</strong><span>Need attention</span></div>
            <div><strong>@_fleet.Nodes.Count(x => Status(x) == "Draining")</strong><span>Draining</span></div>
        </div>
        @if (_showSetup)
        {
            <MudPaper Elevation="1" Class="surface-panel command-section-wide">
                <AgentExecutionSetupStep ShowNavigation="false" OnStatusChanged="_ => LoadAsync()" />
            </MudPaper>
        }
        <MudPaper Elevation="1" Class="surface-panel command-section-wide">
            <div class="office-toolbar">
                <MudTextField T="string" Label="Find an Office" Placeholder="Name, machine, or pool" Immediate="true" @bind-Value="_search" />
                <MudSelect T="string" Label="Status" @bind-Value="_statusFilter">
                    <MudSelectItem T="string" Value='@("all")'>All statuses</MudSelectItem>
                    <MudSelectItem T="string" Value='@("Ready")'>Ready</MudSelectItem>
                    <MudSelectItem T="string" Value='@("attention")'>Needs attention</MudSelectItem>
                    <MudSelectItem T="string" Value='@("Draining")'>Draining</MudSelectItem>
                    <MudSelectItem T="string" Value='@("Revoked")'>Revoked</MudSelectItem>
                </MudSelect>
            </div>
            @if (_fleet.Nodes.Count == 0)
            {
                <div class="office-empty"><MudText Typo="Typo.h6">No Offices yet</MudText><MudText>Add an Office to run agent builds and work on this server.</MudText></div>
            }
            else if (!VisibleOffices.Any())
            {
                <div class="office-empty">No Offices match your search and status filter.</div>
            }
            else
            {
                <div class="office-table-scroll">
                    <table class="office-table">
                        <caption class="office-sr-only">All Offices associated with this server</caption>
                        <thead><tr><th scope="col">Office</th><th scope="col">Status</th><th scope="col">Version</th><th scope="col">Active work</th><th scope="col">Last seen</th><th scope="col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var node in VisibleOffices)
                            {
                                <tr @key="node.Id">
                                    <td><a class="office-name" href="@OfficeUrl(node.Id)">@node.Name</a><span class="office-meta">@node.MachineName · @node.OperatingSystem</span><span class="office-meta">@PoolName(node.ExecutionPoolId)</span></td>
                                    <td><MudChip T="string" Size="Size.Small" Color="@StatusColor(node)">@Status(node)</MudChip></td>
                                    <td>@node.NodeVersion</td>
                                    <td>@ActiveWorkLabel(node.Id)</td>
                                    <td>@Heartbeat(node.LastHeartbeatAt)</td>
                                    <td><div class="office-actions"><MudButton Href="@OfficeUrl(node.Id)" Size="Size.Small">Details</MudButton>
                                    @if (node.Status != "revoked" && node.Status != "pendingapproval")
                                    {
                                        <MudButton Href="@(OfficeUrl(node.Id) + "#upgrade")" Size="Size.Small">Repair</MudButton>
                                    }
                                    @if (node.Status == "ready")
                                    {
                                        <MudButton Size="Size.Small" Disabled="@(!CanAct(node))" OnClick='@(() => NodeActionAsync(node.Id, "drain"))'>Drain</MudButton>
                                    }
                                    else if (node.Status == "draining")
                                    {
                                        <MudButton Size="Size.Small" Disabled="@(!CanAct(node))" OnClick='@(() => NodeActionAsync(node.Id, "resume"))'>Resume</MudButton>
                                    }
                                    </div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <MudText Typo="Typo.caption" Class="mt-3">Server-wide list · Updated @Heartbeat(_lastUpdated) · Refreshes every 15 seconds</MudText>
        </MudPaper>
        <MudExpansionPanels>
            <MudExpansionPanel Text="Advanced: workload pools and routing">
        <MudPaper Elevation="1" Class="surface-panel command-section-wide">
            <MudText Typo="Typo.h5">Pools</MudText>
            <MudText Color="Color.Secondary">Pools define workload limits, required node labels, business allowlists, and global build/runtime defaults.</MudText>
            <MudGrid Class="mt-2">
                <MudItem xs="12" md="3"><MudTextField Label="New pool name" @bind-Value="_newPoolName" /></MudItem>
                <MudItem xs="12" md="2"><MudNumericField T="int" Label="Workload limit" Min="1" Max="100000" @bind-Value="_newPoolLimit" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField Label="Required labels" HelperText="region=west,tier=gpu" @bind-Value="_newPoolLabels" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField Label="Allowed businesses" HelperText="Empty allows all" @bind-Value="_newPoolBusinesses" /></MudItem>
                <MudItem xs="12" md="1" Class="d-flex align-center"><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@ActionsDisabled" OnClick="CreatePoolAsync">Add</MudButton></MudItem>
            </MudGrid>
            @foreach (var pool in _fleet.Pools)
            {
                var edit = _poolEdits[pool.Id];
                <MudPaper Outlined="true" Class="pa-4 mt-3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.h6">@pool.Name</MudText>
                            @if (pool.IsDefaultBuildPool) { <MudChip T="string" Size="Size.Small" Color="Color.Primary">Build default</MudChip> }
                            @if (pool.IsDefaultRuntimePool) { <MudChip T="string" Size="Size.Small" Color="Color.Secondary">Runtime default</MudChip> }
                            @if (!pool.IsEnabled) { <MudChip T="string" Size="Size.Small" Color="Color.Warning">Disabled</MudChip> }
                        </MudStack>
                        <MudText Typo="Typo.caption">@pool.ReadyNodeCount/@pool.NodeCount ready offices | @pool.ActiveAssignmentCount active assignments</MudText>
                    </MudStack>
                    <MudGrid Class="mt-2">
                        <MudItem xs="12" md="3"><MudTextField Label="Name" @bind-Value="edit.Name" /></MudItem>
                        <MudItem xs="12" md="2"><MudNumericField T="int" Label="Workload limit" Min="1" Max="100000" @bind-Value="edit.MaximumActiveWorkloads" /></MudItem>
                        <MudItem xs="12" md="3"><MudTextField Label="Required labels" HelperText="key=value, comma separated" @bind-Value="edit.RequiredLabels" /></MudItem>
                        <MudItem xs="12" md="3"><MudTextField Label="Allowed businesses" HelperText="Empty allows all" @bind-Value="edit.AllowedBusinessIds" /></MudItem>
                        <MudItem xs="12" md="1" Class="d-flex align-center"><MudCheckBox T="bool" Label="Enabled" @bind-Value="edit.IsEnabled" /></MudItem>
                    </MudGrid>
                    <MudStack Row="true" Spacing="1" Class="mt-2" Style="flex-wrap: wrap">
                        <MudButton Variant="Variant.Filled" Disabled="@ActionsDisabled" OnClick="() => SavePoolAsync(pool.Id)">Save policy</MudButton>
                        @if (!pool.IsDefaultBuildPool)
                        {
                            <MudButton Variant="Variant.Outlined" Disabled="@(ActionsDisabled || !edit.IsEnabled)" OnClick="() => SavePoolAsync(pool.Id, setBuildDefault: true)">Make build default</MudButton>
                        }
                        @if (!pool.IsDefaultRuntimePool)
                        {
                            <MudButton Variant="Variant.Outlined" Disabled="@(ActionsDisabled || !edit.IsEnabled)" OnClick="() => SavePoolAsync(pool.Id, setRuntimeDefault: true)">Make runtime default</MudButton>
                        }
                        @if (!pool.IsDefaultBuildPool && !pool.IsDefaultRuntimePool)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@ActionsDisabled" OnClick="() => DeletePoolAsync(pool.Id)">Delete</MudButton>
                        }
                    </MudStack>
                </MudPaper>
            }
        </MudPaper>

        <MudPaper Elevation="1" Class="surface-panel command-section-wide">
            <MudText Typo="Typo.h5">Runtime pool overrides</MudText>
            <MudText Color="Color.Secondary">Agents use the global runtime pool unless an administrator assigns an installation to another enabled pool.</MudText>
            @if (_fleet.InstallationOverrides.Count == 0)
            {
                <MudText Class="mt-3">No active agent installations are available.</MudText>
            }
            @foreach (var installation in _fleet.InstallationOverrides)
            {
                <MudPaper Outlined="true" Class="pa-3 mt-3">
                    <MudGrid>
                        <MudItem xs="12" md="5">
                            <MudText><strong>@installation.AgentName</strong></MudText>
                            <MudText Typo="Typo.caption">Business @installation.BusinessId | effective pool @installation.EffectiveExecutionPoolName</MudText>
                        </MudItem>
                        <MudItem xs="12" md="7">
                            <MudSelect T="string" Label="Runtime execution pool" Value="@PoolSelection(installation)"
                                       ValueChanged="value => SetInstallationPoolAsync(installation.InstallationId, value)" Disabled="@ActionsDisabled">
                                <MudSelectItem T="string" Value="@DefaultPoolSelection">Use global runtime default</MudSelectItem>
                                @foreach (var pool in _fleet.Pools.Where(x => x.IsEnabled))
                                {
                                    <MudSelectItem T="string" Value="@PoolValue(pool.Id)">@pool.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
        </MudPaper>


            </MudExpansionPanel>
        </MudExpansionPanels>
    }
    else if (_fleet is not null && SelectedOffice is { } node)
    {
        <LocalOfficeUpgrade @key="node.Id" @ref="_officeCare" Office="node" Disabled="ActionsDisabled" PackageUrl="PackageUrl(node)"
            ShowSummary="false" ActiveWork="ActiveWork(node.Id)" InProgressChanged="CareProgressChanged"
            OnSessionChanged="session => _careSession = session" ActionMessage="_message" ActionSucceeded="_messageSucceeded"
            OnChanged="LoadAsync" OnResume='@(() => NodeActionAsync(node.Id, "resume"))' OnPause='@(() => NodeActionAsync(node.Id, "drain"))' />
        <MudTabs @bind-ActivePanelIndex="_activeTab" KeepPanelsAlive="true" Elevation="0" Rounded="true" Class="office-tabs">
        <MudTabPanel Text="Overview">
        <MudPaper Elevation="1" Class="surface-panel command-section-wide">
            <div class="office-detail-heading"><div><MudChip T="string" Color="@StatusColor(node)">@Status(node)</MudChip><MudText>@node.MachineName · @node.OperatingSystem / @node.Architecture</MudText></div>
                <div class="office-actions">
                    @if (node.Status == "ready")
                    {
                        <MudButton Variant="Variant.Outlined" Disabled="@(!CanAct(node) || _careInProgress)" OnClick='@(() => NodeActionAsync(node.Id, "drain"))'>Pause new work</MudButton>
                    }
                    else if (node.Status == "draining")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanAct(node) || _careInProgress)" OnClick='@(() => NodeActionAsync(node.Id, "resume"))'>Allow new work</MudButton>
                    }
                    @if (node.Status == "pendingapproval")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@ActionsDisabled" OnClick="() => ApproveAsync(node.Id)">Approve Office</MudButton>
                    }
                </div>
            </div>
            <div class="office-facts">
                <div><span>Installed version</span><strong>@node.NodeVersion</strong></div>
                <div><span>Workload pool</span><strong>@PoolName(node.ExecutionPoolId)</strong></div>
                <div><span>Active work</span><strong>@ActiveWorkLabel(node.Id)</strong></div>
                <div><span>Last seen</span><strong>@Heartbeat(node.LastHeartbeatAt)</strong></div>
                <div><span>Capacity</span><strong>@node.AllocatableCpuCount CPU · @((node.AllocatableMemoryMb / 1024d).ToString("0.#")) GB memory</strong></div>
                <div><span>Work limit</span><strong>@node.MaximumConcurrentWorkloads concurrent workloads</strong></div>
            </div>
            @if (Status(node) == "Offline")
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">
                    This Office isn't connected. Open Office care to get it working again.
                </MudAlert>
            }
            else if (node.Status == "draining")
            {
                <MudText Class="mt-3">New work is paused. Current work is allowed to finish.</MudText>
            }
        </MudPaper>
        <MudPaper Elevation="1" Class="surface-panel command-section-wide" id="upgrade">
            <MudText Typo="Typo.h5">@(_careInProgress ? "Maintenance in progress" : "Office care")</MudText>
            <MudText Class="mt-2">@(_careInProgress ? "You can check progress at any time." : "Repair the connection or update the Office software with step-by-step help.")</MudText>
            @if (node.Status is "revoked" or "pendingapproval")
            {
                <MudAlert Severity="Severity.Warning">@(node.Status == "revoked" ? "This Office's access was removed. Add it again to restore access." : "Approve this Office before managing it.")</MudAlert>
            }
            <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCareAsync">@(_careInProgress ? "View progress" : "Open Office care")</MudButton>
        </MudPaper>
        <MudExpansionPanels><MudExpansionPanel Text="Connection details and diagnostics">
        <MudPaper Elevation="1" Class="surface-panel command-section-wide">
            <MudText Typo="Typo.h5">Connection and capabilities</MudText>
            <MudText>Certificate expires: @Heartbeat(node.CertificateExpiresAt)</MudText>
            <MudText Typo="Typo.caption">Office ID: @node.Id · Protocol @node.ProtocolVersion</MudText>
            @if (node.Providers.Count == 0) { <MudText Class="mt-3">No capabilities have been reported yet.</MudText> }
            @foreach (var provider in node.Providers)
            {
                <div class="office-provider"><strong>@provider.ProviderId</strong><MudChip T="string" Size="Size.Small" Color="@(provider.IsAvailable ? Color.Success : Color.Warning)">@(provider.IsAvailable ? "Available" : "Unavailable")</MudChip>
                    <p>@(provider.SupportsBuilderWorkloads ? "Builds" : "") @(provider.SupportsRuntimeWorkloads ? "Agent runtimes" : "")</p>
                    @if (!provider.IsAvailable) { <p>@provider.UnavailableReason</p> }
                    <span class="office-meta">Certification expires: @Heartbeat(provider.CertificationExpiresAt)</span>
                </div>
            }
            @if (node.Labels.TryGetValue("csweet.security.profile", out var profile))
            {
                <MudText Class="mt-3">Security profile: @profile · @(node.Labels.GetValueOrDefault("csweet.security.mixed-use") == "true" ? "Shared-use machine" : "Dedicated machine")</MudText>
            }
        </MudPaper>
        </MudExpansionPanel></MudExpansionPanels>
        </MudTabPanel>
        <MudTabPanel Text="Work &amp; activity">
        @if (_careSession is { } care)
        {
            <MudPaper Elevation="1" Class="surface-panel command-section-wide">
                <MudText Typo="Typo.h6">Office maintenance</MudText>
                <MudText>@care.PhaseDisplayName</MudText>
                <MudText Typo="Typo.body2">@care.Message</MudText>
                <MudButton OnClick="OpenCareAsync">View details</MudButton>
            </MudPaper>
        }
        <MudPaper Elevation="1" Class="surface-panel command-section-wide">
            <MudText Typo="Typo.h5">Recent work</MudText>
            <MudText Class="mt-2">Active jobs: @ActiveWorkLabel(node.Id)</MudText>
            @if (_activityError is not null) { <MudAlert Severity="Severity.Warning">@_activityError</MudAlert> }
            else if (_activity is null) { <MudText>Loading work history…</MudText> }
            else if (_activity.RecentAssignments.Count == 0) { <MudText Class="mt-3">No work has been assigned to this Office.</MudText> }
            else
            {
                <div class="office-table-scroll"><table class="office-table"><caption class="office-sr-only">Latest 50 workloads for @node.Name</caption>
                    <thead><tr><th scope="col">Queued</th><th scope="col">Work</th><th scope="col">Status</th><th scope="col">Outcome</th></tr></thead><tbody>
                    @foreach (var assignment in _activity.RecentAssignments)
                    {
                        <tr><td>@Heartbeat(assignment.QueuedAt)</td><td>@WorkName(assignment.WorkloadKind)</td><td>@assignment.Status</td><td>@if (assignment.FailureCode is { } failure) { <details><summary>View details</summary>@failure</details> } else { <span>—</span> }</td></tr>
                    }
                </tbody></table></div>
            }
        </MudPaper>
        </MudTabPanel>
        <MudTabPanel Text="Settings">
        <MudPaper Elevation="1" Class="surface-panel command-section-wide">
            <MudText Typo="Typo.h5">Office settings</MudText>
            <MudTextField Label="Office name" @bind-Value="_officeName" Disabled="@(ActionsDisabled || _careInProgress)" MaxLength="200" />
            <MudSelect T="Guid" Label="Workload group" @bind-Value="_officePool" Disabled="@(ActionsDisabled || _careInProgress)">
                @foreach (var pool in _fleet.Pools.Where(x => x.IsEnabled || x.Id == node.ExecutionPoolId))
                { <MudSelectItem T="Guid" Value="pool.Id">@pool.Name</MudSelectItem> }
            </MudSelect>
            <MudText Typo="Typo.body2" Class="mt-3">This computer reports a limit of @node.MaximumConcurrentWorkloads jobs at once. Its capacity is managed by the Office installation.</MudText>
            <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(ActionsDisabled || _careInProgress || string.IsNullOrWhiteSpace(_officeName))" OnClick="SaveOfficeAsync">Save changes</MudButton>
        </MudPaper>
        <MudExpansionPanels>
            <MudExpansionPanel Text="Office labels and access">
                <MudTextField Label="Office labels" HelperText="key=value, comma separated" @bind-Value="_nodeLabelEdits[node.Id]" Disabled="@(ActionsDisabled || _careInProgress)" />
                <MudButton Disabled="@(ActionsDisabled || _careInProgress)" OnClick="() => SaveNodeLabelsAsync(node.Id)">Save labels</MudButton>
                @if (node.Status != "revoked")
                {
                    <MudDivider Class="my-4" />
                    <MudText>Removing access disconnects this Office and stops its current work. You will need to add the Office again to reconnect it.</MudText>
                    @if (_confirmRevocation)
                    {
                        <MudAlert Severity="Severity.Warning">Revoke @node.Name? Any active work will lose access immediately.</MudAlert>
                        <MudButton Color="Color.Error" Disabled="@(ActionsDisabled || _careInProgress)" OnClick="() => RevokeAsync(node.Id)">Confirm revocation</MudButton>
                        <MudButton OnClick="() => _confirmRevocation = false">Cancel</MudButton>
                    }
                    else
                    {
                        <MudButton Color="Color.Error" Disabled="@(ActionsDisabled || _careInProgress)" OnClick="() => _confirmRevocation = true">Revoke access</MudButton>
                    }
                }
            </MudExpansionPanel>
        </MudExpansionPanels>
        </MudTabPanel>
        </MudTabs>
    }
    else if (_fleet is not null)
    {
        <MudAlert Severity="Severity.Warning">This Office is not associated with this server. Return to All Offices to choose another.</MudAlert>
    }
</div>

@code {
    [Parameter] public Guid? OfficeId { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _pollTask;
    private Guid? _loadedOfficeId;
    private bool _refreshing;
    private bool _showSetup;
    private bool _confirmRevocation;
    private LocalOfficeUpgrade? _officeCare;
    private LocalOfficeSetupSessionResponse? _careSession;
    private bool _careInProgress, _openCareOnRender;
    private int _activeTab;
    private Guid? _settingsOffice;
    private string _officeName = "";
    private Guid _officePool;
    private Task OpenCareAsync() => _officeCare?.OpenAsync() ?? Task.CompletedTask;
    private static string WorkName(string kind) => kind.ToLowerInvariant() switch { "builder" => "Agent build", "runtime" => "Agent run", "toolchainbuild" => "Application build", _ => kind };
    private void CareProgressChanged(bool inProgress) => _careInProgress = inProgress;
    private Task SaveOfficeAsync() => MutateAsync(HttpMethod.Put, $"api/execution-fleet/nodes/{OfficeId:D}/settings", new UpdateOfficeSettingsRequest(_officeName, _officePool));
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_openCareOnRender && _officeCare is not null) { _openCareOnRender = false; await OpenCareAsync(); }
    }
    private string _search = "";
    private string _statusFilter = "all";
    private string? _loadError;
    private string? _activityError;
    private DateTimeOffset? _lastUpdated;
    private OfficeActivityResponse? _activity;
    private OfficePackageLinksResponse? _packages;
    private ExecutionNodeSummaryResponse? SelectedOffice => _fleet?.Nodes.FirstOrDefault(x => x.Id == OfficeId);
    private bool ActionsDisabled => _busy || _lastUpdated is null || _loadError is not null || _lastUpdated < DateTimeOffset.UtcNow.AddSeconds(-30);
    private string Status(ExecutionNodeSummaryResponse node) => OfficePresentation.Status(node, DateTimeOffset.UtcNow);
    private Color StatusColor(ExecutionNodeSummaryResponse node) => Status(node) == "Ready" ? Color.Success : Status(node) == "Revoked" ? Color.Error : Color.Warning;
    private bool CanAct(ExecutionNodeSummaryResponse node) => !ActionsDisabled && OfficePresentation.IsConnected(node, DateTimeOffset.UtcNow);
    private int? ActiveWork(Guid id) => id == OfficeId
        ? _activityError is null ? _activity?.ActiveAssignmentCount : null
        : _fleet?.ActiveAssignmentsByOffice?.TryGetValue(id, out var count) == true ? count : null;
    private string ActiveWorkLabel(Guid id) => ActiveWork(id)?.ToString() ?? "Unknown";
    private bool ReadyForUpgrade(ExecutionNodeSummaryResponse node) => !ActionsDisabled && OfficePresentation.ReadyForUpgrade(node, ActiveWork(node.Id), DateTimeOffset.UtcNow);
    private string UpgradeReadiness(ExecutionNodeSummaryResponse node) => !CanAct(node)
        ? "The server cannot confirm that this Office is connected and idle. Check the services and local maintenance state on the Office machine before upgrading."
        : node.Status != "draining" ? "Drain this Office before running an upgrade."
        : ActiveWork(node.Id) is null ? "Waiting for a verified active-work count."
        : $"Waiting for {ActiveWork(node.Id)} active workload(s) to finish.";
    private string PoolName(Guid id) => _fleet?.Pools.FirstOrDefault(x => x.Id == id)?.Name ?? "Unknown pool";
    private static string OfficeUrl(Guid id) => $"/settings/offices/{id:D}";
    private IEnumerable<ExecutionNodeSummaryResponse> VisibleOffices => (_fleet?.Nodes ?? [])
        .Where(x => string.IsNullOrWhiteSpace(_search) || $"{x.Name} {x.MachineName} {PoolName(x.ExecutionPoolId)}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(x => _statusFilter == "all" || (_statusFilter == "attention" ? Status(x) is "Offline" or "Awaiting approval" or "Needs attention" : Status(x) == _statusFilter));
    private string? PackageUrl(ExecutionNodeSummaryResponse node)
    {
        var url = node.OperatingSystem switch { "windows" => _packages?.WindowsPackageOverrideUrl, "linux" => _packages?.LinuxPackageOverrideUrl, "macos" => _packages?.MacOsPackageOverrideUrl, _ => null };
        return Uri.TryCreate(url, UriKind.Absolute, out var uri) && uri.Scheme == "https" ? uri.AbsoluteUri : null;
    }
    private sealed record RecoveryPackageLink(string? Url);
    private static string InstallerInstructions(ExecutionNodeSummaryResponse node) => node.OperatingSystem switch
    {
        "windows" => "Use the signed Windows installer with administrator access.",
        "linux" => "Use the signed package for this Linux machine and its architecture with administrator access.",
        "macos" => "Use the signed macOS package with administrator access.",
        _ => "Use the signed installer for this machine's operating system and architecture."
    };
    private ExecutionFleetAdministrationResponse? _fleet;
    private bool _loading = true;
    private bool _busy;
    private bool _messageSucceeded;
    private string? _message;
    private string _newPoolName = string.Empty;
    private int _newPoolLimit = 100;
    private string _newPoolLabels = string.Empty;
    private string _newPoolBusinesses = string.Empty;
    private readonly Dictionary<Guid, PoolEditModel> _poolEdits = [];
    private readonly Dictionary<Guid, string> _nodeLabelEdits = [];
    private const string DefaultPoolSelection = "default";

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedOfficeId != OfficeId)
        {
            _activity = null;
            _packages = null;
            _confirmRevocation = false;
            _activeTab = 0;
            _careInProgress = false;
            _officeCare = null;
            _careSession = null;
            _settingsOffice = null;
            _openCareOnRender = Navigation.Uri.EndsWith("#upgrade", StringComparison.Ordinal);
            _loadedOfficeId = OfficeId;
        }
        await LoadAsync();
        _pollTask ??= PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
                await InvokeAsync(async () => { if (!_busy) await LoadAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private async Task LoadAsync()
    {
        if (_refreshing) return;
        _refreshing = true;
        var officeId = OfficeId;
        try
        {
            var fleet = await Http.GetFromJsonAsync<ExecutionFleetAdministrationResponse>("api/execution-fleet", _lifetime.Token);
            if (fleet is null) throw new InvalidDataException("The server returned no Office status.");
            _fleet = fleet;
            if (SelectedOffice is { } selectedOffice && _settingsOffice != selectedOffice.Id)
            {
                _settingsOffice = selectedOffice.Id;
                _officeName = selectedOffice.Name;
                _officePool = selectedOffice.ExecutionPoolId;
            }
            foreach (var pool in fleet.Pools) _poolEdits.TryAdd(pool.Id, PoolEditModel.From(pool));
            foreach (var node in fleet.Nodes) _nodeLabelEdits.TryAdd(node.Id, string.Join(',', node.Labels
                .Where(x => !x.Key.StartsWith("csweet.security.", StringComparison.Ordinal))
                .Select(x => $"{x.Key}={x.Value}")));
            _loadError = null;
            _lastUpdated = DateTimeOffset.UtcNow;
            if (officeId is { } id && officeId == OfficeId && fleet.Nodes.Any(x => x.Id == id))
            {
                try
                {
                    var activity = await Http.GetFromJsonAsync<OfficeActivityResponse>($"api/execution-fleet/nodes/{id:D}/activity", _lifetime.Token);
                    if (officeId == OfficeId) { _activity = activity; _activityError = activity is null ? "Work status is unavailable." : null; }
                }
                catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException)
                {
                    if (officeId == OfficeId) { _activity = null; _activityError = "Could not refresh this Office's work status."; }
                }
                if (_packages is null)
                {
                    try
                    {
                        _packages = (await SetupApi.GetExecutionCapacityStatusAsync(_lifetime.Token)).Packages;
                        var selected = fleet.Nodes.Single(x => x.Id == id);
                        if (_packages is not null && selected.OperatingSystem == "windows" && _packages.WindowsPackageOverrideUrl is null)
                        {
                            var download = await Http.GetFromJsonAsync<RecoveryPackageLink>($"api/execution-fleet/nodes/{id:D}/recovery-package", _lifetime.Token);
                            if (download?.Url is { } url) _packages = _packages with { WindowsPackageOverrideUrl = url };
                        }
                    }
                    catch (Exception exception) when (exception is HttpRequestException or ApiClientException or System.Text.Json.JsonException) { /* The signed releases link remains available. */ }
                }
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or InvalidDataException or TaskCanceledException)
        {
            _loadError = "Could not refresh Offices from the server.";
        }
        finally { _loading = false; _refreshing = false; }
    }

    private async Task ApproveAsync(Guid id)
    {
        if (ActionsDisabled) return;
        _busy = true;
        try
        {
            using var response = await Http.PostAsync($"api/setup/execution-capacity/nodes/{id:D}/approve", null);
            var result = await response.Content.ReadFromJsonAsync<ExecutionCapacityActionResponse>();
            _messageSucceeded = response.IsSuccessStatusCode && result?.Succeeded == true;
            _message = result?.Message ?? "Office approval failed.";
            if (_messageSucceeded) await LoadAsync();
        }
        catch (HttpRequestException) { _messageSucceeded = false; _message = "The request failed. Refresh Office status before trying again."; }
        catch (System.Text.Json.JsonException) { _messageSucceeded = false; _message = "The server returned an unreadable response. Refresh Office status."; }
        finally { _busy = false; }
    }

    public async ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        if (_pollTask is not null) await _pollTask;
        _lifetime.Dispose();
    }

    private async Task CreatePoolAsync()
    {
        if (!TryLabels(_newPoolLabels, out var labels)) return;
        await MutateAsync(HttpMethod.Post, "api/execution-fleet/pools", new CreateExecutionPoolRequest(
            _newPoolName, _newPoolLimit, labels, Values(_newPoolBusinesses)));
        if (_messageSucceeded)
        {
            _newPoolName = _newPoolLabels = _newPoolBusinesses = string.Empty;
            _newPoolLimit = 100;
        }
    }

    private async Task SavePoolAsync(Guid poolId, bool setBuildDefault = false, bool setRuntimeDefault = false)
    {
        var edit = _poolEdits[poolId];
        if (!TryLabels(edit.RequiredLabels, out var labels)) return;
        await MutateAsync(HttpMethod.Put, $"api/execution-fleet/pools/{poolId:D}", new UpdateExecutionPoolRequest(
            edit.Name, edit.IsEnabled, edit.MaximumActiveWorkloads, labels, Values(edit.AllowedBusinessIds),
            setBuildDefault, setRuntimeDefault));
    }

    private Task DeletePoolAsync(Guid poolId) =>
        MutateAsync(HttpMethod.Delete, $"api/execution-fleet/pools/{poolId:D}");

    private async Task SetInstallationPoolAsync(Guid installationId, string selection)
    {
        Guid? poolId = selection == DefaultPoolSelection ? null : Guid.Parse(selection);
        await MutateAsync(HttpMethod.Put, $"api/execution-fleet/installations/{installationId:D}/runtime-pool",
            new UpdateAgentExecutionPoolRequest(poolId));
    }

    private async Task SaveNodeLabelsAsync(Guid nodeId)
    {
        if (ActionsDisabled) return;
        if (!TryLabels(_nodeLabelEdits[nodeId], out var labels)) return;
        _busy = true;
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/execution-fleet/nodes/{nodeId:D}/labels", new UpdateExecutionNodeLabelsRequest(labels));
            _messageSucceeded = response.IsSuccessStatusCode;
            _message = response.IsSuccessStatusCode
                ? "Office labels were updated."
                : "The Office labels were rejected.";
            if (_messageSucceeded) await LoadAsync();
        }
        catch (HttpRequestException) { _messageSucceeded = false; _message = "The request failed. Refresh Office status before trying again."; }
        catch (System.Text.Json.JsonException) { _messageSucceeded = false; _message = "The server returned an unreadable response. Refresh Office status."; }
        finally { _busy = false; }
    }

    private async Task MutateAsync(HttpMethod method, string uri, object? body = null)
    {
        if (ActionsDisabled) return;
        _busy = true;
        try
        {
            using var request = new HttpRequestMessage(method, uri)
            {
                Content = body is null ? null : JsonContent.Create(body)
            };
            using var response = await Http.SendAsync(request);
            var result = await response.Content.ReadFromJsonAsync<ExecutionFleetMutationResponse>();
            _messageSucceeded = result?.Succeeded == true;
            _message = result?.Message ?? "The Office settings could not be updated.";
            if (_messageSucceeded) await LoadAsync();
        }
        catch (HttpRequestException) { _messageSucceeded = false; _message = "The request failed. Refresh Office status before trying again."; }
        catch (System.Text.Json.JsonException) { _messageSucceeded = false; _message = "The server returned an unreadable response. Refresh Office status."; }
        finally { _busy = false; }
    }

    private bool TryLabels(string value, out IReadOnlyDictionary<string, string> labels)
    {
        var result = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var item in Values(value))
        {
            var parts = item.Split('=', 2, StringSplitOptions.TrimEntries);
            if (parts.Length != 2 || string.IsNullOrWhiteSpace(parts[0]) || !result.TryAdd(parts[0], parts[1]))
            {
                labels = result;
                _messageSucceeded = false;
                _message = "Required labels must use unique key=value entries separated by commas.";
                return false;
            }
        }
        labels = result;
        return true;
    }

    private static IReadOnlyList<string> Values(string value) => value.Split(',',
        StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string PoolSelection(AgentExecutionPoolOverrideResponse installation) =>
        installation.ConfiguredExecutionPoolId?.ToString("D") ?? DefaultPoolSelection;
    private static string PoolValue(Guid poolId) => poolId.ToString("D");

    private async Task NodeActionAsync(Guid id, string action)
    {
        if (ActionsDisabled) return;
        _busy = true;
        try
        {
            using var response = await Http.PostAsync($"api/execution-fleet/nodes/{id:D}/{action}", null);
            ExecutionFleetMutationResponse? result = null;
            if (response.Content.Headers.ContentLength is not 0)
            {
                try { result = await response.Content.ReadFromJsonAsync<ExecutionFleetMutationResponse>(); }
                catch (System.Text.Json.JsonException) { }
            }

            _messageSucceeded = response.IsSuccessStatusCode && result?.Succeeded != false;
            _message = result?.Message ?? (response.IsSuccessStatusCode
                ? action == "drain" ? "The Office is draining and will stop receiving new work." : "The Office resumed."
                : "The Office action failed. Refresh its status and try again.");
            if (_messageSucceeded) await LoadAsync();
        }
        catch (HttpRequestException) { _messageSucceeded = false; _message = "The request failed. Refresh Office status before trying again."; }
        catch (System.Text.Json.JsonException) { _messageSucceeded = false; _message = "The server returned an unreadable response. Refresh Office status."; }
        finally { _busy = false; }
    }

    private async Task RevokeAsync(Guid id)
    {
        if (ActionsDisabled) return;
        _busy = true;
        try
        {
            using var response = await Http.DeleteAsync($"api/execution-fleet/nodes/{id:D}");
            response.EnsureSuccessStatusCode();
            _confirmRevocation = false;
            _messageSucceeded = true;
            _message = "Office access was revoked.";
            await LoadAsync();
        }
        catch (HttpRequestException) { _messageSucceeded = false; _message = "The request failed. Refresh Office status before trying again."; }
        catch (System.Text.Json.JsonException) { _messageSucceeded = false; _message = "The server returned an unreadable response. Refresh Office status."; }
        finally { _busy = false; }
    }

    private static string Heartbeat(DateTimeOffset? value) => value?.ToLocalTime().ToString("g") ?? "never";

    private sealed class PoolEditModel
    {
        public string Name { get; set; } = string.Empty;
        public bool IsEnabled { get; set; }
        public int MaximumActiveWorkloads { get; set; }
        public string RequiredLabels { get; set; } = string.Empty;
        public string AllowedBusinessIds { get; set; } = string.Empty;

        public static PoolEditModel From(ExecutionPoolResponse pool) => new()
        {
            Name = pool.Name,
            IsEnabled = pool.IsEnabled,
            MaximumActiveWorkloads = pool.MaximumActiveWorkloads,
            RequiredLabels = string.Join(',', pool.RequiredLabels.Select(x => $"{x.Key}={x.Value}")),
            AllowedBusinessIds = string.Join(',', pool.AllowedBusinessIds)
        };
    }
}
