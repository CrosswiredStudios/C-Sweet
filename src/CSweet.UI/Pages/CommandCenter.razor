@page "/organizations/{OrganizationId:guid}/command-center"
@using CSweet.Contracts.Core
@using CSweet.Contracts.Realtime
@inject HttpClient Http
@inject AppRealtimeState Realtime
@implements IDisposable

<PageTitle>Company overview - C-Sweet</PageTitle>
<div class="company-overview aurora-page">
    <MudPaper Elevation="0" Class="page-header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">Company overview</MudText>
            <MudText Typo="Typo.h3">@(_organization?.Name ?? "Your company")</MudText>
            <MudText Color="Color.Secondary">Decisions, company health, and the latest from your project leads.</MudText>
        </div>
        <div class="overview-actions">
            <MudButton Href="@($"/organizations/{OrganizationId}/executive-briefings")" Variant="Variant.Text">Briefing settings</MudButton>
            @if (_errors.Count > 0)
            {
                <MudButton OnClick="RefreshAsync" Disabled="_loading">Retry failed updates</MudButton>
            }
        </div>
    </MudPaper>
    @if (_layoutMessage is not null)
    {
        <div role="alert" class="layout-status">@_layoutMessage</div>
    }
    @if (_loading)
    {
        <div class="overview-loading" aria-label="Updating overview"><MudProgressLinear Indeterminate="true" Color="Color.Primary" /></div>
    }
    <div class="overview-widgets">
    @foreach (var widget in _order)
    {
        var index = _order.IndexOf(widget);
        <section @key="widget" class="overview-widget @(widget + "-widget") @(_dragging == widget ? "is-dragging" : "")"
                 aria-label="@Title(widget)" @ondragover:preventDefault @ondrop="() => DropAsync(widget)">
            <header class="widget-header">
                <div class="widget-heading">
                    <span class="drag-handle" draggable="@(_layoutLoaded && !_saving ? "true" : "false")" @ondragstart="() => _dragging = widget" @ondragend="() => _dragging = null" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.DragIndicator" /></span>
                    <MudText Typo="Typo.h6">@Title(widget)</MudText>
                </div>
                <div class="widget-controls">
                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward" Size="Size.Small" aria-label="@($"Move {Title(widget)} up")" Disabled="@(index == 0 || _saving || !_layoutLoaded)" OnClick="() => MoveAsync(widget, index - 1)" />
                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowDownward" Size="Size.Small" aria-label="@($"Move {Title(widget)} down")" Disabled="@(index == _order.Count - 1 || _saving || !_layoutLoaded)" OnClick="() => MoveAsync(widget, index + 1)" />
                </div>
            </header>
            <div class="widget-content">
                @if (widget == "attention")
                {
                    <div class="attention-tabs" role="tablist" aria-label="Action queues">
                        @for (var tabIndex = 0; tabIndex < AttentionTabs.Length; tabIndex++)
                        {
                            var tab = tabIndex;
                            <button @ref="_attentionTabButtons[tab]" type="button" role="tab" id="@($"attention-tab-{tab}")"
                                    aria-controls="@($"attention-panel-{tab}")" aria-selected="@(_attentionTab == tab ? "true" : "false")"
                                    tabindex="@(_attentionTab == tab ? 0 : -1)" @onclick="() => _attentionTab = tab" @onkeydown="e => NavigateAttentionAsync(e, tab)">
                                @AttentionTabs[tab]
                                @if (tab == 1 && _approvals is not null) { <span class="tab-count">@PendingApprovals.Count()</span> }
                                @if (tab == 2 && _approvals is not null && _hiring is not null) { <span class="tab-count">@(PendingHiringApprovals.Count() + PendingRecommendations.Count())</span> }
                            </button>
                        }
                    </div>
                    <div class="attention-panel" role="tabpanel" id="attention-panel-0" aria-labelledby="attention-tab-0" aria-label="Decisions" tabindex="0" hidden="@(_attentionTab != 0)">
                        <PendingAgentQuestions OrganizationId="OrganizationId" SummaryOnly="true" />
                    </div>
                    <div class="attention-panel" role="tabpanel" id="attention-panel-1" aria-labelledby="attention-tab-1" aria-label="CEO approvals" tabindex="0" hidden="@(_attentionTab != 1)">
                        @if (_errors.GetValueOrDefault("approvals") is { } approvalError)
                        {
                            <MudAlert Severity="Severity.Warning">@approvalError</MudAlert>
                        }
                        else if (_approvals is not null)
                        {
                            <p class="queue-summary">@PendingApprovals.Count() pending</p>
                            @if (!PendingApprovals.Any())
                            {
                                <div class="empty-inline"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" /><MudText>No approvals need your action.</MudText></div>
                            }
                            @foreach (var approval in PendingApprovals.Take(5))
                            {
                                <div class="approval-row">
                                    <div><MudText Typo="Typo.subtitle1">@approval.Title</MudText><MudText Color="Color.Secondary">@approval.Summary</MudText><MudText Typo="Typo.caption">@approval.RequestedBy · Requested @approval.CreatedAt.ToLocalTime().ToString("g")</MudText></div>
                                    <MudButton Href="@ApprovalsHref" Variant="Variant.Outlined" Color="Color.Primary">Review</MudButton>
                                </div>
                            }
                            <MudButton Href="@ApprovalsHref" Size="Size.Small" Class="mt-2">View all approvals</MudButton>
                        }
                        else { <MudText>Loading approvals…</MudText> }
                    </div>
                    <div class="attention-panel" role="tabpanel" id="attention-panel-2" aria-labelledby="attention-tab-2" aria-label="Hiring" tabindex="0" hidden="@(_attentionTab != 2)">
                        <CompanyHiringSummary @key="OrganizationId" OrganizationId="OrganizationId"
                            Approvals="PendingHiringApprovals.ToList()" Recommendations="PendingRecommendations.ToList()"
                            ApprovalsLoaded="@(_approvals is not null)" RecommendationsLoaded="@(_hiring is not null)"
                            ApprovalError="@_errors.GetValueOrDefault("approvals")" RecommendationError="@_errors.GetValueOrDefault("hiring")" />
                    </div>
                }
                else if (ErrorFor(widget) is { } error)
                {
                    <MudAlert Severity="Severity.Warning">@error</MudAlert>
                }
                else if (widget == "activity")
                {
                    <EmployeePortraitScope OrganizationId="OrganizationId">
                        <CurrentActivity OrganizationId="OrganizationId" RefreshVersion="_activityRefreshVersion" />
                    </EmployeePortraitScope>
                }
                else if (widget == "finance" && _dashboard is not null)
                {
                    var finance = _dashboard.Finance;
                    <DashboardReportingState OrganizationId="OrganizationId" Area="Finance" RoleName="CFO" Purpose="publish your monthly financial metrics" HasReport="@(finance.Report is not null)" Reporters="finance.Reporters" />
                    @if (finance.Report is { } report)
                    {
                        <div class="report-period"><MudText Typo="Typo.subtitle2">@report.Data.AsOf.ToString("MMMM yyyy") · Through @report.Data.AsOf.ToString("MMM d") · @report.Data.Currency</MudText></div>
                        @if (report.Data.AsOf.Year != DateTime.UtcNow.Year || report.Data.AsOf.Month != DateTime.UtcNow.Month)
                        {
                            <MudText Color="Color.Warning">No report for this month yet. Showing the last published period.</MudText>
                        }
                        <dl class="finance-metrics">
                            <div><dt>Revenue</dt><dd>@Money(report.Data.Revenue)</dd></div>
                            <div><dt>Expenses</dt><dd>@Money(report.Data.Expenses)</dd></div>
                            <div><dt>Net profit</dt><dd>@Money(report.Data.Revenue - report.Data.Expenses)</dd></div>
                            <div><dt>Cash balance</dt><dd>@Money(report.Data.CashBalance)</dd></div>
                            <div><dt>Monthly budget</dt><dd>@Money(report.Data.MonthlyBudget)</dd></div>
                        </dl>
                        <footer class="report-footer">Published by @report.ReporterName · @report.PublishedAt.ToLocalTime().ToString("g")</footer>
                    }
                }
                else if (widget == "legal" && _dashboard is not null)
                {
                    var legal = _dashboard.Legal;
                    <DashboardReportingState OrganizationId="OrganizationId" Area="Legal" RoleName="CLO" Purpose="maintain your business entity, legal status, and important dates" HasReport="@(legal.Report is not null)" Reporters="legal.Reporters" />
                    @if (legal.Report is { } report)
                    {
                        <div class="legal-content">
                            <div><MudText Typo="Typo.h6">@report.Data.EntityName</MudText><MudText Color="Color.Secondary">@report.Data.EntityType</MudText><MudChip T="string" Variant="Variant.Outlined">@report.Data.Status</MudChip><MudText Typo="Typo.caption">Verified @report.Data.VerifiedOn.ToString("d")</MudText></div>
                            <div class="legal-dates">
                                <MudText Typo="Typo.subtitle2">Important dates</MudText>
                                @if (report.Data.Obligations.Count == 0) { <MudText Color="Color.Secondary">No upcoming obligations reported.</MudText> }
                                @foreach (var obligation in report.Data.Obligations.OrderBy(x => x.DueDate))
                                {
                                    <div class="legal-date"><span>@obligation.Title</span><span class="@(obligation.DueDate <= DateOnly.FromDateTime(DateTime.Today).AddDays(30) ? "date-attention" : "")">@obligation.DueDate.ToString("MMM d, yyyy") · @DueLabel(obligation.DueDate)</span></div>
                                }
                            </div>
                        </div>
                        <footer class="report-footer">Published by @report.ReporterName · @report.PublishedAt.ToLocalTime().ToString("g")</footer>
                    }
                }
                else if (widget == "projects" && _portfolio is not null)
                {
                    @if (_portfolio.Projects.Count == 0) { <MudText Color="Color.Secondary">No projects yet. Your projects and their leads' updates will appear here.</MudText> }
                    <div class="project-cards">
                        @foreach (var project in _portfolio.Projects)
                        {
                            <article class="project-card">
                                <div class="project-title"><MudLink Href="@($"/organizations/{OrganizationId}/projects/{project.Id}")">@project.Name</MudLink><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@project.Status</MudChip></div>
                                @if (project.LatestLeadUpdate is { } update)
                                {
                                    <p class="project-update">@update.Data.Summary</p>
                                    <div class="report-footer">@update.ReporterName · @update.PublishedAt.ToLocalTime().ToString("g")</div>
                                }
                                else
                                {
                                    <p class="project-update no-update">No lead update yet.</p>
                                    <MudText Typo="Typo.caption">@(project.AccountableManagerOrganizationUserId.HasValue ? "The project lead's first recorded update will appear here." : "Assign a project lead to start receiving updates.")</MudText>
                                }
                            </article>
                        }
                    </div>
                    <MudButton Href="@($"/organizations/{OrganizationId}/projects")" Size="Size.Small" Class="mt-2">View projects</MudButton>
                }
                else
                {
                    <MudText Color="Color.Secondary">Loading @Title(widget).ToLowerInvariant()…</MudText>
                }
            </div>
        </section>
    }
    </div>
</div>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    private OrganizationResponse? _organization;
    private ApprovalDashboardResponse? _approvals;
    private HiringBacklogResponse? _hiring;
    private CompanyDashboardResponse? _dashboard;
    private ProjectPortfolioResponse? _portfolio;
    private List<string> _order = DashboardWidgets.DefaultOrder.ToList();
    private readonly Dictionary<string, string> _errors = [];
    private bool _loading, _saving, _layoutLoaded, _disposed, _refreshQueued;
    private string? _dragging, _layoutMessage;
    private CancellationTokenSource? _loadCancellation;
    private Guid _loadedOrganization;
    private int _activityRefreshVersion;
    private static readonly string[] AttentionTabs = ["Decisions", "Approvals", "Hiring"];
    private readonly ElementReference[] _attentionTabButtons = new ElementReference[3];
    private int _attentionTab;
    private async Task NavigateAttentionAsync(KeyboardEventArgs e, int tab)
    {
        var next = e.Key switch { "ArrowRight" => (tab + 1) % 3, "ArrowLeft" => (tab + 2) % 3, "Home" => 0, "End" => 2, _ => -1 };
        if (next < 0) return;
        _attentionTab = next;
        await _attentionTabButtons[next].FocusAsync(preventScroll: true);
    }
    private string ApprovalsHref => $"/organizations/{OrganizationId}/approvals";
    private IEnumerable<ApprovalDashboardItemResponse> ActionableApprovals => (_approvals?.Items ?? [])
        .Where(x => x.CanDecide && string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.CreatedAt);
    private static bool IsHiringApproval(ApprovalDashboardItemResponse item) =>
        item.Kind is ApprovalDashboardKinds.ResourceChange or ApprovalDashboardKinds.HiringWorkflow;
    private IEnumerable<ApprovalDashboardItemResponse> PendingApprovals => ActionableApprovals.Where(x => !IsHiringApproval(x));
    private IEnumerable<ApprovalDashboardItemResponse> PendingHiringApprovals => ActionableApprovals.Where(IsHiringApproval);
    private IEnumerable<HiringRecommendationResponse> PendingRecommendations => (_hiring?.Recommendations ?? [])
        .Where(x => string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase) && x.RemainingHeadcount > 0)
        .OrderBy(x => x.Priority).ThenBy(x => x.CreatedAt);

    protected override void OnInitialized()
    {
        Realtime.EventReceived += OnRealtimeEvent;
        Realtime.Connected += QueueRefresh;
        Realtime.Reconnected += QueueRefresh;
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedOrganization == OrganizationId) return;
        _loadedOrganization = OrganizationId;
        _organization = null; _approvals = null; _hiring = null; _dashboard = null; _portfolio = null;
        _refreshQueued = false; _attentionTab = 0;
        _order = DashboardWidgets.DefaultOrder.ToList(); _layoutLoaded = false; _layoutMessage = null;
        await RefreshAsync();
    }
    private async Task RefreshAsync()
    {
        _activityRefreshVersion++;
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        var cancellation = _loadCancellation = new();
        var token = cancellation.Token;
        var organizationId = OrganizationId;
        _loading = true; _errors.Clear();
        var prefix = $"api/core/organizations/{organizationId}";
        await Task.WhenAll(
            LoadAsync<OrganizationResponse>($"api/organizations/{organizationId}", "organization", x => _organization = x, token),
            LoadAsync<ApprovalDashboardResponse>($"{prefix}/approvals", "approvals", x => _approvals = x, token),
            LoadAsync<HiringBacklogResponse>($"{prefix}/dashboard/hiring", "hiring", x => _hiring = x, token),
            LoadAsync<CompanyDashboardResponse>($"{prefix}/dashboard", "reports", x => _dashboard = x, token),
            LoadAsync<ProjectPortfolioResponse>($"{prefix}/workstreams/inspection", "projects", x => _portfolio = x, token),
            _layoutLoaded ? Task.CompletedTask : LoadAsync<DashboardLayoutRequest>($"{prefix}/dashboard/layout", "layout", x =>
            {
                _order = DashboardWidgets.Restore(x.Order).ToList();
                _layoutLoaded = true; _layoutMessage = null;
            }, token));
        if (token.IsCancellationRequested) return;
        if (_errors.ContainsKey("layout")) _layoutMessage = "Could not load your saved layout. Retry failed updates to enable reordering.";
        _loading = false;
        if (_refreshQueued)
        {
            _refreshQueued = false;
            await RefreshAsync();
        }
    }
    private async Task LoadAsync<T>(string uri, string key, Action<T> apply, CancellationToken token)
    {
        try
        {
            var result = await Http.GetFromJsonAsync<T>(uri, token);
            if (token.IsCancellationRequested) return;
            if (result is null) throw new HttpRequestException("Empty response.");
            apply(result);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        {
            if (!token.IsCancellationRequested)
                _errors[key] = ex is HttpRequestException { StatusCode: System.Net.HttpStatusCode.Forbidden }
                    ? "You do not have access to this information." : "This information could not be loaded.";
        }
    }
    private string? ErrorFor(string widget) => _errors.GetValueOrDefault(widget is "finance" or "legal" ? "reports" : widget);
    private async Task MoveAsync(string widget, int target)
    {
        if (_saving || !_layoutLoaded || target < 0 || target >= _order.Count) return;
        var next = _order.ToList();
        next.Remove(widget); next.Insert(target, widget);
        await SaveOrderAsync(next);
    }
    private async Task DropAsync(string target)
    {
        var dragged = _dragging; _dragging = null;
        if (dragged is not null && dragged != target) await MoveAsync(dragged, _order.IndexOf(target));
    }
    private async Task SaveOrderAsync(List<string> next)
    {
        if (_saving || !_layoutLoaded) return;
        var organizationId = OrganizationId;
        var previous = _order.ToList();
        _order = next; _saving = true; _layoutMessage = null;
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/core/organizations/{organizationId}/dashboard/layout", new DashboardLayoutRequest(next));
            response.EnsureSuccessStatusCode();
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        {
            if (OrganizationId == organizationId) { _order = previous; _layoutMessage = "Could not save the order. Your previous layout has been restored."; }
        }
        finally { _saving = false; }
    }
    private void OnRealtimeEvent(AppRealtimeEventEnvelope envelope)
    {
        if (_disposed || envelope.OrganizationId != OrganizationId) return;
        if (envelope.EventType is AppRealtimeEvents.ApprovalChanged or AppRealtimeEvents.HiringRecommendationsChanged or AppRealtimeEvents.EmployeeDirectoryChanged or CompanyReportingCapabilities.ReportChanged || Projects.IsProjectResourceEvent(envelope.EventType))
            QueueRefresh();
    }
    private void QueueRefresh() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        if (_loading) { _refreshQueued = true; return; }
        await RefreshAsync();
        if (!_disposed) StateHasChanged();
    });
    private static string Title(string key) => key switch { "attention" => "Needs your attention", "activity" => "Current Activity", "finance" => "Finances", "legal" => "Legal", _ => "Projects & products" };
    private static string Money(decimal? value) => value?.ToString("N2") ?? "Not reported";
    private static string DueLabel(DateOnly date)
    {
        var days = date.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
        return days switch { < 0 => $"{Math.Abs(days)} days overdue", 0 => "Due today", 1 => "Tomorrow", _ => $"In {days} days" };
    }
    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        Realtime.EventReceived -= OnRealtimeEvent;
        Realtime.Connected -= QueueRefresh;
        Realtime.Reconnected -= QueueRefresh;
        _loadCancellation?.Cancel(); _loadCancellation?.Dispose();
    }
}
