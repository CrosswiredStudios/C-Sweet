@page "/settings/source-control"
@layout SettingsLayout
@using CSweet.Contracts.SourceControl
@inject HttpClient Http
@inject IJSRuntime JS
@inject IAppLocalizer L

<PageTitle>@L["SourceControlSettings.PageTitle"]</PageTitle>

<div class="setup-shell">
    @if ((DraftId ?? _returnDraftId) is { } draftId)
    { <MudButton Href="@($"/?create=true&draft={draftId:D}")" StartIcon="@Icons.Material.Outlined.ArrowBack">@L["SourceControlSettings.ReturnToYourBusinessDraft"]</MudButton> }
    <MudPaper Elevation="0" Class="page-header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">@L["SourceControlSettings.EnterprisePlatform"]</MudText>
            <MudText Typo="Typo.h3">@L["SourceControlSettings.SourceControl"]</MudText>
            <MudText Color="Color.Secondary">
                @L["SourceControlSettings.ManageRepositoryStorageAndConnect"]
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Refresh"
                   OnClick="LoadAsync" Disabled="_loading">@L["Common.Refresh"]</MudButton>
    </MudPaper>

    @if (_loading)
    {
        <MudPaper Elevation="1" Class="surface-panel surface-panel-narrow" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Color="Color.Secondary">@L["SourceControlSettings.LoadingEnterpriseSourceControlSetup"]</MudText>
        </MudPaper>
    }
    else if (_accessDenied)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            <MudText Typo="Typo.subtitle1">@L["SourceControlSettings.EnterpriseAdministratorAccessIsRequired"]</MudText>
            <MudText Typo="Typo.body2">
                @L["SourceControlSettings.OnlyACSweetSystem"]
            </MudText>
        </MudAlert>
    }
    else
    {
        @if (_storageError is not null) { <MudAlert Severity="Severity.Warning" Class="mb-4">@_storageError</MudAlert> }
        <MudGrid>
        @if (_storage is not null)
        {
            <MudItem xs="12" md="6">
            <MudPaper Outlined="true" Class="pa-4" Style="height:100%">
                <MudText Typo="Typo.h5">@L["SourceControlSettings.InternalGitStorage"]</MudText>
                <MudAlert Severity="@(_storage.Ready ? Severity.Success : Severity.Warning)" Class="my-3">
                    @(_storage.Ready ? "Repository storage is ready." : _storage.Error)
                </MudAlert>
                <MudExpansionPanels Elevation="0">
                <MudExpansionPanel Text="@L["SourceControlSettings.StorageDetails"]">
                <MudText>Repositories: @_storage.RepositoryRoot</MudText>
                <MudText>Temporary work: @_storage.TemporaryRoot</MudText>
                <MudText>LFS configuration: @_storage.LfsProvider · @_storage.LfsLocation</MudText>
                <MudText>Backup storage: @_storage.BackupProvider · @_storage.BackupLocation</MudText>
                <MudText Color="Color.Secondary" Class="mt-3">@L["SourceControlSettings.StoragePathsAreConfiguredOn"]</MudText>
                <MudText Color="Color.Secondary">@L["SourceControlSettings.RelocationRequiresAMaintenanceWindow"]</MudText>
                </MudExpansionPanel>
                </MudExpansionPanels>
            </MudPaper>
            </MudItem>
        }
        @foreach (var installation in _access?.Installations ?? [])
        {
            <MudItem xs="12" md="6"><GitHubConnectionCard @key="installation.InstallationId" Installation="installation" /></MudItem>
        }
        @if (_setup is not null && (!_setup.Readiness.ExistingGitHubAvailable || GitHubPlatformWizardFlow.IsPending(_setup)))
        {
            <MudItem xs="12" md="6"><SourceControlPlatformSetupWizard Setup="_setup" SetupChanged="HandleSetupChanged" BusinessId="BusinessId" AllowRepositoryCreation="AllowRepositoryCreation" /></MudItem>
        }
        </MudGrid>
        @if (_connectionsError is not null) { <MudAlert Severity="Severity.Warning" Class="mt-4">@_connectionsError</MudAlert> }
        @if (_access is { Installations.Count: 0 })
        {
            <MudPaper Outlined="true" Class="pa-4 mt-4">
                <MudText Typo="Typo.h6">@L["SourceControlSettings.ConnectYourGitHubAccount"]</MudText>
                <MudText>@L["SourceControlSettings.TheAppIsConfiguredBut"]</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@ConnectAccountUrl" Class="mt-3">@L["SourceControlSettings.ConnectAccountOnGitHub"]</MudButton>
            </MudPaper>
        }
        @if (_setup?.Readiness.ExistingGitHubAvailable == true && !GitHubPlatformWizardFlow.IsPending(_setup))
        {
            <MudExpansionPanels Class="mt-4" Elevation="0"><MudExpansionPanel Text="@L["SourceControlSettings.GitHubAppConfiguration"]">
                <SourceControlPlatformSetupWizard Setup="_setup" SetupChanged="HandleSetupChanged" BusinessId="BusinessId" AllowRepositoryCreation="AllowRepositoryCreation" />
            </MudExpansionPanel></MudExpansionPanels>
        }
        @if (_setupError is not null) { <MudAlert Severity="Severity.Warning">@_setupError</MudAlert> }
        @if (_setup?.Readiness.ConfigurationMode == "ExternallyManaged")
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                @L["SourceControlSettings.ThisInstallationUsesOperatorManaged"]
            </MudAlert>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "business")] public Guid? BusinessId { get; set; }
    [SupplyParameterFromQuery(Name = "draft")] public Guid? DraftId { get; set; }
    private Guid? _returnDraftId;
    private bool _draftTargetStored;
    [SupplyParameterFromQuery(Name = "allowRepositoryCreation")] public bool AllowRepositoryCreation { get; set; }
    private PlatformSourceControlSetupResponse? _setup;
    private InternalGitStorageStatus? _storage;
    private bool _loading = true;
    private bool _accessDenied;
    private string? _storageError, _setupError;
    private string? _connectionsError;
    private PlatformGitHubAccessOverview? _access;
    private Guid? _returnBusinessId;
    private bool _returnTargetRestored;
    private string? ConnectAccountUrl => (BusinessId ?? _returnBusinessId) is { } businessId
        ? $"/organizations/{businessId:D}/source-control?connectGitHub=true&allowRepositoryCreation={(_setup?.Session?.ProvisionerRequested ?? AllowRepositoryCreation).ToString().ToLowerInvariant()}"
        : _access?.InstallUrl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_draftTargetStored)
        {
            _draftTargetStored = true;
            try
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CSweet.UI/githubWizard.js");
                try { var stored = await module.InvokeAsync<string?>("rememberDraftId", DraftId?.ToString("D")); if (Guid.TryParse(stored, out var draft)) { _returnDraftId = draft; StateHasChanged(); } }
                finally { await module.DisposeAsync(); }
            }
            catch (JSException) { }
        }
        if (_returnTargetRestored || _setup?.Readiness.ExistingGitHubAvailable != true || GitHubPlatformWizardFlow.IsPending(_setup)) return;
        _returnTargetRestored = true;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CSweet.UI/githubWizard.js");
            try
            {
                var stored = await module.InvokeAsync<string?>("takeBusinessId");
                if (Guid.TryParse(stored, out var businessId)) { _returnBusinessId = businessId; StateHasChanged(); }
            }
            finally { await module.DisposeAsync(); }
        }
        catch (JSException) { }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _accessDenied = false; _storage = null; _setup = null;
        _storageError = null; _setupError = null;
        _access = null; _connectionsError = null;
        try
        {
            var state = await CSweet.UI.Services.SourceControlSettingsState.LoadAsync(Http);
            _storage = state.Storage; _setup = state.Setup; _accessDenied = state.AccessDenied;
            _storageError = state.StorageError; _setupError = state.SetupError;
            if (!_accessDenied && _setup?.Readiness.ExistingGitHubAvailable == true)
            {
                await LoadAccessAsync();
            }
        }
        finally { _loading = false; }
    }

    private async Task HandleSetupChanged(PlatformSourceControlSetupResponse updated)
    {
        _setup = updated;
        if (updated.Readiness.ExistingGitHubAvailable) await LoadAccessAsync();
    }
    private async Task LoadAccessAsync()
    {
        _access = null; _connectionsError = null;
        try { _access = await Http.GetFromJsonAsync<PlatformGitHubAccessOverview>("api/source-control/platform-setup/access")
            ?? throw new InvalidOperationException("No GitHub access overview was returned."); }
        catch (Exception) { _connectionsError = L["SourceControlSettings.GitHubInstallationDiscoveryFailedCheck"]; }
    }
}
