@page "/settings/source-control"
@layout SettingsLayout
@using CSweet.Contracts.SourceControl
@inject HttpClient Http

<PageTitle>Source Control Settings - C-Sweet</PageTitle>

<div class="setup-shell">
    <MudPaper Elevation="0" Class="page-header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">Enterprise platform</MudText>
            <MudText Typo="Typo.h3">Source control</MudText>
            <MudText Color="Color.Secondary">
                Manage internal Git storage and inspect service readiness. GitHub is an optional integration
                for businesses that want to use their own account.
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Refresh"
                   OnClick="LoadAsync" Disabled="_loading">Refresh</MudButton>
    </MudPaper>

    @if (_loading)
    {
        <MudPaper Elevation="1" Class="surface-panel surface-panel-narrow" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Color="Color.Secondary">Loading enterprise source-control setup...</MudText>
        </MudPaper>
    }
    else if (_accessDenied)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            <MudText Typo="Typo.subtitle1">Enterprise administrator access is required</MudText>
            <MudText Typo="Typo.body2">
                Only a C-Sweet system administrator can inspect installation storage and configure GitHub Apps.
            </MudText>
        </MudAlert>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">Try again</MudButton>
    }
    else if (_setup is not null)
    {
        @if (_storage is not null)
        {
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.h5">Internal Git storage</MudText>
                <MudAlert Severity="@(_storage.Ready ? Severity.Success : Severity.Warning)" Class="my-3">
                    @(_storage.Ready ? "Repository storage is ready." : _storage.Error)
                </MudAlert>
                <MudText>Repositories: @_storage.RepositoryRoot</MudText>
                <MudText>Temporary work: @_storage.TemporaryRoot</MudText>
                <MudText>LFS configuration: @_storage.LfsProvider · @_storage.LfsLocation</MudText>
                <MudText>Backup configuration: @_storage.BackupProvider · @_storage.BackupLocation</MudText>
                <MudText Color="Color.Secondary" Class="mt-3">Storage paths are configured on GitHost under CSweet:SourceControl:Storage. Use a host directory or mounted NAS share for repositories. LFS and backup configuration supports filesystem or S3-compatible endpoints such as MinIO. Object-store configuration shown here is not a connectivity check.</MudText>
                <MudText Color="Color.Secondary">Relocation requires a maintenance window: stop writes, copy and verify data, update configuration, and restart. A custom repository root requires ExpectedStoreId and a matching .csweet-git-store marker.</MudText>
            </MudPaper>
        }
        <MudText Typo="Typo.h5" Class="my-3">Optional GitHub integration</MudText>
        @if (_setup.Readiness.ConfigurationMode == "ExternallyManaged")
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                This installation uses operator-managed GitHub credentials. They remain active and
                have not been imported into C-Sweet.
            </MudAlert>
        }
        <SourceControlPlatformSetupWizard Setup="_setup" SetupChanged="HandleSetupChanged" />
    }
</div>

@code {
    private PlatformSourceControlSetupResponse? _setup;
    private InternalGitStorageStatus? _storage;
    private bool _loading = true;
    private bool _accessDenied;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _accessDenied = false;
        _error = null;
        try
        {
            using var response = await Http.GetAsync("api/source-control/platform-setup/");
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _accessDenied = true;
                _setup = null;
                return;
            }
            response.EnsureSuccessStatusCode();
            try { _storage = await Http.GetFromJsonAsync<InternalGitStorageStatus>("api/source-control/storage"); }
            catch { _storage = new(false, "", "", "filesystem", "", "filesystem", "", "GitHost storage status is unavailable."); }
            _setup = await response.Content.ReadFromJsonAsync<PlatformSourceControlSetupResponse>()
                ?? throw new InvalidOperationException("Enterprise source-control setup returned no data.");
        }
        catch (Exception exception)
        {
            _setup = null;
            _error = exception.Message;
        }
        finally { _loading = false; }
    }

    private void HandleSetupChanged(PlatformSourceControlSetupResponse updated) => _setup = updated;
}
