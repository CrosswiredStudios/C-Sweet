@page "/agents/marketplace"
@layout MainLayout
@using System.Net.Http.Json
@using CSweet.Agent.SDK
@inject HttpClient Http
@inject IAppLocalizer L

<PageTitle>@L["AgentMarketplace.PageTitle"]</PageTitle>

<div class="setup-shell agent-marketplace-page">
    <MudPaper Elevation="0" Class="page-header agent-marketplace-header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">@L["AgentMarketplace.Overline"]</MudText>
            <MudText Typo="Typo.h3">@L["AgentMarketplace.Title"]</MudText>
            <MudText Color="Color.Secondary">
                @L["AgentMarketplace.Lead"]
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Refresh"
                   Disabled="_loading"
                   OnClick="RefreshAsync">
            @L["Common.Refresh"]
        </MudButton>
    </MudPaper>

    @if (_loading && _result is null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="marketplace-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6">@L["AgentMarketplace.Opening"]</MudText>
                <MudText Color="Color.Secondary">@L["AgentMarketplace.LoadingSources"]</MudText>
            </div>
        </MudPaper>
    }
    else
    {
        @foreach (var source in _result?.Sources.Where(x => !x.Available && !string.IsNullOrWhiteSpace(x.Message)) ?? [])
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                @L.Format("AgentMarketplace.SourceUnavailable", new { source = source.Source, message = source.Message })
            </MudAlert>
        }

        @if (FirstPartyAgents.Count > 0)
        {
            <section class="marketplace-section" aria-labelledby="first-party-agents-heading">
                <div class="marketplace-section-heading">
                    <div>
                        <MudText Typo="Typo.overline" Color="Color.Primary">@L["AgentMarketplace.FirstParty.Overline"]</MudText>
                        <MudText Typo="Typo.h4" id="first-party-agents-heading">@L["AgentMarketplace.FirstParty.Title"]</MudText>
                        <MudText Color="Color.Secondary">
                            @L["AgentMarketplace.FirstParty.Lead"]
                        </MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Outlined.Verified" Color="Color.Primary" />
                </div>
                <div class="marketplace-card-grid">
                    @foreach (var agent in FirstPartyAgents)
                    {
                        <MarketplaceAgentCard @key="agent.AgentReference" Agent="agent" />
                    }
                </div>
            </section>
        }

        <section class="marketplace-section" aria-labelledby="browse-agents-heading">
            <div class="marketplace-section-heading marketplace-browse-heading">
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Primary">@L["AgentMarketplace.Browse.Overline"]</MudText>
                    <MudText Typo="Typo.h4" id="browse-agents-heading">@L["AgentMarketplace.Browse.Title"]</MudText>
                    <MudText Color="Color.Secondary">
                        @L["AgentMarketplace.Browse.Lead"]
                    </MudText>
                </div>
            </div>

            <MudPaper Elevation="0" Outlined="true" Class="marketplace-filters">
                <MudTextField T="string"
                              Label="@L["AgentMarketplace.SearchLabel"]"
                              @bind-Value="_search"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search" />
                <MudTextField T="string" Label="@L["AgentMarketplace.RoleLabel"]" @bind-Value="_role"
                              Variant="Variant.Outlined" Placeholder="@L["AgentMarketplace.RolePlaceholder"]" />
                <MudSelect T="string"
                           Label="@L["AgentMarketplace.CategoryLabel"]"
                           @bind-Value="_category"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    @foreach (var category in AvailableCategories)
                    {
                        <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Label="@L["AgentMarketplace.SortLabel"]" @bind-Value="_sort" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("relevance")">@L["AgentMarketplace.Sort.Relevance"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("rating")">@L["AgentMarketplace.Sort.Rating"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("price-low")">@L["AgentMarketplace.Sort.PriceLow"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("name")">@L["AgentMarketplace.Sort.Name"]</MudSelectItem>
                </MudSelect>
                <div class="marketplace-filter-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Search"
                               Disabled="_loading"
                               OnClick="SearchAsync">
                        @L["Common.Search"]
                    </MudButton>
                    <MudButton Variant="Variant.Text" Disabled="_loading" OnClick="ClearAsync">
                        @L["AgentMarketplace.Clear"]
                    </MudButton>
                </div>
            </MudPaper>

            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            }

            <MudText Typo="Typo.subtitle2" Class="mb-3">
                @L.Format("AgentMarketplace.MatchingCount", new { count = BrowseAgents.Count })
            </MudText>

            @if (BrowseAgents.Count == 0)
            {
                <MudPaper Elevation="0" Outlined="true" Class="marketplace-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Color="Color.Secondary" />
                    <div>
                        <MudText Typo="Typo.h6">@L["AgentMarketplace.NoMatches.Title"]</MudText>
                        <MudText Color="Color.Secondary">@L["AgentMarketplace.NoMatches.Hint"]</MudText>
                    </div>
                </MudPaper>
            }
            else
            {
                <div class="marketplace-card-grid">
                    @foreach (var agent in BrowseAgents)
                    {
                        <MarketplaceAgentCard @key="agent.AgentReference" Agent="agent" />
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private AvailableAgentSearchResult? _result;
    private bool _loading;
    private string? _search;
    private string? _role;
    private string? _category;
    private string _sort = "relevance";

    private IReadOnlyList<AvailableAgent> FirstPartyAgents =>
        (_result?.Agents ?? []).Where(x => x.Source == AgentCatalogSource.FirstPartyCatalog).ToArray();

    private IReadOnlyList<AvailableAgent> BrowseAgents => _result?.Agents ?? [];

    private IReadOnlyList<string> AvailableCategories => (_result?.Agents ?? [])
        .Select(x => x.Category)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToArray();

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task SearchAsync() => LoadAsync();
    private Task RefreshAsync() => LoadAsync();

    private async Task ClearAsync()
    {
        _search = null;
        _role = null;
        _category = null;
        _sort = "relevance";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var query = new List<string> { "limit=100", $"sort={Uri.EscapeDataString(_sort)}" };
            Add("q", _search);
            Add("role", _role);
            Add("category", _category);
            _result = await Http.GetFromJsonAsync<AvailableAgentSearchResult>(
                $"api/agents/available?{string.Join('&', query)}")
                ?? Offline(L["AgentMarketplace.EmptyResponse"]);

            void Add(string key, string? value)
            {
                if (!string.IsNullOrWhiteSpace(value))
                    query.Add($"{key}={Uri.EscapeDataString(value)}");
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or NotSupportedException)
        {
            _result = Offline(L["AgentMarketplace.Unreachable"]);
        }
        finally
        {
            _loading = false;
        }
    }

    private static AvailableAgentSearchResult Offline(string reason) =>
        new([], [new(AgentCatalogSource.Marketplace, false, reason)]);
}
