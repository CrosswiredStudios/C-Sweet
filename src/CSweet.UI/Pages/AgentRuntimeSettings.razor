@page "/settings/agents/runtime"
@layout SettingsLayout
@using CSweet.Contracts.Setup
@inject IAgentRuntimeSettingsApiClient AgentRuntimeSettingsApi
@inject IAppLocalizer L

<PageTitle>@L["AgentRuntimeSettings.PageTitle"]</PageTitle>

<div class="setup-shell configuration-page">
    <MudPaper Elevation="0" Class="page-header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">@L["AgentRuntimeSettings.Overline"]</MudText>
            <MudText Typo="Typo.h3">@L["AgentRuntimeSettings.Title"]</MudText>
            <MudText Color="Color.Secondary">@L["AgentRuntimeSettings.Lead"]</MudText>
        </div>
    </MudPaper>

    <MudPaper Elevation="1" Class="surface-panel command-section-wide">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.Dns" Color="Color.Primary" />
            <MudText>@L["AgentRuntimeSettings.OfficesNote.Before"] <MudLink Href="/settings/offices">@L["AgentRuntimeSettings.OfficesNote.Link"]</MudLink> @L["AgentRuntimeSettings.OfficesNote.After"]</MudText>
        </MudStack>
    </MudPaper>

    @if (_isLoading)
    {
        <MudPaper Elevation="1" Class="surface-panel surface-panel-narrow" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Color="Color.Secondary">@L["AgentRuntimeSettings.Loading"]</MudText>
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <MudPaper Elevation="1" Class="surface-panel surface-panel-narrow">
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_pageError</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync" Class="mt-4">@L["Common.Retry"]</MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="1" Class="surface-panel command-section-wide">
            @if (!string.IsNullOrWhiteSpace(_actionMessage))
            {
                <MudAlert Severity="@ActionMessageSeverity" Variant="Variant.Outlined" Class="mb-4" aria-live="polite">@_actionMessage</MudAlert>
            }

            <MudExpansionPanels MultiExpansion="true">
                <MudExpansionPanel Text="@L["AgentRuntimeSettings.Panel.RuntimeDefaults"]" Expanded="true" Class="configuration-expand-panel">
                    <div class="setup-form-grid">
                        <MudCheckBox T="bool" Label="@L["AgentRuntimeSettings.EnableImportedAgents"]" @bind-Value="_enableImportedAgents" Disabled="_isBusy" />
                        <MudSelect T="string" Label="@L["AgentRuntimeSettings.DefaultActivationMode"]" @bind-Value="_defaultActivationMode" Variant="Variant.Outlined" Disabled="_isBusy">
                            <MudSelectItem T="string" Value="@("AlwaysOn")">@L["AgentRuntimeSettings.Activation.AlwaysOn"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("OnDemand")">@L["AgentRuntimeSettings.Activation.OnDemand"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Scheduled")">@L["AgentRuntimeSettings.Activation.Scheduled"]</MudSelectItem>
                        </MudSelect>
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.DefaultTickFrequency"]" @bind-Value="_defaultTickFrequencySeconds" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.MinimumTickFrequency"]" @bind-Value="_minimumTickFrequencySeconds" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.DefaultMaxRuntime"]" @bind-Value="_defaultMaxRuntimeSeconds" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudSelect T="string" Label="@L["AgentRuntimeSettings.DefaultOverlapPolicy"]" @bind-Value="_defaultOverlapPolicy" Variant="Variant.Outlined" Disabled="_isBusy">
                            <MudSelectItem T="string" Value="@("Skip")">@L["AgentRuntimeSettings.Overlap.Skip"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Queue")">@L["AgentRuntimeSettings.Overlap.Queue"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("CancelPrevious")">@L["AgentRuntimeSettings.Overlap.CancelPrevious"]</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" Label="@L["AgentRuntimeSettings.DefaultRestartPolicy"]" @bind-Value="_defaultRestartPolicy" Variant="Variant.Outlined" Disabled="_isBusy">
                            <MudSelectItem T="string" Value="@("Never")">@L["AgentRuntimeSettings.Restart.Never"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("OnFailure")">@L["AgentRuntimeSettings.Restart.OnFailure"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Always")">@L["AgentRuntimeSettings.Restart.Always"]</MudSelectItem>
                        </MudSelect>
                        <MudCheckBox T="bool" Label="@L["AgentRuntimeSettings.AllowAlwaysOnCommunityAgents"]" @bind-Value="_allowAlwaysOnCommunityAgents" Disabled="_isBusy" />
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@L["AgentRuntimeSettings.Panel.WorkloadLimits"]" Class="configuration-expand-panel">
                    <div class="setup-form-grid">
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.GlobalActiveWorkloads"]" HelperText="@L["AgentRuntimeSettings.UnlimitedHelper"]" Min="0" @bind-Value="_globalMaxActiveWorkloads" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.ActiveWorkloadsPerBusiness"]" HelperText="@L["AgentRuntimeSettings.UnlimitedHelper"]" Min="0" @bind-Value="_perBusinessMaxActiveWorkloads" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.ActiveWorkloadsPerInstallation"]" @bind-Value="_perInstallationMaxActiveWorkloads" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.DefaultMemory"]" @bind-Value="_defaultWorkloadMemoryMb" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.MaximumMemory"]" @bind-Value="_maximumWorkloadMemoryMb" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.CodingInitialMemory"]" @bind-Value="_codingInitialMemoryMb" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.CodingMaximumMemory"]" @bind-Value="_codingMaximumMemoryMb" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.CodingMaximumReplacements"]" @bind-Value="_codingMaximumReplacements" Min="0" Max="2" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.DefaultCpu"]" @bind-Value="_defaultWorkloadCpuPercent" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.MaximumCpu"]" @bind-Value="_maximumWorkloadCpuPercent" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.DefaultProcessLimit"]" @bind-Value="_defaultWorkloadProcessLimit" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.DefaultLogLimit"]" @bind-Value="_defaultWorkloadLogLimitMb" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.StartTimeout"]" @bind-Value="_workloadStartTimeoutSeconds" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.McpSessionTimeout"]" @bind-Value="_mcpSessionTimeoutSeconds" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.StopGracePeriod"]" @bind-Value="_workloadStopGraceSeconds" Variant="Variant.Outlined" Disabled="_isBusy" />
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@L["AgentRuntimeSettings.Panel.NetworkStorage"]" Class="configuration-expand-panel">
                    <div class="setup-form-grid">
                        <MudSelect T="string" Label="@L["AgentRuntimeSettings.DefaultNetworkPolicy"]" @bind-Value="_defaultNetworkPolicy" Variant="Variant.Outlined" Disabled="_isBusy">
                            <MudSelectItem T="string" Value="@("McpOnly")">@L["AgentRuntimeSettings.Network.McpOnly"]</MudSelectItem>
                        </MudSelect>
                        <MudCheckBox T="bool" Label="@L["AgentRuntimeSettings.AllowPublicInternetByDefault"]" @bind-Value="_allowPublicInternetByDefault" Disabled="_isBusy" />
                        <MudTextField Label="@L["AgentRuntimeSettings.AllowedPackageFeedHosts"]" @bind-Value="_allowedPackageFeedHosts" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudTextField Label="@L["AgentRuntimeSettings.BlockedNetworkCidrs"]" @bind-Value="_blockedNetworkCidrs" Variant="Variant.Outlined" Disabled="_isBusy" />
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@L["AgentRuntimeSettings.Panel.BuildImport"]" Class="configuration-expand-panel">
                    <div class="setup-form-grid">
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.BuildTimeout"]" @bind-Value="_buildTimeoutSeconds" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.BuildMemory"]" @bind-Value="_buildMemoryMb" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.BuildCpu"]" @bind-Value="_buildCpuPercent" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.MaximumRepositorySize"]" @bind-Value="_maximumRepositorySizeMb" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.MaximumBuildLog"]" @bind-Value="_maximumBuildLogMb" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudCheckBox T="bool" Label="@L["AgentRuntimeSettings.KeepFailedBuildWorkspaces"]" @bind-Value="_keepFailedBuildWorkspaces" Disabled="_isBusy" />
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@L["AgentRuntimeSettings.Panel.CleanupRetention"]" Class="configuration-expand-panel">
                    <div class="setup-form-grid">
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.CompletedRuntimeRetention"]" @bind-Value="_completedRuntimeRetentionDays" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.FailedRuntimeRetention"]" @bind-Value="_failedRuntimeRetentionDays" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudNumericField T="int" Label="@L["AgentRuntimeSettings.BuildLogRetention"]" @bind-Value="_buildLogRetentionDays" Variant="Variant.Outlined" Disabled="_isBusy" />
                        <MudCheckBox T="bool" Label="@L["AgentRuntimeSettings.RemoveWorkloadsAfterCompletion"]" @bind-Value="_removeWorkloadsAfterCompletion" Disabled="_isBusy" />
                        <MudCheckBox T="bool" Label="@L["AgentRuntimeSettings.RemoveWorkspacesAfterCompletion"]" @bind-Value="_removeWorkspacesAfterCompletion" Disabled="_isBusy" />
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>

            <MudStack Row="true" Class="setup-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isBusy" OnClick="SaveAsync">
                    @L[_isBusy ? "AgentRuntimeSettings.Saving" : "AgentRuntimeSettings.Save"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="_isBusy"
                           StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="RecoverRuntimesAsync">
                    @L[_isBusy ? "AgentRuntimeSettings.Working" : "AgentRuntimeSettings.Recover"]
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</div>

@code {
    private bool _isLoading = true, _isBusy, _enableImportedAgents, _allowAlwaysOnCommunityAgents,
        _allowPublicInternetByDefault, _keepFailedBuildWorkspaces, _removeWorkloadsAfterCompletion,
        _removeWorkspacesAfterCompletion;
    private bool? _actionSucceeded;
    private string? _pageError, _actionMessage;
    private string _defaultActivationMode = "OnDemand", _defaultOverlapPolicy = "Skip", _defaultRestartPolicy = "Never",
        _defaultNetworkPolicy = "McpOnly", _allowedPackageFeedHosts = "", _blockedNetworkCidrs = "";
    private int _defaultTickFrequencySeconds, _minimumTickFrequencySeconds, _defaultMaxRuntimeSeconds,
        _globalMaxActiveWorkloads, _perBusinessMaxActiveWorkloads, _perInstallationMaxActiveWorkloads,
        _defaultWorkloadMemoryMb, _maximumWorkloadMemoryMb, _defaultWorkloadCpuPercent, _maximumWorkloadCpuPercent,
        _defaultWorkloadProcessLimit, _defaultWorkloadLogLimitMb, _workloadStartTimeoutSeconds,
        _mcpSessionTimeoutSeconds, _workloadStopGraceSeconds, _buildTimeoutSeconds, _buildMemoryMb,
        _buildCpuPercent, _maximumRepositorySizeMb, _maximumBuildLogMb, _completedRuntimeRetentionDays,
        _failedRuntimeRetentionDays, _buildLogRetentionDays;

    private Severity ActionMessageSeverity => _actionSucceeded == true ? Severity.Success : Severity.Error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _pageError = null;
        try { Hydrate(await AgentRuntimeSettingsApi.GetAsync()); }
        catch { _pageError = L["AgentRuntimeSettings.LoadFailed"]; }
        finally { _isLoading = false; }
    }

    private void Hydrate(AgentRuntimeSettingsResponse s)
    {
        _codingInitialMemoryMb = s.CodingInitialMemoryMb; _codingMaximumMemoryMb = s.CodingMaximumMemoryMb;
        _codingMaximumReplacements = s.CodingMaximumReplacements;
        _enableImportedAgents = s.EnableImportedAgents; _defaultActivationMode = s.DefaultActivationMode;
        _defaultTickFrequencySeconds = s.DefaultTickFrequencySeconds; _minimumTickFrequencySeconds = s.MinimumTickFrequencySeconds;
        _defaultMaxRuntimeSeconds = s.DefaultMaxRuntimeSeconds; _defaultOverlapPolicy = s.DefaultOverlapPolicy;
        _allowAlwaysOnCommunityAgents = s.AllowAlwaysOnCommunityAgents; _defaultRestartPolicy = s.DefaultRestartPolicy;
        _globalMaxActiveWorkloads = s.GlobalMaxActiveWorkloads; _perBusinessMaxActiveWorkloads = s.PerBusinessMaxActiveWorkloads;
        _perInstallationMaxActiveWorkloads = s.PerInstallationMaxActiveWorkloads; _defaultWorkloadMemoryMb = s.DefaultWorkloadMemoryMb;
        _maximumWorkloadMemoryMb = s.MaximumWorkloadMemoryMb; _defaultWorkloadCpuPercent = s.DefaultWorkloadCpuPercent;
        _maximumWorkloadCpuPercent = s.MaximumWorkloadCpuPercent; _defaultWorkloadProcessLimit = s.DefaultWorkloadProcessLimit;
        _defaultWorkloadLogLimitMb = s.DefaultWorkloadLogLimitMb; _workloadStartTimeoutSeconds = s.WorkloadStartTimeoutSeconds;
        _mcpSessionTimeoutSeconds = s.McpSessionTimeoutSeconds; _workloadStopGraceSeconds = s.WorkloadStopGraceSeconds;
        _defaultNetworkPolicy = s.DefaultNetworkPolicy; _allowPublicInternetByDefault = s.AllowPublicInternetByDefault;
        _allowedPackageFeedHosts = s.AllowedPackageFeedHosts; _blockedNetworkCidrs = s.BlockedNetworkCidrs;
        _buildTimeoutSeconds = s.BuildTimeoutSeconds; _buildMemoryMb = s.BuildMemoryMb; _buildCpuPercent = s.BuildCpuPercent;
        _maximumRepositorySizeMb = s.MaximumRepositorySizeMb; _maximumBuildLogMb = s.MaximumBuildLogMb;
        _keepFailedBuildWorkspaces = s.KeepFailedBuildWorkspaces; _completedRuntimeRetentionDays = s.CompletedRuntimeRetentionDays;
        _failedRuntimeRetentionDays = s.FailedRuntimeRetentionDays; _buildLogRetentionDays = s.BuildLogRetentionDays;
        _removeWorkloadsAfterCompletion = s.RemoveWorkloadsAfterCompletion; _removeWorkspacesAfterCompletion = s.RemoveWorkspacesAfterCompletion;
    }

    private int _codingInitialMemoryMb = 4096, _codingMaximumMemoryMb = 16384, _codingMaximumReplacements = 2;

    private async Task SaveAsync()
    {
        _isBusy = true; _actionMessage = null; _actionSucceeded = null;
        try
        {
            var result = await AgentRuntimeSettingsApi.UpdateAsync(new UpdateAgentRuntimeSettingsRequest(
                _enableImportedAgents, _defaultActivationMode, _defaultTickFrequencySeconds, _minimumTickFrequencySeconds,
                _defaultMaxRuntimeSeconds, _defaultOverlapPolicy, _allowAlwaysOnCommunityAgents, _defaultRestartPolicy,
                _globalMaxActiveWorkloads, _perBusinessMaxActiveWorkloads, _perInstallationMaxActiveWorkloads,
                _defaultWorkloadMemoryMb, _maximumWorkloadMemoryMb, _defaultWorkloadCpuPercent, _maximumWorkloadCpuPercent,
                _defaultWorkloadProcessLimit, _defaultWorkloadLogLimitMb, _workloadStartTimeoutSeconds,
                _mcpSessionTimeoutSeconds, _workloadStopGraceSeconds, _defaultNetworkPolicy,
                _allowPublicInternetByDefault, _allowedPackageFeedHosts, _blockedNetworkCidrs, _buildTimeoutSeconds,
                _buildMemoryMb, _buildCpuPercent, _maximumRepositorySizeMb, _maximumBuildLogMb,
                _keepFailedBuildWorkspaces, _completedRuntimeRetentionDays, _failedRuntimeRetentionDays,
                _buildLogRetentionDays, _removeWorkloadsAfterCompletion, _removeWorkspacesAfterCompletion)
            {
                CodingInitialMemoryMb = _codingInitialMemoryMb, CodingMaximumMemoryMb = _codingMaximumMemoryMb,
                CodingMaximumReplacements = _codingMaximumReplacements
            });
            _actionSucceeded = result.Succeeded;
            _actionMessage = result.Message ?? L[result.Succeeded ? "AgentRuntimeSettings.Saved" : "AgentRuntimeSettings.SaveFailed"];
            if (result.Settings is not null) Hydrate(result.Settings);
        }
        catch { _actionSucceeded = false; _actionMessage = L["AgentRuntimeSettings.SaveError"]; }
        finally { _isBusy = false; }
    }

    private async Task RecoverRuntimesAsync()
    {
        _isBusy = true; _actionMessage = null; _actionSucceeded = null;
        try
        {
            var result = await AgentRuntimeSettingsApi.RecoverAsync();
            _actionSucceeded = result.Succeeded;
            _actionMessage = result.Message ?? L["AgentRuntimeSettings.Recovered"];
        }
        catch
        {
            _actionSucceeded = false;
            _actionMessage = L["AgentRuntimeSettings.RecoverFailed"];
        }
        finally { _isBusy = false; }
    }
}
