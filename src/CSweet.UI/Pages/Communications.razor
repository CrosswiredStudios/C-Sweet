    private string UnreadLabel(CommunicationChatResponse chat) => ChatUnread(chat) > 99 ? "99+" : ChatUnread(chat).ToString();

    private static string ParticipantSummary(CommunicationChatResponse chat) => string.Join(", ", chat.Participants.Take(4).Select(x => x.DisplayName)) + (chat.Participants.Count > 4 ? $" +{chat.Participants.Count - 4}" : string.Empty);
    private static string AvatarClass(string type) => type == "Agent" ? "agent" : "human";
    private static string PresenceClass(string? status) => status switch
    {
        CommunicationPresenceStatuses.Unhealthy => "unhealthy",
        CommunicationPresenceStatuses.Starting => "starting",
        CommunicationPresenceStatuses.PendingActivation => "starting",
        CommunicationPresenceStatuses.ReadyOnDemand => "available",
        CommunicationPresenceStatuses.Scheduled => "offline",
        CommunicationPresenceStatuses.Offline => "offline",
        _ => "available"
    };
    private static string PresenceTitle(string? displayName, string? status, string? detail)
    {
        var name = string.IsNullOrWhiteSpace(displayName) ? "Team member" : displayName;
        var state = status switch
        {
            CommunicationPresenceStatuses.Unhealthy => "has a problem",
            CommunicationPresenceStatuses.Starting => "is starting",
            CommunicationPresenceStatuses.PendingActivation => "is waiting for activation",
            CommunicationPresenceStatuses.ReadyOnDemand => "is ready on demand",
            CommunicationPresenceStatuses.Scheduled => "is scheduled",
            CommunicationPresenceStatuses.Offline => "is offline",
            _ => "is available"
        };
        return string.IsNullOrWhiteSpace(detail) ? $"{name} {state}." : $"{name} {state}. {detail}";
    }
    private static string PresenceBannerLabel(string status) => status switch
    {
        CommunicationPresenceStatuses.Starting => "is starting",
        CommunicationPresenceStatuses.PendingActivation => "is waiting for activation",
        CommunicationPresenceStatuses.ReadyOnDemand => "is ready on demand",
        CommunicationPresenceStatuses.Scheduled => "is scheduled",
        _ => "is unavailable"
    };
    private static string Initials(string name) => string.Join(string.Empty, name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private sealed class TurnView(ChatTurnResponse turn)
    {
        public ChatTurnResponse Turn { get; set; } = turn;
        public List<ChatTurnTraceEventResponse> Events { get; } = [];
        public string StreamingText { get; set; } = string.Empty;
        public string ReasoningText { get; set; } = string.Empty;
        public bool ReasoningComplete { get; set; }
        public string DraftText { get; set; } = string.Empty;
        public List<ChatTurnTraceEventResponse> ActivityEvents => Events
            .Where(x => x.Category == "activity")
            .OrderBy(x => x.Sequence)
            .ToList();
    }

    private sealed record DraftMention(
        Guid OrganizationUserId,
        int Offset,
        int Length,
        string DisplayText);

    private sealed record DirectMessageEntry(
        CommunicationChatResponse? Chat,
        CommunicationPersonResponse Person,
        string Title);

    public async ValueTask DisposeAsync()
    {
        Realtime.EventReceived -= OnRealtimeEvent;
        Realtime.Connected -= OnRealtimeConnectionReady;
        Realtime.Reconnected -= OnRealtimeConnectionReady;
        try { await Realtime.SetCommunicationPerspectiveAsync(null, null); }
        catch (InvalidOperationException) { }
        _chatCts?.Cancel();
        _chatCts?.Dispose();
        _disposeCts.Cancel();
        _disposeCts.Dispose();
        if (_communicationsModule is not null) await _communicationsModule.DisposeAsync();
    }
}
