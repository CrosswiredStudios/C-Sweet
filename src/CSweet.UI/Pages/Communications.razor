    private void OnRealtimeEvent(CSweet.Contracts.Realtime.AppRealtimeEventEnvelope envelope)
    {
        if (envelope.OrganizationId != OrganizationId ||
            (!envelope.EventType.StartsWith("com.csweet.communication.", StringComparison.Ordinal) &&
             !envelope.EventType.StartsWith("com.csweet.app.notification.", StringComparison.Ordinal) &&
             envelope.EventType != CSweet.Contracts.Realtime.AppRealtimeEvents.EmployeeDirectoryChanged)) return;
        _realtimeRefreshPending = true;
        _ = InvokeAsync(RefreshFromRealtimeAsync);
    }

    private void OnRealtimeConnectionReady()
    {
        _realtimeRefreshPending = true;
        _ = InvokeAsync(RefreshFromRealtimeAsync);
    }

    private async Task RefreshFromRealtimeAsync()
    {
        _realtimeRefreshPending = true;
        if (_realtimeRefreshing) return;
        _realtimeRefreshing = true;
        try
        {
            do
            {
                _realtimeRefreshPending = false;
                var visible = await IsDocumentVisibleAsync();
                await RefreshHubAsync(_selected?.Id, visible);
                await LoadNotificationsAsync();
                await InvokeAsync(StateHasChanged);
            }
            while (_realtimeRefreshPending && !_disposeCts.IsCancellationRequested);
        }
        catch (OperationCanceledException) { }
        finally { _realtimeRefreshing = false; }
    }

    private async Task ObserveFirstMessageAsync(Guid chatId, CancellationToken cancellationToken)
    {
        // SignalR is intentionally ephemeral. A conversation can be rendered after
        // its first durable message was published but before this page joined the
        // realtime group, so briefly reconcile empty conversations from storage.
        var delays = new[] { 2, 3, 5, 10, 15, 25 };
        try
        {
            foreach (var delaySeconds in delays)
            {
                await Task.Delay(TimeSpan.FromSeconds(delaySeconds), cancellationToken);
                if (_selected?.Id != chatId || _messages.Count > 0)
                    return;

                await InvokeAsync(RefreshFromRealtimeAsync);
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (_firstMessageCatchUpChatId == chatId)
                _firstMessageCatchUpChatId = null;
        }
    }

