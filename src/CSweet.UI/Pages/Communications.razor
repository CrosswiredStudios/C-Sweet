@page "/organizations/{OrganizationId:guid}/communications"
@page "/organizations/{OrganizationId:guid}/communications/{ChatId:guid}"
@using CSweet.Contracts.Communications
@using CSweet.Contracts.Core
@using CSweet.Contracts.GenAi
@using CSweet.UI.Components.Communications
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject HttpClient Http
@inject IChatTurnApiClient ChatTurns
@inject AppRealtimeState Realtime
@inject CommunicationUnreadState Unread
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Communications - C-Sweet</PageTitle>

<div class="hub-page">
    @if (_loading)
    {
        <div class="hub-centered"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><span>Opening communications…</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(_error) || _hub is null)
    {
        <div class="hub-centered">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Color="Color.Error" Size="Size.Large" />
            <MudText Typo="Typo.h6">Communications could not be opened</MudText>
            <MudText Color="Color.Secondary">@_error</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">Try again</MudButton>
        </div>
    }
    else
    {
        <aside class="hub-sidebar">
            <div class="hub-brand">
                <div class="hub-logo"><MudIcon Icon="@Icons.Material.Filled.Forum" /></div>
                <div><strong>Communications</strong><span>C-Sweet workspace</span></div>
            </div>
            <div class="hub-perspective">
                <label for="communications-perspective">View communications as</label>
                <div class="hub-perspective-select">
                    <MudIcon Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" />
                    <select id="communications-perspective"
                            aria-label="View communications as"
                            value="@PerspectiveValue"
                            @onchange="OnPerspectiveChanged">
                        <option value="">Self</option>
                        @if (PerspectiveAgents.Any())
                        {
                            <option disabled>──────────</option>
                            @foreach (var agent in PerspectiveAgents)
                            {
                                <option value="@agent.Id.ToString("D")">@agent.DisplayName</option>
                            }
                        }
                    </select>
                </div>
                @if (_hub.IsReadOnlyPerspective)
                {
                    <span class="hub-readonly-badge">
                        <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" />
                        Read-only agent perspective
                    </span>
                }
            </div>
            <div class="hub-search">
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                <input aria-label="Search conversations" placeholder="Search" @bind="_search" @bind:event="oninput" />
            </div>
            <nav class="hub-nav" aria-label="Conversations">
                <div class="hub-section-title">
                    <span>Channels</span>
                    @if (_hub.CanManageChats)
                    {
                        <button title="Create channel" aria-label="Create channel" @onclick="OpenCreateGroup"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /></button>
                    }
                </div>
                @foreach (var chat in FilteredChats.Where(x => !x.IsDirect))
                {
                    <button class="hub-nav-item @(chat.Id == _selected?.Id ? "active" : null) @(ChatUnread(chat) > 0 ? "unread" : null)" @onclick="@(() => SelectChatAsync(chat))">
                        <MudIcon Icon="@(chat.IsPrivate ? Icons.Material.Filled.Lock : Icons.Material.Filled.Tag)" Size="Size.Small" />
                        <span>@chat.Title</span>
                        @if (ChatUnread(chat) > 0) { <span class="hub-unread-count">@UnreadLabel(chat)</span> }
                    </button>
                }
                @if (!FilteredChats.Any(x => !x.IsDirect))
                {
                    <p class="hub-nav-empty">No channels yet</p>
                }

                <div class="hub-section-title direct"><span>Direct messages</span></div>
                @foreach (var entry in DirectMessages)
                {
                    <button class="hub-nav-item @(entry.Chat?.Id == _selected?.Id ? "active" : null) @(entry.Chat is not null && ChatUnread(entry.Chat) > 0 ? "unread" : null)"
                            @onclick="@(() => OpenDirectEntryAsync(entry))">
                        <span class="presence-dot @PresenceClass(entry.Person.PresenceStatus)"
                              title="@PresenceTitle(entry.Person.DisplayName, entry.Person.PresenceStatus, entry.Person.PresenceDetail)"
                              aria-label="@PresenceTitle(entry.Person.DisplayName, entry.Person.PresenceStatus, entry.Person.PresenceDetail)"></span><span>@entry.Title</span>
                        @if (entry.Chat is not null && ChatUnread(entry.Chat) > 0) { <span class="hub-unread-dot" aria-label="@($"{ChatUnread(entry.Chat)} unread messages")"></span> }
                        @if (entry.Person.EmployeeType == "Agent") { <span class="agent-mark">AI</span> }
                    </button>
                }
                @if (!DirectMessages.Any())
                {
                    <p class="hub-nav-empty">No direct messages yet</p>
                }
                @if (!_hub.IsReadOnlyPerspective)
                {
                    <div class="hub-section-title direct">
                        <button class="hub-mentions-toggle" @onclick="@(() => _showMentions = !_showMentions)"
                                aria-expanded="@_showMentions">
                            <span>Mentions</span>
                            @if (UnreadMentions > 0) { <span class="hub-unread-count">@UnreadMentions</span> }
                        </button>
                    </div>
                    @if (_showMentions)
                    {
                        <div class="hub-mentions-list">
                            @foreach (var mention in MentionNotifications)
                            {
                                <button class="hub-mention-entry @(mention.ReadAt is null ? "unread" : null)"
                                        @onclick="@(() => OpenMentionAsync(mention))">
                                    <strong>@mention.Title</strong>
                                    <span>@mention.Body</span>
                                    <small>@mention.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</small>
                                </button>
                            }
                            @if (!MentionNotifications.Any())
                            {
                                <p class="hub-nav-empty">No mentions yet</p>
                            }
                        </div>
                    }
                }
            </nav>
            <a class="hub-settings" href="/settings/communications"><MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" /> Connected apps</a>
        </aside>

        <main class="hub-main">
            @if (_selected is null)
            {
                <div class="hub-empty">
                    <div class="hub-empty-icon"><MudIcon Icon="@Icons.Material.Outlined.Forum" Size="Size.Large" /></div>
                    <MudText Typo="Typo.h5">@(_hub.IsReadOnlyPerspective ? $"{ViewedPersonName}'s conversations" : "Your company conversations live here")</MudText>
                    <MudText Color="Color.Secondary">@(_hub.IsReadOnlyPerspective ? "This agent is not currently a member of any conversations." : "Choose a channel, or start a direct message with a teammate.")</MudText>
                </div>
            }
            else
            {
                <header class="hub-chat-header">
                    <div>
                        <div class="hub-title-line">
                            <MudIcon Icon="@(_selected.IsDirect ? Icons.Material.Filled.AlternateEmail : _selected.IsPrivate ? Icons.Material.Filled.Lock : Icons.Material.Filled.Tag)" />
                            <strong>@_selected.Title</strong>
                        </div>
                        <span>@(_selected.Description ?? ParticipantSummary(_selected))</span>
                    </div>
                    <div class="hub-header-actions">
                        <button title="Members" @onclick="@(() => _showMembers = !_showMembers)"><MudIcon Icon="@Icons.Material.Outlined.Group" /><span>@_selected.Participants.Count</span></button>
                        @if (_selected.CanManage)
                        {
                            <button title="Manage channel" @onclick="OpenEdit"><MudIcon Icon="@Icons.Material.Outlined.Edit" /></button>
                        }
                    </div>
                </header>

                <div class="hub-status-stack">
                    @if (!string.IsNullOrWhiteSpace(_notice))
                    {
                        <div class="hub-notice">@_notice</div>
                    }

                    @if (SelectedUnavailableAgent is { } unavailableAgent)
                    {
                        <section class="hub-agent-status @PresenceClass(unavailableAgent.PresenceStatus)"
                                 role="status" aria-live="polite">
                            <MudIcon Icon="@(unavailableAgent.PresenceStatus == CommunicationPresenceStatuses.Unhealthy
                                ? Icons.Material.Outlined.ErrorOutline
                                : Icons.Material.Outlined.Info)" />
                            <div>
                                <strong>@unavailableAgent.DisplayName @PresenceBannerLabel(unavailableAgent.PresenceStatus)</strong>
                                <span>@(unavailableAgent.PresenceDetail ?? "The agent runtime is not available.")</span>
                            </div>
                            @if (unavailableAgent.PresenceStatus == CommunicationPresenceStatuses.Unhealthy)
                            {
                                <a href="/settings/agents">Review diagnostics</a>
                            }
                        </section>
                    }

                    @foreach (var coordination in _coordinationSessions)
                    {
                        <section class="hub-coordination-card" aria-label="Active agent collaboration">
                            <div class="hub-coordination-icon"><MudIcon Icon="@Icons.Material.Outlined.Hub" /></div>
                            <div class="hub-coordination-content">
                                <span>AGENT COLLABORATION · @coordination.Status</span>
                                <strong>@coordination.Subject</strong>
                                <p>@coordination.Initiator.DisplayName and @coordination.Target.DisplayName are collaborating on this task.</p>
                            </div>
                            @if (_hub.CanManageChats)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                           Disabled="@_stoppingCoordination.Contains(coordination.Id)"
                                           OnClick="@(() => StopCoordinationAsync(coordination))">
                                    Stop collaboration
                                </MudButton>
                            }
                        </section>
                    }
                </div>

                <section class="hub-message-list" role="log" aria-live="polite" @ref="_messageList">
                    @if (_messages.Count == 0)
                    {
                        <div class="hub-welcome">
                            <div class="hub-welcome-icon">@(_selected.IsDirect ? "@" : "#")</div>
                            <MudText Typo="Typo.h5">This is the start of @_selected.Title</MudText>
                            <MudText Color="Color.Secondary">Keep decisions, context, and work moving in one place.</MudText>
                        </div>
                    }
                    @foreach (var message in _messages)
                    {
                        @if (message.MessageType == CommunicationMessageTypes.SystemAction)
                        {
                            <article class="hub-system-action-message" aria-label="Suggested action">
                                <div class="hub-system-action-icon">
                                    <MudIcon Icon="@Icons.Material.Outlined.RocketLaunch" />
                                </div>
                                <div class="hub-system-action-content">
                                    <span>SUGGESTED ACTION</span>
                                    @if (message.Actions is { Count: > 0 })
                                    {
                                        <strong>@message.Actions[0].Label</strong>
                                        @if (!string.IsNullOrWhiteSpace(message.Actions[0].Description))
                                        {
                                            <p>@message.Actions[0].Description</p>
                                        }
                                        @if (!_hub.IsReadOnlyPerspective)
                                        {
                                            <div class="hub-system-action-buttons">
                                                @foreach (var action in message.Actions)
                                                {
                                                    <MudButton Href="@action.NavigationUri"
                                                               Variant="Variant.Filled"
                                                               Color="Color.Primary"
                                                               EndIcon="@Icons.Material.Outlined.ArrowForward">
                                                        @action.Label
                                                    </MudButton>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <strong>@message.Content</strong>
                                    }
                                </div>
                            </article>
                        }
                        else
                        {
                            <article class="hub-message @(message.SenderOrganizationUserId == _hub.ViewedOrganizationUserId ? "mine" : null)">
                            <div class="hub-avatar @AvatarClass(message.SenderEmployeeType)">@Initials(message.SenderDisplayName)</div>
                            <div class="hub-message-body">
                                <div class="hub-message-meta">
                                    <strong>@message.SenderDisplayName</strong>
                                    @if (message.SenderEmployeeType == "Agent") { <span>AGENT</span> }
                                    <time>@message.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</time>
                                    @if (message.ChatTurnId is Guid messageTurnId &&
                                        _turns.TryGetValue(messageTurnId, out var messageTurn) &&
                                        messageTurn.Turn.AssistantMessageId == message.Id)
                                    {
                                        @ThinkingButton(messageTurn)
                                    }
                                </div>
                                  @if (message.ResourceChange is null)
                                  {
                                      <MentionedMessageContent Content="@message.Content" Mentions="@message.Mentions" />
                                  }
                                  @if (message.Attachments.Count > 0)
                                  {
                                      <div class="hub-message-attachments" aria-label="Message attachments">
                                          @foreach (var attachment in message.Attachments)
                                          {
                                              <span class="hub-message-attachment" title="@attachment.Sha256">
                                                  <MudIcon Icon="@AttachmentIcon(attachment.ContentType)" Size="Size.Small" />
                                                  <span>@attachment.FileName</span>
                                                  <small>@FormatAttachmentBytes(attachment.SizeBytes)</small>
                                              </span>
                                          }
                                      </div>
                                  }
                                 @if (message.ResourceChange is { } resourceChange)
                                 {
                                      <section class="hub-system-action-message hub-resource-change-approval" aria-label="Hiring plan approval">
                                          <div class="hub-system-action-icon">
                                              <MudIcon Icon="@Icons.Material.Outlined.Groups" />
                                          </div>
                                          <div class="hub-system-action-content">
                                               <span>HIRING PLAN APPROVAL</span>
                                               <strong>@(resourceChange.TeamName ?? "Review proposed product team")</strong>
                                               <p>@resourceChange.ProductGoal</p>
                                               <SuggestedTeamStructureGraph Request="resourceChange"
                                                                            ProductManagerDisplayName="@PersonName(resourceChange.RequesterOrganizationUserId, "Product manager")"
                                                                            ManagerDisplayName="@PersonName(resourceChange.ManagerOrganizationUserId, "Manager")" />
                                               <div class="hub-resource-change-roles">
                                             @foreach (var delta in resourceChange.Deltas)
                                             {
                                                  <div class="hub-resource-change-role">
                                                      <div>
                                                          <strong>@delta.Role.Title</strong>
                                                          <span>@delta.ChangeKind · @delta.Role.Headcount position@(delta.Role.Headcount == 1 ? null : "s") · Priority @delta.Role.Priority</span>
                                                      </div>
                                                      <p>@delta.Role.Purpose</p>
                                                  </div>
                                             }
                                              </div>
                                         @if (!_hub.IsReadOnlyPerspective &&
                                              resourceChange.Status == "Pending" &&
                                              resourceChange.ManagerOrganizationUserId == _hub.CurrentOrganizationUserId)
                                         {
                                              <MudTextField @bind-Value="_resourceFeedback"
                                                            Label="Revision feedback"
                                                            Placeholder="Required only when requesting a revision"
                                                            Lines="2" Variant="Variant.Outlined" Class="hub-resource-change-feedback" />
                                             @if (!string.IsNullOrWhiteSpace(_resourceDecisionError))
                                             {
                                                 <MudAlert Severity="Severity.Error" Dense="true">@_resourceDecisionError</MudAlert>
                                             }
                                              <div class="hub-system-action-buttons">
                                                  <MudButton Color="Color.Primary" Variant="Variant.Filled"
                                                             StartIcon="@Icons.Material.Outlined.Check"
                                                             Disabled="@_resourceDecisionBusy"
                                                             OnClick="@(() => DecideResourceChangeAsync(message, resourceChange, ResourceChangeDecisionKinds.Approve))">Approve plan</MudButton>
                                                  <MudButton Color="Color.Primary" Variant="Variant.Outlined"
                                                            Disabled="@_resourceDecisionBusy"
                                                            OnClick="@(() => DecideResourceChangeAsync(message, resourceChange, ResourceChangeDecisionKinds.RequestRevision))">Request revision</MudButton>
                                                 <MudButton Color="Color.Error" Variant="Variant.Text"
                                                            Disabled="@_resourceDecisionBusy"
                                                            OnClick="@(() => DecideResourceChangeAsync(message, resourceChange, ResourceChangeDecisionKinds.Reject))">Reject</MudButton>
                                              </div>
                                         }
                                         else
                                         {
                                              <div class="hub-resource-change-status"><strong>@resourceChange.Status</strong> @resourceChange.DecisionComment</div>
                                          }
                                          </div>
                                      </section>
                                 }
                                 @if (message.HiringWorkflow is { } hiringWorkflow)
                                 {
                                     <HiringWorkflowApprovalCard OrganizationId="OrganizationId"
                                                                         Workflow="hiringWorkflow"
                                                                         CanDecide="@(!_hub.IsReadOnlyPerspective && hiringWorkflow.Status == "Pending")"
                                                                         DecisionCompleted="@(() => LoadMessagesAsync(markRead: false))" />
                                 }
                                 @if (message.Actions is { Count: > 0 })
                                {
                                    <div class="hub-message-actions" aria-label="Suggested actions">
                                        @foreach (var action in message.Actions)
                                        {
                                            @if (action.Status == "Pending" && !_hub.IsReadOnlyPerspective)
                                            {
                                                <MudButton Href="@action.NavigationUri"
                                                           Variant="Variant.Filled"
                                                           Color="Color.Primary"
                                                           StartIcon="@Icons.Material.Outlined.RocketLaunch">
                                                    @action.Label
                                                </MudButton>
                                                @if (!string.IsNullOrWhiteSpace(action.Description))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@action.Description</MudText>
                                                }
                                            }
                                            else if (action.Status == "Completed")
                                            {
                                                <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined"
                                                         Icon="@Icons.Material.Outlined.CheckCircle">
                                                    Completed
                                                </MudChip>
                                                @if (action.ResultOrganizationUserId is Guid resultUserId)
                                                {
                                                    <MudLink Href="@($"/organizations/{OrganizationId:D}/employees/{resultUserId:D}")"
                                                             Typo="Typo.body2">
                                                        Hired @(action.ResultOrganizationUserDisplayName ?? "agent")
                                                    </MudLink>
                                                }
                                            }
                                        }
                                    </div>
                                }
                                @if (message.Decision is { } decision)
                                {
                                    <section class="executive-decision-card" aria-label="Question">
                                        <header>
                                            <span>QUESTION</span>
                                            <strong>@decision.Prompt</strong>
                                        </header>
                                        @if (decision.Status == "Pending" && !_hub.IsReadOnlyPerspective)
                                        {
                                            <div class="executive-decision-options">
                                                @foreach (var option in decision.Options)
                                                {
                                                    <label class="@(option.Recommended ? "recommended" : null)">
                                                        <input type="radio" name="@($"decision-{decision.Id}")"
                                                               checked="@SelectedDecisionOption(decision.Id, option.Id)"
                                                               @onchange="@(() => SelectDecisionOption(decision.Id, option.Id))" />
                                                        <span><strong>@option.Label</strong>
                                                            @if (option.Recommended) { <small class="recommendation-badge">RECOMMENDED</small> }
                                                            @if (!string.IsNullOrWhiteSpace(option.Description)) { <small>@option.Description</small> }
                                                        </span>
                                                    </label>
                                                }
                                                <label>
                                                    <input type="radio" name="@($"decision-{decision.Id}")"
                                                           checked="@SelectedDecisionOption(decision.Id, SomethingElseKey)"
                                                           @onchange="@(() => SelectDecisionOption(decision.Id, SomethingElseKey))" />
                                                    <span><strong>Something else</strong><small>Give the agent a different direction.</small></span>
                                                </label>
                                                @if (SelectedDecisionOption(decision.Id, SomethingElseKey))
                                                {
                                                    <textarea aria-label="Something else" placeholder="Your direction"
                                                              value="@DecisionOther(decision.Id)"
                                                              @oninput="@(e => SetDecisionOther(decision.Id, e.Value?.ToString()))"></textarea>
                                                }
                                            </div>
                                            @if (_decisionErrors.TryGetValue(decision.Id, out var decisionError))
                                            {
                                                <div class="executive-decision-error">@decisionError</div>
                                            }
                                            <footer>
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                           Disabled="@(!CanSubmitDecision(decision.Id) || _decisionBusy.Contains(decision.Id))"
                                                           OnClick="@(() => SubmitDecisionAsync(message, decision))">Submit</MudButton>
                                            </footer>
                                        }
                                        else if (decision.Status == "Pending")
                                        {
                                            <div class="executive-decision-answer">
                                                <MudIcon Icon="@Icons.Material.Outlined.Visibility" Color="Color.Secondary" Size="Size.Small" />
                                                <span>Pending · read-only</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="executive-decision-answer">
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                                <span>@DecisionAnswer(decision)</span>
                                            </div>
                                        }
                                    </section>
                                }
                            </div>
                            </article>
                        }
                    }
                    @foreach (var pending in ActiveTurns)
                    {
                        <article class="hub-message hub-message-pending">
                            <div class="hub-avatar agent">AI</div>
                            <div class="hub-message-body">
                                <div class="hub-message-meta">
                                    <strong>@_selected.Title</strong><span>AGENT</span>
                                    <time>@pending.Turn.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</time>
                                    @ThinkingButton(pending)
                                </div>
                                @if (!string.IsNullOrWhiteSpace(pending.ReasoningText))
                                {
                                    <details class="hub-turn-reasoning" open="@(!pending.ReasoningComplete)">
                                        <summary>@(pending.ReasoningComplete ? "Reasoning" : "Reasoning…")</summary>
                                        <div class="hub-turn-reasoning-text">@pending.ReasoningText</div>
                                    </details>
                                }
                                @if (pending.ActivityEvents.Count > 0)
                                {
                                    <details class="hub-turn-activity" open="@(!pending.ReasoningComplete)">
                                        <summary>Activity · @pending.ActivityEvents.Count event@(pending.ActivityEvents.Count == 1 ? null : "s")</summary>
                                        @foreach (var activity in pending.ActivityEvents.TakeLast(6))
                                        {
                                            <div><span>@activity.Title</span><small>@activity.Status</small></div>
                                        }
                                    </details>
                                }
                                @if (!string.IsNullOrWhiteSpace(pending.DraftText))
                                {
                                    <div role="status" aria-live="polite" aria-atomic="false">
                                        <div class="hub-turn-draft-label">DRAFT</div>
                                        <ChatMarkdown Content="@pending.DraftText" />
                                    </div>
                                }
                                else if (string.IsNullOrWhiteSpace(pending.StreamingText))
                                {
                                    <div class="hub-turn-running"><MudProgressLinear Indeterminate="true" Color="Color.Primary" /><span>The agent turn is running.</span></div>
                                }
                                else
                                {
                                    <ChatMarkdown Content="@pending.StreamingText" />
                                }
                            </div>
                        </article>
                    }
                </section>

                @if (_hub.IsReadOnlyPerspective)
                {
                    <footer class="hub-readonly-footer">
                        <MudIcon Icon="@Icons.Material.Outlined.Visibility" />
                        <span>You are viewing this conversation as <strong>@ViewedPersonName</strong>. Sending and conversation actions are disabled.</span>
                    </footer>
                }
                else
                {
                    <footer class="hub-composer">
                        <div class="hub-composer-input">
                            <MudTextField T="string" InputId="communication-composer"
                                          Value="_draft" ValueChanged="OnDraftChangedAsync"
                                          Placeholder="@ComposerPlaceholder" Variant="Variant.Outlined"
                                          Lines="2" Immediate="true" OnKeyDown="OnComposerKeyDown"
                                          Disabled="@(_sending || ComposerBlocked)" />
                            @if (_mentionOpen)
                            {
                                <div class="hub-mention-menu" role="listbox" aria-label="Mention a person or agent">
                                    @foreach (var match in _mentionMatches.Select((person, index) => (person, index)))
                                    {
                                        <button class="@(match.index == _mentionSelection ? "selected" : null)"
                                                role="option" aria-selected="@(match.index == _mentionSelection)"
                                                @onmousedown:preventDefault="true"
                                                @onclick="@(() => CommitMentionAsync(match.person))">
                                            <span class="hub-avatar @AvatarClass(match.person.EmployeeType)">@Initials(match.person.DisplayName)</span>
                                            <span><strong>@match.person.DisplayName</strong><small>@match.person.RoleName · @match.person.EmployeeType</small></span>
                                        </button>
                                    }
                                </div>
                            }
                            @if (_pendingAttachments.Count > 0)
                            {
                                <div class="hub-composer-attachments">
                                    @foreach (var attachment in _pendingAttachments)
                                    {
                                        <span>@attachment.FileName <small>@FormatAttachmentBytes(attachment.SizeBytes)</small>
                                            <button type="button" title="Remove attachment" @onclick="@(() => RemoveAttachment(attachment.Id))">×</button>
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                        @if (BlockingTurn is { } activeTurn)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Error"
                                       OnClick="@(() => StopTurnAsync(activeTurn))"
                                       Disabled="@_stoppingTurn" EndIcon="@Icons.Material.Filled.StopCircle">
                                @(_stoppingTurn ? "Stopping" : "Stop")
                            </MudButton>
                        }
                        else
                        {
                            <label class="hub-attachment-button" title="Attach up to 8 PNG, JPEG, WebP, PDF, text, or Markdown files">
                                <MudIcon Icon="@Icons.Material.Outlined.AttachFile" />
                                <InputFile OnChange="UploadAttachmentsAsync" multiple
                                           accept="image/png,image/jpeg,image/webp,application/pdf,text/plain,text/markdown,.md"
                                           disabled="@(_sending || _uploadingAttachments || ComposerBlocked)" />
                            </label>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendAsync"
                                       Disabled="@(_sending || _uploadingAttachments || (string.IsNullOrWhiteSpace(_draft) && _pendingAttachments.Count == 0))" EndIcon="@Icons.Material.Filled.Send">Send</MudButton>
                        }
                    </footer>
                }
            }
        </main>

        <aside class="hub-people @(_showMembers ? "open" : null)">
            <div class="hub-people-header"><strong>@(_selected is null ? "People" : "Members")</strong><button @onclick="@(() => _showMembers = false)"><MudIcon Icon="@Icons.Material.Filled.Close" /></button></div>
            @foreach (var person in VisiblePeople)
            {
                <button class="hub-person"
                        title="@(_hub.IsReadOnlyPerspective ? "Direct-message actions are disabled in agent perspective." : null)"
                        @onclick="@(() => StartDirectAsync(person))"
                        disabled="@(_hub.IsReadOnlyPerspective || person.Id == _hub.CurrentOrganizationUserId)">
                    <span class="hub-avatar @AvatarClass(person.EmployeeType)">@Initials(person.DisplayName)</span>
                    <span><strong>@person.DisplayName</strong><small>@(person.EmployeeType == "Agent" ? "AI employee" : person.RoleName ?? "Team member")</small></span>
                    <span class="presence-dot @PresenceClass(person.PresenceStatus)"
                          title="@PresenceTitle(person.DisplayName, person.PresenceStatus, person.PresenceDetail)"
                          aria-label="@PresenceTitle(person.DisplayName, person.PresenceStatus, person.PresenceDetail)"></span>
                </button>
            }
        </aside>

        @if (_showEditor)
        {
            <div class="hub-dialog-backdrop" @onclick="CloseEditor">
                <section class="hub-dialog" role="dialog" aria-modal="true" aria-labelledby="chat-editor-title" @onclick:stopPropagation="true">
                    <header><div><span>@(_editing is null ? "NEW CHANNEL" : "CHANNEL SETTINGS")</span><h2 id="chat-editor-title">@(_editing is null ? "Create a place to work" : $"Manage #{_editing.Title}")</h2></div><button @onclick="CloseEditor"><MudIcon Icon="@Icons.Material.Filled.Close" /></button></header>
                    @if (!string.IsNullOrWhiteSpace(_editorError)) { <MudAlert Severity="Severity.Error" Dense="true">@_editorError</MudAlert> }
                    <MudTextField Label="Channel name" @bind-Value="_editorTitle" Variant="Variant.Outlined" Immediate="true" />
                    <MudTextField Label="Description" @bind-Value="_editorDescription" Variant="Variant.Outlined" Lines="2" />
                    <MudCheckBox T="bool" @bind-Value="_editorPrivate" Label="Private channel" />
                    @if (_hub.Audiences.Count > 0)
                    {
                        <div class="hub-editor-section"><strong>Add a whole group</strong><span>Role-based departments and active product workstreams stay easy to select.</span>
                            <div class="hub-audience-list">
                                @foreach (var audience in _hub.Audiences)
                                {
                                    <button class="@(_selectedAudiences.Contains(AudienceKey(audience)) ? "selected" : null)" @onclick="@(() => ToggleAudience(audience))">
                                        <MudIcon Icon="@(audience.Kind == "Workstream" ? Icons.Material.Outlined.RocketLaunch : Icons.Material.Outlined.CorporateFare)" />
                                        <span>@audience.Name<small>@audience.Kind · @audience.OrganizationUserIds.Count people</small></span>
                                        <MudIcon Icon="@(_selectedAudiences.Contains(AudienceKey(audience)) ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.AddCircleOutline)" />
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    <div class="hub-editor-section"><strong>Members</strong><span>@_selectedMembers.Count selected</span>
                        <div class="hub-member-grid">
                            @foreach (var person in _hub.People)
                            {
                                <label><input type="checkbox" checked="@_selectedMembers.Contains(person.Id)" @onchange="@(() => ToggleMember(person.Id))" /><span class="hub-avatar @AvatarClass(person.EmployeeType)">@Initials(person.DisplayName)</span><span>@person.DisplayName<small>@(person.RoleName ?? person.EmployeeType)</small></span></label>
                            }
                        </div>
                    </div>
                    @if (_confirmArchive)
                    {
                        <MudAlert Severity="Severity.Warning">Archive this channel? Its history will be preserved and it will disappear from the workspace.</MudAlert>
                    }
                    <footer>
                        @if (_editing is not null)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ArchiveAsync">@(_confirmArchive ? "Confirm archive" : "Archive channel")</MudButton>
                        }
                        <span></span><MudButton Variant="Variant.Text" OnClick="CloseEditor">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_editorBusy" OnClick="SaveEditorAsync">@(_editing is null ? "Create channel" : "Save changes")</MudButton>
                    </footer>
                </section>
            </div>
        }
    }
</div>

<MudDialog @bind-Visible="_thinkingDialogOpen" Options="_thinkingDialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Psychology" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6">Memory &amp; thinking</MudText>
                @if (_thinkingDialogTurn is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@TraceSummary(_thinkingDialogTurn)</MudText>
                }
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_thinkingDialogLoading)
        {
            <div class="thinking-dialog-loading" role="status">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                <span>Loading memory and thinking output...</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_thinkingDialogError))
        {
            <MudAlert Severity="Severity.Error">@_thinkingDialogError</MudAlert>
        }
        else if (_thinkingDialogTurn is { } dialogTurn)
        {
            <div class="thinking-dialog @TraceClass(dialogTurn.Turn.Status)">
                <div class="chat-trace-events" role="list" aria-label="Memory and thinking output" tabindex="0">
                    @foreach (var traceEvent in dialogTurn.Events.OrderBy(x => x.Sequence))
                    {
                        <div class="chat-trace-event" role="listitem">
                            <div><strong>@traceEvent.Title</strong><small>@traceEvent.OccurredAt.ToLocalTime().ToString("T") @if (traceEvent.DurationMs.HasValue) { <span>· @traceEvent.DurationMs ms</span> }</small></div>
                            @if (!string.IsNullOrWhiteSpace(traceEvent.Summary)) { <pre>@traceEvent.Summary</pre> }
                            @if (traceEvent.Details.HasValue) { <details><summary>Structured details</summary><pre>@traceEvent.Details.Value.ToString()</pre></details> }
                        </div>
                    }
                    @if (dialogTurn.Events.Count == 0)
                    {
                        <div class="thinking-dialog-empty">No memory or thinking output has been recorded yet.</div>
                    }
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (_hub?.IsReadOnlyPerspective != true && _thinkingDialogTurn is { } actionTurn)
        {
            @if (!IsTerminal(actionTurn.Turn.Status))
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => CancelTurnAsync(actionTurn))">Cancel turn</MudButton>
            }
            else if (actionTurn.Turn.Status is "Failed" or "CompletedWithWarnings" or "Cancelled")
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@HasActiveTurnFor(actionTurn)" OnClick="@(() => RetryTurnAsync(actionTurn))">Retry</MudButton>
            }
        }
        <MudButton Variant="Variant.Text" OnClick="CloseThinkingDialog">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid? ChatId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "perspective")]
    public Guid? PerspectiveAgentId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "message")]
    public Guid? SourceMessageId { get; set; }
    private readonly CancellationTokenSource _disposeCts = new();
    private CancellationTokenSource? _chatCts;
    private IJSObjectReference? _communicationsModule;
    private ElementReference _messageList;
    private CommunicationHubResponse? _hub;
    private CommunicationChatResponse? _selected;
    private CommunicationChatResponse? _editing;
    private readonly List<CommunicationHubMessageResponse> _messages = [];
    private IReadOnlyList<NotificationResponse> _notifications = [];
    private readonly List<DraftMention> _draftMentions = [];
    private readonly List<PendingAttachment> _pendingAttachments = [];
    private IReadOnlyList<CommunicationPersonResponse> _mentionMatches = [];
    private readonly List<AgentCoordinationSessionResponse> _coordinationSessions = [];
    private readonly HashSet<Guid> _stoppingCoordination = [];
    private readonly Dictionary<Guid, TurnView> _turns = [];
    private readonly HashSet<Guid> _observingTurns = [];
    private readonly HashSet<Guid> _selectedMembers = [];
    private readonly HashSet<string> _selectedAudiences = [];
    private readonly Dictionary<Guid, string> _decisionSelections = [];
    private readonly Dictionary<Guid, string> _decisionOther = [];
    private readonly HashSet<Guid> _decisionBusy = [];
    private bool _resourceDecisionBusy;
    private string? _resourceDecisionError;
    private string? _resourceFeedback;
    private readonly Dictionary<Guid, string> _decisionErrors = [];
    private const string SomethingElseKey = "__something_else__";
    private bool _loading = true, _sending, _uploadingAttachments, _stoppingTurn, _showMembers, _showEditor, _editorBusy, _editorPrivate, _confirmArchive;
    private bool _showMentions, _mentionOpen;
    private int _mentionTriggerOffset, _mentionCaret, _mentionSelection;
    private string _search = string.Empty, _draft = string.Empty, _editorTitle = string.Empty, _editorDescription = string.Empty;
    private string? _error, _notice, _editorError;
    private readonly DialogOptions _thinkingDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };
    private TurnView? _thinkingDialogTurn;
    private bool _thinkingDialogOpen, _thinkingDialogLoading;
    private string? _thinkingDialogError;
    private bool _realtimeRefreshing;
    private bool _realtimeRefreshPending;
    private bool _scrollToBottomPending;
    private Guid? _observedChatId;
    private Guid? _observedPerspectiveId;
    private Guid? _firstMessageCatchUpChatId;
    private string BasePath => $"api/organizations/{OrganizationId}/communications/hub";
    private string PerspectiveApiQuery => PerspectiveAgentId.HasValue
        ? $"?perspectiveOrganizationUserId={PerspectiveAgentId.Value:D}"
        : string.Empty;
    private string HubReadPath => $"{BasePath}{PerspectiveApiQuery}";
    private string PerspectiveValue => PerspectiveAgentId?.ToString("D") ?? string.Empty;
    private IEnumerable<CommunicationPersonResponse> PerspectiveAgents => (_hub?.People ?? [])
        .Where(x => x.EmployeeType == "Agent")
        .OrderBy(x => x.DisplayName);
    private string ViewedPersonName => _hub?.People
        .FirstOrDefault(x => x.Id == _hub.ViewedOrganizationUserId)?.DisplayName ?? "this agent";
    private string PersonName(Guid organizationUserId, string fallback) => _hub?.People
        .FirstOrDefault(x => x.Id == organizationUserId)?.DisplayName ?? fallback;
    private IEnumerable<CommunicationChatResponse> FilteredChats => (_hub?.Chats ?? []).Where(x => string.IsNullOrWhiteSpace(_search) || x.Title.Contains(_search, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<DirectMessageEntry> DirectMessages => BuildDirectMessages();
    private IEnumerable<CommunicationPersonResponse> VisiblePeople => _selected is null || !_showMembers
        ? (_hub?.People ?? [])
        : _hub!.People.Where(x => _selected.Participants.Any(p => p.OrganizationUserId == x.Id));
    private IEnumerable<NotificationResponse> MentionNotifications => _notifications
        .Where(x => x.Category == "Mention" && x.DismissedAt is null)
        .OrderByDescending(x => x.CreatedAt);
    private int UnreadMentions => MentionNotifications.Count(x => x.ReadAt is null);
    private string ComposerPlaceholder => _selected is null ? "Message" :
        $"Message {(_selected.IsDirect ? _selected.Title : $"#{_selected.Title}")}";
    private bool HasActiveTurn => _turns.Values.Any(x => !IsTerminal(x.Turn.Status));
    private CommunicationParticipantResponse? SelectedUnavailableAgent => _selected?.IsDirect == true
        ? _selected.Participants.FirstOrDefault(x =>
            x.EmployeeType == "Agent" &&
            x.PresenceStatus != CommunicationPresenceStatuses.Available)
        : null;
    private bool ComposerBlocked => _selected?.IsDirect == true && HasActiveTurn;
    private TurnView? BlockingTurn => _selected?.IsDirect == true
        ? _turns.Values
            .Where(x => !IsTerminal(x.Turn.Status))
            .OrderBy(x => x.Turn.CreatedAt)
            .FirstOrDefault()
        : null;
    private IEnumerable<TurnView> ActiveTurns => _turns.Values
        .Where(x => !IsTerminal(x.Turn.Status) && x.Turn.AssistantMessageId is null)
        .OrderBy(x => x.Turn.CreatedAt);

    protected override void OnInitialized()
    {
        Realtime.EventReceived += OnRealtimeEvent;
        Realtime.Connected += OnRealtimeConnectionReady;
        Realtime.Reconnected += OnRealtimeConnectionReady;
    }

    protected override Task OnParametersSetAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToBottomPending) return;
        _scrollToBottomPending = false;

        try
        {
            var module = await GetCommunicationsModuleAsync();
            await module.InvokeVoidAsync("scrollToBottom", _messageList);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            await Realtime.SetCommunicationPerspectiveAsync(
                PerspectiveAgentId.HasValue ? OrganizationId : null,
                PerspectiveAgentId,
                _disposeCts.Token);
            _hub = await Http.GetFromJsonAsync<CommunicationHubResponse>(HubReadPath, _disposeCts.Token);
            await LoadNotificationsAsync();
            _selected = ChatId.HasValue
                ? _hub?.Chats.FirstOrDefault(x => x.Id == ChatId.Value)
                : _hub?.Chats.FirstOrDefault(x => x.Id == _selected?.Id) ?? _hub?.Chats.FirstOrDefault();
            if (ChatId.HasValue && _selected is null)
                throw new InvalidOperationException("This conversation was not found or is not available to you.");
            if (_selected is not null) await LoadMessagesAsync();
            if (SourceMessageId.HasValue)
                await MarkSourceMentionReadAsync(SourceMessageId.Value);
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void OnPerspectiveChanged(ChangeEventArgs args)
    {
        Guid? selectedAgentId = Guid.TryParse(args.Value?.ToString(), out var parsed)
            ? parsed
            : null;
        if (selectedAgentId == PerspectiveAgentId) return;

        _chatCts?.Cancel();
        _observedChatId = null;
        _observedPerspectiveId = null;
        _selected = null;
        _messages.Clear();
        _turns.Clear();
        _draft = string.Empty;
        _draftMentions.Clear();
        _notice = null;
        _search = string.Empty;
        _showMembers = false;
        _showEditor = false;
        _thinkingDialogOpen = false;

        var href = $"/organizations/{OrganizationId}/communications";
        if (selectedAgentId.HasValue)
            href += $"?perspective={selectedAgentId.Value:D}";
        Navigation.NavigateTo(href);
    }

    private Task SelectChatAsync(CommunicationChatResponse chat)
    {
        _showMembers = false;
        _thinkingDialogOpen = false;
        _notice = null;
        Navigation.NavigateTo(ChatHref(chat.Id));
        return Task.CompletedTask;
    }

    private Task OpenDirectEntryAsync(DirectMessageEntry entry) =>
        entry.Chat is not null ? SelectChatAsync(entry.Chat) : StartDirectAsync(entry.Person);

    private IEnumerable<DirectMessageEntry> BuildDirectMessages()
    {
        if (_hub is null) yield break;

        var representedPeople = new HashSet<Guid>();
        foreach (var chat in _hub.Chats.Where(x => x.IsDirect))
        {
            var participant = chat.Participants.FirstOrDefault(x =>
                x.OrganizationUserId != _hub.ViewedOrganizationUserId);
            if (participant is null) continue;
            representedPeople.Add(participant.OrganizationUserId);
            var person = _hub.People.FirstOrDefault(x => x.Id == participant.OrganizationUserId)
                ?? new CommunicationPersonResponse(
                    participant.OrganizationUserId,
                    participant.DisplayName,
                    participant.EmployeeType,
                    null,
                    participant.Role,
                    participant.PresenceStatus,
                    participant.PresenceDetail);
            if (MatchesSearch(chat.Title) || MatchesSearch(person.DisplayName))
                yield return new DirectMessageEntry(chat, person, chat.Title);
        }

        if (_hub.IsReadOnlyPerspective) yield break;
        foreach (var person in _hub.People
                     .Where(x => x.Id != _hub.ViewedOrganizationUserId && !representedPeople.Contains(x.Id))
                     .Where(x => MatchesSearch(x.DisplayName))
                     .OrderBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase))
            yield return new DirectMessageEntry(null, person, person.DisplayName);
    }

    private bool MatchesSearch(string value) =>
        string.IsNullOrWhiteSpace(_search) || value.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private async Task LoadNotificationsAsync()
    {
        if (_hub?.IsReadOnlyPerspective == true)
        {
            _notifications = [];
            return;
        }
        _notifications = await Http.GetFromJsonAsync<IReadOnlyList<NotificationResponse>>(
            $"api/organizations/{OrganizationId:D}/communications/notifications",
            _disposeCts.Token) ?? [];
    }

    private async Task OpenMentionAsync(NotificationResponse mention)
    {
        await MarkMentionReadAsync(mention);
        if (!string.IsNullOrWhiteSpace(mention.ActionUri))
            Navigation.NavigateTo(mention.ActionUri);
    }

    private async Task MarkSourceMentionReadAsync(Guid messageId)
    {
        var token = $"message={messageId:D}";
        foreach (var mention in MentionNotifications
                     .Where(x => x.ReadAt is null && x.ActionUri?.Contains(
                         token, StringComparison.OrdinalIgnoreCase) == true).ToList())
            await MarkMentionReadAsync(mention);
    }

    private async Task MarkMentionReadAsync(NotificationResponse mention)
    {
        if (mention.ReadAt.HasValue) return;
        var response = await Http.PostAsync(
            $"api/organizations/{OrganizationId:D}/communications/notifications/{mention.Id:D}/read",
            null, _disposeCts.Token);
        if (!response.IsSuccessStatusCode) return;
        _notifications = _notifications.Select(x => x.Id == mention.Id
            ? x with { ReadAt = DateTimeOffset.UtcNow }
            : x).ToList();
    }
    private async Task LoadMessagesAsync(bool markRead = true)
    {
        if (_selected is null) return;
        if (_observedChatId != _selected.Id ||
            _observedPerspectiveId != _hub?.ViewedOrganizationUserId)
        {
            _chatCts?.Cancel();
            _chatCts?.Dispose();
            _chatCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
            _observedChatId = _selected.Id;
            _observedPerspectiveId = _hub?.ViewedOrganizationUserId;
            _observingTurns.Clear();
            _turns.Clear();
        }
        var token = _chatCts?.Token ?? _disposeCts.Token;
        var items = await Http.GetFromJsonAsync<List<CommunicationHubMessageResponse>>(
            $"{BasePath}/chats/{_selected.Id}/messages{PerspectiveApiQuery}",
            token) ?? [];
        _messages.Clear(); _messages.AddRange(items);
        var coordination = await Http.GetFromJsonAsync<List<AgentCoordinationSessionResponse>>(
            $"{BasePath}/chats/{_selected.Id}/coordination-sessions?activeOnly=true", token) ?? [];
        _coordinationSessions.Clear();
        _coordinationSessions.AddRange(coordination);
        if (_hub?.IsReadOnlyPerspective == true)
            _turns.Clear();
        else
            await LoadTurnsAsync(_selected.Id, token);
        if (items.Count == 0 && _firstMessageCatchUpChatId != _selected.Id)
        {
            _firstMessageCatchUpChatId = _selected.Id;
            _ = ObserveFirstMessageAsync(_selected.Id, token);
        }
        RequestScrollToBottom();
        if (markRead && _hub?.IsReadOnlyPerspective != true && items.LastOrDefault() is { } last)
        {
            var response = await Http.PostAsJsonAsync($"{BasePath}/chats/{_selected.Id}/read",
                new MarkCommunicationChatReadRequest(last.Sequence), token);
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<CommunicationUnreadSummaryResponse>(token) is { } summary)
                Unread.Apply(summary);
        }
    }

    private async Task StopCoordinationAsync(AgentCoordinationSessionResponse session)
    {
        if (_selected is null || !_stoppingCoordination.Add(session.Id)) return;
        _notice = null;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"{BasePath}/chats/{_selected.Id}/coordination-sessions/{session.Id}/stop",
                new StopAgentCoordinationRequest(
                    session.Revision,
                    "Stopped from the communications workspace.",
                    $"ui-stop:{session.Id:N}:{session.Revision}"),
                _disposeCts.Token);
            if (!response.IsSuccessStatusCode)
                throw new InvalidOperationException(await response.Content.ReadAsStringAsync(_disposeCts.Token));
            _notice = "The collaboration was stopped. Its transcript remains available for audit.";
            await LoadMessagesAsync(markRead: false);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _notice = $"Collaboration could not be stopped: {exception.Message}";
        }
        finally
        {
            _stoppingCoordination.Remove(session.Id);
        }
    }

    private async Task SendAsync()
    {
        if (_hub?.IsReadOnlyPerspective == true ||
            _selected is null ||
            ComposerBlocked ||
            (string.IsNullOrWhiteSpace(_draft) && _pendingAttachments.Count == 0))
            return;
        _sending = true; _notice = null;
        var content = _draft.TrimEnd();
        var mentions = _draftMentions
            .Where(x => x.Offset + x.Length <= content.Length)
            .Select(x => new CommunicationMessageMentionInput(x.OrganizationUserId, x.Offset, x.Length))
            .ToList();
        var mentionSnapshot = _draftMentions.ToList();
        var attachmentSnapshot = _pendingAttachments.ToList();
        _draft = string.Empty;
        _draftMentions.Clear();
        _pendingAttachments.Clear();
        await SetMentionMenuOpenAsync(false);
        try
        {
            var response = await Http.PostAsJsonAsync($"{BasePath}/chats/{_selected.Id}/messages",
                new SendCommunicationMessageRequest(
                    content, Guid.NewGuid().ToString("N"), mentions,
                    attachmentSnapshot.Select(x => x.Id).ToList()), _disposeCts.Token);
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException(await response.Content.ReadAsStringAsync(_disposeCts.Token));
            var sent = await response.Content.ReadFromJsonAsync<CommunicationMessageSendResponse>(_disposeCts.Token);
            if (sent is not null)
            {
                if (_messages.All(x => x.Id != sent.Message.Id))
                    _messages.Add(sent.Message);
                RequestScrollToBottom();
                if (sent.Turn is not null)
                {
                    var view = new TurnView(sent.Turn);
                    _turns[sent.Turn.Id] = view;
                    _ = ObserveTurnAsync(_selected.Id, view, _chatCts?.Token ?? _disposeCts.Token);
                }
            }
        }
        catch (Exception ex)
        {
            _draft = content;
            _draftMentions.AddRange(mentionSnapshot);
            _pendingAttachments.AddRange(attachmentSnapshot);
            _notice = ex.Message;
        }
        finally
        {
            _sending = false;
            if (_realtimeRefreshPending)
                _ = InvokeAsync(RefreshFromRealtimeAsync);
        }
    }

    private async Task UploadAttachmentsAsync(InputFileChangeEventArgs args)
    {
        _uploadingAttachments = true;
        _notice = null;
        try
        {
            var files = args.GetMultipleFiles(8);
            if (_pendingAttachments.Count + files.Count > 8)
                throw new InvalidOperationException("A message can contain at most 8 attachments.");
            if (_pendingAttachments.Sum(x => x.SizeBytes) + files.Sum(x => x.Size) > 50L * 1024 * 1024)
                throw new InvalidOperationException("Message attachments must total 50 MB or less.");
            foreach (var file in files)
            {
                if (file.Size > 25L * 1024 * 1024)
                    throw new InvalidOperationException($"{file.Name} exceeds the 25 MB attachment limit.");
                var contentType = AttachmentContentType(file);
                var create = await Http.PostAsJsonAsync(
                    $"api/media-assets/uploads/organization/{OrganizationId:D}",
                    new CreateMediaUploadSessionRequest(file.Name, contentType, file.Size), _disposeCts.Token);
                await EnsureAttachmentSuccessAsync(create);
                var session = await create.Content.ReadFromJsonAsync<MediaUploadSessionResponse>(_disposeCts.Token)
                    ?? throw new InvalidOperationException("C-Sweet did not create an upload session.");
                await using var input = file.OpenReadStream(25L * 1024 * 1024, _disposeCts.Token);
                while (session.ReceivedBytes < session.TotalBytes)
                {
                    var size = (int)Math.Min(session.ChunkSizeBytes, session.TotalBytes - session.ReceivedBytes);
                    var buffer = new byte[size];
                    await input.ReadExactlyAsync(buffer, _disposeCts.Token);
                    using var chunk = new ByteArrayContent(buffer);
                    chunk.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/octet-stream");
                    var append = await Http.PutAsync(
                        $"api/media-assets/uploads/{session.Id:D}/chunks/{session.ReceivedBytes}?organizationId={OrganizationId:D}",
                        chunk, _disposeCts.Token);
                    await EnsureAttachmentSuccessAsync(append);
                    session = await append.Content.ReadFromJsonAsync<MediaUploadSessionResponse>(_disposeCts.Token)
                        ?? throw new InvalidOperationException("C-Sweet returned no upload progress.");
                }
                var complete = await Http.PostAsync(
                    $"api/media-assets/uploads/{session.Id:D}/complete?organizationId={OrganizationId:D}",
                    null, _disposeCts.Token);
                await EnsureAttachmentSuccessAsync(complete);
                session = await complete.Content.ReadFromJsonAsync<MediaUploadSessionResponse>(_disposeCts.Token)
                    ?? throw new InvalidOperationException("C-Sweet returned no completed attachment.");
                var asset = session.Asset ?? throw new InvalidOperationException("The attachment upload did not produce an asset.");
                _pendingAttachments.Add(new PendingAttachment(
                    asset.Id, asset.FileName, asset.ContentType, asset.SizeBytes, asset.Sha256));
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _notice = $"Attachment upload failed: {exception.Message}";
        }
        finally
        {
            _uploadingAttachments = false;
        }
    }

    private void RemoveAttachment(Guid id) => _pendingAttachments.RemoveAll(x => x.Id == id);

