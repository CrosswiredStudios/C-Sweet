            : decision.FreeTextAnswer ?? decision.Status;

    private async Task OnComposerKeyDown(KeyboardEventArgs args)
    {
        if (_mentionOpen)
        {
            if (args.Key == "ArrowDown")
                _mentionSelection = (_mentionSelection + 1) % _mentionMatches.Count;
            else if (args.Key == "ArrowUp")
                _mentionSelection = (_mentionSelection - 1 + _mentionMatches.Count) % _mentionMatches.Count;
            else if (args.Key is "Tab" or "Enter")
                await CommitMentionAsync(_mentionMatches[_mentionSelection]);
            else if (args.Key == "Escape")
                await SetMentionMenuOpenAsync(false);
            return;
        }
        if (args.Key == "Enter" && !args.ShiftKey)
            await SendAsync();
    }

    private async Task OnDraftChangedAsync(string? value)
    {
        var next = value ?? string.Empty;
        UpdateDraftMentions(_draft, next);
        _draft = next;
        try
        {
            var module = await GetCommunicationsModuleAsync();
            _mentionCaret = await module.InvokeAsync<int>(
                "getComposerCaret", "communication-composer");
        }
        catch (JSException) { _mentionCaret = _draft.Length; }
        await RefreshMentionMatchesAsync();
    }

    private async Task RefreshMentionMatchesAsync()
    {
        if (_hub is null || _draft.Length == 0)
        {
            await SetMentionMenuOpenAsync(false);
            return;
        }
        var caret = Math.Clamp(_mentionCaret, 0, _draft.Length);
        var trigger = caret == 0 ? -1 : _draft.LastIndexOf('@', caret - 1);
        if (trigger < 0 || (trigger > 0 && !char.IsWhiteSpace(_draft[trigger - 1])))
        {
            await SetMentionMenuOpenAsync(false);
            return;
        }
        var query = _draft[(trigger + 1)..caret];
        if (query.Length > 80 || query.Contains('\n') ||
            query.Any(x => !(char.IsLetterOrDigit(x) || char.IsWhiteSpace(x) || x is '-' or '\'' or '.')))
        {
            await SetMentionMenuOpenAsync(false);
            return;
        }
        _mentionMatches = _hub.People
            .Where(x => x.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.DisplayName.StartsWith(query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(x => x.DisplayName)
            .ThenBy(x => x.EmployeeType)
            .Take(8)
            .ToList();
        if (_mentionMatches.Count == 0)
        {
            await SetMentionMenuOpenAsync(false);
            return;
        }
        _mentionTriggerOffset = trigger;
        _mentionCaret = caret;
        _mentionSelection = Math.Clamp(_mentionSelection, 0, _mentionMatches.Count - 1);
        await SetMentionMenuOpenAsync(true);
    }

    private async Task CommitMentionAsync(CommunicationPersonResponse person)
    {
        if (!_mentionOpen) return;
        var old = _draft;
        var mentionText = $"@{person.DisplayName}";
        var next = old[.._mentionTriggerOffset] + mentionText + " " + old[_mentionCaret..];
        UpdateDraftMentions(old, next);
        _draft = next;
        _draftMentions.Add(new DraftMention(
            person.Id, _mentionTriggerOffset, mentionText.Length, mentionText));
        var caret = _mentionTriggerOffset + mentionText.Length + 1;
        await SetMentionMenuOpenAsync(false);
        var module = await GetCommunicationsModuleAsync();
        await module.InvokeVoidAsync("setComposerCaret", "communication-composer", caret);
    }

    private void UpdateDraftMentions(string oldValue, string newValue)
    {
        if (_draftMentions.Count == 0) return;
        var prefix = 0;
        while (prefix < oldValue.Length && prefix < newValue.Length &&
               oldValue[prefix] == newValue[prefix]) prefix++;
        var suffix = 0;
        while (suffix < oldValue.Length - prefix && suffix < newValue.Length - prefix &&
               oldValue[oldValue.Length - 1 - suffix] == newValue[newValue.Length - 1 - suffix]) suffix++;
        var oldChangeEnd = oldValue.Length - suffix;
        var delta = newValue.Length - oldValue.Length;
        for (var index = _draftMentions.Count - 1; index >= 0; index--)
        {
            var mention = _draftMentions[index];
            var mentionEnd = mention.Offset + mention.Length;
            if (oldChangeEnd <= mention.Offset)
                mention = mention with { Offset = mention.Offset + delta };
            else if (prefix < mentionEnd && oldChangeEnd > mention.Offset)
            {
                _draftMentions.RemoveAt(index);
                continue;
            }
            if (mention.Offset < 0 || mention.Offset + mention.Length > newValue.Length ||
                !newValue.AsSpan(mention.Offset, mention.Length).SequenceEqual(mention.DisplayText))
            {
                _draftMentions.RemoveAt(index);
                continue;
            }
            _draftMentions[index] = mention;
        }
    }

    private async Task SetMentionMenuOpenAsync(bool open)
    {
        _mentionOpen = open;
        if (!open) _mentionMatches = [];
        try
