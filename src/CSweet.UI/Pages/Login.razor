@page "/login"
@layout AnonymousLayout
@using System.ComponentModel.DataAnnotations
@using CSweet.Contracts.Auth
@inject IAuthenticationApiClient AuthenticationApi
@inject NavigationManager Navigation
@inject IAppLocalizer L

<PageTitle>@L["Login.PageTitle"]</PageTitle>

<MudPaper Elevation="0" Class="auth-card">
    <MudText Typo="Typo.h4">@L["Login.Title"]</MudText>
    <MudText Color="Color.Secondary">@L["Login.Lead"]</MudText>
    @if (Reason == LoginRedirect.ReasonUnavailable)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@L["Login.Reason.Unavailable"]</MudAlert>
    }
    else if (Reason == LoginRedirect.ReasonExpired)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["Login.Reason.Expired"]</MudAlert>
    }
    <EditForm Model="_model" OnValidSubmit="LoginAsync" Class="auth-form">
        <DataAnnotationsValidator />
        <MudTextField Label="@L["Login.Email"]" InputType="InputType.Email" @bind-Value="_model.Email" For="@(() => _model.Email)" Variant="Variant.Outlined" Required="true" />
        <MudTextField Label="@L["Login.Password"]" InputType="InputType.Password" @bind-Value="_model.Password" For="@(() => _model.Password)" Variant="Variant.Outlined" Required="true" />
        <MudCheckBox T="bool" @bind-Value="_model.RememberMe" Label="@L["Login.RememberMe"]" />
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <MudAlert Severity="@(_success ? Severity.Success : Severity.Error)" Variant="Variant.Outlined">@_message</MudAlert>
        }
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_saving">@(_saving ? L["Login.SigningIn"] : L["Login.SignIn"])</MudButton>
        @if (_needsConfirmation)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" OnClick="ResendAsync">@L["Login.ResendConfirmation"]</MudButton>
        }
        <MudButton Href="/forgot-password" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">@L["Login.ForgotPassword"]</MudButton>
        <MudButton Href="/recover-root" Variant="Variant.Text" Color="Color.Secondary" FullWidth="true">@L["Login.UseRecoveryCode"]</MudButton>
    </EditForm>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "reason")] public string? Reason { get; set; }

    private readonly LoginModel _model = new();
    private bool _saving;
    private bool _needsConfirmation;
    private bool _success;
    private string? _message;

    private string UnreachableMessage => L["Login.Unreachable"];

    private async Task LoginAsync()
    {
        _saving = true;
        _needsConfirmation = false;
        _success = false;
        try
        {
            var result = await AuthenticationApi.LoginAsync(new LoginRequest(_model.Email, _model.Password, _model.RememberMe));
            if (result.Succeeded)
            {
                Navigation.NavigateTo(LoginRedirect.SafeReturnUrl(ReturnUrl), forceLoad: true);
                return;
            }
            _message = result.Message;
            _needsConfirmation = result.ErrorCode == "email_not_confirmed";
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            // Network failure or a non-JSON reply: report it instead of crashing the page.
            _message = UnreachableMessage;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResendAsync()
    {
        try
        {
            var result = await AuthenticationApi.ResendConfirmationAsync(_model.Email);
            _success = result.Succeeded;
            _message = result.Message;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _success = false;
            _message = UnreachableMessage;
        }
    }

    private sealed class LoginModel
    {
        [Required, EmailAddress] public string Email { get; set; } = string.Empty;
        [Required] public string Password { get; set; } = string.Empty;
        public bool RememberMe { get; set; }
    }
}
