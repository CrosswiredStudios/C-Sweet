@page "/settings/appearance"
@layout SettingsLayout
@inject AppearanceState AppearanceState
@implements IDisposable

<PageTitle>Appearance - C-Sweet</PageTitle>
<section class="appearance-settings">
    <MudText Typo="Typo.overline">Preferences</MudText>
    <MudText Typo="Typo.h4">Appearance</MudText>
    <p>Choose the look of your workspace. Applies to Overview, Projects and their detail tabs, and navigation.</p>
    <label for="workspace-theme">Theme</label>
    <select id="workspace-theme" value="@AppearanceState.Theme" @onchange="ChangeTheme">
        <option value="aurora">Aurora Light</option>
        <option value="gold">Black &amp; Gold</option>
    </select>
    <div class="appearance-preview @AppearanceState.Theme" aria-hidden="true">
        <div class="preview-nav"><span></span><span></span><span></span></div>
        <div class="preview-content"><strong>Your workspace</strong><div class="preview-card">A little clarity.<br />A little atmosphere.<i></i><i></i></div></div>
    </div>
    <p role="status">@(AppearanceState.PersistenceUnavailable ? "Theme applied for this session. Browser storage is unavailable, so it may reset when you return." : "Your preference is saved automatically in this browser.")</p>
</section>

@code {
    protected override void OnInitialized() => AppearanceState.Changed += OnChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await AppearanceState.InitializeAsync(); }
    private Task ChangeTheme(ChangeEventArgs args) => AppearanceState.SetThemeAsync(args.Value?.ToString() ?? "aurora");
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => AppearanceState.Changed -= OnChanged;
}
