@page "/personal-assistant"
@using CSweet.Contracts.PersonalAssistant
@using CSweet.Contracts.Realtime
@implements IDisposable
@inject PersonalAssistantApiClient Api
@inject IAppRealtimeConnection Realtime
@inject IAppLocalizer L

<PageTitle>@L["PersonalAssistant.PageTitle"]</PageTitle>
<div class="aurora-page business-workspace personal-assistant-workspace">
    <header class="enterprise-heading"><div><span class="business-kicker">@L["PersonalAssistant.YourSpace"]</span><h1>@L["PersonalAssistant.ALittleClarityYourNext"]</h1><p>@L["PersonalAssistant.PlanYourNextVentureAnd"]</p></div><MudButton Href="/?create=true" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add">@L["PersonalAssistant.NewBusiness"]</MudButton></header>
    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error <MudButton OnClick="ReloadAsync">@L["Common.Refresh"]</MudButton></MudAlert> }
    <div class="personal-assistant-grid">
        <div class="personal-assistant-guidance">
            <section class="assistant-panel"><span class="business-kicker">@L["PersonalAssistant.MakeAStart"]</span><h2>@L["PersonalAssistant.BringYourWorkAlong"]</h2><p>@L["PersonalAssistant.AlreadyBuildingAnAppGame"]</p><MudButton Href="/?create=true" Color="Color.Primary" EndIcon="@Icons.Material.Outlined.ArrowForward">@L["PersonalAssistant.PrepareABusiness"]</MudButton></section>
            <section class="assistant-panel"><h2>@L["PersonalAssistant.HelpfulStartingPoints"]</h2><ul><li>@L["PersonalAssistant.DescribeWhatYouReBuilding"]</li><li>@L["PersonalAssistant.KeepAREADMEOrProject"]</li><li>@L["PersonalAssistant.ReviewTheBriefBeforeYou"]</li></ul></section>
            @if (_drafts.Count > 0)
            {
                <section class="assistant-panel"><h2>@L["PersonalAssistant.PickUpWhereYouLeft"]</h2>@foreach (var draft in _drafts) { <a class="assistant-draft-link" href="@($"/?create=true&draft={draft.Id:D}")"><strong>@(draft.Review?.BusinessName is { Length: > 0 } name ? name : "Business from codebases")</strong><span>@draft.Sources.Count sources · @draft.Status</span><MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" /></a> }</section>
            }
            <section class="assistant-panel"><PersonalAssistantSettingsForm NameChanged="@(name => _assistantName = name)" ReadyChanged="@(ready => _ready = ready)" /></section>
        </div>
        <PersonalAssistantChat Ready="_ready" Name="@_assistantName" />
    </div>
</div>

@code {
    private IReadOnlyList<RepositoryOnboardingDraftResponse> _drafts = [];
    private bool _ready, _disposed;
    private string _assistantName = "AI Assistant";
    private string? _error;
    protected override async Task OnInitializedAsync() { Realtime.EventReceived += OnEvent; Realtime.Reconnected += OnReconnect; await ReloadAsync(); }
    private async Task ReloadAsync() { try { _drafts = await Api.DraftsAsync(); var settings = await Api.SettingsAsync(); _ready = settings.Ready; _assistantName = settings.Name; _error = null; } catch (Exception e) { _error = e.Message; } }
    private void OnEvent(AppRealtimeEventEnvelope e) { if (e.EventType is AppRealtimeEvents.RepositoryOnboardingChanged or AppRealtimeEvents.PersonalAssistantChanged) OnReconnect(); }
    private void OnReconnect() { if (!_disposed) _ = InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); }); }
    public void Dispose() { _disposed = true; Realtime.EventReceived -= OnEvent; Realtime.Reconnected -= OnReconnect; }
}
