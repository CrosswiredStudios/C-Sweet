@page "/setup"
@layout SetupLayout
@using CSweet.Contracts.Llm
@using CSweet.Contracts.Setup
@using System.Net.Http.Json
@using CSweet.Domain.Setup
@using CSweet.UI.Setup
@inject ISetupApiClient SetupApi
@inject ILlmProviderApiClient LlmProviderApi
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>C-Sweet Setup</PageTitle>

<div class="setup-shell">
    @if (_isLoading)
    {
        <MudPaper Elevation="1" Class="setup-card setup-loading-card" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Color="Color.Secondary">Preparing your setup...</MudText>
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <MudPaper Elevation="1" Class="setup-card setup-error-card">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_pageError</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">Retry</MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="1" Class="setup-card">
            <nav class="setup-progress" aria-label="Setup progress">
                <ol>
                    @foreach (var step in SetupSteps)
                    {
                        var isActive = step.Key == _activeStepKey;
                        var isComplete = IsStepComplete(step.Key);
                        <li class="@($"{(isActive ? "active" : null)} {(isComplete ? "complete" : null)}")">
                            <button type="button"
                                    aria-current="@(isActive ? "step" : null)"
                                    aria-label="@($"Step {step.Number}: {step.Title}{(isComplete ? ", complete" : string.Empty)}")"
                                    @onclick="() => SelectStep(step.Key)">
                                <span class="setup-progress-node">
                                    @if (isComplete)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" />
                                    }
                                    else
                                    {
                                        @step.Number
                                    }
                                </span>
                                <span class="setup-progress-label">@step.Title</span>
                            </button>
                        </li>
                    }
                </ol>
            </nav>

            <div class="setup-stage" @key="_activeStepKey">
                @if (_status?.IsFirstRunComplete == true)
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Filled">Setup is complete. Redirecting to business onboarding...</MudAlert>
                }
                else
                {
                    @RenderActiveStep()
                }
            </div>
        </MudPaper>
    }
</div>

@code {
    private static readonly IReadOnlyList<WizardStep> SetupSteps =
    [
        new(1, "welcome", "Welcome", "Start here"),
        new(2, "llm-provider", "LLM Providers", "Connect endpoints"),
        new(3, "genai-provider", "GenAI Providers", "Optional"),
        new(4, "email-delivery", "Email Delivery", "Optional"),
        new(5, "communications", "Communications", "Optional")
    ];

    private SetupStatusResponse? _status;
    private IReadOnlyList<LlmProviderProfileResponse> _profiles = [];
    private string _activeStepKey = "welcome";
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _pageError;
    private string? _stepMessage;
    private CommunicationSetupOptionsResponse? _communicationOptions;

    private Guid? _providerProfileId;
    private bool _localProviderDiscoveryAttempted;
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _pageError = null;

        try
        {
            _status = await SetupApi.GetStatusAsync();
            _profiles = await LlmProviderApi.ListAsync();
            _communicationOptions = await Http.GetFromJsonAsync<CommunicationSetupOptionsResponse>("api/setup/communications/options");
            _providerProfileId ??= _profiles.LastOrDefault()?.Id;

            if (_status.IsFirstRunComplete)
            {
                Navigation.NavigateTo("/");
                return;
            }

            _activeStepKey = SetupWizardState.FirstIncompleteStepKey(SetupSteps.Select(x => x.Key).ToList(), _status);
        }
        catch
        {
            _pageError = "Unable to load setup status from the API.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task ContinueFromWelcomeAsync()
    {
        return CompleteStepAsync("welcome", "llm-provider");
    }

    private void BackToWelcome() => SelectStep("welcome");
    private void BackToProvider() => SelectStep("llm-provider");
    private void BackToGenAiProvider() => SelectStep("genai-provider");
    private void BackToEmailDelivery() => SelectStep("email-delivery");

    private RenderFragment RenderActiveStep() => _activeStepKey switch
    {
        "welcome" => WelcomeStep,
        "llm-provider" => LlmProviderStep,
        "genai-provider" => GenAiProviderStep,
        "email-delivery" => EmailDeliveryStep,
        "communications" => CommunicationsStep,
        _ => WelcomeStep
    };

    private RenderFragment WelcomeStep => @<WelcomeSetupStep IsBusy="@_isBusy" OnContinue="@ContinueFromWelcomeAsync" />;

    private RenderFragment LlmProviderStep => @<LlmProviderSetupStep Profiles="@_profiles"
                                                                         SelectedProviderId="@_providerProfileId"
                                                                         ProfilesChanged="@HandleProfilesChangedAsync"
                                                                         AutoDiscoverLocalProviders="@(!_localProviderDiscoveryAttempted)"
                                                                         LocalProviderDiscoveryAttempted="@HandleLocalProviderDiscoveryAttempted"
                                                                         OnContinue="@ContinueFromProviderAsync"
                                                                         OnBack="@BackToWelcome" />;

    private RenderFragment GenAiProviderStep => @<GenAiProviderSetupStep OnContinue="@ContinueFromGenAiProviderAsync"
                                                                              OnBack="@BackToProvider" />;

    private RenderFragment EmailDeliveryStep =>
        @<EmailDeliverySetupStep OnBack="@BackToGenAiProvider" OnContinue="@ContinueFromEmailDeliveryAsync" />;

    private RenderFragment CommunicationsStep => @<CommunicationsSetupStep Options="@_communicationOptions"
                                                                              OnBack="@BackToEmailDelivery"
                                                                              CompletionMessage="@_stepMessage"
                                                                              OnContinue="@CompleteCommunicationsAsync" />;

    private Task HandleProfilesChangedAsync(IReadOnlyList<LlmProviderProfileResponse> profiles)
    {
        _profiles = profiles;
        return Task.CompletedTask;
    }

    private void HandleLocalProviderDiscoveryAttempted()
    {
        _localProviderDiscoveryAttempted = true;
    }

    private async Task ContinueFromProviderAsync(Guid? providerProfileId)
    {
        if (_profiles.Count == 0)
        {
            return;
        }

        _providerProfileId = providerProfileId ?? _profiles.Last().Id;
        await CompleteStepAsync("llm-provider", "genai-provider");
    }

    private Task ContinueFromGenAiProviderAsync() =>
        CompleteStepAsync("genai-provider", "email-delivery");

    private Task ContinueFromEmailDeliveryAsync() => CompleteStepAsync("email-delivery", "communications");

    private async Task CompleteCommunicationsAsync()
    {
        await FinishSetupAsync();
    }

    private async Task FinishSetupAsync()
    {
        _isBusy = true;
        _stepMessage = null;

        try
        {
            var result = await SetupApi.CompleteSetupAsync();
            _status = result.Status ?? _status;

            if (result.Succeeded)
            {
                Navigation.NavigateTo("/");
                return;
            }

            _stepMessage = result.Message ?? "Setup could not be completed.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CompleteStepAsync(string key, string nextStepKey)
    {
        _isBusy = true;
        _stepMessage = null;

        var result = await SetupApi.CompleteStepAsync(key);
        _status = result.Status ?? _status;

        if (result.Succeeded)
        {
            _activeStepKey = nextStepKey;
        }
        else
        {
            _stepMessage = result.Message;
        }

        _isBusy = false;
    }

    private void SelectStep(string key)
    {
        _activeStepKey = key;
        _stepMessage = null;
    }

    private bool IsStepComplete(string key)
    {
        return _status?.Steps.Any(x => x.Key == key && x.IsComplete) == true;
    }

    private sealed record WizardStep(int Number, string Key, string Title, string Description);
}
