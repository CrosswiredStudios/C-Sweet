@page "/setup"
@layout SetupLayout
@using CSweet.Contracts.Llm
@using CSweet.Contracts.Setup
@using CSweet.Domain.Setup
@using CSweet.UI.Setup
@inject ISetupApiClient SetupApi
@inject ILlmProviderApiClient LlmProviderApi
@inject NavigationManager Navigation
@inject IAppLocalizer L

<PageTitle>@L["Setup.PageTitle"]</PageTitle>

<div class="setup-shell setup-assistant">
    @if (_isLoading)
    {
        <MudPaper Elevation="1" Class="setup-card setup-loading-card" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Color="Color.Secondary">@L["Setup.PreparingYourSetup"]</MudText>
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <MudPaper Elevation="1" Class="setup-card setup-error-card">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_pageError</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">@L["Common.Retry"]</MudButton>
        </MudPaper>
    }
    else
    {
            <nav class="setup-progress" aria-label="@L["Setup.SetupProgress"]">
                <ol>
                    @foreach (var step in SetupSteps)
                    {
                        var isActive = step.Key == _activeStepKey;
                        var isComplete = IsStepComplete(step.Key);
                        var canSelect = CanSelectStep(step.Key);
                        <li class="@($"{(isActive ? "active" : null)} {(isComplete ? "complete" : null)} {(!canSelect ? "locked" : null)}")">
                            <button type="button"
                                    disabled="@(!canSelect)"
                                    aria-current="@(isActive ? "step" : null)"
                                    aria-label="@($"Step {step.Number}: {step.Title}{(isComplete ? ", complete" : !canSelect ? ", locked until the current step is complete" : string.Empty)}")"
                                    @onclick="() => SelectStep(step.Key)">
                                <span class="setup-progress-node">
                                    @if (isComplete)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" />
                                    }
                                    else
                                    {
                                        @step.Number
                                    }
                                </span>
                                <span class="setup-progress-label">@step.Title</span>
                            </button>
                        </li>
                    }
                </ol>
            </nav>
        <MudPaper Elevation="0" Class="setup-card">
            <aside class="setup-story" aria-label="@L["Setup.SetupAssistant"]">
                <span class="setup-story-eyebrow">@L["Setup.ALittleSetupALot"]</span>
                <h2>@StoryTitle</h2>
                <p>@StoryDescription</p>
                <div class="setup-story-art" aria-hidden="true">
                    <div class="setup-art-window back"></div>
                    <div class="setup-art-window front">
                        <span class="setup-art-dots">•••</span>
                        <MudIcon Icon="@StoryIcon" />
                        <div class="setup-art-line"></div><div class="setup-art-line short"></div>
                    </div>
                </div>
                <div class="setup-story-note"><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" /><span>@L["Setup.YouChooseWhereYourAgents"]</span></div>
            </aside>
            <div class="setup-stage" @key="_activeStepKey" aria-busy="@_isBusy">
                @if (_status?.IsFirstRunComplete == true)
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Filled">@L["Setup.YourWorkspaceIsReadyOpening"]</MudAlert>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_stepMessage) && _activeStepKey != "agent-execution")
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="setup-step-error">@_stepMessage</MudAlert>
                    }
                    @RenderActiveStep()
                }
            </div>
        </MudPaper>
        <p class="setup-progress-note"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" /> @L["Setup.YourCompletedStepsAreSaved"]</p>
    }
</div>

@code {
    private string StoryTitle => _activeStepKey switch
    {
        "agent-execution" => "A place for your team to work.",
        "llm-provider" => "The thinking behind your team.",
        "personal-assistant" => "An assistant, made yours.",
        "genai-provider" => "Make room for imagination.",
        "connection-service" => "Connect on your terms.",
        _ => "Your next great team starts here."
    };
    private string StoryDescription => _activeStepKey switch
    {
        "agent-execution" => "Connect an Office here or on another machine. We'll guide you through installation and check that it's ready.",
        "llm-provider" => "Use your own hardware, a hosted service, or both. Start with one connection and add more as you grow.",
        "personal-assistant" => "Give your assistant a name and choose how it thinks. You can change these settings anytime.",
        "genai-provider" => "Give your agents tools to create images and video. You can always add these later.",
        _ => "Connect the essentials. Then bring your ideas to life with a team of your own."
    };
    private string StoryIcon => _activeStepKey switch
    {
        "agent-execution" => Icons.Material.Outlined.Computer,
        "llm-provider" => Icons.Material.Outlined.Hub,
        "personal-assistant" => Icons.Material.Outlined.AutoAwesome,
        "genai-provider" => Icons.Material.Outlined.PermMedia,
        _ => Icons.Material.Outlined.Groups
    };
    private static readonly IReadOnlyList<WizardStep> SetupSteps =
    [
        new(1, "welcome", "Welcome", "What to expect"),
        new(2, "agent-execution", "Agent hosting", "Required · Connect a machine"),
        new(3, "llm-provider", "AI models", "Required · Connect a provider"),
        new(4, "personal-assistant", "AI Assistant", "Required · Make it yours"),
        new(5, "genai-provider", "Images & video", "Optional"),
        new(6, "connection-service", "Connections", "Optional")
    ];

    private SetupStatusResponse? _status;
    private IReadOnlyList<LlmProviderProfileResponse> _profiles = [];
    private string _activeStepKey = "welcome";
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _pageError;
    private string? _stepMessage;

    private Guid? _providerProfileId;
    private bool _localProviderDiscoveryAttempted;
    private bool _localGenAiProviderDiscoveryAttempted;
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _pageError = null;

        try
        {
            _status = await SetupApi.GetStatusAsync();
            _profiles = await LlmProviderApi.ListAsync();
            _providerProfileId ??= _profiles.LastOrDefault()?.Id;

            if (_status.IsFirstRunComplete)
            {
                Navigation.NavigateTo("/");
                return;
            }

            _activeStepKey = SetupWizardState.FirstIncompleteStepKey(SetupSteps.Select(x => x.Key).ToList(), _status);
        }
        catch
        {
            _pageError = L["Setup.UnableToLoadSetupStatus"];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task ContinueFromWelcomeAsync()
    {
        return CompleteStepAsync("welcome", "agent-execution");
    }

    private void BackToWelcome() => SelectStep("welcome");
    private void BackToExecution() => SelectStep("agent-execution");
    private void BackToAssistant() => SelectStep("personal-assistant");
    private void BackToProvider() => SelectStep("llm-provider");

    private RenderFragment RenderActiveStep() => _activeStepKey switch
    {
        "welcome" => WelcomeStep,
        "agent-execution" => AgentExecutionStep,
        "llm-provider" => LlmProviderStep,
        "personal-assistant" => AssistantStep,
        "genai-provider" => GenAiProviderStep,
        "connection-service" => ConnectionServiceStep,
        _ => WelcomeStep
    };

    private RenderFragment ConnectionServiceStep => @<ConnectionServiceSetupStep OnContinue="FinishSetupAsync" OnBack="BackToGenAi" />;

    private RenderFragment WelcomeStep => @<WelcomeSetupStep IsBusy="@_isBusy" OnContinue="@ContinueFromWelcomeAsync" />;

    private RenderFragment AgentExecutionStep =>
        @<AgentHostOnboardingStep OnBack="@BackToWelcome"
                                  OnContinue="@ContinueFromExecutionAsync"
                                  IsCompleting="@_isBusy"
                                  CompletionMessage="@_stepMessage" />;

    private RenderFragment LlmProviderStep => @<LlmProviderSetupStep Profiles="@_profiles"
                                                                         SelectedProviderId="@_providerProfileId"
                                                                         ProfilesChanged="@HandleProfilesChangedAsync"
                                                                         AutoDiscoverLocalProviders="@(!_localProviderDiscoveryAttempted)"
                                                                         LocalProviderDiscoveryAttempted="@HandleLocalProviderDiscoveryAttempted"
                                                                         OnContinue="@ContinueFromProviderAsync"
                                                                         OnBack="@BackToExecution" />;

    private RenderFragment AssistantStep => @<PersonalAssistantSetupStep PreferredProviderId="@_providerProfileId" IsCompleting="@_isBusy"
        OnBack="@BackToProvider" OnContinue="@ContinueFromAssistantAsync" />;

    private RenderFragment GenAiProviderStep => @<GenAiProviderSetupStep IsFinalStep="false" IsCompleting="@_isBusy" AutoDiscoverLocalProviders="@(!_localGenAiProviderDiscoveryAttempted)"
                                                                              LocalProviderDiscoveryAttempted="@HandleLocalGenAiProviderDiscoveryAttempted"
                                                                              OnContinue="@ContinueFromGenAiProviderAsync"
                                                                              OnBack="@BackToAssistant" />;

    private Task HandleProfilesChangedAsync(IReadOnlyList<LlmProviderProfileResponse> profiles)
    {
        _profiles = profiles;
        return Task.CompletedTask;
    }

    private void HandleLocalProviderDiscoveryAttempted()
    {
        _localProviderDiscoveryAttempted = true;
    }

    private void HandleLocalGenAiProviderDiscoveryAttempted()
    {
        _localGenAiProviderDiscoveryAttempted = true;
    }

    private async Task ContinueFromProviderAsync(Guid? providerProfileId)
    {
        if (_profiles.Count == 0)
        {
            return;
        }

        _providerProfileId = providerProfileId ?? _profiles.Last().Id;
        await CompleteStepAsync("llm-provider", "personal-assistant");
    }

    private async Task ContinueFromExecutionAsync()
    {
        await CompleteStepAsync("agent-execution", "llm-provider");
    }

    private Task ContinueFromAssistantAsync() => CompleteStepAsync("personal-assistant", "genai-provider");

    private void BackToGenAi() => SelectStep("genai-provider");
    private Task ContinueFromGenAiProviderAsync() => CompleteStepAsync("genai-provider", "connection-service");

    private async Task FinishSetupAsync()
    {
        _isBusy = true;
        _stepMessage = null;

        try
        {
            var step = await SetupApi.CompleteStepAsync("connection-service");
            if (!step.Succeeded)
            {
                _stepMessage = step.Message ?? "We couldn't save this step. Please try again.";
                return;
            }
            var result = await SetupApi.CompleteSetupAsync();
            _status = result.Status ?? _status;

            if (result.Succeeded)
            {
                Navigation.NavigateTo("/");
                return;
            }

            _stepMessage = result.Message ?? "Setup could not be completed.";
        }
        catch
        {
            _stepMessage = L["Setup.WeCouldnTFinishSetup"];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CompleteStepAsync(string key, string nextStepKey)
    {
        _isBusy = true;
        _stepMessage = null;
        try
        {
            var result = await SetupApi.CompleteStepAsync(key);
            _status = result.Status ?? _status;

            if (result.Succeeded)
            {
                _activeStepKey = nextStepKey;
            }
            else
            {
                _stepMessage = result.Message;
            }
        }
        catch
        {
            _stepMessage = L["Setup.CSweetCouldNotSave"];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void SelectStep(string key)
    {
        if (!CanSelectStep(key))
        {
            return;
        }

        _activeStepKey = key;
        _stepMessage = null;
    }

    private bool CanSelectStep(string key)
    {
        return !_isBusy && _status is not null && SetupWizardState.CanNavigateToStep(
            SetupSteps.Select(step => step.Key).ToList(),
            _status,
            key);
    }

    private bool IsStepComplete(string key)
    {
        return _status?.Steps.Any(x => x.Key == key && x.IsComplete) == true;
    }

    private sealed record WizardStep(int Number, string Key, string Title, string Description);
}
