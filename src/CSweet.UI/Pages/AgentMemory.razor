@page "/organizations/{OrganizationId:guid}/employees/{EmployeeId:guid}/memory"
@using CSweet.Contracts.Memory
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="learning-journal">
@if (_loading)
{
    <div class="journal-loading"><MudProgressCircular Indeterminate="true" Size="Size.Small" /><span>Opening memory…</span></div>
}
else if (_summary is null)
{
    <MudAlert Severity="Severity.Warning">@(_error ?? "Memory is unavailable.")</MudAlert>
    <MudButton OnClick="InitializeAsync">Try again</MudButton>
}
else
{
    <header class="journal-heading">
        <div><h2>Learning journal</h2><p>What @_summary.EmployeeName has recorded, refined, and recalled.</p></div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Tune" OnClick="@(() => _manageOpen = !_manageOpen)" aria-expanded="@_manageOpen.ToString().ToLowerInvariant()">Manage memory</MudButton>
    </header>
    <div class="journal-toolbar">
        <div class="journal-views" role="group" aria-label="Memory view">
            @foreach (var view in new[] { "Journal", "All memory", "Connections" })
            {
                <button type="button" aria-pressed="@((_view == view).ToString().ToLowerInvariant())" @onclick="@(() => _view = view)">@view</button>
            }
        </div>
        <div class="journal-search">
            <MudTextField T="string" Placeholder="Search memory…" aria-label="Search memory" @bind-Value="_search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" OnKeyDown="SearchKeyDown" Disabled="@SelectionLocked" />
            <MudIconButton Icon="@Icons.Material.Outlined.Search" aria-label="Search" OnClick="SearchAsync" Disabled="@(SelectionLocked || _loadingItems || _loadingJournal)" />
            <MudButton OnClick="@(() => _filtersOpen = !_filtersOpen)" aria-expanded="@_filtersOpen.ToString().ToLowerInvariant()" StartIcon="@Icons.Material.Outlined.FilterList">Filters</MudButton>
        </div>
    </div>
    <div class="journal-filters" hidden="@(!_filtersOpen)">
            <MudSelect T="string" Label="Type" @bind-Value="_kind" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@string.Empty">All memory</MudSelectItem>
                @foreach (var kind in Kinds)
                {
                    <MudSelectItem T="string" Value="@kind">@kind</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Namespace" @bind-Value="_scope" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@string.Empty">All namespaces</MudSelectItem>
                <MudSelectItem T="string" Value="@("Relationship")">Relationship</MudSelectItem>
                <MudSelectItem T="string" Value="@("Employee")">Employee</MudSelectItem>
                <MudSelectItem T="string" Value="@("Organization")">Organization</MudSelectItem>
                <MudSelectItem T="string" Value="@("Team")">Team</MudSelectItem>
                <MudSelectItem T="string" Value="@("Role")">Role</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" Label="Source" @bind-Value="_source" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@string.Empty">All sources</MudSelectItem>
                <MudSelectItem T="string" Value="@("user")">User</MudSelectItem>
                <MudSelectItem T="string" Value="@("assistant")">Assistant</MudSelectItem>
                <MudSelectItem T="string" Value="@("enrichment")">Enrichment</MudSelectItem>
                <MudSelectItem T="string" Value="@("curated")">Curated</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" Label="Sensitivity" @bind-Value="_sensitivity" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@string.Empty">All sensitivities</MudSelectItem>
                @foreach (var value in Sensitivities) { <MudSelectItem T="string" Value="@value">@value</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" Label="Confirmation" @bind-Value="_state" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@string.Empty">All states</MudSelectItem>
                @foreach (var value in States) { <MudSelectItem T="string" Value="@value">@value</MudSelectItem> }
            </MudSelect>
            <MudDatePicker Label="From" @bind-Date="_from" Variant="Variant.Outlined" Clearable="true" />
            <MudDatePicker Label="To" @bind-Date="_to" Variant="Variant.Outlined" Clearable="true" />
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SearchAsync" Disabled="@(SelectionLocked || _loadingItems || _loadingJournal)">Search</MudButton>

        <MudButton OnClick="ClearFiltersAsync" Disabled="@(SelectionLocked || _loadingItems || _loadingJournal)">Clear filters</MudButton>
    </div>
    @if (_view == "Connections") { <p class="journal-caption">Connections use your search text. Other filters apply to Journal and All memory.</p> }
    @if (_error is not null) { <MudAlert Severity="Severity.Warning">@_error</MudAlert> }
    @if (SelectionLocked) { <MudAlert Severity="Severity.Info">Finish or retry the current review before selecting another memory.</MudAlert> }
    <section class="journal-management" hidden="@(!_manageOpen)" aria-label="Manage memory">
        <div class="management-heading"><h3>Manage memory</h3><MudIconButton Icon="@Icons.Material.Outlined.Close" aria-label="Close management" OnClick="@(() => _manageOpen = false)" /></div>
        <details><summary>Processing & recovery</summary>
        <MudPaper Elevation="1" Class="surface-panel pa-4 mb-4" aria-label="Memory processing recovery">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6">Memory processing</MudText>
                <MudButton OnClick="RefreshRecoveryAsync" Disabled="@_recovering" StartIcon="@Icons.Material.Filled.Refresh">Refresh</MudButton>
            </MudStack>
            @if (_recoveryError is not null)
            {
                <MudAlert Severity="Severity.Warning">@_recoveryError</MudAlert>
            }
            @if (_recoveryNotice is not null)
            {
                <MudAlert Severity="Severity.Info">@_recoveryNotice</MudAlert>
            }
            @if (_failures is { Items.Count: > 0 })
            {
                <MudText Class="mb-2">These memories need attention. After resolving the underlying issue, retry processing. Previously accepted results will be reused.</MudText>
                @foreach (var job in _failures.Items)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" @key="job.Id">
                        <div>
                            <MudText>@FailureLabel(job.FailureCode)</MudText>
                            <MudText Typo="Typo.caption">@(job.JobKind == "episode" ? "Episode" : "Conversation") · @job.CreatedAt.ToLocalTime().ToString("g") · @job.Attempts attempts · @(job.HasAcceptedExtraction ? "Saved results available" : "Extraction needed")</MudText>
                        </div>
                        <MudButton Color="Color.Secondary" Variant="Variant.Outlined" Disabled="@(_recovering || job.FailureCode is "memory_enrichment_source_invalidated" or "memory_enrichment_unverifiable_output" or "memory_enrichment_input_receipt_capacity" or "memory_enrichment_authority_revoked" or "memory_transfer_source_unavailable" or "memory_capture_excluded" or "memory_source_changed" or "memory_source_suppressed" or "memory_source_erased")"
                                   OnClick="@(() => RetryAsync(job))" aria-label="Retry memory processing">Retry processing</MudButton>
                    </MudStack>
                }
                @if (_failures.NextCursor is not null)
                {
                    <MudButton OnClick="LoadMoreFailuresAsync" Disabled="@_recovering">Load more</MudButton>
                }
            }
            else if (_failures is not null)
            {
                <MudText Color="Color.Secondary">No failed memory jobs.</MudText>
            }
        </MudPaper>

        <MemoryIngestionRecoveryPanel OrganizationId="OrganizationId" EmployeeId="EmployeeId" Recovered="RefreshRecoveryAsync" />
        <MemoryReextractionPanel OrganizationId="OrganizationId" EmployeeId="EmployeeId" Recovered="RefreshRecoveryAsync" />

        </details>
        <details><summary>Transfer knowledge</summary><MemoryTransferPanel OrganizationId="OrganizationId" EmployeeId="EmployeeId" Selected="_selected" @key="EmployeeId" /></details>
        <details><summary>Saved erasure operations</summary><MemoryErasureStatusPanel OrganizationId="OrganizationId" EmployeeId="EmployeeId" /></details>
        <details><summary>System details</summary>
            <div class="journal-counts">
                @SummaryCard("Episodes", _summary.EpisodeCount, Icons.Material.Outlined.History)
                @SummaryCard("Claims", _summary.ClaimCount, Icons.Material.Outlined.FactCheck)
                @SummaryCard("Entities", _summary.EntityCount, Icons.Material.Outlined.Hub)
                @SummaryCard("Relationships", _summary.RelationshipCount, Icons.Material.Outlined.Share)
                @SummaryCard("Procedures", _summary.ProcedureCount, Icons.Material.Outlined.Schema)
                @SummaryCard("Pending", _summary.PendingCaptureCount, Icons.Material.Outlined.Sync)
            </div>
            <p>@_summary.AgentName · @_summary.AgentDefinitionId</p><p>Installation @_summary.InstallationId</p>
        </details>
    </section>
    <div class="journal-layout @(_selected is not null ? "has-selection" : "")">
        <section class="journal-main" aria-label="@_view">
            @if (_loadingItems) { <MudProgressLinear Indeterminate="true" /> }
            @if (_view == "Connections") { @GraphPanel() }
            else
            {
                <div class="journal-list-heading"><h3>@(_view == "Journal" ? "Recorded activity" : "Memory library")</h3><span>@(_page?.TotalCount ?? 0) @(_page?.TotalCount == 1 ? "memory" : "memories")</span></div>
                @if (_view == "Journal")
                {
                    <p class="journal-caption">Activity for @_page?.Items.Count loaded @(_page?.Items.Count == 1 ? "memory" : "memories"). Includes up to 20 revisions per memory; full history is available in the inspector.</p>
                    @if (_loadingJournal) { <p class="journal-caption">Loading saved review and recall activity…</p> }
                    @if (_journalNotice is not null) { <MudAlert Severity="Severity.Info">@_journalNotice <MudButton OnClick="LoadJournalAsync" Disabled="@_loadingJournal">Retry activity</MudButton></MudAlert> }
                    @foreach (var group in JournalEntries.GroupBy(x => x.At.ToLocalTime().Date))
                    {
                        <h4 class="journal-date">@group.Key.ToString("dddd, MMMM d")</h4>
                        @foreach (var entry in group)
                        {
                            <button type="button" class="journal-entry @(entry.Item.Id == _selected?.Id ? "selected" : "")" @onclick="@(() => SelectItemAsync(entry.Item))" disabled="@SelectionLocked">
                                <span class="journal-event-icon"><MudIcon Icon="@(entry.Label == "Recalled" ? Icons.Material.Outlined.AutoAwesome : Icons.Material.Outlined.HistoryEdu)" Size="Size.Small" /></span>
                                <span class="journal-entry-body"><span class="journal-entry-meta">@entry.Label · @entry.Item.Kind <time>@entry.At.ToLocalTime().ToString("t")</time></span><strong>@entry.Item.Title</strong><span>@Truncate(entry.Text, 180)</span></span>
                                <span class="journal-entry-arrow" aria-hidden="true">↗</span>
                            </button>
                        }
                    }
                }
                else { @ItemsPanel("All") }
                @if (!_loadingItems && _page is { Items.Count: 0 }) { <div class="journal-empty"><MudIcon Icon="@Icons.Material.Outlined.AutoStories" Size="Size.Large" /><h3>No matching memories</h3><p>Try another search or clear the filters. New records will appear here as they are captured.</p></div> }
                @if (_page?.NextCursor is not null) { <MudButton Class="mt-3" OnClick="LoadMoreItemsAsync" Disabled="@(_loadingItems || _loadingJournal || SelectionLocked)">Load more memories</MudButton> }
            }
        </section>
        <div class="journal-side">
            @if (_selected is not null)
            {
                <div class="inspector-heading"><span>Memory inspector</span><MudIconButton Icon="@Icons.Material.Outlined.Close" aria-label="Close memory inspector" Disabled="@SelectionLocked" OnClick="CloseInspector" /></div>
                @DetailPanel()
            }
            else
            {
                <aside class="journal-context"><span class="journal-eyebrow">Always in view</span><h3>Pinned context</h3><p class="journal-caption">Core memory pinned for this employee.</p>
                    @foreach (var item in _pinned) { <button type="button" class="context-item" @onclick="@(() => SelectItemAsync(item))"><strong>@item.Title</strong><span>@Truncate(item.Content, 150)</span></button> }
                    @if (_pinned.Count > 0 && _pinnedError is not null) { <p class="journal-caption">@_pinnedError</p> }
                    @if (_pinned.Count == 0) { <p class="journal-caption">@(_pinnedError ?? "No pinned context yet. Open a core memory to review and pin it.")</p> }
                    <MudButton OnClick="ShowCoreAsync" Disabled="@(_loadingItems || SelectionLocked)">Explore core memory</MudButton>
                </aside>
                <aside class="journal-health"><span class="health-dot" style="@(_summary.Health == "Healthy" ? null : "background:var(--mud-palette-warning)")"></span><div><strong>@_summary.Health</strong><p>@_summary.PendingCaptureCount pending capture@(_summary.PendingCaptureCount == 1 ? "" : "s")</p><button type="button" @onclick="@(() => _manageOpen = true)">Review processing →</button></div></aside>
            }
        </div>
    </div>
}
</div>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid EmployeeId { get; set; }
    [Parameter] public bool Embedded { get; set; }

    private static readonly string[] Kinds = ["Episode", "Claim", "Entity", "Relationship", "Procedure", "Core"];
    private static readonly string[] Sensitivities = ["Public", "Internal", "Personal", "Confidential", "Restricted"];
    private static readonly string[] States = ["Recorded", "Suppressed", "NotRequired", "Pending", "Confirmed", "Rejected", "Current", "Superseded", "Pinned"];
    private AgentMemorySummaryResponse? _summary;
    private AgentMemoryPageResponse? _page;
    private AgentMemoryGraphResponse? _graph;
    private AgentMemoryItemResponse? _selected;
    private MemoryEnrichmentJobPageResponse? _failures;
    private bool _recovering;
    private string? _recoveryError;
    private string? _recoveryNotice;
    private readonly Dictionary<(Guid JobId, int Generation), Guid> _retryIdentities = [];
    private bool _loading = true;
    private bool _loadingItems;
    private string? _error;
    private string _search = string.Empty;
    private string _kind = string.Empty;
    private string _scope = string.Empty;
    private string _source = string.Empty;
    private string _sensitivity = string.Empty;
    private string _state = string.Empty;
    private DateTime? _from;
    private DateTime? _to;
    private (Guid, Guid)? _loadedIdentity;
    protected override async Task OnParametersSetAsync()
    {
        if (!Embedded)
        {
            Navigation.NavigateTo($"/organizations/{OrganizationId}/employees/{EmployeeId}?tab=memory", replace: true);
            return;
        }
        if (_loadedIdentity == (OrganizationId, EmployeeId)) return;
        _loadedIdentity = (OrganizationId, EmployeeId);
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        _loading = true; _error = null;
        _failures = null;
        _recoveryError = null;
        _recoveryNotice = null;
        _retryIdentities.Clear();
        try
        {
            _summary = await Http.GetFromJsonAsync<AgentMemorySummaryResponse>(BaseUrl + "/summary");
            _loading = false;
            StateHasChanged();
            await Task.WhenAll(LoadItemsAsync(), LoadGraphAsync(), RefreshFailuresAsync(), LoadPinnedAsync());
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private string BaseUrl => $"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/memory";

    private async Task RefreshFailuresAsync() => await ReadFailuresAsync(null);
    private async Task LoadMoreFailuresAsync() => await ReadFailuresAsync(_failures?.NextCursor);

    private async Task RefreshRecoveryAsync()
    {
        var alreadyRecovering = _recovering;
        _recovering = true;
        try
        {
            await RefreshFailuresAsync();
            _summary = await Http.GetFromJsonAsync<AgentMemorySummaryResponse>(BaseUrl + "/summary");
        }
        catch (Exception) { _recoveryError = "Memory processing status could not be refreshed."; }
        finally { _recovering = alreadyRecovering; }
    }

    private async Task ReadFailuresAsync(string? cursor)
    {
        var alreadyRecovering = _recovering;
        _recovering = true;
        _recoveryError = null;
        try
        {
            var suffix = cursor is null ? string.Empty : $"&cursor={Uri.EscapeDataString(cursor)}";
            using var response = await Http.GetAsync($"{BaseUrl}/enrichment/failures?limit=20{suffix}");
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _failures = null;
                _recoveryError = "Memory recovery is available to authorized human managers in this employee's reporting hierarchy.";
                return;
            }
            response.EnsureSuccessStatusCode();
            var page = await response.Content.ReadFromJsonAsync<MemoryEnrichmentJobPageResponse>();
            if (page is not null)
                _failures = cursor is null || _failures is null ? page : new(
                    _failures.Items.Concat(page.Items).DistinctBy(x => x.Id).ToList(), page.NextCursor);
        }
        catch (Exception) { _recoveryError = "Failed memory jobs could not be loaded. Try refreshing."; }
        finally { _recovering = alreadyRecovering; }
    }

    private async Task RetryAsync(MemoryEnrichmentJobResponse job)
    {
        _recovering = true;
        _recoveryError = null;
        _recoveryNotice = null;
        var key = (job.Id, job.RetryGeneration);
        if (!_retryIdentities.TryGetValue(key, out var operationId))
            _retryIdentities[key] = operationId = Guid.NewGuid();
        try
        {
            using var response = await Http.PostAsJsonAsync($"{BaseUrl}/enrichment/{job.Id}/retry",
                new RetryMemoryEnrichmentRequest(operationId, job.RetryGeneration));
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _recoveryNotice = "The job changed or its source is unavailable. Check the employee, source access and processing configuration, then refresh.";
                await RefreshRecoveryAsync();
                return;
            }
            if (response.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized)
            {
                _failures = null;
                _recoveryError = "You no longer have permission to retry this memory. Sign in or ask an authorized manager.";
                return;
            }
            response.EnsureSuccessStatusCode();
            var result = await response.Content.ReadFromJsonAsync<RetryMemoryEnrichmentResponse>();
            _recoveryNotice = result?.Job.Status switch
            {
                "Completed" => "This memory has already been processed.",
                "Failed" => "This retry was already recorded, but processing failed again. Review the latest failure before requesting another retry.",
                "Pending" or "Processing" => "Retry requested. Processing will resume when background capacity is available.",
                _ => "Refresh to check the current processing status."
            };
            await RefreshRecoveryAsync();
        }
        catch (Exception) { _recoveryError = "The retry could not be confirmed. Try again; repeating this request will not restart the job twice."; }
        finally { _recovering = false; }
    }

    private static string FailureLabel(string? code) => code switch
    {
        "memory_enrichment_timeout" => "Processing timed out",
        "memory_enrichment_attempts_exhausted" => "Processing reached its retry limit",
        "memory_enrichment_source_invalidated" => "The source changed or is unavailable. Retrying is disabled.",
        "memory_enrichment_authority_revoked" => "The source no longer has permission to be processed. Retrying is disabled.",
        "memory_transfer_source_unavailable" => "Transferred evidence is unavailable. Retrying is disabled.",
        "memory_enrichment_unverifiable_output" => "Saved results lack verifiable source evidence. Retrying is disabled.",
        "memory_enrichment_input_receipt_capacity" => "This extraction has reached its input-evidence limit. An operator must review its history before further processing.",
        "memory_capture_excluded" => "This source is excluded from memory processing. Retrying is disabled.",
        "memory_source_erased" => "This extraction was removed by forgetting a source. Retrying is disabled.",
        _ => "Memory processing failed"
    };

    private Task LoadItemsAsync() => ReadItemsAsync(null);
    private Task LoadMoreItemsAsync() => ReadItemsAsync(_page?.NextCursor);
    private string _appliedQuery = "limit=20";
    private async Task ReadItemsAsync(string? cursor)
    {
        if (SelectionLocked || _loadingItems || _loadingJournal) return;
        _loadingItems = true;
        try
        {
            var parameters = new List<string> { "limit=20" };

            if (!string.IsNullOrWhiteSpace(_search)) parameters.Add($"search={Uri.EscapeDataString(_search)}");
            if (!string.IsNullOrWhiteSpace(_kind)) parameters.Add($"kind={Uri.EscapeDataString(_kind)}");
            if (!string.IsNullOrWhiteSpace(_scope)) parameters.Add($"scope={Uri.EscapeDataString(_scope)}");
            if (!string.IsNullOrWhiteSpace(_source)) parameters.Add($"source={Uri.EscapeDataString(_source)}");
            if (!string.IsNullOrWhiteSpace(_sensitivity)) parameters.Add($"sensitivity={Uri.EscapeDataString(_sensitivity)}");
            if (!string.IsNullOrWhiteSpace(_state)) parameters.Add($"state={Uri.EscapeDataString(_state)}");
            if (_from.HasValue) parameters.Add($"from={Uri.EscapeDataString(_from.Value.ToString("O"))}");
            if (_to.HasValue) parameters.Add($"to={Uri.EscapeDataString(_to.Value.Date.AddDays(1).AddTicks(-1).ToString("O"))}");
            if (cursor is null) _appliedQuery = string.Join('&', parameters);
            var query = _appliedQuery + (cursor is null ? "" : $"&cursor={Uri.EscapeDataString(cursor)}");
            var page = await Http.GetFromJsonAsync<AgentMemoryPageResponse>($"{BaseUrl}/items?{query}", _lifetime.Token);
            _page = cursor is null || _page is null || page is null ? page : page with { Items = _page.Items.Concat(page.Items).DistinctBy(x => x.Id).ToList() };
            _error = null;
            if (cursor is null && !SelectionLocked) _selected = null;
            if (cursor is null) { _events.Clear(); _activityLoaded.Clear(); }
            if (_loadedIdentity.HasValue) StateHasChanged();
            await LoadJournalAsync();
        }
        catch (Exception) { _page = null; _events.Clear(); _activityLoaded.Clear(); if (!SelectionLocked) _selected = null; _error = "Memory could not be loaded. Try searching again."; }
        finally
        {
            _loadingItems = false;
        }
    }

    private async Task LoadGraphAsync()
    {
        try
        {
            var suffix = string.IsNullOrWhiteSpace(_search) ? string.Empty : $"?search={Uri.EscapeDataString(_search)}";
            _graph = await Http.GetFromJsonAsync<AgentMemoryGraphResponse>($"{BaseUrl}/graph{suffix}", _lifetime.Token);
        }
        catch (Exception) { _graph = null; _error = "Connections could not be loaded. Try searching again."; }

    }

    private async Task SelectItemAsync(AgentMemoryItemResponse item)
    {
        if (SelectionLocked) return;
        _review = null; _pendingReview = null; _reviewMessage = null;
        _correctionTargets = []; _selectedCorrectionTarget = null;
        _selected = item;
        try
        {
            var details = await Http.GetFromJsonAsync<AgentMemoryItemResponse>($"{BaseUrl}/items/{item.Id}", _lifetime.Token);
            if (_selected?.Id == item.Id && !SelectionLocked) _selected = details;
        }
        catch (Exception) { if (_selected?.Id == item.Id && !SelectionLocked) _selected = null; _error = "This memory is unavailable or your access changed."; }

    }

    private async Task SearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private RenderFragment SummaryCard(string label, int count, string icon) => @<MudPaper Elevation="1" Class="memory-summary-card">
            <MudIcon Icon="@icon" Color="Color.Secondary" />
            <div><MudText Typo="Typo.h5">@count</MudText><MudText Typo="Typo.caption">@label</MudText></div>
        </MudPaper>;

    private RenderFragment ItemsPanel(string view) => @<div class="memory-list" role="list">
        @foreach (var item in _page?.Items ?? [])
        {
            <button type="button" class="memory-item @(item.Id == _selected?.Id ? "selected" : null)" @onclick="@(() => SelectItemAsync(item))" disabled="@SelectionLocked">
                <span class="memory-item-heading"><strong>@item.Title</strong><small>@item.Kind</small></span>
                <span>@Truncate(item.Content, 180)</span>
                <span class="memory-item-meta">@item.Scope · @item.State · @item.OccurredAt.ToLocalTime().ToString("g")</span>
            </button>
        }
    </div>;

    private RenderFragment DetailPanel() => @<aside class="memory-detail" aria-label="Memory details">
            @if (_selected is null)
            {
                <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Large" Color="Color.Secondary" />
                <MudText Color="Color.Secondary">Select a memory to inspect its provenance.</MudText>
            }
            else
            {
                <MudText Typo="Typo.overline">@_selected.Kind</MudText>
                <MudText Typo="Typo.h6">@_selected.Title</MudText>
                <MudText Class="memory-detail-content">@_selected.Content</MudText>
                <details class="record-provenance"><summary>Source & provenance</summary><dl>
                    <dt>Scope</dt><dd>@_selected.Scope</dd>
                    <dt>Relationship</dt><dd>@(_selected.UserName ?? "Shared")</dd>
                    <dt>Source</dt><dd>@_selected.Source</dd>
                    <dt>Sensitivity</dt><dd>@_selected.Sensitivity</dd>
                    <dt>State</dt><dd>@_selected.State</dd>
                    @if (_selected.ConversationId.HasValue) { <dt>Conversation</dt><dd>@_selected.ConversationId</dd> }
                    @if (_selected.Confidence.HasValue) { <dt>Confidence</dt><dd>@_selected.Confidence.Value.ToString("P0")</dd> }
                </dl>
                @if (_selected.Metadata is not null)
                {
                    <MudText Typo="Typo.subtitle2">Provenance</MudText>
                    @foreach (var pair in _selected.Metadata)
                    {
                        <MudText Typo="Typo.caption"><strong>@pair.Key:</strong> @pair.Value</MudText>
                    }
                }
                </details>
                @if (_selected.Kind == "Episode")
                {
                    <details class="record-actions"><summary>Privacy & retention</summary>
                    <MemorySuppressionPanel OrganizationId="OrganizationId" EmployeeId="EmployeeId" EpisodeId="_selected.Id"
                        Reviewed="RecordReviewedAsync" LockedChanged="@((bool locked) => _sourceSuppressionLocked = locked)" @key="(typeof(MemorySuppressionPanel), _selected.Id)" />
                    <MemoryHoldPanel OrganizationId="OrganizationId" EmployeeId="EmployeeId" EpisodeId="_selected.Id"
                        Reviewed="RecordReviewedAsync" LockedChanged="@((bool locked) => _sourceHoldLocked = locked)" @key="(typeof(MemoryHoldPanel), _selected.Id)" />
                    <MemoryErasureImpactPanel OrganizationId="OrganizationId" EmployeeId="EmployeeId" EpisodeId="_selected.Id" LockedChanged="@((bool locked) => _erasureLocked = locked)"
                        @key="(typeof(MemoryErasureImpactPanel), OrganizationId, EmployeeId, _selected.Id)" />
                    </details><details class="record-actions"><summary>Review source evidence</summary>
                    <MemoryLegacyReviewPanel OrganizationId="OrganizationId" EmployeeId="EmployeeId" EpisodeId="_selected.Id"
                        Reviewed="RecordReviewedAsync" LockedChanged="@((bool locked) => _procedureReviewLocked = locked)" @key="_selected.Id" />
                    </details>
                }
                @if (_selected.Kind == "Core")
                {
                    <MemoryCoreReviewPanel OrganizationId="OrganizationId" EmployeeId="EmployeeId" BlockId="_selected.Id"
                        Reviewed="RecordReviewedAsync" InspectSource="InspectReviewSourceAsync"
                        LockedChanged="@((bool locked) => _procedureReviewLocked = locked)" @key="_selected.Id" />
                }
                @if (_selected.Kind == "Procedure")
                {
                    <MemoryProcedureReviewPanel OrganizationId="OrganizationId" EmployeeId="EmployeeId" ProcedureId="_selected.Id"
                        Reviewed="RecordReviewedAsync" InspectSource="InspectReviewSourceAsync"
                        LockedChanged="@((bool locked) => _procedureReviewLocked = locked)" @key="_selected.Id" />
                }
                @if (_selected.Kind == "Claim")
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2">Review this claim</MudText>
                    @if (_review is null)
                    {
                        <MudButton OnClick="LoadClaimReviewAsync" Disabled="_reviewBusy" Variant="Variant.Outlined">Check review access</MudButton>
                    }
                    else
                    {
                        <MudText>@_review.Content</MudText>
                        <MudText Typo="Typo.caption">@_review.Confirmation · @_review.Sensitivity · @_review.SourceEpisodeIds.Count source records</MudText>
                        <MudStack Row="true" Class="my-2">
                            @foreach (var source in _review.SourceEpisodeIds.Take(20).Select((id, index) => (Id: id, Number: index + 1)))
                            {
                                <MudButton OnClick="@(() => InspectReviewSourceAsync(source.Id))" Disabled="@(_reviewBusy || _pendingReview is not null)">Inspect source @source.Number</MudButton>
                            }
                        </MudStack>
                        @if (_review.SourceEpisodeIds.Count > 20)
                        {
                            <MudText Typo="Typo.caption">Showing the first 20 source links. The review checks all @_review.SourceEpisodeIds.Count sources.</MudText>
                        }
                        @if (!_review.CanConfirm)
                        {
                            <MudAlert Severity="Severity.Warning">The source evidence is unavailable or this claim is no longer current. It cannot be confirmed or corrected.</MudAlert>
                        }
                        <MudStack Row="true" Class="my-2">
                            <MudButton OnClick="@(() => SubmitClaimReviewAsync("confirm"))" Disabled="@(_reviewBusy || _pendingReview is not null || !_review.CanConfirm || _review.Confirmation == "Confirmed")" Color="Color.Primary">Confirm</MudButton>
                            <MudButton OnClick="@(() => SubmitClaimReviewAsync("reject"))" Disabled="@(_reviewBusy || _pendingReview is not null || !_review.CanReject || _review.Confirmation == "Rejected")" Color="Color.Error">Reject</MudButton>
                        </MudStack>
                        @if (_review.CanCorrect)
                        {
                            @if (_review.IsEntityValued)
                            {
                                <MudTextField T="string" Label="Find replacement entity by name" @bind-Value="_entitySearch" MaxLength="200" Disabled="@(_reviewBusy || _pendingReview is not null)" />
                                <MudButton OnClick="FindCorrectionTargetsAsync" Disabled="@(_reviewBusy || _pendingReview is not null || _entitySearch.Trim().Length < 2)">Find entities</MudButton>
                                <MudText Typo="Typo.caption">Up to 20 matching entities with current source evidence in this memory scope.</MudText>
                                @foreach (var target in _correctionTargets)
                                {
                                    <MudButton OnClick="@(() => _selectedCorrectionTarget = target)" Disabled="@(_reviewBusy || _pendingReview is not null)">@target.Name (@target.Type · @target.Sensitivity)</MudButton>
                                }
                                @if (_selectedCorrectionTarget is { } choice)
                                {
                                    <MudText>Replace the relationship target with @choice.Name.</MudText>
                                    @foreach (var source in choice.SourceEpisodeIds.Take(20).Select((id, index) => (Id: id, Number: index + 1)))
                                    {
                                        <MudButton OnClick="@(() => InspectReviewSourceAsync(source.Id))" Disabled="@(_reviewBusy || _pendingReview is not null)">Inspect replacement source @source.Number</MudButton>
                                    }
                                }
                            }
                            else
                            {
                                <MudTextField T="string" Label="Corrected value" @bind-Value="_replacementValue" MaxLength="16000" Lines="3" Disabled="@(_reviewBusy || _pendingReview is not null)" />
                            }
                            <MudButton OnClick="@(() => SubmitClaimReviewAsync("correct"))" Disabled="@(_reviewBusy || _pendingReview is not null || (_review.IsEntityValued ? _selectedCorrectionTarget is null : string.IsNullOrWhiteSpace(_replacementValue)))">Save correction</MudButton>
                        }
                        @if (_pendingReview is not null && !_reviewBusy)
                        {
                            <MudButton OnClick="@(() => SubmitClaimReviewAsync(_pendingReview.Action))">Retry the same review</MudButton>
                        }
                    }
                    @if (_reviewMessage is not null) { <MudAlert Severity="Severity.Info">@_reviewMessage</MudAlert> }
                }
                @if (_selected.RecallUses is { Count: > 0 })
                {
                    <details><summary>Recall history (@_selected.RecallUses.Count)</summary>
                    @foreach (var use in _selected.RecallUses)
                    {
                        <MudText Typo="Typo.caption">@use.UsedAt.ToLocalTime().ToString("g") in conversation @use.ConversationId</MudText>
                    }
                    </details>
                }
                <details><summary>Version history</summary>
                <MemoryHistoryPanel OrganizationId="OrganizationId" EmployeeId="EmployeeId" Kind="@_selected.Kind" RecordId="_selected.Id"
                    Disabled="@SelectionLocked" @key="(typeof(MemoryHistoryPanel), _selected.Id)" />
                </details>
            }
        </aside>;

    private RenderFragment GraphPanel()
    {
        if (_graph is null || _graph.Nodes.Count == 0)
        {
            return @<MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Entity relationships will appear after durable memory has been enriched.</MudAlert>;
        }
        var positioned = _graph.Nodes.Select((node, index) => new { node, X = 90 + index % 4 * 210, Y = 70 + index / 4 * 130 }).ToList();
        var byId = positioned.ToDictionary(x => x.node.Id);
        return @<div>
            @if (_graph.Truncated) { <MudAlert Severity="Severity.Info">Showing a limited set of connections. Narrow your search to explore more.</MudAlert> }
            <div class="memory-graph" role="group" aria-label="Agent memory entity graph">
                <svg viewBox="@($"0 0 900 {Math.Max(180, ((positioned.Count + 3) / 4) * 130)}")">
                    @foreach (var edge in _graph.Edges.Where(edge => byId.ContainsKey(edge.FromId) && byId.ContainsKey(edge.ToId)))
                    {
                        var from = byId[edge.FromId]; var to = byId[edge.ToId];
                        <line x1="@from.X" y1="@from.Y" x2="@to.X" y2="@to.Y" />
                    }
                    @foreach (var item in positioned)
                    {
                        <g transform="translate(@item.X @item.Y)">
                            <circle r="38" /><foreignObject x="-90" y="-24" width="180" height="80"><button type="button" class="graph-node" disabled="@SelectionLocked" @onclick="@(() => InspectGraphAsync(item.node.Id))">@item.node.Label<span>@item.node.Type</span></button></foreignObject>
                        </g>
                    }
                </svg>
            </div>
            <MudTable Items="@_graph.Nodes" Dense="true" Breakpoint="Breakpoint.Sm" AriaLabel="Memory entities">
                <HeaderContent><MudTh>Name</MudTh><MudTh>Type</MudTh><MudTh>Scope</MudTh></HeaderContent>
                <RowTemplate><MudTd DataLabel="Name"><MudButton OnClick="@(() => InspectGraphAsync(context.Id))" Disabled="@SelectionLocked">@context.Label</MudButton></MudTd><MudTd DataLabel="Type">@context.Type</MudTd><MudTd DataLabel="Scope">@context.Scope</MudTd></RowTemplate>
            </MudTable>
            <MudTable Items="@_graph.Edges" Dense="true" Breakpoint="Breakpoint.Sm" AriaLabel="Memory relationships">
                <HeaderContent><MudTh>From</MudTh><MudTh>Relationship</MudTh><MudTh>To</MudTh><MudTh>Confidence</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="From">@(byId.TryGetValue(context.FromId, out var from) ? from.node.Label : context.FromId.ToString())</MudTd>
                    <MudTd DataLabel="Relationship"><MudButton OnClick="@(() => InspectGraphAsync(context.Id))" Disabled="@SelectionLocked">@context.Label</MudButton></MudTd>
                    <MudTd DataLabel="To">@(byId.TryGetValue(context.ToId, out var to) ? to.node.Label : context.ToId.ToString())</MudTd>
                    <MudTd DataLabel="Confidence">@context.Confidence.ToString("P0")</MudTd>
                </RowTemplate>
            </MudTable>
        </div>;
    }

    private static string Truncate(string value, int length) => value.Length <= length ? value : value[..length] + "...";
}
