@page "/organizations/{OrganizationId:guid}/compute"
@using CSweet.Contracts.Compute
@using CSweet.UI.Components
@implements IDisposable
@inject HttpClient Http

<PageTitle>Compute - C-Sweet</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="aurora-page business-workspace compute-page">
    <div class="compute-heading">
        <div>
            <MudText Typo="Typo.overline">Business resources</MudText>
            <MudText Typo="Typo.h4">Compute</MudText>
            <MudText Color="Color.Secondary">Prepare environments. Give your agents room to build.</MudText>
        </div>

    </div>
    <div class="compute-freshness" role="status">
        @if (_dashboard is not null)
        {
            <span>Status checked @_dashboard.CheckedAt.ToLocalTime().ToString("T") · Refreshes every 10 seconds</span>
        }
    </div>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error <MudButton OnClick="LoadAsync" Disabled="_loading" Color="Color.Inherit">Try again</MudButton></MudAlert>
    }
    @if (_dashboard is null && _loading)
    {
        <MudProgressLinear Indeterminate="true" aria-label="Loading compute" />
    }
    @if (_dashboard is { } dashboard)
    {
        <div class="compute-heading compute-section-heading">
            <MudText Typo="Typo.h6">Compute types</MudText>
            <span class="compute-secondary">Set up once · Reuse across instances</span>
        </div>
        <ComputePreparation @key="OrganizationId" Setup="dashboard.Setup" CheckedAt="dashboard.CheckedAt" CanManage="dashboard.CanManageNetwork"
                            Busy="@(_repairingSetup || _loading)" OnSetup="StartSetupAsync" OnRetry="RepairSetupAsync" OnRefresh="LoadAsync" OnCreate="OpenCreateAsync" />
        @if (_showCreate && dashboard.CanManageNetwork && dashboard.Setup?.State == "Ready")
        {
            <section class="compute-create" aria-labelledby="create-instance-title">
                <div class="compute-heading"><h3 id="create-instance-title">Create Linux instance</h3><MudButton OnClick="CloseCreate" Disabled="_creating">Cancel</MudButton></div>
                <p class="compute-secondary">Choose an agent and its assigned project. Existing compute permissions and capacity limits apply.</p>
                @if (_creationOptions is null)
                {
                    @if (_creationError is null) { <MudProgressLinear Indeterminate="true" aria-label="Loading instance options" /> }
                }
                else if (_creationOptions.Options.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">No eligible agent/project assignments. Assign a compute-capable agent to an active project to create an instance.</MudAlert>
                }
                else
                {
                    <div class="compute-create-fields">
                        <MudSelect T="ComputeCreationOption" Label="Agent / project" @bind-Value="_creationOption" ToStringFunc="@(option => option is null ? string.Empty : $"{option.Agent} · {option.Project}")" Variant="Variant.Outlined" Disabled="@(_creating || _pendingCreation is not null)">
                            @foreach (var option in _creationOptions.Options)
                            {
                                <MudSelectItem T="ComputeCreationOption" Value="option">@option.Agent · @option.Project</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField T="string" Label="Instance name" @bind-Value="_instanceName" Variant="Variant.Outlined" MaxLength="64" HelperText="Lowercase letters, numbers and hyphens; start with a letter." Disabled="@(_creating || _pendingCreation is not null)" />
                        <MudSelect T="int" Label="Lifetime" @bind-Value="_instanceLifetime" Variant="Variant.Outlined" Disabled="@(_creating || _pendingCreation is not null)">
                            @if (_creationOptions.MaximumLifetimeSeconds == 0) { <MudSelectItem T="int" Value="0">Until released</MudSelectItem> }
                            <MudSelectItem T="int" Value="@DefaultLifetime">Release after @TimeSpan.FromSeconds(DefaultLifetime).TotalMinutes.ToString("0") minutes</MudSelectItem>
                        </MudSelect>
                    </div>
                    <p class="compute-secondary">2 vCPU · 2 GiB RAM · 20 GiB disk · Linux only</p>
                    <p class="compute-secondary">Network access follows the agent's reviewed permissions. Creating an instance grants no new network access.</p>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateInstanceAsync" Disabled="@(_creating || _creationOption is null || string.IsNullOrWhiteSpace(_instanceName))">@(_creating ? "Requesting instance…" : "Create instance")</MudButton>
                }
                @if (_creationError is not null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_creationError</MudAlert> }
            </section>
        }
        @if (_creationNotice is not null) { <MudAlert Severity="Severity.Success" Class="mt-4">@_creationNotice</MudAlert> }
        <MudText Typo="Typo.h6" Class="compute-instances-heading">Instances <span class="compute-count">@dashboard.Resources.Count</span></MudText>
        @if (dashboard.Resources.Count == 0)
        {
            <MudPaper Outlined="true" Elevation="0" Class="compute-empty pa-8">
                <MudIcon Icon="@Icons.Material.Outlined.Dns" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Class="mt-2">No compute instances yet</MudText>
                <MudText Class="mt-2">@(dashboard.Setup?.State == "Ready" ? "Linux is ready. Create an instance, or let an agent request one when it needs to build or test." : "Prepare Linux to make instances available. Existing requests continue automatically when compute is ready.")</MudText>
            </MudPaper>
        }
        else
        {
            <MudTable Items="dashboard.Resources" Hover="true" Elevation="0" Breakpoint="Breakpoint.Md" Class="compute-table">
                <HeaderContent>
                    <MudTh>Instance</MudTh><MudTh>Agent / project</MudTh><MudTh>State</MudTh><MudTh>Resources</MudTh><MudTh>Lease expires</MudTh><MudTh>Last change</MudTh><MudTh>Browser access</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Instance"><strong>@(context.Name ?? context.OperatingSystem)</strong><br /><span class="compute-id">@context.OperatingSystem · @context.Id.ToString("N")[..8]</span></MudTd>
                    <MudTd DataLabel="Agent / project"><strong>@context.Agent</strong><br />@context.Project</MudTd>
                    <MudTd DataLabel="State">
                        <MudChip T="string" Color="@StateColor(context.State)" Size="Size.Small">@context.State</MudChip>
                        @if (context.FailureCode is not null) { <div class="compute-failure">@context.FailureCode</div> }
                        @if (context.State is "Requested" or "Provisioning" or "Bootstrapping" && dashboard.CheckedAt - context.UpdatedAt > TimeSpan.FromMinutes(2))
                        {
                            <div class="compute-secondary">Waiting for a provider update. Last confirmed state shown.</div>
                        }
                        @if (context.DesiredState == "Destroyed" && context.State != "Destroyed") { <div>Removal requested</div> }
                        @if (context.LeaseExpiresAt <= dashboard.CheckedAt && context.State != "Destroyed") { <div>Lease expired</div> }
                    </MudTd>
                    <MudTd DataLabel="Resources">@context.CpuCount CPU · @(context.MemoryMiB / 1024d) GiB RAM<br />@(context.DiskMiB / 1024d) GiB disk</MudTd>
                    <MudTd DataLabel="Lease expires">
                        @(context.LeaseExpiresAt == DateTimeOffset.MaxValue ? "Until released" : context.LeaseExpiresAt.ToLocalTime().ToString("g"))
                        @if (dashboard.CanManageNetwork && context.State is not ("Destroyed" or "Destroying"))
                        {
                            @if (_releaseConfirm == context.Id)
                            {
                                <p>Release this instance and delete its compute files? Its saved repository remains available.</p>
                                <MudButton Color="Color.Error" Disabled="_grantBusy.HasValue" OnClick="@(() => ReleaseAsync(context))">Confirm release</MudButton>
                                <MudButton OnClick="@(() => _releaseConfirm = null)">Cancel</MudButton>
                            }
                            else
                            {
                                <MudButton Size="Size.Small" Disabled="_grantBusy.HasValue" OnClick="@(() => _releaseConfirm = context.Id)">Release instance</MudButton>
                            }
                        }
                    </MudTd>
                    <MudTd DataLabel="Last change">@context.UpdatedAt.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="Browser access">
                        <div class="compute-access" id="@($"compute-access-{context.Id:D}")">
                            @if (context.LeaseExpiresAt <= dashboard.CheckedAt || context.State is "Destroyed" or "Destroying")
                            {
                                <strong>Test link unavailable</strong>
                                <p>This instance has expired or is being removed.</p>
                            }
                            else
                            {
                                <div class="compute-access-status">
                                    <MudIcon Icon="@(context.LocalLinkAllowed ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.Lock)"
                                             Color="@(context.LocalLinkAllowed ? Color.Success : Color.Warning)" Size="Size.Small" />
                                    <strong>@(context.LocalLinkAllowed ? "Local test link allowed" : "Your permission is needed")</strong>
                                </div>
                                <p>@(context.LocalLinkAllowed ? "The agent can share a browser link once the app is ready." : "Allow the agent to share a browser link so you can test the app on this computer.")</p>
                                @if (dashboard.CanManageNetwork)
                                {
                                    <div class="compute-access-action">
                                        <MudButton Variant="@(context.LocalLinkAllowed ? Variant.Outlined : Variant.Filled)"
                                                   Color="Color.Primary" Size="Size.Small" Disabled="_grantBusy.HasValue"
                                                   StartIcon="@(context.LocalLinkAllowed ? Icons.Material.Outlined.LinkOff : Icons.Material.Outlined.Link)"
                                                   OnClick="@(() => SetLocalLinkAsync(context))">
                                            @(_grantBusy == context.Id ? "Saving…" : context.LocalLinkAllowed ? "Revoke access" : "Allow local test link")
                                        </MudButton>
                                    </div>
                                }
                                else if (!context.LocalLinkAllowed)
                                {
                                    <p>A business owner can allow access.</p>
                                }
                                <p class="compute-access-scope">This computer only · This instance only · Expires with the instance. No public or outbound internet access.</p>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @if (dashboard.HasMore) { <MudText Typo="Typo.caption">Showing the 100 most recent instances.</MudText> }
        }
    }
</MudContainer>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    private readonly CancellationTokenSource _stop = new();
    private ComputeDashboard? _dashboard;
    private Guid _loadedOrganization;
    private bool _loading;
    private string? _error;
    private Guid? _grantBusy;
    private Guid? _releaseConfirm;
    private bool _repairingSetup;
    private bool _showCreate;
    private bool _creating;
    private int _createGeneration;
    private ComputeCreationOptions? _creationOptions;
    private ComputeCreationOption? _creationOption;
    private CreateLinuxInstance? _pendingCreation;
    private Guid _creationRequestId;
    private string _instanceName = "linux-build-01";
    private int _instanceLifetime;
    private string? _creationError;
    private string? _creationNotice;
    private int DefaultLifetime => _creationOptions?.MaximumLifetimeSeconds is > 0 and var maximum ? Math.Min(3600, maximum) : 3600;
    private void CloseCreate() { _showCreate = false; _createGeneration++; }
    private async Task OpenCreateAsync()
    {
        _showCreate = true;
        _creationOptions = null;
        _creationOption = null;
        _creationError = null;
        var generation = ++_createGeneration;
        var organization = OrganizationId;
        try
        {
            var options = await Http.GetFromJsonAsync<ComputeCreationOptions>($"api/organizations/{organization}/compute/creation-options", _stop.Token);
            if (organization != OrganizationId || generation != _createGeneration) return;
            _creationOptions = options;
            _creationOption = _pendingCreation is { } pending
                ? options?.Options.FirstOrDefault(option => option.InstallationId == pending.InstallationId && option.ProjectId == pending.ProjectId)
                : options?.Options.FirstOrDefault();
            if (_pendingCreation is null)
            {
                _creationRequestId = Guid.NewGuid();
                _instanceName = $"linux-{_creationRequestId.ToString("N")[..8]}";
                _instanceLifetime = options?.MaximumLifetimeSeconds == 0 ? 0 : DefaultLifetime;
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception)
        {
            if (organization != OrganizationId || generation != _createGeneration) return;
            _creationOptions = null;
            _creationError = "Could not load instance options. Close this form and try again.";
        }
    }
    private async Task CreateInstanceAsync()
    {
        if (_creating || _creationOption is null) return;
        var organization = OrganizationId;
        var generation = _createGeneration;
        _creating = true;
        _creationError = null;
        _pendingCreation ??= new(_creationOption.InstallationId, _creationOption.ProjectId, _instanceName.Trim(), _creationRequestId, _instanceLifetime);
        try
        {
            using var response = await Http.PostAsJsonAsync($"api/organizations/{organization}/compute/instances", _pendingCreation, _stop.Token);
            if (organization != OrganizationId || generation != _createGeneration) return;
            if (!response.IsSuccessStatusCode)
            {
                if ((int)response.StatusCode < 500)
                {
                    _pendingCreation = null;
                    _creationError = response.StatusCode == System.Net.HttpStatusCode.BadRequest
                        ? "Use a name starting with a lowercase letter, containing only lowercase letters, numbers and hyphens (up to 64 characters), and an allowed lifetime."
                        : "The request could not be admitted. Check the agent's project permissions, host capacity and existing instances before retrying.";
                    return;
                }
                response.EnsureSuccessStatusCode();
            }
            _pendingCreation = null;
            _showCreate = false;
            _creationNotice = "Instance request accepted. Provisioning progress appears in Instances.";
            await LoadAsync();
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception)
        {
            if (organization == OrganizationId && generation == _createGeneration)
                _creationError = "The request outcome is not yet confirmed. Retry with the same details to recover it without creating a duplicate.";
        }
        finally { if (organization == OrganizationId && generation == _createGeneration) _creating = false; }
    }
    private async Task StartSetupAsync()
    {
        if (_repairingSetup) return;
        var organization = OrganizationId;
        _repairingSetup = true;
        try
        {
            using var response = await Http.PostAsync($"api/organizations/{organization}/compute/setup", null, _stop.Token);
            response.EnsureSuccessStatusCode();
            if (organization == OrganizationId) await LoadAsync();
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception) { if (organization == OrganizationId) _error = "Could not request Linux preparation. Refresh Compute and try again."; }
        finally { if (organization == OrganizationId) _repairingSetup = false; }
    }
    private async Task RepairSetupAsync()
    {
        if (_repairingSetup) return;
        var organization = OrganizationId;
        _repairingSetup = true;
        try
        {
            using var response = await Http.PostAsync($"api/organizations/{organization}/compute/setup/repair", null, _stop.Token);
            response.EnsureSuccessStatusCode();
            if (organization == OrganizationId) await LoadAsync();
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception) { if (organization == OrganizationId) _error = "Could not request Linux preparation repair. Refresh Compute and try again."; }
        finally { if (organization == OrganizationId) _repairingSetup = false; }
    }
    private async Task ReleaseAsync(ComputeResourceStatus resource)
    {
        if (_grantBusy.HasValue) return;
        _grantBusy = resource.Id;
        try
        {
            using var response = await Http.PostAsync($"api/organizations/{OrganizationId}/compute/{resource.Id}/release", null, _stop.Token);
            response.EnsureSuccessStatusCode();
            _releaseConfirm = null;
            await LoadAsync();
        }
        catch (Exception) { _error = "Could not release the instance. Refresh Compute and try again."; }
        finally { _grantBusy = null; }
    }
    private async Task SetLocalLinkAsync(ComputeResourceStatus resource)
    {
        if (_grantBusy.HasValue) return;
        _grantBusy = resource.Id;
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/organizations/{OrganizationId}/compute/{resource.Id}/local-link", new { enabled = !resource.LocalLinkAllowed }, _stop.Token);
            response.EnsureSuccessStatusCode();
            await LoadAsync();
        }
        catch (Exception) { _error = "Could not change the network grant. Refresh Compute and try again."; }
        finally { _grantBusy = null; }
    }
    protected override void OnInitialized() => _ = RefreshLoopAsync();
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedOrganization == OrganizationId) return;
        _loadedOrganization = OrganizationId;
        _dashboard = null;
        _error = null;
        _showCreate = false;
        _creating = false;
        _repairingSetup = false;
        _pendingCreation = null;
        _creationNotice = null;
        _creationError = null;
        _createGeneration++;
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        if (_loading || _stop.IsCancellationRequested) return;
        var organization = OrganizationId;
        _loading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<ComputeDashboard>($"api/organizations/{organization}/compute", _stop.Token);
            if (organization != OrganizationId) return;
            _dashboard = result;
            _error = null;
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception) { if (organization == OrganizationId) _error = "Could not refresh compute. Displayed information may be out of date. Please try again."; }
        finally { _loading = false; }
    }
    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
                await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }
    private static Color StateColor(string state) => state switch { "Ready" => Color.Success, "Failed" => Color.Error,
        "Running" or "Provisioning" or "Bootstrapping" or "Busy" => Color.Info, "Stopped" or "Destroyed" => Color.Default, _ => Color.Warning };
    public void Dispose() { _stop.Cancel(); _stop.Dispose(); }
}
