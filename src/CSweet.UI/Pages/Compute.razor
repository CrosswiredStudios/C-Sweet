@page "/organizations/{OrganizationId:guid}/compute"
@using CSweet.Contracts.Compute
@using CSweet.UI.Components
@implements IDisposable
@inject HttpClient Http
@inject IAppLocalizer L

<PageTitle>@L["Compute.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="aurora-page business-workspace compute-page">
    <div class="compute-heading">
        <div>
            <MudText Typo="Typo.overline">@L["Compute.BusinessResources"]</MudText>
            <MudText Typo="Typo.h4">@L["Compute.Compute"]</MudText>
            <MudText Color="Color.Secondary">@L["Compute.PrepareEnvironmentsGiveYourAgents"]</MudText>
        </div>

    </div>
    <div class="compute-freshness" role="status">
        @if (_dashboard is not null)
        {
            <span>Status checked @_dashboard.CheckedAt.ToLocalTime().ToString("T") · Refreshes every 10 seconds</span>
        }
    </div>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error <MudButton OnClick="LoadAsync" Disabled="_loading" Color="Color.Inherit">@L["Compute.TryAgain"]</MudButton></MudAlert>
    }
    @if (_actionNotice is not null)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4" role="status">@_actionNotice</MudAlert>
    }
    @if (_dashboard is null && _loading)
    {
        <MudProgressLinear Indeterminate="true" aria-label="@L["Compute.LoadingCompute"]" />
    }
    @if (_dashboard is { } dashboard)
    {
        <MudTabs @bind-ActivePanelIndex="_tab" KeepPanelsAlive="true" Elevation="0" Class="compute-tabs">
        <MudTabPanel Text="@L["Compute.ComputeTypes"]">
        @if (!dashboard.LegacyLocalSetupEnabled && dashboard.Offices.Count > 0)
        {
            <section class="compute-create" aria-label="Office workspace capacity">
                <div class="compute-heading">
                    <div>
                        <h3>Linux workspace capacity</h3>
                        <p class="compute-secondary">Standard workspace · 2 vCPU · 2 GiB RAM · 20 GiB disk</p>
                    </div>
                    <strong>@dashboard.Offices.Sum(o => o.Free?.StandardWorkspaces ?? 0) standard workspaces available</strong>
                </div>
                @foreach (var office in dashboard.Offices)
                {
                    <div class="compute-office" @key="office.Id">
                        <div class="compute-heading">
                            <strong>@office.Name</strong>
                            <MudChip T="string" Color="@(office.State == "Online" ? Color.Success : Color.Warning)" Size="Size.Small">@office.State</MudChip>
                        </div>
                        @if (office.Total is { } total)
                        {
                            <dl class="compute-metrics">
                                <div><dt>Free slots</dt><dd>@Quantity(office.Free?.Slots, total.Slots)</dd></div>
                                <div><dt>Free CPU</dt><dd>@Quantity(office.Free?.CpuCount, total.CpuCount)</dd></div>
                                <div><dt>Free memory</dt><dd>@Quantity(office.Free?.MemoryMiB / 1024d, total.MemoryMiB / 1024d) GiB</dd></div>
                                <div><dt>Free disk</dt><dd>@Quantity(office.Free?.DiskMiB / 1024d, total.DiskMiB / 1024d) GiB</dd></div>
                            </dl>
                            <p class="compute-secondary">@(office.Features.Contains("browser-testing-v1") ? "Browser testing supported" : "Browser testing unavailable")</p>
                        }
                        else
                        {
                            <p class="compute-secondary">@(office.MayReassign
                                ? "This Office’s workspace reservation belongs to a deleted business."
                                : "This Office has no usable Linux capacity offer.")</p>
                        }
                        @if (office.LastHeartbeatAt is { } lastSeen)
                        {
                            <div class="compute-secondary">Last seen @lastSeen.ToLocalTime().ToString("g")</div>
                        }
                        @if (office.MayReassign)
                        {
                            <div class="compute-office-actions">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_officeBusy != null)"
                                    OnClick="@(() => _confirmOffice = office.Id)">Reassign Office compute</MudButton>
                                @if (_confirmOffice == office.Id)
                                {
                                    <span>Assign this Office’s workspace reservation to this business?</span>
                                    <MudButton Color="Color.Primary" Disabled="@(_officeBusy != null)" OnClick="@(() => ReassignOfficeAsync(office))">Confirm reassignment</MudButton>
                                    <MudButton OnClick="@(() => _confirmOffice = null)">@L["Common.Cancel"]</MudButton>
                                }
                            </div>
                        }
                    </div>
                }
                <MudLink Href="/settings/offices">Manage Office workspace limits</MudLink>
            </section>
        }
        <ComputePreparation @key="OrganizationId" Setup="dashboard.Setup" CheckedAt="dashboard.CheckedAt" CanManage="dashboard.CanManageNetwork" LegacyLocalSetupEnabled="dashboard.LegacyLocalSetupEnabled"
                            Busy="@(_repairingSetup || _loading)" OnSetup="StartSetupAsync" OnRetry="RepairSetupAsync" OnUpdate="UpdateServiceAsync" OnRefresh="LoadAsync" OnCreate="OpenCreateAsync" />
        </MudTabPanel>
        <MudTabPanel Text="@L["Compute.Instances"]">
        @if (_showCreate && dashboard.CanManageNetwork && dashboard.Setup?.State == "Ready")
        {
            <section class="compute-create" aria-labelledby="create-instance-title">
                <div class="compute-heading"><h3 id="create-instance-title">@L["Compute.CreateLinuxInstance"]</h3><MudButton OnClick="CloseCreate" Disabled="_creating">@L["Common.Cancel"]</MudButton></div>
                <p class="compute-secondary">@L["Compute.ChooseAnAgentAndIts"]</p>
                @if (_creationOptions is null)
                {
                    @if (_creationError is null) { <MudProgressLinear Indeterminate="true" aria-label="@L["Compute.LoadingInstanceOptions"]" /> }
                }
                else if (_creationOptions.Options.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">@L["Compute.NoEligibleAgentProjectAssignments"]</MudAlert>
                }
                else
                {
                    <div class="compute-create-fields">
                        <MudSelect T="ComputeCreationOption" Label="@L["Compute.AgentProject"]" @bind-Value="_creationOption" ToStringFunc="@(option => option is null ? string.Empty : $"{option.Agent} · {option.Project}")" Variant="Variant.Outlined" Disabled="@(_creating || _pendingCreation is not null)">
                            @foreach (var option in _creationOptions.Options)
                            {
                                <MudSelectItem T="ComputeCreationOption" Value="option">@option.Agent · @option.Project</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField T="string" Label="@L["Compute.InstanceName"]" @bind-Value="_instanceName" Variant="Variant.Outlined" MaxLength="64" HelperText="Lowercase letters, numbers and hyphens; start with a letter." Disabled="@(_creating || _pendingCreation is not null)" />
                        <MudSelect T="int" Label="@L["Compute.Lifetime"]" @bind-Value="_instanceLifetime" Variant="Variant.Outlined" Disabled="@(_creating || _pendingCreation is not null)">
                            @if (_creationOptions.MaximumLifetimeSeconds == 0) { <MudSelectItem T="int" Value="0">@L["Compute.UntilReleased"]</MudSelectItem> }
                            <MudSelectItem T="int" Value="@DefaultLifetime">Release after @TimeSpan.FromSeconds(DefaultLifetime).TotalMinutes.ToString("0") minutes</MudSelectItem>
                        </MudSelect>
                    </div>
                    <p class="compute-secondary">@L["Compute.2VCPU2GiBRAM"]</p>
                    <p class="compute-secondary">@L["Compute.NetworkAccessFollowsTheAgent"]</p>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateInstanceAsync" Disabled="@(_creating || _creationOption is null || string.IsNullOrWhiteSpace(_instanceName))">@(_creating ? "Requesting instance…" : "Create instance")</MudButton>
                }
                @if (_creationError is not null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_creationError</MudAlert> }
            </section>
        }
        @if (_creationNotice is not null) { <MudAlert Severity="Severity.Success" Class="mt-4">@_creationNotice</MudAlert> }
        <div class="compute-heading compute-instances-heading">
            <span class="compute-secondary">@dashboard.Resources.Count instance@(dashboard.Resources.Count == 1 ? "" : "s")</span>
            @if (!_showCreate && dashboard.CanManageNetwork && dashboard.Setup?.State == "Ready")
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenCreateAsync">@L["Compute.CreateLinuxInstance"]</MudButton>
            }
        </div>
        @if (dashboard.Resources.Count == 0)
        {
            <MudPaper Outlined="true" Elevation="0" Class="compute-empty pa-8">
                <MudIcon Icon="@Icons.Material.Outlined.Dns" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Class="mt-2">@L["Compute.NoComputeInstancesYet"]</MudText>
                <MudText Class="mt-2">@(dashboard.Setup?.State == "Ready" ? "Linux is ready. Create an instance, or let an agent request one when it needs to build or test." :
                    dashboard.LegacyLocalSetupEnabled ? "Prepare Linux to make instances available. Existing requests continue automatically when compute is ready." :
                    "A workspace appears here once Headquarters places the request with an Office.")</MudText>
                @if (dashboard.Requests.Count > 0)
                {
                    <MudButton OnClick="@(() => _tab = 2)" Color="Color.Primary" Class="mt-2">View requests</MudButton>
                }
            </MudPaper>
        }
        else
        {
            <MudTable Items="dashboard.Resources" Hover="true" Elevation="0" Breakpoint="Breakpoint.Md" Class="compute-table">
                <HeaderContent>
                    <MudTh>@L["Compute.Instance"]</MudTh><MudTh>@L["Compute.AgentProject"]</MudTh><MudTh>@L["Compute.State"]</MudTh><MudTh>@L["Compute.Resources"]</MudTh><MudTh>@L["Compute.LeaseExpires"]</MudTh><MudTh>@L["Compute.LastChange"]</MudTh><MudTh>@L["Compute.BrowserAccess"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Instance"><strong>@(context.Name ?? context.OperatingSystem)</strong><br /><span class="compute-id">@context.OperatingSystem · @context.Id.ToString("N")[..8]</span></MudTd>
                    <MudTd DataLabel="Agent / project"><strong>@context.Agent</strong><br />@context.Project</MudTd>
                    <MudTd DataLabel="State">
                        <MudChip T="string" Color="@StateColor(context.State)" Size="Size.Small">@context.State</MudChip>
                        @if (context.FailureCode is not null) { <div class="compute-failure">@context.FailureCode</div> }
                        @if (context.LatestOperation is { } operation)
                        {
                            <details class="compute-operation">
                                <summary>Operation details</summary>
                                <div>@OperationName(operation.Action) · @operation.State</div>
                                <div>@operation.Attempts dispatch attempt@(operation.Attempts == 1 ? "" : "s")</div>
                                <div>@operation.UpdatedAt.ToLocalTime().ToString("g")</div>
                                @if (operation.FailureCode is { } code && code != context.FailureCode)
                                {
                                    <code class="compute-failure">@(code)</code>
                                }
                                @if (operation.CanRecheck)
                                {
                                    <MudButton Size="Size.Small" Color="Color.Primary" Disabled="@(_grantBusy.HasValue)"
                                        OnClick="@(() => RecheckProvisioningAsync(context, operation))">Recheck provisioning</MudButton>
                                }
                            </details>
                        }
                        @if (context.State is "Requested" or "Provisioning" or "Bootstrapping" && dashboard.CheckedAt - context.UpdatedAt > TimeSpan.FromMinutes(2))
                        {
                            <div class="compute-secondary">@L["Compute.WaitingForAProviderUpdate"]</div>
                        }
                        @if (context.DesiredState == "Destroyed" && context.State != "Destroyed") { <div>@L["Compute.RemovalRequested"]</div> }
                        @if (context.LeaseExpiresAt <= dashboard.CheckedAt && context.State != "Destroyed") { <div>@L["Compute.LeaseExpired"]</div> }
                    </MudTd>
                    <MudTd DataLabel="Resources">@context.CpuCount CPU · @(context.MemoryMiB / 1024d) GiB RAM<br />@(context.DiskMiB / 1024d) GiB disk</MudTd>
                    <MudTd DataLabel="Lease expires">
                        @(context.LeaseExpiresAt == DateTimeOffset.MaxValue ? "Until released" : context.LeaseExpiresAt.ToLocalTime().ToString("g"))
                        @if (dashboard.CanManageNetwork && context.State is not ("Destroyed" or "Destroying"))
                        {
                            @if (_releaseConfirm == context.Id)
                            {
                                <p>@L["Compute.ReleaseThisInstanceAndDelete"]</p>
                                <MudButton Color="Color.Error" Disabled="_grantBusy.HasValue" OnClick="@(() => ReleaseAsync(context))">@L["Compute.ConfirmRelease"]</MudButton>
                                <MudButton OnClick="@(() => _releaseConfirm = null)">@L["Common.Cancel"]</MudButton>
                            }
                            else
                            {
                                @if (context.CanPowerOff || context.CanPowerOn)
                                {
                                    <MudButton Size="Size.Small" Disabled="_grantBusy.HasValue" OnClick="@(() => ChangePowerAsync(context))">@(context.CanPowerOn ? "Start VM" : "Stop VM")</MudButton>
                                }
                                @if (context.State == "Stopped") { <span>Disk retained</span> }
                                <MudButton Size="Size.Small" Disabled="_grantBusy.HasValue" OnClick="@(() => _releaseConfirm = context.Id)">@L["Compute.ReleaseInstance"]</MudButton>
                            }
                        }
                    </MudTd>
                    <MudTd DataLabel="Last change">@context.UpdatedAt.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="Browser access">
                        <div class="compute-access" id="@($"compute-access-{context.Id:D}")">
                            @if (context.LeaseExpiresAt <= dashboard.CheckedAt || context.State is "Destroyed" or "Destroying")
                            {
                                <strong>@L["Compute.TestLinkUnavailable"]</strong>
                                <p>@L["Compute.ThisInstanceHasExpiredOr"]</p>
                            }
                            else
                            {
                                <div class="compute-access-status">
                                    <MudIcon Icon="@(context.LocalLinkAllowed ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.Lock)"
                                             Color="@(context.LocalLinkAllowed ? Color.Success : Color.Warning)" Size="Size.Small" />
                                    <strong>@(context.LocalLinkAllowed ? "Local test link allowed" : "Your permission is needed")</strong>
                                </div>
                                <p>@(context.LocalLinkAllowed ? "The agent can share a browser link once the app is ready." : "Allow the agent to share a browser link so you can test the app on this computer.")</p>
                                @if (dashboard.CanManageNetwork)
                                {
                                    <div class="compute-access-action">
                                        <MudButton Variant="@(context.LocalLinkAllowed ? Variant.Outlined : Variant.Filled)"
                                                   Color="Color.Primary" Size="Size.Small" Disabled="_grantBusy.HasValue"
                                                   StartIcon="@(context.LocalLinkAllowed ? Icons.Material.Outlined.LinkOff : Icons.Material.Outlined.Link)"
                                                   OnClick="@(() => SetLocalLinkAsync(context))">
                                            @(_grantBusy == context.Id ? "Saving…" : context.LocalLinkAllowed ? "Revoke access" : "Allow local test link")
                                        </MudButton>
                                    </div>
                                }
                                else if (!context.LocalLinkAllowed)
                                {
                                    <p>@L["Compute.ABusinessOwnerCanAllow"]</p>
                                }
                                <p class="compute-access-scope">@L["Compute.ThisComputerOnlyThisInstance"]</p>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @if (dashboard.HasMore) { <MudText Typo="Typo.caption">@L["Compute.ShowingThe100MostRecent"]</MudText> }
        }
        </MudTabPanel>
        <MudTabPanel Text="Requests and Info">
            @if (!dashboard.CanManageNetwork)
            {
                <MudPaper Outlined="true" Elevation="0" Class="pa-5">A business owner can review compute requests and retry eligible work.</MudPaper>
            }
            else if (dashboard.Requests.Count == 0)
            {
                <MudPaper Outlined="true" Elevation="0" Class="pa-5">No pending compute requests.</MudPaper>
            }
            @foreach (var request in dashboard.Requests)
            {
                <article class="compute-create compute-request" @key="request.Id">
                    <div class="compute-heading">
                        <div>
                            <h3>@request.Employee</h3>
                            <span class="compute-secondary">@request.Project</span>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="@(request.DiagnosticCode == null ? Color.Success : Color.Warning)">
                            @(request.DiagnosticCode == null ? "Compute ready" : "Waiting for compute")
                        </MudChip>
                    </div>
                    <p>@(request.RequiresBrowser ? "Linux x64 · Browser testing · 2 vCPU · 2 GiB RAM · 20 GiB disk" : "Office workspace · Resources are set by the requesting agent")</p>
                    @foreach (var work in request.Work)
                    {
                        <MudLink Href="@work.Uri">@(work.Identifier is { } id ? $"{id} · {work.Title}" : work.Title)</MudLink>
                    }
                    <p>@request.Reason</p>
                    <details class="compute-operation">
                        <summary>View diagnostics</summary>
                        <div>Last check @request.LastCheckedAt.ToLocalTime().ToString("g")</div>
                        @if (request.RetryAt is { } next) { <div>Next automatic check @next.ToLocalTime().ToString("g")</div> }
                        @if (request.DiagnosticCode is { } diagnostic) { <code>@diagnostic</code> }
                    </details>
                    @if (request.CanRecheck)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" Disabled="@(_requestBusy != null)"
                            OnClick="@(() => RecheckRequestAsync(request))">Recheck now</MudButton>
                    }
                    else if (request.DiagnosticCode is not null)
                    {
                        <MudButton OnClick="@(() => _tab = 0)" Color="Color.Primary" Class="mt-2">Review Compute Types</MudButton>
                    }
                </article>
            }
        </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    private int _tab;
    private string? _openedTab;
    private Guid? _requestBusy, _officeBusy, _confirmOffice;
    private readonly CancellationTokenSource _stop = new();
    private ComputeDashboard? _dashboard;
    private Guid _loadedOrganization;
    private bool _loading;
    private string? _error;
    private Guid? _grantBusy;
    private Guid? _releaseConfirm;
    private bool _repairingSetup;
    private bool _showCreate;
    private bool _creating;
    private int _createGeneration;
    private ComputeCreationOptions? _creationOptions;
    private ComputeCreationOption? _creationOption;
    private CreateLinuxInstance? _pendingCreation;
    private Guid _creationRequestId;
    private string _instanceName = "linux-build-01";
    private int _instanceLifetime;
    private string? _creationError;
    private string? _creationNotice;
    private int DefaultLifetime => _creationOptions?.MaximumLifetimeSeconds is > 0 and var maximum ? Math.Min(3600, maximum) : 3600;
    private void CloseCreate() { _showCreate = false; _createGeneration++; }
    private async Task OpenCreateAsync()
    {
        _tab = 1;
        _showCreate = true;
        _creationOptions = null;
        _creationOption = null;
        _creationError = null;
        var generation = ++_createGeneration;
        var organization = OrganizationId;
        try
        {
            var options = await Http.GetFromJsonAsync<ComputeCreationOptions>($"api/organizations/{organization}/compute/creation-options", _stop.Token);
            if (organization != OrganizationId || generation != _createGeneration) return;
            _creationOptions = options;
            _creationOption = _pendingCreation is { } pending
                ? options?.Options.FirstOrDefault(option => option.InstallationId == pending.InstallationId && option.ProjectId == pending.ProjectId)
                : options?.Options.FirstOrDefault();
            if (_pendingCreation is null)
            {
                _creationRequestId = Guid.NewGuid();
                _instanceName = $"linux-{_creationRequestId.ToString("N")[..8]}";
                _instanceLifetime = options?.MaximumLifetimeSeconds == 0 ? 0 : DefaultLifetime;
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception)
        {
            if (organization != OrganizationId || generation != _createGeneration) return;
            _creationOptions = null;
            _creationError = L["Compute.CouldNotLoadInstanceOptions"];
        }
    }
    private async Task CreateInstanceAsync()
    {
        if (_creating || _creationOption is null) return;
        var organization = OrganizationId;
        var generation = _createGeneration;
        _creating = true;
        _creationError = null;
        _pendingCreation ??= new(_creationOption.InstallationId, _creationOption.ProjectId, _instanceName.Trim(), _creationRequestId, _instanceLifetime);
        try
        {
            using var response = await Http.PostAsJsonAsync($"api/organizations/{organization}/compute/instances", _pendingCreation, _stop.Token);
            if (organization != OrganizationId || generation != _createGeneration) return;
            if (!response.IsSuccessStatusCode)
            {
                if ((int)response.StatusCode < 500)
                {
                    _pendingCreation = null;
                    _creationError = response.StatusCode == System.Net.HttpStatusCode.BadRequest
                        ? "Use a name starting with a lowercase letter, containing only lowercase letters, numbers and hyphens (up to 64 characters), and an allowed lifetime."
                        : "The request could not be admitted. Check the agent's project permissions, host capacity and existing instances before retrying.";
                    return;
                }
                response.EnsureSuccessStatusCode();
            }
            _pendingCreation = null;
            _showCreate = false;
            _creationNotice = L["Compute.InstanceRequestAcceptedProvisioningProgr"];
            await LoadAsync();
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception)
        {
            if (organization == OrganizationId && generation == _createGeneration)
                _creationError = L["Compute.TheRequestOutcomeIsNot"];
        }
        finally { if (organization == OrganizationId && generation == _createGeneration) _creating = false; }
    }
    private async Task StartSetupAsync()
    {
        if (_repairingSetup) return;
        var organization = OrganizationId;
        _repairingSetup = true;
        try
        {
            using var response = await Http.PostAsync($"api/organizations/{organization}/compute/setup", null, _stop.Token);
            response.EnsureSuccessStatusCode();
            if (organization == OrganizationId) await LoadAsync();
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception) { if (organization == OrganizationId) _error = L["Compute.CouldNotRequestLinuxPreparation"]; }
        finally { if (organization == OrganizationId) _repairingSetup = false; }
    }
    private async Task UpdateServiceAsync()
    {
        if (_repairingSetup) return;
        var organization = OrganizationId; _repairingSetup = true;
        try
        {
            using var response = await Http.PostAsync($"api/organizations/{organization}/compute/setup/update", null, _stop.Token);
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            { _error = "Compute is busy. Try the service update after the current operation finishes."; return; }
            response.EnsureSuccessStatusCode();
            if (organization == OrganizationId) await LoadAsync();
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception) { if (organization == OrganizationId) _error = "The compute service update could not be requested."; }
        finally { if (organization == OrganizationId) _repairingSetup = false; }
    }
    private async Task RepairSetupAsync()
    {
        if (_repairingSetup) return;
        var organization = OrganizationId;
        _repairingSetup = true;
        try
        {
            using var response = await Http.PostAsync($"api/organizations/{organization}/compute/setup/repair", null, _stop.Token);
            response.EnsureSuccessStatusCode();
            if (organization == OrganizationId) await LoadAsync();
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception) { if (organization == OrganizationId) _error = L["Compute.CouldNotRequestLinuxPreparation2"]; }
        finally { if (organization == OrganizationId) _repairingSetup = false; }
    }
    private async Task ReleaseAsync(ComputeResourceStatus resource)
    {
        if (_grantBusy.HasValue) return;
        _grantBusy = resource.Id;
        try
        {
            using var response = await Http.PostAsync($"api/organizations/{OrganizationId}/compute/{resource.Id}/release", null, _stop.Token);
            response.EnsureSuccessStatusCode();
            _releaseConfirm = null;
            await LoadAsync();
        }
        catch (Exception) { _error = L["Compute.CouldNotReleaseTheInstance"]; }
        finally { _grantBusy = null; }
    }
    private async Task ChangePowerAsync(ComputeResourceStatus resource)
    {
        if (_grantBusy.HasValue) return;
        _grantBusy = resource.Id;
        try
        {
            var action = resource.CanPowerOn ? "start" : "stop";
            using var response = await Http.PostAsync($"api/organizations/{OrganizationId}/compute/{resource.Id}/power/{action}?generation={resource.Generation}", null, _stop.Token);
            await LoadAsync();
            if (!response.IsSuccessStatusCode) _error = "The power request could not be accepted. Check Office capacity and current instance state.";
        }
        catch (HttpRequestException) { _error = "The Office power request could not be delivered."; }
        finally { _grantBusy = null; }
    }

    private async Task SetLocalLinkAsync(ComputeResourceStatus resource)
    {
        if (_grantBusy.HasValue) return;
        _grantBusy = resource.Id;
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/organizations/{OrganizationId}/compute/{resource.Id}/local-link", new { enabled = !resource.LocalLinkAllowed }, _stop.Token);
            response.EnsureSuccessStatusCode();
            await LoadAsync();
        }
        catch (Exception) { _error = L["Compute.CouldNotChangeTheNetwork"]; }
        finally { _grantBusy = null; }
    }
    protected override void OnInitialized() => _ = RefreshLoopAsync();
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedOrganization != OrganizationId || _openedTab != Tab)
        {
            _tab = Tab switch { "instances" => 1, "requests" => 2, _ => 0 };
            _openedTab = Tab;
        }
        if (_loadedOrganization == OrganizationId) return;
        _loadedOrganization = OrganizationId;
        _dashboard = null;
        _error = null;
        _showCreate = false;
        _creating = false;
        _repairingSetup = false;
        _pendingCreation = null;
        _creationNotice = null;
        _creationError = null;
        _requestBusy = _officeBusy = _confirmOffice = null;
        _actionNotice = null;
        _createGeneration++;
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        if (_loading || _stop.IsCancellationRequested) return;
        var organization = OrganizationId;
        _loading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<ComputeDashboard>($"api/organizations/{organization}/compute?details=true", _stop.Token);
            if (organization != OrganizationId) return;
            _dashboard = result;
            _error = null;
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception) { if (organization == OrganizationId) _error = L["Compute.CouldNotRefreshComputeDisplayed"]; }
        finally { _loading = false; }
    }
    private async Task RecheckRequestAsync(ComputeRequestStatus request)
    {
        _requestBusy = request.Id;
        try { await SendComputeActionAsync($"requests/{request.Id:D}/recheck"); }
        finally { _requestBusy = null; }
    }
    private async Task RecheckProvisioningAsync(ComputeResourceStatus resource, ComputeOperationStatus operation)
    {
        _grantBusy = resource.Id;
        try { await SendComputeActionAsync($"instances/{resource.Id:D}/provisioning/{operation.Id:D}/recheck"); }
        finally { _grantBusy = null; }
    }
    private async Task ReassignOfficeAsync(ComputeOfficeStatus office)
    {
        _officeBusy = office.Id;
        _confirmOffice = null;
        try { await SendComputeActionAsync($"offices/{office.Id:D}/reassign"); }
        finally { _officeBusy = null; }
    }
    private string? _actionNotice;
    private async Task SendComputeActionAsync(string action)
    {
        var organization = OrganizationId;
        _actionNotice = null;
        try
        {
            using var response = await Http.PostAsync($"api/organizations/{organization:D}/compute/{action}", null, _stop.Token);
            if (organization != OrganizationId) return;
            if (response.IsSuccessStatusCode || response.StatusCode == System.Net.HttpStatusCode.Conflict)
                _actionNotice = (await response.Content.ReadFromJsonAsync<ComputeActionResult>(_stop.Token))?.Message;
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                _actionNotice = "You do not have permission to perform this compute action.";
            else
                _actionNotice = "The compute action could not be accepted.";
            await LoadAsync();
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (HttpRequestException) { if (OrganizationId == organization) _actionNotice = "The compute action could not be delivered."; }
    }
    private static string Quantity(double? free, double total) => free is double n ? $"{n:0.#} / {total:0.#}" : $"— / {total:0.#}";
    private static string OperationName(string action) => action.Replace("infrastructure.", "").Replace(".v1", "");
    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
                await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }
    private static Color StateColor(string state) => state switch { "Ready" => Color.Success, "Failed" => Color.Error,
        "Running" or "Provisioning" or "Bootstrapping" or "Busy" => Color.Info, "Stopped" or "Destroyed" => Color.Default, _ => Color.Warning };
    public void Dispose() { _stop.Cancel(); _stop.Dispose(); }
}
