@page "/"
@inject HttpClient Http

<PageTitle>Enterprise - C-Sweet</PageTitle>

<div class="aurora-page business-workspace enterprise-workspace">
    <Organizations CreateRequested="@CreateRequested" DraftId="DraftId" />
    <section class="enterprise-tools" aria-label="Enterprise tools">
        <div>
            <h2><MudIcon Icon="@Icons.Material.Outlined.Science" Size="Size.Small" />Business benchmarks</h2>
            <p>Compare models and agents against the same goal.</p>
        </div>
        <MudButton Href="benchmarks" Color="Color.Primary" EndIcon="@Icons.Material.Outlined.NorthEast">Explore benchmarks</MudButton>
    </section>
    <footer class="enterprise-footer">
        <div class="enterprise-connectivity" role="status">
            <MudIcon Icon="@ApiStatusIcon" Color="@ApiStatusColor" Size="Size.Small" />
            <span>@ApiStatusLabel</span>
        </div>
        <MudButton Href="settings" EndIcon="@Icons.Material.Outlined.ArrowForward">Workspace settings</MudButton>
        @if (_apiStatus == false)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="enterprise-connectivity-error">
                The API service cannot be reached. Check that the backend is running.
            </MudAlert>
        }
    </footer>
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "create")]
    public bool CreateRequested { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "draft")] public Guid? DraftId { get; set; }

    private bool? _apiStatus;
    private string ApiStatusLabel => _apiStatus switch { true => "API connected", false => "API disconnected", _ => "Checking connection…" };
    private Color ApiStatusColor => _apiStatus switch { true => Color.Success, false => Color.Error, _ => Color.Default };
    private string ApiStatusIcon => _apiStatus switch { true => Icons.Material.Outlined.CheckCircle, false => Icons.Material.Outlined.CloudOff, _ => Icons.Material.Outlined.Sync };

    protected override async Task OnInitializedAsync()
    {
        try { _apiStatus = (await Http.GetAsync("api/health")).IsSuccessStatusCode; }
        catch { _apiStatus = false; }
    }
}
