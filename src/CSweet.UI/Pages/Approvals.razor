@page "/organizations/{OrganizationId:guid}/approvals"
@using CSweet.Contracts.Core
@using CSweet.Contracts.SourceControl
@inject HttpClient Http
@inject ApprovalState ApprovalNotifications
@implements IDisposable

<PageTitle>Approvals - C-Sweet</PageTitle>

<EmployeePortraitScope OrganizationId="OrganizationId">
<div class="approvals-page">
    <MudPaper Elevation="0" Class="page-header approvals-header">
        <div>
            <MudText Typo="Typo.h3">Approvals</MudText>
            <MudText Color="Color.Secondary">
                One inbox for approvals, agent questions, and requests for your direction.
            </MudText>
        </div>
        <MudChip T="string" Color="@(_dashboard?.PendingCount > 0 ? Color.Warning : Color.Success)"
                 Variant="Variant.Filled">
            @(_dashboard?.PendingCount ?? 0) pending approvals
        </MudChip>
    </MudPaper>

    <MudTabs ActivePanelIndex="@_activeTab" ActivePanelIndexChanged="SelectTab" Class="mb-4" KeepPanelsAlive="true">
        <MudTabPanel Text="Approvals" />
        <MudTabPanel Text="Decisions" />
    </MudTabs>

    <div hidden="@(_activeTab != 1)">
        <PendingAgentQuestions OrganizationId="OrganizationId" />
    </div>
    <div hidden="@(_activeTab != 0)">

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_dashboard is not null)
    {
        <MudStack Row="true" Spacing="1" Class="approval-filters">
            <MudButton Variant="@(!_showHistory ? Variant.Filled : Variant.Text)"
                       Color="Color.Primary" OnClick="@(() => _showHistory = false)">
                Pending (@_dashboard.PendingCount)
            </MudButton>
            <MudButton Variant="@(_showHistory ? Variant.Filled : Variant.Text)"
                       Color="Color.Primary" OnClick="@(() => _showHistory = true)">
                All activity
            </MudButton>
        </MudStack>

        @if (VisibleItems.Count == 0)
        {
            <MudPaper Elevation="0" Outlined="true" Class="approval-empty">
                <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.h5">@(_showHistory ? "No approval activity yet" : "No pending approvals")</MudText>
                <MudText Color="Color.Secondary">
                    @(_showHistory
                        ? "Durable approval requests will appear here when an agent or workflow creates them."
                        : "There are no pending approvals in this company.")
                </MudText>
            </MudPaper>
        }
        else
        {
            <MudStack Spacing="3">
                @foreach (var item in VisibleItems)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="approval-card">
                        <div class="approval-card-heading">
                            <div>
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@KindLabel(item.Kind)</MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(item.Status)">@item.Status</MudChip>
                                </MudStack>
                                <MudText Typo="Typo.h5" Class="mt-2">@item.Title</MudText>
                                <MudText Color="Color.Secondary">@item.Summary</MudText>
                            </div>
                            <MudButton Href="@item.ActionUri" Variant="Variant.Text"
                                       EndIcon="@Icons.Material.Outlined.OpenInNew">
                                Open source
                            </MudButton>
                        </div>

                        <div class="approval-meta">
                            <span><strong>Requested by</strong>@item.RequestedBy</span>
                            <span><strong>Assigned to</strong>@item.AssignedTo</span>
                            @if (!string.IsNullOrWhiteSpace(item.RequestingTeam))
                            {
                                <span><strong>Requesting team</strong>@item.RequestingTeam</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.ActualDecisionMaker))
                            {
                                <span><strong>Decided by</strong>@item.ActualDecisionMaker</span>
                            }
                            <span><strong>Created</strong>@item.CreatedAt.ToLocalTime().ToString("g")</span>
                        </div>

                        @if (item.ResourceChange is { } request)
                        {
                            <SuggestedTeamStructureGraph Request="request"
                                                         ProductManagerDisplayName="@item.RequestedBy"
                                                         ManagerDisplayName="@item.AssignedTo" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Source request @request.Id · workstream @(request.WorkstreamId?.ToString("D") ?? "not scoped")
                            </MudText>
                            <div class="approval-role-list">
                                @foreach (var delta in request.Deltas)
                                {
                                    <div>
                                        <strong>@delta.ChangeKind · <ResourceRoleTitle Role="delta.Role" /></strong>
                                        <span>@delta.Role.Team · @delta.Role.Headcount headcount · priority @delta.Role.Priority</span>
                                        <small>@delta.Role.Purpose</small>
                                    </div>
                                }
                            </div>

                            @if (item.CanDecide && item.Status == "Pending")
                            {
                                <MudTextField Value="@Feedback(item.Id)"
                                              ValueChanged="@((string value) => SetFeedback(item.Id, value))"
                                              Label="Decision feedback" Lines="2" Variant="Variant.Outlined" />
                                @if (_decisionErrors.TryGetValue(item.Id, out var decisionError))
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true">@decisionError</MudAlert>
                                }
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Color="Color.Success" Variant="Variant.Filled"
                                               Disabled="@(_decidingId.HasValue)"
                                               OnClick="@(() => DecideAsync(item, ResourceChangeDecisionKinds.Approve))">
                                        Approve
                                    </MudButton>
                                    <MudButton Color="Color.Warning" Variant="Variant.Outlined"
                                               Disabled="@(_decidingId.HasValue)"
                                               OnClick="@(() => DecideAsync(item, ResourceChangeDecisionKinds.RequestRevision))">
                                        Request revision
                                    </MudButton>
                                    <MudButton Color="Color.Error" Variant="Variant.Text"
                                               Disabled="@(_decidingId.HasValue)"
                                               OnClick="@(() => DecideAsync(item, ResourceChangeDecisionKinds.Reject))">
                                        Reject
                                    </MudButton>
                                </MudStack>
                            }
                            else if (!string.IsNullOrWhiteSpace(request.DecisionComment))
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    Decision feedback: @request.DecisionComment
                                </MudAlert>
                            }
                        }
                        else if (item.AgentAction is { } agentAction)
                        {
                            @if (item.CanManageStandingPolicy && agentAction.ActionType != "web-preview.grant")
                            {
                                <MudButton Variant="Variant.Outlined" Class="my-3"
                                    Href="@($"/organizations/{OrganizationId:D}/connector-actions/{item.Id:D}/standing-policy")">Manage automatic approval rules</MudButton>
                                <MudText Typo="Typo.caption">Owner-only rules for future requests, separate from this action's decision.</MudText>
                            }
                            @if (agentAction.ActionType == "web-preview.grant")
                            {
                                <WebPreviewGrantReview ReviewPayloadJson="@agentAction.ReviewPayloadJson" />
                                @if (item.CanManageStandingPolicy && item.Status == "Active")
                                {
                                    <MudButton Class="mt-3" Color="Color.Error" Variant="Variant.Outlined" Disabled="@(_decidingId.HasValue)"
                                        OnClick="@(() => RevokeWebPreviewGrantAsync(item))">Revoke preview access</MudButton>
                                }
                            }
                            else
                            {
                            <MudGrid Class="mt-3">
                                <MudItem xs="12" md="6"><strong>Account</strong><br />@(agentAction.AccountName ?? agentAction.ChannelId)</MudItem>
                                <MudItem xs="12" md="6"><strong>Action</strong><br />@agentAction.ActionType</MudItem>
                                @if (!string.IsNullOrWhiteSpace(agentAction.ResourceId))
                                {
                                    <MudItem xs="12"><strong>Resource</strong><br />@agentAction.ResourceId</MudItem>
                                }
                                <MudItem xs="12"><strong>Payload binding</strong><br /><code>@agentAction.PayloadHash</code></MudItem>
                                @if (!string.IsNullOrWhiteSpace(agentAction.ReviewPayloadJson))
                                {
                                    <MudItem xs="12"><strong>Exact proposed changes</strong><pre style="white-space: pre-wrap; overflow-wrap: anywhere">@agentAction.ReviewPayloadJson</pre></MudItem>
                                }
                                @if (!string.IsNullOrWhiteSpace(agentAction.FiscalSummary))
                                {
                                    <MudItem xs="12"><strong>Fiscal commitment</strong><br />@agentAction.FiscalSummary</MudItem>
                                }
                                @if (!string.IsNullOrWhiteSpace(agentAction.ApprovalRoute))
                                {
                                    <MudItem xs="12"><strong>Approval route</strong><br />@agentAction.ApprovalRoute</MudItem>
                                }
                                @if (agentAction.ExpiresAt.HasValue)
                                {
                                    <MudItem xs="12" md="6"><strong>Approval expires</strong><br />@agentAction.ExpiresAt.Value.ToLocalTime().ToString("g")</MudItem>
                                }
                            </MudGrid>
                            }
                            @if (item.CanDecide && item.Status == "Pending" &&
                                (agentAction.ActionType != "web-preview.grant" || WebPreviewGrantReview.IsValid(agentAction.ReviewPayloadJson)))
                            {
                                <MudTextField Value="@Feedback(item.Id)" ValueChanged="@((string value) => SetFeedback(item.Id, value))"
                                              Label="Decision feedback" Lines="2" Variant="Variant.Outlined" Class="mt-3" />
                                @if (_decisionErrors.TryGetValue(item.Id, out var actionError))
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true">@actionError</MudAlert>
                                }
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="@(_decidingId.HasValue)"
                                               OnClick="@(() => DecideAgentActionAsync(item, ResourceChangeDecisionKinds.Approve))">Approve</MudButton>
                                    <MudButton Color="Color.Warning" Variant="Variant.Outlined" Disabled="@(_decidingId.HasValue)"
                                               OnClick="@(() => DecideAgentActionAsync(item, ResourceChangeDecisionKinds.RequestRevision))">Request revision</MudButton>
                                    <MudButton Color="Color.Error" Variant="Variant.Text" Disabled="@(_decidingId.HasValue)"
                                               OnClick="@(() => DecideAgentActionAsync(item, ResourceChangeDecisionKinds.Reject))">Reject</MudButton>
                                </MudStack>
                            }
                        }
                        else if (item.HiringWorkflow is { } hiringWorkflow)
                        {
                            <HiringWorkflowApprovalCard OrganizationId="OrganizationId"
                                                        Workflow="hiringWorkflow"
                                                        CanDecide="item.CanDecide"
                                                        DecisionCompleted="LoadAsync" />
                        }
                        else if (item.SourceControl is { } sourceControl)
                        {
                            <MudGrid Class="mt-3">
                                <MudItem xs="12" md="6"><strong>Code project</strong><br />@sourceControl.CodeProjectName</MudItem>
                                <MudItem xs="12" md="6"><strong>GitHub organization</strong><br />@sourceControl.AccountLogin</MudItem>
                                @if (!string.IsNullOrWhiteSpace(sourceControl.TemplateName))
                                {
                                    <MudItem xs="12" md="6"><strong>Starter project</strong><br />@sourceControl.TemplateName</MudItem>
                                }
                                @if (!string.IsNullOrWhiteSpace(sourceControl.DefaultTeamName))
                                {
                                    <MudItem xs="12" md="6"><strong>Default team</strong><br />@sourceControl.DefaultTeamName</MudItem>
                                }
                                <MudItem xs="12" md="6"><strong>Visibility</strong><br />@(sourceControl.PrivateOnly ? "Private only" : "Provider policy")</MudItem>
                                @if (sourceControl.MaximumProjects.HasValue)
                                {
                                    <MudItem xs="12" md="6"><strong>Policy quota</strong><br />@sourceControl.MaximumProjects projects</MudItem>
                                }
                            </MudGrid>
                            @if (item.CanDecide && item.Status == "Pending")
                            {
                                <MudTextField Value="@Feedback(item.Id)"
                                              ValueChanged="@((string value) => SetFeedback(item.Id, value))"
                                              Label="Decision feedback" Lines="2" Variant="Variant.Outlined" Class="mt-3"
                                              HelperText="Feedback is required when rejecting a request." />
                                @if (_decisionErrors.TryGetValue(item.Id, out var sourceDecisionError))
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true">@sourceDecisionError</MudAlert>
                                }
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Color="Color.Success" Variant="Variant.Filled"
                                               Disabled="@(_decidingId.HasValue)"
                                               OnClick="@(() => DecideSourceControlAsync(item, true))">
                                        Approve
                                    </MudButton>
                                    <MudButton Color="Color.Error" Variant="Variant.Text"
                                               Disabled="@(_decidingId.HasValue)"
                                               OnClick="@(() => DecideSourceControlAsync(item, false))">
                                        Reject
                                    </MudButton>
                                </MudStack>
                            }
                        }
                        else if (item.ArtifactAccess is { } artifactAccess)
                        {
                            <MudText Class="mt-3"><strong>Requested actions</strong><br />@string.Join(", ", artifactAccess.Actions)</MudText>
                            @if (item.CanDecide && item.Status == "Pending")
                            {
                                <MudTextField Value="@Feedback(item.Id)" ValueChanged="@((string value) => SetFeedback(item.Id, value))"
                                              Label="Decision comment" Lines="2" Variant="Variant.Outlined" Class="mt-3" />
                                @if (_decisionErrors.TryGetValue(item.Id, out var accessError))
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true">@accessError</MudAlert>
                                }
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="@(_decidingId.HasValue)"
                                               OnClick="@(() => DecideArtifactAccessAsync(item, "approve"))">Approve exact files</MudButton>
                                    <MudButton Color="Color.Error" Variant="Variant.Text" Disabled="@(_decidingId.HasValue)"
                                               OnClick="@(() => DecideArtifactAccessAsync(item, "reject"))">Reject</MudButton>
                                </MudStack>
                            }
                        }
                        else if (item.Status == "Pending")
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                This request is observable here. Use “Open source” for its specialized review and execution flow.
                            </MudAlert>
                        }
                    </MudPaper>
                }
            </MudStack>
        }
    }
    </div>
</div>

</EmployeePortraitScope>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? SelectedTab { get; set; }
    private int _activeTab;
    private string? _lastTab;
    private void SelectTab(int index) => _activeTab = index;

    private ApprovalDashboardResponse? _dashboard;
    private bool _loading = true;
    private bool _showHistory;
    private string? _error;
    private Guid? _decidingId;
    private readonly Dictionary<Guid, string> _feedback = [];
    private readonly Dictionary<Guid, string> _decisionErrors = [];

    private IReadOnlyList<ApprovalDashboardItemResponse> VisibleItems =>
        (_dashboard?.Items ?? [])
        .Where(x => _showHistory || x.Status == "Pending")
        .ToList();

    protected override void OnInitialized()
    {
        ApprovalNotifications.Changed += OnApprovalsChanged;
        _ = ApprovalNotifications.InitializeAsync();
    }

    private void OnApprovalsChanged() => _ = InvokeAsync(() =>
    {
        if (ApprovalNotifications.OrganizationId != OrganizationId) return;
        _dashboard = ApprovalNotifications.Dashboard;
        StateHasChanged();
    });

    public void Dispose() => ApprovalNotifications.Changed -= OnApprovalsChanged;

    protected override Task OnParametersSetAsync()
    {
        if (_lastTab != SelectedTab) { _activeTab = SelectedTab == "decisions" ? 1 : 0; _lastTab = SelectedTab; }
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var organizationId = OrganizationId;
            var dashboard = await ApprovalNotifications.LoadAsync(organizationId);
            if (organizationId == OrganizationId) _dashboard = dashboard;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DecideAsync(ApprovalDashboardItemResponse item, string decision)
    {
        if (item.ResourceChange is null || _decidingId.HasValue) return;
        var feedback = Feedback(item.Id);
        if (decision == ResourceChangeDecisionKinds.RequestRevision &&
            string.IsNullOrWhiteSpace(feedback))
        {
            _decisionErrors[item.Id] = "Feedback is required when requesting a revision.";
            return;
        }

        _decidingId = item.Id;
        _decisionErrors.Remove(item.Id);
        try
        {
            var payload = new ResourceChangeDecisionRequest(
                item.Id,
                decision,
                feedback,
                $"approvals:{item.Id:N}:{decision}");
            var response = await Http.PostAsJsonAsync(
                $"api/core/organizations/{OrganizationId:D}/hiring/resource-changes/{item.Id:D}/decide",
                payload);
            if (!response.IsSuccessStatusCode)
            {
                _decisionErrors[item.Id] = await response.Content.ReadAsStringAsync();
                return;
            }
            _feedback.Remove(item.Id);
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _decisionErrors[item.Id] = exception.Message;
        }
        finally
        {
            _decidingId = null;
        }
    }

    private async Task DecideSourceControlAsync(ApprovalDashboardItemResponse item, bool approved)
    {
        if (item.SourceControl is null || _decidingId.HasValue) return;
        var feedback = Feedback(item.Id);
        if (!approved && string.IsNullOrWhiteSpace(feedback))
        {
            _decisionErrors[item.Id] = "Feedback is required when rejecting a code-project or merge request.";
            return;
        }

        _decidingId = item.Id;
        _decisionErrors.Remove(item.Id);
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/organizations/{OrganizationId:D}/source-control/approvals/{item.Id:D}/decision",
                new DecideSourceControlApprovalRequest(
                    approved, feedback, item.SourceControl.Revision));
            if (!response.IsSuccessStatusCode)
            {
                _decisionErrors[item.Id] = await response.Content.ReadAsStringAsync();
                return;
            }
            _feedback.Remove(item.Id);
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _decisionErrors[item.Id] = exception.Message;
        }
        finally
        {
            _decidingId = null;
        }
    }

    private async Task RevokeWebPreviewGrantAsync(ApprovalDashboardItemResponse item)
    {
        if (item.AgentAction?.ResourceId is not { } id || !Guid.TryParse(id, out var grantId) || _decidingId.HasValue) return;
        _decidingId = item.Id;
        _decisionErrors.Remove(item.Id);
        try
        {
            using var response = await Http.PostAsync($"api/core/organizations/{OrganizationId:D}/web-preview-grants/{grantId:D}/revoke", null);
            if (!response.IsSuccessStatusCode) { _decisionErrors[item.Id] = "Preview access could not be revoked. Refresh and try again."; return; }
            await LoadAsync();
        }
        catch (HttpRequestException) { _decisionErrors[item.Id] = "The server could not be reached. Refresh to check the grant status."; }
        finally { _decidingId = null; }
    }
    private async Task DecideAgentActionAsync(ApprovalDashboardItemResponse item, string decision)
    {
        if (item.AgentAction is not { } action || _decidingId.HasValue) return;
        var feedback = Feedback(item.Id);
        if (decision == ResourceChangeDecisionKinds.RequestRevision && string.IsNullOrWhiteSpace(feedback))
        {
            _decisionErrors[item.Id] = "Feedback is required when requesting a revision.";
            return;
        }
        _decidingId = item.Id;
        _decisionErrors.Remove(item.Id);
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/core/organizations/{OrganizationId:D}/approvals/agent-actions/{item.Id:D}/decide",
                new DecideManagedAgentActionRequest(item.Id, decision, feedback, action.PayloadHash,
                    action.ExpectedRevision, action.IdempotencyKey, $"approval:{item.Id:N}:{decision}", action.ResourceId));
            if (!response.IsSuccessStatusCode)
            {
                _decisionErrors[item.Id] = await response.Content.ReadAsStringAsync();
                return;
            }
            _feedback.Remove(item.Id);
            await LoadAsync();
        }
        catch (Exception exception) { _decisionErrors[item.Id] = exception.Message; }
        finally { _decidingId = null; }
    }

    private async Task DecideArtifactAccessAsync(ApprovalDashboardItemResponse item, string decision)
    {
        if (item.ArtifactAccess is null || _decidingId.HasValue) return;
        _decidingId = item.Id;
        _decisionErrors.Remove(item.Id);
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/organizations/{OrganizationId:D}/documents/access-requests/{item.Id:D}/decision",
                new DecideArtifactAccessRequest(decision, Feedback(item.Id), $"approval:{item.Id:N}:{decision}"));
            if (!response.IsSuccessStatusCode)
            {
                _decisionErrors[item.Id] = await response.Content.ReadAsStringAsync();
                return;
            }
            _feedback.Remove(item.Id);
            await LoadAsync();
        }
        catch (Exception exception) { _decisionErrors[item.Id] = exception.Message; }
        finally { _decidingId = null; }
    }

    private string Feedback(Guid id) =>
        _feedback.TryGetValue(id, out var value) ? value : string.Empty;

    private void SetFeedback(Guid id, string value) => _feedback[id] = value;

    private static Color StatusColor(string status) => status switch
    {
        "Pending" => Color.Warning,
        "Approved" => Color.Success,
        "Rejected" => Color.Error,
        "RevisionRequested" => Color.Info,
        _ => Color.Default
    };

    private static string KindLabel(string kind) => kind switch
    {
        ApprovalDashboardKinds.ResourceChange => "Team design",
        ApprovalDashboardKinds.AgentAction => "Agent action",
        ApprovalDashboardKinds.HiringWorkflow => "Hiring",
        ApprovalDashboardKinds.Artifact => "Artifact",
        ApprovalDashboardKinds.ArtifactAccess => "Document access",
        ApprovalDashboardKinds.RepositoryProvisioning => "Private code project",
        ApprovalDashboardKinds.Merge => "Code merge",
        _ => kind
    };
}
