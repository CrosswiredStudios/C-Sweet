@page "/forgot-password"
@layout AnonymousLayout
@using System.ComponentModel.DataAnnotations
@inject IAuthenticationApiClient AuthenticationApi
@inject AuthSessionStore AuthSession
@inject IAppLocalizer L

<PageTitle>@L["ForgotPassword.PageTitle"]</PageTitle>

<MudPaper Elevation="0" Class="auth-card">
    <MudText Typo="Typo.h4">@L["ForgotPassword.Title"]</MudText>
    @if (AuthSession.Current?.EmailRecoveryAvailable != true)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">@L["ForgotPassword.RecoveryUnavailable"]</MudAlert>
        <MudButton Href="/recover-root" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">@L["Login.UseRecoveryCode"]</MudButton>
    }
    <MudText Color="Color.Secondary">@L["ForgotPassword.Lead"]</MudText>
    <EditForm Model="_model" OnValidSubmit="SendAsync" Class="auth-form">
        <DataAnnotationsValidator />
        <MudTextField Label="@L["Login.Email"]" InputType="InputType.Email" @bind-Value="_model.Email" For="@(() => _model.Email)" Variant="Variant.Outlined" Required="true" />
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <MudAlert Severity="@(_success ? Severity.Success : Severity.Error)" Variant="Variant.Outlined">@_message</MudAlert>
        }
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@(AuthSession.Current?.EmailRecoveryAvailable != true)">@L["ForgotPassword.Send"]</MudButton>
        <MudButton Href="/login" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">@L["Auth.BackToSignIn"]</MudButton>
    </EditForm>
</MudPaper>

@code {
    private readonly EmailModel _model = new();
    private string? _message;
    private bool _success;
    private async Task SendAsync()
    {
        var result = await AuthenticationApi.ForgotPasswordAsync(_model.Email);
        _success = result.Succeeded;
        _message = result.Message;
    }
    private sealed class EmailModel { [Required, EmailAddress] public string Email { get; set; } = string.Empty; }
}
