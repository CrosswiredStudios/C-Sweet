@page "/organizations/{OrganizationId:guid}/employees/{EmployeeId:guid}"
@using CSweet.Contracts.Agents
@using CSweet.Contracts.Analytics
@using CSweet.Contracts.Core
@using CSweet.Contracts.Memory
@using CSweet.Contracts.WorkManagement
@using Wire = CSweet.WorkManagement.Contracts
@inject HttpClient Http
@inject NavigationManager Navigation

<EmployeePortraitScope OrganizationId="OrganizationId">
<PageTitle>@(_details?.Employee.DisplayName ?? "Employee") - C-Sweet</PageTitle>

<div class="command-center-shell aurora-page employee-workspace employee-details-page">
    <MudBreadcrumbs Items="_breadcrumbs" />
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_details is null)
    {
        <MudAlert Severity="Severity.Error">@(_error ?? "The employee could not be loaded.")</MudAlert>
    }
    else
    {
        <MudPaper Elevation="0" Class="page-header">
            <div class="employee-profile-identity">
                <span class="employee-profile-portrait" aria-hidden="true"><PersonAvatarContent EmployeeId="_details.Employee.Id" IsAgent="@(_details.Employee.EmployeeType == 1)" Initials="@string.Concat(_details.Employee.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0]))" /></span>
                <div><MudText Typo="Typo.overline">@EmployeeTypeLabel</MudText>
                <MudText Typo="Typo.h3">@_details.Employee.DisplayName</MudText>
                <MudText Color="Color.Secondary">@(_details.Role?.Name ?? "Role not assigned")</MudText></div>
            </div>
            <MudStack Row="true" Spacing="1">
                <MudChip T="string" Color="@(_details.Employee.IsActive ? Color.Success : Color.Default)">@(_details.Employee.IsActive ? "Active" : "Inactive")</MudChip>
                <MudButton Href="@($"/organizations/{OrganizationId}/employees")" Variant="Variant.Outlined">Directory</MudButton>
            </MudStack>
        </MudPaper>

        <MudTabs Rounded="true" Elevation="0" Class="employee-profile-tabs"
                 ActivePanelIndex="_activeTab" ActivePanelIndexChanged="SelectTab"
                 KeepPanelsAlive="true" LazyLoadPanels="true">
            <MudTabPanel Text="Overview" Icon="@Icons.Material.Outlined.Badge">
                <MudGrid Class="mt-2">
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Elevation="0" Class="pa-4">
                            <MudText Typo="Typo.h6">Profile</MudText>
                            <dl class="profile-facts">
                                <div><dt>Email</dt><dd>@(_details.Employee.Email ?? "Not provided")</dd></div>
                                <div><dt>Reports to</dt><dd>@if (_details.Manager is not null) { <a href="@($"/organizations/{OrganizationId}/employees/{_details.Manager.Id}")">@_details.Manager.DisplayName</a> } else { <span>No manager</span> }</dd></div>
                                @if (_details.Worker is not null) { <div><dt>Worker</dt><dd>@_details.Worker.Name</dd></div> }
                                <div><dt>Joined</dt><dd>@_details.Employee.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy")</dd></div>
                            </dl>
                            @if (!string.IsNullOrWhiteSpace(_details.Role?.Description)) { <MudText Class="mt-2">@_details.Role.Description</MudText> }
                            @if (_details.Permissions.CanEditIdentity)
                            {
                                <MudButton Class="mt-3" Size="Size.Small" Variant="Variant.Outlined" OnClick="ToggleProfileEdit">@(_editingProfile ? "Cancel edit" : "Edit profile")</MudButton>
                            }
                            @if (_editingProfile)
                            {
                                <MudStack Spacing="2" Class="mt-3">
                                    <MudTextField @bind-Value="_profileName" Label="Name" Variant="Variant.Outlined" />
                                    <MudTextField @bind-Value="_profileEmail" Label="Email" Variant="Variant.Outlined" />
                                    @if (_details.Permissions.CanManageStructure)
                                    {
                                        <MudSelect T="Guid?" @bind-Value="_profileRoleId" Label="Organization role" Variant="Variant.Outlined" Clearable="true">
                                            @foreach (var role in _roles) { <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)">@role.Name</MudSelectItem> }
                                        </MudSelect>
                                        <MudSelect T="Guid?" @bind-Value="_profileManagerId" Label="Reports to" Variant="Variant.Outlined" Clearable="true">
                                            @foreach (var employee in _employees.Where(x => x.Id != EmployeeId)) { <MudSelectItem T="Guid?" Value="@((Guid?)employee.Id)">@employee.DisplayName</MudSelectItem> }
                                        </MudSelect>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_profileError)) { <MudAlert Severity="Severity.Error">@_profileError</MudAlert> }
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_profileSaving" OnClick="SaveProfileAsync">Save profile</MudButton>
                                </MudStack>
                            }
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Elevation="0" Class="pa-4">
                            <MudText Typo="Typo.h6">Organization</MudText>
                            <MudText Typo="Typo.subtitle2" Class="mt-2">Direct reports</MudText>
                            <MudStack Row="true" Spacing="1" Style="flex-wrap:wrap">
                                @foreach (var report in _details.DirectReports)
                                { <MudChip T="string" Href="@($"/organizations/{OrganizationId}/employees/{report.Id}")">@report.DisplayName</MudChip> }
                                @if (_details.DirectReports.Count == 0) { <MudText Color="Color.Secondary">No direct reports yet.</MudText> }
                            </MudStack>
                            <MudText Typo="Typo.subtitle2" Class="mt-3">Teams</MudText>
                            <MudStack Row="true" Spacing="1" Style="flex-wrap:wrap">
                                @foreach (var team in _details.Teams) { <MudChip T="string">@team.Name</MudChip> }
                                @if (_details.Teams.Count == 0) { <MudText Color="Color.Secondary">Not assigned to a team.</MudText> }
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="Personal Board" Icon="@Icons.Material.Outlined.ViewKanban">
                @if (!_details.Permissions.CanViewSensitive)
                { <MudAlert Severity="Severity.Warning" Class="mt-3">Only this employee and their managers can view this board.</MudAlert> }
                else if (_boardError is not null)
                { <MudAlert Severity="Severity.Error" Class="mt-3">@_boardError <MudButton OnClick="LoadPersonalBoardAsync">Retry</MudButton></MudAlert> }
                else if (_personalBoard is null)
                { <MudProgressLinear Indeterminate="true" Class="mt-3" /> }
                else
                {
                    <div class="mt-3">
                        <EmployeePersonalBoard OrganizationId="OrganizationId" EmployeeId="EmployeeId" Board="_personalBoard" RequestedItemId="ItemId"
                            CanAdd="_details.Permissions.CanManagePersonalBoard"
                            CanExecute="_details.Permissions.CanExecutePersonalWork"
                            IncludeArchived="_includeArchived" IncludeArchivedChanged="SetIncludeArchivedAsync"
                            RefreshRequested="LoadPersonalBoardAsync" />
                    </div>
                }
            </MudTabPanel>
            <MudTabPanel Text="Assigned Work" Icon="@Icons.Material.Outlined.AssignmentInd">
                @if (!_details.Permissions.CanViewSensitive)
                { <MudAlert Severity="Severity.Warning" Class="mt-3">Assignment details are restricted.</MudAlert> }
                else if (_assignmentsError is not null)
                { <MudAlert Severity="Severity.Error" Class="mt-3">@_assignmentsError <MudButton OnClick="LoadAssignmentsAsync">Retry</MudButton></MudAlert> }
                else if (_assigned is null)
                { <MudProgressLinear Indeterminate="true" Class="mt-3" /> }
                else
                {
                    <div class="assigned-toolbar">
                        <div><h2>Assigned work <span>@_assigned.Items.Count</span></h2><p>Open a task to manage it on its team board.</p></div>
                        <MudTextField T="string" @bind-Value="_assignmentSearch" Immediate="true" Label="Search assigned work" Placeholder="Task or board" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
                    </div>
                    <MudTable T="EmployeeAssignedWorkItemResponse" Items="FilteredAssignments" Hover="true" Dense="false" Class="assigned-work-table">
                        <HeaderContent><MudTh>Task</MudTh><MudTh>Board / column</MudTh><MudTh>Relationship</MudTh><MudTh>Priority</MudTh><MudTh>Due</MudTh><MudTh></MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Task"><MudText Typo="Typo.subtitle2">@(!string.IsNullOrWhiteSpace(context.Item.Identifier) ? $"{context.Item.Identifier} · " : "")@context.Item.Title</MudText><MudText Typo="Typo.caption">@context.Item.Status · @context.Item.Kind</MudText></MudTd>
                            <MudTd DataLabel="Board">@context.BoardName / @context.ColumnName@if (!string.IsNullOrWhiteSpace(context.SprintName)) { <MudText Typo="Typo.caption">Sprint: @context.SprintName</MudText> }</MudTd>
                            <MudTd DataLabel="Relationship">@string.Join(", ", context.Relationships.Select(RelationshipLabel))</MudTd>
                            <MudTd DataLabel="Priority">@context.Item.Priority</MudTd>
                            <MudTd DataLabel="Due">@(context.Item.DueDate?.ToLocalTime().ToString("MMM d, yyyy") ?? "—")</MudTd>
                            <MudTd>@if (context.CanOpenBoard) { <MudButton Size="Size.Small" Href="@($"/organizations/{OrganizationId}/work/boards/{context.Item.BoardId}?item={context.Item.Id}")">Open task</MudButton> }</MudTd>
                        </RowTemplate>
                        <NoRecordsContent><MudText Class="pa-4">@(_assignmentSearch.Length > 0 ? "No tasks match your search." : "No tasks assigned from team boards yet.")</MudText></NoRecordsContent>
                    </MudTable>
                }
            </MudTabPanel>
            <MudTabPanel Text="Configuration" Icon="@Icons.Material.Outlined.Tune" Disabled="@(_details.Employee.AgentInstallationId is null)">
                @if (!_details.Permissions.CanViewSensitive)
                { <MudAlert Severity="Severity.Warning">Configuration is restricted to authorized managers.</MudAlert> }
                else if (_details.Employee.AgentInstallationId.HasValue)
                {
                    <EmployeeConfigurationPanel @key="EmployeeId" OrganizationId="OrganizationId" EmployeeId="EmployeeId" ConfigurationChanged="@(view => _configuration = view)" />
                }
            </MudTabPanel>
            <MudTabPanel Text="Agent operations" Icon="@Icons.Material.Outlined.SettingsSuggest" Disabled="@(_details.Employee.AgentInstallationId is null)">
                @if (!_details.Permissions.CanViewSensitive)
                { <MudAlert Severity="Severity.Warning" Class="mt-3">Agent operations are restricted to this employee and their managers.</MudAlert> }
                else if (_details.Employee.AgentInstallationId.HasValue)
                {
                    @if (_details.Role?.Name?.Contains("Chief of Staff", StringComparison.OrdinalIgnoreCase) == true)
                    {
                    <MudButton Href="@($"/organizations/{OrganizationId:D}/hiring-settings/{_details.Employee.AgentInstallationId:D}")">Chief hiring settings</MudButton>
                    }
                    <MudGrid Class="mt-3">
                        <MudItem xs="12" md="6"><MudPaper Outlined="true" Class="pa-4"><MudText Typo="Typo.h6">Runtime status</MudText><MudText>@(_runtime?.Stage ?? "Unavailable")</MudText><MudText Color="Color.Secondary">@(_runtime?.Reason ?? _runtime?.RuntimeStatus)</MudText></MudPaper></MudItem>
                        <MudItem xs="12" md="6"><MudPaper Outlined="true" Class="pa-4"><MudText Typo="Typo.h6">Schedule & resources</MudText><MudText>@(_installation?.Schedule.ActivationMode ?? "Unavailable")</MudText><MudText Color="Color.Secondary">@(_installation is null ? "" : $"{_installation.MemoryMb} MB · {_installation.CpuPercent}% CPU · {_installation.Schedule.MaxRuntimeSeconds}s max runtime")</MudText></MudPaper></MudItem>
                        <MudItem xs="12" md="6"><MudPaper Outlined="true" Class="pa-4"><MudText Typo="Typo.h6">Capabilities & access</MudText>@if (_installation is null) { <MudText Color="Color.Secondary">Access information unavailable.</MudText> } else { <details class="access-list" open><summary>Capabilities · @_installation.GrantedCapabilities.Count</summary><ul>@foreach (var capability in _installation.GrantedCapabilities) { <li>@capability</li> }</ul></details><MudText Typo="Typo.body2">Public internet: @(_installation.PublicInternetGranted ? "Allowed" : "Restricted")</MudText><RuntimeInternetAccessReview Installation="_installation" Updated="@(updated => _installation = updated)" /><MudText Typo="Typo.body2">Runtime network: @(_installation.LatestRuntime?.NetworkMode ?? "not-running")</MudText><MudText Typo="Typo.body2">Runtime image tools: @(_installation.LatestRuntime?.ImageTools.Count > 0 ? string.Join(", ", _installation.LatestRuntime.ImageTools) : "Unavailable until a certified development runtime is running")</MudText><details class="access-list"><summary>Network access · @_installation.GrantedNetworkAccess.Count</summary><ul>@foreach (var address in _installation.GrantedNetworkAccess) { <li>@address</li> }</ul></details> }</MudPaper></MudItem>
                        <MudItem xs="12" md="6">
                            <MudPaper Outlined="true" Class="pa-4">
                                <MudText Typo="Typo.h6">Runs & diagnostics</MudText>
                                <MudText Color="Color.Secondary">@(_runtime is null ? "Run history unavailable" : $"{_runtimeRuns.Count} recent runs")</MudText>
                                <MudText Color="Color.Secondary">Build: @(_installation?.Build?.Status ?? "No build status") · Configuration: @(_configuration?.SynchronizationStatus ?? "Unavailable")</MudText>
                                @if (_configuration is not null) { <MudText Typo="Typo.caption">@_configuration.Fields.Count configuration fields · Secrets masked</MudText> }
                                @if (_runtimeRuns.Count > 0)
                                {
                                    <MudExpansionPanels MultiExpansion="true" Class="mt-2">
                                        @foreach (var run in _runtimeRuns.Take(10))
                                        {
                                            <MudExpansionPanel Text="@($"{run.QueuedAt.LocalDateTime:g} · {run.Status}")">
                                                @if (!string.IsNullOrWhiteSpace(run.Reason))
                                                {
                                                    <MudAlert Severity="@RuntimeRunSeverity(run.Status)" Dense="true" Variant="Variant.Outlined">@run.Reason</MudAlert>
                                                }
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Runtime @run.Id · Tick @run.TickId</MudText>
                                                @if (run.Events.Count > 0)
                                                {
                                                    <pre style="white-space:pre-wrap;max-height:16rem;overflow:auto">@RuntimeEventLog(run)</pre>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(run.LogExcerpt))
                                                {
                                                    <MudText Typo="Typo.subtitle2">Runtime output</MudText>
                                                    <pre style="white-space:pre-wrap;max-height:20rem;overflow:auto">@run.LogExcerpt</pre>
                                                }
                                            </MudExpansionPanel>
                                        }
                                    </MudExpansionPanels>
                                }
                                @if (_buildLog is not null)
                                {
                                    <MudExpansionPanels Class="mt-2"><MudExpansionPanel Text="Build log"><pre style="white-space:pre-wrap;max-height:20rem;overflow:auto">@_buildLog.Content</pre></MudExpansionPanel></MudExpansionPanels>
                                }

                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }
            </MudTabPanel>
            <MudTabPanel Text="Memory" Icon="@Icons.Material.Outlined.Hub" Disabled="@(_details.Employee.AgentInstallationId is null)">
                @if (!_details.Permissions.CanViewSensitive)
                { <MudAlert Severity="Severity.Warning" Class="mt-3">Memory is restricted to this employee and their managers.</MudAlert> }
                else
                {
                    <AgentMemory Embedded="true" OrganizationId="OrganizationId" EmployeeId="EmployeeId" @key="(OrganizationId, EmployeeId)" />
                }
            </MudTabPanel>
            <MudTabPanel Text="Usage" Icon="@Icons.Material.Outlined.QueryStats">
                @if (!_details.Permissions.CanViewSensitive)
                { <MudAlert Severity="Severity.Warning" Class="mt-3">Usage is restricted to this employee and their managers.</MudAlert> }
                else
                {
                    <div class="section-intro"><h2>Model usage</h2><p>Tokens and requests across all models. Windows overlap.</p></div>
                    <MudGrid>
                        @foreach (var window in UsageWindows)
                        {
                            var usage = UsageFor(window.Key);
                            <MudItem xs="12" md="4"><MudPaper Outlined="true" Class="pa-5 usage-card">
                                <MudText Typo="Typo.overline">@window.Label</MudText>
                                @if (usage is null) { <MudText Typo="Typo.h5">Unavailable</MudText><MudText Color="Color.Secondary">Usage could not be loaded.</MudText> }
                                else { <MudText Typo="Typo.h4">@usage.Sum(x => x.TotalTokens).ToString("N0")</MudText><MudText Color="Color.Secondary">tokens · @usage.Sum(x => x.RequestCount).ToString("N0") model calls</MudText> }
                            </MudPaper></MudItem>
                        }
                    </MudGrid>
                    @if (UsageWindows.Any(x => UsageFor(x.Key) is null)) { <MudButton Class="mt-3" OnClick="LoadUsageAsync">Retry usage</MudButton> }
                }
            </MudTabPanel>
            @if (_details.Permissions.CanViewTimeline)
            {
                <MudTabPanel Text="Timeline" Icon="@Icons.Material.Outlined.Timeline"><EmployeeTimeline OrganizationId="OrganizationId" EmployeeId="EmployeeId" CanViewAuditLog="_details.Permissions.CanViewAuditLog" /></MudTabPanel>
            }
        </MudTabs>
    }
</div>

</EmployeePortraitScope>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid EmployeeId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    [SupplyParameterFromQuery(Name = "item")] public Guid? ItemId { get; set; }
    private static readonly string[] TabSlugs =
        ["overview", "personal-board", "assigned-work", "configuration", "agent-operations", "memory", "usage", "timeline"];
    private int _activeTab;
    private Guid? _loadedOrganizationId;
    private Guid? _loadedEmployeeId;
    private EmployeeDetailsResponse? _details;
    private Wire.PersonalTodoBoard? _personalBoard;
    private EmployeeAssignedWorkResponse? _assigned;
    private AgentRuntimeReadinessResponse? _runtime;
    private AgentInstallationResponse? _installation;
    private IReadOnlyList<AgentRuntimeRunResponse> _runtimeRuns = [];
    private AgentBuildLogResponse? _buildLog;
    private AgentConfigurationView? _configuration;
    private IReadOnlyList<OrganizationUserResponse> _employees = [];
    private IReadOnlyList<RoleResponse> _roles = [];
    private readonly Dictionary<string, IReadOnlyList<EmployeeModelInferenceUsageResponse>> _usage = [];
    private bool _loading = true;
    private bool _includeArchived;
    private string? _error;
    private string? _boardError, _assignmentsError;
    private string _assignmentSearch = "";
    private IEnumerable<EmployeeAssignedWorkItemResponse> FilteredAssignments => (_assigned?.Items ?? []).Where(x =>
        string.IsNullOrWhiteSpace(_assignmentSearch) ||
        $"{x.Item.Identifier} {x.Item.Title} {x.BoardName}".Contains(_assignmentSearch.Trim(), StringComparison.OrdinalIgnoreCase));
    private bool _editingProfile;
    private bool _profileSaving;
    private string _profileName = string.Empty;
    private string? _profileEmail;
    private Guid? _profileRoleId;
    private Guid? _profileManagerId;
    private string? _profileError;
    private readonly List<BreadcrumbItem> _breadcrumbs = [];
    private static readonly (string Key, string Label)[] UsageWindows = [("24h", "Last 24 hours"), ("7d", "Last 7 days"), ("30d", "Last 30 days")];
    private string EmployeeTypeLabel => _details?.Employee.EmployeeType == 1 ? "Agent employee" : "Human employee";

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedOrganizationId == OrganizationId && _loadedEmployeeId == EmployeeId)
        {
            ApplyTabSelection();
            return;
        }
        _loadedOrganizationId = OrganizationId; _loadedEmployeeId = EmployeeId;
        _loading = true; _error = null; _breadcrumbs.Clear();
        _details = null; _personalBoard = null; _assigned = null; _runtime = null; _installation = null;
        _runtimeRuns = []; _configuration = null; _buildLog = null; _usage.Clear();
        _boardError = null; _assignmentsError = null; _editingProfile = false; _profileError = null;
        _assignmentSearch = ""; _includeArchived = false;
        _breadcrumbs.Add(new("Employees", $"/organizations/{OrganizationId}/employees"));
        try
        {
            _details = await Http.GetFromJsonAsync<EmployeeDetailsResponse>($"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/details");
            if (_details is null) throw new InvalidOperationException("The employee response was empty.");
            _employees = await Http.GetFromJsonAsync<IReadOnlyList<OrganizationUserResponse>>($"api/core/organizations/{OrganizationId}/users") ?? [];
            _roles = await Http.GetFromJsonAsync<IReadOnlyList<RoleResponse>>($"api/organizations/{OrganizationId}/roles") ?? [];
            _breadcrumbs.Add(new(_details.Employee.DisplayName, null, true));
            if (_details.Permissions.CanViewSensitive)
            {
                await Task.WhenAll(LoadPersonalBoardAsync(), LoadAssignmentsAsync(), LoadUsageAsync());
                if (_details.Employee.AgentInstallationId.HasValue)
                {
                    try
                    {
                        var runtimeTask = Http.GetFromJsonAsync<AgentRuntimeReadinessResponse>($"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/runtime");
                        var operationsTask = Http.GetFromJsonAsync<AgentInstallationResponse>($"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/operations");
                        var historyTask = Http.GetFromJsonAsync<IReadOnlyList<AgentRuntimeRunResponse>>($"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/runtime-history");
                        await Task.WhenAll(runtimeTask, operationsTask, historyTask);
                        _runtime = await runtimeTask; _installation = await operationsTask;
                        _runtimeRuns = await historyTask ?? [];
                        try { _configuration = await Http.GetFromJsonAsync<AgentConfigurationView>($"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/configuration"); } catch { _configuration = null; }
                        try { _buildLog = await Http.GetFromJsonAsync<AgentBuildLogResponse>($"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/build-log"); } catch { _buildLog = null; }
                    }
                    catch { _runtime = null; _installation = null; _runtimeRuns = []; _configuration = null; _buildLog = null; }
                }
            }
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _loading = false; }
        ApplyTabSelection();
    }

    private void ApplyTabSelection() => _activeTab = ReachableTabIndex(IndexForSlug(Tab));

    private void SelectTab(int index)
    {
        _activeTab = index;
        if (IndexForSlug(Tab) == index) return;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", index == 0 ? null : TabSlugs[index]));
    }

    private static int IndexForSlug(string? slug)
    {
        if (string.IsNullOrWhiteSpace(slug)) return 0;
        for (var index = 0; index < TabSlugs.Length; index++)
        {
            if (string.Equals(TabSlugs[index], slug.Trim(), StringComparison.OrdinalIgnoreCase)) return index;
        }
        return 0;
    }

    private int ReachableTabIndex(int index)
    {
        if (index is 3 or 4 or 5 && _details?.Employee.AgentInstallationId is null) return 0;
        if (index == 7 && _details?.Permissions.CanViewTimeline != true) return 0;
        return index;
    }

    private async Task LoadPersonalBoardAsync()
    {
        _boardError = null;
        try { _personalBoard = await Http.GetFromJsonAsync<Wire.PersonalTodoBoard>($"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/personal-board?includeArchived={_includeArchived.ToString().ToLowerInvariant()}"); if (_personalBoard is null) _boardError = "Personal board is unavailable."; }
        catch { _boardError = "Personal board could not be loaded."; }
    }
    private async Task SetIncludeArchivedAsync(bool value) { _includeArchived = value; await LoadPersonalBoardAsync(); }
    private async Task LoadAssignmentsAsync()
    {
        _assignmentsError = null;
        try { _assigned = await Http.GetFromJsonAsync<EmployeeAssignedWorkResponse>($"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/assignments"); if (_assigned is null) _assignmentsError = "Assigned work is unavailable."; }
        catch { _assignmentsError = "Assigned work could not be loaded."; }
    }
    private async Task LoadUsageAsync()
    {
        foreach (var window in UsageWindows)
        {
            try
            {
                var response = await Http.GetFromJsonAsync<InferenceAnalyticsResponse>($"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/usage?window={window.Key}");
                if (response is null) _usage.Remove(window.Key);
                else _usage[window.Key] = response.Employees.Where(x => x.EmployeeId == EmployeeId).ToList();
            }
            catch { _usage.Remove(window.Key); }
        }
    }
    private IReadOnlyList<EmployeeModelInferenceUsageResponse>? UsageFor(string window) => _usage.GetValueOrDefault(window);
    private static Severity RuntimeRunSeverity(string status) => status switch
    {
        "Completed" or "Running" => Severity.Success,
        "Queued" or "Starting" or "WaitingForMcpSession" => Severity.Info,
        "Cancelled" => Severity.Warning,
        _ => Severity.Error
    };
    private static string RuntimeEventLog(AgentRuntimeRunResponse run) =>
        string.Join(Environment.NewLine, run.Events.Select(runtimeEvent =>
            $"[{runtimeEvent.OccurredAt.LocalDateTime:yyyy-MM-dd HH:mm:ss}] {runtimeEvent.Status}: {runtimeEvent.Reason}"));
    private void ToggleProfileEdit()
    {
        _editingProfile = !_editingProfile; _profileError = null;
        if (!_editingProfile || _details is null) return;
        _profileName = _details.Employee.DisplayName; _profileEmail = _details.Employee.Email;
        _profileRoleId = _details.Employee.RoleId; _profileManagerId = _details.Employee.ReportsToOrganizationUserId;
    }
    private async Task SaveProfileAsync()
    {
        if (_details is null) return;
        _profileSaving = true; _profileError = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/core/organizations/{OrganizationId}/employees/{EmployeeId}/profile",
                new UpdateEmployeeProfileRequest(_profileName, _profileEmail, _profileRoleId,
                    _profileManagerId, _details.Employee.Revision));
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException(await response.Content.ReadAsStringAsync());
            _details = await response.Content.ReadFromJsonAsync<EmployeeDetailsResponse>()
                ?? throw new InvalidOperationException("The updated employee response was empty.");
            _editingProfile = false;
        }
        catch (Exception exception) { _profileError = exception.Message; }
        finally { _profileSaving = false; }
    }
    private static string RelationshipLabel(string value) => value switch { "DirectAssignee" => "Direct assignee", "AccountableOwner" => "Accountable owner", "StageAssignee" => "Stage assignee", "StageAgent" => "Stage agent", _ => value };
}
