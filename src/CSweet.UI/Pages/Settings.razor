@page "/settings"
@layout SettingsLayout

<PageTitle>Settings - C-Sweet</PageTitle>
<section class="settings-overview">
    <div class="page-header">
        <div><MudText Typo="Typo.overline">Your workspace</MudText><MudText Typo="Typo.h3">Make it yours</MudText><MudText Color="Color.Secondary">Preferences, connections, and the tools behind your team.</MudText></div>
        <MudTextField T="string" @bind-Value="_search" Immediate="true" Label="Find a setting" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
    </div>
    @foreach (var group in MatchingSections.GroupBy(section => section.Group))
    {
        <section class="settings-category" aria-label="@group.Key">
            <h2>@group.Key</h2>
            <div class="settings-category-grid">
                @foreach (var section in group)
                {
                    <a class="settings-category-card" href="@section.Url">
                        <span class="settings-category-icon"><MudIcon Icon="@section.Icon" /></span>
                        <span><strong>@section.Title</strong><small>@section.Description</small></span>
                        <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Class="settings-card-arrow" />
                    </a>
                }
            </div>
        </section>
    }
    @if (!MatchingSections.Any()) { <div class="settings-empty" role="status"><h2>No matching settings</h2><p>Try a provider, connection, or feature name.</p><MudButton OnClick="@(() => _search = string.Empty)">Clear search</MudButton></div> }
</section>
@code {
    private string _search = string.Empty;
    private IEnumerable<SettingsSection> MatchingSections => SettingsSections.All.Where(section =>
        $"{section.Group} {section.Title} {section.Description}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));
}
