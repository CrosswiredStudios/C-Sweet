@page "/settings"
@layout SettingsLayout
@inject IAppLocalizer L

<PageTitle>@L["Settings.PageTitle"]</PageTitle>
<section class="settings-overview">
    <div class="page-header">
        <div><MudText Typo="Typo.overline">@L["Settings.Overline"]</MudText><MudText Typo="Typo.h3">@L["Settings.Heading"]</MudText><MudText Color="Color.Secondary">@L["Settings.Lead"]</MudText></div>
        <MudTextField T="string" @bind-Value="_search" Immediate="true" Label="@L["Settings.SearchLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
    </div>
    @foreach (var group in MatchingSections.GroupBy(section => section.GroupKey))
    {
        <section class="settings-category" aria-label="@L[group.Key]">
            <h2>@L[group.Key]</h2>
            <div class="settings-category-grid">
                @foreach (var section in group)
                {
                    <a class="settings-category-card" href="@section.Url">
                        <span class="settings-category-icon"><MudIcon Icon="@section.Icon" /></span>
                        <span><strong>@L[section.TitleKey]</strong><small>@L[section.DescriptionKey]</small></span>
                        <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Class="settings-card-arrow" />
                    </a>
                }
            </div>
        </section>
    }
    @if (!MatchingSections.Any()) { <div class="settings-empty" role="status"><h2>@L["Settings.NoMatches.Title"]</h2><p>@L["Settings.NoMatches.Hint"]</p><MudButton OnClick="@(() => _search = string.Empty)">@L["Common.ClearSearch"]</MudButton></div> }
</section>
@code {
    private string _search = string.Empty;
    private IEnumerable<SettingsSection> MatchingSections => SettingsSections.All.Where(section =>
        $"{L[section.GroupKey]} {L[section.TitleKey]} {L[section.DescriptionKey]}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));
}
