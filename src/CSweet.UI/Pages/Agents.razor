    private async Task LoadConfigurationAsync(AgentInstallationResponse agent)
    {
        _configurationCts?.Cancel();
        _configurationCts?.Dispose();
        var configurationCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
        configurationCts.CancelAfter(TimeSpan.FromSeconds(90));
        _configurationCts = configurationCts;

        _isLoadingConfiguration = true;
        _configurationError = null;
        _actionMessage = null;
        _schema = null;
        _configurationView = null;
        _formValues.Clear();

        try
        {
            _configurationView = await AgentApi.GetDefinitionConfigurationAsync(agent.Id, configurationCts.Token);
            _schema = ToSchema(_configurationView);
            HydrateFormValues(_schema);
            await LoadConfiguredProviderModelsAsync(_schema);
        }
        catch (OperationCanceledException) when (configurationCts.IsCancellationRequested)
        {
            if (_configurationDialogOpen && !_disposeCts.IsCancellationRequested)
            {
                _configurationError = "The configuration request timed out. Try again.";
            }
            _schema = null;
        }
        catch (Exception ex)
        {
            _configurationError = ex.Message;
        }
        finally
        {
            if (ReferenceEquals(_configurationCts, configurationCts))
            {
                _isLoadingConfiguration = false;
            }
        }
    }

    private async Task SaveConfigurationAsync()
    {
        if (_selectedAgent is null || _schema is null || _configurationView is null)
        {
            return;
        }

        _isBusy = true;
        _actionMessage = null;
        _actionSucceeded = null;

        try
        {
            var missingRequired = _schema.Fields
                .Where(field => field.Required && IsMissingValue(field))
                .Select(field => field.Label)
                .ToList();
            if (missingRequired.Count > 0)
            {
                _actionSucceeded = false;
                _actionMessage = $"Complete the required settings: {string.Join(", ", missingRequired)}.";
                return;
            }

            var settings = _schema.Fields.ToDictionary(
                field => field.Key,
                field => JsonSerializer.SerializeToElement(_formValues.GetValueOrDefault(field.Key), SerializerOptions),
                StringComparer.Ordinal);

            _configurationView = await AgentApi.UpdateDefinitionConfigurationAsync(
                _selectedAgent.Id,
                new PutAgentDefinitionConfigurationRequest(
                    _schema.SchemaVersion,
                    settings,
                    _configurationView.ExpectedRevision));

            _actionSucceeded = true;
            _actionMessage = "Global agent defaults saved. Stopped agents remain stopped.";
            _schema = ToSchema(_configurationView);
            HydrateFormValues(_schema);
        }
        catch (Exception ex)
        {
            _actionSucceeded = false;
            _actionMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static AgentConfigurationSchemaResponse ToSchema(AgentConfigurationView view) => new(
        view.AgentId,
        view.AgentVersion,
        view.SchemaVersion,
        view.Fields,
        view.EffectiveValues);

    private void HydrateFormValues(AgentConfigurationSchemaResponse schema)
    {
        _formValues.Clear();

        foreach (var field in schema.Fields)
        {
            if (!schema.Settings.TryGetValue(field.Key, out var value))
            {
                _formValues[field.Key] = field.Type == AgentConfigurationFieldTypes.Boolean ? false : null;
                continue;
            }

            _formValues[field.Key] = field.Type switch
            {
                AgentConfigurationFieldTypes.Boolean => value.ValueKind is JsonValueKind.True,
                AgentConfigurationFieldTypes.Number => value.ValueKind == JsonValueKind.Number && value.TryGetDecimal(out var number)
                    ? number
                    : null,
                _ => value.ValueKind == JsonValueKind.String ? value.GetString() : null
            };
        }
    }

    private AgentTokenUsageResponse? AgentUsage(string agentKey) =>
        _usageSummary?.Agents.FirstOrDefault(agent => string.Equals(agent.AgentKey, agentKey, StringComparison.Ordinal));

    private static RenderFragment UsageCard(string label, LlmTokenUsageWindowResponse usage) => @<MudPaper Elevation="1" Class="usage-summary-card">
        <MudText Typo="Typo.overline" Color="Color.Secondary">@label</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @usage.RequestCount.ToString("N0") model calls · @usage.UsageReportedCallCount.ToString("N0") with usage
        </MudText>
        <div class="usage-token-breakdown">
            <div>
                <span>Input</span>
                <strong>@FormatTokens(usage.InputTokens)</strong>
            </div>
            <div>
                <span>Output</span>
                <strong>@FormatTokens(usage.OutputTokens)</strong>
            </div>
            @if (usage.CachedInputTokens > 0)
            {
                <div>
                    <span>Cached input</span>
                    <strong>@FormatTokens(usage.CachedInputTokens)</strong>
                </div>
            }
        </div>
    </MudPaper>;

    private string GetStringValue(string key) =>
        _formValues.TryGetValue(key, out var value) ? value?.ToString() ?? string.Empty : string.Empty;

    private decimal? GetNumberValue(string key) =>
        _formValues.TryGetValue(key, out var value) && value is decimal number ? number : null;

    private bool GetBooleanValue(string key) =>
        _formValues.TryGetValue(key, out var value) && value is true;

    private void SetFormValue(string key, object? value)
    {
        _formValues[key] = value;
    }

    private async Task SetProviderValueAsync(string key, string value)
    {
        _formValues[key] = value;

        if (_schema is null)
        {
            return;
        }

        var provider = FindProvider(value);
        if (provider is not null)
            await LoadProviderModelsAsync(provider.Id);

        foreach (var modelField in _schema.Fields.Where(field =>
            field.Type == AgentConfigurationFieldTypes.LlmModel &&
            string.Equals(ProviderFieldKey(field), key, StringComparison.Ordinal)))
        {
            var models = provider is null ? [] : ModelOptions(modelField);
            _formValues[modelField.Key] = provider is null
                ? string.Empty
                : models.Contains(provider.DefaultChatModel, StringComparer.Ordinal)
                    ? provider.DefaultChatModel
                    : models.FirstOrDefault() ?? string.Empty;
        }
    }

    private bool IsModelPickerDisabled(AgentConfigurationField field) =>
        FindProvider(GetStringValue(ProviderFieldKey(field))) is not { } provider ||
        _loadingProviderModels.Contains(provider.Id);

    private string ModelPlaceholder(AgentConfigurationField field) =>
        FindProvider(GetStringValue(ProviderFieldKey(field))) is not { } provider
            ? "Select a provider first"
            : _loadingProviderModels.Contains(provider.Id)
                ? "Loading models..."
                : "Select a model";

    private IReadOnlyList<string> ModelOptions(AgentConfigurationField field)
    {
        var provider = FindProvider(GetStringValue(ProviderFieldKey(field)));
        if (provider is null)
            return [];

        var models = _providerModels.GetValueOrDefault(provider.Id) ?? [];
        return models
            .Append(provider.DefaultChatModel)
            .Where(model => !string.IsNullOrWhiteSpace(model))
            .Distinct(StringComparer.Ordinal)
            .ToList();
    }

    private bool SelectedModelMissing(AgentConfigurationField field)
    {
        var selected = GetStringValue(field.Key);
        return !string.IsNullOrWhiteSpace(selected) &&
            !ModelOptions(field).Contains(selected, StringComparer.Ordinal);
    }

    private string ProviderFieldKey(AgentConfigurationField modelField)
    {
        if (!string.IsNullOrWhiteSpace(modelField.DependsOnFieldKey))
        {
            return modelField.DependsOnFieldKey;
        }

        return _schema?.Fields.FirstOrDefault(field => field.Type == AgentConfigurationFieldTypes.LlmProvider)?.Key
            ?? string.Empty;
    }

    private LlmProviderProfileResponse? FindProvider(string providerId)
    {
        return Guid.TryParse(providerId, out var id)
            ? _providerProfiles.FirstOrDefault(provider => provider.Id == id)
            : null;
    }

    private async Task LoadConfiguredProviderModelsAsync(AgentConfigurationSchemaResponse schema)
    {
        var providerIds = schema.Fields
            .Where(field => field.Type == AgentConfigurationFieldTypes.LlmProvider)
            .Select(field => GetStringValue(field.Key))
            .Where(value => Guid.TryParse(value, out _))
            .Select(Guid.Parse)
            .Distinct()
            .ToList();

        await Task.WhenAll(providerIds.Select(LoadProviderModelsAsync));

        foreach (var modelField in schema.Fields.Where(field =>
                     field.Type == AgentConfigurationFieldTypes.LlmModel &&
                     string.IsNullOrWhiteSpace(GetStringValue(field.Key))))
        {
            var provider = FindProvider(GetStringValue(ProviderFieldKey(modelField)));
            if (provider is null)
                continue;
            var models = ModelOptions(modelField);
            _formValues[modelField.Key] = models.Contains(provider.DefaultChatModel, StringComparer.Ordinal)
                ? provider.DefaultChatModel
                : models.FirstOrDefault() ?? string.Empty;
        }
    }

    private async Task LoadProviderModelsAsync(Guid providerId)
    {
        if ((_providerModels.ContainsKey(providerId) && !_providerModelErrors.ContainsKey(providerId)) ||
            !_loadingProviderModels.Add(providerId))
            return;

        _providerModelErrors.Remove(providerId);
        try
        {
            var result = await LlmProviderApi.GetModelCatalogAsync(providerId);
            if (!result.Succeeded)
            {
                _providerModelErrors[providerId] = result.Message ?? "Models could not be loaded from this provider.";
                _providerModels[providerId] = [];
                return;
            }

            _providerModels[providerId] = result.Models
                .Select(model => model.Id)
                .Where(model => !string.IsNullOrWhiteSpace(model))
                .Distinct(StringComparer.Ordinal)
                .ToList();
        }
        catch (Exception exception)
        {
            _providerModelErrors[providerId] = exception.Message;
            _providerModels[providerId] = [];
        }
        finally
        {
            _loadingProviderModels.Remove(providerId);
        }
    }

    private string? ModelCatalogError(AgentConfigurationField providerField)
    {
        var provider = FindProvider(GetStringValue(providerField.Key));
        return provider is not null && _providerModelErrors.TryGetValue(provider.Id, out var error)
            ? error
            : null;
    }

    private bool IsMissingValue(AgentConfigurationField field)
    {
        if (!_formValues.TryGetValue(field.Key, out var value) || value is null)
            return true;

        return field.Type is AgentConfigurationFieldTypes.Boolean or AgentConfigurationFieldTypes.Number
            ? false
            : string.IsNullOrWhiteSpace(value.ToString());
    }

    private static string FormatTokens(long tokens) => tokens >= 1_000_000
        ? $"{tokens / 1_000_000d:0.##}M"
        : tokens >= 1_000
            ? $"{tokens / 1_000d:0.#}K"
            : tokens.ToString("N0");

    private static string FormatCharacters(long characters) => characters >= 1_000_000
        ? $"{characters / 1_000_000d:0.##}M"
        : characters >= 1_000
            ? $"{characters / 1_000d:0.#}K"
            : characters.ToString("N0");

    private static string FormatPurposes(IReadOnlyDictionary<string, int> purposes) =>
        string.Join(", ", purposes.OrderBy(item => item.Key, StringComparer.Ordinal)
            .Select(item => $"{item.Key} ×{item.Value}"));

    private static string FormatUsageCaption(LlmTokenUsageWindowResponse? usage) =>
        usage is null
            ? "In 0 / Out 0 / 30d"
            : $"In {FormatTokens(usage.InputTokens)} / Out {FormatTokens(usage.OutputTokens)} / 30d";

    private static string DisplayImportValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not specified" : value;

    private static Color BuildStatusColor(string status) => status switch
    {
        "Succeeded" => Color.Success,
        "Failed" or "Cancelled" => Color.Error,
        _ => Color.Warning
    };

    private static string BuildStepIcon(string status) => status switch
    {
        "Succeeded" => Icons.Material.Filled.CheckCircle,
        "Failed" => Icons.Material.Filled.Error,
        "Cancelled" => Icons.Material.Filled.DisabledByDefault,
        _ => Icons.Material.Filled.RadioButtonUnchecked
    };

    private static Color BuildStepColor(string status) => status switch
    {
        "Succeeded" => Color.Success,
        "Failed" => Color.Error,
        "Cancelled" => Color.Warning,
        "InProgress" => Color.Primary,
        _ => Color.Default
    };

    private static string BuildStatusLabel(string status) => status switch
    {
        "Queued" => "Build queued",
        "Cloning" or "Building" => "Building",
        "Succeeded" => "Built",
        "Failed" => "Build failed",
        "Cancelled" => "Build cancelled",
        _ => status
    };

    private static bool IsRuntimeActive(string? status) => status is
        "Queued" or "Starting" or "WaitingForMcpSession" or "Running" or "CompletionReported" or "Stopping";

    private static bool IsBuildSuccessful(string? status) => status is null or "Succeeded";

    private void OpenSecureRuntimeSetup() =>
        Navigation.NavigateTo("/settings/agents/runtime");

    private static bool IsAlwaysOn(AgentInstallationResponse installation) =>
        string.Equals(installation.Schedule.ActivationMode, "AlwaysOn", StringComparison.Ordinal);

    private static string FormatLastRun(AgentRuntimeRunResponse? run) => run is null
        ? "Never"
        : $"{run.Status} · {run.QueuedAt.ToLocalTime():g}";

    private static string FormatTimestamp(DateTimeOffset? timestamp) =>
        timestamp?.ToLocalTime().ToString("g") ?? "—";

    private static string FormatFrequency(int seconds) => seconds % 3600 == 0
        ? $"{seconds / 3600}h"
        : seconds % 60 == 0
            ? $"{seconds / 60}m"
            : $"{seconds}s";

    private static string FormatNextTick(DateTimeOffset? nextTickAt) =>
        nextTickAt?.ToLocalTime().ToString("g") ?? "Not scheduled";

    public void Dispose()
    {
        _configurationCts?.Cancel();
        _configurationCts?.Dispose();
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }

    private sealed record AgentBuildProgress(
        string Title,
        string Detail,
        bool IsTerminal,
        Severity Severity);

    private static RenderFragment ImportValueSection(string title, IReadOnlyList<string> values) => @<div class="agent-import-values-section">
        <MudText Typo="Typo.subtitle2">@title</MudText>
        @if (values.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">None requested</MudText>
        }
        else
        {
            <div class="agent-import-values">
                @foreach (var value in values)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@value</MudChip>
                }
            </div>
        }
    </div>;

    private RenderFragment ApprovalSection(string title, IReadOnlyList<string> requested, HashSet<string> approved) => @<div class="agent-import-values-section">
        <MudText Typo="Typo.subtitle2">Approved @title.ToLowerInvariant()</MudText>
        @if (requested.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">None requested</MudText>
        }
        else
        {
            <div class="agent-import-approval-list">
                @foreach (var value in requested)
                {
                    <MudCheckBox T="bool"
                                 Label="@value"
                                 Value="@approved.Contains(value)"
                                 ValueChanged="@((bool isApproved) => SetApproval(approved, value, isApproved))" />
                }
            </div>
        }
    </div>;
}
