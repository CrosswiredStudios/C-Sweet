    private async Task CheckForUpdatesAsync(CancellationToken cancellationToken)
    {
        _isCheckingUpdates = true;
        _updateCheckError = null;

        try
        {
            _updates = await AgentApi.CheckUpdatesAsync(cancellationToken);
            _updateCheckError = _updates.FirstOrDefault(update => !string.IsNullOrWhiteSpace(update.Error))?.Error;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch
        {
            _updates = [];
            _updateCheckError = "Agent update checks are temporarily unavailable.";
        }
        finally
        {
            _isCheckingUpdates = false;
            if (!cancellationToken.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

