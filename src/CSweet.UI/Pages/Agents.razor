        _isInstallingImport = true;
        _importError = null;
        try
        {
            var installation = await AgentApi.InstallAsync(
                _importPreview.ImportId,
                new InstallAgentRequest(
                    _installBusinessId.Trim(),
                    _installActivationMode,
                    _installTickFrequencySeconds,
                    _installOverlapPolicy,
                    _approvedCapabilities.ToList(),
                    _approvedSubscriptions.ToList(),
                    _approvedPublications.ToList(),
                    _approvedPermissions.ToList(),
                    _approvedNetworkAccess.ToList(),
                    _installMaxRuntimeSeconds,
                    _installMemoryMb,
                    _installCpuPercent)
                {
                    GrantedRequestedCapabilities = _approvedRequestedCapabilities.ToList(),
                    ConfigurationSettings = _importConfigurationValues
                        .Where(pair => pair.Value is not null)
                        .ToDictionary(
                            pair => pair.Key,
                            pair => JsonSerializer.SerializeToElement(pair.Value, SerializerOptions),
                            StringComparer.Ordinal)
                },
                _disposeCts.Token);
            _installations = _installations.Prepend(installation).ToList();
            _importDialogOpen = false;
            _isInstallingImport = false;
            await InvokeAsync(StateHasChanged);
            await LoadAsync();
            if (!string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//", StringComparison.Ordinal))
                Navigation.NavigateTo(ReturnUrl);
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested) { }
        catch (Exception exception)
        {
            _importError = exception.Message;
        }
        finally
        {
            _isInstallingImport = false;
        }
    }

