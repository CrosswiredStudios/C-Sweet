@page "/settings/agents"
@layout SettingsLayout
@implements IDisposable
@using System.Text.Json
@using CSweet.Contracts.Agents
@using CSweet.Contracts.BusinessOnboarding
@using CSweet.Contracts.Llm
@using CSweet.Contracts.Plugins
@using CSweet.Contracts.Setup
@inject IAgentApiClient AgentApi
@inject ILlmProviderApiClient LlmProviderApi
@inject IAgentRuntimeSettingsApiClient AgentRuntimeSettingsApi
@inject IBusinessOnboardingApiClient BusinessOnboardingApi
@inject ISetupApiClient SetupApi
@inject NavigationManager Navigation

<PageTitle>Agents - C-Sweet</PageTitle>

<div class="setup-shell agents-page">
    <MudPaper Elevation="0" Class="page-header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">Agent management</MudText>
            <MudText Typo="Typo.h3">Agents</MudText>
            <MudText Color="Color.Secondary">Manage imported agent plugins that businesses can use to create agent employees.</MudText>
        </div>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isBusy" OnClick="OpenImportDialog" StartIcon="@Icons.Material.Filled.Add">
                Import Agent
            </MudButton>
            <MudTooltip Text="Refresh agents">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Secondary" Disabled="@(_isBusy || _isLoading)" OnClick="LoadAsync" />
            </MudTooltip>
        </MudStack>
    </MudPaper>

    @if (_usageSummary is not null)
    {
        <section class="usage-summary-grid" aria-label="Agent token usage">
            @UsageCard("Last 24 Hours", _usageSummary.Last24Hours)
            @UsageCard("Last 7 Days", _usageSummary.Last7Days)
            @UsageCard("Last 30 Days", _usageSummary.Last30Days)
        </section>
        @if (_usageSummary.RecentChatTurns.Count > 0)
        {
            <MudPaper Elevation="1" Class="surface-panel mt-4">
                <MudText Typo="Typo.h6">Recent chat-turn inference</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Each row groups every billable model call caused by one user message, including tool follow-ups and memory enrichment.
                </MudText>
                <MudTable T="LlmChatTurnUsageResponse" Items="@_usageSummary.RecentChatTurns.Take(10)" Dense="true" Hover="true" Breakpoint="Breakpoint.Md">
                    <HeaderContent>
                        <MudTh>Started</MudTh>
                        <MudTh>Model calls</MudTh>
                        <MudTh>Purposes</MudTh>
                        <MudTh>Input</MudTh>
                        <MudTh>Output</MudTh>
                        <MudTh>Prompt characters processed</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Started">@context.StartedAt.ToLocalTime().ToString("g")</MudTd>
                        <MudTd DataLabel="Model calls">@context.ModelCallCount (@context.UsageReportedCallCount with usage)</MudTd>
                        <MudTd DataLabel="Purposes">@FormatPurposes(context.CallsByPurpose)</MudTd>
                        <MudTd DataLabel="Input">
                            @FormatTokens(context.InputTokens)
                            @if (context.CachedInputTokens > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatTokens(context.CachedInputTokens) cached</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Output">@FormatTokens(context.OutputTokens)</MudTd>
                        <MudTd DataLabel="Prompt characters processed">
                            Messages @FormatCharacters(context.MessageCharacters) · instructions @FormatCharacters(context.InstructionCharacters) · tools @FormatCharacters(context.ToolCharacters) · memory @FormatCharacters(context.MemoryCharacters)
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }
    }

    @if (_isLoading)
    {
        <MudPaper Elevation="1" Class="surface-panel surface-panel-narrow agents-loading-panel">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Color="Color.Secondary">Loading agents...</MudText>
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <MudPaper Elevation="1" Class="surface-panel surface-panel-narrow">
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_pageError</MudAlert>
            <MudStack Row="true" Class="setup-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">Retry</MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <section class="agent-installations-section" aria-label="Installed agent plugins">
            <div class="configuration-section-header">
                <div>
                    <MudText Typo="Typo.h6">Installed Agent Definitions</MudText>
                    <MudText Color="Color.Secondary">Globally installed agent families and the defaults inherited by every new hire.</MudText>
                </div>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@_installations.Count</MudChip>
            </div>

            @if (!string.IsNullOrWhiteSpace(_installationActionMessage))
            {
                <MudAlert Severity="@(_installationActionSucceeded ? Severity.Success : Severity.Error)" Variant="Variant.Outlined">
                    @_installationActionMessage
                </MudAlert>
            }

            @if (_isCheckingUpdates)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Sync">
                    Checking for agent updates in the background. You can continue using this page.
                </MudAlert>
            }

            @if (AvailableUpdates.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.SystemUpdateAlt">
                    @AvailableUpdates.Count agent @(AvailableUpdates.Count == 1 ? "update is" : "updates are") available.
                </MudAlert>
            }
            else if (!string.IsNullOrWhiteSpace(_updateCheckError))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@_updateCheckError</MudAlert>
            }

            @if (_installations.Count == 0)
            {
                <MudText Color="Color.Secondary">No agent definitions have been installed.</MudText>
            }
            else
            {
                <div class="agent-installations-grid">
                    @foreach (var installation in _installations)
                    {
                        var availableUpdate = UpdateFor(installation.Id);
                        var buildProgress = BuildProgressFor(installation);
                        <MudPaper Elevation="1" Class="agent-installation-card">
                            <div class="configuration-section-header">
                                <div>
                                    <MudText Typo="Typo.subtitle1">@installation.AgentName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@installation.AgentId · global definition</MudText>
                                </div>
                                <MudStack Row="true" Spacing="1" Class="agent-status-chips">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Installed</MudChip>
                                    @if (availableUpdate is not null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">Update @availableUpdate.AvailableVersion</MudChip>
                                    }
                                    @if (installation.Build is not null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="@BuildStatusColor(installation.Build.Status)" Variant="Variant.Filled">@BuildStatusLabel(installation.Build.Status)</MudChip>
                                    }
                                    @if (IsBuildSuccessful(installation.Build?.Status))
                                    {
                                        @if (installation.Schedule.AutomaticStartSuppressedAt is not null)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Startup failed</MudChip>
                                        }
                                        else if (IsRuntimeActive(installation.LatestRuntime?.Status))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">Running</MudChip>
                                        }
                                        else if (installation.IsEnabled && installation.Schedule.IsEnabled)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Scheduled</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">Disabled</MudChip>
                                        }
                                    }
                                </MudStack>
                            </div>
                            <dl class="configuration-details agents-details">
                                <div><dt>Activation</dt><dd>@installation.Schedule.ActivationMode</dd></div>
                                <div><dt>Frequency</dt><dd>@FormatFrequency(installation.Schedule.TickFrequencySeconds)</dd></div>
                                <div><dt>Next tick</dt><dd>@FormatNextTick(installation.Schedule.NextTickAt)</dd></div>
                                <div><dt>Last run</dt><dd>@FormatLastRun(installation.LatestRuntime)</dd></div>
                                <div><dt>Runtime limit</dt><dd>@installation.Schedule.MaxRuntimeSeconds s</dd></div>
                                <div><dt>Memory</dt><dd>@installation.MemoryMb MB</dd></div>
                                <div><dt>CPU</dt><dd>@installation.CpuPercent%</dd></div>
                            </dl>
                            @if (installation.Schedule.AutomaticStartSuppressedAt is not null)
                            {
                                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
                                    <MudText Typo="Typo.subtitle2">Automatic startup stopped after 3 failed attempts.</MudText>
                                    <MudText Typo="Typo.body2">
                                        @(installation.LatestRuntime?.Reason ?? "The agent did not register successfully with the runtime broker.")
                                    </MudText>
                                     @if (!string.IsNullOrWhiteSpace(installation.LatestRuntime?.LogExcerpt))
                                     {
                                        <details class="mt-2">
                                            <summary>Startup log details</summary>
                                             <pre class="agent-build-log">@installation.LatestRuntime.LogExcerpt</pre>
                                         </details>
                                     }
                                     <MudButton Variant="Variant.Filled"
                                                Color="Color.Warning"
                                                StartIcon="@Icons.Material.Filled.Refresh"
                                                Class="mt-3"
                                                Disabled="@_isManagingInstallation"
                                                OnClick="@(() => RetryStartupAsync(installation))">
                                         Try startup again
                                     </MudButton>
                                 </MudAlert>
                             }
                            @if (buildProgress is not null)
                            {
                                <MudAlert Severity="@buildProgress.Severity" Variant="Variant.Outlined" Class="mb-3">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.subtitle2">@buildProgress.Title</MudText>
                                        <MudText Typo="Typo.body2">@buildProgress.Detail</MudText>
                                        @if (!buildProgress.IsTerminal)
                                        {
                                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                                        }
                                    </MudStack>
                                </MudAlert>
                            }
                            @if (ShouldShowBuildSteps(installation, buildProgress) &&
                                 installation.Build?.Steps is { Count: > 0 } buildSteps)
                            {
                                <div class="agent-build-steps" aria-label="Build progress">
                                    @foreach (var step in buildSteps)
                                    {
                                        <div class="agent-build-step agent-build-step-@step.Status.ToLowerInvariant()">
                                            <div class="agent-build-step-indicator">
                                                @if (step.Status == "InProgress")
                                                {
                                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@BuildStepIcon(step.Status)" Color="@BuildStepColor(step.Status)" Size="Size.Small" />
                                                }
                                            </div>
                                            <div class="agent-build-step-content">
                                                <MudText Typo="Typo.subtitle2">@step.Label</MudText>
                                                @if (!string.IsNullOrWhiteSpace(step.Detail))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@step.Detail</MudText>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(step.Error))
                                                {
                                                    <pre class="agent-build-step-error">@step.Error</pre>
                                                    @if (installation.Build.HasLog)
                                                    {
                                                        <MudButton Variant="Variant.Text"
                                                                   Color="Color.Error"
                                                                   Size="Size.Small"
                                                                   StartIcon="@Icons.Material.Filled.Description"
                                                                   OnClick="@(() => OpenBuildLogDialogAsync(installation))">
                                                            View full build log
                                                        </MudButton>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            <MudStack Row="true" Class="setup-actions">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Settings" Disabled="@_isBusy" OnClick="@(() => SelectAgentAsync(installation))">
                                    Configure global defaults
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    }
                </div>
            }
        </section>

        <MudDialog @bind-Visible="_configurationDialogOpen" Options="_configurationDialogOptions">
            <TitleContent>
                <MudText Typo="Typo.h6">Configure agent</MudText>
            </TitleContent>
            <DialogContent>
                @if (_selectedAgent is null)
                {
                    <div class="agents-empty-editor">
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Select an agent</MudText>
                        <MudText Color="Color.Secondary">Configuration fields come from the signed package manifest and can be edited while all agent runtimes are stopped.</MudText>
                    </div>
                }
                else
                {
                    <div class="configuration-section-header">
                        <div>
                            <MudText Typo="Typo.h6">@_selectedAgent.AgentName</MudText>
                            <MudText Color="Color.Secondary">@_selectedAgent.AgentId · global defaults</MudText>
                        </div>
                        <MudChip T="string" Color="@SchemaChipColor" Variant="Variant.Filled">@SchemaChipLabel</MudChip>
                    </div>

                    <dl class="configuration-details agents-details">
                        <div>
                            <dt>Publisher</dt>
                            <dd>@_selectedAgent.PublisherName</dd>
                        </div>
                        <div>
                            <dt>Version</dt>
                            <dd>@_selectedAgent.AgentVersion</dd>
                        </div>
                        <div>
                            <dt>Capabilities</dt>
                            <dd>@_selectedAgent.GrantedCapabilities.Count</dd>
                        </div>
                        <div>
                            <dt>Permissions</dt>
                            <dd>@_selectedAgent.GrantedPermissions.Count</dd>
                        </div>
                        <div>
                            <dt>30d input</dt>
                            <dd>@FormatTokens(SelectedAgentUsage?.Usage.InputTokens ?? 0)</dd>
                        </div>
                        <div>
                            <dt>30d output</dt>
                            <dd>@FormatTokens(SelectedAgentUsage?.Usage.OutputTokens ?? 0)</dd>
                        </div>
                        <div>
                            <dt>30d requests</dt>
                            <dd>@((SelectedAgentUsage?.Usage.RequestCount ?? 0).ToString("N0"))</dd>
                        </div>
                    </dl>

                    @if (_isLoadingConfiguration)
                    {
                        <div class="agents-loading-panel mt-4">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                            <MudText Color="Color.Secondary">Loading the signed configuration schema...</MudText>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_configurationError))
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-4">@_configurationError</MudAlert>
                        <MudStack Row="true" Class="setup-actions">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@_isBusy" OnClick="@(() => LoadConfigurationAsync(_selectedAgent))">
                                Try again
                            </MudButton>
                        </MudStack>
                    }
                    else if (_schema is not null)
                    {
                        <MudText Color="Color.Secondary" Class="mt-4">Schema @_schema.SchemaVersion from the signed package manifest.</MudText>

                        <div class="agent-config-form">
                            @foreach (var field in _schema.Fields)
                            {
                                <div class="agent-config-field">
                                    @switch (field.Type)
                                    {
                                        case AgentConfigurationFieldTypes.Boolean:
                                            <MudCheckBox T="bool"
                                                         Label="@field.Label"
                                                         Value="@GetBooleanValue(field.Key)"
                                                         ValueChanged="@((bool value) => SetFormValue(field.Key, value))" />
                                            break;

                                        case AgentConfigurationFieldTypes.Number:
                                            <MudNumericField T="decimal?"
                                                             Label="@field.Label"
                                                             Value="@GetNumberValue(field.Key)"
                                                             ValueChanged="@((decimal? value) => SetFormValue(field.Key, value))"
                                                             Min="@field.Minimum"
                                                             Max="@field.Maximum"
                                                             Step="@(field.Step ?? 1)"
                                                             Variant="Variant.Outlined" />
                                            break;

                                        case AgentConfigurationFieldTypes.Select:
                                            <MudSelect T="string"
                                                       Label="@field.Label"
                                                       Value="@GetStringValue(field.Key)"
                                                       ValueChanged="@((string value) => SetFormValue(field.Key, value))"
                                                       Variant="Variant.Outlined">
                                                @foreach (var option in field.Options ?? [])
                                                {
                                                    <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                                                }
                                            </MudSelect>
                                            break;

                                        case AgentConfigurationFieldTypes.LlmProvider:
                                            <MudSelect T="string"
                                                       Label="@field.Label"
                                                       Value="@GetStringValue(field.Key)"
                                                       ValueChanged="@((string value) => SetProviderValueAsync(field.Key, value))"
                                                       Variant="Variant.Outlined">
                                                <MudSelectItem T="string" Value="@string.Empty">Select a provider</MudSelectItem>
                                                @foreach (var profile in _providerProfiles.Where(profile => profile.IsEnabled))
                                                {
                                                    <MudSelectItem T="string" Value="@profile.Id.ToString()">@profile.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                            @if (!string.IsNullOrWhiteSpace(ModelCatalogError(field)))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Error">@ModelCatalogError(field)</MudText>
                                            }
                                            break;

                                        case AgentConfigurationFieldTypes.LlmModel:
                                            <MudSelect T="string"
                                                       Label="@field.Label"
                                                       Value="@GetStringValue(field.Key)"
                                                       ValueChanged="@((string value) => SetFormValue(field.Key, value))"
                                                       Disabled="@IsModelPickerDisabled(field)"
                                                       Variant="Variant.Outlined">
                                                <MudSelectItem T="string" Value="@string.Empty">@ModelPlaceholder(field)</MudSelectItem>
                                                @if (SelectedModelMissing(field))
                                                {
                                                    <MudSelectItem T="string" Value="@GetStringValue(field.Key)">@GetStringValue(field.Key)</MudSelectItem>
                                                }
                                                @foreach (var model in ModelOptions(field))
                                                {
                                                    <MudSelectItem T="string" Value="@model">@model</MudSelectItem>
                                                }
                                            </MudSelect>
                                            break;

                                        case AgentConfigurationFieldTypes.Secret:
                                            <MudTextField Label="@field.Label"
                                                          Value="@GetStringValue(field.Key)"
                                                          ValueChanged="@((string value) => SetFormValue(field.Key, value))"
                                                          InputType="InputType.Password"
                                                          autocomplete="off"
                                                          Placeholder="@field.Placeholder"
                                                          Variant="Variant.Outlined" />
                                            break;

                                        case AgentConfigurationFieldTypes.TextArea:
                                            <MudTextField Label="@field.Label"
                                                          Value="@GetStringValue(field.Key)"
                                                          ValueChanged="@((string value) => SetFormValue(field.Key, value))"
                                                          Lines="4"
                                                          Placeholder="@field.Placeholder"
                                                          Variant="Variant.Outlined" />
                                            break;

                                        default:
                                            <MudTextField Label="@field.Label"
                                                          Value="@GetStringValue(field.Key)"
                                                          ValueChanged="@((string value) => SetFormValue(field.Key, value))"
                                                          Placeholder="@field.Placeholder"
                                                          Variant="Variant.Outlined" />
                                            break;
                                    }

                                    @if (!string.IsNullOrWhiteSpace(field.Description))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@field.Description</MudText>
                                    }
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_actionMessage))
                        {
                            <MudAlert Severity="@ActionMessageSeverity" Variant="Variant.Outlined" Class="mt-4">@_actionMessage</MudAlert>
                        }

                        <MudStack Row="true" Class="setup-actions">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@_isBusy"
                                       OnClick="SaveConfigurationAsync">
                                @(_isBusy ? "Saving..." : "Save Settings")
                            </MudButton>
                        </MudStack>
                    }
                }
            </DialogContent>
            <DialogActions>
                <MudButton Variant="Variant.Text" Disabled="@_isBusy" OnClick="CloseConfigurationDialog">Close</MudButton>
            </DialogActions>
        </MudDialog>
    }
</div>

<MudDialog @bind-Visible="_importDialogOpen" Options="_importDialogOptions">
    <TitleContent>
        <div class="agent-import-title">
            <MudIcon Icon="@Icons.Material.Filled.AddToQueue" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6">Import agent</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(_importPreview is null ? "Connect a public GitHub repository" : "Review identity, access, and deployment")
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="agent-import-dialog-content">
            @if (!string.IsNullOrWhiteSpace(_importError))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true">@_importError</MudAlert>
            }

            @if (_importPreview is null)
            {
                <div class="agent-import-source-card">
                    <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Primary" Class="agent-import-source-icon" />
                    <MudText Typo="Typo.h6">Connect a repository</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        C-Sweet reads the root manifest first. Repository code is not executed during preview.
                    </MudText>
                    <MudTextField Label="Public GitHub repository URL"
                                  @bind-Value="_importRepositoryUrl"
                                  Placeholder="https://github.com/owner/repository"
                                  Variant="Variant.Outlined"
                                  Disabled="@_isPreviewingImport"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Link" />
                    <MudTextField Label="Branch, tag, or commit"
                                  @bind-Value="_importRef"
                                  Placeholder="Optional — uses the default branch"
                                  Variant="Variant.Outlined"
                                  Disabled="@_isPreviewingImport" />
                </div>
            }
            else
            {
                <div class="agent-import-hero">
                    <div class="agent-import-avatar"><MudIcon Icon="@Icons.Material.Filled.SmartToy" /></div>
                    <div class="agent-import-identity">
                        <MudText Typo="Typo.h5">@_importPreview.AgentName</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@_importPreview.AgentId · v@_importPreview.AgentVersion</MudText>
                    </div>
                    <div class="agent-import-status-chips">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@_importPreview.RuntimeType</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@DisplayImportValue(_importPreview.DefaultActivationMode)</MudChip>
                        @if (_importPreview.ConfigurationFields.Any(field => !field.Secret))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                @ImportConfigurationFieldCount agent setting@(ImportConfigurationFieldCount == 1 ? string.Empty : "s")
                            </MudChip>
                        }
                    </div>
                </div>

                @if (IsImportInstallBlocked)
                {
                    <div class="agent-import-prerequisite">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Warning" />
                        <div>
                            <MudText Typo="Typo.subtitle2">Runtime approval required</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@ImportBlockerMessage</MudText>
                        </div>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   Disabled="@_isEnablingImport"
                                   OnClick="EnableImportPrerequisitesAsync">
                            @(_isEnablingImport ? "Enabling…" : "Enable required settings")
                        </MudButton>
                    </div>
                }

                <MudTabs @bind-ActivePanelIndex="_importTabIndex" Rounded="true" ApplyEffectsToContainer="true" Class="agent-import-tabs">
                    <MudTabPanel Text="Overview" Icon="@Icons.Material.Filled.Badge">
                        <div class="agent-import-tab-content">
                            <div class="agent-import-facts">
                                <div><span>Publisher</span><strong>@_importPreview.PublisherName</strong><small>@_importPreview.PublisherId</small></div>
                                <div><span>Framework</span><strong>@DisplayImportValue(_importPreview.TargetFramework)</strong><small>@_importPreview.RuntimeType</small></div>
                                <div><span>Capabilities</span><strong>@_importPreview.Capabilities.Count</strong><small>declared services</small></div>
                                <div><span>Access requests</span><strong>@ImportAccessRequestCount</strong><small>review before install</small></div>
                            </div>

                            @if (_importPreview.Warnings.Count > 0)
                            {
                                @foreach (var warning in _importPreview.Warnings)
                                {
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">@warning.Message</MudAlert>
                                }
                            }

                            <MudExpansionPanels>
                                <MudExpansionPanel Text="Technical details">
                                    <dl class="agent-import-technical-details">
                                        <div><dt>Project</dt><dd>@DisplayImportValue(_importPreview.ProjectPath)</dd></div>
                                        <div><dt>Commit</dt><dd class="agent-import-hash">@_importPreview.CommitSha</dd></div>
                                        <div><dt>Manifest digest</dt><dd class="agent-import-hash">@_importPreview.ManifestDigest</dd></div>
                                    </dl>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="Access review" Icon="@Icons.Material.Filled.Security">
                        <div class="agent-import-tab-content agent-import-access-grid">
                            @ApprovalSection("Capabilities", _importPreview.Capabilities, _approvedCapabilities)
                            @ApprovalSection("Platform access", _importPreview.RequestedCapabilities, _approvedRequestedCapabilities)
                            @ApprovalSection("Subscriptions", _importPreview.RequestedSubscriptions, _approvedSubscriptions)
                            @ApprovalSection("Publications", _importPreview.RequestedPublications, _approvedPublications)
                            @ApprovalSection("Permissions", _importPreview.RequestedPermissions, _approvedPermissions)
                            @ApprovalSection("Network access", _importPreview.RequestedNetworkAccess, _approvedNetworkAccess)
                        </div>
                    </MudTabPanel>
                    @if (_importPreview.ConfigurationFields.Any(field => !field.Secret))
                    {
                        <MudTabPanel Text="Agent settings" Icon="@Icons.Material.Filled.Settings">
                            <div class="agent-import-tab-content">
                                <div>
                                    <MudText Typo="Typo.subtitle2">Configure @_importPreview.AgentName</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Choose the model provider and other settings declared by this agent before installation.
                                    </MudText>
                                </div>
                                <div class="agent-import-form-grid">
                                    @foreach (var field in _importPreview.ConfigurationFields.Where(field => !field.Secret))
                                    {
                                        <div class="agent-configuration-field">
                                            @if (IsImportProviderField(field))
                                            {
                                                <MudSelect T="string" Label="@ImportFieldLabel(field)" Value="@ImportConfigurationString(field.Key)"
                                                           ValueChanged="@(value => SetImportProviderAsync(field.Key, value))"
                                                           Variant="Variant.Outlined" Disabled="@_isInstallingImport">
                                                    @foreach (var provider in _providerProfiles.Where(provider => provider.IsEnabled))
                                                    {
                                                        <MudSelectItem T="string" Value="@provider.Id.ToString()">@provider.Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            }
                                            else if (IsImportModelField(field))
                                            {
                                                <MudSelect T="string" Label="@ImportFieldLabel(field)" Value="@ImportConfigurationString(field.Key)"
                                                           ValueChanged="@(value => SetImportConfiguration(field.Key, value))"
                                                           Variant="Variant.Outlined"
                                                           Disabled="@(_isInstallingImport || ImportModelProvider() is null || _loadingProviderModels.Contains(ImportModelProvider()!.Id))">
                                                    @foreach (var model in ImportModelOptions())
                                                    {
                                                        <MudSelectItem T="string" Value="@model">@model</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            }
                                            else if (field.Type.Equals(AgentConfigurationFieldTypes.Boolean, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <MudCheckBox T="bool" Label="@ImportFieldLabel(field)" Value="@ImportConfigurationBoolean(field.Key)"
                                                             ValueChanged="@(value => SetImportConfiguration(field.Key, value))"
                                                             Disabled="@_isInstallingImport" />
                                            }
                                            else if (field.Type.Equals(AgentConfigurationFieldTypes.Number, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <MudNumericField T="decimal?" Label="@ImportFieldLabel(field)" Value="@ImportConfigurationNumber(field.Key)"
                                                                 ValueChanged="@(value => SetImportConfiguration(field.Key, value))"
                                                                 Variant="Variant.Outlined" Disabled="@_isInstallingImport" />
                                            }
                                            else if (field.Type.Equals(AgentConfigurationFieldTypes.Select, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <MudSelect T="string" Label="@ImportFieldLabel(field)" Value="@ImportConfigurationString(field.Key)"
                                                           ValueChanged="@(value => SetImportConfiguration(field.Key, value))"
                                                           Variant="Variant.Outlined" Disabled="@_isInstallingImport">
                                                    @foreach (var option in field.Options ?? [])
                                                    {
                                                        <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            }
                                            else
                                            {
                                                <MudTextField T="string" Label="@ImportFieldLabel(field)" Value="@ImportConfigurationString(field.Key)"
                                                              ValueChanged="@(value => SetImportConfiguration(field.Key, value))"
                                                              Variant="Variant.Outlined" Disabled="@_isInstallingImport" />
                                            }
                                            @if (!string.IsNullOrWhiteSpace(field.Description))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@field.Description</MudText>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (HasMissingRequiredImportConfiguration)
                                {
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                        Complete all required agent settings before installation.
                                    </MudAlert>
                                }
                            </div>
                        </MudTabPanel>
                    }
                    <MudTabPanel Text="Deployment" Icon="@Icons.Material.Filled.Tune">
                        <div class="agent-import-tab-content">
                            <MudText Typo="Typo.subtitle2">Defaults for new hires</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">These values do not create or start a runtime. Each business receives them when the agent is hired.</MudText>
                            <div class="agent-import-form-grid">
                                <MudSelect T="string" Label="Activation mode" @bind-Value="_installActivationMode" Variant="Variant.Outlined" Disabled="@_isInstallingImport">
                                    <MudSelectItem T="string" Value="@("AlwaysOn")">Always On</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("OnDemand")">On demand</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Scheduled")">Scheduled</MudSelectItem>
                                </MudSelect>
                                <MudNumericField T="int" Label="Tick frequency (seconds)" @bind-Value="_installTickFrequencySeconds" Min="@(_runtimeSettings?.MinimumTickFrequencySeconds ?? 60)" Variant="Variant.Outlined" Disabled="@_isInstallingImport" />
                                <MudSelect T="string" Label="Overlap policy" @bind-Value="_installOverlapPolicy" Variant="Variant.Outlined" Disabled="@_isInstallingImport">
                                    <MudSelectItem T="string" Value="@("Skip")">Skip</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Queue")">Queue</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("CancelPrevious")">Cancel previous</MudSelectItem>
                                </MudSelect>
                            </div>
                            <MudText Typo="Typo.subtitle2" Class="mt-3">Resource limits</MudText>
                            <div class="agent-import-form-grid agent-import-form-grid-three">
                                <MudNumericField T="int" Label="Max runtime (seconds)" @bind-Value="_installMaxRuntimeSeconds" Min="1" Max="@(_runtimeSettings?.DefaultMaxRuntimeSeconds ?? int.MaxValue)" Variant="Variant.Outlined" Disabled="@_isInstallingImport" />
                                <MudNumericField T="int" Label="Memory (MB)" @bind-Value="_installMemoryMb" Min="1" Max="@(_runtimeSettings?.MaximumWorkloadMemoryMb ?? int.MaxValue)" Variant="Variant.Outlined" Disabled="@_isInstallingImport" />
                                <MudNumericField T="int" Label="CPU (%)" @bind-Value="_installCpuPercent" Min="1" Max="@(_runtimeSettings?.MaximumWorkloadCpuPercent ?? int.MaxValue)" Variant="Variant.Outlined" Disabled="@_isInstallingImport" />
                            </div>
                        </div>
                    </MudTabPanel>
                </MudTabs>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="@(_isPreviewingImport || _isInstallingImport)" OnClick="CloseImportDialog">
            Close
        </MudButton>
        @if (_importPreview is null)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(_isPreviewingImport || string.IsNullOrWhiteSpace(_importRepositoryUrl))"
                       OnClick="PreviewImportAsync">
                @(_isPreviewingImport ? "Previewing..." : "Preview Manifest")
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="@_isInstallingImport" OnClick="ResetImportPreview">
                Back
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_isInstallingImport || IsImportInstallBlocked)" OnClick="InstallImportAsync" StartIcon="@Icons.Material.Filled.VerifiedUser">
                @(_isInstallingImport ? "Installing..." : "Approve and Install")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_scheduleDialogOpen" Options="_scheduleDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Schedule</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Color="Color.Secondary">@_scheduleInstallation?.AgentName</MudText>
            <MudSelect T="string" Label="Activation mode" @bind-Value="_scheduleActivationMode" Variant="Variant.Outlined" Disabled="@_isManagingInstallation">
                <MudSelectItem T="string" Value="@("AlwaysOn")">Always On</MudSelectItem>
                <MudSelectItem T="string" Value="@("OnDemand")">On demand</MudSelectItem>
                <MudSelectItem T="string" Value="@("Scheduled")">Scheduled</MudSelectItem>
            </MudSelect>
            <MudNumericField T="int" Label="Tick frequency (seconds)" @bind-Value="_scheduleTickFrequencySeconds" Min="@(_runtimeSettings?.MinimumTickFrequencySeconds ?? 60)" Variant="Variant.Outlined" Disabled="@_isManagingInstallation" />
            <MudSelect T="string" Label="Overlap policy" @bind-Value="_scheduleOverlapPolicy" Variant="Variant.Outlined" Disabled="@_isManagingInstallation">
                <MudSelectItem T="string" Value="@("Skip")">Skip</MudSelectItem>
                <MudSelectItem T="string" Value="@("Queue")">Queue</MudSelectItem>
                <MudSelectItem T="string" Value="@("CancelPrevious")">Cancel Previous</MudSelectItem>
            </MudSelect>
            <MudNumericField T="int" Label="Max runtime (seconds)" @bind-Value="_scheduleMaxRuntimeSeconds" Min="1" Max="@(_runtimeSettings?.DefaultMaxRuntimeSeconds ?? int.MaxValue)" Variant="Variant.Outlined" Disabled="@_isManagingInstallation" />
            <MudCheckBox T="bool" Label="Schedule enabled" @bind-Value="_scheduleEnabled" Disabled="@_isManagingInstallation" />
