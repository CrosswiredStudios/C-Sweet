            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_scheduleError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="@_isManagingInstallation" OnClick="CloseScheduleDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isManagingInstallation" OnClick="SaveScheduleAsync">
            @(_isManagingInstallation ? "Saving..." : "Save Schedule")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_runsDialogOpen" Options="_managementDialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Runtime History · @_runsInstallation?.AgentName</MudText></TitleContent>
    <DialogContent>
        @if (_isLoadingManagementDetail)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
        else if (!string.IsNullOrWhiteSpace(_managementDetailError))
        {
            <MudAlert Severity="Severity.Error">@_managementDetailError</MudAlert>
        }
        else if (_runtimeRuns.Count == 0)
        {
            <MudText Color="Color.Secondary">No runtime instances have been recorded.</MudText>
        }
        else
        {
            <MudExpansionPanels>
                @foreach (var run in _runtimeRuns)
                {
                    <MudExpansionPanel Text="@($"{run.Status} · {run.QueuedAt.ToLocalTime():g}")">
                        <dl class="configuration-details agents-details">
                            <div><dt>Tick</dt><dd>@run.TickId</dd></div>
                            <div><dt>Started</dt><dd>@FormatTimestamp(run.StartedAt)</dd></div>
                            <div><dt>Completed</dt><dd>@FormatTimestamp(run.CompletedAt)</dd></div>
                            <div><dt>Result</dt><dd>@(run.Reason ?? run.Status)</dd></div>
                        </dl>
                        @foreach (var runtimeEvent in run.Events)
                        {
                            <MudText Typo="Typo.caption"><strong>@runtimeEvent.Status</strong> · @runtimeEvent.OccurredAt.ToLocalTime().ToString("g") · @(runtimeEvent.Reason ?? "No detail")</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(run.LogExcerpt))
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-3">Container log excerpt</MudText>
                            <pre class="agent-build-log">@run.LogExcerpt</pre>
                        }
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </DialogContent>
    <DialogActions><MudButton Variant="Variant.Text" OnClick="CloseRunsDialog">Close</MudButton></DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_buildLogDialogOpen" Options="_managementDialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Build Log · @_buildLogInstallation?.AgentName</MudText></TitleContent>
    <DialogContent>
        @if (_isLoadingManagementDetail)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
        else if (!string.IsNullOrWhiteSpace(_managementDetailError))
        {
            <MudAlert Severity="Severity.Error">@_managementDetailError</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">Status: @_buildLog?.Status @(_buildLog?.IsTruncated == true ? "· truncated" : string.Empty)</MudText>
            <pre class="agent-build-log">@(_buildLog?.Content ?? "No build output was retained.")</pre>
        }
    </DialogContent>
    <DialogActions><MudButton Variant="Variant.Text" OnClick="CloseBuildLogDialog">Close</MudButton></DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_removeDialogOpen" Options="_removeDialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Error" />
            <MudText Typo="Typo.h6">Remove imported agent?</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText>
                This permanently removes <strong>@_removeInstallation?.AgentName</strong> from
                <strong>@_removeInstallation?.BusinessId</strong>.
            </MudText>
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                Grants, schedule, run history, isolated workloads, and cached build artifacts that are not shared by another installation will be deleted. You will need to import and approve the agent again.
            </MudAlert>
            @if (!string.IsNullOrWhiteSpace(_removeError))
            {
                <MudAlert Severity="Severity.Error">@_removeError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="@_isManagingInstallation" OnClick="CloseRemoveDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" Disabled="@_isManagingInstallation" OnClick="RemoveInstallationAsync">
            @(_isManagingInstallation ? "Removing…" : "Remove agent")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_updateDialogOpen" Options="_updateDialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.SystemUpdateAlt" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Update imported agent?</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText>
                Update <strong>@_updateInstallation?.AgentName</strong> for
                <strong>@_updateInstallation?.BusinessId</strong> from
                <strong>@_selectedUpdate?.CurrentVersion</strong> to
                <strong>@_selectedUpdate?.AvailableVersion</strong>?
            </MudText>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                The new GitHub commit will be built before it runs. Schedule and configuration are preserved. Grants removed from the new manifest are revoked automatically; newly requested access remains denied.
            </MudAlert>
            @if (_isManagingInstallation)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Stopping the current runtime and queuing the new package...</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(_updateError))
            {
                <MudAlert Severity="Severity.Error">@_updateError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="@_isManagingInstallation" OnClick="CloseUpdateDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SystemUpdateAlt" Disabled="@_isManagingInstallation" OnClick="UpdateInstallationAsync">
            @(_isManagingInstallation ? "Updating..." : "Confirm update")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly JsonSerializerOptions SerializerOptions = new(JsonSerializerDefaults.Web);

    [Parameter, SupplyParameterFromQuery(Name = "businessId")]
    public Guid? ChiefSetupBusinessId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "setup")]
    public string? SetupMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "repositoryUrl")]
    public string? SuggestedRepositoryUrl { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "queueInstall")]
    public bool QueueInstall { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool IsChiefSetup => ChiefSetupBusinessId.HasValue && string.Equals(SetupMode, "chief-of-staff", StringComparison.OrdinalIgnoreCase);

    private bool CanAssignToChiefSetup(AgentInstallationResponse installation) =>
        ChiefSetupBusinessId.HasValue &&
        (string.Equals(installation.BusinessId, "default", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(installation.BusinessId, ChiefSetupBusinessId.Value.ToString("D"), StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<AgentInstallationResponse> _installations = [];
    private IReadOnlyList<AgentUpdateAvailabilityResponse> _updates = [];
    private IReadOnlyList<LlmProviderProfileResponse> _providerProfiles = [];
    private readonly Dictionary<Guid, IReadOnlyList<string>> _providerModels = [];
    private readonly HashSet<Guid> _loadingProviderModels = [];
    private readonly Dictionary<Guid, string> _providerModelErrors = [];
    private AgentRuntimeSettingsResponse? _runtimeSettings;
    private LlmTokenUsageSummaryResponse? _usageSummary;
    private AgentInstallationResponse? _selectedAgent;
    private AgentConfigurationSchemaResponse? _schema;
    private AgentConfigurationView? _configurationView;
    private readonly Dictionary<string, object?> _formValues = new(StringComparer.Ordinal);
    private bool _isLoading = true;
    private bool _isLoadingConfiguration;
    private bool _isBusy;
    private bool _isManagingInstallation;
    private bool _isSecureRuntimeReady;
    private bool _isCheckingUpdates;
    private string? _pageError;
    private string? _installationActionMessage;
    private bool _installationActionSucceeded;
    private string? _updateCheckError;
    private string? _configurationError;
    private string? _actionMessage;
    private bool? _actionSucceeded;
    private readonly DialogOptions _importDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };
    private readonly DialogOptions _configurationDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private bool _configurationDialogOpen;
    private bool _importDialogOpen;
    private bool _isPreviewingImport;
    private bool _isInstallingImport;
    private bool _isEnablingImport;
    private string _importRepositoryUrl = string.Empty;
    private string _importRef = string.Empty;
    private string? _importError;
    private AgentImportPreviewResponse? _importPreview;
    private int _importTabIndex;
    private string _installBusinessId = "default";
    private string _installActivationMode = "OnDemand";
    private int _installTickFrequencySeconds = 3600;
    private string _installOverlapPolicy = "Skip";
    private int _installMaxRuntimeSeconds = 600;
    private int _installMemoryMb = 1024;
    private int _installCpuPercent = 50;
    private readonly HashSet<string> _approvedCapabilities = new(StringComparer.Ordinal);
    private readonly HashSet<string> _approvedRequestedCapabilities = new(StringComparer.Ordinal);
    private readonly HashSet<string> _approvedSubscriptions = new(StringComparer.Ordinal);
    private readonly HashSet<string> _approvedPublications = new(StringComparer.Ordinal);
    private readonly HashSet<string> _approvedPermissions = new(StringComparer.Ordinal);
    private readonly HashSet<string> _approvedNetworkAccess = new(StringComparer.Ordinal);
    private readonly Dictionary<string, object?> _importConfigurationValues = new(StringComparer.Ordinal);
    private readonly DialogOptions _scheduleDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    private bool _scheduleDialogOpen;
    private AgentInstallationResponse? _scheduleInstallation;
    private string _scheduleActivationMode = "OnDemand";
    private int _scheduleTickFrequencySeconds = 3600;
    private string _scheduleOverlapPolicy = "Skip";
    private int _scheduleMaxRuntimeSeconds = 600;
    private bool _scheduleEnabled = true;
    private string? _scheduleError;
    private readonly DialogOptions _managementDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };
    private bool _runsDialogOpen;
    private AgentInstallationResponse? _runsInstallation;
    private IReadOnlyList<AgentRuntimeRunResponse> _runtimeRuns = [];
    private bool _buildLogDialogOpen;
    private AgentInstallationResponse? _buildLogInstallation;
    private AgentBuildLogResponse? _buildLog;
    private bool _isLoadingManagementDetail;
    private string? _managementDetailError;
    private readonly DialogOptions _removeDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = false };
    private bool _removeDialogOpen;
    private AgentInstallationResponse? _removeInstallation;
    private string? _removeError;
    private readonly DialogOptions _updateDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = false };
    private bool _updateDialogOpen;
    private AgentInstallationResponse? _updateInstallation;
    private AgentUpdateAvailabilityResponse? _selectedUpdate;
    private string? _updateError;
    private readonly CancellationTokenSource _disposeCts = new();
    private Task? _updateCheckTask;
    private CancellationTokenSource? _configurationCts;
    private readonly Dictionary<Guid, AgentBuildProgress> _buildProgress = [];
    private readonly HashSet<Guid> _trackedDefinitionBuilds = [];

    private string SchemaChipLabel => _schema is null ? "Unavailable" : "Control plane";
    private Color SchemaChipColor => _schema is null ? Color.Warning : Color.Success;
    private Severity ActionMessageSeverity => _actionSucceeded == false ? Severity.Error : Severity.Success;
    private bool IsImportInstallBlocked =>
        _importPreview is not null &&
        (_runtimeSettings?.EnableImportedAgents != true ||
         HasMissingRequiredImportConfiguration);
    private bool HasMissingRequiredImportConfiguration =>
        _importPreview?.ConfigurationFields
            .Where(configField => configField.Required && !configField.Secret)
            .Any(configField => !HasImportConfigurationValue(configField)) == true;
    private int ImportConfigurationFieldCount =>
        _importPreview?.ConfigurationFields.Count(configField => !configField.Secret) ?? 0;
    private string ImportBlockerMessage => HasMissingRequiredImportConfiguration
        ? "Complete the required values on the Agent settings tab before installing."
        : _runtimeSettings is null
            ? "Runtime settings are unavailable. Refresh the page before installing."
            : "Imported agents are disabled in global runtime settings.";
    private int ImportAccessRequestCount => _importPreview is null
        ? 0
        : _importPreview.RequestedCapabilities.Count +
          _importPreview.RequestedSubscriptions.Count +
          _importPreview.RequestedPublications.Count +
          _importPreview.RequestedPermissions.Count +
          _importPreview.RequestedNetworkAccess.Count;
    private AgentTokenUsageResponse? SelectedAgentUsage =>
        _selectedAgent is null ? null : AgentUsage(_selectedAgent.AgentId);
    private IReadOnlyList<AgentUpdateAvailabilityResponse> AvailableUpdates =>
        _updates.Where(update => update.UpdateAvailable).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (!string.IsNullOrWhiteSpace(SuggestedRepositoryUrl))
        {
            OpenImportDialog();
            _importRepositoryUrl = SuggestedRepositoryUrl;
            if (QueueInstall)
            {
                await InvokeAsync(StateHasChanged);
                await PreviewImportAsync();
            }
        }
    }

    private async Task AssignAsChiefAsync(AgentInstallationResponse installation)
    {
        if (!ChiefSetupBusinessId.HasValue) return;
        _isManagingInstallation = true;
        _installationActionMessage = null;
        try
        {
            var result = await BusinessOnboardingApi.AssignChiefAsync(
                ChiefSetupBusinessId.Value, new CompleteChiefSetupRequest(installation.Id));
            _installationActionSucceeded = true;
            _installationActionMessage = result.ReadinessWarnings.Count == 0
                ? "Chief of Staff assigned. Opening the command center..."
                : $"Chief assigned with {result.ReadinessWarnings.Count} readiness warning(s). Opening the command center...";
            Navigation.NavigateTo(result.NextRoute);
        }
        catch (Exception exception)
        {
            _installationActionSucceeded = false;
            _installationActionMessage = exception.Message;
        }
        finally
        {
            _isManagingInstallation = false;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _pageError = null;
        var loaded = false;

        try
        {
            var installationsTask = AgentApi.ListDefinitionsAsync();
            var providersTask = LlmProviderApi.ListAsync();
            var usageTask = LlmProviderApi.GetUsageSummaryAsync();
            var runtimeSettingsTask = AgentRuntimeSettingsApi.GetAsync();
            var isolationReadyTask = GetIsolationReadinessAsync();

            await Task.WhenAll(installationsTask, providersTask, usageTask, runtimeSettingsTask, isolationReadyTask);

            _installations = (await installationsTask)
                .OrderByDescending(installation => installation.CreatedAt)
                .ToList();
            _providerProfiles = await providersTask;
            _usageSummary = await usageTask;
            _runtimeSettings = await runtimeSettingsTask;
            _isSecureRuntimeReady = await isolationReadyTask;
            if (_selectedAgent is not null)
            {
                _selectedAgent = _installations.FirstOrDefault(agent => agent.Id == _selectedAgent.Id);
            }
            loaded = true;
        }
        catch
        {
            _pageError = "Unable to load agents from the API.";
        }
        finally
        {
            _isLoading = false;
        }

        if (loaded)
        {
            _updates = [];
            ResumeDefinitionBuildTracking();
        }
    }

