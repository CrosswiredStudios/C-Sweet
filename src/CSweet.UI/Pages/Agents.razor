    private async Task InitializeImportApprovalAsync(AgentImportPreviewResponse preview)
    {
        _importTabIndex = preview.ConfigurationFields.Any(field => !field.Secret) ? 2 : 0;
        _installBusinessId = "default";
        _installActivationMode = preview.DefaultActivationMode ?? _runtimeSettings?.DefaultActivationMode ?? "OnDemand";
        _installTickFrequencySeconds = _runtimeSettings?.DefaultTickFrequencySeconds ?? 3600;
        _installOverlapPolicy = _runtimeSettings?.DefaultOverlapPolicy ?? "Skip";
        _installMaxRuntimeSeconds = _runtimeSettings?.DefaultMaxRuntimeSeconds ?? 600;
        _installMemoryMb = _runtimeSettings?.DefaultWorkloadMemoryMb ?? 1024;
        _installCpuPercent = _runtimeSettings?.DefaultWorkloadCpuPercent ?? 50;
        ReplaceApproval(_approvedCapabilities, preview.Capabilities);
        ReplaceApproval(_approvedRequestedCapabilities, preview.RequestedCapabilities);
        ReplaceApproval(_approvedSubscriptions, preview.RequestedSubscriptions);
        ReplaceApproval(_approvedPublications, preview.RequestedPublications);
        ReplaceApproval(_approvedPermissions, preview.RequestedPermissions);
        ReplaceApproval(_approvedNetworkAccess, preview.RequestedNetworkAccess);
        _importConfigurationValues.Clear();
        var provider = _providerProfiles.FirstOrDefault(candidate => candidate.IsEnabled);
        foreach (var field in preview.ConfigurationFields.Where(field => !field.Secret))
        {
            if (IsImportProviderField(field) && provider is not null)
                _importConfigurationValues[field.Key] = provider.Id.ToString();
            else if (field.Type.Equals(AgentConfigurationFieldTypes.Boolean, StringComparison.OrdinalIgnoreCase))
                _importConfigurationValues[field.Key] = false;
            else if (field.Type.Equals(AgentConfigurationFieldTypes.Select, StringComparison.OrdinalIgnoreCase))
                _importConfigurationValues[field.Key] = field.Options?.FirstOrDefault()?.Value;
            else
                _importConfigurationValues[field.Key] = null;
        }
        if (provider is not null && preview.ConfigurationFields.Any(IsImportModelField))
        {
            await LoadProviderModelsAsync(provider.Id);
            SetDefaultImportModel(provider);
        }
    }

    private async Task InstallImportAsync()
    {
        if (_importPreview is null)
        {
            return;
