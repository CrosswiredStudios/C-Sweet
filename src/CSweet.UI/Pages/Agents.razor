    private async Task UpdateInstallationAsync()
    {
        if (_updateInstallation is null || _selectedUpdate?.AvailablePackageVersionId is not Guid packageVersionId)
        {
            return;
        }

        var installationId = _updateInstallation.Id;
        var progressKey = InstallationProgressKey(_updateInstallation);
        _isManagingInstallation = true;
        _updateError = null;
        SetBuildProgress(progressKey, "Preparing update", "Stopping the current runtime and queuing the new package.");
        try
        {
            var updated = await AgentApi.UpdateAsync(
                installationId,
                new UpdateAgentInstallationRequest(packageVersionId),
                _disposeCts.Token);
            ReplaceInstallation(updated);
            _updates = _updates.Where(update => update.InstallationId != installationId).ToList();
            _updateDialogOpen = false;
            _updateInstallation = null;
            _selectedUpdate = null;
            _isManagingInstallation = false;
            await InvokeAsync(StateHasChanged);
            await TrackAgentBuildAsync(updated, isUpdate: true, cancellationToken: _disposeCts.Token);
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested) { }
        catch (Exception exception)
        {
            _updateError = exception.Message;
            SetBuildProgress(progressKey, "Update failed", exception.Message, true, Severity.Error);
        }
        finally
        {
            _isManagingInstallation = false;
        }
    }

    private async Task TrackAgentBuildAsync(
        AgentInstallationResponse installation,
        bool isUpdate,
        CancellationToken cancellationToken)
    {
        var deadline = DateTimeOffset.UtcNow.AddMinutes(15);
        var consecutiveRefreshFailures = 0;

        while (!cancellationToken.IsCancellationRequested)
        {
            ReplaceInstallation(installation);
            var build = installation.Build;
            if (build is null || string.Equals(build.Status, "Succeeded", StringComparison.Ordinal))
            {
                var completionTitle = isUpdate ? "Update complete" : "Agent ready";
                SetBuildProgress(InstallationProgressKey(installation), completionTitle, $"{installation.AgentName} {installation.AgentVersion} is built and ready.", true, Severity.Success);
                SetInstallationMessage(
                    isUpdate
                        ? $"{installation.AgentName} updated to {installation.AgentVersion} and is ready."
                        : $"{installation.AgentName} installed and ready.",
                    true);
                return;
            }

            if (build.Status is "Failed" or "Cancelled")
            {
                var failedStep = build.Steps?.FirstOrDefault(step => !string.IsNullOrWhiteSpace(step.Error));
                var failureDetail = failedStep is null
                    ? build.FailureMessage ?? $"The build ended with status {build.Status}."
                    : $"{failedStep.Label} failed: {failedStep.Error}";
                SetBuildProgress(InstallationProgressKey(installation), "Agent build failed", failureDetail, true, Severity.Error);
                SetInstallationMessage(
                    isUpdate
                        ? $"{installation.AgentName} was updated, but its new package could not be built."
                        : $"{installation.AgentName} was installed, but its package could not be built.",
                    false);
                return;
            }

            var (title, detail) = build.Status switch
            {
                "Queued" => ("Build queued", "Waiting for an available build worker."),
                "Cloning" => ("Fetching source", "Cloning the approved GitHub commit."),
                "Building" => ("Building package", "Compiling and packaging the new agent version."),
                _ => ("Updating agent", $"Build status: {build.Status}.")
            };
            SetBuildProgress(InstallationProgressKey(installation), title, detail);
            await InvokeAsync(StateHasChanged);

            if (DateTimeOffset.UtcNow >= deadline)
            {
                SetBuildProgress(InstallationProgressKey(installation), "Build is still running", "Progress tracking stopped after 15 minutes. Refresh the page to see the latest status.", true, Severity.Warning);
                return;
            }

            await Task.Delay(TimeSpan.FromSeconds(2), cancellationToken);
            try
            {
                installation = await RefreshBuildOwnerAsync(installation, cancellationToken)
                    ?? throw new InvalidOperationException("The updated installation could not be found.");
                consecutiveRefreshFailures = 0;
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                throw;
            }
            catch (Exception exception)
            {
                consecutiveRefreshFailures++;
                if (consecutiveRefreshFailures >= 3)
                {
                    SetBuildProgress(InstallationProgressKey(installation), "Could not refresh build progress", exception.Message, true, Severity.Warning);
                    return;
                }
                SetBuildProgress(InstallationProgressKey(installation), "Reconnecting", "The build is continuing; retrying the progress check.");
            }
        }
    }

    private void ResumeDefinitionBuildTracking()
    {
        foreach (var definition in _installations.Where(definition =>
                     IsDefinition(definition) && definition.Build?.Status is "Queued" or "Cloning" or "Building"))
        {
            var key = InstallationProgressKey(definition);
            if (_trackedDefinitionBuilds.Add(key))
                _ = TrackLoadedDefinitionBuildAsync(definition, key, _disposeCts.Token);
        }
    }

    private async Task TrackLoadedDefinitionBuildAsync(
        AgentInstallationResponse definition,
        Guid progressKey,
        CancellationToken cancellationToken)
    {
        try
        {
            await TrackAgentBuildAsync(definition, isUpdate: false, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            SetBuildProgress(progressKey, "Could not refresh build progress", exception.Message, true, Severity.Warning);
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _trackedDefinitionBuilds.Remove(progressKey);
        }
    }

    private Task<AgentInstallationResponse?> RefreshBuildOwnerAsync(
        AgentInstallationResponse installation,
        CancellationToken cancellationToken) =>
        IsDefinition(installation)
            ? AgentApi.GetDefinitionAsync(installation.Id, cancellationToken)
            : AgentApi.GetInstallationAsync(installation.Id, cancellationToken);

