    private static bool IsImportProviderField(PluginConfigurationField field) =>
        field.Type.Equals("provider", StringComparison.OrdinalIgnoreCase) ||
        field.Type.Equals(AgentConfigurationFieldTypes.LlmProvider, StringComparison.OrdinalIgnoreCase);

    private static bool IsImportModelField(PluginConfigurationField field) =>
        field.Type.Equals("model", StringComparison.OrdinalIgnoreCase) ||
        field.Type.Equals(AgentConfigurationFieldTypes.LlmModel, StringComparison.OrdinalIgnoreCase);

    private static string ImportFieldLabel(PluginConfigurationField field) =>
        field.Required ? $"{field.Label} (required)" : field.Label;

    private string ImportConfigurationString(string key) =>
        _importConfigurationValues.GetValueOrDefault(key)?.ToString() ?? string.Empty;

    private bool ImportConfigurationBoolean(string key) =>
        _importConfigurationValues.GetValueOrDefault(key) is true;

    private decimal? ImportConfigurationNumber(string key) =>
        _importConfigurationValues.GetValueOrDefault(key) as decimal?;

    private void SetImportConfiguration(string key, object? value) =>
        _importConfigurationValues[key] = value;

    private bool HasImportConfigurationValue(PluginConfigurationField field)
    {
        if (!_importConfigurationValues.TryGetValue(field.Key, out var value) || value is null)
            return false;
        return field.Type.Equals(AgentConfigurationFieldTypes.Boolean, StringComparison.OrdinalIgnoreCase) ||
               field.Type.Equals(AgentConfigurationFieldTypes.Number, StringComparison.OrdinalIgnoreCase) ||
               !string.IsNullOrWhiteSpace(value.ToString());
    }

    private async Task SetImportProviderAsync(string key, string value)
    {
        _importConfigurationValues[key] = value;
        var provider = FindProvider(value);
        if (provider is null)
            return;
        await LoadProviderModelsAsync(provider.Id);
        SetDefaultImportModel(provider);
    }

    private LlmProviderProfileResponse? ImportModelProvider()
    {
        if (_importPreview is null)
            return null;
        var providerField = _importPreview.ConfigurationFields.FirstOrDefault(IsImportProviderField);
        return providerField is null ? null : FindProvider(ImportConfigurationString(providerField.Key));
    }

    private IReadOnlyList<string> ImportModelOptions()
    {
        var provider = ImportModelProvider();
        if (provider is null)
            return [];
        return (_providerModels.GetValueOrDefault(provider.Id) ?? [])
            .Append(provider.DefaultChatModel)
            .Where(model => !string.IsNullOrWhiteSpace(model))
            .Distinct(StringComparer.Ordinal)
            .ToList();
    }

    private void SetDefaultImportModel(LlmProviderProfileResponse provider)
    {
        if (_importPreview is null)
            return;
        var models = ImportModelOptions();
        var model = models.Contains(provider.DefaultChatModel, StringComparer.Ordinal)
            ? provider.DefaultChatModel
            : models.FirstOrDefault() ?? string.Empty;
        foreach (var field in _importPreview.ConfigurationFields.Where(IsImportModelField))
            _importConfigurationValues[field.Key] = model;
    }

