@page "/settings/plugins"
@layout SettingsLayout
@using System.Text.Json
@using CSweet.Contracts.Agents
@using CSweet.Contracts.Plugins
@inject IPluginApiClient PluginApi
@inject IAppLocalizer L

<PageTitle>@L["Plugins.PageTitle"]</PageTitle>

<div class="setup-shell">
    <MudPaper Elevation="0" Class="page-header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">@L["Plugins.Overline"]</MudText>
            <MudText Typo="Typo.h3">@L["Plugins.Title"]</MudText>
            <MudText Color="Color.Secondary">@L["Plugins.Lead"]</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="@_busy">@L["Common.Refresh"]</MudButton>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="@(_error ? Severity.Error : Severity.Success)" Variant="Variant.Outlined">@_message</MudAlert>
    }

    @if (RequiredProviderIds.Count > 0)
    {
    <MudPaper Elevation="1" Class="surface-panel">
        <MudText Typo="Typo.h6">@L["Plugins.Providers.Title"]</MudText>
        <MudText Color="Color.Secondary">@L["Plugins.Providers.Intro"]</MudText>
        <MudText Color="Color.Secondary">@L["Plugins.Providers.Note"]</MudText>
        <PluginProviderRequirements Declarations="RequiredConnections" Profiles="_providerProfiles" Busy="@(_busy || !_providerProfilesLoaded)" Configure="ConfigureDeclaredProvider" />
        @if (!string.IsNullOrEmpty(_providerId))
        {
        <MudGrid Class="mt-2">
            <MudItem xs="12" md="4"><MudTextField Value="@_providerId" Label="@L["Plugins.Providers.ProfileId"]" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField Value="@_providerDisplayName" Label="@L["Plugins.Providers.DisplayName"]" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_providerClientId" Label="@L["Plugins.Providers.ClientId"]" Variant="Variant.Outlined" Disabled="@(_busy || _editingManagedProfile)" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField Value="@_providerAuthorizationEndpoint" Label="@L["Plugins.Providers.AuthorizationEndpoint"]" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField Value="@_providerTokenEndpoint" Label="@L["Plugins.Providers.TokenEndpoint"]" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField Value="@_providerRevocationEndpoint" Label="@L["Plugins.Providers.RevocationEndpoint"]" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_providerClientSecret" Label="@L["Plugins.Providers.ClientSecret"]" InputType="InputType.Password" Variant="Variant.Outlined" Disabled="@(_busy || _editingManagedProfile)" HelperText="@L["Plugins.Providers.ClientSecretHelp"]" /></MudItem>
        </MudGrid>
        <MudCheckBox @bind-Value="_providerEnabled" Label="@L["Common.Enabled"]" Color="Color.Primary" Disabled="@(_busy || _editingManagedProfile)" />
        <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProviderAsync"
                       Disabled="@(_busy || _editingManagedProfile || !CanEditProvider(_providerId) || string.IsNullOrWhiteSpace(_providerClientId))">@L["Plugins.Providers.Save"]</MudButton>
            <MudButton Variant="Variant.Text" OnClick="ResetProviderForm" Disabled="_busy">@L["Plugins.Providers.Clear"]</MudButton>
        </MudStack>
        }
        @foreach (var profile in _providerProfiles.Where(x => RequiredProviderIds.Contains(x.Id)))
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 mt-3">
                <div class="configuration-section-header">
                    <div>
                        <MudText Typo="Typo.subtitle1">@profile.DisplayName</MudText>
                        <MudText Typo="Typo.caption">@L.Format("Plugins.Providers.ProfileMeta", new { id = profile.Id, kind = profile.ManagedByDeployment ? L["Plugins.Providers.ManagedProfile"] : L["Plugins.Providers.SelfHostedProfile"] })</MudText>
                    </div>
                    <MudChip T="string" Color="@(CanEditProvider(profile.Id) && profile.IsEnabled && profile.HasClientSecret ? Color.Success : Color.Warning)">
                        @(CanEditProvider(profile.Id) && profile.IsEnabled && profile.HasClientSecret ? L["Plugins.Providers.CredentialsConfigured"] : L["Plugins.Providers.NeedsAttention"])
                    </MudChip>
                </div>
                <MudText Typo="Typo.body2">@L.Format("Plugins.Providers.ClientIdValue", new { value = profile.ClientId })</MudText>
                <MudText Typo="Typo.body2">@L.Format("Plugins.Providers.AuthorizationValue", new { value = profile.AuthorizationEndpoint })</MudText>
                <MudStack Row="true" Class="mt-2">
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => EditProvider(profile))" Disabled="@(_busy || !CanEditProvider(profile.Id))">@L["Plugins.Providers.ViewOrEdit"]</MudButton>
                    @if (!profile.ManagedByDeployment)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteProviderAsync(profile))" Disabled="_busy">@L["Common.Delete"]</MudButton>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudPaper>

    }
    <MudPaper Elevation="1" Class="surface-panel">
        <MudText Typo="Typo.h6">@L["Plugins.Import.Title"]</MudText>
        <MudText Color="Color.Secondary">@L["Plugins.Import.Intro"]</MudText>
        <MudTextField @bind-Value="_repositoryUrl" Label="@L["Plugins.Import.RepositoryUrl"]" Variant="Variant.Outlined" Disabled="@_busy" />
        <MudTextField @bind-Value="_commitSha" Label="@L["Plugins.Import.CommitSha"]" Variant="Variant.Outlined" Disabled="@_busy" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PreviewAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_repositoryUrl) || string.IsNullOrWhiteSpace(_commitSha))">
            @L["Plugins.Import.PreviewManifest"]
        </MudButton>

        @if (_preview is not null)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle1">@L.Format("Plugins.Import.PreviewHeading", new { name = _preview.AgentName, kind = _preview.PluginKind })</MudText>
            <MudText Typo="Typo.body2">@L.Format("Plugins.Import.PreviewMeta", new { id = _preview.AgentId, version = _preview.AgentVersion })</MudText>
            <MudText Typo="Typo.caption">@L.Format("Plugins.Import.Commit", new { sha = _preview.CommitSha })</MudText><br />
            <MudText Typo="Typo.caption">@L.Format("Plugins.Import.Manifest", new { file = _preview.ManifestFileName, digest = _preview.ManifestDigest })</MudText>
            <MudText Typo="Typo.body2" Class="mt-3">@L.Format("Plugins.Import.ProvidedCapabilities", new { values = Format(_preview.Capabilities) })</MudText>
            <MudText Typo="Typo.body2">@L.Format("Plugins.Import.RequestedCapabilities", new { values = Format(_preview.RequestedCapabilities) })</MudText>
            <MudText Typo="Typo.body2">@L.Format("Plugins.Import.NetworkAccess", new { values = Format(_preview.RequestedNetworkAccess) })</MudText>
            @foreach (var configField in _preview.ConfigurationFields.Where(configField => !configField.Secret && IsConfigurationFieldVisible(configField)))
            {
                <MudTextField T="string" Label="@FieldLabel(configField)"
                              Value="@ConfigurationValue(configField.Key)"
                              ValueChanged="@(value => SetConfigurationValue(configField.Key, value))"
                              Variant="Variant.Outlined" Disabled="@_busy" />
            }
            <MudCheckBox @bind-Value="_approve" Label="@L["Plugins.Import.Approve"]" Color="Color.Primary" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="InstallAsync" Disabled="@(_busy || !_approve || HasMissingConfiguration)">
                @L["Plugins.Import.BuildAndInstall"]
            </MudButton>
        }
    </MudPaper>

    <MudPaper Elevation="1" Class="surface-panel">
        <div class="configuration-section-header">
            <div>
                <MudText Typo="Typo.h6">@L["Plugins.Installed.Title"]</MudText>
                <MudText Color="Color.Secondary">@L["Plugins.Installed.Intro"]</MudText>
            </div>
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@_installations.Count</MudChip>
        </div>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_installations.Count == 0)
        {
            <MudText Color="Color.Secondary">@L["Plugins.Installed.Empty"]</MudText>
        }
        else
        {
            @foreach (var installation in _installations)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-3">
                    <div class="configuration-section-header">
                        <div>
                            <MudText Typo="Typo.subtitle1">@installation.AgentName</MudText>
                            <MudText Typo="Typo.caption">@L.Format("Plugins.Installed.Meta", new { kind = installation.PluginKind, scope = installation.InstallationScope, sha = installation.CommitSha })</MudText>
                        </div>
                        <MudChip T="string" Color="@(installation.IsEnabled ? Color.Success : Color.Default)">@(installation.IsEnabled ? L["Common.Enabled"] : L["Common.Disabled"])</MudChip>
                    </div>
                    <MudText Typo="Typo.body2">@L.Format("Plugins.Installed.Status", new { build = installation.Build?.Status ?? L["Plugins.Installed.BuildQueued"], runtime = installation.LatestRuntime?.Status ?? L["Plugins.Installed.RuntimeNotStarted"] })</MudText>
                    <MudStack Row="true" Class="mt-3">
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => ToggleAsync(installation))" Disabled="@_busy">
                            @(installation.IsEnabled ? L["Plugins.Installed.Disable"] : L["Plugins.Installed.Enable"])
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => RemoveAsync(installation))" Disabled="@_busy">@L["Plugins.Installed.Remove"]</MudButton>
                    </MudStack>
                </MudPaper>
            }
        }
    </MudPaper>
</div>

@code {
    private readonly List<AgentInstallationResponse> _installations = [];
    private readonly List<PluginProviderProfileResponse> _providerProfiles = [];
    private IReadOnlyList<PluginConnectionDeclaration> RequiredConnections => _installations.Where(x => x.PluginKind == "Connector")
        .SelectMany(x => x.ConnectionDeclarations).Concat(_preview?.PluginKind == "Connector" ? _preview.Connections : [])
        .ToArray();
    private HashSet<string> RequiredProviderIds => RequiredConnections
        .Select(x => x.ProviderProfile).ToHashSet(StringComparer.Ordinal);
    private AgentImportPreviewResponse? _preview;
    private string _repositoryUrl = string.Empty;
    private string _commitSha = string.Empty;
    private string? _message;
    private bool _loading = true;
    private bool _busy;
    private bool _error;
    private bool _approve;
    private readonly Dictionary<string, string> _configurationValues = new(StringComparer.Ordinal);
    private string _providerId = string.Empty;
    private string _providerDisplayName = string.Empty;
    private string _providerAuthorizationEndpoint = string.Empty;
    private string _providerTokenEndpoint = string.Empty;
    private string _providerRevocationEndpoint = string.Empty;
    private string _providerClientId = string.Empty;
    private string _providerClientSecret = string.Empty;
    private bool _providerEnabled = true;
    private bool _editingManagedProfile;
    private bool _providerProfilesLoaded;
    private bool HasMissingConfiguration =>
        _preview?.ConfigurationFields
            .Where(configField => configField.Required && !configField.Secret && IsConfigurationFieldVisible(configField))
            .Any(configField => string.IsNullOrWhiteSpace(ConfigurationValue(configField.Key))) == true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _providerProfilesLoaded = false;
        try
        {
            _installations.Clear();
            _installations.AddRange(await PluginApi.ListAsync());
            _providerProfiles.Clear();
            if (RequiredProviderIds.Count > 0)
                _providerProfiles.AddRange(await PluginApi.ListProviderProfilesAsync());
            _providerProfilesLoaded = true;
            if (!string.IsNullOrEmpty(_providerId) && !CanEditProvider(_providerId)) ResetProviderForm();
        }
        catch (Exception exception) { ShowError(exception); }
        finally { _loading = false; }
    }

    private async Task SaveProviderAsync()
    {
        _busy = true;
        try
        {
            if (_editingManagedProfile || !CanEditProvider(_providerId))
                throw new InvalidOperationException(L["Plugins.Providers.Error.SelectDeclared"]);
            var declared = PluginProviderDeclarations.Collect(RequiredConnections).Single(x => x.Id == _providerId).Provider!;
            if (_providerAuthorizationEndpoint != declared.AuthorizationEndpoint || _providerTokenEndpoint != declared.TokenEndpoint ||
                _providerRevocationEndpoint != declared.RevocationEndpoint)
                throw new InvalidOperationException(L["Plugins.Providers.Error.DeclarationChanged"]);
            await PluginApi.SaveProviderProfileAsync(_providerId.Trim(), new(
                _providerDisplayName.Trim(), _providerAuthorizationEndpoint.Trim(), _providerTokenEndpoint.Trim(),
                string.IsNullOrWhiteSpace(_providerRevocationEndpoint) ? null : _providerRevocationEndpoint.Trim(),
                _providerClientId.Trim(), string.IsNullOrWhiteSpace(_providerClientSecret) ? null : _providerClientSecret,
                _providerEnabled));
            _providerClientSecret = string.Empty;
            ShowSuccess(L["Plugins.Providers.Saved"]);
            await LoadAsync();
        }
        catch (Exception exception) { ShowError(exception); }
        finally { _busy = false; }
    }

    private void EditProvider(PluginProviderProfileResponse profile)
    {
        if (!CanEditProvider(profile.Id)) return;
        _providerId = profile.Id; _providerDisplayName = profile.DisplayName;
        _providerAuthorizationEndpoint = profile.AuthorizationEndpoint; _providerTokenEndpoint = profile.TokenEndpoint;
        _providerRevocationEndpoint = profile.RevocationEndpoint ?? string.Empty; _providerClientId = profile.ClientId;
        _providerClientSecret = string.Empty; _providerEnabled = profile.IsEnabled;
        _editingManagedProfile = profile.ManagedByDeployment;
    }

    private bool CanEditProvider(string id)
    {
        var requirement = PluginProviderDeclarations.Collect(RequiredConnections).SingleOrDefault(x => x.Id == id);
        var profile = _providerProfiles.SingleOrDefault(x => x.Id == id);
        return _providerProfilesLoaded && requirement?.CanConfigure == true && (profile is null || requirement.Matches(profile));
    }

    private void ConfigureDeclaredProvider(PluginProviderDeclarations.Requirement requested)
    {
        // Re-resolve from current declarations; an old UI callback must not configure a removed preview.
        var requirement = PluginProviderDeclarations.Collect(RequiredConnections).SingleOrDefault(x => x.Id == requested.Id);
        if (requirement?.CanConfigure != true || !CanEditProvider(requirement.Id)) return;
        var existing = _providerProfiles.SingleOrDefault(x => x.Id == requirement.Id);
        if (existing is not null) { EditProvider(existing); return; }
        ResetProviderForm();
        _providerId = requirement.Id; _providerDisplayName = requirement.Provider!.DisplayName;
        _providerAuthorizationEndpoint = requirement.Provider.AuthorizationEndpoint;
        _providerTokenEndpoint = requirement.Provider.TokenEndpoint;
        _providerRevocationEndpoint = requirement.Provider.RevocationEndpoint;
    }

    private async Task DeleteProviderAsync(PluginProviderProfileResponse profile)
    {
        _busy = true;
        try { await PluginApi.DeleteProviderProfileAsync(profile.Id); ResetProviderForm(); ShowSuccess(L["Plugins.Providers.Deleted"]); await LoadAsync(); }
        catch (Exception exception) { ShowError(exception); }
        finally { _busy = false; }
    }

    private void ResetProviderForm()
    {
        _providerId = string.Empty; _providerDisplayName = string.Empty;
        _providerAuthorizationEndpoint = string.Empty;
        _providerTokenEndpoint = string.Empty;
        _providerRevocationEndpoint = string.Empty;
        _providerClientId = string.Empty; _providerClientSecret = string.Empty; _providerEnabled = true;
        _editingManagedProfile = false;
    }

    private async Task PreviewAsync()
    {
        _busy = true; _message = null; _preview = null; _approve = false; _configurationValues.Clear(); ResetProviderForm();
        _providerProfilesLoaded = false;
        try
        {
            _preview = await PluginApi.PreviewAsync(new(_repositoryUrl.Trim(), _commitSha.Trim()));
            _providerProfiles.Clear();
            if (RequiredProviderIds.Count > 0)
                _providerProfiles.AddRange(await PluginApi.ListProviderProfilesAsync());
            _providerProfilesLoaded = true;
            foreach (var configField in _preview.ConfigurationFields.Where(configField => !configField.Secret))
                _configurationValues[configField.Key] = string.Empty;
        }
        catch (Exception exception) { ShowError(exception); }
        finally { _busy = false; }
    }

    private async Task InstallAsync()
    {
        if (_preview is null) return;
        _busy = true;
        try
        {
            var communication = string.Equals(_preview.PluginKind, "CommunicationProvider", StringComparison.OrdinalIgnoreCase);
            var request = new InstallAgentRequest(
                communication ? "enterprise" : "shared",
                communication ? "AlwaysOn" : (_preview.DefaultActivationMode ?? "OnDemand"),
                communication ? 30 : 300,
                "Skip",
                _preview.Capabilities,
                _preview.RequestedSubscriptions,
                _preview.RequestedPublications,
                _preview.RequestedPermissions,
                _preview.RequestedNetworkAccess,
                300, 512, 50)
            {
                PluginScope = communication ? "System" : "Organization",
                GrantedRequestedCapabilities = _preview.RequestedCapabilities,
                ConfigurationSettings = _configurationValues
                    .Where(pair => !string.IsNullOrWhiteSpace(pair.Value))
                    .ToDictionary(
                        pair => pair.Key,
                        pair => JsonSerializer.SerializeToElement(pair.Value.Trim()),
                        StringComparer.Ordinal)
            };
            await PluginApi.InstallAsync(_preview.ImportId, request);
            _preview = null; _approve = false; _repositoryUrl = string.Empty; _commitSha = string.Empty;
            ShowSuccess(L["Plugins.Import.Installed"]);
            await LoadAsync();
        }
        catch (Exception exception) { ShowError(exception); }
        finally { _busy = false; }
    }

    private async Task ToggleAsync(AgentInstallationResponse installation)
    {
        _busy = true;
        try { await PluginApi.SetEnabledAsync(installation.Id, !installation.IsEnabled); ShowSuccess(L["Plugins.Installed.StateUpdated"]); await LoadAsync(); }
        catch (Exception exception) { ShowError(exception); }
        finally { _busy = false; }
    }

    private async Task RemoveAsync(AgentInstallationResponse installation)
    {
        _busy = true;
        try { await PluginApi.RemoveAsync(installation.Id); ShowSuccess(L["Plugins.Installed.Removed"]); await LoadAsync(); }
        catch (Exception exception) { ShowError(exception); }
        finally { _busy = false; }
    }

    private string Format(IReadOnlyList<string> values) => values.Count == 0 ? L["Common.None"] : string.Join(", ", values.Select(value => CapabilityDisplayNames.For(L, value)));
    private string FieldLabel(PluginConfigurationField configField) =>
        configField.Required ? L.Format("Plugins.Import.RequiredField", new { label = configField.Label }) : configField.Label;
    private string ConfigurationValue(string key) => _configurationValues.GetValueOrDefault(key) ?? string.Empty;
    private void SetConfigurationValue(string key, string value) => _configurationValues[key] = value;
    private bool IsConfigurationFieldVisible(PluginConfigurationField field) =>
        AgentConfigurationVisibility.IsVisible(field, _configurationValues);
    private void ShowSuccess(string message) { _message = message; _error = false; }
    private void ShowError(Exception exception) { _message = exception.Message; _error = true; }
}
