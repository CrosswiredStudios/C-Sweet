@page "/settings/plugins"
@layout SettingsLayout
@using System.Text.Json
@using CSweet.Contracts.Agents
@using CSweet.Contracts.Plugins
@inject IPluginApiClient PluginApi

<PageTitle>Plugins - C-Sweet</PageTitle>

<div class="setup-shell">
    <MudPaper Elevation="0" Class="page-header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">Enterprise extensions</MudText>
            <MudText Typo="Typo.h3">Plugins</MudText>
            <MudText Color="Color.Secondary">Import immutable agent and communication-provider packages. Nothing runs until an administrator approves the manifest and grants.</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="@_busy">Refresh</MudButton>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="@(_error ? Severity.Error : Severity.Success)" Variant="Variant.Outlined">@_message</MudAlert>
    }

    <MudPaper Elevation="1" Class="surface-panel">
        <MudText Typo="Typo.h6">OAuth provider profiles</MudText>
        <MudText Color="Color.Secondary">Configure a provider once for all compatible plugins. Client secrets are encrypted by C-Sweet and are never returned to this page or to an agent.</MudText>
        <MudGrid Class="mt-2">
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_providerId" Label="Profile ID" Variant="Variant.Outlined" Disabled="@(_busy || _editingManagedProfile)" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_providerDisplayName" Label="Display name" Variant="Variant.Outlined" Disabled="_busy" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_providerClientId" Label="OAuth client ID" Variant="Variant.Outlined" Disabled="_busy" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_providerAuthorizationEndpoint" Label="Authorization endpoint" Variant="Variant.Outlined" Disabled="_busy" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_providerTokenEndpoint" Label="Token endpoint" Variant="Variant.Outlined" Disabled="_busy" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_providerRevocationEndpoint" Label="Revocation endpoint" Variant="Variant.Outlined" Disabled="_busy" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_providerClientSecret" Label="OAuth client secret" InputType="InputType.Password" Variant="Variant.Outlined" Disabled="@(_busy || _editingManagedProfile)" HelperText="Leave blank when editing to preserve the encrypted value." /></MudItem>
        </MudGrid>
        <MudCheckBox @bind-Value="_providerEnabled" Label="Enabled" Color="Color.Primary" Disabled="_busy" />
        <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProviderAsync"
                       Disabled="@(_busy || _editingManagedProfile || string.IsNullOrWhiteSpace(_providerId) || string.IsNullOrWhiteSpace(_providerClientId))">Save provider profile</MudButton>
            <MudButton Variant="Variant.Text" OnClick="ResetProviderForm" Disabled="_busy">Clear</MudButton>
        </MudStack>
        @foreach (var profile in _providerProfiles)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 mt-3">
                <div class="configuration-section-header">
                    <div>
                        <MudText Typo="Typo.subtitle1">@profile.DisplayName</MudText>
                        <MudText Typo="Typo.caption">@profile.Id · @(profile.ManagedByDeployment ? "Managed deployment profile" : "Vault-backed self-hosted profile")</MudText>
                    </div>
                    <MudChip T="string" Color="@(profile.IsEnabled && profile.HasClientSecret ? Color.Success : Color.Warning)">
                        @(profile.IsEnabled && profile.HasClientSecret ? "Ready" : "Needs attention")
                    </MudChip>
                </div>
                <MudText Typo="Typo.body2">Client ID: @profile.ClientId</MudText>
                <MudText Typo="Typo.body2">Authorization: @profile.AuthorizationEndpoint</MudText>
                <MudStack Row="true" Class="mt-2">
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => EditProvider(profile))" Disabled="_busy">View or edit</MudButton>
                    @if (!profile.ManagedByDeployment)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteProviderAsync(profile))" Disabled="_busy">Delete</MudButton>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudPaper>

    <MudPaper Elevation="1" Class="surface-panel">
        <MudText Typo="Typo.h6">Import from GitHub</MudText>
        <MudText Color="Color.Secondary">Use an exact 40-character commit SHA for reproducible imports. The manifest digest is shown before approval.</MudText>
        <MudTextField @bind-Value="_repositoryUrl" Label="Public GitHub repository URL" Variant="Variant.Outlined" Disabled="@_busy" />
        <MudTextField @bind-Value="_commitSha" Label="Exact commit SHA" Variant="Variant.Outlined" Disabled="@_busy" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PreviewAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_repositoryUrl) || string.IsNullOrWhiteSpace(_commitSha))">
            Preview manifest
        </MudButton>

        @if (_preview is not null)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle1">@_preview.AgentName (@_preview.PluginKind)</MudText>
            <MudText Typo="Typo.body2">@_preview.AgentId · @_preview.AgentVersion</MudText>
            <MudText Typo="Typo.caption">Commit: @_preview.CommitSha</MudText><br />
            <MudText Typo="Typo.caption">Manifest: @_preview.ManifestFileName · SHA-256 @_preview.ManifestDigest</MudText>
            <MudText Typo="Typo.body2" Class="mt-3">Provided capabilities: @Format(_preview.Capabilities)</MudText>
            <MudText Typo="Typo.body2">Requested platform capabilities: @Format(_preview.RequestedCapabilities)</MudText>
            <MudText Typo="Typo.body2">Network access: @Format(_preview.RequestedNetworkAccess)</MudText>
            @foreach (var configField in _preview.ConfigurationFields.Where(configField => !configField.Secret))
            {
                <MudTextField T="string" Label="@FieldLabel(configField)"
                              Value="@ConfigurationValue(configField.Key)"
                              ValueChanged="@(value => SetConfigurationValue(configField.Key, value))"
                              Variant="Variant.Outlined" Disabled="@_busy" />
            }
            <MudCheckBox @bind-Value="_approve" Label="I approve the displayed capabilities, permissions, publications, subscriptions, and network grants." Color="Color.Primary" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="InstallAsync" Disabled="@(_busy || !_approve || HasMissingConfiguration)">
                Build and install
            </MudButton>
        }
    </MudPaper>

    <MudPaper Elevation="1" Class="surface-panel">
        <div class="configuration-section-header">
            <div>
                <MudText Typo="Typo.h6">Installed plugins</MudText>
                <MudText Color="Color.Secondary">Communication providers are system-scoped, always-on runtimes with durable storage under <code>/data</code>.</MudText>
            </div>
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@_installations.Count</MudChip>
        </div>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_installations.Count == 0)
        {
            <MudText Color="Color.Secondary">No plugins are installed. The default topology starts no communication-provider containers.</MudText>
        }
        else
        {
            @foreach (var installation in _installations)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-3">
                    <div class="configuration-section-header">
                        <div>
                            <MudText Typo="Typo.subtitle1">@installation.AgentName</MudText>
                            <MudText Typo="Typo.caption">@installation.PluginKind · @installation.InstallationScope · @installation.CommitSha</MudText>
                        </div>
                        <MudChip T="string" Color="@(installation.IsEnabled ? Color.Success : Color.Default)">@(installation.IsEnabled ? "Enabled" : "Disabled")</MudChip>
                    </div>
                    <MudText Typo="Typo.body2">Build: @(installation.Build?.Status ?? "Queued") · Runtime: @(installation.LatestRuntime?.Status ?? "Not started")</MudText>
                    <MudStack Row="true" Class="mt-3">
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => ToggleAsync(installation))" Disabled="@_busy">
                            @(installation.IsEnabled ? "Disable" : "Enable")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => RemoveAsync(installation))" Disabled="@_busy">Remove installation</MudButton>
                    </MudStack>
                </MudPaper>
            }
        }
    </MudPaper>
</div>

@code {
    private readonly List<AgentInstallationResponse> _installations = [];
    private readonly List<PluginProviderProfileResponse> _providerProfiles = [];
    private AgentImportPreviewResponse? _preview;
    private string _repositoryUrl = string.Empty;
    private string _commitSha = string.Empty;
    private string? _message;
    private bool _loading = true;
    private bool _busy;
    private bool _error;
    private bool _approve;
    private readonly Dictionary<string, string> _configurationValues = new(StringComparer.Ordinal);
    private string _providerId = "com.csweet.google.youtube";
    private string _providerDisplayName = "Google / YouTube";
    private string _providerAuthorizationEndpoint = "https://accounts.google.com/o/oauth2/v2/auth";
    private string _providerTokenEndpoint = "https://oauth2.googleapis.com/token";
    private string _providerRevocationEndpoint = "https://oauth2.googleapis.com/revoke";
    private string _providerClientId = string.Empty;
    private string _providerClientSecret = string.Empty;
    private bool _providerEnabled = true;
    private bool _editingManagedProfile;
    private bool HasMissingConfiguration =>
        _preview?.ConfigurationFields
            .Where(configField => configField.Required && !configField.Secret)
            .Any(configField => string.IsNullOrWhiteSpace(ConfigurationValue(configField.Key))) == true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _installations.Clear();
            _installations.AddRange(await PluginApi.ListAsync());
            _providerProfiles.Clear();
            _providerProfiles.AddRange(await PluginApi.ListProviderProfilesAsync());
        }
        catch (Exception exception) { ShowError(exception); }
        finally { _loading = false; }
    }

    private async Task SaveProviderAsync()
    {
        _busy = true;
        try
        {
            await PluginApi.SaveProviderProfileAsync(_providerId.Trim(), new(
                _providerDisplayName.Trim(), _providerAuthorizationEndpoint.Trim(), _providerTokenEndpoint.Trim(),
                string.IsNullOrWhiteSpace(_providerRevocationEndpoint) ? null : _providerRevocationEndpoint.Trim(),
                _providerClientId.Trim(), string.IsNullOrWhiteSpace(_providerClientSecret) ? null : _providerClientSecret,
                _providerEnabled));
            _providerClientSecret = string.Empty;
            ShowSuccess("OAuth provider profile saved. The client secret is encrypted and will not be displayed again.");
            await LoadAsync();
        }
        catch (Exception exception) { ShowError(exception); }
        finally { _busy = false; }
    }

    private void EditProvider(PluginProviderProfileResponse profile)
    {
        _providerId = profile.Id; _providerDisplayName = profile.DisplayName;
        _providerAuthorizationEndpoint = profile.AuthorizationEndpoint; _providerTokenEndpoint = profile.TokenEndpoint;
        _providerRevocationEndpoint = profile.RevocationEndpoint ?? string.Empty; _providerClientId = profile.ClientId;
        _providerClientSecret = string.Empty; _providerEnabled = profile.IsEnabled;
        _editingManagedProfile = profile.ManagedByDeployment;
    }

    private async Task DeleteProviderAsync(PluginProviderProfileResponse profile)
    {
        _busy = true;
        try { await PluginApi.DeleteProviderProfileAsync(profile.Id); ResetProviderForm(); ShowSuccess("Provider profile and encrypted secret deleted."); await LoadAsync(); }
        catch (Exception exception) { ShowError(exception); }
        finally { _busy = false; }
    }

    private void ResetProviderForm()
    {
        _providerId = "com.csweet.google.youtube"; _providerDisplayName = "Google / YouTube";
        _providerAuthorizationEndpoint = "https://accounts.google.com/o/oauth2/v2/auth";
        _providerTokenEndpoint = "https://oauth2.googleapis.com/token";
        _providerRevocationEndpoint = "https://oauth2.googleapis.com/revoke";
        _providerClientId = string.Empty; _providerClientSecret = string.Empty; _providerEnabled = true;
        _editingManagedProfile = false;
    }

    private async Task PreviewAsync()
    {
        _busy = true; _message = null; _preview = null; _approve = false; _configurationValues.Clear();
        try
        {
            _preview = await PluginApi.PreviewAsync(new(_repositoryUrl.Trim(), _commitSha.Trim()));
            foreach (var configField in _preview.ConfigurationFields.Where(configField => !configField.Secret))
                _configurationValues[configField.Key] = string.Empty;
        }
        catch (Exception exception) { ShowError(exception); }
        finally { _busy = false; }
    }

    private async Task InstallAsync()
    {
        if (_preview is null) return;
        _busy = true;
        try
        {
            var communication = string.Equals(_preview.PluginKind, "CommunicationProvider", StringComparison.OrdinalIgnoreCase);
            var request = new InstallAgentRequest(
                communication ? "enterprise" : "shared",
                communication ? "AlwaysOn" : (_preview.DefaultActivationMode ?? "OnDemand"),
                communication ? 30 : 300,
                "Skip",
                _preview.Capabilities,
                _preview.RequestedSubscriptions,
                _preview.RequestedPublications,
                _preview.RequestedPermissions,
                _preview.RequestedNetworkAccess,
                300, 512, 50)
            {
                PluginScope = communication ? "System" : "Organization",
                GrantedRequestedCapabilities = _preview.RequestedCapabilities,
                ConfigurationSettings = _configurationValues
                    .Where(pair => !string.IsNullOrWhiteSpace(pair.Value))
                    .ToDictionary(
                        pair => pair.Key,
                        pair => JsonSerializer.SerializeToElement(pair.Value.Trim()),
                        StringComparer.Ordinal)
            };
            await PluginApi.InstallAsync(_preview.ImportId, request);
            _preview = null; _approve = false; _repositoryUrl = string.Empty; _commitSha = string.Empty;
            ShowSuccess("Plugin approved and queued for an isolated build.");
            await LoadAsync();
        }
        catch (Exception exception) { ShowError(exception); }
        finally { _busy = false; }
    }

    private async Task ToggleAsync(AgentInstallationResponse installation)
    {
        _busy = true;
        try { await PluginApi.SetEnabledAsync(installation.Id, !installation.IsEnabled); ShowSuccess("Plugin state updated."); await LoadAsync(); }
        catch (Exception exception) { ShowError(exception); }
        finally { _busy = false; }
    }

    private async Task RemoveAsync(AgentInstallationResponse installation)
    {
        _busy = true;
        try { await PluginApi.RemoveAsync(installation.Id); ShowSuccess("Plugin installation removed. Persistent provider data remains preserved for controlled cleanup."); await LoadAsync(); }
        catch (Exception exception) { ShowError(exception); }
        finally { _busy = false; }
    }

    private static string Format(IReadOnlyList<string> values) => values.Count == 0 ? "None" : string.Join(", ", values);
    private static string FieldLabel(PluginConfigurationField configField) =>
        configField.Required ? $"{configField.Label} (required)" : configField.Label;
    private string ConfigurationValue(string key) => _configurationValues.GetValueOrDefault(key) ?? string.Empty;
    private void SetConfigurationValue(string key, string value) => _configurationValues[key] = value;
    private void ShowSuccess(string message) { _message = message; _error = false; }
    private void ShowError(Exception exception) { _message = exception.Message; _error = true; }
}
