@page "/settings/plugins"
@layout SettingsLayout
@using CSweet.Contracts.Agents
@using CSweet.Contracts.Plugins
@inject IPluginApiClient PluginApi
@inject IBusinessContext BusinessContext
@inject IAppLocalizer L
@inject NavigationManager Navigation

<PageTitle>@L["Plugins.PageTitle"]</PageTitle>
<div class="setup-shell plugins-page">
    <MudPaper Elevation="0" Class="page-header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">@L["Plugins.Overline"]</MudText>
            <MudText Typo="Typo.h3">@L["Plugins.Title"]</MudText>
            <MudText Color="Color.Secondary">@L["Plugins.Lead"]</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="@(_busy || _loading)">@L["Common.Refresh"]</MudButton>
    </MudPaper>
    @if (_installationPolicy is { ImportedPluginsEnabled: false })
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="status">
            @L["Plugins.Import.Unavailable"]
        </MudAlert>
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="@(_error ? Severity.Error : Severity.Success)" Variant="Variant.Outlined" role="status">@_message</MudAlert>
    }
    <MudTabs ActivePanelIndex="_activeTab" ActivePanelIndexChanged="ChangeTab" Elevation="0" Class="plugins-tabs" KeepPanelsAlive="false">
        <MudTabPanel Text="@L["Plugins.Tabs.Installed"]" BadgeData="@_installations.Count" Disabled="_busy">
            <section class="plugins-tab-content" aria-label="@L["Plugins.Installed.Title"]">
                <div class="plugins-toolbar">
                    <MudTextField T="string" @bind-Value="_installedSearch" Immediate="true" Placeholder="@L["Plugins.Installed.Search"]" aria-label="@L["Plugins.Installed.Search"]" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L.Format("Plugins.Installed.Count", new { count = _installations.Count })</MudText>
                </div>
                @if (_loading) { <MudProgressLinear Indeterminate="true" aria-label="@L["Plugins.Installed.Loading"]" /> }
                else if (_installations.Count == 0)
                {
                    <MudPaper Outlined="true" Elevation="0" Class="plugins-empty">
                        <MudIcon Icon="@Icons.Material.Outlined.Extension" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">@L["Plugins.Installed.EmptyTitle"]</MudText>
                        <MudText Color="Color.Secondary">@L["Plugins.Installed.Empty"]</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ChangeTab(1))">@L["Plugins.Tabs.Find"]</MudButton>
                    </MudPaper>
                }
                else if (!FilteredInstallations.Any()) { <MudText Class="pa-5" Color="Color.Secondary">@L["Plugins.Installed.NoMatches"]</MudText> }
                else
                {
                    @foreach (var installation in FilteredInstallations)
                    {
                        <MudPaper @key="installation.Id" Outlined="true" Elevation="0" Class="plugin-installation">
                            <div class="plugin-row">
                                <PluginCatalogIcon Entry="@PluginCatalog.Entries.FirstOrDefault(e=>e.Id==installation.AgentId)" />
                                <div class="plugin-row-body">
                                    <div class="plugin-title"><MudText Typo="Typo.subtitle1">@installation.AgentName</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@($"v{installation.AgentVersion}")</MudText></div>
                                    @if (!string.IsNullOrWhiteSpace(installation.Summary)) { <MudText Typo="Typo.body2" Color="Color.Secondary">@installation.Summary</MudText> }
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L.Format("Plugins.Installed.Scope", new { kind = installation.PluginKind, scope = InstallationScope(installation) })</MudText>
                                </div>
                                <div class="plugin-row-actions">
                                    <MudChip T="string" Size="Size.Small" Color="@(installation.IsEnabled ? Color.Success : Color.Default)">@(installation.IsEnabled ? L["Common.Enabled"] : L["Common.Disabled"])</MudChip>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Manage(installation))" Disabled="_busy" aria-expanded="@(_managedId == installation.Id)">@L["Plugins.Installed.Manage"]</MudButton>
                                </div>
                            </div>
                            @if (_managedId == installation.Id)
                            {
                                <div class="plugin-management">
                                    <MudText Typo="Typo.body2">@L.Format("Plugins.Installed.Status", new { build = installation.Build?.Status ?? L["Plugins.Installed.Ready"], runtime = installation.LatestRuntime?.Status ?? L["Plugins.Installed.RuntimeNotStarted"] })</MudText>
                                    @if (!string.IsNullOrWhiteSpace(installation.Build?.FailureMessage)) { <MudAlert Severity="Severity.Error">@installation.Build.FailureMessage</MudAlert> }
                                    <MudText Typo="Typo.caption">@installation.AgentId · @installation.PublisherName</MudText>
                                    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mt-3">
                                        <MudButton Variant="Variant.Outlined" OnClick="@(() => ToggleAsync(installation))" Disabled="_busy">@(installation.IsEnabled ? L["Plugins.Installed.Disable"] : L["Plugins.Installed.Enable"])</MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => _removePending = installation.Id)" Disabled="_busy">@L["Plugins.Installed.Remove"]</MudButton>
                                    </MudStack>
                                    @if (_removePending == installation.Id)
                                    {
                                        <MudAlert Severity="Severity.Warning" Class="mt-3">@L.Format("Plugins.Installed.ConfirmRemove", new { name = installation.AgentName })</MudAlert>
                                        <MudButton Color="Color.Error" OnClick="@(() => RemoveAsync(installation))" Disabled="_busy">@L["Plugins.Installed.Remove"]</MudButton>
                                        <MudButton OnClick="@(() => _removePending = null)" Disabled="_busy">@L["Common.Cancel"]</MudButton>
                                    }
                                </div>
                            }
                        </MudPaper>
                    }
                }
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-5">@L["Plugins.Installed.AgentsHint"] <MudLink Href="/settings/agents">@L["Plugins.Installed.AgentsLink"]</MudLink></MudText>
                    @if (RequiredProviderIds.Count > 0)
    {
    <MudPaper Elevation="1" Class="surface-panel" id="provider-administration">
        <MudText Typo="Typo.h6">@L["Plugins.Providers.Title"]</MudText>
        <MudText Color="Color.Secondary">@L["Plugins.Providers.Intro"]</MudText>
        <MudText Color="Color.Secondary">@L["Plugins.Providers.Note"]</MudText>
        <PluginProviderRequirements Declarations="RequiredConnections" Profiles="_providerProfiles" Busy="@(_busy || !_providerProfilesLoaded)" Configure="ConfigureDeclaredProvider" />
        @if (!string.IsNullOrEmpty(_providerId))
        {
        <MudGrid Class="mt-2">
            <MudItem xs="12" md="4"><MudTextField Value="@_providerId" Label="@L["Plugins.Providers.ProfileId"]" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField Value="@_providerDisplayName" Label="@L["Plugins.Providers.DisplayName"]" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_providerClientId" Label="@L["Plugins.Providers.ClientId"]" Variant="Variant.Outlined" Disabled="@(_busy || _editingManagedProfile)" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField Value="@_providerAuthorizationEndpoint" Label="@L["Plugins.Providers.AuthorizationEndpoint"]" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField Value="@_providerTokenEndpoint" Label="@L["Plugins.Providers.TokenEndpoint"]" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField Value="@_providerRevocationEndpoint" Label="@L["Plugins.Providers.RevocationEndpoint"]" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_providerClientSecret" Label="@L["Plugins.Providers.ClientSecret"]" InputType="InputType.Password" Variant="Variant.Outlined" Disabled="@(_busy || _editingManagedProfile)" HelperText="@L["Plugins.Providers.ClientSecretHelp"]" /></MudItem>
        </MudGrid>
        <MudCheckBox @bind-Value="_providerEnabled" Label="@L["Common.Enabled"]" Color="Color.Primary" Disabled="@(_busy || _editingManagedProfile)" />
        <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProviderAsync"
                       Disabled="@(_busy || _editingManagedProfile || !CanEditProvider(_providerId) || string.IsNullOrWhiteSpace(_providerClientId))">@L["Plugins.Providers.Save"]</MudButton>
            <MudButton Variant="Variant.Text" OnClick="ResetProviderForm" Disabled="_busy">@L["Plugins.Providers.Clear"]</MudButton>
        </MudStack>
        }
        @foreach (var profile in _providerProfiles.Where(x => RequiredProviderIds.Contains(x.Id)))
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 mt-3">
                <div class="configuration-section-header">
                    <div>
                        <MudText Typo="Typo.subtitle1">@profile.DisplayName</MudText>
                        <MudText Typo="Typo.caption">@L.Format("Plugins.Providers.ProfileMeta", new { id = profile.Id, kind = profile.ManagedByDeployment ? L["Plugins.Providers.ManagedProfile"] : L["Plugins.Providers.SelfHostedProfile"] })</MudText>
                    </div>
                    <MudChip T="string" Color="@(CanEditProvider(profile.Id) && profile.IsEnabled && profile.HasClientSecret ? Color.Success : Color.Warning)">
                        @(CanEditProvider(profile.Id) && profile.IsEnabled && profile.HasClientSecret ? L["Plugins.Providers.CredentialsConfigured"] : L["Plugins.Providers.NeedsAttention"])
                    </MudChip>
                </div>
                <MudText Typo="Typo.body2">@L.Format("Plugins.Providers.ClientIdValue", new { value = profile.ClientId })</MudText>
                <MudText Typo="Typo.body2">@L.Format("Plugins.Providers.AuthorizationValue", new { value = profile.AuthorizationEndpoint })</MudText>
                <MudStack Row="true" Class="mt-2">
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => EditProvider(profile))" Disabled="@(_busy || !CanEditProvider(profile.Id))">@L["Plugins.Providers.ViewOrEdit"]</MudButton>
                    @if (!profile.ManagedByDeployment)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteProviderAsync(profile))" Disabled="_busy">@L["Common.Delete"]</MudButton>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudPaper>

    }

            </section>
        </MudTabPanel>
        <MudTabPanel Text="@L["Plugins.Tabs.Find"]" Disabled="_busy">
            <section class="plugins-tab-content" aria-label="@L["Plugins.Tabs.Find"]">
                <div class="configuration-section-header">
                    <div><MudText Typo="Typo.h6">@L["Plugins.Catalog.Title"]</MudText><MudText Color="Color.Secondary">@L["Plugins.Catalog.Intro"]</MudText></div>
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => ChangeTab(2))">@L["Plugins.Catalog.InstallLink"]</MudButton>
                </div>
                <MudTextField T="string" @bind-Value="_catalogSearch" Immediate="true" Placeholder="@L["Plugins.Catalog.Search"]" aria-label="@L["Plugins.Catalog.Search"]" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Class="mt-4" />
                <div class="plugin-categories">
                    @foreach (var category in new[] { "All", "Connections", "Development" })
                    {
                        <MudButton Variant="@(_catalogCategory == category ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" OnClick="@(() => _catalogCategory = category)" aria-pressed="@(_catalogCategory == category)">@L[$"Plugins.Catalog.Category.{category}"]</MudButton>
                    }
                </div>
                <div class="plugin-catalog-grid">
                    @foreach (var entry in FilteredCatalog)
                    {
                        var installed = _installations.FirstOrDefault(x => x.AgentId == entry.Id);
                        <MudPaper @key="entry.Id" Outlined="true" Elevation="0" Class="plugin-catalog-card">
                            <div class="configuration-section-header"><PluginCatalogIcon Entry="entry" /><MudText Typo="Typo.caption" Color="Color.Secondary">@L[$"Plugins.Catalog.Category.{entry.Category}"]</MudText></div>
                            <MudText Typo="Typo.h6" Class="mt-4">@entry.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="plugin-catalog-description">@L[entry.DescriptionKey]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">C-Sweet</MudText>
                            @if (installed is not null) { <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Check" OnClick="@(() => OpenInstalled(installed))">@L["Plugins.Catalog.Installed"]</MudButton> }
                            else { <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Outlined.ArrowForward" OnClick="@(() => ReviewCatalogAsync(entry))" Disabled="@(_busy || _loading)">@L["Plugins.Catalog.Review"]</MudButton> }
                        </MudPaper>
                    }
                </div>
                @if (!FilteredCatalog.Any()) { <MudText Color="Color.Secondary" Class="pa-5">@L["Plugins.Catalog.NoMatches"]</MudText> }
            </section>
        </MudTabPanel>
        <MudTabPanel Text="@L["Plugins.Tabs.Install"]" Icon="@Icons.Material.Outlined.Add" Disabled="_busy">
            <section class="plugins-tab-content" aria-label="@L["Plugins.Tabs.Install"]">
                <MudPaper Elevation="0" Outlined="true" Class="surface-panel plugin-install-panel">
                    @if (_preview is null)
                    {
                        <MudText Typo="Typo.h6">@L["Plugins.Import.Title"]</MudText>
                        <MudText Color="Color.Secondary">@L["Plugins.Import.Intro"]</MudText>
                        <div class="plugin-source-methods">
                            <MudButton Variant="@(!_uploadBundle ? Variant.Filled : Variant.Text)" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Link" OnClick="@(() => SetSource(false))" Disabled="_busy" aria-pressed="@(!_uploadBundle)">@L["Plugins.Import.RepositoryLink"]</MudButton>
                            <MudButton Variant="@(_uploadBundle ? Variant.Filled : Variant.Text)" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.UploadFile" OnClick="@(() => SetSource(true))" Disabled="_busy" aria-pressed="@_uploadBundle">@L["Plugins.Import.UploadBundle"]</MudButton>
                        </div>
                        @if (_uploadBundle)
                        {
                            <div class="plugin-bundle-upload">
                                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1">@L["Plugins.Import.ChooseBundle"]</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Plugins.Import.BundleHelp"]</MudText>
                                <InputFile OnChange="BundleSelected" accept=".cspb" disabled="@_busy" aria-label="@L["Plugins.Import.ChooseBundle"]" />
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PreviewAsync" Disabled="@(_busy || _bundle is null)">@L["Plugins.Import.PreviewBundle"]</MudButton>
                        }
                        else
                        {
                            <MudTextField @bind-Value="_repositoryUrl" Immediate="true" Label="@L["Plugins.Import.RepositoryUrl"]" Variant="Variant.Outlined" Disabled="_busy" />
                            <MudExpansionPanels Elevation="0" Class="my-3"><MudExpansionPanel Text="@L["Plugins.Import.ChooseVersion"]"><MudTextField @bind-Value="_commitSha" Label="@L["Plugins.Import.CommitSha"]" HelperText="@L["Plugins.Import.RefHelp"]" Variant="Variant.Outlined" Disabled="_busy" /></MudExpansionPanel></MudExpansionPanels>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Outlined.ArrowForward" OnClick="PreviewAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_repositoryUrl))">@L["Plugins.Import.PreviewManifest"]</MudButton>
                        }
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="plugin-review-hint"><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Size="Size.Small" /> @L["Plugins.Import.ReviewHint"]</MudText>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ArrowBack" OnClick="BackToSource" Disabled="_busy">@L["Plugins.Import.Back"]</MudButton>
                        <MudText Typo="Typo.h6" Class="mt-3">@_preview.AgentName</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@_preview.PublisherName · @($"v{_preview.AgentVersion}") · @_preview.PluginKind</MudText>
                        @if (_preview.PluginKind == "Connector" && _preview.Accounts is null)
                        {
                            <MudSelect T="Guid?" @bind-Value="_businessId" Label="@L["Plugins.Import.Business"]" Variant="Variant.Outlined" Disabled="_busy" Class="mt-4">
                                @foreach (var business in BusinessContext.Businesses) { <MudSelectItem T="Guid?" Value="@((Guid?)business.Id)">@business.Name</MudSelectItem> }
                            </MudSelect>
                            @if (!_businessId.HasValue) { <MudAlert Severity="Severity.Warning">@L["Plugins.Import.BusinessRequired"]</MudAlert> }
                        }
                        else { <MudText Typo="Typo.body2" Class="mt-3">@L["Plugins.Import.SystemScope"]</MudText> }
                        <MudDivider Class="my-4" />
                        <MudText Typo="Typo.subtitle1">@L["Plugins.Import.AccessTitle"]</MudText>
                        @if (_preview.Accounts is { } accounts)
                        {
                            @foreach (var permission in accounts.Permissions)
                            { <MudText Typo="Typo.subtitle2" Class="mt-2">@permission.Label</MudText><MudText Typo="Typo.body2">@permission.Purpose</MudText> }
                            <MudAlert Severity="Severity.Info" Class="mt-3">Installing makes these abilities available to your enterprise. No external account, business or agent receives access yet. After installation, choose Connect account and review the provider's consent page.</MudAlert>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mt-2">@L.Format("Plugins.Import.ProvidedCapabilities", new { values = Format(_preview.Capabilities) })</MudText>
                            <MudText Typo="Typo.body2">@L.Format("Plugins.Import.RequestedCapabilities", new { values = Format(_preview.RequestedCapabilities) })</MudText>
                            <MudText Typo="Typo.body2">@L.Format("Plugins.Import.NetworkAccess", new { values = Format(_preview.RequestedNetworkAccess) })</MudText>
                            <MudText Typo="Typo.body2">@L.Format("Plugins.Import.Subscriptions", new { values = Format(_preview.RequestedSubscriptions) })</MudText>
                        }
                        @foreach (var warning in _preview.Warnings) { <MudAlert Severity="Severity.Warning" Class="mt-2">@warning.Message</MudAlert> }
                        @foreach (var configField in _preview.ConfigurationFields.Where(configField => !configField.Secret && IsConfigurationFieldVisible(configField)))
                        {
                            <MudTextField T="string" Label="@FieldLabel(configField)" Value="@ConfigurationValue(configField.Key)" ValueChanged="@(value => SetConfigurationValue(configField.Key, value))" Immediate="true" Variant="Variant.Outlined" Disabled="_busy" />
                        }
                        <MudExpansionPanels Elevation="0" Class="my-3"><MudExpansionPanel Text="@L["Plugins.Import.PackageDetails"]"><div class="plugin-package-details">
                            <MudText Typo="Typo.body2">@_preview.AgentId</MudText><MudText Typo="Typo.body2">@_preview.RepositoryUrl</MudText>
                            <MudText Typo="Typo.body2">@L.Format("Plugins.Import.ProvidedCapabilities", new { values = Format(_preview.Capabilities) })</MudText>
                            <MudText Typo="Typo.body2">@L.Format("Plugins.Import.RequestedCapabilities", new { values = Format(_preview.RequestedCapabilities) })</MudText>
                            <MudText Typo="Typo.body2">@L.Format("Plugins.Import.NetworkAccess", new { values = Format(_preview.RequestedNetworkAccess) })</MudText>
                            <MudText Typo="Typo.body2">@L.Format("Plugins.Import.Subscriptions", new { values = Format(_preview.RequestedSubscriptions) })</MudText>
                            @if (_preview.BundleDigest is not null) { <MudText Typo="Typo.caption">@L.Format("Plugins.Import.BundleDigest", new { digest = _preview.BundleDigest })</MudText> }
                            else { <MudText Typo="Typo.caption">@L.Format("Plugins.Import.Commit", new { sha = _preview.CommitSha })</MudText> }
                            <MudText Typo="Typo.caption">@L.Format("Plugins.Import.Manifest", new { file = _preview.ManifestFileName, digest = _preview.ManifestDigest })</MudText>
                        </div></MudExpansionPanel></MudExpansionPanels>
                        @if (_preview.WebAccess.Mode == PluginWebAccessMode.AllPublic) { <MudCheckBox @bind-Value="_acknowledgeAllPublic" Label="@L["Plugins.Import.AllPublic"]" Color="Color.Warning" Disabled="_busy" /> }
                        <MudCheckBox @bind-Value="_approve" Label="@L["Plugins.Import.Approve"]" Color="Color.Primary" Disabled="_busy" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="InstallAsync" Disabled="@(!CanInstall)">@L["Plugins.Import.BuildAndInstall"]</MudButton>
                        @if (_preview.Accounts is null && RequiredProviderIds.Count > 0) { <PluginProviderRequirements Declarations="RequiredConnections" Profiles="_providerProfiles" Busy="@(_busy || !_providerProfilesLoaded)" Configure="ConfigureFromReview" /> }
                    }
                    @if (_busy) { <MudProgressLinear Indeterminate="true" Class="mt-4" aria-label="@L["Plugins.Import.Working"]" /> }
                </MudPaper>
            </section>
        </MudTabPanel>
    </MudTabs>
</div>
