@page "/register"
@layout RegistrationLayout
@using System.ComponentModel.DataAnnotations
@using CSweet.Contracts.Auth
@inject IAuthenticationApiClient AuthenticationApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable
@inject IAppLocalizer L
@inject AppCulture Culture

<PageTitle>@L["Register.PageTitle"]</PageTitle>

<section class="registration-sheet" aria-labelledby="registration-title" aria-busy="@_saving">
    @if (_registrationClosed)
    {
        <div class="registration-symbol"><MudIcon Icon="@Icons.Material.Outlined.Lock" /></div>
        <h1 id="registration-title">@L["Register.Closed.Title"]</h1>
        <p class="registration-lead">@L["Register.Closed.Lead"]</p>
        <a class="registration-primary" href="/login">@L["Register.Closed.GoToSignIn"] <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" /></a>
    }
    else if (_accountCreated)
    {
        <span class="registration-eyebrow">@L["Register.Created.Eyebrow"]</span>
        <h1 id="registration-title">@L["Register.Created.Title"]</h1>
        <p class="registration-lead">@L["Register.Created.Lead"]</p>
        @if (_recoveryCodes.Count > 0)
        {
            <div class="registration-codes" aria-label="@L["Register.Codes.AriaLabel"]">
                @foreach (var recoveryCode in _recoveryCodes) { <code>@recoveryCode</code> }
            </div>
            <div class="registration-exports">
                <button type="button" disabled="@_exporting" @onclick="CopyCodesAsync"><MudIcon Icon="@Icons.Material.Outlined.ContentCopy" /> @L["Common.Copy"]</button>
                <button type="button" class="registration-download" disabled="@_exporting" @onclick="DownloadCodesAsync"><MudIcon Icon="@Icons.Material.Outlined.FileDownload" /> @L["Register.Codes.Download"]</button>
                <button type="button" disabled="@_exporting" @onclick="PrintCodesAsync"><MudIcon Icon="@Icons.Material.Outlined.Print" /> @L["Register.Codes.Print"]</button>
            </div>
            @if (_exportMessage is not null) { <p class="registration-feedback @(_exportFailed ? "registration-error" : null)" role="status">@_exportMessage</p> }
            <label class="registration-confirm"><input type="checkbox" @bind="_codesSaved" /><span>@L["Register.Codes.Saved"]</span></label>
            <button type="button" class="registration-primary" disabled="@(!_codesSaved)" @onclick="ContinueToSetup">@L["Register.Codes.ContinueToSetup"] <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" /></button>
            <p class="registration-footnote">@L["Register.Codes.KeepOpen"]</p>
        }
        else
        {
            <p class="registration-error" role="alert">@L["Register.Codes.Missing"]</p>
            @if (_error is not null) { <p class="registration-error" role="alert">@_error</p> }
            <button type="button" class="registration-primary" disabled="@_saving" @onclick="GenerateCodesAsync">@(_saving ? L["Register.Codes.Generating"] : L["Register.Codes.Generate"])</button>
        }
    }
    else
    {
        <span class="registration-eyebrow">@L["Register.Form.Eyebrow"]</span>
        <h1 id="registration-title">@L["Register.Form.Title"]</h1>
        <p class="registration-lead">@L["Register.Form.Lead"]</p>
        <EditForm EditContext="_editContext" OnSubmit="RegisterAsync" class="registration-form" novalidate>
            <DataAnnotationsValidator />
            <fieldset disabled="@_saving">
                <div class="registration-field">
                    <label for="register-name">@L["Register.Form.Name"]</label>
                    <InputText id="register-name" @bind-Value="_model.DisplayName" autocomplete="name" maxlength="160" aria-required="true" aria-describedby="register-name-error" />
                    <div id="register-name-error"><ValidationMessage For="@(() => _model.DisplayName)" /></div>
                </div>
                <div class="registration-field">
                    <label for="register-email">@L["Login.Email"]</label>
                    <InputText id="register-email" type="email" @bind-Value="_model.Email" autocomplete="email" inputmode="email" aria-required="true" aria-describedby="register-email-error" />
                    <div id="register-email-error"><ValidationMessage For="@(() => _model.Email)" /></div>
                </div>
                <div class="registration-field">
                    <label for="register-password">@L["Login.Password"]</label>
                    <div class="registration-password">
                        <InputText id="register-password" type="@(_showPassword ? "text" : "password")" @bind-Value="_model.Password" autocomplete="new-password" aria-required="true" aria-describedby="register-password-error" />
                        <button type="button" aria-label="@(_showPassword ? L["Register.Form.HidePassword"] : L["Register.Form.ShowPassword"])" aria-pressed="@_showPassword" @onclick="() => _showPassword = !_showPassword">@(_showPassword ? L["Register.Form.Hide"] : L["Register.Form.Show"])</button>
                    </div>
                    <div id="register-password-error"><ValidationMessage For="@(() => _model.Password)" /></div>
                </div>
                <div class="registration-field">
                    <label for="register-confirm">@L["Register.Form.ConfirmPassword"]</label>
                    <div class="registration-password">
                        <InputText id="register-confirm" type="@(_showConfirm ? "text" : "password")" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" aria-required="true" aria-describedby="register-confirm-error" />
                        <button type="button" aria-label="@(_showConfirm ? L["Register.Form.HideConfirmation"] : L["Register.Form.ShowConfirmation"])" aria-pressed="@_showConfirm" @onclick="() => _showConfirm = !_showConfirm">@(_showConfirm ? L["Register.Form.Hide"] : L["Register.Form.Show"])</button>
                    </div>
                    <div id="register-confirm-error"><ValidationMessage For="@(() => _model.ConfirmPassword)" /></div>
                </div>
            </fieldset>
            <div class="registration-notice"><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" /><div><strong>@L["Register.Form.Notice.Title"]</strong><span>@L["Register.Form.Notice.Body"]</span></div></div>
            @if (_error is not null) { <p class="registration-error" role="alert">@_error</p> }
            <button type="submit" class="registration-primary" disabled="@_saving"><span role="status">@(_saving ? L["Register.Form.Creating"] : L["Register.Form.Submit"])</span><MudIcon Icon="@Icons.Material.Outlined.ArrowForward" /></button>
        </EditForm>
        <footer class="registration-footer"><span>@L["Register.Form.HaveAccount"]</span><a href="/login">@L["Login.SignIn"]</a></footer>
    }
</section>

@code {
    private readonly RegisterModel _model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _serverErrors = default!;
    private bool _saving, _accountCreated, _registrationClosed, _codesSaved, _exporting, _exportFailed, _showPassword, _showConfirm;
    private string? _error, _exportMessage;
    private IReadOnlyList<string> _recoveryCodes = [];
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        _editContext = new(_model);
        _serverErrors = new(_editContext);
        _editContext.OnFieldChanged += ClearFieldError;
    }

    private void ClearFieldError(object? sender, FieldChangedEventArgs args)
    {
        _serverErrors.Clear(args.FieldIdentifier);
        _editContext.NotifyValidationStateChanged();
    }

    private async Task RegisterAsync()
    {
        if (_saving || _accountCreated || _registrationClosed) return;
        _error = null;
        _serverErrors.Clear();
        if (!_editContext.Validate()) { _error = L["Register.Error.Validation"]; return; }
        _saving = true;
        try
        {
            var result = await AuthenticationApi.RegisterAsync(new RegisterAdminRequest(_model.DisplayName, _model.Email, _model.Password, _model.ConfirmPassword,
                Culture.CurrentCode, Culture.PreferredTimeZoneId ?? Culture.DeviceTimeZoneId));
            if (result.Succeeded)
            {
                _accountCreated = true;
                _recoveryCodes = result.RecoveryCodes ?? [];
                _model.Password = _model.ConfirmPassword = string.Empty;
            }
            else if (result.ErrorCode == "registration_closed") _registrationClosed = true;
            else
            {
                _error = result.Message;
                foreach (var field in result.ValidationErrors ?? new Dictionary<string, string[]>())
                {
                    if (typeof(RegisterModel).GetProperty(field.Key) is not null)
                        _serverErrors.Add(new FieldIdentifier(_model, field.Key), field.Value);
                }
                _editContext.NotifyValidationStateChanged();
            }
        }
        catch (Exception)
        {
            _error = L["Register.Error.Unconfirmed"];
        }
        finally { _saving = false; }
    }

    private async Task GenerateCodesAsync()
    {
        if (_saving || !_accountCreated || _recoveryCodes.Count > 0) return;
        _saving = true; _error = null;
        try
        {
            var result = await AuthenticationApi.RegenerateRecoveryCodesAsync();
            if (result.Succeeded && result.RecoveryCodes is { Count: > 0 }) _recoveryCodes = result.RecoveryCodes;
            else _error = result.Message;
        }
        catch (Exception) { _error = L["Register.Error.GenerateFailed"]; }
        finally { _saving = false; }
    }

    private string RecoveryText => $"{L["Register.RecoveryText.Title"]}{Environment.NewLine}{Environment.NewLine}{string.Join(Environment.NewLine, _recoveryCodes)}";
    private async Task<IJSObjectReference> ModuleAsync() => _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CSweet.UI/js/auth-security.js");
    private Task CopyCodesAsync() => ExportCodesAsync("copyText", L["Register.Export.CopySuccess"], L["Register.Export.CopyFailure"], RecoveryText);
    private Task DownloadCodesAsync() => ExportCodesAsync("downloadText", L["Register.Export.DownloadSuccess"], L["Register.Export.DownloadFailure"], "csweet-root-recovery-codes.txt", RecoveryText);
    private Task PrintCodesAsync() => ExportCodesAsync("printText", L["Register.Export.PrintSuccess"], L["Register.Export.PrintFailure"], L["Register.RecoveryText.Title"], RecoveryText);
    private async Task ExportCodesAsync(string method, string success, string failure, params object[] arguments)
    {
        if (_exporting || _recoveryCodes.Count == 0) return;
        _exporting = true; _exportMessage = null; _exportFailed = false;
        try
        {
            var module = await ModuleAsync();
            if (method == "printText" && !await module.InvokeAsync<bool>(method, arguments))
            { _exportMessage = failure; _exportFailed = true; return; }
            if (method != "printText") await module.InvokeVoidAsync(method, arguments);
            _exportMessage = success;
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { _exportMessage = failure; _exportFailed = true; }
        finally { _exporting = false; }
    }
    private void ContinueToSetup() { if (_codesSaved && _recoveryCodes.Count > 0) Navigation.NavigateTo("/setup", forceLoad: true); }

    public async ValueTask DisposeAsync()
    {
        _editContext.OnFieldChanged -= ClearFieldError;
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "Enter your name."), MaxLength(160)] public string DisplayName { get; set; } = string.Empty;
        [Required(ErrorMessage = "Enter your email."), EmailAddress(ErrorMessage = "Enter a valid email address.")] public string Email { get; set; } = string.Empty;
        [Required(ErrorMessage = "Choose a password.")] public string Password { get; set; } = string.Empty;
        [Required(ErrorMessage = "Confirm your password."), Compare(nameof(Password), ErrorMessage = "The passwords don’t match.")] public string ConfirmPassword { get; set; } = string.Empty;
    }
}
