@page "/settings/security"
@layout SettingsLayout
@inject IAuthenticationApiClient AuthenticationApi
@inject AuthSessionStore AuthSession
@inject IJSRuntime JS
@implements IAsyncDisposable
@inject IAppLocalizer L

<PageTitle>@L["AccountSecurity.PageTitle"]</PageTitle>

<div class="setup-shell">
<div class="page-header"><div>
    <MudText Typo="Typo.overline" Color="Color.Primary">@L["AccountSecurity.Overline"]</MudText>
    <MudText Typo="Typo.h4">@L["AccountSecurity.Title"]</MudText>
    <MudText Color="Color.Secondary">@AuthSession.Current?.Email</MudText>
</div></div>
<MudPaper Elevation="0" Class="surface-panel">
    <MudText Typo="Typo.h6">@L["AccountSecurity.Recovery"]</MudText>
    <div class="setup-check-list mt-4">
        <MudText>@L.Format("AccountSecurity.EmailVerified", new { verified = AuthSession.Current?.IsEmailConfirmed == true })</MudText>
        <MudText>@L.Format("AccountSecurity.EmailRecoveryAvailable", new { available = AuthSession.Current?.EmailRecoveryAvailable == true })</MudText>
    </div>
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">@L["AccountSecurity.RegenerateWarning"]</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="_busy" OnClick="RegenerateAsync" Class="mt-4">@L["AccountSecurity.Regenerate"]</MudButton>
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="@(_codes.Count > 0 ? Severity.Success : Severity.Error)" Variant="Variant.Outlined" Class="mt-4">@_message</MudAlert>
    }
    @if (_codes.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mt-4">@L["AccountSecurity.SaveNow"]</MudText>
        <div class="recovery-code-grid">
            @foreach (var recoveryCode in _codes) { <code>@recoveryCode</code> }
        </div>
        <MudStack Row="true" Class="mt-4">
            <MudButton Variant="Variant.Outlined" OnClick="CopyAsync">@L["Common.Copy"]</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="DownloadAsync">@L["Register.Codes.Download"]</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="PrintAsync">@L["Register.Codes.Print"]</MudButton>
        </MudStack>
    }

</MudPaper>
<MudPaper Elevation="0" Class="surface-panel">
    <EmailDeliverySetupStep ContextLabel="@L["AccountSecurity.EmailDeliveryContext"]" ShowNavigation="false" />
</MudPaper>
</div>

@code {
    private bool _busy;
    private string? _message;
    private IReadOnlyList<string> _codes = [];
    private IJSObjectReference? _module;
    private string Text => $"{L["Register.RecoveryText.Title"]}{Environment.NewLine}{Environment.NewLine}{string.Join(Environment.NewLine, _codes)}";
    private async Task<IJSObjectReference> ModuleAsync() => _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CSweet.UI/js/auth-security.js");

    private async Task RegenerateAsync()
    {
        _busy = true;
        var result = await AuthenticationApi.RegenerateRecoveryCodesAsync();
        _codes = result.RecoveryCodes ?? [];
        _message = result.Message;
        _busy = false;
    }
    private async Task CopyAsync() => await (await ModuleAsync()).InvokeVoidAsync("copyText", Text);
    private async Task DownloadAsync() => await (await ModuleAsync()).InvokeVoidAsync("downloadText", "csweet-root-recovery-codes.txt", Text);
    private async Task PrintAsync() => await (await ModuleAsync()).InvokeVoidAsync("printText", L["Register.RecoveryText.Title"], Text);

    public async ValueTask DisposeAsync() { if (_module is not null) await _module.DisposeAsync(); }
}
