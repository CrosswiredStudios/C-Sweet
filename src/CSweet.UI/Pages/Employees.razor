@page "/organizations/{OrganizationId:guid}/employees"
@using System.Text.Json
@using CSweet.Contracts.Agents
@using CSweet.Contracts.Core
@using CSweet.Contracts.Llm
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IAgentApiClient AgentApi
@inject ILlmProviderApiClient LlmProviderApi

<PageTitle>Employees - C-Sweet</PageTitle>

<div class="command-center-shell employees-page">
    <MudPaper Elevation="0" Class="page-header employees-page-header">
        <div>
            <MudText Typo="Typo.h3">Employees</MudText>
            <MudText Color="Color.Secondary">A reporting graph of human teammates and agent employees.</MudText>
        </div>
        <MudStack Row="true" Spacing="2" Class="employees-header-actions">
            @if (!IsHiringTab)
            {
                <MudButton OnClick="OpenHireDialog" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd">Hire employee</MudButton>
            }
            <MudButton Href="@($"/organizations/{OrganizationId}/command-center")" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Dashboard">Command Center</MudButton>
        </MudStack>
    </MudPaper>

    <EmployeePageTabs OrganizationId="OrganizationId" HiringSelected="IsHiringTab" />

    @if (IsHiringTab)
    {
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                Agents maintain a prioritized list of roles worth hiring next.
                <MudLink Href="@($"/organizations/{OrganizationId}/marketplace")">Browse the agent marketplace</MudLink>.
            </MudAlert>
            @if (_hiringDashboard?.ResourceChanges.Count > 0)
            {
                <MudText Typo="Typo.h5" Class="mb-3">Team design approvals</MudText>
                <MudStack Spacing="3" Class="mb-6">
                    @foreach (var request in _hiringDashboard.ResourceChanges)
                    {
                        <MudPaper Class="pa-5 hiring-recommendation" Elevation="0" Outlined="true">
                            <MudStack Spacing="2">
                                <div class="hiring-heading">
                                    <div>
                                        <MudText Typo="Typo.overline">@request.Status · revision @request.ContextRevision</MudText>
                                        <MudText Typo="Typo.h5">@request.ProductGoal</MudText>
                                        <MudText Color="Color.Secondary">@request.Rationale</MudText>
                                    </div>
                                    <MudChip T="string" Color="@(request.Status == "Pending" ? Color.Warning : request.Status == "Approved" ? Color.Success : Color.Default)">
                                        @request.Status
                                    </MudChip>
                                </div>
                                @foreach (var delta in request.Deltas)
                                {
                                    <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                                        <MudText><strong>@delta.ChangeKind:</strong> @delta.Role.Title (@delta.Role.Team) · @delta.Role.Headcount headcount · priority @delta.Role.Priority</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@delta.Role.Purpose</MudText>
                                    </MudPaper>
                                }
                                @if (request.Status == "Pending" &&
                                     request.ManagerOrganizationUserId == _hiringDashboard.CurrentOrganizationUserId)
                                {
                                    <MudTextField @bind-Value="_resourceFeedback" Label="Decision feedback" Lines="2" Variant="Variant.Outlined" />
                                    <MudStack Row="true" Spacing="1">
                                        <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="_resourceDecisionBusy"
                                                   OnClick="@(() => DecideResourceChangeAsync(request, ResourceChangeDecisionKinds.Approve))">Approve team</MudButton>
                                        <MudButton Color="Color.Warning" Variant="Variant.Outlined" Disabled="_resourceDecisionBusy"
                                                   OnClick="@(() => DecideResourceChangeAsync(request, ResourceChangeDecisionKinds.RequestRevision))">Request revision</MudButton>
                                        <MudButton Color="Color.Error" Variant="Variant.Text" Disabled="_resourceDecisionBusy"
                                                   OnClick="@(() => DecideResourceChangeAsync(request, ResourceChangeDecisionKinds.Reject))">Reject</MudButton>
                                    </MudStack>
                                }
                                else if (!string.IsNullOrWhiteSpace(request.DecisionComment))
                                {
                                    <MudText Typo="Typo.caption">Manager feedback: @request.DecisionComment</MudText>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
            @if (_hiringDashboard?.Recommendations.Count is null or 0)
            {
                <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.h6">No hiring recommendation yet</MudText>
                    <MudText Color="Color.Secondary">The Chief of Staff will maintain the ranked staffing backlog here and surface only the top need in chat.</MudText>
                </MudPaper>
            }
            else
            {
                <MudStack Spacing="3">
                    @foreach (var recommendation in _hiringDashboard!.Recommendations)
                    {
                        <MudPaper Class="@($"pa-5 hiring-recommendation {(Recommendation == recommendation.Id ? "highlighted" : string.Empty)}")" Elevation="0" Outlined="true">
                            <MudStack Spacing="2">
                                <div class="hiring-heading">
                                    <div><MudText Typo="Typo.overline">Priority @recommendation.Priority · @recommendation.Status</MudText><MudText Typo="Typo.h5">@recommendation.Title</MudText><MudText Color="Color.Secondary">@recommendation.Objective</MudText></div>
                                    <MudButton Href="@recommendation.HiringUrl" Variant="Variant.Filled"
                                               Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Storefront">
                                        Browse candidates
                                    </MudButton>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(recommendation.SuggestedBy))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Suggested by @recommendation.SuggestedBy</MudText>
                                }
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Candidate sourcing, security review, installation, and approval continue in Marketplace.</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
        }
    }
    else if (_loading)
    {
        <EmployeeLoadingState />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
    }
    else if (_employees.Count == 0)
    {
        <EmployeeEmptyState HireRequested="OpenHireDialog" />
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_actionError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_actionError</MudAlert>
        }
        <EmployeeViewToggle Value="_activeView" ValueChanged="ChangeViewAsync" />
        @if (_activeView == EmployeeViewKind.Graph)
        {
            <EmployeeGraphView Employees="PresentedEmployees"
                               Teams="_teamDirectory.Teams"
                               SelectedId="_selectedEmployeeId"
                               SelectedIdChanged="SelectEmployeeAsync"
                               Degrees="_graphDegrees"
                               DegreesChanged="ChangeDegreesAsync"
                               TeamSelected="FocusTeamAsync"
                               ActionRequested="HandleEmployeeActionAsync" />
        }
        else if (_activeView == EmployeeViewKind.Teams)
        {
            <TeamClustersView Directory="_teamDirectory"
                              Employees="PresentedEmployees"
                              FocusTeamId="_focusedTeamId"
                              SelectedEmployeeId="_selectedEmployeeId"
                              EmployeeSelected="SelectEmployeeAsync"
                              ActionRequested="HandleTeamActionAsync" />
        }
        else
        {
            <EmployeeDirectoryView Employees="PresentedEmployees"
                                   Roles="_roles"
                                   Teams="_teamDirectory.Teams"
                                   Filter="_directoryFilter"
                                   FilterChanged="ChangeFilterAsync"
                                   SelectedId="_selectedEmployeeId"
                                   EmployeeSelected="SelectEmployeeAsync"
                                   ActionRequested="HandleEmployeeActionAsync" />
        }
    }
</div>

<MudDialog @bind-Visible="_teamDialogOpen" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@(_editingTeam is null ? "Create team" : $"Edit {_editingTeam.Name}")</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_teamName" Label="Team name" Variant="Variant.Outlined" Required="true" />
            <MudTextField @bind-Value="_teamDescription" Label="Description" Lines="3" Variant="Variant.Outlined" />
            <MudSelect T="Guid?" @bind-Value="_teamLeadId" Label="Required lead" Variant="Variant.Outlined" Required="true">
                @foreach (var employee in _employees.OrderBy(x => x.DisplayName))
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)employee.Id)">@employee.DisplayName — @EmployeeLabel(employee)</MudSelectItem>
                }
            </MudSelect>
            @if (_editingTeam is null)
            {
                <MudText Typo="Typo.subtitle2">Initial members and team-specific roles</MudText>
                @foreach (var employee in _employees.OrderBy(x => x.DisplayName))
                {
                    var unavailable = IsAgentBoundToAnotherTeam(employee, null);
                    <MudPaper Elevation="0" Outlined="true" Class="pa-2">
                        <MudCheckBox T="bool" Value="@_teamInitialMemberIds.Contains(employee.Id)"
                                     ValueChanged="@(value => ToggleInitialTeamMember(employee.Id, value))"
                                     Disabled="@unavailable"
                                     Label="@employee.DisplayName" />
                        @if (unavailable)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">This agent employee is lifetime-bound to another team. Hire another installation for this team.</MudText>
                        }
                        @if (_teamInitialMemberIds.Contains(employee.Id))
                        {
                            <MudSelect T="Guid?" Value="@InitialTeamRole(employee.Id)"
                                       ValueChanged="@(value => SetInitialTeamRole(employee.Id, value))"
                                       Label="Team role" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                                @foreach (var role in _roles.OrderBy(x => x.Name))
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)">@role.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </MudPaper>
                }
            }
            @if (_teamRevisionConflict)
            {
                <MudAlert Severity="Severity.Warning">The team changed while you were editing. Your values were retained and current state was reloaded.</MudAlert>
                <MudCheckBox T="bool" @bind-Value="_teamRevisionReviewed" Label="I reviewed the current team state and want to retry." />
            }
            @if (!string.IsNullOrWhiteSpace(_teamMutationError))
            {
                <MudAlert Severity="Severity.Error">@_teamMutationError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _teamDialogOpen = false)">Cancel</MudButton>
        <MudButton OnClick="SaveTeamAsync" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_teamMutationBusy || (_teamRevisionConflict && !_teamRevisionReviewed))">
            @(_teamMutationBusy ? "Saving..." : "Review and save")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_teamMemberDialogOpen" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Add or reactivate team member</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudSelect T="Guid?" @bind-Value="_teamMemberId" Label="Employee" Variant="Variant.Outlined">
                @foreach (var employee in _employees.OrderBy(x => x.DisplayName))
                {
                    var unavailable = IsAgentBoundToAnotherTeam(employee, _editingTeam?.Id);
                    <MudSelectItem T="Guid?" Value="@((Guid?)employee.Id)" Disabled="@unavailable">
                        @employee.DisplayName — @(unavailable ? "hire another agent installation" : EmployeeLabel(employee))
                    </MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Guid?" @bind-Value="_teamMemberRoleId" Label="Team-specific role" Variant="Variant.Outlined" Clearable="true">
                @foreach (var role in _roles.OrderBy(x => x.Name))
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)">@role.Name</MudSelectItem>
                }
            </MudSelect>
            @if (!string.IsNullOrWhiteSpace(_teamMutationError))
            {
                <MudAlert Severity="Severity.Error">@_teamMutationError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _teamMemberDialogOpen = false)">Cancel</MudButton>
        <MudButton OnClick="SaveTeamMemberAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="_teamMutationBusy">Save membership</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_teamConfirmDialogOpen" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@_teamConfirmTitle</MudText></TitleContent>
    <DialogContent><MudText>@_teamConfirmMessage</MudText></DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _teamConfirmDialogOpen = false)">Cancel</MudButton>
        <MudButton OnClick="ConfirmTeamActionAsync" Variant="Variant.Filled" Color="@(_pendingTeamAction?.Action == TeamUiActionKind.Restore ? Color.Primary : Color.Error)" Disabled="_teamMutationBusy">Confirm</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_configurationDialogOpen" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Configure @_configurationEmployee?.DisplayName</MudText></TitleContent>
    <DialogContent>
        @if (_loadingConfiguration)
        {
            <MudStack Spacing="2" role="status" aria-live="polite">
                <MudText Typo="Typo.subtitle2">Loading configuration from the control plane...</MudText>
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            </MudStack>
        }
        else if (!string.IsNullOrWhiteSpace(_configurationError))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@_configurationError</MudAlert>
        }
        else if (_configurationSchema is not null)
        {
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                        @(_configurationView?.SynchronizationStatus ?? "Unknown")
                    </MudChip>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               Disabled="@(_savingConfiguration || _configurationView?.OverriddenKeys.Count == 0)"
                               OnClick="RestoreAllConfigurationAsync">
                        Restore all defaults
                    </MudButton>
                </MudStack>
                @foreach (var field in _configurationSchema.Fields)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        @if (IsConfigurationOverridden(field.Key))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Overridden</MudChip>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@_savingConfiguration"
                                       OnClick="@(() => RestoreConfigurationKeyAsync(field.Key))">Use default</MudButton>
                        }
                    </MudStack>
                    @if (field.Type == AgentConfigurationFieldTypes.Boolean)
                    {
                        <MudCheckBox T="bool" Label="@field.Label" Value="@ConfigurationBoolean(field.Key)" ValueChanged="@(value => SetConfigurationValue(field.Key, value))" />
                    }
                    else if (field.Type == AgentConfigurationFieldTypes.Number)
                    {
                        <MudNumericField T="decimal?" Label="@field.Label" Value="@ConfigurationNumber(field.Key)" ValueChanged="@(value => SetConfigurationValue(field.Key, value))" Min="@field.Minimum" Max="@field.Maximum" Variant="Variant.Outlined" />
                    }
                    else if (field.Type == AgentConfigurationFieldTypes.Select)
                    {
                        <MudSelect T="string" Label="@field.Label" Value="@ConfigurationString(field.Key)" ValueChanged="@((string value) => SetConfigurationValue(field.Key, value))" Variant="Variant.Outlined">
                            @foreach (var option in field.Options ?? [])
                            {
                                <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else if (field.Type == AgentConfigurationFieldTypes.LlmProvider)
                    {
                        <MudSelect T="string" Label="@field.Label" Value="@ConfigurationString(field.Key)" ValueChanged="@(value => SetProviderValueAsync(field.Key, value))" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@string.Empty">Select a provider</MudSelectItem>
                            @foreach (var provider in _providerProfiles.Where(x => x.IsEnabled))
                            {
                                <MudSelectItem T="string" Value="@provider.Id.ToString()">@provider.Name</MudSelectItem>
                            }
                        </MudSelect>
                        @if (!string.IsNullOrWhiteSpace(ModelCatalogError(field)))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error">@ModelCatalogError(field)</MudText>
                        }
                    }
                    else if (field.Type == AgentConfigurationFieldTypes.LlmModel)
                    {
                        <MudSelect T="string" Label="@field.Label" Value="@ConfigurationString(field.Key)" ValueChanged="@(value => SetConfigurationValue(field.Key, value))" Variant="Variant.Outlined" Disabled="@IsModelPickerDisabled(field)">
                            <MudSelectItem T="string" Value="@string.Empty">@ModelPlaceholder(field)</MudSelectItem>
                            @if (SelectedModelMissing(field))
                            {
                                <MudSelectItem T="string" Value="@ConfigurationString(field.Key)">@ConfigurationString(field.Key)</MudSelectItem>
                            }
                            @foreach (var model in ModelOptions(field))
                            {
                                <MudSelectItem T="string" Value="@model">@model</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudTextField Label="@field.Label" Value="@ConfigurationString(field.Key)" ValueChanged="@((string value) => SetConfigurationValue(field.Key, value))" Lines="@(field.Type == AgentConfigurationFieldTypes.TextArea ? 4 : 1)" Variant="Variant.Outlined" />
                    }
                    @if (!string.IsNullOrWhiteSpace(field.Description))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@field.Description</MudText>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(_configurationMessage))
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@_configurationMessage</MudAlert>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseConfiguration" Disabled="@_savingConfiguration">Close</MudButton>
        <MudButton OnClick="SaveConfigurationAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_savingConfiguration || _configurationSchema is null)">
            @(_savingConfiguration ? "Saving..." : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_runtimeConsoleOpen" Options="_runtimeConsoleOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Terminal" />
            <MudText Typo="Typo.h6">@_runtimeConsoleEmployee?.DisplayName console</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_loadingRuntimeConsole)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (!string.IsNullOrWhiteSpace(_runtimeConsoleError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_runtimeConsoleError</MudAlert>
        }
        else if (_runtimeRuns.Count == 0)
        {
            <MudText Color="Color.Secondary">No runtime attempts have been recorded for this instance.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true">
                @foreach (var run in _runtimeRuns)
                {
                    <MudExpansionPanel Text="@($"{run.QueuedAt.LocalDateTime:g} · {run.Status}")">
                        <MudStack Spacing="1">
                            @if (!string.IsNullOrWhiteSpace(run.Reason))
                            {
                                <MudAlert Severity="@RuntimeRunSeverity(run.Status)" Dense="true" Variant="Variant.Outlined">@run.Reason</MudAlert>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Runtime @run.Id · Tick @run.TickId</MudText>
                            <pre class="agent-build-log">@RuntimeEventLog(run)</pre>
                            @if (!string.IsNullOrWhiteSpace(run.LogExcerpt))
                            {
                                <MudText Typo="Typo.subtitle2">Container output</MudText>
                                <pre class="agent-build-log">@run.LogExcerpt</pre>
                            }
                        </MudStack>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@_loadingRuntimeConsole" OnClick="RefreshRuntimeConsoleAsync">Refresh</MudButton>
        <MudButton Variant="Variant.Text" OnClick="CloseRuntimeConsole">Close</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_hireDialogOpen" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Hire employee</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            @if (!string.IsNullOrWhiteSpace(_actionError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_actionError</MudAlert>
            }
            <MudTextField Label="Name" @bind-Value="_hireName" Required="true" Variant="Variant.Outlined" Disabled="@_saving" />
            <MudTextField Label="Email (optional)" @bind-Value="_hireEmail" InputType="InputType.Email" Variant="Variant.Outlined" Disabled="@_saving" />
            <MudSelect T="int" Label="Employee type" @bind-Value="_hireEmployeeType" Variant="Variant.Outlined" Disabled="@_saving">
                <MudSelectItem T="int" Value="0">Human</MudSelectItem>
                <MudSelectItem T="int" Value="1">Agent</MudSelectItem>
            </MudSelect>
            @if (_hireEmployeeType == 1)
            {
                <MudSelect T="string" Label="Agent" @bind-Value="_hireAgentKey" Required="true" Variant="Variant.Outlined" Disabled="@_saving">
                    @foreach (var agent in AvailableAgents)
                    {
                        <MudSelectItem T="string" Value="@agent.Key">@agent.Name</MudSelectItem>
                    }
                </MudSelect>
                @if (AvailableAgents.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        No enabled agents are available. Add or enable an agent before hiring an agent employee.
                    </MudAlert>
                }
            }
            <MudSelect T="Guid?" Label="@(_hireEmployeeType == 1 ? "Managed by (required)" : "Managed by")"
                       @bind-Value="_hireManagerId" Required="@(_hireEmployeeType == 1)"
                       Clearable="@(_hireEmployeeType != 1)" Variant="Variant.Outlined" Disabled="@_saving">
                @foreach (var employee in _employees)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)employee.Id)">@employee.DisplayName</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.subtitle2">Team assignments</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @(_hireEmployeeType == 1
                    ? "An AI employee instance can join at most one team for its lifetime."
                    : "Humans and contractors may join several teams with an independent role in each.")
            </MudText>
            @foreach (var team in _teamDirectory.Teams.Where(team => !team.IsArchived).OrderBy(team => team.Name))
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-2">
                    <MudCheckBox T="bool" Label="@team.Name"
                                 Value="@_hireTeamIds.Contains(team.Id)"
                                 ValueChanged="@(value => SetHireTeam(team.Id, value))"
                                 Disabled="_saving" />
                    @if (_hireTeamIds.Contains(team.Id))
                    {
                        <MudSelect T="Guid?" Value="@HireTeamRole(team.Id)"
                                   ValueChanged="@(value => SetHireTeamRole(team.Id, value))"
                                   Label="Team-specific role" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var role in _roles.OrderBy(role => role.Name))
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)">@role.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudPaper>
            }
            <MudText Typo="Typo.subtitle2">Manages</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Select existing employees who will report to this new hire.</MudText>
            @if (_employees.Count == 0)
            {
                <MudText Color="Color.Secondary">There are no existing employees to assign.</MudText>
            }
            else
            {
                <div class="employee-management-picker">
                    @foreach (var employee in _employees)
                    {
                        <MudCheckBox T="bool"
                                     Label="@employee.DisplayName"
                                     Value="@_managedEmployeeIds.Contains(employee.Id)"
                                     ValueChanged="@(value => SetManaged(employee.Id, value))"
                                     Disabled="@(_saving || _hireManagerId == employee.Id)" />
                    }
                </div>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseHireDialog" Disabled="@_saving">Cancel</MudButton>
        <MudButton OnClick="HireAsync" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_saving || (_hireEmployeeType == 1 && !_hireManagerId.HasValue))">
            @(_saving ? "Hiring..." : "Hire")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_roleDialogOpen" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Change company role</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Color="Color.Secondary">This changes the administrator’s position in this company. System administrator and Owner access remain unchanged.</MudText>
            <MudSelect T="Guid?" Label="Company role" @bind-Value="_selectedRoleId" Clearable="true" Variant="Variant.Outlined" Disabled="_saving">
                @foreach (var role in _roles)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)">@role.Name</MudSelectItem>
                }
            </MudSelect>
            @if (!string.IsNullOrWhiteSpace(_actionError))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_actionError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseRoleDialog" Disabled="_saving">Cancel</MudButton>
        <MudButton OnClick="SaveRoleAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">@(_saving ? "Saving..." : "Save role")</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_fireDialogOpen" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Fire employee?</MudText></TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_actionError))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@_actionError</MudAlert>
        }
        <MudText>Remove <strong>@_employeeToFire?.DisplayName</strong> from this organization?</MudText>
        @if (_employeeToFire?.EmployeeType == 1)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                Firing an agent also permanently removes its conversation history.
            </MudAlert>
        }
        @if (_employeeToFire is not null && SubordinateCount(_employeeToFire) > 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                Their @SubordinateCount(_employeeToFire) direct report(s) will become unassigned.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseFireDialog" Disabled="@_saving">Cancel</MudButton>
        <MudButton OnClick="FireAsync" Variant="Variant.Filled" Color="Color.Error" Disabled="@_saving">@(_saving ? "Firing..." : "Fire")</MudButton>
    </DialogActions>
</MudDialog>
