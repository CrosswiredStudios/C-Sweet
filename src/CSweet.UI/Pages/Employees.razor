@page "/organizations/{OrganizationId:guid}/employees"
@using System.Text.Json
@using CSweet.Contracts.Agents
@using CSweet.Contracts.Core
@using CSweet.Contracts.Llm
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IAgentApiClient AgentApi
@inject IAppLocalizer L

<EmployeePortraitScope OrganizationId="OrganizationId">
<PageTitle>@L["Employees.PageTitle"]</PageTitle>

<div class="command-center-shell aurora-page employee-workspace employees-page">
    <header class="employees-heading">
        <h1>@L["Employees.Employees"]</h1>
        @if (!_loading)
        {
            <span class="employees-census">@_employees.Count people <span aria-hidden="true">·</span> @PresentedTeams.Teams.Count(x => !x.IsArchived) teams</span>
        }
    </header>
    <nav class="employees-navigation" aria-label="@L["Employees.EmployeeViews"]">
        @foreach (var view in new[] { EmployeeViewKind.Graph, EmployeeViewKind.Teams, EmployeeViewKind.Directory })
        {
            <a href="@ViewUrl(view)" aria-current="@(!IsHiringTab && _activeView == view ? "page" : null)"
               class="@(!IsHiringTab && _activeView == view ? "active" : null)">@(view == EmployeeViewKind.Graph ? "Org chart" : view.ToString())</a>
        }
        <a href="@($"/organizations/{OrganizationId}/employees?tab=hiring")" aria-current="@(IsHiringTab ? "page" : null)" class="@(IsHiringTab ? "active" : null)">@L["Employees.Hiring"]</a>
    </nav>
    @if (IsHiringTab)
    {
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }
        else
        {
            <MudButton OnClick="OpenHireDialog" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd">@L["Employees.AddEmployee"]</MudButton>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                @L["Employees.ReviewProposedTeamChangesAnd"]
                <MudLink Href="@($"/organizations/{OrganizationId}/marketplace")">@L["Employees.BrowseTheAgentMarketplace"]</MudLink>.
            </MudAlert>
            @if (_hiringDashboard?.ResourceChanges.Count > 0)
            {
                <MudText Typo="Typo.h5" Class="mb-3">@L["Employees.TeamDesignApprovals"]</MudText>
                <MudStack Spacing="3" Class="mb-6">
                    @foreach (var request in _hiringDashboard.ResourceChanges)
                    {
                        <MudPaper Class="pa-5 hiring-recommendation" Elevation="0" Outlined="true">
                            <MudStack Spacing="2">
                                <div class="hiring-heading">
                                    <div>
                                        <MudText Typo="Typo.overline">Team proposal · revision @request.ContextRevision</MudText>
                                        <MudText Typo="Typo.h5">@request.ProductGoal</MudText>
                                        <MudText Color="Color.Secondary">@request.Rationale</MudText>
                                    </div>
                                    <MudChip T="string" Color="@(request.Status == "Pending" ? Color.Warning : request.Status == "Approved" ? Color.Success : Color.Default)">
                                        @request.Status
                                    </MudChip>
                                </div>
                                @foreach (var delta in request.Deltas)
                                {
                                    <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                                        <MudText><strong>@delta.ChangeKind:</strong> <ResourceRoleTitle Role="delta.Role" /> (@delta.Role.Team) · @delta.Role.Headcount headcount · priority @delta.Role.Priority</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@delta.Role.Purpose</MudText>
                                    </MudPaper>
                                }
                                @if (request.Status == "Pending" &&
                                     request.ManagerOrganizationUserId == _hiringDashboard.CurrentOrganizationUserId)
                                {
                                    <MudTextField @bind-Value="_resourceFeedback" Label="@L["Employees.DecisionFeedback"]" Lines="2" Variant="Variant.Outlined" />
                                    <MudStack Row="true" Spacing="1">
                                        <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="_resourceDecisionBusy"
                                                   OnClick="@(() => DecideResourceChangeAsync(request, ResourceChangeDecisionKinds.Approve))">@L["Employees.ApproveTeam"]</MudButton>
                                        <MudButton Color="Color.Warning" Variant="Variant.Outlined" Disabled="_resourceDecisionBusy"
                                                   OnClick="@(() => DecideResourceChangeAsync(request, ResourceChangeDecisionKinds.RequestRevision))">@L["Employees.RequestRevision"]</MudButton>
                                        <MudButton Color="Color.Error" Variant="Variant.Text" Disabled="_resourceDecisionBusy"
                                                   OnClick="@(() => DecideResourceChangeAsync(request, ResourceChangeDecisionKinds.Reject))">@L["Common.Reject"]</MudButton>
                                    </MudStack>
                                }
                                else if (!string.IsNullOrWhiteSpace(request.DecisionComment))
                                {
                                    <MudText Typo="Typo.caption">Manager feedback: @request.DecisionComment</MudText>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
            @if (_hiringDashboard?.Recommendations.Count is null or 0)
            {
                <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.h6">@L["Employees.NoHiringRecommendationYet"]</MudText>
                    <MudText Color="Color.Secondary">@L["Employees.NewStaffingRecommendationsWillAppear"]</MudText>
                </MudPaper>
            }
            else
            {
                <MudStack Spacing="3">
                    @foreach (var recommendation in _hiringDashboard!.Recommendations)
                    {
                        <MudPaper Class="@($"pa-5 hiring-recommendation {(Recommendation == recommendation.Id ? "highlighted" : string.Empty)}")" Elevation="0" Outlined="true">
                            <MudStack Spacing="2">
                                <div class="hiring-heading">
                                    <div><MudText Typo="Typo.overline">Priority @recommendation.Priority · @recommendation.Status</MudText><MudText Typo="Typo.h5">@recommendation.Title</MudText><MudText Color="Color.Secondary">@recommendation.Objective</MudText></div>
                                    <MudButton Href="@recommendation.HiringUrl" Variant="Variant.Filled"
                                               Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Storefront">
                                        @L["Employees.BrowseCandidates"]
                                    </MudButton>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(recommendation.SuggestedBy))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Suggested by @recommendation.SuggestedBy</MudText>
                                }
                                @if (recommendation.SourceResourceChangeRequestId.HasValue)
                                {
                                    <details class="hiring-provenance"><summary>@L["Employees.RequestDetails"]</summary><MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Requested by @(recommendation.RequestingEmployee ?? "delivery manager")
                                        · team @(recommendation.RequestingTeam ?? recommendation.TeamId?.ToString("D") ?? "not scoped")
                                        · assigned to @(recommendation.AssignedApprover ?? "manager")
                                        · decided by @(recommendation.ActualDecisionMaker ?? "pending")
                                        · source @recommendation.SourceResourceChangeRequestId
                                    </MudText></details>
                                }

                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
        }
    }
    else if (_loading)
    {
        <EmployeeLoadingState />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
    }
    else if (_employees.Count == 0)
    {
        <EmployeeEmptyState HireRequested="OpenHireDialog" />
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_actionError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_actionError</MudAlert>
        }
        @if (_activeView == EmployeeViewKind.Graph)
        {
            <EmployeeGraphView Employees="PresentedEmployees" />
        }
        else if (_activeView == EmployeeViewKind.Teams)
        {
            <TeamClustersView Directory="PresentedTeams"
                              Employees="PresentedEmployees"
                              ActionRequested="HandleTeamActionAsync" />
        }
        else
        {
            <EmployeeDirectoryView Employees="PresentedEmployees"
                                   Roles="_roles"
                                   Teams="PresentedTeams.Teams"
                                   Filter="_directoryFilter"
                                   FilterChanged="ChangeFilterAsync"
                                   SelectedId="_selectedEmployeeId"
                                   EmployeeSelected="OpenEmployeeDetailsAsync"
                                   ActionRequested="HandleEmployeeActionAsync" />
        }
    }
</div>

<MudDialog @bind-Visible="_teamDialogOpen" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@(_editingTeam is null ? "Create team" : $"Edit {_editingTeam.Name}")</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_teamName" Label="@L["Employees.TeamName"]" Variant="Variant.Outlined" Required="true" />
            <MudTextField @bind-Value="_teamDescription" Label="@L["Employees.Description"]" Lines="3" Variant="Variant.Outlined" />
            <MudSelect T="Guid?" @bind-Value="_teamLeadId" Label="@L["Employees.RequiredLead"]" Variant="Variant.Outlined" Required="true">
                @foreach (var employee in _employees.OrderBy(x => x.DisplayName))
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)employee.Id)">@employee.DisplayName — @EmployeeLabel(employee)</MudSelectItem>
                }
            </MudSelect>
            @if (_editingTeam is null)
            {
                <MudText Typo="Typo.subtitle2">@L["Employees.InitialMembersAndTeamSpecific"]</MudText>
                @foreach (var employee in _employees.OrderBy(x => x.DisplayName))
                {
                    var unavailable = IsAgentBoundToAnotherTeam(employee, null);
                    <MudPaper Elevation="0" Outlined="true" Class="pa-2">
                        <MudCheckBox T="bool" Value="@_teamInitialMemberIds.Contains(employee.Id)"
                                     ValueChanged="@(value => ToggleInitialTeamMember(employee.Id, value))"
                                     Disabled="@unavailable"
                                     Label="@employee.DisplayName" />
                        @if (unavailable)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">@L["Employees.ThisAgentEmployeeIsLifetime"]</MudText>
                        }
                        @if (_teamInitialMemberIds.Contains(employee.Id))
                        {
                            <MudSelect T="Guid?" Value="@InitialTeamRole(employee.Id)"
                                       ValueChanged="@(value => SetInitialTeamRole(employee.Id, value))"
                                       Label="@L["Employees.TeamRole"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                                @foreach (var role in _roles.OrderBy(x => x.Name))
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)">@role.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </MudPaper>
                }
            }
            @if (_teamRevisionConflict)
            {
                <MudAlert Severity="Severity.Warning">@L["Employees.TheTeamChangedWhileYou"]</MudAlert>
                <MudCheckBox T="bool" @bind-Value="_teamRevisionReviewed" Label="@L["Employees.IReviewedTheCurrentTeam"]" />
            }
            @if (!string.IsNullOrWhiteSpace(_teamMutationError))
            {
                <MudAlert Severity="Severity.Error">@_teamMutationError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _teamDialogOpen = false)">@L["Common.Cancel"]</MudButton>
        <MudButton OnClick="SaveTeamAsync" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_teamMutationBusy || (_teamRevisionConflict && !_teamRevisionReviewed))">
            @(_teamMutationBusy ? "Saving..." : "Review and save")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_teamMemberDialogOpen" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@L["Employees.AddOrReactivateTeamMember"]</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudSelect T="Guid?" @bind-Value="_teamMemberId" Label="@L["Employees.Employee"]" Variant="Variant.Outlined">
                @foreach (var employee in _employees.OrderBy(x => x.DisplayName))
                {
                    var unavailable = IsAgentBoundToAnotherTeam(employee, _editingTeam?.Id);
                    <MudSelectItem T="Guid?" Value="@((Guid?)employee.Id)" Disabled="@unavailable">
                        @employee.DisplayName — @(unavailable ? "hire another agent installation" : EmployeeLabel(employee))
                    </MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Guid?" @bind-Value="_teamMemberRoleId" Label="@L["Employees.TeamSpecificRole"]" Variant="Variant.Outlined" Clearable="true">
                @foreach (var role in _roles.OrderBy(x => x.Name))
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)">@role.Name</MudSelectItem>
                }
            </MudSelect>
            @if (!string.IsNullOrWhiteSpace(_teamMutationError))
            {
                <MudAlert Severity="Severity.Error">@_teamMutationError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _teamMemberDialogOpen = false)">@L["Common.Cancel"]</MudButton>
        <MudButton OnClick="SaveTeamMemberAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="_teamMutationBusy">@L["Employees.SaveMembership"]</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_teamConfirmDialogOpen" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@_teamConfirmTitle</MudText></TitleContent>
    <DialogContent><MudText>@_teamConfirmMessage</MudText></DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _teamConfirmDialogOpen = false)">@L["Common.Cancel"]</MudButton>
        <MudButton OnClick="ConfirmTeamActionAsync" Variant="Variant.Filled" Color="@(_pendingTeamAction?.Action == TeamUiActionKind.Restore ? Color.Primary : Color.Error)" Disabled="_teamMutationBusy">@L["Common.Confirm"]</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_configurationDialogOpen" Options="_dialogOptions" Class="aurora-page employee-configuration-dialog">
    <TitleContent><MudText Typo="Typo.h6">Configure @_configurationEmployee?.DisplayName</MudText></TitleContent>
    <DialogContent>
        @if (_configurationDialogOpen && _configurationEmployee is not null)
        {
            <EmployeeConfigurationPanel @key="_configurationEmployee.Id" OrganizationId="OrganizationId" EmployeeId="_configurationEmployee.Id" />
        }
    </DialogContent>
</MudDialog>

<MudDialog @bind-Visible="_runtimeConsoleOpen" Options="_runtimeConsoleOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Terminal" />
            <MudText Typo="Typo.h6">@_runtimeConsoleEmployee?.DisplayName console</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_loadingRuntimeConsole)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (!string.IsNullOrWhiteSpace(_runtimeConsoleError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_runtimeConsoleError</MudAlert>
        }
        else if (_runtimeRuns.Count == 0)
        {
            <MudText Color="Color.Secondary">@L["Employees.NoRuntimeAttemptsHaveBeen"]</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true">
                @foreach (var run in _runtimeRuns)
                {
                    <MudExpansionPanel Text="@($"{run.QueuedAt.LocalDateTime:g} · {run.Status}")">
                        <MudStack Spacing="1">
                            @if (!string.IsNullOrWhiteSpace(run.Reason))
                            {
                                <MudAlert Severity="@RuntimeRunSeverity(run.Status)" Dense="true" Variant="Variant.Outlined">@run.Reason</MudAlert>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Runtime @run.Id · Tick @run.TickId</MudText>
                            <pre class="agent-build-log">@RuntimeEventLog(run)</pre>
                            @if (!string.IsNullOrWhiteSpace(run.LogExcerpt))
                            {
                                <MudText Typo="Typo.subtitle2">@L["Employees.ContainerOutput"]</MudText>
                                <pre class="agent-build-log">@run.LogExcerpt</pre>
                            }
                        </MudStack>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@_loadingRuntimeConsole" OnClick="RefreshRuntimeConsoleAsync">@L["Common.Refresh"]</MudButton>
        <MudButton Variant="Variant.Text" OnClick="CloseRuntimeConsole">@L["Common.Close"]</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_hireDialogOpen" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@L["Employees.HireEmployee"]</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            @if (!string.IsNullOrWhiteSpace(_actionError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_actionError</MudAlert>
            }
            <MudTextField Label="@L["Employees.Name"]" @bind-Value="_hireName" Required="true" Variant="Variant.Outlined" Disabled="@_saving" />
            <MudTextField Label="Email (optional)" @bind-Value="_hireEmail" InputType="InputType.Email" Variant="Variant.Outlined" Disabled="@_saving" />
            <MudSelect T="int" Label="@L["Employees.EmployeeType"]" @bind-Value="_hireEmployeeType" Variant="Variant.Outlined" Disabled="@_saving">
                <MudSelectItem T="int" Value="0">@L["Employees.Human"]</MudSelectItem>
                <MudSelectItem T="int" Value="1">@L["Employees.Agent"]</MudSelectItem>
            </MudSelect>
            @if (_hireEmployeeType == 1)
            {
                <MudSelect T="string" Label="@L["Employees.Agent"]" @bind-Value="_hireAgentKey" Required="true" Variant="Variant.Outlined" Disabled="@_saving">
                    @foreach (var agent in AvailableAgents)
                    {
                        <MudSelectItem T="string" Value="@agent.Key">@agent.Name</MudSelectItem>
                    }
                </MudSelect>
                @if (AvailableAgents.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        @L["Employees.NoEnabledAgentsAreAvailable"]
                    </MudAlert>
                }
            }
            <MudSelect T="Guid?" Label="@(_hireEmployeeType == 1 ? "Managed by (required)" : "Managed by")"
                       @bind-Value="_hireManagerId" Required="@(_hireEmployeeType == 1)"
                       Clearable="@(_hireEmployeeType != 1)" Variant="Variant.Outlined" Disabled="@_saving">
                @foreach (var employee in _employees)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)employee.Id)">@employee.DisplayName</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.subtitle2">@L["Employees.TeamAssignments"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @(_hireEmployeeType == 1
                    ? "An AI employee instance can join at most one team for its lifetime."
                    : "Humans and contractors may join several teams with an independent role in each.")
            </MudText>
            @foreach (var team in _teamDirectory.Teams.Where(team => !team.IsArchived).OrderBy(team => team.Name))
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-2">
                    <MudCheckBox T="bool" Label="@team.Name"
                                 Value="@_hireTeamIds.Contains(team.Id)"
                                 ValueChanged="@(value => SetHireTeam(team.Id, value))"
                                 Disabled="_saving" />
                    @if (_hireTeamIds.Contains(team.Id))
                    {
                        <MudSelect T="Guid?" Value="@HireTeamRole(team.Id)"
                                   ValueChanged="@(value => SetHireTeamRole(team.Id, value))"
                                   Label="@L["Employees.TeamSpecificRole"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var role in _roles.OrderBy(role => role.Name))
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)">@role.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudPaper>
            }
            <MudText Typo="Typo.subtitle2">@L["Employees.Manages"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Employees.SelectExistingEmployeesWhoWill"]</MudText>
            @if (_employees.Count == 0)
            {
                <MudText Color="Color.Secondary">@L["Employees.ThereAreNoExistingEmployees"]</MudText>
            }
            else
            {
                <div class="employee-management-picker">
                    @foreach (var employee in _employees)
                    {
                        <MudCheckBox T="bool"
                                     Label="@employee.DisplayName"
                                     Value="@_managedEmployeeIds.Contains(employee.Id)"
                                     ValueChanged="@(value => SetManaged(employee.Id, value))"
                                     Disabled="@(_saving || _hireManagerId == employee.Id)" />
                    }
                </div>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseHireDialog" Disabled="@_saving">@L["Common.Cancel"]</MudButton>
        <MudButton OnClick="HireAsync" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_saving || (_hireEmployeeType == 1 && !_hireManagerId.HasValue))">
            @(_saving ? "Hiring..." : "Hire")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_roleDialogOpen" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@L["Employees.ChangeCompanyRole"]</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Color="Color.Secondary">@L["Employees.ThisChangesTheAdministratorS"]</MudText>
            <MudSelect T="Guid?" Label="@L["Employees.CompanyRole"]" @bind-Value="_selectedRoleId" Clearable="true" Variant="Variant.Outlined" Disabled="_saving">
                @foreach (var role in _roles)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)">@role.Name</MudSelectItem>
                }
            </MudSelect>
            @if (!string.IsNullOrWhiteSpace(_actionError))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_actionError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseRoleDialog" Disabled="_saving">@L["Common.Cancel"]</MudButton>
        <MudButton OnClick="SaveRoleAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">@(_saving ? "Saving..." : "Save role")</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_fireDialogOpen" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@L["Employees.FireEmployee"]</MudText></TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_actionError))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@_actionError</MudAlert>
        }
        <MudText>@L.Format("Employees.RemoveConfirm", new { name = _employeeToFire?.DisplayName })</MudText>
        @if (_employeeToFire?.EmployeeType == 1)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                @L["Employees.FiringAnAgentAlsoPermanently"]
            </MudAlert>
        }
        @if (_employeeToFire is not null && SubordinateCount(_employeeToFire) > 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                Their @SubordinateCount(_employeeToFire) direct report(s) will become unassigned.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseFireDialog" Disabled="@_saving">@L["Common.Cancel"]</MudButton>
        <MudButton OnClick="FireAsync" Variant="Variant.Filled" Color="Color.Error" Disabled="@_saving">@(_saving ? "Firing..." : "Fire")</MudButton>
    </DialogActions>
</MudDialog>

</EmployeePortraitScope>
