@page "/businesses/{BusinessId:guid}/plugins/{ProviderId:guid}/api-key-accounts"
@layout SettingsLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using CSweet.Contracts.Plugins
@using CSweet.UI.Services
@inject RemoteMcpAccountApiClient Api
<PageTitle>@ProviderName account access</PageTitle>
<main class="plugin-manage remote-mcp-accounts">
    <MudLink Href="/settings/plugins">← Plugins</MudLink>
    <header class="manage-heading">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">API-key account</MudText>
            <MudText Typo="Typo.h4">@ProviderName account access</MudText>
            <MudText Color="Color.Secondary">Your key is stored encrypted by C-Sweet and sent only to the endpoint approved at install review. Agents receive reviewed read results, never the key. Storing a key grants no agent access until you grant it below.</MudText>
        </div>
    </header>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert" Class="mb-4">@_error</MudAlert> }
    @if (_view is null)
    {
        @if (_error is null) { <MudProgressLinear Indeterminate="true" aria-label="Loading account access" /> }
    }
    else
    {
        <MudPaper Outlined="true" Elevation="0" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1">What a grant allows</MudText>
            @if (!string.IsNullOrEmpty(_view.EndpointHost))
            {
                <MudText Typo="Typo.body2" Class="mb-2">Endpoint: <strong>@_view.EndpointHost</strong> (approved at install review).</MudText>
            }
            @if (_view.Tools.Count > 0)
            {
                <ul class="remote-mcp-tools">
                    @foreach (var tool in _view.Tools) { <li>@tool.Description <code>@tool.Capability</code></li> }
                </ul>
            }
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">Account and company identity are enforced by @ProviderName and are not verified or matched to this C-Sweet business.</MudAlert>
        </MudPaper>

        <MudPaper Outlined="true" Elevation="0" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1">@(_view.Connections.Any(c => !c.Revoked) ? "Replace the stored key" : "Store a key")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">The key is never displayed again. Changing or revoking it stops any authorized agent's active and queued work; submit new work after reviewing access.</MudText>
            <div class="remote-mcp-key-row">
                <MudTextField T="string" @bind-Value="_key" Immediate="true" InputType="InputType.Password" Label="API key" Variant="Variant.Outlined" autocomplete="off" maxlength="256" Disabled="_busy" />
                @if (_view.Connections.Any(c => !c.Revoked))
                {
                    var current = _view.Connections.First(c => !c.Revoked);
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_key))" OnClick="@(() => Rotate(current))">Replace key and clear grants</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Key" Disabled="@(_busy || string.IsNullOrWhiteSpace(_key))" OnClick="Connect">Store key</MudButton>
                }
            </div>
        </MudPaper>

        @foreach (var connection in _view.Connections)
        {
            <MudPaper Outlined="true" Elevation="0" Class="pa-4 mb-4">
                <div class="remote-mcp-connection-heading">
                    <MudText Typo="Typo.subtitle1">Connection @connection.Id.ToString("N")[..8]</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@(connection.Revoked ? Color.Default : connection.ConsumerInstallationId is null ? Color.Warning : Color.Success)">
                        @(connection.Revoked ? "Revoked" : connection.ConsumerInstallationId is null ? "Stored · no agent access" : "Access granted")
                    </MudChip>
                </div>
                @if (!connection.Revoked)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Choose the one agent that may perform the reviewed reads above with this account in this business.</MudText>
                    <MudSelect T="Guid" @bind-Value="_consumer" Label="Agent to authorize" Variant="Variant.Outlined" Disabled="_busy">
                        @foreach (var consumer in _view.Consumers) { <MudSelectItem T="Guid" Value="consumer.Id">@consumer.Name</MudSelectItem> }
                    </MudSelect>
                    <MudCheckBox T="bool" @bind-Value="_approved" Disabled="_busy" Label="@($"Allow this agent to perform the reviewed {ProviderName} reads listed above with my account in this business.")" />
                    <div class="remote-mcp-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.VerifiedUser" Disabled="@(_busy || !_approved || _consumer == Guid.Empty)" OnClick="@(() => Grant(connection))">Grant read access</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.LinkOff" Disabled="_busy" OnClick="@(() => Revoke(connection))">Revoke access and remove stored key</MudButton>
                    </div>
                }
            </MudPaper>
        }
    }
</main>
@code {
    [Parameter] public Guid BusinessId { get; set; }
    [Parameter] public Guid ProviderId { get; set; }
    private RemoteMcpAccountView? _view;
    private string ProviderName => string.IsNullOrWhiteSpace(_view?.ProviderName) ? "Provider" : _view!.ProviderName;
    private string _key = "";
    private string? _error;
    private Guid _consumer;
    private bool _approved, _busy;
    protected override Task OnParametersSetAsync() => Run(async () => _view = await Api.GetAsync(BusinessId, ProviderId));
    private Task Connect() => WithKey(async input => await Api.ConnectAsync(BusinessId, ProviderId, input));
    private Task Rotate(RemoteMcpConnectionView c) => WithKey(async input => { input.ExpectedGeneration = c.Generation; await Api.RotateAsync(BusinessId, ProviderId, c.Id, input); });
    private Task Grant(RemoteMcpConnectionView c) => Run(async () => { await Api.GrantAsync(BusinessId, ProviderId, c.Id, new(_consumer, c.Generation, _view!.PackageDigest)); _approved = false; await Reload(); });
    private Task Revoke(RemoteMcpConnectionView c) => Run(async () => { await Api.RevokeAsync(BusinessId, ProviderId, c.Id, new(c.Generation)); await Reload(); });
    private async Task WithKey(Func<RemoteMcpKeyRequest, Task> action)
    {
        var input = new RemoteMcpKeyRequest { Key = _key }; _key = "";
        try { await Run(async () => { await action(input); _approved = false; await Reload(); }); }
        finally { input.Key = ""; _key = ""; }
    }
    private async Task Reload() => _view = await Api.GetAsync(BusinessId, ProviderId);
    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); } catch { _error = "Account settings are unavailable or changed. Refresh and review access again."; }
        finally { _busy = false; }
    }
}
