@page "/organizations/{OrganizationId:guid}/source-control"
@page "/organizations/{OrganizationId:guid}/source-control/{RepositoryId:guid}"
@using CSweet.Contracts.SourceControl
@using CSweet.Contracts.Core
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Source Control</PageTitle>

<MudContainer @key="OrganizationId" MaxWidth="MaxWidth.Large" Class="source-workspace py-6">
    <div class="source-surface @(RepositoryId is null ? null : "repository-open")">
    <div class="source-header">
        <div>
            <MudText Typo="Typo.h3">Source control</MudText>
            <MudText Class="source-description">Your repositories, the latest work, and who has access.</MudText>
        </div>
        @if (_dashboard is { CanManageSourceControl: true })
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                       Disabled="_loading" OnClick="BeginCreate">Create repository</MudButton>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" aria-label="Loading source control" />
    }
    else if (_dashboard is null)
    {
        <MudButton Variant="Variant.Outlined" OnClick="LoadAsync">Try again</MudButton>
    }
    else
    {
        <nav class="source-tabs" aria-label="Source control sections">
            <button type="button" class="@TabClass(WorkspaceSection.Repositories)" aria-current="@CurrentTab(WorkspaceSection.Repositories)" @onclick="() => SelectSection(WorkspaceSection.Repositories)">Repositories</button>
            <button type="button" class="@TabClass(WorkspaceSection.Connections)" aria-current="@CurrentTab(WorkspaceSection.Connections)" @onclick="() => SelectSection(WorkspaceSection.Connections)">Connections</button>
            @if (_dashboard.CanManageSourceControl)
            {
                <button type="button" class="@TabClass(WorkspaceSection.Activity)" aria-current="@CurrentTab(WorkspaceSection.Activity)" @onclick="() => SelectSection(WorkspaceSection.Activity)">Activity</button>
                <button type="button" class="@TabClass(WorkspaceSection.Settings)" aria-current="@CurrentTab(WorkspaceSection.Settings)" @onclick="() => SelectSection(WorkspaceSection.Settings)">Settings</button>
            }
        </nav>
        @if (_section == WorkspaceSection.Repositories && (_dashboard.ActiveOnboarding is not null || _dashboard.Connections.Any(c => c.Status is "AttentionRequired" or "Disconnected")))
        {
            <div class="source-attention">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Color="Color.Warning" />
                <span>@(_dashboard.ActiveOnboarding is not null ? "GitHub setup is not finished." : "A repository connection needs attention.")</span>
                <MudButton OnClick="() => SelectSection(WorkspaceSection.Connections)">View connections</MudButton>
            </div>
        }
        <div hidden="@(_section != WorkspaceSection.Repositories)">
            <InternalRepositoryManager OrganizationId="OrganizationId" CanManage="_dashboard.CanManageSourceControl"
                                       SelectedRepository="RepositoryId" SelectedReference="@SelectedReference" SelectedFile="@SelectedFile"
                                       Repositories="_dashboard.Repositories" Connections="_dashboard.Connections"
                                       @bind-Creating="_creating" OnChanged="LoadAsync" />
        </div>
        @if (_section == WorkspaceSection.Connections)
        {
            <section class="source-section" aria-label="Repository providers">
                <h2>Repository providers</h2>
                <div class="source-provider-list">
                    @foreach (var connection in _dashboard.Connections)
                    {
                        <div class="source-provider">
                            <div class="source-provider-row">
                                <div class="source-row-copy">
                                    <h3>@(connection.Provider == "InternalGit" ? "C-Sweet storage" : connection.Name)</h3>
                                    <p>@(connection.Provider == "InternalGit" ? "Built-in private repositories" : $"{connection.AccountLogin} · {ModeLabel(connection.Mode)}") · @connection.RepositoryCount @(connection.RepositoryCount == 1 ? "repository" : "repositories")</p>
                                </div>
                                <span class="source-status @ConnectionStatusClass(connection.Status)">@StatusLabel(connection.Status)</span>
                                @if (_dashboard.CanManageSourceControl)
                                {
                                    <SourceControlConnectionEditor @key="connection.Id" OrganizationId="OrganizationId" ConnectionId="connection.Id" OnChanged="LoadAsync" />
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(connection.HealthMessage))
                            {
                                <p class="source-health">@connection.HealthMessage</p>
                            }
                        </div>
                    }
                    <div class="source-provider-row">
                        <div class="source-row-copy">
                            <h3>@(_dashboard.Connections.Any(c => c.Provider == "GitHub") ? "Another GitHub account" : "GitHub")</h3>
                            <p>@(_dashboard.PlatformReadiness.ExistingGitHubAvailable ? "Connect existing repositories or use approved templates" : "Not configured · Administrator setup required")</p>
                        </div>
                        @if (_dashboard.CanManageSourceControl)
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="OpenGitHubWizard">Connect GitHub</MudButton>
                        }
                    </div>
                </div>
            </section>
        }
        @if (_dashboard.CanManageSourceControl)
        {
            <MudDialog @bind-Visible="_showGitHubSetup" Options="GitHubDialogOptions">
                <TitleContent><MudText Typo="Typo.h6">Connect GitHub</MudText></TitleContent>
                <DialogContent>
                    <MudStack Spacing="3" aria-live="polite">
                        @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
                        @if (_loadingSetup || _savingSetup) { <MudProgressLinear Indeterminate="true" /> }
                        @if (_connectedAccount is not null)
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" Size="Size.Large" />
                            <MudText Typo="Typo.h5">Connected to @_connectedAccount</MudText>
                            <MudText>@(_creationConfigured ? "Repository creation is enabled." : $"{_connectedRepositoryCount} repositories are ready.")</MudText>
                        }
                        else if (_dashboard.ActiveOnboarding is { ConnectionId: { } connectionId } setup &&
                                 setup.CurrentStep is "choose-projects" or "configure-managed-projects")
                        {
                            <MudText Typo="Typo.h5">@(_dashboard.Connections.FirstOrDefault(c => c.Id == connectionId)?.AccountLogin)</MudText>
                            @if (_availableProjects.Count == 0 && !_loadingSetup)
                            {
                                <MudAlert Severity="Severity.Info">@(setup.CurrentStep == "choose-projects" ? "No repositories are available. Add repositories to the app on GitHub, then retry." : "Choose a template repository on GitHub before enabling creation.")</MudAlert>
                                <MudButton Disabled="_loadingSetup" OnClick="LoadAsync">Retry</MudButton>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2">@(setup.CurrentStep == "choose-projects" ? (_availableProjects.Count > 500 ? "Choose repositories to connect to this business." : "The repositories you allowed on GitHub are selected. Click Done to connect them.") : "Choose a template and team for new repositories.")</MudText>
                                @if (setup.CurrentStep == "choose-projects" && _availableProjects.Count > 500)
                                {
                                    <MudAlert Severity="Severity.Info">Choose up to 500 repositories for this business.</MudAlert>
                                }
                                <MudSelect T="string" Label="@(setup.CurrentStep == "choose-projects" ? "Repositories" : "Templates")"
                                           MultiSelection="true" @bind-SelectedValues="_selectedProjectIds" ToStringFunc="RepositoryName" Disabled="_savingSetup">
                                    @foreach (var project in _availableProjects)
                                    {
                                        <MudSelectItem T="string" Value="@project.RepositoryId">@project.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                @if (setup.CurrentStep == "configure-managed-projects")
                                {
                                    <MudSelect T="Guid" Label="Team" @bind-Value="_defaultTeamId" Disabled="_savingSetup">
                                        @foreach (var team in _teams)
                                        {
                                            <MudSelectItem T="Guid" Value="@team.Id">@team.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudExpansionPanels Elevation="0">
                                        <MudExpansionPanel Text="Creation options">
                                            <MudTextField @bind-Value="_namePrefix" Label="Repository name prefix" Disabled="_savingSetup" />
                                            <MudNumericField T="int" @bind-Value="_maximumProjects" Label="Repository limit" Min="1" Max="500" Disabled="_savingSetup" />
                                            <MudSwitch T="bool" @bind-Value="_managerApprovalRequired" Disabled="_savingSetup">Require manager approval</MudSwitch>
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                }
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           Disabled="@(_savingSetup || _loadingSetup || _selectedProjectIds.Count == 0 || _selectedProjectIds.Count > (setup.CurrentStep == "configure-managed-projects" ? 20 : 500) || (setup.CurrentStep == "configure-managed-projects" && _defaultTeamId == Guid.Empty))"
                                           OnClick="@(() => SaveProjectSetupAsync(connectionId, setup.CurrentStep))">Done</MudButton>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.h5">Connect your GitHub account</MudText>
                            <MudText>Choose your account and the repositories C-Sweet can work with on GitHub.</MudText>
                            <MudCheckBox T="bool" @bind-Value="_allowRepositoryCreation" Label="Allow C-Sweet to create repositories" Disabled="_starting" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Optional. We’ll guide you through the required GitHub approvals.</MudText>
                            @if (!_dashboard.PlatformReadiness.ExistingGitHubAvailable)
                            {
                                <MudText Typo="Typo.body2">A C-Sweet administrator must complete the one-time GitHub setup.</MudText>
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Custom.Brands.GitHub"
                                       Disabled="_starting" OnClick="ContinueConnectionAsync">Continue to GitHub</MudButton>
                        }
                    </MudStack>
                </DialogContent>
                <DialogActions><MudButton Disabled="@(_starting || _savingSetup)" OnClick="() => _showGitHubSetup = false">@(_connectedAccount is null ? "Close" : "Done")</MudButton></DialogActions>
            </MudDialog>
        }
        @if (_section == WorkspaceSection.Activity && _dashboard.CanManageSourceControl)
        {
            <div class="source-section source-activity">
                <SourceControlActivity @key="OrganizationId" OrganizationId="OrganizationId" Repositories="_dashboard.Repositories" />
            </div>
        }
        @if (_section == WorkspaceSection.Settings && _dashboard.CanManageSourceControl)
        {
            <section class="source-section source-settings" aria-label="Repository settings">
                <h2>Repository defaults</h2>
                <div class="source-setting-row">
                    <div class="source-row-copy"><h3>New repository defaults</h3><p>Provider and template for new repositories</p></div>
                    <MudButton Variant="Variant.Outlined" OnClick="() => ToggleSetting(RepositorySetting.Defaults)">@(_setting == RepositorySetting.Defaults ? "Close" : "Edit")</MudButton>
                </div>
                @if (_setting == RepositorySetting.Defaults)
                {
                    <div class="source-settings-editor"><BusinessSourceControlDefaultsEditor OrganizationId="OrganizationId" /></div>
                }
                <div class="source-setting-row">
                    <div class="source-row-copy"><h3>Creation policy</h3><p>Approvals, naming, team defaults, and limits</p></div>
                    <MudButton Variant="Variant.Outlined" OnClick="() => ToggleSetting(RepositorySetting.Creation)">@(_setting == RepositorySetting.Creation ? "Close" : "View")</MudButton>
                </div>
                @if (_setting == RepositorySetting.Creation)
                {
                    <div class="source-settings-editor"><InternalProvisioningSettings OrganizationId="OrganizationId" Expanded="true" /></div>
                }
                <div class="source-setting-row">
                    <div class="source-row-copy"><h3>Backups</h3><p>Schedules, retained copies, and restore</p></div>
                    <MudButton Variant="Variant.Outlined" OnClick="() => ToggleSetting(RepositorySetting.Backups)">@(_setting == RepositorySetting.Backups ? "Close" : "View")</MudButton>
                </div>
                @if (_setting == RepositorySetting.Backups)
                {
                    <div class="source-settings-editor"><InternalGitBackups OrganizationId="OrganizationId" Expanded="true" /></div>
                }
            </section>
        }
        <footer class="source-footer">
            <span>Private repositories for this business</span>
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Outlined.Refresh" OnClick="LoadAsync">Refresh</MudButton>
        </footer>
    }
    </div>
</MudContainer>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid? RepositoryId { get; set; }
    [SupplyParameterFromQuery(Name = "reference")] public string? SelectedReference { get; set; }
    [SupplyParameterFromQuery(Name = "file")] public string? SelectedFile { get; set; }
    [SupplyParameterFromQuery(Name = "connectGitHub")] public bool ConnectGitHub { get; set; }
    [SupplyParameterFromQuery(Name = "allowRepositoryCreation")] public bool AllowRepositoryCreation { get; set; }

    private enum WorkspaceSection { Repositories, Connections, Activity, Settings }
    private WorkspaceSection _section;
    private bool _creating, _showGitHubSetup;
    private string? _connectedAccount;
    private int _connectedRepositoryCount;
    private bool _creationConfigured;
    private Guid? _selectionSession;
    private static readonly DialogOptions GitHubDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false };
    private void OpenGitHubWizard() { _connectedAccount = null; _showGitHubSetup = true; }
    private enum RepositorySetting { None, Defaults, Creation, Backups }
    private RepositorySetting _setting;
    private void ToggleSetting(RepositorySetting setting) => _setting = _setting == setting ? RepositorySetting.None : setting;
    private static string ConnectionStatusClass(string status) => status switch
    {
        "Ready" or "Connected" => "ready",
        "AttentionRequired" => "attention",
        "Disconnected" => "disconnected",
        _ => ""
    };
    private string TabClass(WorkspaceSection section) => _section == section ? "source-tab active" : "source-tab";
    private string? CurrentTab(WorkspaceSection section) => _section == section ? "page" : null;
    private void SelectSection(WorkspaceSection section) => _section = section;
    private void BeginCreate() { _section = WorkspaceSection.Repositories; _creating = true; }
    private SourceControlDashboardResponse? _dashboard;
    private bool _loading;
    private bool _starting, _allowRepositoryCreation;
    private bool _loadingSetup;
    private bool _savingSetup;
    private string? _error;
    private IReadOnlyList<AvailableSourceControlRepository> _availableProjects = [];
    private IReadOnlyList<TeamSummaryResponse> _teams = [];
    private IReadOnlyCollection<string> _selectedProjectIds = [];
    private string RepositoryName(string id) => _availableProjects.FirstOrDefault(p => p.RepositoryId == id)?.Name ?? id;
    private string _namePrefix = "csweet";
    private int _maximumProjects = 20;
    private bool _managerApprovalRequired = true;
    private Guid _defaultTeamId;
    private long _loadVersion;
    private Guid _loadedBusiness;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var business = OrganizationId;
        var version = ++_loadVersion;
        if (_loadedBusiness != business)
        {
            _section = WorkspaceSection.Repositories; _creating = false; _showGitHubSetup = false; _setting = RepositorySetting.None;
            _loadedBusiness = business; _dashboard = null; _availableProjects = []; _teams = [];
            _selectionSession = null; _connectedAccount = null; _selectedProjectIds = []; _defaultTeamId = Guid.Empty; _namePrefix = "csweet";
            _maximumProjects = 20; _managerApprovalRequired = true;
            _allowRepositoryCreation = AllowRepositoryCreation;
        }
        _loading = true;
        _error = null;
        try
        {
            var dashboard = await Http.GetFromJsonAsync<SourceControlDashboardResponse>(
                $"api/organizations/{business:D}/source-control/dashboard");
            if (version != _loadVersion || business != OrganizationId) return;
            var firstLoad = _dashboard is null;
            _dashboard = dashboard;
            if (firstLoad && ConnectGitHub && _dashboard?.CanManageSourceControl == true)
                _showGitHubSetup = true;
            if (firstLoad && RepositoryId is null && _dashboard?.ActiveOnboarding is not null)
            {
                _section = WorkspaceSection.Connections;
                _showGitHubSetup = _dashboard.CanManageSourceControl;
            }
            if (_dashboard is { CanManageSourceControl: true,
                                ActiveOnboarding: { ConnectionId: { } connectionId } active } &&
                active.CurrentStep is "choose-projects" or "configure-managed-projects")
            {
                await LoadProjectSetupAsync(
                    connectionId,
                    active.CurrentStep == "configure-managed-projects", business, version);
            }
        }
        catch (Exception exception)
        {
            if (version == _loadVersion && business == OrganizationId)
            {
                _dashboard = null;
                _error = exception is HttpRequestException { StatusCode: System.Net.HttpStatusCode.Forbidden }
                    ? "You do not have access to source control for this business. Choose a business you can access."
                    : exception is HttpRequestException { StatusCode: System.Net.HttpStatusCode.Unauthorized }
                        ? "Your session has expired. Sign in again to view source control."
                        : "Source control could not be loaded. Try again when the service is available.";
            }
        }
        finally
        {
            if (version == _loadVersion) _loading = false;
        }
    }

    private async Task LoadProjectSetupAsync(Guid connectionId, bool templates, Guid business, long version)
    {
        _loadingSetup = true;
        _availableProjects = [];
        try
        {
            var projects = await Http.GetFromJsonAsync<IReadOnlyList<AvailableSourceControlRepository>>(
                $"api/organizations/{business:D}/source-control/connections/{connectionId:D}/available-projects?templates={templates.ToString().ToLowerInvariant()}") ?? [];
            if (version != _loadVersion || business != OrganizationId) return;
            _availableProjects = projects;
            if (_selectionSession != _dashboard?.ActiveOnboarding?.SessionId)
            {
                _selectionSession = _dashboard?.ActiveOnboarding?.SessionId;
                // GitHub already collected repository consent. Only template choice needs another decision.
                _selectedProjectIds = templates || projects.Count > 500 ? [] : projects.Select(p => p.RepositoryId).ToList();
            }
            if (templates)
            {
                var directory = await Http.GetFromJsonAsync<TeamDirectoryResponse>(
                    $"api/core/organizations/{business:D}/teams?includeArchived=false");
                if (version != _loadVersion || business != OrganizationId) return;
                _teams = directory?.Teams.Where(team => !team.IsArchived).ToList() ?? [];
                if (_defaultTeamId == Guid.Empty && _teams.Count > 0)
                    _defaultTeamId = _teams[0].Id;
            }
        }
        catch (Exception)
        {
            if (version == _loadVersion && business == OrganizationId)
                _error = "Repositories could not be loaded. Retry when GitHub is available.";
        }
        finally
        {
            if (version == _loadVersion) _loadingSetup = false;
        }
    }

    private async Task SaveProjectSetupAsync(Guid connectionId, string step)
    {
        _savingSetup = true;
        _error = null;
        try
        {
            HttpResponseMessage response;
            if (step == "choose-projects")
            {
                response = await Http.PutAsJsonAsync(
                    $"api/organizations/{OrganizationId:D}/source-control/connections/{connectionId:D}/existing-projects",
                    new SelectExistingCodeProjectsRequest(_selectedProjectIds.ToList()));
            }
            else
            {
                response = await Http.PutAsJsonAsync(
                    $"api/organizations/{OrganizationId:D}/source-control/connections/{connectionId:D}/managed-policy",
                    new ConfigureManagedCodeProjectsRequest(
                        _selectedProjectIds.ToList(), _namePrefix, _maximumProjects,
                        _managerApprovalRequired, _defaultTeamId, null));
            }
            using (response)
            {
                if (!response.IsSuccessStatusCode)
                    throw new InvalidOperationException(await response.Content.ReadAsStringAsync());
            }
            _connectedAccount = _dashboard?.Connections.FirstOrDefault(c => c.Id == connectionId)?.AccountLogin;
            _connectedRepositoryCount = _selectedProjectIds.Count;
            _creationConfigured = step == "configure-managed-projects";
            _selectedProjectIds = [];
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _savingSetup = false;
        }
    }

    private Task ContinueConnectionAsync()
    {
        if (!_dashboard!.PlatformReadiness.ExistingGitHubAvailable ||
            (_allowRepositoryCreation && !_dashboard.PlatformReadiness.ManagedGitHubAvailable))
        {
            Navigation.NavigateTo($"/settings/source-control?business={OrganizationId:D}&allowRepositoryCreation={_allowRepositoryCreation.ToString().ToLowerInvariant()}");
            return Task.CompletedTask;
        }
        return StartAsync(_allowRepositoryCreation ? "ManagedGitHub" : "ExistingGitHub");
    }

    private async Task StartAsync(string mode)
    {
        _starting = true;
        _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/organizations/{OrganizationId:D}/source-control/onboarding",
                new StartSourceControlOnboardingRequest(mode));
            if (!response.IsSuccessStatusCode)
            {
                _error = await ReadApiErrorAsync(response);
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<StartSourceControlOnboardingResponse>()
                ?? throw new InvalidOperationException("Source-control setup returned no authorization link.");
            Navigation.NavigateTo(result.AuthorizationUrl, forceLoad: true);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _starting = false;
        }
    }

    private static async Task<string> ReadApiErrorAsync(HttpResponseMessage response)
    {
        var content = await response.Content.ReadAsStringAsync();
        try
        {
            using var json = System.Text.Json.JsonDocument.Parse(content);
            if (json.RootElement.TryGetProperty("message", out var message) &&
                !string.IsNullOrWhiteSpace(message.GetString()))
                return message.GetString()!;
        }
        catch (System.Text.Json.JsonException)
        {
        }
        return string.IsNullOrWhiteSpace(content)
            ? "C-Sweet could not start GitHub setup."
            : content;
    }

    private static string ModeLabel(string mode) => mode switch
    {
        "ManagedGitHub" => "Full access",
        "ExistingGitHub" => "Existing GitHub projects",
        _ => "Advanced Git"
    };

    private static string StatusLabel(string status) => status switch
    {
        "Connected" or "Ready" => "Ready",
        "AttentionRequired" => "Needs attention",
        "Pending" or "Provisioning" => "Setup in progress",
        "Disconnected" => "Disconnected",
        _ => status
    };

    private static Color StatusColor(string status) => status switch
    {
        "Connected" or "Ready" => Color.Success,
        "AttentionRequired" => Color.Warning,
        "Disconnected" => Color.Error,
        _ => Color.Default
    };

    private static string StepLabel(string step) => step switch
    {
        "authorize-source-access" => "Authorize access to code projects",
        "authorize-provisioner" => "Authorize private-project creation",
        "choose-projects" => "Choose existing code projects",
        "configure-managed-projects" => "Choose project rules and a default team",
        _ => step
    };
}
