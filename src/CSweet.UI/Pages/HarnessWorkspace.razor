@page "/agents/{InstallationId:guid}/harness"
@using CSweet.Contracts.Agents
@using WorkspaceResponse = CSweet.Contracts.Agents.HarnessWorkspace
@inject HttpClient Http
@inject AppRealtimeState Realtime
@implements IDisposable
@inject IAppLocalizer L
<PageTitle>@L["HarnessWorkspace.PageTitle"]</PageTitle>
<main class="harness-page">
    <header class="harness-heading"><div><span class="harness-eyebrow">@L["HarnessWorkspace.AgentControls"]</span><h1>@L["HarnessWorkspace.ExecutionWorkspace"]</h1><p>@L["HarnessWorkspace.InspectReadinessChooseModelsAnd"]</p></div><button class="harness-button" @onclick="LoadAsync" disabled="@_busy">@L["Common.Refresh"]</button></header>
    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    @if (_notice is not null) { <MudAlert Severity="Severity.Success">@_notice</MudAlert> }
    @if (_changedElsewhere) { <MudAlert Severity="Severity.Info">@L["HarnessWorkspace.ThisAgentSPolicyOr"] <button class="harness-button" @onclick="LoadAsync" disabled="@_busy">@L["HarnessWorkspace.Reload"]</button> @L["HarnessWorkspace.UnsavedEditsHereWillBe"]</MudAlert> }
    @if (_workspace is { } workspace)
    {
        <MudTabs KeepPanelsAlive="true" Rounded="true" Elevation="0">
            <MudTabPanel Text="@L["HarnessWorkspace.Doctor"]" Icon="@Icons.Material.Outlined.HealthAndSafety">
                <p class="harness-description">@L.Format("HarnessWorkspace.ReadOnlyChecks", new { checkedAt = workspace.CheckedAt.ToLocalTime().ToString("g") })</p>
                <div class="doctor-grid">
                    @foreach (var finding in workspace.Findings)
                    {
                        <article class="doctor-card"><span class="doctor-state @finding.State.ToLowerInvariant()">@finding.State</span><h2>@finding.Title</h2><p>@finding.Detail</p><a href="@finding.RepairUrl">@L["HarnessWorkspace.OpenSettings"] <span aria-hidden="true">↗</span></a></article>
                    }
                </div>
            </MudTabPanel>
            <MudTabPanel Text="@L["HarnessWorkspace.ModelsBudgets"]" Icon="@Icons.Material.Outlined.Tune">
                <section class="harness-section"><h2>@L["HarnessWorkspace.ContextEfficiency"]</h2><p>@L["HarnessWorkspace.CompactExactRepeatedToolResults"]</p>
                    <MudSwitch T="bool" @bind-Value="_compact" Label="@L["HarnessWorkspace.CompactDuplicateContext"]" />
                    <MudSwitch T="bool" @bind-Value="_decision" Disabled="@(!_compact)" Label="@L["HarnessWorkspace.UseDecisionModel"]" />
                    <p class="harness-description">@(workspace.DecisionModel is { Available: true } engine ? L.Format("HarnessWorkspace.DecisionModelAvailable", new { host = engine.Host, model = engine.Model }) : L["HarnessWorkspace.DecisionModelUnavailable"])</p>
                </section>
                <section class="harness-section"><h2>@L["HarnessWorkspace.SharedTaskCeilings"]</h2><p>@L["HarnessWorkspace.CanonicalChildWorkAndRetries"]</p>
                    <div class="harness-fields"><MudNumericField T="long?" @bind-Value="_tokens" Label="@L["HarnessWorkspace.TaskTokenCeiling"]" Min="1" Variant="Variant.Outlined" /><MudNumericField T="decimal?" @bind-Value="_cost" Label="@L["HarnessWorkspace.TaskCostCeiling"]" Min="0.000001m" Variant="Variant.Outlined" /></div>
                </section>
                <section class="harness-section"><h2>@L["HarnessWorkspace.StageRoutes"]</h2><p>@L["HarnessWorkspace.StageRoutesHelp"]</p>
                    @foreach (var route in _routes)
                    {
                        <div class="route-fields" @key="route"><MudTextField @bind-Value="route.Stage" Label="@L["HarnessWorkspace.StageKey"]" Variant="Variant.Outlined" /><MudSelect T="Guid" @bind-Value="route.Provider" Label="@L["HarnessWorkspace.Provider"]" Variant="Variant.Outlined">@foreach (var provider in workspace.Providers) { <MudSelectItem T="Guid" Value="provider.Id">@provider.Name</MudSelectItem> }</MudSelect><MudTextField @bind-Value="route.Model" Label="@L["HarnessWorkspace.Model"]" Variant="Variant.Outlined" /><MudNumericField T="decimal?" @bind-Value="route.Input" Min="0" Label="@L["HarnessWorkspace.Input1M"]" Variant="Variant.Outlined" /><MudNumericField T="decimal?" @bind-Value="route.Output" Min="0" Label="@L["HarnessWorkspace.Output1M"]" Variant="Variant.Outlined" /><button class="harness-button" @onclick="() => _routes.Remove(route)" aria-label="@L["HarnessWorkspace.RemoveRoute"]">@L["Common.Remove"]</button></div>
                        @foreach (var fallback in route.Fallbacks)
                        {
                            <div class="route-fields route-fallback" @key="fallback"><span class="fallback-label">@L.Format("HarnessWorkspace.FallbackNumber", new { number = route.Fallbacks.IndexOf(fallback) + 1 })</span><MudSelect T="Guid" @bind-Value="fallback.Provider" Label="@L["HarnessWorkspace.Provider"]" Variant="Variant.Outlined">@foreach (var provider in workspace.Providers) { <MudSelectItem T="Guid" Value="provider.Id">@provider.Name</MudSelectItem> }</MudSelect><MudTextField @bind-Value="fallback.Model" Label="@L["HarnessWorkspace.Model"]" Variant="Variant.Outlined" /><MudNumericField T="decimal?" @bind-Value="fallback.Input" Min="0" Label="@L["HarnessWorkspace.Input1M"]" Variant="Variant.Outlined" /><MudNumericField T="decimal?" @bind-Value="fallback.Output" Min="0" Label="@L["HarnessWorkspace.Output1M"]" Variant="Variant.Outlined" /><button class="harness-button" @onclick="() => route.Fallbacks.Remove(fallback)" aria-label="@L["HarnessWorkspace.RemoveFallback"]">@L["Common.Remove"]</button></div>
                        }
                        <button class="harness-button route-add-fallback" @onclick="() => route.Fallbacks.Add(new())" disabled="@(route.Fallbacks.Count >= 3)">@(string.IsNullOrWhiteSpace(route.Stage) ? L["HarnessWorkspace.AddFallback"] : L.Format("HarnessWorkspace.AddFallbackTo", new { stage = route.Stage }))</button>
                    }
                    <button class="harness-button" @onclick="() => _routes.Add(new())" disabled="@(_routes.Count >= 32)">@L["HarnessWorkspace.AddRoute"]</button>
                </section>
                <button class="harness-button primary" @onclick="SaveAsync" disabled="@_busy">@L["HarnessWorkspace.SavePolicy"]</button><span class="harness-revision">@L.Format("HarnessWorkspace.RevisionNumber", new { revision = workspace.Policy.Revision })</span>
            </MudTabPanel>
            <MudTabPanel Text="@L["HarnessWorkspace.Skills"]" Icon="@Icons.Material.Outlined.AutoStories">
                <section class="harness-section"><h2>@L["HarnessWorkspace.PinnedInstructions"]</h2><p>@L["HarnessWorkspace.PublishingCreatesAnImmutableBusiness"]</p>
                    @foreach (var skill in workspace.Skills)
                    {
                        <article class="skill-card"><MudCheckBox T="bool" Value="@_skills.Contains(skill.Id)" ValueChanged="@(value => Pin(skill.Id, value))" Disabled="@(!skill.Enabled && !_savedSkills.Contains(skill.Id))" Label="@L.Format(skill.Enabled ? "HarnessWorkspace.SkillLabel" : "HarnessWorkspace.SkillLabelDisabled", new { name = skill.Name, version = skill.Version })" /><code>@skill.Digest</code><details><summary>@L["HarnessWorkspace.ReadInstructions"]</summary><pre>@skill.Instructions</pre><p>@L.Format("HarnessWorkspace.Requires", new { capabilities = string.Join(", ", skill.RequiredCapabilities) })</p></details>@if (skill.Enabled) { <button class="harness-button" @onclick="() => DisableAsync(skill.Id)" disabled="@_busy">@L["HarnessWorkspace.DisableRevision"]</button> }</article>
                    }
                    <button class="harness-button primary" @onclick="SaveAsync" disabled="@_busy">@L["HarnessWorkspace.SaveAssignment"]</button>
                </section>
                <section class="harness-section"><h2>@L["HarnessWorkspace.PublishARevision"]</h2><div class="harness-fields"><MudTextField @bind-Value="_name" Label="@L["HarnessWorkspace.SkillName"]" Variant="Variant.Outlined" /><MudTextField @bind-Value="_capabilities" Label="@L["HarnessWorkspace.RequiredCapabilities"]" Variant="Variant.Outlined" /></div><MudTextField @bind-Value="_instructions" Label="@L["HarnessWorkspace.Instructions"]" Lines="8" Variant="Variant.Outlined" /><button class="harness-button" disabled="@_busy" @onclick="PublishAsync">@L["HarnessWorkspace.PublishRevision"]</button></section>
            </MudTabPanel>
            <MudTabPanel Text="@L["HarnessWorkspace.Judgments"]" Icon="@Icons.Material.Outlined.FactCheck">
                <section class="harness-section"><h2>@L["HarnessWorkspace.AdvisoryJudgments"]</h2><MudNumericField T="int" @bind-Value="_judgmentOutputTokens" Label="@L["HarnessWorkspace.JudgmentOutputTokenLimit"]" Min="64" Max="4096" Variant="Variant.Outlined" /><button class="harness-button" @onclick="SaveAsync" disabled="@_busy">@L["HarnessWorkspace.SaveJudgmentLimit"]</button><p>@L["HarnessWorkspace.JudgmentsHelp"]</p><p>@L.Format("HarnessWorkspace.JudgeGrantNote", new { grant = "platform.harness.judge" })</p></section>
            </MudTabPanel>
        </MudTabs>
    }
    else if (_busy) { <MudProgressLinear Indeterminate="true" /> }
</main>
@code {
    [Parameter] public Guid InstallationId { get; set; }
    private WorkspaceResponse? _workspace;
    private string? _error, _notice;
    private bool _busy, _compact, _decision = true;
    private int _judgmentOutputTokens = 512;
    private long? _tokens;
    private decimal? _cost;
    private string _name = "", _instructions = "", _capabilities = "";
    private readonly List<RouteEditor> _routes = [];
    private readonly HashSet<Guid> _skills = [];
    // Pins as last loaded: a disabled revision can be unpinned and re-pinned until saved, never newly pinned.
    private readonly HashSet<Guid> _savedSkills = [];
    private sealed class RouteEditor { public string Stage { get; set; } = "Default"; public Guid Provider { get; set; } public string Model { get; set; } = ""; public decimal? Input { get; set; } public decimal? Output { get; set; } public List<TargetEditor> Fallbacks { get; } = []; }
    private sealed class TargetEditor { public Guid Provider { get; set; } public string Model { get; set; } = ""; public decimal? Input { get; set; } public decimal? Output { get; set; } }
    protected override Task OnParametersSetAsync() => LoadAsync();
    private bool _changedElsewhere;
    protected override void OnInitialized() => Realtime.EventReceived += OnRealtime;
    public void Dispose() => Realtime.EventReceived -= OnRealtime;
    // Realtime is a wake hint: re-read, and flag only a real difference so this page's own saves stay quiet.
    private void OnRealtime(CSweet.Contracts.Realtime.AppRealtimeEventEnvelope message)
    {
        if (message.EventType != CSweet.Contracts.Realtime.AppRealtimeEvents.HarnessChanged || message.Subject != InstallationId.ToString("D")) return;
        _ = InvokeAsync(async () =>
        {
            if (_workspace is null || _busy) return;
            try
            {
                var current = await Http.GetFromJsonAsync<WorkspaceResponse>($"api/agents/{InstallationId:D}/harness");
                if (current is null || _workspace is null) return;
                _changedElsewhere = current.Policy.Revision != _workspace.Policy.Revision ||
                    !current.Skills.Select(x => (x.Id, x.Enabled)).SequenceEqual(_workspace.Skills.Select(x => (x.Id, x.Enabled)));
                StateHasChanged();
            }
            catch (HttpRequestException) { }
        });
    }
    private void Pin(Guid id, bool value) { if (value) _skills.Add(id); else _skills.Remove(id); }
    private async Task LoadAsync()
    {
        // A reload starts from a clean slate; Mutate sets its notice only after a successful reload.
        _busy = true; _error = null; _notice = null; _changedElsewhere = false;
        try {
            _workspace = await Http.GetFromJsonAsync<WorkspaceResponse>($"api/agents/{InstallationId:D}/harness");
            if (_workspace is { } w) {
                _judgmentOutputTokens = w.Policy.JudgmentOutputTokens; _compact = w.Policy.CompactContext; _decision = w.Policy.DecisionCompaction; _tokens = w.Policy.TaskTokenLimit; _cost = w.Policy.TaskCostLimit;
                _routes.Clear();
                foreach (var x in w.Policy.Routes ?? [])
                {
                    var editor = new RouteEditor { Stage = x.Stage, Provider = x.ProviderId, Model = x.Model, Input = x.InputPricePerMillion, Output = x.OutputPricePerMillion };
                    editor.Fallbacks.AddRange((x.Fallbacks ?? []).Select(f => new TargetEditor { Provider = f.ProviderId, Model = f.Model, Input = f.InputPricePerMillion, Output = f.OutputPricePerMillion }));
                    _routes.Add(editor);
                }
                _skills.Clear(); _skills.UnionWith(w.Policy.SkillRevisionIds ?? []);
                _savedSkills.Clear(); _savedSkills.UnionWith(_skills);
            }
        } catch (HttpRequestException) { _workspace = null; _error = L["HarnessWorkspace.ThisWorkspaceIsUnavailableOr"]; }
        finally { _busy = false; }
    }
    private async Task SaveAsync()
    {
        if (_workspace is null) return;
        if (_routes.Any(x => x.Provider == Guid.Empty || x.Fallbacks.Any(f => f.Provider == Guid.Empty))) { _notice = null; _error = L["HarnessWorkspace.SelectAProviderForEvery"]; return; }
        var policy = new HarnessPolicy(_workspace.Policy.Revision, _compact, _tokens, _cost,
            _routes.Select(x => new HarnessRoute(x.Stage.Trim(), x.Provider, x.Model.Trim(), x.Input, x.Output,
                x.Fallbacks.Count == 0 ? null : x.Fallbacks.Select(f => new HarnessRouteTarget(f.Provider, f.Model.Trim(), f.Input, f.Output)).ToArray())).ToArray(),
            _skills.ToArray(), _judgmentOutputTokens, _decision);
        await Mutate(async () => await Http.PutAsJsonAsync($"api/agents/{InstallationId:D}/harness", new SaveHarnessPolicy(_workspace.Policy.Revision, policy)), L["HarnessWorkspace.PolicySaved"]);
    }
    private Task PublishAsync() => Mutate(async () => await Http.PostAsJsonAsync($"api/agents/{InstallationId:D}/harness/skills", new PublishHarnessSkill(_name, _instructions, _capabilities.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))), L["HarnessWorkspace.SkillPublished"]);
    private Task DisableAsync(Guid id) => Mutate(() => Http.DeleteAsync($"api/agents/{InstallationId:D}/harness/skills/{id:D}"), L["HarnessWorkspace.RevisionDisabled"]);
    private async Task Mutate(Func<Task<HttpResponseMessage>> action, string notice)
    {
        _busy = true; _error = null; _notice = null;
        try { using var response = await action(); if (!response.IsSuccessStatusCode) { var failure = response.Content.Headers.ContentType?.MediaType == "application/json" ? await response.Content.ReadFromJsonAsync<Dictionary<string, string>>() : null; _error = failure?.GetValueOrDefault("error") ?? L["HarnessWorkspace.ChangeNotSaved"]; return; } await LoadAsync(); if (_error is null) _notice = notice; }
        catch (Exception error) when (error is HttpRequestException or System.Text.Json.JsonException) { _error = L["HarnessWorkspace.TheChangeCouldNotBe"]; }
        finally { _busy = false; }
    }
}
