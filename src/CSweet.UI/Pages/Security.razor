@page "/organizations/{OrganizationId:guid}/security"
@using System.Net
@using System.Net.Http.Json
@using CSweet.Contracts.Security
@inject HttpClient Http
@inject IAppLocalizer L
@inject UserTime Time

<PageTitle>@L["Security.PageTitle"]</PageTitle>

<EmployeePortraitScope OrganizationId="OrganizationId">
<div class="aurora-page business-workspace security-audit-page">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="security-audit-heading">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">@L["Security.Overline"]</MudText>
            <MudText Typo="Typo.h4">@L["Security.Title"]</MudText>
            <MudText Color="Color.Secondary">@L["Security.Lead"]</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Refresh"
                   Disabled="_loading" OnClick="ReloadAsync">@L["Common.Refresh"]</MudButton>
    </MudStack>

    <div class="security-audit-filters">
        <MudSelect T="string" Label="@L["Security.TimeRange"]" Value="_range" ValueChanged="OnRangeChanged" Variant="Variant.Outlined" Dense="true">
            <MudSelectItem T="string" Value="@("24h")">@L["Security.Range.24h"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("7d")">@L["Security.Range.7d"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("30d")">@L["Security.Range.30d"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("all")">@L["Security.Range.All"]</MudSelectItem>
        </MudSelect>
        <MudSelect T="string" Label="@L["Security.Category"]" Value="_category" ValueChanged="OnCategoryChanged" Variant="Variant.Outlined" Dense="true">
            <MudSelectItem T="string" Value="@string.Empty">@L["Security.AllCategories"]</MudSelectItem>
            @foreach (var value in Categories) { <MudSelectItem T="string" Value="@value">@Label("SecurityCategory", value)</MudSelectItem> }
        </MudSelect>
        <MudSelect T="string" Label="@L["Security.Outcome"]" Value="_outcome" ValueChanged="OnOutcomeChanged" Variant="Variant.Outlined" Dense="true">
            <MudSelectItem T="string" Value="@string.Empty">@L["Security.AllOutcomes"]</MudSelectItem>
            @foreach (var value in Outcomes) { <MudSelectItem T="string" Value="@value">@Label("SecurityOutcome", value)</MudSelectItem> }
        </MudSelect>
        <MudSelect T="string" Label="@L["Security.Actor"]" Value="_actorKind" ValueChanged="OnActorChanged" Variant="Variant.Outlined" Dense="true">
            <MudSelectItem T="string" Value="@string.Empty">@L["Security.AllActors"]</MudSelectItem>
            @foreach (var value in ActorKinds) { <MudSelectItem T="string" Value="@value">@Label("SecurityActorKind", value)</MudSelectItem> }
        </MudSelect>
        <MudTextField Label="@L["Common.Search"]" @bind-Value="_search" Variant="Variant.Outlined"
                      Placeholder="@L["Security.SearchPlaceholder"]" Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Outlined.Search" Immediate="true" DebounceInterval="350" OnDebounceIntervalElapsed="ReloadAsync" Clearable="true" />
        <MudSwitch T="bool" Value="_groupModelResponses" ValueChanged="OnGroupModelResponsesChanged" Color="Color.Primary"
                   Label="@L["Security.GroupModelResponses"]" />
    </div>

    @if (_forbidden)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
            @L["Security.Forbidden"]
        </MudAlert>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert>
    }
    else
    {
        @if (_items.Any(x => x.IntegrityStatus != "Verified"))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-4">
                @L["Security.IntegrityWarning"]
            </MudAlert>
        }

        <MudTable T="SecurityEventSummaryResponse" Items="_items" Dense="true" Hover="true" Breakpoint="Breakpoint.Md"
                  Loading="_loading" Class="security-audit-table mt-4" AriaLabel="@L["Security.TableAriaLabel"]">
            <HeaderContent>
                <MudTh>@L["Security.Column.Time"]</MudTh><MudTh>@L["Security.Column.Activity"]</MudTh><MudTh>@L["Security.Actor"]</MudTh><MudTh>@L["Security.Column.Target"]</MudTh><MudTh>@L["Security.Column.Direction"]</MudTh><MudTh>@L["Security.Outcome"]</MudTh><MudTh>@L["Security.Column.Integrity"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Security.Column.Time"]"><button class="security-event-link" @onclick="@(() => OpenDetailAsync(context.Id, _groupModelResponses))">@FormatTime(context.OccurredAt)</button></MudTd>
                <MudTd DataLabel="@L["Security.Column.Activity"]">
                    <MudText Typo="Typo.body2">
                        @if (context.ActivityHref is { } href)
                        { <MudLink Href="@href"><strong>@ActivityLabel(context)</strong></MudLink> }
                        else
                        { <strong>@ActivityLabel(context)</strong> }
                    </MudText>
                    @if (context.ModelResponseChunkCount is int chunks)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L.Format("Security.PartsCombined", new { count = chunks })</MudText>
                    }
                    @if (context.Category == "DocumentAccess" && context.EntityId.HasValue)
                    {
                        @if (context.EventType.Contains(".package.", StringComparison.Ordinal))
                        { <MudLink Href="@($"/organizations/{OrganizationId:D}/documents?packageId={context.EntityId:D}")">@L["Security.OpenPackage"]</MudLink> }
                        else if (!context.EventType.Contains(".folder.", StringComparison.Ordinal))
                        { <MudLink Href="@($"/organizations/{OrganizationId:D}/documents?artifact={context.EntityId:D}")">@L["Security.OpenDocument"]</MudLink> }
                    }
                </MudTd>
                <MudTd DataLabel="@L["Security.Actor"]">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        @if (context.ActorKind == "Agent")
                        {
                            <span class="security-actor-avatar" aria-hidden="true"><PersonAvatarContent EmployeeId="context.ActorEmployeeId" IsAgent="true" /></span>
                        }
                        <div><MudText Typo="Typo.body2">@context.ActorDisplayName</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@Label("SecurityActorKind", context.ActorKind)</MudText></div>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="@L["Security.Column.Target"]">@Value(context.TargetDisplayName)</MudTd>
                <MudTd DataLabel="@L["Security.Column.Direction"]">@Label("SecurityDirection", context.Direction)</MudTd>
                <MudTd DataLabel="@L["Security.Outcome"]"><MudChip T="string" Size="Size.Small" Color="@OutcomeColor(context.Outcome)">@Label("SecurityOutcome", context.Outcome)</MudChip></MudTd>
                <MudTd DataLabel="@L["Security.Column.Integrity"]"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@IntegrityColor(context.IntegrityStatus)">@Label("SecurityIntegrity", context.IntegrityStatus)</MudChip></MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Color="Color.Secondary" Class="pa-4">@L["Security.NoEvents"]</MudText>
            </NoRecordsContent>
        </MudTable>

        @if (_nextCursor is not null)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="_loadingMore" OnClick="LoadMoreAsync" Class="mt-3">
                @(_loadingMore ? L["Common.Loading"] : L["Security.LoadMore"])
            </MudButton>
        }
    }
</div>

<MudDialog @bind-Visible="_detailOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">@L["Security.EventDialogTitle"]</MudText></TitleContent>
    <DialogContent>
        @if (_detailLoading) { <MudProgressLinear Indeterminate="true" /> }
        else if (_detail is not null)
        {
            <AuditEventInspector Event="_detail" OrganizationId="OrganizationId" />
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _detailOpen = false)">@L["Common.Close"]</MudButton></DialogActions>
</MudDialog>

</EmployeePortraitScope>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [SupplyParameterFromQuery(Name = "eventId")] public Guid? EventId { get; set; }
    private static readonly string[] Categories = ["DocumentAccess", "AgentCapability", "AgentRuntime", "AgentWork", "Communication", "Mcp", "McpAgentRuntime", "BrokerConnection", "BrokerEvent", "BrokerCapability", "SecurityAccess", "Domain"];
    private static readonly string[] Outcomes = ["Received", "Accepted", "Authorized", "Established", "Delivered", "Completed", "Denied", "Rejected", "Failed", "Dropped"];
    private static readonly string[] ActorKinds = ["Human", "Agent", "Platform", "Unknown"];
    private readonly List<SecurityEventSummaryResponse> _items = [];
    private string _range = "24h", _category = "", _outcome = "", _actorKind = "", _search = "";
    private string? _nextCursor, _error; private bool _groupModelResponses = true, _loading, _loadingMore, _forbidden, _detailOpen, _detailLoading;
    private SecurityEventDetailResponse? _detail;
    private long _loadVersion;

    protected override async Task OnParametersSetAsync() { await ReloadAsync(); if (EventId is Guid id) await OpenDetailAsync(id, false); }
    private async Task ReloadAsync() { _items.Clear(); _nextCursor = null; await LoadAsync(false); }
    private Task LoadMoreAsync() => LoadAsync(true);
    private async Task LoadAsync(bool append)
    {
        var version = ++_loadVersion;
        if (append) _loadingMore = true; else _loading = true;
        _error = null; _forbidden = false;
        try
        {
            var response = await Http.GetAsync(BuildUrl(append ? _nextCursor : null));
            if (version != _loadVersion) return;
            if (response.StatusCode == HttpStatusCode.Forbidden) { _forbidden = true; return; }
            response.EnsureSuccessStatusCode();
            var page = await response.Content.ReadFromJsonAsync<SecurityEventPageResponse>();
            if (page is null || version != _loadVersion) return;
            if (!append) _items.Clear();
            _items.AddRange(page.Items); _nextCursor = page.NextCursor;
        }
        catch (Exception exception) { if (version == _loadVersion) _error = exception.Message; }
        finally { if (version == _loadVersion) { _loading = false; _loadingMore = false; } }
    }
    private string BuildUrl(string? cursor)
    {
        var query = new List<string> { "limit=50" };
        var from = _range switch { "24h" => DateTimeOffset.UtcNow.AddHours(-24), "7d" => DateTimeOffset.UtcNow.AddDays(-7), "30d" => DateTimeOffset.UtcNow.AddDays(-30), _ => (DateTimeOffset?)null };
        if (from.HasValue) query.Add($"from={Uri.EscapeDataString(from.Value.ToString("O"))}");
        Add(query, "category", _category); Add(query, "outcome", _outcome); Add(query, "actorKind", _actorKind); Add(query, "search", _search); Add(query, "cursor", cursor);
        query.Add($"groupModelResponses={(_groupModelResponses ? "true" : "false")}");
        return $"api/organizations/{OrganizationId:D}/security/events?{string.Join('&', query)}";
    }
    private static void Add(List<string> query, string key, string? value) { if (!string.IsNullOrWhiteSpace(value)) query.Add($"{key}={Uri.EscapeDataString(value.Trim())}"); }
    private async Task OpenDetailAsync(Guid id, bool groupModelResponse) { _detailOpen = true; _detailLoading = true; _detail = null; try { _detail = await Http.GetFromJsonAsync<SecurityEventDetailResponse>($"api/organizations/{OrganizationId:D}/security/events/{id:D}?groupModelResponse={(groupModelResponse ? "true" : "false")}"); } finally { _detailLoading = false; } }
    private Task OnRangeChanged(string value) { _range = value; return ReloadAsync(); }
    private Task OnCategoryChanged(string value) { _category = value; return ReloadAsync(); }
    private Task OnOutcomeChanged(string value) { _outcome = value; return ReloadAsync(); }
    private Task OnActorChanged(string value) { _actorKind = value; return ReloadAsync(); }
    private Task OnGroupModelResponsesChanged(bool value) { _groupModelResponses = value; return ReloadAsync(); }

    private string FormatTime(DateTimeOffset value) => Time.Format(value, "g");
    private string Label(string family, string? value) => string.IsNullOrEmpty(value) ? string.Empty : L.Has(family + "." + value) ? L[family + "." + value] : value;
    private static string ActivityLabel(SecurityEventSummaryResponse value) =>
        value.ActivityDescription ?? value.Summary ?? AuditActionDescriptions.Humanize(value.EventType);
    private static string ActorLabel(SecurityEventDetailResponse value) => value.ActorDisplayName ?? value.ActorAgentId ?? value.ActorApplicationUserId?.ToString("D") ?? value.ActorKind;
    private static string Value(object? value) => value?.ToString() ?? "—";
    private static Color OutcomeColor(string value) => value is "Denied" or "Rejected" or "Failed" or "Dropped" ? Color.Error : value is "Received" or "Authorized" ? Color.Info : Color.Success;
    private static Color IntegrityColor(string value) => value == "Verified" ? Color.Success : value == "LegacyUnsealed" ? Color.Warning : Color.Error;
}
