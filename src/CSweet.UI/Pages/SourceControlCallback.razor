@page "/source-control/github-callback"
@using CSweet.Contracts.SourceControl
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IAppLocalizer L

<PageTitle>@L["SourceControlCallback.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-12">
    <MudPaper Outlined="true" Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            @if (_working)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["SourceControlCallback.ConnectingYourGitHubAccount"]</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    @L["SourceControlCallback.CSweetIsConfirmingYour"]
                </MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Color="Color.Error" Size="Size.Large" />
                <MudText Typo="Typo.h6">@L["SourceControlCallback.GitHubSetupCouldNotBe"]</MudText>
                <MudText Typo="Typo.body2">@_error</MudText>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? Code { get; set; }
    [SupplyParameterFromQuery(Name = "installation_id")] public long InstallationId { get; set; }
    [SupplyParameterFromQuery(Name = "setup_action")] public string? SetupAction { get; set; }

    private bool _working = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        // Standalone installation returns only refresh the provider-backed inventory.
        // They never authorize a business connection or trust a query-string installation ID.
        if (string.IsNullOrWhiteSpace(State) && InstallationId > 0)
        {
            Navigation.NavigateTo("/settings/source-control", forceLoad: true);
            return;
        }
        if (State?.StartsWith("repository-onboarding:", StringComparison.Ordinal) == true)
        {
            try
            {
                var parts = State.Split(':', 3);
                if (parts.Length != 3 || !Guid.TryParse(parts[1], out var draftId) || string.IsNullOrWhiteSpace(Code) || InstallationId <= 0)
                    throw new InvalidOperationException("The GitHub response did not match a valid onboarding draft.");
                using var result = await Http.PostAsJsonAsync($"api/repository-onboarding/{draftId:D}/github/complete",
                    new CSweet.Contracts.PersonalAssistant.CompleteDraftGitHubAuthorizationRequest(State, InstallationId, Code));
                if (!result.IsSuccessStatusCode) throw new InvalidOperationException("GitHub authorization could not be verified. Resume the draft and connect again.");
                Navigation.NavigateTo($"/?create=true&draft={draftId:D}", forceLoad: true);
            }
            catch (Exception e) { Fail(e.Message); }
            return;
        }
        if (string.IsNullOrWhiteSpace(State) || string.IsNullOrWhiteSpace(Code) || InstallationId <= 0 ||
            !TryReadState(State, out var organizationId, out var sessionId))
        {
            Fail("The GitHub response did not match a valid C-Sweet setup session.");
            return;
        }

        try
        {
            var dashboard = await Http.GetFromJsonAsync<SourceControlDashboardResponse>(
                $"api/organizations/{organizationId:D}/source-control/dashboard");
            var active = dashboard?.ActiveOnboarding;
            if (active is null || active.SessionId != sessionId)
                throw new InvalidOperationException("This setup session has expired or was replaced.");
            var appKind = active.CurrentStep == "authorize-provisioner" ? "Provisioner" : "SourceAccess";
            using var response = await Http.PostAsJsonAsync(
                $"api/organizations/{organizationId:D}/source-control/onboarding/{sessionId:D}/github-installation",
                new CompleteGitHubAppInstallationRequest(State, InstallationId, appKind, Code));
            if (!response.IsSuccessStatusCode)
                throw new InvalidOperationException(await response.Content.ReadAsStringAsync());
            var result = await response.Content.ReadFromJsonAsync<CompleteGitHubAppInstallationResponse>()
                ?? throw new InvalidOperationException("C-Sweet returned no setup result.");
            if (!string.IsNullOrWhiteSpace(result.NextAuthorizationUrl))
                Navigation.NavigateTo(result.NextAuthorizationUrl, forceLoad: true);
            else
                Navigation.NavigateTo($"/organizations/{organizationId:D}/source-control", forceLoad: true);
        }
        catch (Exception exception)
        {
            Fail(exception.Message);
        }
    }

    private void Fail(string message)
    {
        _working = false;
        _error = message;
    }

    private static bool TryReadState(string state, out Guid organizationId, out Guid sessionId)
    {
        organizationId = Guid.Empty;
        sessionId = Guid.Empty;
        var segments = state.Split('.', 3, StringSplitOptions.RemoveEmptyEntries);
        return segments.Length == 3 &&
               Guid.TryParseExact(segments[0], "N", out organizationId) &&
               Guid.TryParseExact(segments[1], "N", out sessionId);
    }
}
