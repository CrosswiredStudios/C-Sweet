@page "/organizations/{OrganizationId:guid}/hiring-settings/{InstallationId:guid}"
@using System.Net.Http.Json
@using CSweet.Agent.SDK
@inject HttpClient Http
@inject IAppLocalizer L

<PageTitle>@L["ChiefHiringSettings.PageTitle"]</PageTitle>
<div class="aurora-page business-workspace business-form-page">
<MudButton Href="@($"/organizations/{OrganizationId}/employees?tab=hiring")" StartIcon="@Icons.Material.Outlined.ArrowBack" Class="mb-4">@L["ChiefHiringSettings.BackToHiring"]</MudButton>
<MudPaper Class="pa-6" Outlined="true">
    <MudText Typo="Typo.h4">@L["ChiefHiringSettings.Title"]</MudText>
    <MudText Class="mb-4">@L["ChiefHiringSettings.Intro"]</MudText>
    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    @if (_policy is not null)
    {
        <MudSelect T="HiringSelectionMode" Label="@L["ChiefHiringSettings.HiringMode"]" @bind-Value="_mode">
            <MudSelectItem Value="HiringSelectionMode.RecommendCandidates">@L["ChiefHiringSettings.Mode.RecommendCandidates"]</MudSelectItem>
            <MudSelectItem Value="HiringSelectionMode.ChooseCandidates">@L["ChiefHiringSettings.Mode.ChooseCandidates"]</MudSelectItem>
            <MudSelectItem Value="HiringSelectionMode.Automatic">@L["ChiefHiringSettings.Mode.Automatic"]</MudSelectItem>
        </MudSelect>
        @if (_mode == HiringSelectionMode.Automatic)
        {
            <MudSelect T="AutomaticHiringLevel" Label="@L["ChiefHiringSettings.AutomaticAuthority"]" @bind-Value="_level">
                <MudSelectItem Value="AutomaticHiringLevel.ApprovedPackages">@L["ChiefHiringSettings.Level.ApprovedPackages"]</MudSelectItem>
                <MudSelectItem Value="AutomaticHiringLevel.WithinLimits">@L["ChiefHiringSettings.Level.WithinLimits"]</MudSelectItem>
                <MudSelectItem Value="AutomaticHiringLevel.BroadDelegation">@L["ChiefHiringSettings.Level.BroadDelegation"]</MudSelectItem>
            </MudSelect>
            @if (_level == AutomaticHiringLevel.BroadDelegation)
            {
                <MudAlert Severity="Severity.Warning">@L["ChiefHiringSettings.BroadDelegationWarning"]</MudAlert>
            }
            @if (_level == AutomaticHiringLevel.WithinLimits)
            {
                <MudNumericField T="decimal?" Label="@L["ChiefHiringSettings.MaximumHireCost"]" Min="0" @bind-Value="_hireCost" />
                <MudNumericField T="decimal?" Label="@L["ChiefHiringSettings.MaximumTotalCost"]" Min="0" @bind-Value="_totalCost" />
                <MudTextField Label="@L["ChiefHiringSettings.Currency"]" @bind-Value="_currency" />
                <MudTextField Label="@L["ChiefHiringSettings.AllowedCapabilities"]" Lines="4" @bind-Value="_capabilities" />
                <MudTextField Label="@L["ChiefHiringSettings.AllowedNetwork"]" Lines="4" @bind-Value="_network" />
            }
        }
        <MudSelect T="HiringPublisherPreference" Label="@L["ChiefHiringSettings.Publishers"]" @bind-Value="_publishers">
            <MudSelectItem Value="HiringPublisherPreference.PreferFirstParty">@L["ChiefHiringSettings.Publishers.PreferFirstParty"]</MudSelectItem>
            <MudSelectItem Value="HiringPublisherPreference.FirstPartyOnly">@L["ChiefHiringSettings.Publishers.FirstPartyOnly"]</MudSelectItem>
            <MudSelectItem Value="HiringPublisherPreference.BestFit">@L["ChiefHiringSettings.Publishers.BestFit"]</MudSelectItem>
        </MudSelect>
        <MudTextField Label="@L["ChiefHiringSettings.Rationale"]" @bind-Value="_rationale" />
        <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveAsync">@L["ChiefHiringSettings.Save"]</MudButton>
        @if (_saved) { <MudAlert Class="mt-4" Severity="Severity.Success">@L["ChiefHiringSettings.Saved"]</MudAlert> }
        <MudDivider Class="my-4" />
        <MudText>@L["ChiefHiringSettings.ApplyIntro"]</MudText>
        <MudSelect T="Guid?" Label="@L["ChiefHiringSettings.ExistingPlan"]" @bind-Value="_planId">
            @foreach (var plan in _plans) { <MudSelectItem T="Guid?" Value="@((Guid?)plan.SourceResourceChangeRequestId)">@plan.Title</MudSelectItem> }
        </MudSelect>
        <MudButton Disabled="@(!_planId.HasValue || _saving)" OnClick="ApplyAsync">@L["ChiefHiringSettings.ApplyToPlan"]</MudButton>
    }
</MudPaper>

</div>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid InstallationId { get; set; }
    private HiringPolicyResponse? _policy;
    private HiringSelectionMode _mode;
    private AutomaticHiringLevel _level;
    private HiringPublisherPreference _publishers;
    private decimal? _hireCost, _totalCost;
    private string _currency = "USD", _capabilities = "", _network = "", _rationale = "";
    private string? _error;
    private bool _saving, _saved;
    private Guid? _planId;
    private IReadOnlyList<CSweet.Contracts.Core.HiringRecommendationResponse> _plans = [];
    protected override void OnInitialized() => _rationale = L["ChiefHiringSettings.DefaultRationale"];
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _policy = await Http.GetFromJsonAsync<HiringPolicyResponse>(PolicyUrl);
            if (_policy is null) return;
            var settings = _policy.Settings;
            _mode = settings.Mode; _level = settings.AutomaticLevel; _publishers = settings.Publishers;
            _hireCost = settings.MaximumHireCost; _totalCost = settings.MaximumTotalCost;
            _currency = settings.Currency ?? "USD";
            _capabilities = string.Join('\n', settings.AllowedCapabilities ?? []);
            _network = string.Join('\n', settings.AllowedNetworkAccess ?? []);
            var dashboard = await Http.GetFromJsonAsync<CSweet.Contracts.Core.HiringDashboardResponse>($"api/core/organizations/{OrganizationId:D}/hiring");
            _plans = dashboard?.Recommendations.Where(x => x.SourceResourceChangeRequestId.HasValue && x.RemainingHeadcount > 0)
                .DistinctBy(x => x.SourceResourceChangeRequestId).ToArray() ?? [];
        }
        catch (HttpRequestException) { _error = L["ChiefHiringSettings.Unavailable"]; }
    }
    private string PolicyUrl => $"api/core/organizations/{OrganizationId:D}/hiring/policies/{InstallationId:D}";
    private static string[] Entries(string value) => value.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Distinct(StringComparer.Ordinal).ToArray();
    private async Task SaveAsync()
    {
        if (_policy is null) return;
        _saving = true; _error = null; _saved = false;
        try
        {
            var response = await Http.PutAsJsonAsync(PolicyUrl, new UpdateHiringPolicyRequest(
                new(_mode, _level, _publishers, _hireCost, _totalCost, _currency, Entries(_capabilities), Entries(_network)), _policy.Revision, _rationale));
            if (!response.IsSuccessStatusCode) { _error = await response.Content.ReadAsStringAsync(); return; }
            _policy = await response.Content.ReadFromJsonAsync<HiringPolicyResponse>(); _saved = true;
        }
        catch (HttpRequestException) { _error = L["ChiefHiringSettings.SaveFailed"]; }
        finally { _saving = false; }
    }
    private async Task ApplyAsync()
    {
        if (!_planId.HasValue) return;
        _saving = true; _error = null; _saved = false;
        try
        {
            var response = await Http.PostAsync($"{PolicyUrl}/plans/{_planId.Value:D}/apply", null);
            _error = response.IsSuccessStatusCode ? null : await response.Content.ReadAsStringAsync();
            _saved = response.IsSuccessStatusCode;
        }
        catch (HttpRequestException) { _error = L["ChiefHiringSettings.ApplyFailed"]; }
        finally { _saving = false; }
    }
}
