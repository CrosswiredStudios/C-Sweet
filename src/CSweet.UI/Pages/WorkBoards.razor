<MudDialog @bind-Visible="_itemCreatorOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">New work item</MudText></TitleContent>
    <DialogContent>
        <div class="mt-2">
            <StructuredMentionTextField Label="Title" Value="_itemTitle"
                ValueChanged="@(value => _itemTitle = value)" Mentions="_itemTitleMentions"
                MentionsChanged="@(value => _itemTitleMentions = value)" People="_organizationUsers"
                Field="@CSweet.WorkManagement.Contracts.WorkItemMentionFields.Title" />
        </div>
        <div class="mt-3">
            <StructuredMentionTextField Label="Description" Value="_itemDescription"
                ValueChanged="@(value => _itemDescription = value)" Mentions="_itemDescriptionMentions"
                MentionsChanged="@(value => _itemDescriptionMentions = value)" People="_organizationUsers"
                Field="@CSweet.WorkManagement.Contracts.WorkItemMentionFields.Description" Lines="3" />
        </div>
        <MudSelect T="string" Label="Type" @bind-Value="_itemKind"
                   Variant="Variant.Outlined" Class="mt-3">
            @foreach (var kind in WorkItemKinds)
            {
                <MudSelectItem T="string" Value="@kind">@kind</MudSelectItem>
            }
        </MudSelect>
        @if (_itemKind is not ("Initiative" or "Epic"))
        {
            <MudSelect T="Guid?" Label="Accountable owner" @bind-Value="_itemAccountableOwnerId"
                       Variant="Variant.Outlined" Class="mt-3" Required="true">
                @foreach (var person in _organizationUsers.Where(x => x.IsActive).OrderBy(x => x.DisplayName))
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)person.Id)">@person.DisplayName</MudSelectItem>
                }
            </MudSelect>
            @if (PublishedPolicy is null)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                    Publish an orchestration policy before creating executable work.
                </MudAlert>
            }
            else
            {
                @foreach (var stage in PublishedPolicy.Stages.Where(x => x.StageType is "AgentExecution" or "ManualWork"))
                {
                    @if (stage.StageType == "AgentExecution")
                    {
                        <MudSelect T="Guid?" Label="@($"{stage.Name} agent")"
                                   Value="@StageAgent(stage.Key)"
                                   ValueChanged="@(value => SetStageAgent(stage.Key, value))"
                                   Variant="Variant.Outlined" Class="mt-3" Required="true">
                            @foreach (var agent in _itemAgentInstallations)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)agent.Id)">@agent.AgentName (@agent.AgentVersion)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudSelect T="Guid?" Label="@($"{stage.Name} assignee")"
                                   Value="@StageHuman(stage.Key)"
                                   ValueChanged="@(value => SetStageHuman(stage.Key, value))"
                                   Variant="Variant.Outlined" Class="mt-3" Required="true">
                            @foreach (var person in _organizationUsers.Where(x => x.IsActive && x.EmployeeType == 0).OrderBy(x => x.DisplayName))
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)person.Id)">@person.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                    }
                }
            }
        }
        @if (!string.IsNullOrWhiteSpace(_itemError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">@_itemError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _itemCreatorOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_saving" OnClick="CreateItemAsync">Create</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_developerAssignmentOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Assign software developer</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            C-Sweet will materialize the selected code project into a credential-free workspace.
            The developer can build and test changes, while C-Sweet owns commit and publication.
        </MudText>
        <MudSelect T="Guid?" Label="Developer installation"
                   @bind-Value="_developerInstallationId"
                   Variant="Variant.Outlined" Class="mt-3" Required="true">
            @foreach (var installation in _developerInstallations)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)installation.Id)">
                    @installation.AgentName (@installation.AgentVersion)
                </MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid?" Label="Code project"
                   Value="_developerConnectionId"
                   ValueChanged="SelectDeveloperConnection"
                   Variant="Variant.Outlined" Class="mt-3" Required="true">
            @foreach (var connection in _repositoryConnections)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)connection.Id)">
                    @connection.Name — @connection.CanonicalPath
                </MudSelectItem>
            }
        </MudSelect>
        <MudTextField T="string" Label="Requirements (one per line)"
                      @bind-Value="_developerRequirements"
                      Variant="Variant.Outlined" Lines="5" Class="mt-3" Required="true" />
        <MudTextField T="string" Label="Acceptance criteria (one per line)"
                      @bind-Value="_developerAcceptanceCriteria"
                      Variant="Variant.Outlined" Lines="5" Class="mt-3" Required="true" />
        <MudTextField T="string" Label="Constraints (one per line)"
                      @bind-Value="_developerConstraints"
                      Variant="Variant.Outlined" Lines="3" Class="mt-3" />
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
            The agent receives no Git credentials, provider tokens, remote URL, or `.git`
            directory. The trusted GitHost validates the assigned repository, branch, and commit.
        </MudAlert>
        @if (!string.IsNullOrWhiteSpace(_developerAssignmentError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">
                @_developerAssignmentError
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        @if (_developerAssignmentItem?.AssignedInstallationId is not null)
        {
            <MudButton Color="Color.Error" Disabled="_saving"
                       OnClick="UnassignDeveloperAsync">Unassign</MudButton>
        }
        <MudButton OnClick="@(() => _developerAssignmentOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_saving || !_developerInstallationId.HasValue ||
                               !_developerConnectionId.HasValue)"
                   OnClick="AssignDeveloperAsync">
            @(_saving ? "Assigning..." : "Assign")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_columnsOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Configure columns</MudText></TitleContent>
    <DialogContent>
        @foreach (var draft in _columnDrafts)
        {
            <MudPaper Outlined="true" Class="pa-3 mt-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField T="string" Label="Name" @bind-Value="draft.Name"
                                  Variant="Variant.Outlined" />
                    <MudSelect T="string" Label="Category" @bind-Value="draft.Category"
                               Variant="Variant.Outlined">
                        @foreach (var category in ColumnCategories)
                        {
                            <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Label="WIP policy" @bind-Value="draft.WipPolicy"
                               Variant="Variant.Outlined">
                        @foreach (var policy in WipPolicies)
                        {
                            <MudSelectItem T="string" Value="@policy">@policy</MudSelectItem>
                        }
                    </MudSelect>
                    @if (draft.WipPolicy != "Disabled")
                    {
                        <MudNumericField T="int?" Label="Limit" @bind-Value="draft.WipLimit"
                                         Min="1" Variant="Variant.Outlined" />
                    }
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                   Color="Color.Error"
                                   Disabled="@(_columnDrafts.Count <= 2)"
                                   OnClick="@(() => _columnDrafts.Remove(draft))"
                                   aria-label="Remove column" />
                </MudStack>
            </MudPaper>
        }
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Add"
                   Class="mt-3" OnClick="AddColumn">Add column</MudButton>
        @if (!string.IsNullOrWhiteSpace(_columnsError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">@_columnsError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _columnsOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_saving" OnClick="SaveColumnsAsync">Save workflow</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid? BoardId { get; set; }

    private WorkBoardDirectoryResponse? _directory;
    private PersonalTodoDirectory? _personalTodos;
    private string? _personalTodoError;
    private WorkBoardSummaryResponse? _editingBoard;
    private WorkBoardSummaryResponse? _detailBoard;
    private WorkBoardDetailResponse? _detail;
    private string _search = "";
    private string _itemSearch = "";
    private string _editorName = "";
    private string _editorDescription = "";
    private string _editorKey = "";
    private Guid? _editorManagerId;
    private string? _error;
    private string? _editorError;
    private bool _includeArchived;
    private bool _favoritesOnly;
    private bool _loading;
    private bool _saving;
    private bool _forbidden;
    private bool _editorOpen;
    private bool _editorDefault;
    private bool _detailLoading;
    private bool _itemCreatorOpen;
    private bool _columnsOpen;
    private bool _agentAccessOpen;
    private bool _collaborationOpen;
    private bool _collaborationLoading;
    private bool _sprintsOpen;
    private bool _automationsOpen;
    private bool _estimateOpen;
    private bool _capacityOpen;
    private bool _carryoverOpen;
    private bool _developerAssignmentOpen;
    private bool _deliveryOpen;
    private bool _orchestrationOpen;
    private bool _executionOpen;
    private bool _realtimeRefreshRunning;
    private bool _realtimeRefreshPending;
    private string _itemTitle = "";
    private string _itemDescription = "";
    private IReadOnlyList<CSweet.WorkManagement.Contracts.WorkItemMentionInput> _itemTitleMentions = [];
    private IReadOnlyList<CSweet.WorkManagement.Contracts.WorkItemMentionInput> _itemDescriptionMentions = [];
    private string _itemKind = "Task";
    private Guid? _itemAccountableOwnerId;
    private IReadOnlyList<OrganizationUserResponse> _organizationUsers = [];
    private IReadOnlyList<AgentInstallationResponse> _itemAgentInstallations = [];
    private readonly Dictionary<string, Guid?> _stageAgentAssignments = new(StringComparer.Ordinal);
    private readonly Dictionary<string, Guid?> _stageHumanAssignments = new(StringComparer.Ordinal);
    private string? _itemError;
    private string? _columnsError;
    private string? _detailError;
    private string? _moveError;
    private WorkBoardItemResponse? _draggedItem;
    private Guid? _dragTargetColumnId;
    private bool _movePending;
    private string? _agentAccessError;
    private string? _collaborationError;
    private string _commentBody = "";
    private string _sprintName = "";
    private string _sprintGoal = "";
    private string? _sprintError;
    private string? _planningError;
    private string? _automationError;
    private string _automationName = "";
    private string _automationTrigger = "item.created";
    private string _automationAction = WorkItemActions.Move;
    private Guid? _automationConditionColumnId;
    private Guid? _automationTargetColumnId;
    private Guid? _selectedAgentId;
    private Guid? _transferBoardId;
    private WorkBoardItemResponse? _selectedItem;
    private WorkBoardItemResponse? _estimateItem;
    private WorkBoardItemResponse? _developerAssignmentItem;
    private WorkItemCollaborationResponse? _collaboration;
    private IReadOnlyList<WorkSprintResponse> _sprints = [];
    private WorkSprintResponse? _capacitySprint;
    private WorkSprintResponse? _carryoverSource;
    private WorkSprintReportResponse? _sprintReport;
    private WorkAutomationDirectoryResponse? _automations;
    private decimal? _estimatePoints;
    private decimal? _capacityPoints;
    private Guid? _carryoverTargetSprintId;
    private string _agentAccessProfile = "None";
    private readonly List<ColumnDraft> _columnDrafts = [];
    private IReadOnlyList<AgentInstallationResponse> _boardAgents = [];
    private IReadOnlyList<AgentInstallationResponse> _developerInstallations = [];
    private IReadOnlyList<SourceControlRepositoryOptionResponse> _repositoryConnections = [];
    private IReadOnlyList<AgentInstallationResponse> _pipelineAgents = [];
    private DeliveryPipelineResponse? _deliveryPipeline;
    private WorkOrchestrationPolicyResponse? _orchestrationPolicy;
    private WorkSprintExecutionResponse? _execution;
    private WorkSprintResponse? _executionSprint;
    private string? _executionError;
    private Guid? _orchestrationReadyColumnId;
    private Guid? _orchestrationDevelopmentColumnId;
    private Guid? _orchestrationQualityColumnId;
    private Guid? _orchestrationDoneColumnId;
    private string _orchestrationMergeMode = "ManagerApproval";
    private int _orchestrationQualityCycles = 3;
    private string? _orchestrationError;
    private Guid? _pipelineDeveloperId;
    private Guid? _pipelineQualityId;
    private Guid? _pipelineDevelopmentColumnId;
    private Guid? _pipelineQualityColumnId;
    private Guid? _pipelineDoneColumnId;
    private Guid? _pipelineRepositoryId;
    private string? _pipelineError;
    private Guid? _developerInstallationId;
    private Guid? _developerConnectionId;
    private string _developerRequirements = "";
    private string _developerAcceptanceCriteria = "";
    private string _developerConstraints = "";
    private string? _developerAssignmentError;
    private IReadOnlyList<WorkBoardGrantResponse> _boardGrants = [];
    private static readonly string[] WorkItemKinds = ["Initiative", "Epic", "Story", "Task", "Bug"];
    private static readonly string[] ColumnCategories = ["ToDo", "InProgress", "Done", "Cancelled"];
    private static readonly string[] WipPolicies = ["Disabled", "Warning", "HardLimit"];
    private static readonly string[] AutomationTriggers =
    [
        "item.created", "item.moved", "item.completed", "item.cancelled",
        "item.reopened", "item.sprint.assigned", "item.sprint.removed",
        "item.estimate.changed", "comment.created"
    ];
    private static readonly string[] AutomationItemActions =
    [
        WorkItemActions.Move, WorkItemActions.Complete,
        WorkItemActions.Cancel, WorkItemActions.Reopen
    ];
    private IReadOnlyList<WorkBoardSummaryResponse> TransferTargets =>
        _directory?.Boards.Where(board =>
                !board.IsArchived &&
                board.Id != _detail?.Board.Id &&
                board.AllowedActions.Contains(WorkItemActions.Transfer))
            .OrderBy(board => board.Name)
            .ToList() ?? [];
    private IReadOnlyList<WorkSprintResponse> AssignableSprints =>
        _sprints.Where(x => x.Status is "Planned" or "Active")
            .OrderByDescending(x => x.Status == "Active")
            .ThenBy(x => x.Name)
            .ToList();
    private bool PipelineFormComplete =>
        _pipelineDeveloperId.HasValue &&
        _pipelineQualityId.HasValue &&
        _pipelineDevelopmentColumnId.HasValue &&
        _pipelineQualityColumnId.HasValue &&
        _pipelineDoneColumnId.HasValue &&
        _pipelineRepositoryId.HasValue;

    protected override void OnInitialized() =>
        Realtime.EventReceived += OnRealtimeEvent;

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
        if (BoardId.HasValue)
        {
            _detailBoard = _directory?.Boards.SingleOrDefault(x => x.Id == BoardId.Value);
            await LoadBoardAsync();
        }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        _forbidden = false;
        try
        {
            var query = new List<string>
            {
                $"includeArchived={_includeArchived.ToString().ToLowerInvariant()}",
                $"favoritesOnly={_favoritesOnly.ToString().ToLowerInvariant()}"
            };
            if (!string.IsNullOrWhiteSpace(_search))
                query.Add($"search={Uri.EscapeDataString(_search.Trim())}");
            var response = await Http.GetAsync(
                $"api/organizations/{OrganizationId:D}/work/boards?{string.Join('&', query)}");
            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _forbidden = true;
                return;
            }
            response.EnsureSuccessStatusCode();
            _directory = await response.Content.ReadFromJsonAsync<WorkBoardDirectoryResponse>();
            await LoadPersonalTodosAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadPersonalTodosAsync()
    {
        try
        {
            var response = await Http.GetAsync(
                $"api/organizations/{OrganizationId:D}/work/personal-todos");
            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _personalTodos = null;
                return;
            }
            response.EnsureSuccessStatusCode();
            _personalTodos = await response.Content.ReadFromJsonAsync<PersonalTodoDirectory>();
            _personalTodoError = null;
        }
        catch (Exception exception)
        {
            _personalTodoError = exception.Message;
        }
    }

    private async Task SearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await ReloadAsync();
    }

    private async Task SetFavoritesOnlyAsync(bool value)
    {
        _favoritesOnly = value;
        await ReloadAsync();
    }

    private async Task SetIncludeArchivedAsync(bool value)
    {
        _includeArchived = value;
        await ReloadAsync();
    }

    private async Task OpenCreate()
    {
        await LoadOrganizationUsersAsync();
        _editingBoard = null;
        _editorName = "";
        _editorDescription = "";
        _editorKey = "";
        _editorManagerId = _organizationUsers.FirstOrDefault(x => x.IsActive)?.Id;
        _editorDefault = false;
        _editorError = null;
        _editorOpen = true;
    }

    private async Task OpenEdit(WorkBoardSummaryResponse board)
    {
        await LoadOrganizationUsersAsync();
        _editingBoard = board;
        _editorName = board.Name;
        _editorDescription = board.Description;
        _editorKey = board.Key ?? "";
        _editorManagerId = board.ManagerOrganizationUserId;
        _editorDefault = board.IsDefault;
        _editorError = null;
        _editorOpen = true;
    }

    private async Task SaveEditorAsync()
    {
        if (string.IsNullOrWhiteSpace(_editorName) || string.IsNullOrWhiteSpace(_editorKey) || !_editorManagerId.HasValue)
        {
            _editorError = "Board name, key, and manager are required.";
            return;
        }
        _saving = true;
        _editorError = null;
        try
        {
            HttpResponseMessage response;
            if (_editingBoard is null)
            {
                response = await Http.PostAsJsonAsync(
                    $"api/organizations/{OrganizationId:D}/work/boards",
                    new CreateWorkBoardRequest(_editorName, _editorDescription)
                    {
                        Key = _editorKey,
                        ManagerOrganizationUserId = _editorManagerId
                    });
            }
            else
            {
                response = await Http.PutAsJsonAsync(
                    $"api/organizations/{OrganizationId:D}/work/boards/{_editingBoard.Id:D}",
                    new UpdateWorkBoardRequest(
                        _editorName, _editorDescription, _editingBoard.WorkstreamId,
                        _editorDefault, _editingBoard.Revision)
                    {
                        Key = _editorKey,
                        ManagerOrganizationUserId = _editorManagerId
                    });
            }
            if (!response.IsSuccessStatusCode)
            {
                _editorError = await response.Content.ReadAsStringAsync();
                return;
            }
            _editorOpen = false;
            await ReloadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task LoadOrganizationUsersAsync() =>
        _organizationUsers = await Http.GetFromJsonAsync<IReadOnlyList<OrganizationUserResponse>>(
            $"api/core/organizations/{OrganizationId:D}/users") ?? [];

    private async Task OpenBoardAsync(WorkBoardSummaryResponse board)
    {
        await Task.CompletedTask;
        Navigation.NavigateTo($"/organizations/{OrganizationId:D}/work/boards/{board.Id:D}");
    }

    private void BackToBoards() =>
