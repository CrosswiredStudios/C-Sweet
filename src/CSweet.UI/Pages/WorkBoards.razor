    private Guid? StageAgent(string key) => _stageAgentAssignments.GetValueOrDefault(key);
    private Guid? StageHuman(string key) => _stageHumanAssignments.GetValueOrDefault(key);
    private void SetStageAgent(string key, Guid? value) => _stageAgentAssignments[key] = value;
    private void SetStageHuman(string key, Guid? value) => _stageHumanAssignments[key] = value;

    private IReadOnlyList<WorkStageAssignment> BuildItemStageAssignments()
    {
        if (_itemKind is "Initiative" or "Epic") return [];
        if (!_itemAccountableOwnerId.HasValue)
            throw new InvalidOperationException("Choose an accountable owner.");
        var result = new List<WorkStageAssignment>();
        foreach (var stage in PublishedPolicy?.Stages ?? [])
        {
            switch (stage.StageType)
            {
                case "AgentExecution":
                    if (!StageAgent(stage.Key).HasValue)
                        throw new InvalidOperationException($"Choose an exact agent for {stage.Name}.");
                    result.Add(new(stage.Key, "AgentInstallation", AgentInstallationId: StageAgent(stage.Key)));
                    break;
                case "ManualWork":
                    if (!StageHuman(stage.Key).HasValue)
                        throw new InvalidOperationException($"Choose a human assignee for {stage.Name}.");
                    result.Add(new(stage.Key, "Human", OrganizationUserId: StageHuman(stage.Key)));
                    break;
                case "ManagerApproval":
                    result.Add(new(stage.Key, "BoardManager"));
                    break;
                case "TrustedPlatformAction":
                    result.Add(new(stage.Key, "PlatformAction", PlatformAction: stage.PlatformAction));
                    break;
            }
        }
        return result;
    }

