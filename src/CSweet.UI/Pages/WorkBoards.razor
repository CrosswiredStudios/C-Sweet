    private async Task OpenAgentAccessAsync()
    {
        if (_detail is null) return;
        _agentAccessError = null;
        _selectedAgentId = null;
        _agentAccessProfile = "None";
        try
        {
            var installations = await Http.GetFromJsonAsync<IReadOnlyList<AgentInstallationResponse>>(
                "api/agents/installations") ?? [];
            _boardAgents = installations.Where(x =>
                    x.IsEnabled &&
                    x.PluginKind == "Agent" &&
                    Guid.TryParse(x.BusinessId, out var businessId) &&
                    businessId == OrganizationId)
                .OrderBy(x => x.AgentName)
                .ToList();
            _boardGrants = await Http.GetFromJsonAsync<IReadOnlyList<WorkBoardGrantResponse>>(
                $"api/organizations/{OrganizationId:D}/work/boards/{_detail.Board.Id:D}/grants") ?? [];
            _agentAccessOpen = true;
        }
        catch (Exception exception)
        {
            _detailError = exception.Message;
        }
    }

    private void SelectAgentAccess(Guid? installationId)
    {
        _selectedAgentId = installationId;
        var actions = _boardGrants.Where(x =>
                x.SubjectKind == "AgentInstallation" &&
                x.SubjectId == installationId)
            .Select(x => x.Action)
            .ToHashSet(StringComparer.Ordinal);
        _agentAccessProfile = actions.Contains(WorkItemActions.Create) ? "Operator" :
            actions.Contains(WorkItemActions.Read) ? "ReadOnly" : "None";
    }

    private async Task SaveAgentAccessAsync()
    {
        if (_detail is null || !_selectedAgentId.HasValue) return;
        _saving = true;
        _agentAccessError = null;
        try
        {
            IReadOnlyList<string> actions = _agentAccessProfile switch
            {
                "ReadOnly" =>
                    [
                        WorkBoardActions.Read,
                        WorkItemActions.Read,
                        WorkSprintActions.Read,
                        WorkSprintActions.ReadReports,
                        WorkAutomationActions.Read
                    ],
                "Operator" =>
                [
                    WorkBoardActions.Read,
                    WorkItemActions.Read,
                    WorkItemActions.Create,
                    WorkItemActions.Update,
                    WorkItemActions.Move,
                    WorkItemActions.Complete,
                    WorkItemActions.Cancel,
                    WorkItemActions.Reopen,
                    WorkItemActions.Comment,
                    WorkItemActions.Transfer,
                    WorkItemActions.Estimate,
                    WorkSprintActions.Read,
                    WorkSprintActions.Create,
                    WorkSprintActions.Start,
                    WorkSprintActions.Complete,
                    WorkSprintActions.Cancel,
                    WorkSprintActions.ManageScope,
                    WorkSprintActions.ManageCapacity,
                    WorkSprintActions.CarryOver,
                    WorkSprintActions.ReadReports,
                    WorkAutomationActions.Read,
                    WorkAutomationActions.Manage
                ],
                _ => []
            };
            var response = await Http.PutAsJsonAsync(
                $"api/organizations/{OrganizationId:D}/work/boards/{_detail.Board.Id:D}/grants",
                new SetWorkBoardSubjectGrantsRequest(
                    "AgentInstallation", _selectedAgentId.Value, actions));
            if (!response.IsSuccessStatusCode)
            {
                _agentAccessError = await response.Content.ReadAsStringAsync();
                return;
            }
            _boardGrants = (_boardGrants.Where(x =>
                    x.SubjectKind != "AgentInstallation" ||
                    x.SubjectId != _selectedAgentId.Value)
                .Concat(await response.Content.ReadFromJsonAsync<IReadOnlyList<WorkBoardGrantResponse>>() ?? [])
                .ToList());
            _agentAccessOpen = false;
            await RefreshDetailAsync();
        }
        finally
        {
            _saving = false;
        }
    }

