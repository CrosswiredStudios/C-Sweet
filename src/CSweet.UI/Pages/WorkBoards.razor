@page "/organizations/{OrganizationId:guid}/work"
@using System.Net
@using System.Net.Http.Json
@using CSweet.Contracts.WorkManagement
@using CSweet.Contracts.Agents
@using CSweet.Contracts.Realtime
@using SoftwareDevelopmentBrief = CSweet.WorkManagement.Contracts.SoftwareDevelopmentBrief
@implements IAsyncDisposable
@inject HttpClient Http
@inject AppRealtimeState Realtime

<PageTitle>Work - C-Sweet</PageTitle>

<MudPaper Elevation="1" Class="surface-panel">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">Company work</MudText>
            <MudText Typo="Typo.h4">Boards</MudText>
            <MudText Color="Color.Secondary">
                Find and manage the operational boards you are granted to access.
            </MudText>
        </div>
        @if (_directory?.CanCreateBoard == true)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenCreate">
                New board
            </MudButton>
        }
    </MudStack>

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-5" Style="flex-wrap: wrap;">
        <MudTextField T="string" Label="Search boards" @bind-Value="_search"
                      Variant="Variant.Outlined" Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Outlined.Search"
                      OnKeyDown="SearchKeyDown" Immediate="true" />
        <MudSwitch T="bool" Value="_favoritesOnly" Color="Color.Primary"
                   ValueChanged="SetFavoritesOnlyAsync">Favorites only</MudSwitch>
        <MudSwitch T="bool" Value="_includeArchived" Color="Color.Primary"
                   ValueChanged="SetIncludeArchivedAsync">Show archived</MudSwitch>
        <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Color="Color.Primary"
                       Disabled="_loading" OnClick="ReloadAsync" aria-label="Refresh boards" />
    </MudStack>

    @if (_forbidden)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
            You do not have a board read grant for this company.
        </MudAlert>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert>
    }
    else if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-4" />
    }
    else if (_directory?.Boards.Count is null or 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
            No boards match the current filters.
        </MudAlert>
    }
    else
    {
        <MudGrid Class="mt-3">
            @foreach (var board in _directory!.Boards)
            {
                <MudItem xs="12" md="6" xl="4">
                    <MudCard Outlined="true" Style="height: 100%;">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.h6">@board.Name</MudText>
                                    @if (board.IsDefault)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">Default</MudChip>
                                    }
                                    @if (board.IsArchived)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Archived</MudChip>
                                    }
                                </MudStack>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudIconButton Icon="@(board.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                               Color="@(board.IsFavorite ? Color.Warning : Color.Default)"
                                               OnClick="@(() => SetFavoriteAsync(board))"
                                               aria-label="@(board.IsFavorite ? "Remove from favorites" : "Add to favorites")" />
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.body2">@Description(board)</MudText>
                            <MudStack Row="true" Spacing="1" Class="mt-4" Style="flex-wrap: wrap;">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Outlined.TaskAlt">
                                    @board.ActiveItemCount active
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Outlined.AdminPanelSettings">
                                    @board.GrantedSubjectCount with access
                                </MudChip>
                                @if (board.LastVisitedAt.HasValue)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Icon="@Icons.Material.Outlined.History">
                                        @RelativeTime(board.LastVisitedAt.Value)
                                    </MudChip>
                                }
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Outlined.Visibility"
                                       OnClick="@(() => OpenBoardAsync(board))">View</MudButton>
                            @if (board.AllowedActions.Contains(WorkBoardActions.Configure))
                            {
                                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Edit"
                                           Disabled="board.IsArchived" OnClick="@(() => OpenEdit(board))">
                                    Configure
                                </MudButton>
                            }
                            <MudSpacer />
                            @if (!board.IsArchived && !board.IsDefault &&
                                 board.AllowedActions.Contains(WorkBoardActions.Archive))
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Archive"
                                               Color="Color.Warning" OnClick="@(() => ArchiveAsync(board))"
                                               aria-label="Archive board" />
                            }
                            else if (board.IsArchived &&
                                     board.AllowedActions.Contains(WorkBoardActions.Restore))
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Unarchive"
                                               Color="Color.Success" OnClick="@(() => RestoreAsync(board))"
                                               aria-label="Restore board" />
                            }
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudPaper>

<MudDialog @bind-Visible="_editorOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editingBoard is null ? "Create board" : "Configure board")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" Label="Name" @bind-Value="_editorName"
                      Variant="Variant.Outlined" Required="true" Class="mt-2" />
        <MudTextField T="string" Label="Description" @bind-Value="_editorDescription"
                      Variant="Variant.Outlined" Lines="3" Class="mt-3" />
        @if (_editingBoard is not null)
        {
            <MudSwitch T="bool" @bind-Value="_editorDefault" Color="Color.Primary" Class="mt-3">
                Default company board
            </MudSwitch>
        }
        @if (!string.IsNullOrWhiteSpace(_editorError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">@_editorError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _editorOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                   OnClick="SaveEditorAsync">@(_saving ? "Saving..." : "Save")</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_detailOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_detail?.Board.Name ?? _detailBoard?.Name ?? "Board")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_detailLoading)
        {
            <MudStack Spacing="2">
                <MudProgressLinear Indeterminate="true" />
                <MudText Color="Color.Secondary">Loading board details…</MudText>
            </MudStack>
        }
        else if (!string.IsNullOrWhiteSpace(_detailError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                <MudText Typo="Typo.subtitle2">This board could not be loaded.</MudText>
                <MudText Typo="Typo.body2">@_detailError</MudText>
            </MudAlert>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">
                Your board list and existing work are unchanged. You can retry the request or close this window.
            </MudText>
        }
        else if (_detail is not null)
        {
            <MudText Color="Color.Secondary">@Description(_detail.Board)</MudText>
            <MudStack Row="true" Spacing="2" Class="mt-3">
                @if (_detail.Board.AllowedActions.Contains(WorkItemActions.Create) && !_detail.Board.IsArchived)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.AddTask"
                               OnClick="OpenItemCreator">New work item</MudButton>
                }
                @if (_detail.Board.AllowedActions.Contains(WorkSprintActions.Read))
                {
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Outlined.EventNote"
                               OnClick="@(() => _sprintsOpen = true)">Sprints</MudButton>
                }
                @if (_detail.Board.AllowedActions.Contains(WorkAutomationActions.Read))
                {
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Outlined.AutoFixHigh"
                               OnClick="OpenAutomationsAsync">Automations</MudButton>
                }
                @if (_detail.Board.AllowedActions.Contains(WorkBoardActions.ConfigureColumns) &&
                     !_detail.Board.IsArchived)
                {
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Outlined.ViewColumn"
                               OnClick="OpenColumnEditor">Configure columns</MudButton>
                }
                @if (_detail.Board.AllowedActions.Contains(WorkBoardActions.ManageGrants))
                {
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Outlined.AdminPanelSettings"
                               OnClick="OpenAgentAccessAsync">Agent access</MudButton>
                }
            </MudStack>
            <div class="mt-4" style="display:flex; gap:16px; overflow-x:auto; align-items:flex-start;">
                @foreach (var column in _detail.Columns)
                {
                    var columnItems = _detail.Items
                        .Where(item => item.ColumnId == column.Id)
                        .OrderBy(item => item.Rank)
                        .ToList();
                    <MudPaper Outlined="true" Class="pa-3"
                              Style="min-width:280px; width:280px; flex:0 0 280px;">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle1"><b>@column.Name</b></MudText>
                            <MudChip T="int" Size="Size.Small">@columnItems.Count</MudChip>
                        </MudStack>
                        @if (column.WipLimit.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @column.WipPolicy limit: @column.WipLimit
                            </MudText>
                        }
                        @foreach (var item in columnItems)
                        {
                            <MudCard Outlined="true" Class="mt-3">
                                <MudCardContent>
                                    <MudText Typo="Typo.overline" Color="Color.Primary">@item.Kind</MudText>
                                    <MudText Typo="Typo.subtitle2">@item.Title</MudText>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <MudText Typo="Typo.caption">@item.Description</MudText>
                                    }
                                    @if (SprintFor(item.SprintId) is { } sprint)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                                 Variant="Variant.Outlined" Class="mt-2">
                                            @sprint.Name
                                        </MudChip>
                                    }
                                    @if (item.EstimatePoints.HasValue)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Class="mt-2 ml-1">
                                            @item.EstimatePoints.Value.ToString("0.##") pts
                                        </MudChip>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.AssignedDisplayName))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                                 Variant="Variant.Outlined" Class="mt-2 ml-1"
                                                 Icon="@Icons.Material.Outlined.Code">
                                            @item.AssignedDisplayName
                                        </MudChip>
                                    }
                                </MudCardContent>
                                <MudCardActions>
                                    <MudIconButton Icon="@Icons.Material.Outlined.Forum"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenCollaborationAsync(item))"
                                                   aria-label="Comments and activity" />
                                    @if (column.Category == "ToDo" &&
                                         _detail.Board.AllowedActions.Contains(WorkItemActions.Update) &&
                                         !_detail.Board.IsArchived)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Outlined.Code"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       OnClick="@(() => OpenDeveloperAssignmentAsync(item))"
                                                       aria-label="Assign software developer" />
                                    }
                                    @if (_detail.Board.AllowedActions.Contains(WorkItemActions.Estimate) &&
                                         !_detail.Board.IsArchived)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Outlined.Calculate"
                                                       Size="Size.Small"
                                                       OnClick="@(() => OpenEstimate(item))"
                                                       aria-label="Set estimate" />
                                    }
                                    @if (_detail.Board.AllowedActions.Contains(WorkSprintActions.ManageScope) &&
                                         !_detail.Board.IsArchived)
                                    {
                                        <MudMenu Icon="@Icons.Material.Outlined.EventAvailable"
                                                 Size="Size.Small"
                                                 AriaLabel="Assign sprint">
                                            <MudMenuItem Disabled="@(!item.SprintId.HasValue)"
                                                         OnClick="@(() => SetItemSprintAsync(item, null))">
                                                Backlog (no sprint)
                                            </MudMenuItem>
                                            @foreach (var sprintOption in AssignableSprints)
                                            {
                                                <MudMenuItem Disabled="@(item.SprintId == sprintOption.Id)"
                                                             OnClick="@(() => SetItemSprintAsync(item, sprintOption.Id))">
                                                    @sprintOption.Name
                                                </MudMenuItem>
                                            }
                                        </MudMenu>
                                    }
                                    @{
                                        var columnIndex = ColumnIndex(column.Id);
                                    }
                                    @if (columnIndex > 0)
                                    {
                                        var previousColumn = _detail.Columns[columnIndex - 1];
                                        <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                                                       Size="Size.Small"
                                                       Disabled="@(!CanMoveTo(item, previousColumn))"
                                                       OnClick="@(() => MoveItemAsync(item, previousColumn))"
                                                       aria-label="Move left" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                                                       Size="Size.Small" Disabled="true" aria-label="Move left" />
                                    }
                                    <MudSpacer />
                                    @if (columnIndex < _detail.Columns.Count - 1)
                                    {
                                        var nextColumn = _detail.Columns[columnIndex + 1];
                                        <MudIconButton Icon="@Icons.Material.Outlined.ArrowForward"
                                                       Size="Size.Small"
                                                       Disabled="@(!CanMoveTo(item, nextColumn))"
                                                       OnClick="@(() => MoveItemAsync(item, nextColumn))"
                                                       aria-label="Move right" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Outlined.ArrowForward"
                                                       Size="Size.Small" Disabled="true" aria-label="Move right" />
                                    }
                                </MudCardActions>
                            </MudCard>
                        }
                    </MudPaper>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (!_detailLoading && !string.IsNullOrWhiteSpace(_detailError))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Refresh"
                       OnClick="RetryBoardAsync">
                Retry
            </MudButton>
        }
        <MudButton OnClick="@(() => _detailOpen = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_automationsOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Board automations</MudText></TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_automationError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
                @_automationError
            </MudAlert>
        }
        @if (_detail?.Board.AllowedActions.Contains(WorkAutomationActions.Manage) == true &&
             !_detail.Board.IsArchived)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudText Typo="Typo.subtitle1">New event rule</MudText>
                <MudTextField T="string" Label="Name" @bind-Value="_automationName"
                              Variant="Variant.Outlined" Class="mt-2" />
                <MudSelect T="string" Label="When" @bind-Value="_automationTrigger"
                           Variant="Variant.Outlined" Class="mt-2">
                    @foreach (var trigger in AutomationTriggers)
                    {
                        <MudSelectItem T="string" Value="@trigger">@ActivityLabel(trigger)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid?" Label="Only while in column"
                           @bind-Value="_automationConditionColumnId"
                           Clearable="true" Variant="Variant.Outlined" Class="mt-2">
                    @foreach (var column in _detail.Columns)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)column.Id)">@column.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Label="Action" @bind-Value="_automationAction"
                           Variant="Variant.Outlined" Class="mt-2">
                    @foreach (var action in AutomationItemActions)
                    {
                        <MudSelectItem T="string" Value="@action">@action.Replace("work.item.", "")</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid?" Label="Target column" @bind-Value="_automationTargetColumnId"
                           Variant="Variant.Outlined" Class="mt-2">
                    @foreach (var column in _detail.Columns)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)column.Id)">@column.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                           Disabled="@(_saving || string.IsNullOrWhiteSpace(_automationName) ||
                                       !_automationTargetColumnId.HasValue)"
                           OnClick="CreateAutomationAsync">
                    Create disabled rule
                </MudButton>
            </MudPaper>
        }
        @if (_automations?.Rules.Count is null or 0)
        {
            <MudText Color="Color.Secondary" Class="mt-4">No automation rules are configured.</MudText>
        }
        else
        {
            @foreach (var rule in _automations.Rules)
            {
                <MudPaper Outlined="true" Class="pa-3 mt-3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.subtitle1">@rule.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @ActivityLabel(rule.TriggerEventType) → @rule.Action.Replace("work.item.", "")
                            </MudText>
                            <MudText Typo="Typo.caption" Style="display:block;">
                                Identity: @rule.AutomationIdentityId
                            </MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(rule.IsEnabled && rule.HasExecutionGrant ? Color.Success :
                                          rule.IsEnabled ? Color.Warning : Color.Default)">
                            @(rule.IsEnabled ? (rule.HasExecutionGrant ? "Active" : "Grant missing") : "Disabled")
                        </MudChip>
                    </MudStack>
                    <MudStack Row="true" Class="mt-2">
                        @if (_detail?.Board.AllowedActions.Contains(WorkAutomationActions.Manage) == true)
                        {
                            <MudButton Variant="Variant.Text"
                                       OnClick="@(() => ToggleAutomationAsync(rule))">
                                @(rule.IsEnabled ? "Disable" : "Enable")
                            </MudButton>
                        }
                        @if (!rule.HasExecutionGrant &&
                             _detail?.Board.AllowedActions.Contains(WorkBoardActions.ManageGrants) == true)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                       OnClick="@(() => GrantAutomationAsync(rule))">
                                Grant @rule.Action.Replace("work.item.", "")
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>
            }
        }
        @if (_automations?.RecentExecutions.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4">Recent executions</MudText>
            @foreach (var execution in _automations.RecentExecutions.Take(20))
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-1">
                    <MudText Typo="Typo.caption">@execution.Status · @execution.RequiredAction</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @RelativeTime(execution.CompletedAt)
                    </MudText>
                </MudStack>
            }
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _automationsOpen = false)">Close</MudButton></DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_sprintsOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Sprints</MudText></TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_sprintError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
                @_sprintError
            </MudAlert>
        }
        @if (_detail?.Board.AllowedActions.Contains(WorkSprintActions.ReadReports) == true)
        {
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Outlined.Insights"
                       OnClick="LoadSprintReportAsync">
                Refresh report
            </MudButton>
            @if (_sprintReport is not null)
            {
                <MudStack Row="true" Class="mt-3" Style="flex-wrap:wrap;">
                    <MudChip T="string" Variant="Variant.Outlined">
                        @_sprintReport.AverageVelocity.ToString("0.##") avg velocity
                    </MudChip>
                    <MudChip T="string" Variant="Variant.Outlined">
                        @_sprintReport.TotalCompletedPoints.ToString("0.##") points delivered
                    </MudChip>
                    @if (_sprintReport.AverageCapacityUtilizationPercent.HasValue)
                    {
                        <MudChip T="string" Variant="Variant.Outlined">
                            @_sprintReport.AverageCapacityUtilizationPercent.Value.ToString("0.#")% capacity
                        </MudChip>
                    }
                </MudStack>
                @if (_sprintReport.ActiveForecast is { } forecast)
                {
                    <MudAlert Severity="@(forecast.IsOverCapacity ? Severity.Warning : Severity.Info)"
                              Variant="Variant.Outlined" Class="mt-3">
                        <b>@forecast.SprintName:</b>
                        @forecast.RemainingPoints.ToString("0.##") points remaining.
                        @if (forecast.ProjectedSprintsRequired.HasValue)
                        {
                            <span>
                                At the historical velocity of @forecast.AverageVelocity.ToString("0.##"),
                                this is approximately @forecast.ProjectedSprintsRequired.Value.ToString("0.##") sprint(s) of work.
                            </span>
                        }
                        else
                        {
                            <span>A forecast needs at least one completed sprint with delivered points.</span>
                        }
                    </MudAlert>
                }
                @if (_sprintReport.Burndown.FirstOrDefault(x => x.Status == "Active") is { } activeSeries &&
                     activeSeries.Points.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3">Recent burndown changes</MudText>
                    @foreach (var point in activeSeries.Points.TakeLast(8).Reverse())
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-1">
                            <MudText Typo="Typo.caption">@ActivityLabel(point.Reason)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @point.RemainingPoints.ToString("0.##") remaining · @RelativeTime(point.OccurredAt)
                            </MudText>
                        </MudStack>
                    }
                }
            }
        }
        @if (_detail?.Board.AllowedActions.Contains(WorkSprintActions.Create) == true &&
             !_detail.Board.IsArchived)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudText Typo="Typo.subtitle1">Plan a sprint</MudText>
                <MudTextField T="string" Label="Name" @bind-Value="_sprintName"
                              Variant="Variant.Outlined" Class="mt-2" />
                <MudTextField T="string" Label="Goal" @bind-Value="_sprintGoal"
                              Variant="Variant.Outlined" Lines="2" Class="mt-2" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.Add"
                           Disabled="@(_saving || string.IsNullOrWhiteSpace(_sprintName))"
                           OnClick="CreateSprintAsync" Class="mt-2">
                    Create sprint
                </MudButton>
            </MudPaper>
        }
        @if (_sprints.Count == 0)
        {
            <MudText Color="Color.Secondary" Class="mt-4">No sprints have been planned.</MudText>
        }
        @foreach (var sprint in _sprints)
        {
            <MudPaper Outlined="true" Class="pa-3 mt-3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.subtitle1">@sprint.Name</MudText>
                        <MudText Typo="Typo.body2">@sprint.Goal</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @sprint.Status · @sprint.CompletedItemCount/@sprint.ItemCount completed
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @sprint.CompletedPoints.ToString("0.##")/@sprint.PlannedPoints.ToString("0.##") points
                            @if (sprint.CapacityPoints.HasValue)
                            {
                                <span> · @sprint.CapacityPoints.Value.ToString("0.##") capacity</span>
                            }
                        </MudText>
                    </div>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(sprint.Status == "Active" ? Color.Success : Color.Default)">
                        @sprint.Status
                    </MudChip>
                </MudStack>
                <MudStack Row="true" Class="mt-2">
                    @if (sprint.Status == "Planned" &&
                         _detail?.Board.AllowedActions.Contains(WorkSprintActions.Start) == true)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Success"
                                   Disabled="_saving"
                                   OnClick="@(() => ChangeSprintStateAsync(sprint, "start"))">
                            Start
                        </MudButton>
                    }
                    @if (sprint.Status == "Active" &&
                         _detail?.Board.AllowedActions.Contains(WorkSprintActions.Complete) == true)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary"
                                   Disabled="_saving"
                                   OnClick="@(() => ChangeSprintStateAsync(sprint, "complete"))">
                            Complete
                        </MudButton>
                    }
                    @if ((sprint.Status == "Planned" || sprint.Status == "Active") &&
                         _detail?.Board.AllowedActions.Contains(WorkSprintActions.Cancel) == true)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error"
                                   Disabled="_saving"
                                   OnClick="@(() => ChangeSprintStateAsync(sprint, "cancel"))">
                            Cancel
                        </MudButton>
                    }
                    @if ((sprint.Status == "Planned" || sprint.Status == "Active") &&
                         _detail?.Board.AllowedActions.Contains(WorkSprintActions.ManageCapacity) == true)
                    {
                        <MudButton Variant="Variant.Text"
                                   OnClick="@(() => OpenCapacity(sprint))">
                            Capacity
                        </MudButton>
                    }
                    @if ((sprint.Status == "Completed" || sprint.Status == "Cancelled") &&
                         sprint.CompletedItemCount < sprint.ItemCount &&
                         _detail?.Board.AllowedActions.Contains(WorkSprintActions.CarryOver) == true &&
                         AssignableSprints.Any(x => x.Id != sprint.Id))
                    {
                        <MudButton Variant="Variant.Text"
                                   OnClick="@(() => OpenCarryover(sprint))">
                            Carry over
                        </MudButton>
                    }
                </MudStack>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _sprintsOpen = false)">Close</MudButton></DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_estimateOpen"
