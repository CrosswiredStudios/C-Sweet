    private void SelectAgentAccess(Guid? installationId)
    {
        _selectedAgentId = installationId;
        var actions = _boardGrants.Where(x =>
                x.SubjectKind == "AgentInstallation" &&
                x.SubjectId == installationId)
            .Select(x => x.Action)
            .ToHashSet(StringComparer.Ordinal);
        _agentAccessProfile = actions.Contains(WorkItemActions.Create) ? "Operator" :
            actions.Contains(WorkItemActions.Read) ? "ReadOnly" : "None";
    }

    private async Task SaveAgentAccessAsync()
    {
        if (_detail is null || !_selectedAgentId.HasValue) return;
        _saving = true;
        _agentAccessError = null;
        try
        {
            IReadOnlyList<string> actions = _agentAccessProfile switch
            {
                "ReadOnly" =>
                    [
                        WorkBoardActions.Read,
                        WorkItemActions.Read,
                        WorkSprintActions.Read,
                        WorkSprintActions.ReadReports,
                        WorkAutomationActions.Read
                    ],
                "Operator" =>
                [
                    WorkBoardActions.Read,
                    WorkItemActions.Read,
                    WorkItemActions.Create,
                    WorkItemActions.Update,
                    WorkItemActions.Move,
                    WorkItemActions.Complete,
                    WorkItemActions.Cancel,
                    WorkItemActions.Reopen,
                    WorkItemActions.Comment,
                    WorkItemActions.Transfer,
                    WorkItemActions.Estimate,
                    WorkSprintActions.Read,
                    WorkSprintActions.Create,
                    WorkSprintActions.Start,
                    WorkSprintActions.Complete,
                    WorkSprintActions.Cancel,
                    WorkSprintActions.ManageScope,
                    WorkSprintActions.ManageCapacity,
                    WorkSprintActions.CarryOver,
                    WorkSprintActions.ReadReports,
                    WorkAutomationActions.Read,
                    WorkAutomationActions.Manage
                ],
                _ => []
            };
            var response = await Http.PutAsJsonAsync(
                $"api/organizations/{OrganizationId:D}/work/boards/{_detail.Board.Id:D}/grants",
                new SetWorkBoardSubjectGrantsRequest(
                    "AgentInstallation", _selectedAgentId.Value, actions));
            if (!response.IsSuccessStatusCode)
            {
                _agentAccessError = await response.Content.ReadAsStringAsync();
                return;
            }
            _boardGrants = (_boardGrants.Where(x =>
                    x.SubjectKind != "AgentInstallation" ||
                    x.SubjectId != _selectedAgentId.Value)
                .Concat(await response.Content.ReadFromJsonAsync<IReadOnlyList<WorkBoardGrantResponse>>() ?? [])
                .ToList());
            _agentAccessOpen = false;
            await RefreshDetailAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private int ColumnIndex(Guid columnId) =>
        _detail is null ? -1 : _detail.Columns.Select((column, index) => (column, index))
            .First(pair => pair.column.Id == columnId).index;

    private bool CanMoveTo(WorkBoardItemResponse item, WorkBoardColumnResponse target)
    {
        if (_detail is null || _detail.Board.IsArchived) return false;
        var action = target.Category switch
        {
            "Done" when item.Status != "Completed" => WorkItemActions.Complete,
            "Cancelled" when item.Status != "Cancelled" => WorkItemActions.Cancel,
            "ToDo" or "InProgress" when item.Status is "Completed" or "Cancelled" =>
                WorkItemActions.Reopen,
            _ => WorkItemActions.Move
        };
        return _detail.Board.AllowedActions.Contains(action);
    }

    private async Task SetFavoriteAsync(WorkBoardSummaryResponse board)
    {
        var response = await Http.PutAsJsonAsync(
            $"api/organizations/{OrganizationId:D}/work/boards/{board.Id:D}/favorite",
            new SetWorkBoardFavoriteRequest(!board.IsFavorite));
        response.EnsureSuccessStatusCode();
        await ReloadAsync();
    }

    private async Task ArchiveAsync(WorkBoardSummaryResponse board)
    {
        var response = await Http.PostAsync(
            $"api/organizations/{OrganizationId:D}/work/boards/{board.Id:D}/archive", null);
        if (response.IsSuccessStatusCode) await ReloadAsync();
        else _error = await response.Content.ReadAsStringAsync();
    }

    private async Task RestoreAsync(WorkBoardSummaryResponse board)
    {
        var response = await Http.PostAsync(
            $"api/organizations/{OrganizationId:D}/work/boards/{board.Id:D}/restore", null);
        if (response.IsSuccessStatusCode) await ReloadAsync();
        else _error = await response.Content.ReadAsStringAsync();
    }

    private static string Description(WorkBoardSummaryResponse board) =>
        string.IsNullOrWhiteSpace(board.Description) ? "No description provided." : board.Description;

    private WorkSprintResponse? SprintFor(Guid? sprintId) =>
        sprintId.HasValue ? _sprints.SingleOrDefault(x => x.Id == sprintId.Value) : null;

    private static string RelativeTime(DateTimeOffset value)
    {
        var age = DateTimeOffset.UtcNow - value;
        return age.TotalMinutes < 1 ? "Just now" :
            age.TotalHours < 1 ? $"{(int)age.TotalMinutes}m ago" :
            age.TotalDays < 1 ? $"{(int)age.TotalHours}h ago" :
            $"{(int)age.TotalDays}d ago";
    }

    private static string ActivityLabel(string eventType) => eventType switch
    {
        "comment.created" => "added a comment",
        "item.transferred" => "transferred the item",
        "item.created" => "created the item",
        "item.moved" => "moved the item",
        "item.completed" => "completed the item",
        "item.cancelled" => "cancelled the item",
        "item.reopened" => "reopened the item",
        "item.sprint.assigned" => "assigned the item to a sprint",
        "item.sprint.removed" => "moved the item to the backlog",
        "item.sprint.carried-over" => "carried the item into another sprint",
        "item.estimate.changed" => "changed the estimate",
        _ => eventType.Replace('.', ' ')
    };

    private void OnRealtimeEvent(AppRealtimeEventEnvelope envelope)
    {
        if (envelope.OrganizationId != OrganizationId ||
            envelope.EventType != AppRealtimeEvents.WorkBoardChanged ||
            _detail is null ||
            !envelope.Data.TryGetProperty("boardId", out var boardIdElement) ||
            !boardIdElement.TryGetGuid(out var boardId) ||
            boardId != _detail.Board.Id) return;
        _realtimeRefreshPending = true;
        if (_realtimeRefreshRunning) return;
        _ = InvokeAsync(RefreshFromRealtimeAsync);
    }

    private async Task RefreshFromRealtimeAsync()
    {
        if (_realtimeRefreshRunning) return;
        _realtimeRefreshRunning = true;
        try
        {
            while (_realtimeRefreshPending)
            {
                _realtimeRefreshPending = false;
                try
                {
                    await RefreshDetailAsync();
                    if (_collaborationOpen && _selectedItem is not null)
                        await LoadCollaborationAsync();
                    if (_sprintReport is not null)
                        await LoadSprintReportAsync();
                    if (_automationsOpen)
                        await LoadAutomationsAsync();
                }
                catch (Exception exception)
                {
                    _detailError = exception.Message;
                }
            }
        }
        finally
        {
            _realtimeRefreshRunning = false;
        }
    }

    public ValueTask DisposeAsync()
    {
        Realtime.EventReceived -= OnRealtimeEvent;
        return ValueTask.CompletedTask;
    }

    private sealed class ColumnDraft
    {
        public Guid? Id { get; init; }
        public string Name { get; set; } = "";
        public string Category { get; set; } = "InProgress";
        public string WipPolicy { get; set; } = "Disabled";
        public int? WipLimit { get; set; }
    }
