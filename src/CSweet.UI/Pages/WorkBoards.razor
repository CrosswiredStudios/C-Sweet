        _saving = true;
        _developerAssignmentError = null;
        try
        {
            var request = new AssignSoftwareDevelopmentWorkItemRequest(
                _developerInstallationId.Value,
                new SoftwareDevelopmentBrief(
                    _developerConnectionId.Value,
                    "software-development-polyglot-v1",
                    requirements,
                    acceptanceCriteria,
                    Lines(_developerConstraints)),
                _developerAssignmentItem.Revision,
                Guid.NewGuid().ToString("N"));
            var response = await Http.PutAsJsonAsync(
                $"api/organizations/{OrganizationId:D}/work/boards/{_detail.Board.Id:D}/items/{_developerAssignmentItem.Id:D}/developer-assignment",
                request);
            if (!response.IsSuccessStatusCode)
            {
                _developerAssignmentError = await response.Content.ReadAsStringAsync();
                return;
