<MudDialog @bind-Visible="_developerAssignmentOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Assign software developer</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            The selected installation will clone the granted repository into its isolated
            container workspace, implement and validate this ticket, then publish a reviewable PR.
        </MudText>
        <MudSelect T="Guid?" Label="Developer installation"
                   @bind-Value="_developerInstallationId"
                   Variant="Variant.Outlined" Class="mt-3" Required="true">
            @foreach (var installation in _developerInstallations)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)installation.Id)">
                    @installation.AgentName (@installation.AgentVersion)
                </MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid?" Label="Repository connection"
                   Value="_developerConnectionId"
                   ValueChanged="SelectDeveloperConnection"
                   Variant="Variant.Outlined" Class="mt-3" Required="true">
            @foreach (var connection in _repositoryConnections)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)connection.Id)">
                    @connection.Name — @connection.PermittedRepositoryPath
                </MudSelectItem>
            }
        </MudSelect>
        <MudTextField T="string" Label="Base branch" @bind-Value="_developerBaseBranch"
                      Variant="Variant.Outlined" Class="mt-3" Required="true" />
        <MudTextField T="string" Label="Requirements (one per line)"
                      @bind-Value="_developerRequirements"
                      Variant="Variant.Outlined" Lines="5" Class="mt-3" Required="true" />
        <MudTextField T="string" Label="Acceptance criteria (one per line)"
                      @bind-Value="_developerAcceptanceCriteria"
                      Variant="Variant.Outlined" Lines="5" Class="mt-3" Required="true" />
        <MudTextField T="string" Label="Constraints (one per line)"
                      @bind-Value="_developerConstraints"
                      Variant="Variant.Outlined" Lines="3" Class="mt-3" />
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
            This agent has trusted shell and Git access inside its container. Repository-scoped
            credentials, expiration, branch protection, and granted push permissions are the
            primary controls.
        </MudAlert>
        @if (!string.IsNullOrWhiteSpace(_developerAssignmentError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">
                @_developerAssignmentError
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        @if (_developerAssignmentItem?.AssignedInstallationId is not null)
        {
            <MudButton Color="Color.Error" Disabled="_saving"
                       OnClick="UnassignDeveloperAsync">Unassign</MudButton>
        }
        <MudButton OnClick="@(() => _developerAssignmentOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_saving || !_developerInstallationId.HasValue ||
                               !_developerConnectionId.HasValue)"
                   OnClick="AssignDeveloperAsync">
            @(_saving ? "Assigning..." : "Assign")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_columnsOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Configure columns</MudText></TitleContent>
    <DialogContent>
        @foreach (var draft in _columnDrafts)
        {
            <MudPaper Outlined="true" Class="pa-3 mt-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField T="string" Label="Name" @bind-Value="draft.Name"
                                  Variant="Variant.Outlined" />
                    <MudSelect T="string" Label="Category" @bind-Value="draft.Category"
                               Variant="Variant.Outlined">
                        @foreach (var category in ColumnCategories)
                        {
                            <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Label="WIP policy" @bind-Value="draft.WipPolicy"
                               Variant="Variant.Outlined">
                        @foreach (var policy in WipPolicies)
                        {
                            <MudSelectItem T="string" Value="@policy">@policy</MudSelectItem>
                        }
                    </MudSelect>
                    @if (draft.WipPolicy != "Disabled")
                    {
                        <MudNumericField T="int?" Label="Limit" @bind-Value="draft.WipLimit"
                                         Min="1" Variant="Variant.Outlined" />
                    }
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                   Color="Color.Error"
                                   Disabled="@(_columnDrafts.Count <= 2)"
                                   OnClick="@(() => _columnDrafts.Remove(draft))"
                                   aria-label="Remove column" />
                </MudStack>
            </MudPaper>
        }
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Add"
                   Class="mt-3" OnClick="AddColumn">Add column</MudButton>
        @if (!string.IsNullOrWhiteSpace(_columnsError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">@_columnsError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _columnsOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_saving" OnClick="SaveColumnsAsync">Save workflow</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid OrganizationId { get; set; }

    private WorkBoardDirectoryResponse? _directory;
    private WorkBoardSummaryResponse? _editingBoard;
    private WorkBoardSummaryResponse? _detailBoard;
    private WorkBoardDetailResponse? _detail;
    private string _search = "";
    private string _editorName = "";
    private string _editorDescription = "";
    private string? _error;
    private string? _editorError;
    private bool _includeArchived;
    private bool _favoritesOnly;
    private bool _loading;
    private bool _saving;
    private bool _forbidden;
    private bool _editorOpen;
    private bool _editorDefault;
    private bool _detailOpen;
    private bool _detailLoading;
    private bool _itemCreatorOpen;
    private bool _columnsOpen;
    private bool _agentAccessOpen;
    private bool _collaborationOpen;
    private bool _collaborationLoading;
    private bool _sprintsOpen;
    private bool _automationsOpen;
    private bool _estimateOpen;
    private bool _capacityOpen;
    private bool _carryoverOpen;
    private bool _developerAssignmentOpen;
    private bool _realtimeRefreshRunning;
    private bool _realtimeRefreshPending;
    private string _itemTitle = "";
    private string _itemDescription = "";
    private string _itemKind = "Task";
    private string? _itemError;
    private string? _columnsError;
    private string? _detailError;
    private string? _agentAccessError;
    private string? _collaborationError;
    private string _commentBody = "";
    private string _sprintName = "";
    private string _sprintGoal = "";
    private string? _sprintError;
    private string? _planningError;
    private string? _automationError;
    private string _automationName = "";
    private string _automationTrigger = "item.created";
    private string _automationAction = WorkItemActions.Move;
    private Guid? _automationConditionColumnId;
    private Guid? _automationTargetColumnId;
    private Guid? _selectedAgentId;
    private Guid? _transferBoardId;
    private WorkBoardItemResponse? _selectedItem;
    private WorkBoardItemResponse? _estimateItem;
    private WorkBoardItemResponse? _developerAssignmentItem;
    private WorkItemCollaborationResponse? _collaboration;
    private IReadOnlyList<WorkSprintResponse> _sprints = [];
    private WorkSprintResponse? _capacitySprint;
    private WorkSprintResponse? _carryoverSource;
    private WorkSprintReportResponse? _sprintReport;
    private WorkAutomationDirectoryResponse? _automations;
    private decimal? _estimatePoints;
    private decimal? _capacityPoints;
    private Guid? _carryoverTargetSprintId;
    private string _agentAccessProfile = "None";
    private readonly List<ColumnDraft> _columnDrafts = [];
    private IReadOnlyList<AgentInstallationResponse> _boardAgents = [];
    private IReadOnlyList<AgentInstallationResponse> _developerInstallations = [];
    private IReadOnlyList<GitRepositoryConnectionResponse> _repositoryConnections = [];
    private Guid? _developerInstallationId;
    private Guid? _developerConnectionId;
    private string _developerBaseBranch = "main";
    private string _developerRequirements = "";
    private string _developerAcceptanceCriteria = "";
    private string _developerConstraints = "";
    private string? _developerAssignmentError;
    private IReadOnlyList<WorkBoardGrantResponse> _boardGrants = [];
    private static readonly string[] WorkItemKinds = ["Initiative", "Epic", "Story", "Task", "Bug"];
    private static readonly string[] ColumnCategories = ["ToDo", "InProgress", "Done", "Cancelled"];
    private static readonly string[] WipPolicies = ["Disabled", "Warning", "HardLimit"];
    private static readonly string[] AutomationTriggers =
    [
        "item.created", "item.moved", "item.completed", "item.cancelled",
        "item.reopened", "item.sprint.assigned", "item.sprint.removed",
        "item.estimate.changed", "comment.created"
    ];
    private static readonly string[] AutomationItemActions =
    [
        WorkItemActions.Move, WorkItemActions.Complete,
        WorkItemActions.Cancel, WorkItemActions.Reopen
    ];
    private IReadOnlyList<WorkBoardSummaryResponse> TransferTargets =>
        _directory?.Boards.Where(board =>
                !board.IsArchived &&
                board.Id != _detail?.Board.Id &&
                board.AllowedActions.Contains(WorkItemActions.Transfer))
            .OrderBy(board => board.Name)
            .ToList() ?? [];
    private IReadOnlyList<WorkSprintResponse> AssignableSprints =>
        _sprints.Where(x => x.Status is "Planned" or "Active")
            .OrderByDescending(x => x.Status == "Active")
            .ThenBy(x => x.Name)
            .ToList();

    protected override void OnInitialized() =>
        Realtime.EventReceived += OnRealtimeEvent;

    protected override Task OnParametersSetAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        _forbidden = false;
        try
        {
            var query = new List<string>
            {
                $"includeArchived={_includeArchived.ToString().ToLowerInvariant()}",
                $"favoritesOnly={_favoritesOnly.ToString().ToLowerInvariant()}"
            };
            if (!string.IsNullOrWhiteSpace(_search))
                query.Add($"search={Uri.EscapeDataString(_search.Trim())}");
            var response = await Http.GetAsync(
                $"api/organizations/{OrganizationId:D}/work/boards?{string.Join('&', query)}");
            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _forbidden = true;
                return;
            }
            response.EnsureSuccessStatusCode();
            _directory = await response.Content.ReadFromJsonAsync<WorkBoardDirectoryResponse>();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await ReloadAsync();
    }

    private async Task SetFavoritesOnlyAsync(bool value)
    {
        _favoritesOnly = value;
        await ReloadAsync();
    }

    private async Task SetIncludeArchivedAsync(bool value)
    {
        _includeArchived = value;
        await ReloadAsync();
    }

    private void OpenCreate()
    {
        _editingBoard = null;
        _editorName = "";
        _editorDescription = "";
        _editorDefault = false;
        _editorError = null;
        _editorOpen = true;
    }

    private void OpenEdit(WorkBoardSummaryResponse board)
    {
        _editingBoard = board;
        _editorName = board.Name;
        _editorDescription = board.Description;
        _editorDefault = board.IsDefault;
