    private async Task LoadBoardAsync()
    {
        var boardId = BoardId ?? _detailBoard?.Id;
        if (!boardId.HasValue) return;
        _detailLoading = true;
        _detail = null;
        _detailError = null;
        try
        {
            var response = await Http.GetAsync(
                $"api/organizations/{OrganizationId:D}/work/boards/{boardId.Value:D}");
            if (!response.IsSuccessStatusCode)
            {
                _detailError = response.StatusCode switch
                {
                    HttpStatusCode.Forbidden =>
                        "You no longer have permission to view this board.",
                    HttpStatusCode.NotFound =>
                        "The board no longer exists or is no longer available.",
                    _ => "The server returned an error while loading the board. Please try again."
                };
                return;
            }

            _detail = await response.Content.ReadFromJsonAsync<WorkBoardDetailResponse>();
            if (_detail is null)
            {
                _detailError = "The server returned an empty board response. Please try again.";
                return;
            }

            await LoadSprintsAsync();
            await LoadOrchestrationAsync();
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
            _detailError = "The board request timed out. Check the server and try again.";
        }
        catch (HttpRequestException)
        {
            _detailError = "The board service could not be reached. Check that the application is running and try again.";
        }
        catch (Exception)
        {
            _detailError = "An unexpected error occurred while loading the board. Please try again.";
        }
        finally
        {
            _detailLoading = false;
        }
    }

