@page "/organizations/{OrganizationId:guid}/work"
@page "/organizations/{OrganizationId:guid}/work/boards/{BoardId:guid}"
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using CSweet.Contracts.WorkManagement
@using CSweet.Contracts.Agents
@using CSweet.Contracts.Realtime
@using CSweet.Contracts.Core
@using CSweet.UI.Components.WorkBoards
@using SoftwareDevelopmentBrief = CSweet.WorkManagement.Contracts.SoftwareDevelopmentBrief
@using WorkSprintPreflightResult = CSweet.WorkManagement.Contracts.WorkSprintPreflightResult
@using WorkOrchestrationPolicyRevision = CSweet.WorkManagement.Contracts.WorkOrchestrationPolicyRevision
@using WorkStageAssignment = CSweet.WorkManagement.Contracts.WorkStageAssignment
@using PersonalTodoDirectory = CSweet.WorkManagement.Contracts.PersonalTodoDirectory
@using PersonalTodoBoard = CSweet.WorkManagement.Contracts.PersonalTodoBoard
@using PersonalTodoItem = CSweet.WorkManagement.Contracts.PersonalTodoItem
@using AddPersonalTodoItemRequest = CSweet.WorkManagement.Contracts.AddPersonalTodoItemRequest
@using ReorderPersonalTodoItemRequest = CSweet.WorkManagement.Contracts.ReorderPersonalTodoItemRequest
@using RequeuePersonalTodoItemRequest = CSweet.WorkManagement.Contracts.RequeuePersonalTodoItemRequest
@implements IAsyncDisposable
@inject HttpClient Http
@inject AppRealtimeState Realtime
@inject NavigationManager Navigation

<PageTitle>Work - C-Sweet</PageTitle>

@if (!BoardId.HasValue)
{
<MudPaper Elevation="1" Class="surface-panel">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">Company work</MudText>
            <MudText Typo="Typo.h4">Boards</MudText>
            <MudText Color="Color.Secondary">
                Find and manage the operational boards you are granted to access.
            </MudText>
        </div>
        @if (_directory?.CanCreateBoard == true)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenCreate">
                New board
            </MudButton>
        }
    </MudStack>

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-5" Style="flex-wrap: wrap;">
        <MudTextField T="string" Label="Search boards" @bind-Value="_search"
                      Variant="Variant.Outlined" Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Outlined.Search"
                      OnKeyDown="SearchKeyDown" Immediate="true" />
        <MudSwitch T="bool" Value="_favoritesOnly" Color="Color.Primary"
                   ValueChanged="SetFavoritesOnlyAsync">Favorites only</MudSwitch>
        <MudSwitch T="bool" Value="_includeArchived" Color="Color.Primary"
                   ValueChanged="SetIncludeArchivedAsync">Show archived</MudSwitch>
        <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Color="Color.Primary"
                       Disabled="_loading" OnClick="ReloadAsync" aria-label="Refresh boards" />
    </MudStack>

    @if (_forbidden)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
            You do not have a board read grant for this company.
        </MudAlert>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert>
    }
    else if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-4" />
    }
    else if (_directory?.Boards.Count is null or 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
            No boards match the current filters.
        </MudAlert>
    }
    else
    {
        <MudGrid Class="mt-3">
            @foreach (var board in _directory!.Boards)
            {
                <MudItem xs="12" md="6" xl="4">
                    <MudCard Outlined="true" Style="height: 100%;">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.h6">@board.Name</MudText>
                                    @if (board.IsDefault)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">Default</MudChip>
                                    }
                                    @if (board.IsArchived)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Archived</MudChip>
                                    }
                                </MudStack>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudIconButton Icon="@(board.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                               Color="@(board.IsFavorite ? Color.Warning : Color.Default)"
                                               OnClick="@(() => SetFavoriteAsync(board))"
                                               aria-label="@(board.IsFavorite ? "Remove from favorites" : "Add to favorites")" />
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.body2">@Description(board)</MudText>
                            <MudStack Row="true" Spacing="1" Class="mt-4" Style="flex-wrap: wrap;">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Outlined.TaskAlt">
                                    @board.ActiveItemCount active
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Outlined.AdminPanelSettings">
                                    @board.GrantedSubjectCount with access
                                </MudChip>
                                @if (board.LastVisitedAt.HasValue)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Icon="@Icons.Material.Outlined.History">
                                        @RelativeTime(board.LastVisitedAt.Value)
                                    </MudChip>
                                }
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Outlined.Visibility"
                                       OnClick="@(() => OpenBoardAsync(board))">View</MudButton>
                            @if (board.AllowedActions.Contains(WorkBoardActions.Configure))
                            {
                                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Edit"
                                           Disabled="board.IsArchived" OnClick="@(() => OpenEdit(board))">
                                    Configure
                                </MudButton>
                            }
                            <MudSpacer />
                            @if (!board.IsArchived && !board.IsDefault &&
                                 board.AllowedActions.Contains(WorkBoardActions.Archive))
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Archive"
                                               Color="Color.Warning" OnClick="@(() => ArchiveAsync(board))"
                                               aria-label="Archive board" />
                            }
                            else if (board.IsArchived &&
                                     board.AllowedActions.Contains(WorkBoardActions.Restore))
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Unarchive"
                                               Color="Color.Success" OnClick="@(() => RestoreAsync(board))"
                                               aria-label="Restore board" />
                            }
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudPaper>

@if (_personalTodos?.Boards.Count > 0)
{
    <MudPaper Elevation="1" Class="surface-panel mt-5">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.overline" Color="Color.Primary">Protected work</MudText>
                <MudText Typo="Typo.h5">Direct reports' personal to-do boards</MudText>
                <MudText Color="Color.Secondary">
                    Inspect priorities, add work, reorder ready items, and requeue blocked work.
                </MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Color="Color.Primary"
                           OnClick="LoadPersonalTodosAsync" aria-label="Refresh personal boards" />
        </MudStack>
        <MudExpansionPanels Class="mt-4" MultiExpansion="true">
            @foreach (var board in _personalTodos.Boards)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6">@board.OwnerDisplayName</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @board.Items.Count item(s)
                            </MudChip>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <EmployeePersonalBoard OrganizationId="OrganizationId"
                            EmployeeId="board.OwnerOrganizationUserId" Board="board"
                            CanAdd="true"
                            CanExecute="@(_personalTodos.CurrentOrganizationUserId == board.OwnerOrganizationUserId)"
                            RefreshRequested="LoadPersonalTodosAsync" />
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
        @if (!string.IsNullOrWhiteSpace(_personalTodoError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">
                @_personalTodoError
            </MudAlert>
        }
    </MudPaper>
}
}

<MudDialog @bind-Visible="_editorOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editingBoard is null ? "Create board" : "Configure board")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" Label="Name" @bind-Value="_editorName"
                      Variant="Variant.Outlined" Required="true" Class="mt-2" />
        <MudTextField T="string" Label="Description" @bind-Value="_editorDescription"
                      Variant="Variant.Outlined" Lines="3" Class="mt-3" />
        <MudTextField T="string" Label="Board key" @bind-Value="_editorKey"
                      Variant="Variant.Outlined" Required="true" Class="mt-3"
                      HelperText="2–12 uppercase letters or digits; used in immutable ticket identifiers." />
        <MudSelect T="Guid?" Label="Board manager" @bind-Value="_editorManagerId"
                   Variant="Variant.Outlined" Required="true" Class="mt-3">
            @foreach (var person in _organizationUsers.Where(x => x.IsActive).OrderBy(x => x.DisplayName))
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)person.Id)">@person.DisplayName</MudSelectItem>
            }
        </MudSelect>
        @if (_editingBoard is not null)
        {
            <MudSwitch T="bool" @bind-Value="_editorDefault" Color="Color.Primary" Class="mt-3">
                Default company board
            </MudSwitch>
        }
        @if (!string.IsNullOrWhiteSpace(_editorError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">@_editorError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _editorOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                   OnClick="SaveEditorAsync">@(_saving ? "Saving..." : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@if (BoardId.HasValue)
{
<main class="kanban-workspace">
    <header class="kanban-header">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ArrowBack"
                   OnClick="BackToBoards">All boards</MudButton>
        <div class="kanban-heading">
            <MudText Typo="Typo.overline" Color="Color.Primary">Company work / Board</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.h4">@(_detail?.Board.Name ?? "Board")</MudText>
                @if (!string.IsNullOrWhiteSpace(_detail?.Board.Key))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_detail.Board.Key</MudChip>
                }
                @if (_detail?.Board.IsArchived == true)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Archived · read only</MudChip>
                }
            </MudStack>
        </div>
        @if (_detail is not null)
        {
            <MudIconButton Icon="@(_detail.Board.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                           Color="@(_detail.Board.IsFavorite ? Color.Warning : Color.Default)"
                           OnClick="@(() => SetFavoriteAsync(_detail.Board))" aria-label="Toggle favorite" />
        }
    </header>
    <section class="kanban-content">
        @if (_detailLoading)
        {
            <MudStack Spacing="2">
                <MudProgressLinear Indeterminate="true" />
                <MudText Color="Color.Secondary">Loading board details…</MudText>
            </MudStack>
        }
        else if (!string.IsNullOrWhiteSpace(_detailError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                <MudText Typo="Typo.subtitle2">This board could not be loaded.</MudText>
                <MudText Typo="Typo.body2">@_detailError</MudText>
            </MudAlert>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">
                Your board list and existing work are unchanged. You can retry the request or close this window.
            </MudText>
        }
        else if (_detail is not null)
        {
            <MudText Color="Color.Secondary">@Description(_detail.Board)</MudText>
            <div class="kanban-toolbar">
                <MudTextField T="string" Label="Search this board" @bind-Value="_itemSearch"
                              Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
                @if (_detail.Board.AllowedActions.Contains(WorkItemActions.Create) && !_detail.Board.IsArchived)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.AddTask"
                               OnClick="OpenItemCreator">New work item</MudButton>
                }
                <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Disabled="_detailLoading"
                               OnClick="RetryBoardAsync" aria-label="Refresh board" />
                @if (_detail.Board.AllowedActions.Contains(WorkSprintActions.Read))
                {
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Outlined.EventNote"
                               OnClick="@(() => _sprintsOpen = true)">Sprints</MudButton>
                }
                @if (_detail.Board.AllowedActions.Contains(WorkOrchestrationActions.Read))
                {
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Outlined.AccountTree"
                               OnClick="OpenOrchestrationAsync">Orchestration</MudButton>
                }
                @if (_detail.Board.AllowedActions.Contains(WorkBoardActions.ConfigureColumns) &&
                     !_detail.Board.IsArchived)
                {
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Outlined.ViewColumn"
                               OnClick="OpenColumnEditor">Configure columns</MudButton>
                }
                @if (_detail.Board.AllowedActions.Contains(WorkBoardActions.ManageGrants) ||
                     _detail.Board.AllowedActions.Contains(WorkAutomationActions.Manage))
                {
                    <MudMenu Icon="@Icons.Material.Outlined.MoreVert" AriaLabel="More board actions">
                        @if (_detail.Board.AllowedActions.Contains(WorkAutomationActions.Manage))
                        {
                            <MudMenuItem OnClick="OpenAutomationsAsync">Automations</MudMenuItem>
                        }
                        @if (_detail.Board.AllowedActions.Contains(WorkBoardActions.ManageGrants))
                        {
                            <MudMenuItem OnClick="OpenAgentAccessAsync">Access management</MudMenuItem>
                        }
                    </MudMenu>
                }
            </div>
            @if (_movePending)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2" />
            }
            @if (_deliveryPipeline is not null)
            {
                <MudPaper Outlined="true" Class="pa-3 mt-3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.subtitle1"><b>Delivery pipeline</b></MudText>
                            <MudText Typo="Typo.body2">
                                @_deliveryPipeline.Status · @_deliveryPipeline.Stage
                                @if (_deliveryPipeline.QualityCycle > 0)
                                {
                                    <span> · QA cycle @_deliveryPipeline.QualityCycle</span>
                                }
                                @if (_deliveryPipeline.MergeStatus != "None")
                                {
                                    <span> · merge @_deliveryPipeline.MergeStatus</span>
                                }
                            </MudText>
                            @if (_deliveryPipeline.ActiveSprintId.HasValue)
                            {
                                <MudText Typo="Typo.caption">
                                    Sprint @_deliveryPipeline.ActiveSprintId · ticket @_deliveryPipeline.ActiveWorkItemId
                                </MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(_deliveryPipeline.SourcePullRequestUrl))
                            {
                                <MudLink Href="@_deliveryPipeline.SourcePullRequestUrl" Target="_blank">
                                    Source pull request
                                </MudLink>
                            }
                        </div>
                        <MudChip T="string" Color="@PipelineColor(_deliveryPipeline.Status)">
                            @_deliveryPipeline.Status
                        </MudChip>
                    </MudStack>
                    @if (!string.IsNullOrWhiteSpace(_deliveryPipeline.LastError))
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2">
                            @_deliveryPipeline.LastError
                            @if (!string.IsNullOrWhiteSpace(_deliveryPipeline.ResumeAction))
                            {
                                <div>@_deliveryPipeline.ResumeAction</div>
                            }
                        </MudAlert>
                    }
                </MudPaper>
            }
            @if (!string.IsNullOrWhiteSpace(_moveError))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">@_moveError</MudAlert>
            }
            <div class="kanban-columns">
                @foreach (var column in _detail.Columns)
                {
                    var columnItems = WorkBoardPresentation.ItemsForColumn(
                        _detail.Items, column.Id, _itemSearch);
                    <MudPaper Outlined="true" Class="@($"kanban-column {DropClass(column)}")"
                              @ondragover:preventDefault="true"
                              @ondragenter="@(() => _dragTargetColumnId = column.Id)"
                              @ondragleave="@(() => ClearDragTarget(column.Id))"
                              @ondrop="@(() => DropItemAsync(column, null))">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="kanban-column-header">
                            <MudText Typo="Typo.subtitle1"><b>@column.Name</b></MudText>
                            <MudChip T="int" Size="Size.Small">@columnItems.Count</MudChip>
                        </MudStack>
                        @if (column.WipLimit.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="@WipColor(column, columnItems.Count)">
                                @columnItems.Count / @column.WipLimit WIP · @column.WipPolicy
                            </MudText>
                        }
                        @foreach (var item in columnItems)
                        {
                            <div @ondragover:preventDefault="true"
                                 @ondrop:stopPropagation="true"
                                 @ondrop="@(() => DropItemAsync(column, item.Id))">
                            <MudCard Outlined="true" Class="kanban-card"
                                     draggable="@CanDrag(item)"
                                     @ondragstart="@(() => BeginDrag(item))"
                                     @ondragend="EndDrag">
                                <MudCardContent>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.overline" Color="Color.Primary">@(item.Identifier ?? item.Kind)</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@PriorityColor(item.Priority)">@item.Priority</MudChip>
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Kind</MudText>
                                    <MudText Typo="Typo.subtitle2"><StructuredMentionText Text="@item.Title" Mentions="@item.Mentions" Field="@CSweet.WorkManagement.Contracts.WorkItemMentionFields.Title" /></MudText>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <MudText Typo="Typo.caption"><StructuredMentionText Text="@item.Description" Mentions="@item.Mentions" Field="@CSweet.WorkManagement.Contracts.WorkItemMentionFields.Description" /></MudText>
                                    }
                                    @if (SprintFor(item.SprintId) is { } sprint)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                                 Variant="Variant.Outlined" Class="mt-2">
                                            @sprint.Name
                                        </MudChip>
                                    }
                                    @if (item.EstimatePoints.HasValue)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Class="mt-2 ml-1">
                                            @item.EstimatePoints.Value.ToString("0.##") pts
                                        </MudChip>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.AssignedDisplayName))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                                 Variant="Variant.Outlined" Class="mt-2 ml-1"
                                                 Icon="@Icons.Material.Outlined.Code">
                                            @item.AssignedDisplayName
                                        </MudChip>
                                    }
                                    @if (item.DueDate.HasValue)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Color="@DueDateColor(item.DueDate.Value)" Class="mt-2 ml-1">
                                            Due @item.DueDate.Value.ToLocalTime().ToString("MMM d")
                                        </MudChip>
                                    }
                                </MudCardContent>
                                <MudCardActions>
                                    <MudIconButton Icon="@Icons.Material.Outlined.Forum"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenCollaborationAsync(item))"
                                                   aria-label="Comments and activity" />
                                    @if (_detail.Board.AllowedActions.Contains(WorkItemActions.Estimate) &&
                                         !_detail.Board.IsArchived)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Outlined.Calculate"
                                                       Size="Size.Small"
                                                       OnClick="@(() => OpenEstimate(item))"
                                                       aria-label="Set estimate" />
                                    }
                                    @if (_detail.Board.AllowedActions.Contains(WorkSprintActions.ManageScope) &&
                                         !_detail.Board.IsArchived)
                                    {
                                        <MudMenu Icon="@Icons.Material.Outlined.EventAvailable"
                                                 Size="Size.Small"
                                                 AriaLabel="Assign sprint">
                                            <MudMenuItem Disabled="@(!item.SprintId.HasValue)"
                                                         OnClick="@(() => SetItemSprintAsync(item, null))">
                                                Backlog (no sprint)
                                            </MudMenuItem>
                                            @foreach (var sprintOption in AssignableSprints)
                                            {
                                                <MudMenuItem Disabled="@(item.SprintId == sprintOption.Id)"
                                                             OnClick="@(() => SetItemSprintAsync(item, sprintOption.Id))">
                                                    @sprintOption.Name
                                                </MudMenuItem>
                                            }
                                        </MudMenu>
                                    }
                                    <MudSpacer />
                                    <MudMenu Icon="@Icons.Material.Outlined.DriveFileMove" Size="Size.Small"
                                             AriaLabel="Move work item to another column">
                                        @foreach (var targetColumn in _detail.Columns)
                                        {
                                            <MudMenuItem Disabled="@(!CanMoveTo(item, targetColumn))"
                                                         OnClick="@(() => MoveItemAsync(item, targetColumn))">
                                                Move to @targetColumn.Name
                                            </MudMenuItem>
                                        }
                                    </MudMenu>
                                </MudCardActions>
                            </MudCard>
                            </div>
                        }
                        @if (columnItems.Count == 0)
                        {
                            <div class="kanban-empty">Drop work here or create a new item.</div>
                        }
                    </MudPaper>
                }
            </div>
        }
    </section>
</main>
}

<MudDialog @bind-Visible="_automationsOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Board automations</MudText></TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_automationError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
                @_automationError
            </MudAlert>
        }
        @if (_detail?.Board.AllowedActions.Contains(WorkAutomationActions.Manage) == true &&
             !_detail.Board.IsArchived)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudText Typo="Typo.subtitle1">New event rule</MudText>
                <MudTextField T="string" Label="Name" @bind-Value="_automationName"
                              Variant="Variant.Outlined" Class="mt-2" />
                <MudSelect T="string" Label="When" @bind-Value="_automationTrigger"
                           Variant="Variant.Outlined" Class="mt-2">
                    @foreach (var trigger in AutomationTriggers)
                    {
                        <MudSelectItem T="string" Value="@trigger">@ActivityLabel(trigger)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid?" Label="Only while in column"
                           @bind-Value="_automationConditionColumnId"
                           Clearable="true" Variant="Variant.Outlined" Class="mt-2">
                    @foreach (var column in _detail.Columns)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)column.Id)">@column.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Label="Action" @bind-Value="_automationAction"
                           Variant="Variant.Outlined" Class="mt-2">
                    @foreach (var action in AutomationItemActions)
                    {
                        <MudSelectItem T="string" Value="@action">@action.Replace("work.item.", "")</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid?" Label="Target column" @bind-Value="_automationTargetColumnId"
                           Variant="Variant.Outlined" Class="mt-2">
                    @foreach (var column in _detail.Columns)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)column.Id)">@column.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                           Disabled="@(_saving || string.IsNullOrWhiteSpace(_automationName) ||
                                       !_automationTargetColumnId.HasValue)"
                           OnClick="CreateAutomationAsync">
                    Create disabled rule
                </MudButton>
            </MudPaper>
        }
        @if (_automations?.Rules.Count is null or 0)
        {
            <MudText Color="Color.Secondary" Class="mt-4">No automation rules are configured.</MudText>
        }
        else
        {
            @foreach (var rule in _automations.Rules)
            {
                <MudPaper Outlined="true" Class="pa-3 mt-3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.subtitle1">@rule.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @ActivityLabel(rule.TriggerEventType) → @rule.Action.Replace("work.item.", "")
                            </MudText>
                            <MudText Typo="Typo.caption" Style="display:block;">
                                Identity: @rule.AutomationIdentityId
                            </MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(rule.IsEnabled && rule.HasExecutionGrant ? Color.Success :
                                          rule.IsEnabled ? Color.Warning : Color.Default)">
                            @(rule.IsEnabled ? (rule.HasExecutionGrant ? "Active" : "Grant missing") : "Disabled")
                        </MudChip>
                    </MudStack>
                    <MudStack Row="true" Class="mt-2">
                        @if (_detail?.Board.AllowedActions.Contains(WorkAutomationActions.Manage) == true)
                        {
                            <MudButton Variant="Variant.Text"
                                       OnClick="@(() => ToggleAutomationAsync(rule))">
                                @(rule.IsEnabled ? "Disable" : "Enable")
                            </MudButton>
                        }
                        @if (!rule.HasExecutionGrant &&
                             _detail?.Board.AllowedActions.Contains(WorkBoardActions.ManageGrants) == true)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                       OnClick="@(() => GrantAutomationAsync(rule))">
                                Grant @rule.Action.Replace("work.item.", "")
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>
            }
        }
        @if (_automations?.RecentExecutions.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4">Recent executions</MudText>
            @foreach (var execution in _automations.RecentExecutions.Take(20))
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-1">
                    <MudText Typo="Typo.caption">@execution.Status · @execution.RequiredAction</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @RelativeTime(execution.CompletedAt)
                    </MudText>
                </MudStack>
            }
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _automationsOpen = false)">Close</MudButton></DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_sprintsOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Sprints</MudText></TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_sprintError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
                @_sprintError
            </MudAlert>
        }
        @if (_detail?.Board.AllowedActions.Contains(WorkSprintActions.ReadReports) == true)
        {
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Outlined.Insights"
                       OnClick="LoadSprintReportAsync">
                Refresh report
            </MudButton>
            @if (_sprintReport is not null)
            {
                <MudStack Row="true" Class="mt-3" Style="flex-wrap:wrap;">
                    <MudChip T="string" Variant="Variant.Outlined">
                        @_sprintReport.AverageVelocity.ToString("0.##") avg velocity
                    </MudChip>
                    <MudChip T="string" Variant="Variant.Outlined">
                        @_sprintReport.TotalCompletedPoints.ToString("0.##") points delivered
                    </MudChip>
                    @if (_sprintReport.AverageCapacityUtilizationPercent.HasValue)
                    {
                        <MudChip T="string" Variant="Variant.Outlined">
                            @_sprintReport.AverageCapacityUtilizationPercent.Value.ToString("0.#")% capacity
                        </MudChip>
                    }
                </MudStack>
                @if (_sprintReport.ActiveForecast is { } forecast)
                {
                    <MudAlert Severity="@(forecast.IsOverCapacity ? Severity.Warning : Severity.Info)"
                              Variant="Variant.Outlined" Class="mt-3">
                        <b>@forecast.SprintName:</b>
                        @forecast.RemainingPoints.ToString("0.##") points remaining.
                        @if (forecast.ProjectedSprintsRequired.HasValue)
                        {
                            <span>
                                At the historical velocity of @forecast.AverageVelocity.ToString("0.##"),
                                this is approximately @forecast.ProjectedSprintsRequired.Value.ToString("0.##") sprint(s) of work.
                            </span>
                        }
                        else
                        {
                            <span>A forecast needs at least one completed sprint with delivered points.</span>
                        }
                    </MudAlert>
                }
                @if (_sprintReport.Burndown.FirstOrDefault(x => x.Status == "Active") is { } activeSeries &&
                     activeSeries.Points.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3">Recent burndown changes</MudText>
                    @foreach (var point in activeSeries.Points.TakeLast(8).Reverse())
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-1">
                            <MudText Typo="Typo.caption">@ActivityLabel(point.Reason)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @point.RemainingPoints.ToString("0.##") remaining · @RelativeTime(point.OccurredAt)
                            </MudText>
                        </MudStack>
                    }
                }
            }
        }
        @if (_detail?.Board.AllowedActions.Contains(WorkSprintActions.Create) == true &&
             !_detail.Board.IsArchived)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudText Typo="Typo.subtitle1">Plan a sprint</MudText>
                <MudTextField T="string" Label="Name" @bind-Value="_sprintName"
                              Variant="Variant.Outlined" Class="mt-2" />
                <MudTextField T="string" Label="Goal" @bind-Value="_sprintGoal"
                              Variant="Variant.Outlined" Lines="2" Class="mt-2" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.Add"
                           Disabled="@(_saving || string.IsNullOrWhiteSpace(_sprintName))"
                           OnClick="CreateSprintAsync" Class="mt-2">
                    Create sprint
                </MudButton>
            </MudPaper>
        }
        @if (_sprints.Count == 0)
        {
            <MudText Color="Color.Secondary" Class="mt-4">No sprints have been planned.</MudText>
        }
        @foreach (var sprint in _sprints)
        {
            <MudPaper Outlined="true" Class="pa-3 mt-3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.subtitle1">@sprint.Name</MudText>
                        <MudText Typo="Typo.body2">@sprint.Goal</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @sprint.Status · @sprint.CompletedItemCount/@sprint.ItemCount completed
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @sprint.CompletedPoints.ToString("0.##")/@sprint.PlannedPoints.ToString("0.##") points
                            @if (sprint.CapacityPoints.HasValue)
                            {
                                <span> · @sprint.CapacityPoints.Value.ToString("0.##") capacity</span>
                            }
                        </MudText>
                    </div>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(sprint.Status == "Active" ? Color.Success : Color.Default)">
                        @sprint.Status
                    </MudChip>
                </MudStack>
                <MudStack Row="true" Class="mt-2">
                    @if (sprint.Status == "Planned" &&
                         _detail?.Board.AllowedActions.Contains(WorkOrchestrationActions.Start) == true)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Success"
                                   Disabled="_saving"
                                   OnClick="@(() => StartOrchestratedSprintAsync(sprint))">
                            Preflight &amp; start
                        </MudButton>
                    }
                    @if (sprint.Status == "Active" &&
                         _detail?.Board.AllowedActions.Contains(WorkOrchestrationActions.Pause) == true)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Warning"
                                   Disabled="_saving"
                                   OnClick="@(() => ControlOrchestratedSprintAsync(sprint, "pause"))">
                            Pause
                        </MudButton>
                    }
                    @if (sprint.Status == "Paused" &&
                         _detail?.Board.AllowedActions.Contains(WorkOrchestrationActions.Resume) == true)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Success" Disabled="_saving"
                                   OnClick="@(() => ControlOrchestratedSprintAsync(sprint, "resume"))">Resume</MudButton>
                    }
                    @if ((sprint.Status == "Active" || sprint.Status == "Paused") &&
                         _detail?.Board.AllowedActions.Contains(WorkOrchestrationActions.Cancel) == true)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error"
                                   Disabled="_saving"
                                   OnClick="@(() => ControlOrchestratedSprintAsync(sprint, "cancel"))">
                            Cancel
                        </MudButton>
                    }
                    @if ((sprint.Status == "Planned" || sprint.Status == "Active") &&
                         _detail?.Board.AllowedActions.Contains(WorkSprintActions.ManageCapacity) == true)
                    {
                        <MudButton Variant="Variant.Text"
                                   OnClick="@(() => OpenCapacity(sprint))">
                            Capacity
                        </MudButton>
                    }
                    @if ((sprint.Status == "Completed" || sprint.Status == "Cancelled") &&
                         sprint.CompletedItemCount < sprint.ItemCount &&
                         _detail?.Board.AllowedActions.Contains(WorkSprintActions.CarryOver) == true &&
                         AssignableSprints.Any(x => x.Id != sprint.Id))
                    {
                        <MudButton Variant="Variant.Text"
                                   OnClick="@(() => OpenCarryover(sprint))">
                            Carry over
                        </MudButton>
                    }
                    @if (sprint.Status is "Active" or "Paused" or "Completed" or "Cancelled")
                    {
                        <MudButton Variant="Variant.Text" OnClick="@(() => OpenExecutionAsync(sprint))">Execution</MudButton>
                    }
                </MudStack>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _sprintsOpen = false)">Close</MudButton></DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_executionOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Sprint execution</MudText></TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_executionError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_executionError</MudAlert>
        }
        @if (_execution is not null)
        {
            <MudStack Row="true" Spacing="2" Class="mb-3">
                <MudChip T="string" Color="@ExecutionColor(_execution.Status)">@_execution.Status</MudChip>
                <MudText Typo="Typo.caption">Policy @_execution.PolicyRevisionId · updated @RelativeTime(_execution.UpdatedAt)</MudText>
            </MudStack>
            @foreach (var item in _execution.Items.OrderBy(x => x.ItemIdentifier))
            {
                var current = item.Stages.OrderByDescending(x => x.UpdatedAt).FirstOrDefault();
                <MudPaper Outlined="true" Class="pa-3 mt-2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.subtitle1">@item.ItemIdentifier</MudText>
                            <MudText Typo="Typo.body2">@item.CurrentStageKey · @item.Status</MudText>
                            @if (current is not null)
                            {
                                <MudText Typo="Typo.caption">@current.PrincipalKind · attempt @current.AttemptCount · @current.LastSummary</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.BlockedReason))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">@item.BlockedReason</MudText>
                            }
                        </div>
                        @if (current is not null)
                        {
                            <MudStack Row="true" Spacing="1">
                                @if (current.Status == "WaitingForApproval")
                                {
                                    <MudButton Size="Size.Small" Color="Color.Success" OnClick="@(() => DecideStageAsync(current, true))">Approve</MudButton>
                                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => DecideStageAsync(current, false))">Reject</MudButton>
                                }
                                @if (current.Status == "WaitingForHuman")
                                {
                                    <MudButton Size="Size.Small" Color="Color.Primary" OnClick="@(() => CompleteManualStageAsync(current))">Complete</MudButton>
                                }
                                @if (current.Status is "Blocked" or "Failed")
                                {
                                    <MudButton Size="Size.Small" Color="Color.Warning" OnClick="@(() => RetryStageAsync(current))">Retry</MudButton>
                                }
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>
            }
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _executionOpen = false)">Close</MudButton></DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_estimateOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Estimate work item</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2">@_estimateItem?.Title</MudText>
        <MudNumericField T="decimal?" Label="Story points" @bind-Value="_estimatePoints"
                         Min="0" Max="999999.99m" Variant="Variant.Outlined" Class="mt-3"
                         HelperText="Leave empty to remove the estimate." />
        @if (!string.IsNullOrWhiteSpace(_planningError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">
                @_planningError
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _estimateOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_saving" OnClick="SaveEstimateAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_capacityOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Sprint capacity</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2">@_capacitySprint?.Name</MudText>
        <MudNumericField T="decimal?" Label="Capacity points" @bind-Value="_capacityPoints"
                         Min="0" Max="999999.99m" Variant="Variant.Outlined" Class="mt-3"
                         HelperText="Leave empty for no capacity target." />
        @if (!string.IsNullOrWhiteSpace(_planningError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">
                @_planningError
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _capacityOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_saving" OnClick="SaveCapacityAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_carryoverOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Carry over incomplete work</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            The completed sprint snapshot remains unchanged. Current incomplete cards move to the selected sprint.
        </MudAlert>
        <MudSelect T="Guid?" Label="Target sprint" @bind-Value="_carryoverTargetSprintId"
                   Variant="Variant.Outlined" Class="mt-3">
            @foreach (var sprint in AssignableSprints.Where(x => x.Id != _carryoverSource?.Id))
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)sprint.Id)">@sprint.Name</MudSelectItem>
            }
        </MudSelect>
        @if (!string.IsNullOrWhiteSpace(_planningError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">
                @_planningError
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _carryoverOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_saving || !_carryoverTargetSprintId.HasValue)"
                   OnClick="CarryOverAsync">Carry over all incomplete</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_collaborationOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_selectedItem?.Title ?? "Work item")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_collaborationLoading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_collaborationError))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
                    @_collaborationError
                </MudAlert>
            }
            <MudText Typo="Typo.subtitle1">Comments</MudText>
            @if (_collaboration?.Comments.Count is null or 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                    No comments yet.
                </MudText>
            }
            else
            {
                @foreach (var comment in _collaboration!.Comments.OrderByDescending(x => x.CreatedAt))
                {
                    <MudPaper Outlined="true" Class="pa-3 mt-2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle2">@comment.AuthorDisplayName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @RelativeTime(comment.CreatedAt)
                            </MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Class="mt-1">@comment.Body</MudText>
                    </MudPaper>
                }
            }
            @if (_detail?.Board.AllowedActions.Contains(WorkItemActions.Comment) == true &&
                 !_detail.Board.IsArchived)
            {
                <MudTextField T="string" Label="Add a comment" @bind-Value="_commentBody"
                              Variant="Variant.Outlined" Lines="3" Class="mt-4" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.Send"
                           Disabled="@(_saving || string.IsNullOrWhiteSpace(_commentBody))"
                           OnClick="AddCommentAsync" Class="mt-2">
                    Comment
                </MudButton>
            }

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle1">Activity</MudText>
            @if (_collaboration?.Activity.Count is null or 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                    No recorded activity yet.
                </MudText>
            }
            else
            {
                @foreach (var activity in _collaboration!.Activity.Take(50))
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-2">
                        <MudText Typo="Typo.body2">
                            @activity.ActorDisplayName · @ActivityLabel(activity.EventType)
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @RelativeTime(activity.OccurredAt)
                        </MudText>
                    </MudStack>
                }
            }

            @if (_detail?.Board.AllowedActions.Contains(WorkItemActions.Transfer) == true &&
                 TransferTargets.Count > 0 && !_detail.Board.IsArchived)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle1">Transfer to another board</MudText>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
                    The work item keeps one canonical state and leaves this board when transferred.
                </MudAlert>
                <MudSelect T="Guid?" Label="Destination board" @bind-Value="_transferBoardId"
                           Variant="Variant.Outlined" Class="mt-3">
                    @foreach (var board in TransferTargets)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)board.Id)">@board.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.DriveFileMove"
                           Disabled="@(_saving || !_transferBoardId.HasValue)"
                           OnClick="TransferItemAsync" Class="mt-2">
                    Transfer
                </MudButton>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _collaborationOpen = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_orchestrationOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Board orchestration</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Starting a sprint is the authorization boundary. C-Sweet dispatches only to the exact agents assigned on each ticket.
        </MudAlert>
        @if (PublishedPolicy is not null)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-3">@PublishedPolicy.Name</MudText>
            <MudText Typo="Typo.body2">Revision @PublishedPolicy.Revision · @PublishedPolicy.MergeMode · @PublishedPolicy.Stages.Count stages</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mt-3">No policy has been published for this board.</MudText>
        }
        <MudSelect T="Guid?" Label="Ready column" @bind-Value="_orchestrationReadyColumnId"
                   Variant="Variant.Outlined" Class="mt-3">
            @foreach (var column in _detail?.Columns ?? [])
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)column.Id)">@column.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid?" Label="Development column" @bind-Value="_orchestrationDevelopmentColumnId"
                   Variant="Variant.Outlined" Class="mt-3">
            @foreach (var column in _detail?.Columns ?? [])
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)column.Id)">@column.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid?" Label="QA column" @bind-Value="_orchestrationQualityColumnId"
                   Variant="Variant.Outlined" Class="mt-3">
            @foreach (var column in _detail?.Columns ?? [])
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)column.Id)">@column.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid?" Label="Done column" @bind-Value="_orchestrationDoneColumnId"
                   Variant="Variant.Outlined" Class="mt-3">
            @foreach (var column in _detail?.Columns ?? [])
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)column.Id)">@column.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" Label="Merge policy" @bind-Value="_orchestrationMergeMode"
                   Variant="Variant.Outlined" Class="mt-3">
            <MudSelectItem T="string" Value="@("ManagerApproval")">Manager approval</MudSelectItem>
            <MudSelectItem T="string" Value="@("Automatic")">Governed automatic merge</MudSelectItem>
        </MudSelect>
        <MudNumericField T="int" Label="Maximum QA cycles" @bind-Value="_orchestrationQualityCycles"
                         Min="1" Max="10" Variant="Variant.Outlined" Class="mt-3" />
        @if (!string.IsNullOrWhiteSpace(_orchestrationError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">@_orchestrationError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _orchestrationOpen = false)">Close</MudButton>
        @if (_detail?.Board.AllowedActions.Contains(WorkOrchestrationActions.Configure) == true)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_saving || !OrchestrationTemplateComplete)"
                       OnClick="PublishSoftwarePolicyAsync">Publish software policy</MudButton>
        }
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_deliveryOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Delivery pipeline</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Enabling is the one-time authorization for sequential Developer → QA → governed merge
            processing across approved sprints.
        </MudAlert>
        <MudSelect T="Guid?" Label="Software Developer" @bind-Value="_pipelineDeveloperId"
                   Variant="Variant.Outlined" Class="mt-3">
            @foreach (var agent in _pipelineAgents.Where(x => x.AgentId == "com.csweet.software-developer"))
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)agent.Id)">@agent.AgentName (@agent.AgentVersion)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid?" Label="Software QA" @bind-Value="_pipelineQualityId"
                   Variant="Variant.Outlined" Class="mt-3">
            @foreach (var agent in _pipelineAgents.Where(x => x.AgentId == "com.csweet.software-qa"))
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)agent.Id)">@agent.AgentName (@agent.AgentVersion)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid?" Label="Development column" @bind-Value="_pipelineDevelopmentColumnId"
                   Variant="Variant.Outlined" Class="mt-3">
            @foreach (var column in _detail?.Columns.Where(x => x.Category != "Done") ?? [])
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)column.Id)">@column.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid?" Label="QA column" @bind-Value="_pipelineQualityColumnId"
                   Variant="Variant.Outlined" Class="mt-3">
            @foreach (var column in _detail?.Columns.Where(x => x.Category != "Done") ?? [])
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)column.Id)">@column.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid?" Label="Done column" @bind-Value="_pipelineDoneColumnId"
                   Variant="Variant.Outlined" Class="mt-3">
            @foreach (var column in _detail?.Columns.Where(x => x.Category == "Done") ?? [])
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)column.Id)">@column.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid?" Label="Repository" @bind-Value="_pipelineRepositoryId"
                   Variant="Variant.Outlined" Class="mt-3">
            @foreach (var connection in _repositoryConnections)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)connection.Id)">
                    @connection.Name — @connection.CanonicalPath
                </MudSelectItem>
            }
        </MudSelect>
        @if (!string.IsNullOrWhiteSpace(_pipelineError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">
                @_pipelineError
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        @if (_deliveryPipeline?.IsEnabled == true)
        {
            <MudButton Color="Color.Warning" OnClick="@(() => ChangePipelineAsync("pause"))">Pause</MudButton>
            <MudButton Color="Color.Error" OnClick="@(() => ChangePipelineAsync("disable"))">Disable</MudButton>
        }
        @if (_deliveryPipeline?.Status == "Paused")
        {
            <MudButton Color="Color.Success" OnClick="@(() => ChangePipelineAsync("resume"))">Resume</MudButton>
        }
        <MudSpacer />
        <MudButton OnClick="@(() => _deliveryOpen = false)">Close</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_saving || !PipelineFormComplete)"
                   OnClick="SaveDeliveryPipelineAsync">
            @(_deliveryPipeline is null ? "Enable pipeline" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_agentAccessOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Agent board access</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
            Board grants and the agent package's MCP capability grant are both required.
        </MudAlert>
        <MudSelect T="Guid?" Label="Agent installation" Value="_selectedAgentId"
                   ValueChanged="SelectAgentAccess" Variant="Variant.Outlined" Class="mt-3">
            @foreach (var agent in _boardAgents)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)agent.Id)">
                    @agent.AgentName (@agent.AgentVersion)
                </MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" Label="Access profile" @bind-Value="_agentAccessProfile"
                   Variant="Variant.Outlined" Class="mt-3">
            <MudSelectItem T="string" Value="@("None")">No access</MudSelectItem>
            <MudSelectItem T="string" Value="@("ReadOnly")">Read only</MudSelectItem>
            <MudSelectItem T="string" Value="@("Operator")">Work-item operator</MudSelectItem>
        </MudSelect>
        @if (!string.IsNullOrWhiteSpace(_agentAccessError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">
                @_agentAccessError
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _agentAccessOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_saving || !_selectedAgentId.HasValue)"
                   OnClick="SaveAgentAccessAsync">Save access</MudButton>
    </DialogActions>
