                .Where(x => x.IsEnabled && x.RevisionStatus == "Active" &&
                            Guid.TryParse(x.BusinessId, out var businessId) && businessId == OrganizationId)
                .OrderBy(x => x.AgentName).ToList();
            foreach (var stage in PublishedPolicy?.Stages ?? [])
