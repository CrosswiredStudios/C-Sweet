    private async Task MoveItemAsync(WorkBoardItemResponse item, WorkBoardColumnResponse target) =>
        await MoveItemAsync(item, target, null);

    private async Task MoveItemAsync(
        WorkBoardItemResponse item,
        WorkBoardColumnResponse target,
        Guid? beforeItemId)
    {
        if (_detail is null || _movePending || !CanMoveTo(item, target)) return;
        if (beforeItemId == item.Id) return;
        var previous = _detail;
        _moveError = null;
        _movePending = true;
        var before = _detail.Items.SingleOrDefault(x => x.Id == beforeItemId);
        var optimisticRank = before?.Rank ??
            (_detail.Items.Where(x => x.ColumnId == target.Id && x.Id != item.Id)
                .Select(x => x.Rank).DefaultIfEmpty(0).Max() + 1);
        _detail = _detail with
        {
            Items = _detail.Items.Select(x => x.Id == item.Id
                ? x with { ColumnId = target.Id, Rank = optimisticRank }
                : x).ToList()
        };
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/organizations/{OrganizationId:D}/work/boards/{previous.Board.Id:D}/items/{item.Id:D}/move",
                WorkBoardPresentation.MoveRequest(item, target.Id, beforeItemId));
            if (!response.IsSuccessStatusCode)
            {
                _detail = previous;
                _moveError = await ApiErrorAsync(response);
                return;
            }
            await RefreshDetailAsync();
        }
        catch (Exception exception)
        {
            _detail = previous;
            _moveError = exception.Message;
        }
        finally
        {
            _movePending = false;
            EndDrag();
        }
    }

    private bool CanDrag(WorkBoardItemResponse item) =>
        !_movePending && _detail is { Board.IsArchived: false } &&
        _detail.Columns.Any(column => CanMoveTo(item, column));

    private void BeginDrag(WorkBoardItemResponse item)
    {
        if (!CanDrag(item)) return;
        _draggedItem = item;
        _moveError = null;
    }

    private void EndDrag()
    {
        _draggedItem = null;
        _dragTargetColumnId = null;
    }

    private async Task DropItemAsync(WorkBoardColumnResponse target, Guid? beforeItemId)
    {
        var item = _draggedItem;
        if (item is null) return;
        await MoveItemAsync(item, target, beforeItemId);
