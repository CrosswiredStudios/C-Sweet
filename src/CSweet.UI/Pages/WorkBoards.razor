    private static Color WipColor(WorkBoardColumnResponse column, int count) =>
        column.WipLimit.HasValue && count >= column.WipLimit.Value
            ? column.WipPolicy == "HardLimit" ? Color.Error : Color.Warning
            : Color.Secondary;

