    private async Task OpenDeveloperAssignmentAsync(WorkBoardItemResponse item)
    {
        _developerAssignmentItem = item;
        _developerInstallationId = item.AssignedInstallationId;
        _developerConnectionId = item.Development?.RepositoryConnectionId;
        _developerBaseBranch = item.Development?.BaseBranch ?? "main";
        _developerRequirements = string.Join(
            Environment.NewLine,
            item.Development?.Requirements ?? [item.Description]);
        _developerAcceptanceCriteria = string.Join(
            Environment.NewLine,
            item.Development?.AcceptanceCriteria ?? []);
        _developerConstraints = string.Join(
            Environment.NewLine,
            item.Development?.Constraints ?? []);
        _developerAssignmentError = null;
        try
        {
            var installations = await Http.GetFromJsonAsync<IReadOnlyList<AgentInstallationResponse>>(
                "api/agents/installations") ?? [];
            _developerInstallations = installations
                .Where(x =>
                    x.IsEnabled &&
                    x.RevisionStatus == "Active" &&
                    x.AgentId == "com.csweet.software-developer")
                .OrderBy(x => x.AgentName)
                .ToList();
            _repositoryConnections =
                await Http.GetFromJsonAsync<IReadOnlyList<GitRepositoryConnectionResponse>>(
                    $"api/organizations/{OrganizationId:D}/git/repositories") ?? [];
            if (!_developerInstallationId.HasValue && _developerInstallations.Count == 1)
                _developerInstallationId = _developerInstallations[0].Id;
            if (!_developerConnectionId.HasValue && _repositoryConnections.Count == 1)
                SelectDeveloperConnection(_repositoryConnections[0].Id);
            _developerAssignmentOpen = true;
        }
        catch (Exception exception)
        {
            _developerAssignmentError = exception.Message;
            _developerAssignmentOpen = true;
        }
    }

    private void SelectDeveloperConnection(Guid? connectionId)
    {
        _developerConnectionId = connectionId;
        var connection = _repositoryConnections.SingleOrDefault(x => x.Id == connectionId);
        if (connection is not null)
            _developerBaseBranch = connection.DefaultBranch;
    }

    private async Task AssignDeveloperAsync()
    {
        if (_detail is null ||
            _developerAssignmentItem is null ||
            !_developerInstallationId.HasValue ||
            !_developerConnectionId.HasValue)
            return;
        var requirements = Lines(_developerRequirements);
        var acceptanceCriteria = Lines(_developerAcceptanceCriteria);
        if (requirements.Count == 0 || acceptanceCriteria.Count == 0)
        {
            _developerAssignmentError =
                "At least one requirement and one acceptance criterion are required.";
            return;
        }

        _saving = true;
        _developerAssignmentError = null;
        try
        {
            var request = new AssignSoftwareDevelopmentWorkItemRequest(
                _developerInstallationId.Value,
                new SoftwareDevelopmentBrief(
                    _developerConnectionId.Value,
                    _developerBaseBranch,
                    "software-development-polyglot-v1",
                    requirements,
                    acceptanceCriteria,
                    Lines(_developerConstraints)),
                _developerAssignmentItem.Revision,
                Guid.NewGuid().ToString("N"));
            var response = await Http.PutAsJsonAsync(
                $"api/organizations/{OrganizationId:D}/work/boards/{_detail.Board.Id:D}/items/{_developerAssignmentItem.Id:D}/developer-assignment",
                request);
            if (!response.IsSuccessStatusCode)
            {
                _developerAssignmentError = await response.Content.ReadAsStringAsync();
                return;
            }
            _developerAssignmentOpen = false;
            await RefreshDetailAsync();
        }
        finally
        {
            _saving = false;
        }
    }

