@page "/organizations/{OrganizationId:guid}/marketplace"
@using System.Net.Http.Json
@using CSweet.Agent.SDK
@using CSweet.Contracts.Core
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Agent Catalog - C-Sweet</PageTitle>

<div class="command-center-shell">
    <MudPaper Elevation="0" Class="page-header">
        <div>
            <MudText Typo="Typo.h3">Agent catalog</MudText>
            <MudText Color="Color.Secondary">
                Browse installed, local-directory, first-party, and marketplace agents through one catalog.
            </MudText>
        </div>
        <MudButton Href="@($"/organizations/{OrganizationId}/employees?tab=hiring")"
                   Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Groups">
            Hiring recommendations
        </MudButton>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField T="string" Label="Search agents or capabilities"
                              @bind-Value="_search" Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField T="string" Label="Role" @bind-Value="_role"
                              Variant="Variant.Outlined" Placeholder="Product Manager" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="Category" @bind-Value="_category"
                           Variant="Variant.Outlined" Clearable="true">
                    @foreach (var category in Categories)
                    {
                        <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="string" Label="Sort" @bind-Value="_sort" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("relevance")">Most relevant</MudSelectItem>
                    <MudSelectItem T="string" Value="@("rating")">Highest rated</MudSelectItem>
                    <MudSelectItem T="string" Value="@("price-low")">Lowest price</MudSelectItem>
                    <MudSelectItem T="string" Value="@("name")">Name</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="_loading" OnClick="SearchAsync">
                        Search catalog
                    </MudButton>
                    <MudButton Variant="Variant.Text" Disabled="_loading" OnClick="ClearAsync">
                        Clear filters
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        @foreach (var source in _result?.Sources.Where(x => !x.Available && !string.IsNullOrWhiteSpace(x.Message)) ?? [])
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                @source.Source: @source.Message
            </MudAlert>
        }

        <MudText Typo="Typo.subtitle1" Class="mb-3">
            @(_result?.Agents.Count ?? 0) matching @((_result?.Agents.Count ?? 0) == 1 ? "agent" : "agents")
        </MudText>
        @if (_result?.Agents.Count is null or 0)
        {
            <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6">No matching agents</MudText>
                <MudText Color="Color.Secondary">Try a broader role or search term.</MudText>
            </MudPaper>
        }
        else
        {
            <MudGrid>
                @foreach (var agent in _result.Agents)
                {
                    <MudItem xs="12" md="6" lg="4">
                        <MarketplaceAgentCard Agent="agent" ReviewHireRequested="ReviewHireAsync" />
                    </MudItem>
                }
            </MudGrid>
        }
    }
</div>

<MudDialog @bind-Visible="_reviewOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h5">Review and hire @_preview?.AgentName</MudText>
    </TitleContent>
    <DialogContent>
        @if (_reviewBusy)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        @if (!string.IsNullOrWhiteSpace(_reviewError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_reviewError</MudAlert>
        }
        @if (_preview is not null)
        {
            <MudStack Spacing="2">
                <MudText><strong>Role:</strong> @_preview.RoleTitle</MudText>
                <MudText><strong>Source:</strong> @_preview.Source · @_preview.Trust</MudText>
                <MudText><strong>Price:</strong> @(_preview.Price.HasValue ? $"{_preview.Price:0.##} {_preview.Currency}" : "No listed cost")</MudText>
                <MudText Color="Color.Secondary">@_preview.InstallationConsequence</MudText>
                <MudSelect T="Guid?" Label="Reports to" @bind-Value="_reportsToId"
                           Variant="Variant.Outlined" Clearable="true" Disabled="_reviewBusy">
                    @foreach (var manager in _people)
                    {
                        <MudSelectItem T="Guid?" Value="@manager.Id">@manager.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.subtitle2">Capabilities</MudText>
                <div class="marketplace-agent-capabilities">
                    @foreach (var capability in _preview.Capabilities)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@capability</MudChip>
                    }
                </div>
                @if (_preview.RequestedCapabilities.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2">Requested platform access</MudText>
                    <MudText Typo="Typo.body2">@string.Join(", ", _preview.RequestedCapabilities)</MudText>
                }
                @if (_preview.Subscriptions.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2">Event subscriptions</MudText>
                    <MudText Typo="Typo.body2">@string.Join(", ", _preview.Subscriptions)</MudText>
                }
                @if (_preview.NetworkAccess.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2">Network access</MudText>
                    <MudText Typo="Typo.body2">@string.Join(", ", _preview.NetworkAccess)</MudText>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseReview" Disabled="_reviewBusy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_reviewBusy || _preview is null)"
                   OnClick="ConfirmHireAsync">
            Approve and hire
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [SupplyParameterFromQuery(Name = "role")]
    public string? RequestedRole { get; set; }

    private AvailableAgentSearchResult? _result;
    private bool _loading;
    private string? _search;
    private string? _role;
    private string? _category;
    private string _sort = "relevance";
    private string? _appliedRouteRole;
    private bool _reviewOpen;
    private bool _reviewBusy;
    private string? _reviewError;
    private MarketplaceHirePreviewResponse? _preview;
    private AvailableAgent? _selectedAgent;
    private Guid? _reportsToId;
    private IReadOnlyList<OrganizationUserResponse> _people = [];
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

    private IReadOnlyList<string> Categories => (_result?.Agents ?? [])
        .Select(x => x.Category)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToArray();

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(_appliedRouteRole, RequestedRole, StringComparison.Ordinal))
        {
            _appliedRouteRole = RequestedRole;
            _role = string.IsNullOrWhiteSpace(RequestedRole) ? null : RequestedRole.Trim();
        }
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _loading = true;
        try
        {
            var query = new List<string> { $"sort={Uri.EscapeDataString(_sort)}", "limit=100" };
            Add("q", _search);
            Add("role", _role);
            Add("category", _category);
            _result = await Http.GetFromJsonAsync<AvailableAgentSearchResult>(
                $"api/core/organizations/{OrganizationId:D}/agents/available?{string.Join('&', query)}")
                ?? Offline("The agent catalog returned an empty response.");

            void Add(string key, string? value)
            {
                if (!string.IsNullOrWhiteSpace(value))
                    query.Add($"{key}={Uri.EscapeDataString(value)}");
            }
        }
        catch (HttpRequestException)
        {
            _result = Offline("C-Sweet could not reach the agent catalog.");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ClearAsync()
    {
        _search = null;
        _role = null;
        _category = null;
        _sort = "relevance";
        await SearchAsync();
    }

    private static AvailableAgentSearchResult Offline(string reason) =>
        new([], [new(AgentCatalogSource.Marketplace, false, reason)]);

    private async Task ReviewHireAsync(AvailableAgent agent)
    {
        _selectedAgent = agent;
        _reviewOpen = true;
        _reviewBusy = true;
        _reviewError = null;
        _preview = null;
        try
        {
            _people = await Http.GetFromJsonAsync<IReadOnlyList<OrganizationUserResponse>>(
                $"api/core/organizations/{OrganizationId:D}/users") ?? [];
            await LoadPreviewAsync();
        }
        catch (Exception exception)
        {
            _reviewError = exception.Message;
        }
        finally
        {
            _reviewBusy = false;
        }
    }

    private async Task LoadPreviewAsync()
    {
        if (_selectedAgent is null) return;
        var role = string.IsNullOrWhiteSpace(_role)
            ? _selectedAgent.RoleAliases.FirstOrDefault() ?? _selectedAgent.Name
            : _role.Trim();
        var response = await Http.PostAsJsonAsync(
            $"api/core/organizations/{OrganizationId:D}/hiring/marketplace/preview",
            new PreviewMarketplaceHireRequest(
                _selectedAgent.AgentReference,
                role,
                _reportsToId,
                $"marketplace-preview:{Guid.NewGuid():N}"));
        if (!response.IsSuccessStatusCode)
        {
            var failure = await response.Content.ReadFromJsonAsync<MarketplaceApiError>();
            throw new InvalidOperationException(failure?.Message ?? "The agent hire could not be prepared.");
        }
        _preview = await response.Content.ReadFromJsonAsync<MarketplaceHirePreviewResponse>()
            ?? throw new InvalidOperationException("The Marketplace hire preview was empty.");
    }

    private async Task ConfirmHireAsync()
    {
        if (_preview is null) return;
        _reviewBusy = true;
        _reviewError = null;
        try
        {
            if (_preview.ReportsToOrganizationUserId != _reportsToId)
            {
                await LoadPreviewAsync();
                if (_preview is null) return;
            }
            var response = await Http.PostAsJsonAsync(
                $"api/core/organizations/{OrganizationId:D}/hiring/workflows/{_preview.WorkflowId:D}/confirm",
                new ConfirmHiringWorkflowRequest($"marketplace-confirm:{_preview.WorkflowId:D}"));
            if (!response.IsSuccessStatusCode)
            {
                var failure = await response.Content.ReadFromJsonAsync<MarketplaceApiError>();
                throw new InvalidOperationException(failure?.Message ?? "The hire could not be completed.");
            }
            _reviewOpen = false;
            _preview = null;
            _selectedAgent = null;
            Navigation.NavigateTo($"/organizations/{OrganizationId:D}/employees");
        }
        catch (Exception exception)
        {
            _reviewError = exception.Message;
        }
        finally
        {
            _reviewBusy = false;
        }
    }

    private void CloseReview()
    {
        _reviewOpen = false;
        _preview = null;
        _selectedAgent = null;
        _reviewError = null;
    }

    private sealed record MarketplaceApiError(string? Error, string? Message);
}
