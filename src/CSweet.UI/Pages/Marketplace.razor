@using HiringRecommendationResponse = CSweet.Contracts.Core.HiringRecommendationResponse
@page "/organizations/{OrganizationId:guid}/marketplace"
@using System.Net.Http.Json
@using System.Text.Json
@using CSweet.Agent.SDK
@using CSweet.Contracts.Agents
@using CSweet.Contracts.Core
@using CSweet.Contracts.Llm
@using CSweet.Contracts.Plugins
@using CSweet.Domain.Core
@using ContractAgentConfigurationFieldTypes = CSweet.Contracts.Agents.AgentConfigurationFieldTypes
@inject HttpClient Http
@inject ILlmProviderApiClient LlmProviderApi
@inject AgentHireOperationState HireOperations
@inject NavigationManager Navigation
@inject IAppLocalizer L

<PageTitle>@L["Marketplace.PageTitle"]</PageTitle>

<div class="aurora-page business-workspace marketplace-page">
    <MudPaper Elevation="0" Class="page-header">
        <div>
            <MudText Typo="Typo.overline">@L["Marketplace.Overline"]</MudText>
            <MudText Typo="Typo.h3">@L["Marketplace.Title"]</MudText>
            <MudText Color="Color.Secondary">
                @L["Marketplace.Lead"]
            </MudText>
        </div>
        <MudButton Href="@($"/organizations/{OrganizationId}/employees?tab=hiring")"
                   Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Groups">
            @L["Marketplace.HiringRecommendations"]
        </MudButton>
    </MudPaper>

    @if (RecommendationId.HasValue)
    {
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            @if (_hiringContext is { Status: "Pending", RemainingHeadcount: > 0 } hiring)
            {
                <MudText Typo="Typo.h6">@L.Format("Marketplace.HiringContext.Title", new { title = hiring.Title, proposer = hiring.RequestingEmployee ?? hiring.SuggestedBy ?? L["Marketplace.HiringContext.UnknownEmployee"] })</MudText>
                <MudText>@L.Format("Marketplace.HiringContext.Detail", new { team = hiring.RequestingTeam, count = hiring.RemainingHeadcount, approver = hiring.ActualDecisionMaker })</MudText>
                <MudLink Href="@($"/organizations/{OrganizationId:D}/employees?tab=hiring&recommendation={RecommendationId:D}")">@L["Marketplace.HiringContext.ReviewPlan"]</MudLink>
            }
            else { <MudAlert Severity="Severity.Warning">@L["Marketplace.HiringContext.Unavailable"]</MudAlert> }
            <MudButton Variant="Variant.Text" Href="@($"/organizations/{OrganizationId:D}/marketplace")">@L["Marketplace.HiringContext.BrowseOutside"]</MudButton>
        </MudPaper>
    }

    @if (_needsChiefSetup)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
            <strong>@L["Marketplace.ChiefSetup.Title"]</strong> @L["Marketplace.ChiefSetup.Body"]
        </MudAlert>
    }

    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField T="string" Label="@L["Marketplace.SearchLabel"]"
                              @bind-Value="_search" Immediate="true" OnKeyDown="SearchKeyDown" Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField T="string" Label="@L["Marketplace.RoleLabel"]" @bind-Value="_role"
                              Variant="Variant.Outlined" Placeholder="@L["Marketplace.RolePlaceholder"]" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="@L["Marketplace.CategoryLabel"]" @bind-Value="_category"
                           Variant="Variant.Outlined" Clearable="true">
                    @foreach (var category in Categories)
                    {
                        <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="string" Label="@L["Marketplace.SortLabel"]" @bind-Value="_sort" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("relevance")">@L["Marketplace.Sort.Relevance"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("rating")">@L["Marketplace.Sort.Rating"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("price-low")">@L["Marketplace.Sort.PriceLow"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("name")">@L["Marketplace.Sort.Name"]</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="_loading" OnClick="SearchAsync">
                        @L["Marketplace.SearchCatalog"]
                    </MudButton>
                    <MudButton Variant="Variant.Text" Disabled="_loading" OnClick="ClearAsync">
                        @L["Marketplace.ClearFilters"]
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_loading)
    {
        <MudPaper Class="pa-5 mb-4" Elevation="0" Outlined="true" role="status" aria-label="@L["Marketplace.LoadingAria"]">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                <MudText>@L["Marketplace.Finding"]</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        @foreach (var source in _result?.Sources.Where(x => !x.Available && !string.IsNullOrWhiteSpace(x.Message)) ?? [])
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                @L.Format("Marketplace.SourceUnavailable", new { source = source.Source, message = source.Message })
            </MudAlert>
        }

        <MudText Typo="Typo.subtitle1" Class="mb-3">
            @L.Format("Marketplace.MatchingCount", new { count = _result?.Agents.Count ?? 0 })
        </MudText>
        @if (_result?.Agents.Count is null or 0)
        {
            <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6">@L["Marketplace.NoMatches.Title"]</MudText>
                <MudText Color="Color.Secondary">@L["Marketplace.NoMatches.Hint"]</MudText>
            </MudPaper>
        }
        else
        {
            <div class="marketplace-agent-grid">
                @foreach (var agent in _result.Agents)
                {
                    <MarketplaceAgentCard @key="agent.AgentReference" Agent="agent" OrganizationId="OrganizationId" ReviewHireRequested="@(CanContextHire ? EventCallback.Factory.Create<AvailableAgent>(this, ReviewHireAsync) : default)" />
                }
            </div>
        }
    }
</div>

<AgentHireDialog @ref="_hireDialog" OrganizationId="OrganizationId" Hired="OnHired" />

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    [SupplyParameterFromQuery(Name = "role")]
    public string? RequestedRole { get; set; }
    [SupplyParameterFromQuery(Name = "recommendationId")]
    public Guid? RecommendationId { get; set; }

    private AvailableAgentSearchResult? _result;
    private bool _loading = true;
    private bool _needsChiefSetup;
    private string? _search;
    private string? _role;
    private string? _category;
    private string _sort = "relevance";
    private async Task SearchKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter" && !_loading) await SearchAsync(); }
    private string? _appliedRouteRole;
    private AgentHireDialog? _hireDialog;
    private HiringRecommendationResponse? _hiringContext;
    private IReadOnlyList<string> Categories => (_result?.Agents ?? [])
        .Select(x => x.Category)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToArray();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        if (!string.Equals(_appliedRouteRole, RequestedRole, StringComparison.Ordinal))
        {
            _appliedRouteRole = RequestedRole;
            _role = string.IsNullOrWhiteSpace(RequestedRole) ? null : RequestedRole.Trim();
        }
        _hiringContext = null;
        if (RecommendationId.HasValue)
        {
            try { _hiringContext = await Http.GetFromJsonAsync<HiringRecommendationResponse>($"api/core/organizations/{OrganizationId:D}/hiring/recommendations/{RecommendationId.Value:D}"); }
            catch (HttpRequestException) { }
        }
        await LoadOrganizationAsync();
        await SearchAsync();
    }

    private async Task LoadOrganizationAsync()
    {
        try
        {
            var organization = await Http.GetFromJsonAsync<OrganizationResponse>(
                $"api/core/organizations/{OrganizationId:D}");
            _needsChiefSetup = organization?.NeedsChiefSetup == true;
        }
        catch
        {
            _needsChiefSetup = false;
        }
    }

    private async Task SearchAsync()
    {
        _loading = true;
        try
        {
            var query = new List<string> { $"sort={Uri.EscapeDataString(_sort)}", "limit=100" };
            Add("q", _search);
            Add("role", _role);
            Add("category", _category);
            if (RecommendationId.HasValue)
                query.Add($"recommendationId={RecommendationId.Value:D}");
            _result = await Http.GetFromJsonAsync<AvailableAgentSearchResult>(
                $"api/core/organizations/{OrganizationId:D}/agents/available?{string.Join('&', query)}")
                ?? Offline(L["Marketplace.EmptyResponse"]);

            void Add(string key, string? value)
            {
                if (!string.IsNullOrWhiteSpace(value))
                    query.Add($"{key}={Uri.EscapeDataString(value)}");
            }
        }
        catch (HttpRequestException)
        {
            _result = Offline(L[RecommendationId.HasValue
                ? "Marketplace.RecommendationLoadFailed"
                : "Marketplace.Unreachable"]);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ClearAsync()
    {
        _search = null;
        _role = null;
        _category = null;
        _sort = "relevance";
        await SearchAsync();
    }

    private static AvailableAgentSearchResult Offline(string reason) =>
        new([], [new(AgentCatalogSource.Marketplace, false, reason)]);

    private bool CanContextHire => !RecommendationId.HasValue || _hiringContext is { Status: "Pending", RemainingHeadcount: > 0 };
    private Task ReviewHireAsync(AvailableAgent agent) =>
        RecommendationId.HasValue && _hiringContext is not { Status: "Pending", RemainingHeadcount: > 0 }
            ? Task.CompletedTask : _hireDialog!.OpenAsync(agent, _hiringContext?.Title ?? _role, RecommendationId);

    private void OnHired() => Navigation.NavigateTo($"/organizations/{OrganizationId:D}/command-center");
}
